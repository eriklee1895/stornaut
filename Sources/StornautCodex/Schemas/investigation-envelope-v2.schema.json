{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stornaut Investigation Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "investigationID",
    "runID",
    "summary",
    "coverage",
    "evidence",
    "findings",
    "candidateProposals",
    "capabilityDegradations"
  ],
  "properties": {
    "protocolVersion": {
      "const": 2
    },
    "investigationID": {
      "$ref": "#/$defs/identifier"
    },
    "runID": {
      "$ref": "#/$defs/identifier"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "investigatedTargetIDs",
        "unresolvedTargets"
      ],
      "properties": {
        "investigatedTargetIDs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "unresolvedTargets": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetID",
              "reason"
            ],
            "properties": {
              "targetID": {
                "$ref": "#/$defs/identifier"
              },
              "reason": {
                "$ref": "#/$defs/reasonKey"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "targetID",
          "source",
          "summary",
          "publicURL"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "targetID": {
            "$ref": "#/$defs/identifier"
          },
          "source": {
            "enum": [
              "probeBroker",
              "directFile",
              "shell",
              "liveSearch",
              "browserOrDirectFetch",
              "image",
              "skill",
              "subagent"
            ]
          },
          "summary": {
            "$ref": "#/$defs/itemSummary"
          },
          "publicURL": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/advisoryItem"
      }
    },
    "candidateProposals": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateID",
          "targetID",
          "summary",
          "evidenceIDs",
          "confidence",
          "uncertainty"
        ],
        "properties": {
          "candidateID": {
            "$ref": "#/$defs/identifier"
          },
          "targetID": {
            "$ref": "#/$defs/identifier"
          },
          "summary": {
            "$ref": "#/$defs/itemSummary"
          },
          "evidenceIDs": {
            "$ref": "#/$defs/evidenceReferences"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "uncertainty": {
            "$ref": "#/$defs/uncertainty"
          }
        }
      }
    },
    "capabilityDegradations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "reasonKey",
          "summary"
        ],
        "properties": {
          "capability": {
            "enum": [
              "directRead",
              "shell",
              "unifiedExec",
              "liveSearch",
              "publicNetwork",
              "browserOrDirectFetch",
              "imageInspection",
              "skills",
              "subagents",
              "probeBroker"
            ]
          },
          "reasonKey": {
            "$ref": "#/$defs/reasonKey"
          },
          "summary": {
            "$ref": "#/$defs/itemSummary"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "reasonKey": {
      "$ref": "#/$defs/identifier"
    },
    "itemSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "advisoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetID",
        "summary",
        "evidenceIDs",
        "confidence",
        "uncertainty"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "targetID": {
          "$ref": "#/$defs/identifier"
        },
        "summary": {
          "$ref": "#/$defs/itemSummary"
        },
        "evidenceIDs": {
          "$ref": "#/$defs/evidenceReferences"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        }
      }
    }
  }
}
