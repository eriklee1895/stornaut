{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stornaut.dev/schemas/rule-catalog-source-v1.json",
  "title": "Stornaut Rule Catalog Source v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "$ref": "#/$defs/token"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "ruleID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "tokenList": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathPattern",
        "expectedKind"
      ],
      "properties": {
        "pathPattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expectedKind": {
          "enum": [
            "regularFile",
            "directory",
            "symbolicLink",
            "other"
          ]
        }
      }
    },
    "recovery": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "methodKey",
        "cost"
      ],
      "properties": {
        "methodKey": {
          "$ref": "#/$defs/token"
        },
        "cost": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "url",
        "revision",
        "license",
        "usage"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "revision": {
          "$ref": "#/$defs/token"
        },
        "license": {
          "$ref": "#/$defs/token"
        },
        "usage": {
          "enum": [
            "behaviorReferenceOnly",
            "officialDocumentation",
            "independentObservation",
            "blackBoxVerification"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "independentlyVerified",
        "verifiedAt"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "independentlyVerified": {
          "const": true
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "match",
        "producer",
        "rationaleKey",
        "category",
        "disposition",
        "risk",
        "confidenceRequirement",
        "veto",
        "requiredEvidenceKeys",
        "requiredActivityKeys",
        "recovery",
        "recommendedAction",
        "provenance",
        "fixtureIDs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ruleID"
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rationaleKey": {
          "$ref": "#/$defs/token"
        },
        "category": {
          "enum": [
            "packageAndBuildCaches",
            "rebuildableProjectArtifacts",
            "toolRuntimesAndImages",
            "updatesAndTemporaryFiles",
            "largeRepositoriesAndHistory",
            "unknownLargeConsumers",
            "protected"
          ]
        },
        "disposition": {
          "enum": [
            "readyToReclaim",
            "reviewRecommended",
            "protected",
            "unknown"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "confidenceRequirement": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "veto": {
          "type": "boolean"
        },
        "requiredEvidenceKeys": {
          "$ref": "#/$defs/tokenList"
        },
        "requiredActivityKeys": {
          "$ref": "#/$defs/tokenList"
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        },
        "recommendedAction": {
          "enum": [
            "none",
            "moveToTrash"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "fixtureIDs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        }
      }
    }
  }
}
