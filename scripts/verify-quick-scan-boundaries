#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"

quick_scan_root=Sources/StornautCore/QuickScan
surveyor_root=Sources/StornautCore/Surveyor

if rg -n \
    'StornautCodex|CodexProcess|ProbeBridge|Adapter|ActionPolicyGate|ActionExecutor|TrashMoving|RegisteredAction|Process\(|posix_spawn' \
    "$quick_scan_root"; then
    echo "Quick Scan contains a prohibited runtime dependency" >&2
    exit 1
fi

if rg -n \
    'removeItem|moveItem|copyItem|createFile|forWritingTo|O_WRONLY|O_RDWR|unlink\(|rename\(' \
    "$quick_scan_root" "$surveyor_root"; then
    echo "Quick Scan or Surveyor contains a scanned-target write surface" >&2
    exit 1
fi

rg -q 'O_RDONLY \| O_DIRECTORY \| O_NOFOLLOW \| O_CLOEXEC' \
    Sources/StornautCore/Surveyor/Surveyor.swift

if rg -n \
    '^public protocol QuickScan(ProductPersisting|ActivityProviding)' \
    Sources/StornautCore/QuickScan/QuickScanCoordinator.swift; then
    echo "A generic Quick Scan injection seam escaped StornautCore" >&2
    exit 1
fi

package_graph=$(swift package describe --type json)
python3 - "$package_graph" <<'PY'
import json
import sys

package = json.loads(sys.argv[1])
targets = {target["name"]: target for target in package["targets"]}
core = targets["StornautCore"]
dependencies = set(core.get("target_dependencies", []))
if dependencies & {"StornautCodex", "RuleCompilerKit"}:
    raise SystemExit("StornautCore depends on Codex or the host compiler")
resources = {
    resource["path"].removeprefix(core["path"] + "/")
    for resource in core.get("resources", [])
}
if not any(path.endswith("/Resources/BuiltInRuleCatalog.json") for path in resources):
    raise SystemExit("compiled runtime catalog is not a Core resource")
PY

echo "Quick Scan boundary verification passed."
