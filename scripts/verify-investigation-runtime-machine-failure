MAGIC = 0x53544E43
VERSION = 1
MAX_DOMAIN = 64
MAX_EVENT = 4_608
MAX_EVENT_PAYLOAD = 4_096
O_NOFOLLOW_ANY = 0x20000000
O_RESOLVE_BENEATH = 0x00001000
O_UNIQUE = 0x00002000
READ_FLAGS = (os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | O_NOFOLLOW_ANY
              | O_RESOLVE_BENEATH | O_UNIQUE)
DIRECTORY_FLAGS = READ_FLAGS | os.O_DIRECTORY
ROOT_FLAGS = (os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NONBLOCK
              | O_NOFOLLOW_ANY | O_UNIQUE)
PHASES = ("01-preflight", "02-install", "03-authorization",
          "04-driver-epochs", "05-uninstall", "06-verifier")
