#!/bin/zsh -f
set -euo pipefail
typeset -r iicc_failure_self_sha=f496b8a3b027c751c6ed49cd0d657154f10f5ce957127f1c616f512bba55394c # iicc-failure-self-seal
if [[ $0 != /dev/fd/9 ]]; then
    self=${0:A}
    [[ -f $self && ! -L $self ]] || exit 2
    exec 9<"$self"
    exec /bin/zsh -f /dev/fd/9 "$@"
fi

[[ $# == 2 ]] || {
    print -u2 "Usage: scripts/verify-investigation-runtime-machine-failure <evidence-root> <disposition.json>"
    exit 2
}

exec /usr/bin/python3 -I - "$1" "$2" "$iicc_failure_self_sha" 9 <<'PY'
import ctypes
import errno
import fcntl
import hashlib
import json
import os
import pwd
import re
import select
import stat
import struct
import subprocess
import sys
import uuid

if sys.flags.optimize != 0:
    raise SystemExit("optimized Python execution is not admitted")

MAGIC = 0x53544E43
VERSION = 1
MAX_DOMAIN = 64
MAX_EVENT = 4_608
MAX_EVENT_PAYLOAD = 4_096
O_NOFOLLOW_ANY = 0x20000000
O_RESOLVE_BENEATH = 0x00001000
O_UNIQUE = 0x00002000
READ_FLAGS = (os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | O_NOFOLLOW_ANY
              | O_RESOLVE_BENEATH | O_UNIQUE)
DIRECTORY_FLAGS = READ_FLAGS | os.O_DIRECTORY
ROOT_FLAGS = (os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NONBLOCK
              | O_NOFOLLOW_ANY | O_UNIQUE)
PHASES = ("01-preflight", "02-install", "03-authorization",
          "04-driver-epochs", "05-uninstall", "06-verifier")
V1_FILES = (
    "01-preflight/source-build.json",
    "02-install/installed.json",
    "03-authorization/attempt-event-0001.bin",
    "03-authorization/attempt-event-0002.bin",
    "03-authorization/attempt-event-0003.bin",
    "03-authorization/capability-counts.json",
    "03-authorization/human-attestation.json",
    "03-authorization/policy-probe.json",
)
V2_FILES = V1_FILES[:5] + (
    "03-authorization/attempt-event-0004.bin",
) + V1_FILES[5:]
MISSING = (
    "manifest.bin",
