#!/bin/zsh -f
set -euo pipefail
typeset -r iicc_failure_self_sha=8dd8609068a9f22acdd2d865f8af250f4f112aab15e6968ba8bfdbb4cd67fdac # iicc-failure-self-seal
if [[ $0 != /dev/fd/9 ]]; then
    self=${0:A}
    [[ -f $self && ! -L $self ]] || exit 2
    exec 9<"$self"
    exec /bin/zsh -f /dev/fd/9 "$@"
fi

[[ $# == 2 ]] || {
    print -u2 "Usage: scripts/verify-investigation-runtime-machine-failure <evidence-root> <disposition.json>"
    exit 2
}

exec /usr/bin/python3 -I - "$1" "$2" "$iicc_failure_self_sha" 9 <<'PY'
import ctypes
