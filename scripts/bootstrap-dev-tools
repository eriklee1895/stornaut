#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
source "$repo_root/scripts/dev-tools-common"

function install_xcodebuildmcp() {
    if verify_xcodebuildmcp_install >/dev/null 2>&1; then
        print "XcodeBuildMCP $STORNAUT_XCODEBUILDMCP_VERSION is already installed."
        return
    fi

    print "Installing XcodeBuildMCP $STORNAUT_XCODEBUILDMCP_VERSION from the committed lockfile..."
    npm ci \
        --ignore-scripts \
        --no-audit \
        --no-fund \
        --registry=https://registry.npmjs.org \
        --prefix "$repo_root/tools/xcodebuildmcp"

    verify_xcodebuildmcp_install
}

function install_peekaboo() {
    if verify_peekaboo_install >/dev/null 2>&1; then
        print "Peekaboo $STORNAUT_PEEKABOO_VERSION is already installed."
        return
    fi

    local install_root install_dir archive_url temporary_dir archive extracted_dir
    install_root="$repo_root/.dev-tools/peekaboo"
    install_dir=$(stornaut_peekaboo_dir)
    archive_url="https://github.com/openclaw/Peekaboo/releases/download/v$STORNAUT_PEEKABOO_VERSION/peekaboo-macos-universal.tar.gz"
    temporary_dir=$(mktemp -d)
    archive="$temporary_dir/peekaboo.tar.gz"
    extracted_dir="$temporary_dir/peekaboo-macos-universal"
    trap 'rm -rf "$temporary_dir"' EXIT

    print "Downloading signed Peekaboo $STORNAUT_PEEKABOO_VERSION release..."
    curl -fsSL "$archive_url" -o "$archive"
    print "$STORNAUT_PEEKABOO_ARCHIVE_SHA256  $archive" | shasum -a 256 -c -

    tar -xzf "$archive" -C "$temporary_dir"
    for expected_file in peekaboo libswiftCompatibilitySpan.dylib LICENSE VERSION; do
        test -f "$extracted_dir/$expected_file"
    done

    rm -rf "$install_dir"
    mkdir -p "$install_root"
    mv "$extracted_dir" "$install_dir"
    chmod 0755 "$install_dir/peekaboo"

    verify_peekaboo_install
    rm -rf "$temporary_dir"
    trap - EXIT
}

install_xcodebuildmcp
install_peekaboo

print "Development tools are installed under ignored repository-local directories."
print "Run scripts/doctor-dev-tools to verify MCP catalogs and local permissions."
