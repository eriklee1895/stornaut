if (
    value(driver_proxy_body, "remoteGlobalIDString") != driver_id
    or value(driver_proxy_body, "remoteInfo") != driver_name
):
    raise SystemExit("Machine driver native dependency proxy drifted")
driver_proxies = [
    object_id
    for object_id, (_, body) in container_proxies.items()
    if value(body, "remoteGlobalIDString") == driver_id
]
if driver_proxies != [driver_proxy]:
    raise SystemExit("Machine driver native dependency proxy is not unique")

tool_specs = (
    ("StornautInvestigationMachineDriverNative", "StornautInvestigationMachineDriver", "StornautInvestigationMachineDriverSupport", "Tools/StornautInvestigationMachineDriver/main.swift", "com.eriklee.stornaut.investigation.machine-driver"),
    ("StornautInvestigationMachineGateNative", "StornautInvestigationMachineGate", "StornautInvestigationMachineGateSupport", "tools/StornautInvestigationMachineGate/main.swift", "com.eriklee.stornaut.investigation.machine-gate"),
    ("StornautInvestigationMachineGateCoordinatorNative", "StornautInvestigationMachineGateCoordinator", "StornautInvestigationMachineGateCoordinatorSupport", "tools/StornautInvestigationMachineGateCoordinator/main.swift", "com.eriklee.stornaut.investigation.machine-gate-coordinator"),
)
tool_ids = {}
tool_product_refs = {}
tool_support_products = {}
tool_dependency_objects = {}
tool_artifact_build_files = set()
for tool_name, product_name, support_name, main_path, signing_identifier in tool_specs:
    tool_id, tool_body = native_by_name[tool_name]
    tool_ids[tool_name] = tool_id
    phase_ids = [key for key, _ in references(tool_body, "buildPhases")]
    if Counter(phase_types.get(key, "other") for key in phase_ids) != Counter({"PBXSourcesBuildPhase": 1, "PBXFrameworksBuildPhase": 1}):
        raise SystemExit(f"Machine tool native phase graph drifted: {tool_name}")
    if references(tool_body, "dependencies"):
        raise SystemExit(f"Machine tool gained native dependency: {tool_name}")
    if value(tool_body, "productType") != "com.apple.product-type.tool" or value(tool_body, "productName") != product_name:
        raise SystemExit(f"Machine tool product drifted: {tool_name}")
    product_ref, _ = reference(tool_body, "productReference")
    tool_product_refs[product_name] = product_ref
    product_body = file_references[product_ref][1]
    if value(product_body, "path") != product_name or value(product_body, "sourceTree") != "BUILT_PRODUCTS_DIR" or value(product_body, "explicitFileType") != "compiled.mach-o.executable":
        raise SystemExit(f"Machine tool product reference drifted: {tool_name}")
    source_refs = [key for key, (_, body) in file_references.items() if value(body, "path") == main_path]
    if len(source_refs) != 1:
        raise SystemExit(f"Machine tool main source drifted: {tool_name}")
    source_builds = [key for key, (_, body) in build_files.items() if re.search(rf"(?:^|;)[ \t]*fileRef = {source_refs[0]} /\* .*? \*/;", body, re.MULTILINE)]
    if len(source_builds) != 1:
        raise SystemExit(f"Machine tool main build file drifted: {tool_name}")
    source_phase = next(key for key in phase_ids if key in source_phases)
    if [key for key, _ in references(source_phases[source_phase][1], "files")] != source_builds:
        raise SystemExit(f"Machine tool source phase drifted: {tool_name}")
    supports = [key for key, (_, body) in package_products.items() if value(body, "productName") == support_name]
    if len(supports) != 1:
        raise SystemExit(f"Machine tool support product drifted: {tool_name}")
    tool_support_products[tool_name] = supports[0]
    if [key for key, _ in references(tool_body, "packageProductDependencies")] != supports:
        raise SystemExit(f"Machine tool package dependency drifted: {tool_name}")
    support_builds = [key for key, (_, body) in build_files.items() if re.search(rf"(?:^|;)[ \t]*productRef = {supports[0]} /\* .*? \*/;", body, re.MULTILINE)]
    if len(support_builds) != 1:
        raise SystemExit(f"Machine tool support build file drifted: {tool_name}")
    framework_phase = next(key for key in phase_ids if key in framework_phases)
    if [key for key, _ in references(framework_phases[framework_phase][1], "files")] != support_builds:
        raise SystemExit(f"Machine tool framework phase drifted: {tool_name}")
    dependency_objects = [key for key, target in dependency_targets.items() if target == tool_id]
    if len(dependency_objects) != 1:
        raise SystemExit(f"Machine tool dependency object drifted: {tool_name}")
    tool_dependency_objects[tool_name] = dependency_objects[0]
    tool_artifact_build_files.update(source_builds + support_builds)
    configuration_list, _ = reference(tool_body, "buildConfigurationList")
    configurations = references(
        configuration_lists[configuration_list][1], "buildConfigurations"
    )
    if [name for _, name in configurations] != ["Debug", "Release"]:
        raise SystemExit(f"Machine tool configuration list drifted: {tool_name}")
    for configuration_id, configuration_name in configurations:
        configuration = build_configurations[configuration_id][1]
        for marker in (
            'ARCHS = arm64', 'CODE_SIGN_IDENTITY = "-"',
            'CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO',
            'CODE_SIGN_STYLE = Manual', 'ENABLE_HARDENED_RUNTIME = NO',
            'OTHER_SWIFT_FLAGS = "$(inherited) -parse-as-library"',
            f'PRODUCT_BUNDLE_IDENTIFIER = {signing_identifier}',
            f'PRODUCT_MODULE_NAME = {tool_name}',
            f'PRODUCT_NAME = {product_name}', 'SKIP_INSTALL = YES',
        ):
            if marker not in configuration:
                raise SystemExit(
                    f"Machine tool {configuration_name} setting drifted: {tool_name}: {marker}"
                )
        if 'CODE_SIGN_ENTITLEMENTS' in configuration:
            raise SystemExit(f"Machine tool gained entitlements: {tool_name}")
        coordinator_only_settings = (
            'CONFIGURATION_BUILD_DIR = "$(BUILD_DIR)/$(CONFIGURATION)/StornautInvestigationMachineGateCoordinatorNative"',
            'SWIFT_INCLUDE_PATHS = "$(inherited) $(BUILD_DIR)/$(CONFIGURATION)"',
            'LD_RUNPATH_SEARCH_PATHS = "$(inherited) @executable_path/../Frameworks"',
        )
        if tool_name == "StornautInvestigationMachineGateCoordinatorNative":
            for setting in coordinator_only_settings:
                if setting not in configuration:
                    raise SystemExit(
                        f"Coordinator native output isolation drifted: {setting}"
                    )
        elif any(setting in configuration for setting in coordinator_only_settings):
            raise SystemExit(f"Unexpected Machine tool output isolation: {tool_name}")

diagnostic_name = "StornautInvestigationDiagnosticApp"
diagnostic_id, diagnostic_body = native_by_name[diagnostic_name]
release_shell_name = "StornautInvestigationDiagnosticReleaseShell"
release_shell_id, release_shell_body = native_by_name[release_shell_name]
diagnostic_dependency_ids = [
    object_id
    for object_id, _ in references(diagnostic_body, "dependencies")
]
diagnostic_dependency_targets = [
    dependency_targets[object_id] for object_id in diagnostic_dependency_ids
]
helper_id = native_by_name["StornautLifecycleHelper"][0]
if Counter(diagnostic_dependency_targets) != Counter(
    {helper_id: 1, **{value: 1 for value in tool_ids.values()}}
):
    raise SystemExit(
        "Diagnostic App native dependencies must be exactly helper plus three machine tools"
    )
for tool_name, dependency in tool_dependency_objects.items():
    if diagnostic_dependency_ids.count(dependency) != 1:
        raise SystemExit(f"Diagnostic App machine-tool dependency drifted: {tool_name}")
if references(release_shell_body, "dependencies"):
    raise SystemExit("Release shell gained a native target dependency")
if references(release_shell_body, "packageProductDependencies"):
    raise SystemExit("Release shell gained a package product dependency")
if value(release_shell_body, "productType") != (
    "com.apple.product-type.application"
):
    raise SystemExit("Release shell is not an App target")
if value(release_shell_body, "productName") != release_shell_name:
    raise SystemExit("Release shell product name drifted")
release_shell_product_ref, _ = reference(
    release_shell_body, "productReference"
)
release_shell_product_body = file_references[release_shell_product_ref][1]
if (
    value(release_shell_product_body, "path")
        != f"{release_shell_name}.app"
    or value(release_shell_product_body, "sourceTree")
        != "BUILT_PRODUCTS_DIR"
    or value(release_shell_product_body, "explicitFileType")
        != "wrapper.application"
):
    raise SystemExit("Release shell product reference drifted")

release_shell_phase_ids = [
    object_id
    for object_id, _ in references(release_shell_body, "buildPhases")
]
release_shell_phase_types = Counter(
    phase_types.get(object_id, "other")
    for object_id in release_shell_phase_ids
)
if release_shell_phase_types != Counter({
    "PBXSourcesBuildPhase": 1,
    "PBXFrameworksBuildPhase": 1,
    "PBXResourcesBuildPhase": 1,
}):
    raise SystemExit(
        "Release shell phase graph drifted: "
        f"{dict(release_shell_phase_types)}"
    )
release_shell_framework_phase = next(
    object_id
    for object_id in release_shell_phase_ids
    if object_id in framework_phases
)
release_shell_resource_phase = next(
    object_id
    for object_id in release_shell_phase_ids
    if object_id in resource_phases
)
if references(
    framework_phases[release_shell_framework_phase][1], "files"
) or references(
    resource_phases[release_shell_resource_phase][1], "files"
):
    raise SystemExit("Release shell Frameworks/Resources must be empty")

harness_file_refs = [
    object_id
    for object_id, (_, body) in file_references.items()
    if value(body, "path") == (
        "StornautApp/Diagnostics/"
        "InvestigationRuntimeDiagnosticHarness.swift"
    )
]
if len(harness_file_refs) != 1:
    raise SystemExit("Diagnostic harness file reference is not unique")
harness_file_ref = harness_file_refs[0]
harness_build_files = [
    object_id
    for object_id, (_, body) in build_files.items()
    if re.search(
        rf"(?:^|;)[ \t]*fileRef = {harness_file_ref} /\* .*? \*/;",
        body,
        re.MULTILINE,
    )
]
if len(harness_build_files) != 2:
    raise SystemExit("Expected two diagnostic harness build memberships")
diagnostic_source_phase = next(
    object_id
    for object_id, _ in references(diagnostic_body, "buildPhases")
    if object_id in source_phases
)
release_shell_source_phase = next(
    object_id
    for object_id in release_shell_phase_ids
    if object_id in source_phases
)
source_memberships = {
    phase_id: [
        object_id
        for object_id, _ in references(body, "files")
        if object_id in harness_build_files
    ]
    for phase_id, (_, body) in source_phases.items()
}
source_memberships = {
    phase_id: members
    for phase_id, members in source_memberships.items()
    if members
}
if (
    set(source_memberships)
        != {diagnostic_source_phase, release_shell_source_phase}
    or sorted(len(members) for members in source_memberships.values())
        != [1, 1]
    or set().union(*map(set, source_memberships.values()))
        != set(harness_build_files)
):
    raise SystemExit("Diagnostic harness source ownership drifted")

