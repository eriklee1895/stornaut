    xcrun swiftc -frontend -parse "$focused_test_source"
    python3 - "$composer_source" "$focused_test_source" <<'PY'
from pathlib import Path
import hashlib
import re
import sys

composer_path, test_path = map(Path, sys.argv[1:])
composer = composer_path.read_text(encoding="utf-8")
test = test_path.read_text(encoding="utf-8")
imports = set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", composer))
if imports != {"Foundation", "StornautInvestigationHandoffContract"}:
    raise SystemExit("ii-b5a dependency surface drifted")
if re.search(r"(?m)^\s*(?:public|open)\s+", composer):
    raise SystemExit("ii-b5a public surface drifted")
for forbidden in (
    "Codable", "Encodable", "Decodable", "readiness", "receipt",
    "FileManager", "FileHandle", "Process(", "NSXPC", "URLSession",
    "socketpair(", "posix_spawn", "fork(", "execv(", "execve(", "kill(",
    "waitpid(", "setuid(", "setgid(", "dup2(", "Darwin.write(",
):
    if forbidden in composer:
        raise SystemExit("ii-b5a authority or non-admission surface drifted")
if composer.count("140_000_000_000") != 1 or (
    composer.count("continuousNanoseconds()") != 2
    or "addingReportingOverflow(" not in composer
    or "InvestigationHandoffEpochBootstrap(" not in composer
):
    raise SystemExit("ii-b5a internal deadline ownership drifted")
for forbidden in ("@main", "InvestigationMachineDriverSupport", "CommandLine", "exit("):
    if forbidden in composer:
        raise SystemExit("ii-b5a entry reachability drifted")
expected = {
    composer_path: "c6cc195f447dbe660139be5a0bec14c07342bc35bbdd24f737455c7c0a699291",
    test_path: "f9dd54bf1c67589dd46c1387ccdc49e77581df275159632f40b7ef0c4d2390a9",
}
for path, digest in expected.items():
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        label = "composer" if path == composer_path else "focused test"
        raise SystemExit(f"ii-b5a canonical {label} source drifted")
