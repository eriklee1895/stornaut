    )

driver_free_targets = (
    "StornautApp",
    "StornautAppTests",
    "StornautAppUITests",
    "StornautLifecycleHelper",
    "StornautInvestigationDiagnosticAppTests",
    "StornautInvestigationDiagnosticReleaseShell",
)
driver_artifact_build_files = {
    main_build_file,
    support_build_file,
    driver_copy_build_file,
}
all_phase_objects = {**copy_phases, **source_phases, **framework_phases}
for target_name in driver_free_targets:
    _, body = native_by_name[target_name]
    dependency_ids = {
        object_id for object_id, _ in references(body, "dependencies")
    }
    if driver_dependency in dependency_ids:
        raise SystemExit(f"{target_name} gained Machine driver dependency")
    package_ids = {
        object_id
        for object_id, _ in references(
            body,
            "packageProductDependencies",
        )
    }
    if support_product in package_ids:
        raise SystemExit(f"{target_name} gained DriverSupport membership")
    target_phase_ids = {
        object_id for object_id, _ in references(body, "buildPhases")
    }
    if driver_copy_phase in target_phase_ids:
        raise SystemExit(f"{target_name} gained Machine driver copy phase")
    member_build_files = set()
    for phase_id in target_phase_ids:
        phase = all_phase_objects.get(phase_id)
        if phase is not None:
            member_build_files.update(
                object_id
                for object_id, _ in references(phase[1], "files")
            )
    escaped = member_build_files & driver_artifact_build_files
    if escaped:
        raise SystemExit(
            f"{target_name} gained Machine driver build membership: "
            f"{sorted(escaped)}"
        )


def load_scheme(path):
    try:
        return path.read_text(encoding="utf-8"), ET.parse(path).getroot()
    except (OSError, ET.ParseError) as error:
        raise SystemExit(f"Cannot parse Xcode scheme {path}: {error}")


ordinary_scheme_text, ordinary_scheme_root = load_scheme(ordinary_scheme_path)
diagnostic_scheme_text, diagnostic_scheme_root = load_scheme(
    diagnostic_scheme_path
)
driver_product_name = "StornautInvestigationMachineDriver"
driver_identity = {driver_id, driver_name, driver_product_name}
for token in driver_identity:
    if token in ordinary_scheme_text:
        raise SystemExit(
            f"Ordinary scheme gained Machine driver identity: {token}"
        )


def is_driver_reference(element):
    return bool(
        driver_identity
        & {
            element.get("BlueprintIdentifier", ""),
            element.get("BlueprintName", ""),
            element.get("BuildableName", ""),
        }
    )


if any(
    is_driver_reference(element)
    for element in ordinary_scheme_root.iter("BuildableReference")
):
    raise SystemExit("Ordinary scheme gained a Machine driver reference")
diagnostic_driver_references = [
    element
    for element in diagnostic_scheme_root.iter("BuildableReference")
    if is_driver_reference(element)
]
if len(diagnostic_driver_references) != 1:
    raise SystemExit(
        "Diagnostic scheme must contain exactly one Machine driver "
        f"reference, found {len(diagnostic_driver_references)}"
    )
driver_reference = diagnostic_driver_references[0]
expected_driver_reference = {
    "BuildableIdentifier": "primary",
    "BlueprintIdentifier": driver_id,
    "BuildableName": driver_product_name,
    "BlueprintName": driver_name,
    "ReferencedContainer": "container:Stornaut.xcodeproj",
}
if driver_reference.attrib != expected_driver_reference:
    raise SystemExit(
        "Diagnostic scheme Machine driver reference drifted: "
        f"{driver_reference.attrib!r}"
    )
driver_entries = []
for entry in diagnostic_scheme_root.findall(
    "./BuildAction/BuildActionEntries/BuildActionEntry"
):
    references_in_entry = entry.findall("./BuildableReference")
    if driver_reference in references_in_entry:
        driver_entries.append(entry)
if len(driver_entries) != 1:
    raise SystemExit(
        "Diagnostic scheme must contain one explicit Machine driver "
        "BuildActionEntry"
    )
expected_driver_entry = {
    "buildForTesting": "YES",
    "buildForRunning": "YES",
    "buildForProfiling": "NO",
    "buildForArchiving": "NO",
    "buildForAnalyzing": "YES",
}
if driver_entries[0].attrib != expected_driver_entry:
    raise SystemExit(
        "Diagnostic scheme Machine driver build entry drifted: "
        f"{driver_entries[0].attrib!r}"
    )
if diagnostic_scheme_text.count(driver_id) != 1:
    raise SystemExit(
        "Diagnostic scheme Machine driver target identifier is not unique"
    )
