for marker in (
    "LifecycleMachineClaimXPCClient",
    "LifecycleMachineClaimXPCServerNamespace",
    "LifecycleMachineClaimXPCReplyResolver",
    "remoteObjectProxy",
    "activeConnection",
):
    if marker in helper:
        raise SystemExit(
            f"legacy machine claim helper gained client authority: {marker}"
        )

combined_machine = host + "\n" + claim
for marker in (
    "LifecycleMachineClaimXPCClient",
    "LifecycleMachineClaimXPCWire",
    "LifecycleMachineClaimXPCError",
    "NSXPCConnection",
    "LifecycleLocalInstallationContract",
    "helperExecutableURL",
    "SecurityLifecycleCodeSigningVerifier",
):
    if marker in combined_machine:
        raise SystemExit(
            f"legacy machine claim Machine consumer remains: {marker}"
        )

strict_source, _ = declaration(
    host,
    r"struct\s+StrictMachineRetirementClaimSource\s*:",
    "injected Machine source",
)
if strict_source.count("init(") != 1 or re.search(
    r"init\s*\(\s*fetch:", strict_source
) is None:
    raise SystemExit(
        "legacy machine claim injected source initializer drifted"
    )
for marker in (
    "init()",
    "serviceName",
    "machServiceName",
    "remoteObject",
    "activeConnection",
):
    if marker in strict_source:
        raise SystemExit(
            f"legacy machine claim injected source gained transport: {marker}"
        )

_, production_body = declaration(
    host,
    r"static\s+func\s+production\s*\(",
    "production factory",
)
normalized_production = re.sub(r"\s+", "", production_body)
expected_production = (
    "_=(configuration,appProcessIdentity,userID,handoff,transition,"
    "effectiveUserID,now)"
    "throwInvestigationMachineDriverHostError.implementationUnavailable"
)
if normalized_production != expected_production:
    raise SystemExit(
        "legacy machine claim production is not immediately typed unavailable"
    )

source_error, _ = declaration(
    claim,
    r"enum\s+InvestigationMachineRetirementClaimSourceError\s*:",
    "Machine-local source error",
)
if (
    "case outcomeUnknown" not in source_error
    or "public " in source_error
    or "package " in source_error
):
    raise SystemExit(
        "legacy machine claim Machine-local source error drifted"
    )
outcome_catch = re.search(
    r"catch\s+InvestigationMachineRetirementClaimSourceError"
    r"\.outcomeUnknown\s*\{(?P<body>.*?)\}",
    claim,
    re.DOTALL,
)
if outcome_catch is None:
    raise SystemExit(
        "legacy machine claim outcome-unknown mapping is missing"
    )
outcome_body = re.sub(r"\s+", "", outcome_catch.group("body"))
if outcome_body != (
    "throwInvestigationMachineRetirementClaimError.outcomeUnknown"
):
    raise SystemExit(
        "legacy machine claim external-state outcome priority drifted"
    )
PY
}

function verify_claim_server_contract() {
    local adapter_source=$1
    local effects_source=$2
    local deadline_source=$3
    python3 - "$adapter_source" "$effects_source" "$deadline_source" <<'PY'
from pathlib import Path
import re
import sys


def code_only(source, label):
    output = list(source)
    index = 0
    block_depth = 0
    delimiter = None
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if delimiter is not None:
            if source.startswith(delimiter, index):
                width = len(delimiter)
                output[index:index + width] = " " * width
                delimiter = None
                index += width
            elif delimiter == '"' and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source):
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif source.startswith('"""', index):
            output[index:index + 3] = "   "
            delimiter = '"""'
            index += 3
        elif source[index] == '"':
            output[index] = " "
            delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or delimiter is not None:
        raise SystemExit(f"{label} has an unterminated comment or string")
    return "".join(output)


def body(source, pattern, label):
    match = re.search(pattern, source)
    if match is None:
        raise SystemExit(f"claim server {label} drifted: {pattern}")
    opening = source.find("{", match.end())
    if opening < 0:
        raise SystemExit(f"claim server {label} has no body: {pattern}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    raise SystemExit(f"claim server {label} body is unterminated: {pattern}")


def bodies(source, pattern, label):
    results = []
    for match in re.finditer(pattern, source):
        opening = source.find("{", match.end())
        if opening < 0:
            raise SystemExit(f"claim server {label} has no body: {pattern}")
        depth = 0
        for index in range(opening, len(source)):
            if source[index] == "{":
                depth += 1
            elif source[index] == "}":
                depth -= 1
                if depth == 0:
                    results.append(source[match.start():index + 1])
                    break
        else:
            raise SystemExit(
                f"claim server {label} body is unterminated: {pattern}"
            )
    return results


def require_patterns(source, patterns, label):
    for pattern in patterns:
        if re.search(pattern, source) is None:
            raise SystemExit(f"claim server {label} drifted: {pattern}")


adapter_path, effects_path, deadline_path = map(Path, sys.argv[1:])
raw_sources = {
    "adapter": adapter_path.read_text(encoding="utf-8"),
    "effects": effects_path.read_text(encoding="utf-8"),
    "deadline": deadline_path.read_text(encoding="utf-8"),
}
for source_name, source in raw_sources.items():
    if re.search(r"#+(?:\"|/)", source):
        raise SystemExit(
            f"claim server {source_name} gained raw literal or regex"
        )
adapter = code_only(raw_sources["adapter"], "adapter")
effects = code_only(raw_sources["effects"], "effects")
deadline = code_only(raw_sources["deadline"], "deadline")
for source_name, source in (
    ("adapter", adapter), ("effects", effects), ("deadline", deadline),
):
    if re.search(r"(?m)^\s*#(?:if|elseif|else|endif)\b", source):
        raise SystemExit(
            f"claim server {source_name} gained conditional compilation"
        )
    if re.search(r"(?m)(?:^|[^/])/(?![/*])[^\n/]+/(?:[A-Za-z]*)", source):
        raise SystemExit(
            f"claim server {source_name} gained raw literal or regex"
        )

adapter_imports = re.findall(
    r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", adapter
)
if adapter_imports != [
    "CryptoKit", "Foundation",
    "StornautInvestigationHandoffContract", "StornautLifecycle",
]:
    raise SystemExit(f"claim server adapter imports drifted: {adapter_imports}")
effects_imports = re.findall(
    r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", effects
)
if effects_imports != ["Darwin", "Foundation", "StornautLifecycle"]:
    raise SystemExit(f"claim server effects imports drifted: {effects_imports}")

terminal_action = body(
    effects,
    r"private\s+final\s+class\s+"
        r"DarwinInvestigationMachineClaimServerPhysicalTerminalAction\s*:\s*"
        r"InvestigationMachineClaimServerPhysicalTerminalAction\s*,\s*"
        r"@unchecked\s+Sendable",
    "physical terminal authority",
)
require_patterns(terminal_action, (
    r"private\s+let\s+queue\s*=\s*DispatchQueue\s*\(",
    r"func\s+scheduleExit\s*\(\s*status:\s*Int32\s*,\s*"
        r"delayNanoseconds:\s*UInt64\s*\)",
    r"if\s+delayNanoseconds\s*==\s*0",
    r"queue\.async\s*\{\s*exit\s*\(\s*status\s*\)\s*\}",
    r"queue\.asyncAfter",
    r"\.nanoseconds\s*\(\s*Int\s*\(\s*delayNanoseconds\s*\)\s*\)",
), "physical terminal authority")
if terminal_action.count("exit(status)") != 2:
    raise SystemExit("claim server physical terminal exit cardinality drifted")
terminal_properties = re.findall(
    r"(?m)^\s*private\s+let\s+([A-Za-z_][A-Za-z0-9_]*)\s*=",
    terminal_action,
)
terminal_functions = re.findall(
    r"(?m)^\s*func\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(",
    terminal_action,
)
terminal_calls = re.findall(
    r"(?<![A-Za-z0-9_])([A-Za-z_][A-Za-z0-9_.]*)\s*\(",
    terminal_action,
)
if terminal_properties != ["queue"] or terminal_functions != ["scheduleExit"]:
    raise SystemExit(
        "claim server physical terminal authority drifted: "
        f"properties={terminal_properties}, functions={terminal_functions}"
    )
if terminal_calls != [
    "DispatchQueue", "scheduleExit", "exit", "queue.asyncAfter",
    "now", "nanoseconds", "Int", "exit",
]:
    raise SystemExit(
        f"claim server physical terminal authority drifted: calls={terminal_calls}"
    )
effects_without_terminal_action = effects.replace(
    terminal_action, " " * len(terminal_action), 1
)

for source_name, source in (
    ("adapter", adapter),
    ("effects", effects_without_terminal_action),
):
    authority = re.search(
        r"\b(?:NSXPCConnection|NSXPCListener|NSXPCListenerEndpoint|"
        r"FileManager|URLSession|Process|Security|ActionExecutor|Policy|"
        r"Cleanup|Executor|StornautExecution)\b|"
        r"\b(?:exit|kill|posix_spawn|unlink|rename|socket|connect)\s*\(",
        source,
    )
    if authority:
        raise SystemExit(
            f"claim server {source_name} gained authority: "
            f"{authority.group(0)!r}"
        )

projection = body(
    adapter,
    r"private\s+struct\s+InvestigationMachineClaimServerProjection\b",
    "sealed transfer projection",
)
projection_init = body(
    projection,
    r"init\s*\(\s*transfer\s*:\s*"
        r"LifecycleMachineRetirementReservationTransfer",
    "sealed transfer initializer",
)
require_patterns(projection_init, (
    r"transfer\.ownerRetirementObservation\s*==\s*"
        r"\.retiredOwnedResources",
    r"transfer\.residueObservation\.provedEmpty",
    r"transfer\.residueObservation\.investigationID\s*==\s*"
        r"transfer\.investigationID",
    r"transfer\.residueObservation\.auditSessionID\s*==\s*"
        r"transfer\.helperIdentity\.auditSessionID",
    r"transfer\.residueObservation\.userID\s*==\s*transfer\.userID",
    r"\(0\.\.\.60_000_000\)\.contains\(residueAge\.partialValue\)",
    r"handoffOwnerRetirement\s*\(\s*"
        r"transfer\.ownerRetirementObservation",
    r"handoffL1Residue\s*\(\s*transfer\.residueObservation",
), "sealed transfer admission")
if "LifecycleMachineRetirementReservationTransfer(" in adapter:
    raise SystemExit("claim server re-minted sealed transfer")

if re.search(r"package\s+actor\s+InvestigationMachineClaimServerAdapter", adapter):
    raise SystemExit("claim server adapter regained actor isolation")
adapter_class = body(
    adapter,
    r"package\s+final\s+class\s+"
        r"InvestigationMachineClaimServerAdapter\s*:\s*"
        r"@unchecked\s+Sendable",
    "non-actor adapter",
)
require_patterns(adapter_class, (
    r"private\s+let\s+evidenceLock\s*=\s*NSLock\s*\(\s*\)",
    r"transfer\s*:\s*LifecycleMachineRetirementReservationTransfer",
), "non-actor adapter boundary")
claim = body(adapter_class, r"package\s+func\s+claim\s*\(", "claim")
release = body(adapter_class, r"package\s+func\s+release\s*\(", "release")
reply = body(
    adapter_class, r"package\s+func\s+replyDidDispatch\s*\(", "reply"
)
next_observation = body(
    adapter_class, r"private\s+func\s+nextObservation\s*\(",
    "operation observation",
)
require_patterns(claim, (
    r"ownerRetirement:\s*projection\.ownerRetirement",
    r"l1Residue:\s*projection\.l1Residue",
    r"evidenceLock\.withLock\s*\{\s*evidence\s*=\s*value\s*\}",
    r"state\.commitClaimResponse\s*\(",
    r"if\s+evidence\s*==\s*value\s*\{\s*evidence\s*=\s*nil\s*\}",
), "claim projection")
lock_bodies = bodies(
    adapter_class, r"evidenceLock\.withLock", "evidence lock"
)
normalized_lock_bodies = [re.sub(r"\s+", "", value) for value in lock_bodies]
allowed_lock_bodies = [
    "evidenceLock.withLock{evidence=value}",
    "evidenceLock.withLock{ifevidence==value{evidence=nil}}",
    "evidenceLock.withLock({evidence}",
    "evidenceLock.withLock({evidence}",
    "evidenceLock.withLock{evidence!=nil}",
    "evidenceLock.withLock({evidence}",
]
if sorted(normalized_lock_bodies) != sorted(allowed_lock_bodies):
    raise SystemExit(
        f"claim server evidence lock scope drifted: {normalized_lock_bodies}"
    )
claim_order = (
    re.search(r"let\s+encoded\s*=\s*try\s+value\.encoded\s*\(\s*\)", claim),
    re.search(r"evidenceLock\.withLock\s*\{\s*evidence\s*=\s*value\s*\}", claim),
    re.search(r"let\s+committed\s*=\s*state\.commitClaimResponse\s*\(", claim),
    re.search(r"try\s+requireApplied\s*\(\s*committed\s*\)", claim),
    re.search(r"return\s+encoded", claim),
)
if not (
    all(claim_order)
    and all(
        earlier.start() < later.start()
        for earlier, later in zip(claim_order, claim_order[1:])
    )
):
    raise SystemExit("claim server claim response commit order drifted")
if re.search(r"ownerRetirement:\s*InvestigationMachineOwnerRetirement\s*\(", claim):
    raise SystemExit("claim server claim synthesized owner retirement")
require_patterns(release, (
    r"release\.requestBindingSHA256\.rawBytes",
    r"release\.claimedHelperIdentitySHA256\.rawBytes",
    r"release\.claimConnectionEpoch\s*==\s*"
        r"evidence\.claimConnectionEpoch",
    r"release\.releaseDeadlineNanoseconds\s*"
        r"==\s*evidence\.releaseDeadlineNanoseconds",
    r"state\.commitReleaseResponse\s*\(",
), "release binding")
if not re.search(
    r"catch\s*\{\s*rejectBinding\s*\(\s*\)\s*"
    r"throw\s+InvestigationMachineClaimServerError\.bindingMismatch",
    release,
):
    raise SystemExit("claim server malformed release reason drifted")
release_order = (
    re.search(
        r"let\s+encoded\s*=\s*try\s+"
        r"InvestigationMachineClaimReleased\s*\(",
        release,
    ),
    re.search(
        r"let\s+committed\s*=\s*state\.commitReleaseResponse\s*\(",
        release,
    ),
    re.search(r"try\s+requireApplied\s*\(\s*committed\s*\)", release),
    re.search(r"return\s+encoded", release),
)
if not (
    all(release_order)
    and all(
        earlier.start() < later.start()
        for earlier, later in zip(release_order, release_order[1:])
    )
):
    raise SystemExit("claim server release response commit order drifted")
if "expectedReleaseChallenge" in adapter or re.search(
    r"release\s*\.\s*validate\s*\(", release
):
    raise SystemExit("claim server release regained self-challenge validation")
require_patterns(reply, (
    r"state\.replyDidDispatch\s*\(",
), "reply commitment")
require_patterns(next_observation, (
    r"state\.rejectOperationObservation\s*\(",
    r"reservationID:\s*reservationID",
    r"executor\.apply\s*\(\s*transition,\s*to:\s*state\s*\)",
), "operation rejection")

owner_projection = body(
    adapter, r"private\s+func\s+handoffOwnerRetirement\s*\(",
    "owner projection",
)
require_patterns(owner_projection, (
    r"observation\.resourceOwnership\s*==\s*\.owned",
    r"observation\.processGroupTerminated",
    r"observation\.standardErrorContained",
    r"observation\.workspaceRemoved",
), "owner projection")
residue_projection = body(
    adapter, r"private\s+func\s+handoffL1Residue\s*\(",
    "residue projection",
)
for marker in (
    "observation.investigationID.rawValue",
    "observation.auditSessionID",
    "observation.userID",
    "observation.remainingAuditSessionMemberCount",
    "observation.matchingLeaseCount",
    "observation.leaseRootEntryCount",
    "observation.investigationArtifactCount",
):
    if marker not in residue_projection:
        raise SystemExit(f"claim server residue projection drifted: {marker}")

executor = body(
    effects,
    r"package\s+final\s+class\s+"
        r"InvestigationMachineClaimServerEffectExecutor\b",
    "effect executor",
)
slot = body(executor, r"private\s+final\s+class\s+Slot\b", "slot")
require_patterns(slot, (
    r"private\s+var\s+cancelRequested\s*=\s*false",
    r"private\s+var\s+cancelApplied\s*=\s*false",
    r"private\s+var\s+callbackFinished\s*=\s*false",
    r"callbackFinished\s*=\s*true",
    r"removeSlot:\s*callbackFinished\s*\|\|\s*cancelRequested",
), "slot lifecycle")
schedule = body(executor, r"private\s+func\s+schedule\s*\(", "schedule")
require_patterns(schedule, (
    r"defer\s*\{\s*finishCallback\s*\(\s*ticket\s*\)\s*\}",
    r"state\.rejectObservation\s*\(\s*ticket:\s*ticket\s*\)",
    r"perform\s*\(\s*slot\.install\s*\(\s*handle\s*\),"
        r"\s*ticket:\s*ticket\s*\)",
), "callback ownership")
arm_match = re.search(r"let\s+armed\s*=\s*state\.armSucceeded\s*\(\s*ticket\s*\)", schedule)
apply_arm_match = re.search(r"try\s+apply\s*\(\s*armed,\s*to:\s*state\s*\)", schedule)
install_match = re.search(
    r"perform\s*\(\s*slot\.install\s*\(\s*handle\s*\),"
    r"\s*ticket:\s*ticket\s*\)",
    schedule,
)
if not (
    arm_match and apply_arm_match and install_match
    and arm_match.start() < apply_arm_match.start() < install_match.start()
):
    raise SystemExit("claim server arm/install linearization drifted")
if "rejectOperationObservation" in effects:
    raise SystemExit("claim server callback used operation-bound rejection")

deadline_class = body(
    deadline,
    r"package\s+final\s+class\s+"
        r"LifecycleMachineRetirementEscrowDeadlineState\b",
    "deadline owner",
)
binding_rejection = body(
    deadline_class, r"package\s+func\s+rejectBinding\s*\(",
    "binding rejection",
)
callback_rejection = body(
    deadline_class, r"package\s+func\s+rejectObservation\s*\(",
    "callback rejection",
)
operation_rejection = body(
    deadline_class,
    r"package\s+func\s+rejectOperationObservation\s*\(",
    "operation rejection seam",
)
claim_commit = body(
    deadline_class, r"package\s+func\s+commitClaimResponse\s*\(",
    "claim response commit",
)
release_commit = body(
    deadline_class, r"package\s+func\s+commitReleaseResponse\s*\(",
    "release response commit",
)
require_patterns(claim_commit, (
    r"context\.reservation\.reservationID\s*==\s*reservationID",
    r"context\.connectionEpoch\s*==\s*connectionEpoch",
    r"state\s*=\s*\.claimed\s*\(\s*context,\s*ticket\s*\)",
), "claim response commit")
require_patterns(release_commit, (
    r"context\.claim\.reservation\.reservationID\s*==\s*reservationID",
    r"context\.claim\.connectionEpoch\s*==\s*connectionEpoch",
    r"context\.releaseChallenge\s*==\s*releaseChallenge",
    r"state\s*=\s*\.releasedWaiting\s*\(\s*context\s*\)",
), "release response commit")
for label, commit in (
    ("claim", claim_commit), ("release", release_commit),
):
    if re.search(r"effects\s*:|\.schedule\s*\(|\.cancel\s*\(", commit):
        raise SystemExit(f"claim server {label} response commit gained effects")
require_patterns(binding_rejection, (
    r"context\.reservationID\s*==\s*reservationID",
    r"\.bindingMismatch",
    r"rememberLateArm:\s*pendingTicketLocked",
), "binding rejection")
require_patterns(callback_rejection, (
    r"currentTicketLocked\s*==\s*ticket",
    r"\.invalidTimeObservation",
    r"pendingTicketLocked\s*==\s*ticket\s*\?\s*ticket\s*:\s*nil",
), "callback rejection")
require_patterns(operation_rejection, (
    r"context\.reservationID\s*==\s*reservationID",
    r"\.invalidTimeObservation",
    r"rememberLateArm:\s*pendingTicketLocked",
), "operation rejection seam")
PY
}

function verify_claim_asid_contract() {
    local source=$1
    python3 - "$source" <<'PY'
from pathlib import Path
import re
import sys


def swift_code_only(source):
    output = list(source)
    index = 0
    block_depth = 0
    string_delimiter = None
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if string_delimiter is not None:
            if source.startswith(string_delimiter, index):
                width = len(string_delimiter)
                output[index:index + width] = " " * width
                string_delimiter = None
                index += width
            elif string_delimiter == '"' and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source):
                    if source[index + 1] != "\n":
                        output[index + 1] = " "
                    index += 2
                else:
                    index += 1
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            if end < 0:
                end = len(source)
            for offset in range(index, end):
                output[offset] = " "
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif source.startswith('\"\"\"', index):
            output[index:index + 3] = "   "
            string_delimiter = '"""'
            index += 3
        elif source[index] == '"':
            output[index] = " "
            string_delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or string_delimiter is not None:
        raise SystemExit("claim contract has unterminated comment or string")
    return "".join(output)


def declaration_body(source, pattern, start=0):
    match = re.search(pattern, source[start:])
    if match is None:
        raise SystemExit(f"missing claim declaration: {pattern}")
    declaration_start = start + match.start()
    opening = source.find("{", start + match.end())
    if opening < 0:
        raise SystemExit(f"claim declaration has no body: {pattern}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[declaration_start:index + 1], index + 1
    raise SystemExit(f"claim declaration body is unterminated: {pattern}")


source = Path(sys.argv[1]).read_text(encoding="utf-8")
code = swift_code_only(source)
evidence_body, evidence_end = declaration_body(
    code, r"package\s+struct\s+InvestigationMachineClaimEvidence\b"
)
evidence_init, _ = declaration_body(
    evidence_body, r"package\s+init\s*\("
)
evidence_validate, _ = declaration_body(
    evidence_body, r"package\s+func\s+validate\s*\("
)
expectation_body, _ = declaration_body(
    code,
    r"package\s+struct\s+InvestigationMachineClaimExpectation\b",
    evidence_end,
)
expectation_init, _ = declaration_body(
    expectation_body, r"package\s+init\s*\("
)
required = (
    (evidence_init, r"l1Residue\.auditSessionID\s*==\s*"
        r"helperIdentity\.auditSessionID"),
    (expectation_body, r"package\s+let\s+"
        r"helperAuditSessionID:\s*UInt32"),
    (evidence_validate, r"l1Residue\.auditSessionID\s*==\s*"
        r"expectation\.helperAuditSessionID"),
    (expectation_init, r"helperAuditSessionID\s*=\s*"
        r"helperIdentity\.auditSessionID"),
)
for scoped_source, pattern in required:
    if re.search(pattern, scoped_source) is None:
        raise SystemExit(f"claim evidence helper ASID join drifted: {pattern}")
for pattern in (
    r"(?:appIdentity\.auditSessionID\s*==\s*"
        r"helperIdentity\.auditSessionID|"
        r"helperIdentity\.auditSessionID\s*==\s*"
        r"appIdentity\.auditSessionID)",
    r"(?:l1Residue\.auditSessionID\s*==\s*"
        r"appIdentity\.auditSessionID|"
        r"appIdentity\.auditSessionID\s*==\s*"
        r"l1Residue\.auditSessionID)",
    r"(?:auditSessionID|helperAuditSessionID)\s*=\s*"
        r"appIdentity\.auditSessionID",
):
    if re.search(pattern, evidence_body + expectation_body):
        raise SystemExit(
            f"claim evidence regained invalid App/helper ASID join: {pattern}"
        )
PY
}

function verify_deadline_state_contract() {
    local source=$1
    python3 - "$source" <<'PY'
from pathlib import Path
import re
import sys


def code_only(source):
    output = list(source)
    index = 0
    block_depth = 0
    delimiter = None
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if delimiter is not None:
            if source.startswith(delimiter, index):
                width = len(delimiter)
                output[index:index + width] = " " * width
                delimiter = None
                index += width
            elif delimiter == '"' and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source):
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif source.startswith('\"\"\"', index):
            output[index:index + 3] = "   "
            delimiter = '"""'
            index += 3
        elif source[index] == '"':
            output[index] = " "
            delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or delimiter is not None:
        raise SystemExit("deadline state has unterminated comment or string")
    return "".join(output)


def body(source, pattern):
    match = re.search(pattern, source)
    if match is None:
        raise SystemExit(f"deadline state declaration drifted: {pattern}")
    opening = source.find("{", match.end())
    if opening < 0:
        raise SystemExit(f"deadline state declaration has no body: {pattern}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    raise SystemExit(f"deadline state declaration is unterminated: {pattern}")


source = Path(sys.argv[1]).read_text(encoding="utf-8")
code = code_only(source)
imports = re.findall(r"(?m)^\s*import\s+([A-Za-z0-9_]+)\s*$", code)
if imports != ["Foundation"]:
    raise SystemExit(f"deadline state imports drifted: {imports}")
for import_line in re.findall(r"(?m)^\s*.*\bimport\b.*$", code):
    if import_line.strip() != "import Foundation":
        raise SystemExit(f"deadline state import surface drifted: {import_line!r}")
declaration_prefix = (
    r"(?m)^\s*(?:@[A-Za-z_][A-Za-z0-9_.]*(?:\([^\n]*\))?\s+)*"
    r"(?:(?:final|nonisolated|distributed|indirect|static|class|"
    r"mutating|nonmutating|borrowing|consuming)\s+)*"
)
if re.search(declaration_prefix + r"(?:public|open)\s+", code):
    raise SystemExit("deadline state exposed public surface")
if re.search(r"(?m)(?:^|[^/])/(?![/*])[^\n/]+/(?:[A-Za-z]*)", code) \
        or re.search(r"\b(?:Regex|RegexBuilder)\b", code):
    raise SystemExit("deadline state gained regex-literal spoofing surface")
required_types = (
    "LifecycleMachineRetirementDeadlineValueError",
    "LifecycleMachineRetirementDeadlineDigest",
    "LifecycleMachineRetirementDeadlineObservation",
    "LifecycleMachineRetirementDeadlineReservation",
    "LifecycleMachineRetirementDeadlineClaim",
    "LifecycleMachineRetirementDeadlineRelease",
    "LifecycleMachineRetirementDeadlineKind",
    "LifecycleMachineRetirementDeadlineTicket",
    "LifecycleMachineRetirementDeadlineTerminalReason",
    "LifecycleMachineRetirementDeadlinePhase",
    "LifecycleMachineRetirementDeadlineDisposition",
    "LifecycleMachineRetirementDeadlineEffect",
    "LifecycleMachineRetirementDeadlineTransition",
)
for name in required_types:
    if not re.search(rf"(?m)^package\s+(?:enum|struct)\s+{name}\b", code):
        raise SystemExit(f"deadline state package type drifted: {name}")
class_body = body(
    code,
    r"(?m)^package\s+final\s+class\s+"
    r"LifecycleMachineRetirementEscrowDeadlineState\b",
)
required_methods = (
    "reserve", "armSucceeded", "armFailed", "claim", "release",
    "replyDidDispatch", "replyDispatchFailed", "deadlineFired",
    "cancel", "invalidate",
)
methods = {}
for name in required_methods:
    methods[name] = body(class_body, rf"package\s+func\s+{name}\s*\(")
for marker in (
    "maximumClaimRequestWindowMicroseconds",
    "maximumReleaseWindowNanoseconds",
    "maximumPostReplyExitWindowNanoseconds",
    "lateArmCancellation",
    "NSLock()",
):
    if marker not in class_body:
        raise SystemExit(f"deadline state owner marker drifted: {marker}")
authority = re.compile(
    r"\b(?:Codable|Encodable|Decodable|NSXPC\w*|Dispatch\w*|Task|"
    r"FileManager|URLSession|Process|Security|ActionExecutor|Policy|Cleanup|"
    r"Executor|StornautInvestigationHandoffContract)\b|"
    r"\b(?:exit|kill|posix_spawn|unlink|rename)\s*\("
)
match = authority.search(code)
if match:
    raise SystemExit(f"deadline state gained authority: {match.group(0)!r}")
arm_success = methods["armSucceeded"]
if not (
    re.search(r"lateArmCancellation\.remove\(ticket\)\s*!=\s*nil", arm_success)
    and re.search(r"effects:\s*\[\.cancel\(ticket\)\]", arm_success)
):
    raise SystemExit("deadline stale arm success no longer cancels timer")
if "lateArmCancellation" in methods["armFailed"]:
    raise SystemExit("deadline stale arm failure clears pending cancellation")
deadline_fired = methods["deadlineFired"]
for pattern in (
    r"let\s+isPending\s*=\s*pendingTicketLocked\s*==\s*ticket",
    r"cancelCurrent:\s*!isPending",
    r"rememberLateArm:\s*isPending\s*\?\s*ticket\s*:\s*nil",
):
    if not re.search(pattern, deadline_fired):
        raise SystemExit(f"deadline pending/armed callback drifted: {pattern}")
reply = methods["replyDidDispatch"]
if "checkedAdd" in reply or "maximumPostReplyExitWindowNanoseconds" in reply:
    raise SystemExit("reply dispatch regained deadline extension authority")
if not re.search(
    r"observation\.monotonicNanoseconds\s*<\s*"
    r"context\.postReplyExitDeadlineNanoseconds",
    reply,
):
    raise SystemExit("reply dispatch no longer checks retained deadline")
PY
}

function verify_claim_server_scope() {
    python3 - <<'PY'
import subprocess

checkpoints = (
    (
        "147247ffadcb37c8a7ab83983bf884bd858ac51b",
        "0e6a377f020d3e446ea9a8d7b045516d0bd9515b",
        "617b73625180d05591061abcbbb5f470bab00656",
        {"scripts/verify-investigation-boundaries"},
        650,
        "b1",
    ),
    (
        "08184b0a769d904b895636455688ada9e3c3e9e3",
        "147247ffadcb37c8a7ab83983bf884bd858ac51b",
        "2d9a22d0e9fc5158898fd3c2a304582c93ec8a94",
        {"scripts/verify-contract"},
        400,
        "b2",
    ),
)
for commit, parent, tree, expected_paths, ceiling, label in checkpoints:
    observed_parent = subprocess.check_output(
        ["git", "show", "-s", "--format=%P", commit], text=True
    ).strip()
    observed_tree = subprocess.check_output(
        ["git", "show", "-s", "--format=%T", commit], text=True
    ).strip()
    if observed_parent != parent or observed_tree != tree:
        raise SystemExit(
            f"claim server historical {label} identity drifted"
        )
    paths = {
        path
        for path in subprocess.check_output(
            ["git", "diff-tree", "--no-commit-id", "--name-only",
             "-r", commit],
            text=True,
        ).splitlines()
        if not path.startswith("docs/")
    }
    if paths != expected_paths:
        raise SystemExit(
            f"claim server historical {label} paths drifted: {sorted(paths)}"
        )
    changed_lines = 0
    for row in subprocess.check_output(
        ["git", "diff-tree", "--numstat", "--no-commit-id",
         "-r", commit],
        text=True,
    ).splitlines():
        added, deleted, path = row.split("\t")
        if path in expected_paths and added != "-" and deleted != "-":
            changed_lines += int(added) + int(deleted)
    if changed_lines > ceiling:
        raise SystemExit(
            f"claim server historical {label} budget drifted: "
            f"{changed_lines} > {ceiling}"
        )
PY
}

function verify_legacy_machine_claim_scope() {
    python3 - <<'PY'
from pathlib import Path
import subprocess

baseline = "ecd76e922f5433d023110910d4e777aa9c714592"
expected = {
    "Sources/StornautLifecycle/LifecycleSupervisorXPC.swift",
    "Sources/StornautInvestigationMachine/InvestigationMachineRetirementClaim.swift",
    "Sources/StornautInvestigationMachine/InvestigationMachineDriverHost.swift",
    "Tests/StornautLifecycleTests/LifecycleMachineClaimXPCContractTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineRetirementClaimTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineDriverHostTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift",
    "StornautLifecycleHelper/main.swift",
    "scripts/verify-app-release-boundaries",
    "scripts/verify-investigation-boundaries",
    "scripts/verify-contract",
}
descendants = subprocess.check_output(
    ["git", "rev-list", "--ancestry-path", "--reverse",
     f"{baseline}..HEAD"],
    text=True,
).splitlines()
if descendants:
    checkpoint = descendants[0]
    parent = subprocess.check_output(
        ["git", "show", "-s", "--format=%P", checkpoint], text=True
    ).strip()
    if parent != baseline:
        raise SystemExit(
            "legacy machine claim checkpoint is not the direct baseline child"
        )
    diff_command = ["git", "diff", "--numstat", baseline, checkpoint, "--"]
    name_command = ["git", "diff", "--name-only", baseline, checkpoint, "--"]
    untracked = set()
else:
    diff_command = ["git", "diff", "--numstat", baseline, "--"]
    name_command = ["git", "diff", "--name-only", baseline, "--"]
    untracked = set(subprocess.check_output(
        ["git", "ls-files", "--others", "--exclude-standard"],
        text=True,
    ).splitlines())
paths = set(subprocess.check_output(name_command, text=True).splitlines()) | untracked
non_document = {path for path in paths if not path.startswith("docs/")}
if non_document != expected:
    raise SystemExit(
        "legacy machine claim checkpoint paths drifted: "
        f"{sorted(non_document)}"
    )
changed_lines = 0
counted = set()
for row in subprocess.check_output(diff_command, text=True).splitlines():
    added, deleted, path = row.split("\t")
    if path in expected and added != "-" and deleted != "-":
        changed_lines += int(added) + int(deleted)
        counted.add(path)
for path in expected & untracked:
    changed_lines += len(Path(path).read_text(encoding="utf-8").splitlines())
    counted.add(path)
if counted != expected:
    raise SystemExit(
        "legacy machine claim checkpoint numstat drifted: "
        f"{sorted(counted)}"
    )
if changed_lines > 3_000:
    raise SystemExit(
        f"legacy machine claim checkpoint budget drifted: {changed_lines} > 3000"
    )
PY
}

