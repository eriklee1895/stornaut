    local total production tests verifier totals
    totals=$(
        git diff --cached --numstat "$baseline" | awk '
          index($3,"docs/")!=1 {
            if($1=="-"||$2=="-") exit 2
            n=$1+$2; total+=n
            if(index($3,"Sources/")==1||$3=="StornautLifecycleHelper/main.swift") production+=n
            else if(index($3,"Tests/")==1) tests+=n
            else if(index($3,"scripts/")==1) verifier+=n
          } END {print total+0, production+0, tests+0, verifier+0}'
    ) || {
        print -u2 "interactive-native binary checkpoint path rejected"
        return 1
    }
    read total production tests verifier <<< "$totals"
    (( total <= 2400 && production <= 900 && tests <= 1100 \
        && verifier <= 500 )) || {
        print -u2 "interactive-native checkpoint budget drifted"
        return 1
    }
    local -a unstaged=(${(f)"$(git diff --name-only --diff-filter=ACMRD --)"})
    local -a untracked=(${(f)"$(git ls-files --others --exclude-standard --)"})
    (( ${#unstaged} == 0 && ${#untracked} == 0 )) || {
        print -u2 "interactive-native checkpoint worktree is not staged-only"
        return 1
    }
    local item expected_mode entry
    for item in "${expected[@]}"; do
        expected_mode=100644
        [[ $item == scripts/* ]] && expected_mode=100755
        entry=$(git ls-files -s -- "$item")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $item" \
            && "$(print -r -- "$entry" | awk '{print $2}')" \
                == "$(git hash-object -- "$item")" ]] || {
            print -u2 "interactive-native staged source/mode drifted: $item"
            return 1
        }
    done
}

