    if git diff --cached --name-only --diff-filter=D "$baseline" | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'; then print -u2 "ii-b5b-i-c2b-ii-b checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'; then print -u2 "ii-b5b-i-c2b-ii-b binary checkpoint path rejected"; return 1; fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1')"})
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || { print -u2 "ii-b5b-i-c2b-ii-b checkpoint paths drifted"; return 1; }
    local changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 {n+=$1+$2} END {print n+0}')
    (( changed <= 800 )) || { print -u2 "ii-b5b-i-c2b-ii-b checkpoint budget drifted"; return 1; }
}

function verify_iib5bic2b_aggregate_scope() {
    local baseline=${1:-58332ccb9f78da203fb2380ca006c49f0f371c2b}
    [[ "$(git rev-parse "$baseline^{commit}")" == 58332ccb9f78da203fb2380ca006c49f0f371c2b ]] || { print -u2 "ii-b5b-i-c2b aggregate baseline drifted"; return 1; }
    local expected=(
        Sources/StornautInvestigationMachine/InvestigationLifecycleTopologyCollector.swift
