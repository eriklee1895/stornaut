def code_only(source):
    output = list(source)
    index = 0
    block_depth = 0
    string_end = None
    raw_hashes = ""
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "; block_depth += 1; index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "; block_depth -= 1; index += 2
            else:
                if source[index] != "\n": output[index] = " "
                index += 1
            continue
        if string_end is not None:
            if source.startswith(string_end, index):
                width = len(string_end)
                output[index:index + width] = " " * width
                index += width; string_end = None; raw_hashes = ""
            elif not raw_hashes and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source) and source[index + 1] != "\n":
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n": output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index); index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "; block_depth = 1; index += 2
        else:
            opener = re.match(r'(#+)?("""|")', source[index:])
            if opener is None:
                index += 1; continue
            hashes = opener.group(1) or ""
            quote = opener.group(2)
            width = len(opener.group(0))
            output[index:index + width] = " " * width
            string_end = quote + hashes; raw_hashes = hashes; index += width
    if block_depth or string_end is not None:
        raise SystemExit("ii-c-b1 Swift lexical scan drifted")
    return "".join(output)

def function_body(source, signature):
    start = source.find(signature)
    if start < 0:
        raise SystemExit("ii-c-b1 executable admission sequence drifted")
    opening = source.find("{", start + len(signature))
    if opening < 0:
        raise SystemExit("ii-c-b1 executable admission sequence drifted")
    depth = 0
    for index in range(opening, len(source)):
        depth += source[index] == "{"
        depth -= source[index] == "}"
        if depth == 0:
            return source[opening + 1:index]
    raise SystemExit("ii-c-b1 executable admission sequence drifted")

