function verify_iib5biii_b2ai_supervisor_contract() {
    local single_epoch_source=$1 composition_source=$2 continuity_source=$3
    local bridge_source=$4 protocol_source=$5 focused_test_source=$6
    local boundary_test_source=$7
    local source
    for source in "$single_epoch_source" "$composition_source" \
        "$continuity_source" "$bridge_source" "$protocol_source" \
        "$focused_test_source" "$boundary_test_source"
    do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source"
    done
    python3 - "$single_epoch_source" "$composition_source" \
        "$continuity_source" "$bridge_source" "$protocol_source" \
        "$focused_test_source" "$boundary_test_source" <<'PY'
from pathlib import Path
import re
import sys

(single_path, composition_path, continuity_path, bridge_path, protocol_path,
 focused_path, boundary_path) = map(Path, sys.argv[1:])
single, composition, continuity, bridge, protocol, focused, boundary = (
    path.read_text(encoding="utf-8") for path in (
        single_path, composition_path, continuity_path, bridge_path,
        protocol_path, focused_path, boundary_path
    )
)

def fail(message):
    raise SystemExit(message)

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

def declaration(source, pattern, label):
    match = re.search(pattern, source, re.MULTILINE)
    if match is None:
        fail(f"iii-b2a-i declaration missing: {label}")
    opening = source.find("{", match.end())
    if opening < 0:
        fail(f"iii-b2a-i declaration malformed: {label}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    fail(f"iii-b2a-i declaration unterminated: {label}")

expected_imports = {
    single_path: {
        "Foundation", "StornautInvestigationHandoffContract",
        "StornautInvestigationInstalledL2",
    },
    composition_path: {
        "Foundation", "StornautInvestigationHandoffContract",
        "StornautInvestigationInstalledL2",
    },
    continuity_path: {
        "Foundation", "StornautInvestigationHandoffContract",
    },
    bridge_path: {
        "Foundation", "StornautInvestigationHandoffContract",
    },
    protocol_path: {
        "Foundation", "StornautInvestigationHandoffContract",
    },
}
for path, source in (
    (single_path, single), (composition_path, composition),
    (continuity_path, continuity), (bridge_path, bridge),
    (protocol_path, protocol),
):
    if imports(source) != expected_imports[path]:
        fail("iii-b2a-i dependency surface drifted")

semantic = single + composition + continuity + bridge + protocol
if re.search(r"(?m)^\s*(?:public|open)\s+", semantic):
    fail("iii-b2a-i package boundary drifted")
if re.search(r"\b(?:Codable|Encodable|Decodable)\b", semantic):
