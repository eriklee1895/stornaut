    local baseline=${1:-HEAD}
    local expected=(
        Sources/StornautInvestigationRuntime/InvestigationLifecycleAppServerTransport.swift
        Tests/StornautInvestigationTests/InvestigationLifecycleAppServerTransportTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline")"})
    if git diff --cached --name-status "$baseline" \
        | awk '$1 == "D" { found = 1 } END { exit !found }'
    then
        print -u2 "ii-b3b staged checkpoint deleted a required path"
        return 1
    fi
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || {
        print -u2 "ii-b3b staged checkpoint paths drifted"
        return 1
    }
    local changed
