function verify_iib5biia_staged_scope() {
    local baseline=${1:-ddbc4a0be3ea059c7de239b85ef60c40c09affbb}
    [[ "$(git rev-parse "$baseline^{commit}")" \
        == ddbc4a0be3ea059c7de239b85ef60c40c09affbb ]] || {
        print -u2 "ii-b5b-ii-a checkpoint baseline drifted"
        return 1
    }
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/DarwinInvestigationMachineInstalledDriverSystem.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineFixedCapsuleIntake.swift
        Tests/StornautInvestigationTests/InvestigationMachineDriverSupportTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineFixedCapsuleIntakeTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "ii-b5b-ii-a checkpoint deleted an existing path"
        return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "ii-b5b-ii-a binary checkpoint path rejected"
        return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1')"})
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || {
        print -u2 "ii-b5b-ii-a checkpoint paths drifted"
        return 1
    }
    local changed
    changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 {n+=$1+$2} END {print n+0}')
    (( changed <= 2000 )) || {
        print -u2 "ii-b5b-ii-a checkpoint budget drifted"
        return 1
    }
    verify_iib5biia_index_semantics
}

