    r"\b(?:CommandLine|ProcessInfo\.processInfo\.environment)\b",
    r"@main\b|#if\b|Task\s*\{|Task\.detached",
)
for pattern in forbidden_patterns:
    if re.search(pattern, code, re.IGNORECASE):
        raise SystemExit(
            f"ii-b5b-ii-a authority or admission surface drifted: {pattern}"
        )

required_tests = (
    "fixedCapsuleIntakeProvidesClosedFDZeroSurface",
    "validCapsuleReadsOnlyFDZeroAndYieldsCanonicalRows",
    "invalidDescriptorProvenanceFailsClosed",
    "interruptedReadRetriesAndMalformedCapsuleIsRejected",
