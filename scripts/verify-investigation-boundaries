function verify_root_driver_lineage_cross_uid_staged_scope() {
    local -x PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local baseline=${1:-$cross_uid_scope_baseline}
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == b4c632e68e2f28ef67b9734bce82dac61bdc7bed ]] \
        || { print -u2 "cross-UID checkpoint baseline drifted"; return 1; }
    local -a expected=(Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift scripts/verify-contract scripts/verify-investigation-boundaries)
    local text checkpoint_path add delete total=0 mode entry
    text=$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    local -a observed=(${(f)text})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] \
        || { print -u2 "cross-UID checkpoint paths drifted"; return 1; }
    while IFS=$'\t' read -r add delete checkpoint_path; do
        [[ $checkpoint_path == docs/* || $checkpoint_path == AGENTS.md || $checkpoint_path == README.md ]] && continue
        [[ $add != - && $delete != - ]] || { print -u2 "cross-UID binary checkpoint path rejected"; return 1; }
        (( total += add + delete ))
    done <<< "$(git diff --cached --numstat "$baseline" --)"
    (( total <= 400 )) || { print -u2 "cross-UID checkpoint budget drifted"; return 1; }
    local worktree=$(git diff --name-only --diff-filter=ACMRD -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    local untracked=$(git ls-files --others --exclude-standard -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    [[ -z $worktree && -z $untracked ]] || { print -u2 "cross-UID index/worktree drifted"; return 1; }
    for checkpoint_path in "${expected[@]}"; do
        mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry"|awk '{print $1,$3,$4}')" == "$mode 0 $checkpoint_path" \
            && "$(print -r -- "$entry"|awk '{print $2}')" == "$(git hash-object -- "$checkpoint_path")" ]] \
            || { print -u2 "cross-UID staged source/mode drifted: $checkpoint_path"; return 1; }
    done
}

