        Tests/StornautInvestigationTests/InvestigationMachineCampaignEvidenceTests.swift 530
        Sources/StornautInvestigationMachineGateSupport/InvestigationMachineGateTransport.swift 10
        Tests/Fixtures/InvestigationMachineGateStub/main.swift 10
        Tests/StornautInvestigationTests/InvestigationSudoShapedDriverLauncherTests.swift 10
        scripts/verify-investigation-boundaries 300
        scripts/verify-contract 110
    )
    local checkpoint_path add delete ceiling total=0 numstat observed_text entry mode
    local -a expected=(
        Sources/StornautInvestigationMachineCampaign/main.swift
        Sources/StornautInvestigationMachineCampaignSupport/InvestigationMachineCampaignHarness.swift
        Sources/StornautInvestigationMachineCampaignSupport/InvestigationMachineCampaignEvidenceContract.swift
        Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpochComposition.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpochPhysicalBridge.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinOuterInnerProtocol.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineZeroArgumentEntry.swift
        Sources/StornautInvestigationMachineCampaignSupport/InvestigationMachineRawEvidenceWriter.swift
        scripts/stornaut-r5-local-lifecycle scripts/verify-investigation-runtime-machine-report
        Tests/StornautInvestigationTests/InvestigationMachineCampaignEvidenceTests.swift
        Sources/StornautInvestigationMachineGateSupport/InvestigationMachineGateTransport.swift
        Tests/Fixtures/InvestigationMachineGateStub/main.swift
        Tests/StornautInvestigationTests/InvestigationSudoShapedDriverLauncherTests.swift
        scripts/verify-investigation-boundaries scripts/verify-contract
    )
    observed_text=$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    local -a observed=(${(f)observed_text})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "ii-c-c checkpoint paths drifted"; return 1
    }
    numstat=$(/usr/bin/git diff --cached --numstat "$baseline" --) || {
        print -u2 "ii-c-c checkpoint diff unavailable"; return 1
    }
    while IFS=$'\t' read -r add delete checkpoint_path; do
        [[ $checkpoint_path == docs/* || $checkpoint_path == AGENTS.md || $checkpoint_path == README.md ]] && continue
        [[ $add != - && $delete != - ]] || { print -u2 "ii-c-c binary path rejected"; return 1; }
        (( ${+ceilings[$checkpoint_path]} )) || { print -u2 "ii-c-c checkpoint paths drifted: $checkpoint_path"; return 1; }
        ceiling=${ceilings[$checkpoint_path]}
        (( add + delete <= ceiling )) || { print -u2 "ii-c-c path budget drifted: $checkpoint_path"; return 1; }
        (( total += add + delete ))
    done <<< "$numstat"
    (( total <= 4000 )) || { print -u2 "ii-c-c aggregate budget drifted"; return 1; }
    local -a untracked=(${(f)"$(git ls-files --others --exclude-standard -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    (( ${#untracked} == 0 )) || { print -u2 "ii-c-c checkpoint untracked paths drifted"; return 1; }
    local unstaged=$(git diff --name-only --diff-filter=ACMRD -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    [[ -z $unstaged ]] || { print -u2 "ii-c-c checkpoint unstaged paths drifted"; return 1; }
    for checkpoint_path in "${expected[@]}"; do
        mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" == "$mode 0 $checkpoint_path" ]] \
            || { print -u2 "ii-c-c staged source/mode drifted: $checkpoint_path"; return 1; }
        [[ "$(print -r -- "$entry" | awk '{print $2}')" == "$(git hash-object -- "$checkpoint_path")" ]] \
            || { print -u2 "ii-c-c staged/worktree source drifted: $checkpoint_path"; return 1; }
    done
}

function verify_iicc_prearm_staged_scope() {
    local -x PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local baseline=${1:-$iicc_prearm_scope_baseline}
    local expected_baseline=62ee47091e338107e182233eaed80ed1ecc059cc
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == $expected_baseline ]] \
        || { print -u2 "ii-c-c pre-arm checkpoint baseline drifted"; return 1; }
    local -A ceilings=(
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift 250
        scripts/verify-contract 450
        scripts/verify-investigation-boundaries 450
    )
    local -a expected=(
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-contract scripts/verify-investigation-boundaries
    )
    local text checkpoint_path add delete total=0 mode entry numstat
    text=$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    local -a observed=(${(f)text})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] \
        || { print -u2 "ii-c-c pre-arm checkpoint paths drifted"; return 1; }
    numstat=$(git diff --cached --numstat "$baseline" --) \
        || { print -u2 "ii-c-c pre-arm checkpoint diff unavailable"; return 1; }
    while IFS=$'\t' read -r add delete checkpoint_path; do
        [[ $checkpoint_path == docs/* || $checkpoint_path == AGENTS.md || $checkpoint_path == README.md ]] && continue
        [[ $add != - && $delete != - ]] \
            || { print -u2 "ii-c-c pre-arm binary path rejected"; return 1; }
        (( ${+ceilings[$checkpoint_path]} )) \
            || { print -u2 "ii-c-c pre-arm checkpoint paths drifted: $checkpoint_path"; return 1; }
        (( add + delete <= ceilings[$checkpoint_path] )) \
            || { print -u2 "ii-c-c pre-arm path budget drifted: $checkpoint_path"; return 1; }
        (( total += add + delete ))
    done <<< "$numstat"
    (( total <= 900 )) \
        || { print -u2 "ii-c-c pre-arm aggregate budget drifted"; return 1; }
    for checkpoint_path in "${expected[@]}"; do
        mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry" | awk '{print $1,$3,$4}')" == "$mode 0 $checkpoint_path" \
            && "$(print -r -- "$entry" | awk '{print $2}')" == "$(git hash-object -- "$checkpoint_path")" ]] \
            || { print -u2 "ii-c-c pre-arm staged source/mode drifted: $checkpoint_path"; return 1; }
    done
    [[ -z "$(git diff --name-only --diff-filter=ACMRD -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')" \
        && -z "$(git ls-files --others --exclude-standard -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')" ]] \
        || { print -u2 "ii-c-c pre-arm index/worktree drifted"; return 1; }
}

