function verify_iic0biii2a_staged_scope() {
    local expected_baseline=e832e8433137f9777aba77daba2ca248a563404d
    local baseline=${1:-$expected_baseline}
    local budget=1800
    local expected=(
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 4 )) || {
        print -u2 "ii-c0b-iii-2a checkpoint path ceiling drifted"; return 1
    }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" \
        == "$expected_baseline" ]] || {
        print -u2 "ii-c0b-iii-2a checkpoint baseline drifted"; return 1
    }
    if git diff --cached --name-only --diff-filter=D "$baseline" | grep -q .
    then
        print -u2 "ii-c0b-iii-2a checkpoint deleted an existing path"; return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk '$1=="-" || $2=="-" {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-iii-2a binary checkpoint path rejected"; return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline")"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "ii-c0b-iii-2a checkpoint paths drifted"; return 1
    }
    local checkpoint_path mode entry
    for checkpoint_path in "${expected[@]}"; do
        mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" \
            == "$mode 0 $checkpoint_path" ]] || {
            print -u2 "ii-c0b-iii-2a checkpoint mode drifted: $checkpoint_path"
            return 1
        }
    done
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk '{n+=$1+$2} END {print n+0}')
    (( changed <= budget )) || {
        print -u2 "ii-c0b-iii-2a checkpoint budget drifted"; return 1
    }
    local observed_path allowed_path
    local -a worktree_paths=(
        ${(f)"$(git diff --name-only --diff-filter=ACMRD --)"}
    )
    for observed_path in "${worktree_paths[@]}"; do
        allowed_path=false
        for checkpoint_path in "${expected[@]}"; do
            [[ $observed_path == $checkpoint_path ]] && allowed_path=true
        done
        $allowed_path || {
            print -u2 "ii-c0b-iii-2a checkpoint worktree paths drifted"
            return 1
        }
    done
    local -a untracked_paths=(
        ${(f)"$(git ls-files --others --exclude-standard --)"}
    )
    (( ${#untracked_paths} == 0 )) || {
        print -u2 "ii-c0b-iii-2a checkpoint untracked paths drifted"
        return 1
    }
    local staged_blob worktree_blob
    for checkpoint_path in "${expected[@]}"; do
        entry=$(git ls-files -s -- "$checkpoint_path")
        staged_blob=$(print -r -- "$entry" | awk '{print $2}')
        worktree_blob=$(git hash-object -- "$checkpoint_path")
        [[ "$staged_blob" == "$worktree_blob" ]] || {
            print -u2 \
                "ii-c0b-iii-2a staged/worktree source drifted: $checkpoint_path"
            return 1
        }
    done
}

function verify_iic0biii2a_completed_tree() {
    local implementation_tree=544209f3cd4682b1c4d720931498c8daa5ccc325
    [[ "$(git write-tree)" == "$implementation_tree" ]] || {
        print -u2 "ii-c0b-iii-2a completed tree drifted"; return 1
    }
}

function verify_iica_staged_scope() {
    local expected_baseline=2b30a157c14bc507351b10bd521e710987860f71
    local baseline=${1:-$expected_baseline}
    local -a expected=(
        Package.swift
        Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift
        Sources/StornautInvestigationMachineGateSupport/InvestigationMachineFixedGateLauncher.swift
        Stornaut.xcodeproj/project.pbxproj
        Stornaut.xcodeproj/xcshareddata/xcschemes/StornautInvestigationDiagnosticApp.xcscheme
        Tests/StornautInvestigationTests/InvestigationClosedMachineArtifactInstallerTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/stornaut-r5-local-lifecycle
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == \
        "$expected_baseline" ]] || {
        print -u2 "ii-c-a checkpoint baseline drifted"; return 1
    }
    (( ${#expected} == 11 )) || {
        print -u2 "ii-c-a checkpoint path ceiling drifted"; return 1
    }
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "ii-c-a checkpoint deleted an existing path"; return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "ii-c-a binary checkpoint path rejected"; return 1
    fi
    local -a observed=(
        ${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" \
            | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"' \
            | LC_ALL=C sort)"}
    )
    [[ "${(j:\n:)observed}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "ii-c-a checkpoint paths drifted"; return 1
    }
    local total package_api xcode installer tests verifiers
    total=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 {n+=$1+$2} END {print n+0}')
    package_api=$(git diff --cached --numstat "$baseline" -- Package.swift Sources/StornautInvestigationMachineGateSupport/InvestigationMachineFixedGateLauncher.swift Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift | awk '{n+=$1+$2} END {print n+0}')
    xcode=$(git diff --cached --numstat "$baseline" -- Stornaut.xcodeproj/project.pbxproj Stornaut.xcodeproj/xcshareddata/xcschemes/StornautInvestigationDiagnosticApp.xcscheme | awk '{n+=$1+$2} END {print n+0}')
    installer=$(git diff --cached --numstat "$baseline" -- scripts/stornaut-r5-local-lifecycle | awk '{n+=$1+$2} END {print n+0}')
    tests=$(git diff --cached --numstat "$baseline" -- Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift Tests/StornautInvestigationTests/InvestigationClosedMachineArtifactInstallerTests.swift | awk '{n+=$1+$2} END {print n+0}')
    verifiers=$(git diff --cached --numstat "$baseline" -- scripts/verify-investigation-boundaries scripts/verify-app-release-boundaries scripts/verify-contract | awk '{n+=$1+$2} END {print n+0}')
    (( total <= 3800 )) || { print -u2 "ii-c-a checkpoint budget drifted"; return 1; }
    (( package_api <= 120 )) || { print -u2 "ii-c-a Package/API budget drifted"; return 1; }
    (( xcode <= 650 )) || { print -u2 "ii-c-a Xcode budget drifted"; return 1; }
    (( installer <= 500 )) || { print -u2 "ii-c-a installer budget drifted"; return 1; }
    (( tests <= 850 )) || { print -u2 "ii-c-a tests budget drifted"; return 1; }
    (( verifiers <= 1680 )) || { print -u2 "ii-c-a verifier budget drifted"; return 1; }
    local checkpoint_path mode entry staged_blob worktree_blob
    for checkpoint_path in "${expected[@]}"; do
        mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" == \
            "$mode 0 $checkpoint_path" ]] || {
            print -u2 "ii-c-a staged source/mode drifted: $checkpoint_path"; return 1
        }
        staged_blob=$(print -r -- "$entry" | awk '{print $2}')
        worktree_blob=$(git hash-object -- "$checkpoint_path")
        [[ "$staged_blob" == "$worktree_blob" ]] || {
            print -u2 "ii-c-a staged source/mode drifted: $checkpoint_path"; return 1
        }
    done
    local -a untracked=(
        ${(f)"$(git ls-files --others --exclude-standard -- \
            | awk 'index($0,"docs/")!=1')"}
    )
    (( ${#untracked} == 0 )) || {
        print -u2 "ii-c-a checkpoint untracked paths drifted"; return 1
    }
}

