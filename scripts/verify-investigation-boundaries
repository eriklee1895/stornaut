function verify_iic0bivb1_staged_scope() {
    local expected_baseline=a22f8fe9887fc276f418b288f03f8f080b1d3e45
    local baseline=${1:-$expected_baseline}
    local budget=2200
    local expected=(
        Tests/Fixtures/InvestigationFixedGateHandoff/main.swift
        Tests/StornautInvestigationTests/InvestigationFixedGateHandoffPhysicalTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 5 )) || {
        print -u2 "ii-c0b-iv-b1b-ii checkpoint path ceiling drifted"
        return 1
    }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == \
        "$expected_baseline" ]] || {
        print -u2 "ii-c0b-iv-b1b-ii checkpoint baseline drifted"
        return 1
    }
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-iv-b1b-ii checkpoint deleted an existing path"
        return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-iv-b1b-ii binary checkpoint path rejected"
        return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "ii-c0b-iv-b1b-ii checkpoint paths drifted"
        return 1
    }
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= budget )) || {
        print -u2 "ii-c0b-iv-b1b-ii checkpoint budget drifted"
        return 1
    }
    local checkpoint_path mode entry staged_blob worktree_blob
    for checkpoint_path in "${expected[@]}"; do
        mode=100644
        [[ $checkpoint_path == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" \
            == "$mode 0 $checkpoint_path" ]] || {
            print -u2 \
                "ii-c0b-iv-b1b-ii checkpoint mode drifted: $checkpoint_path"
            return 1
        }
        staged_blob=$(print -r -- "$entry" | awk '{print $2}')
        worktree_blob=$(git hash-object -- "$checkpoint_path")
        [[ "$staged_blob" == "$worktree_blob" ]] || {
            print -u2 \
                "ii-c0b-iv-b1b-ii staged/worktree source drifted: $checkpoint_path"
            return 1
        }
    done
    local observed_path allowed_path
    local -a worktree_paths=(
        ${(f)"$(git diff --name-only --diff-filter=ACMRD -- \
            | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"}
    )
    local -a untracked_paths=(
        ${(f)"$(git ls-files --others --exclude-standard -- \
            | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"}
    )
    for observed_path in "${worktree_paths[@]}" "${untracked_paths[@]}"; do
        [[ -z $observed_path ]] && continue
        allowed_path=false
        for checkpoint_path in "${expected[@]}"; do
            [[ $observed_path == $checkpoint_path ]] && allowed_path=true
        done
        $allowed_path || {
            print -u2 "ii-c0b-iv-b1b-ii checkpoint worktree paths drifted"
            return 1
        }
    done
}

function verify_iic0bivb2_source_contract() {
    local package=${1:-Package.swift} composition=${2:-Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift}
    local receipt=${3:-Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorReceipt.swift} entry=${4:-tools/StornautInvestigationMachineGateCoordinator/main.swift}
    local composition_test=${5:-Tests/StornautInvestigationTests/InvestigationMachineGateCoordinatorCompositionTests.swift} receipt_test=${6:-Tests/StornautInvestigationTests/InvestigationMachineGateCoordinatorReceiptTests.swift} boundary_test=${7:-Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift}
    python3 - "$package" "$composition" "$receipt" "$entry" "$composition_test" "$receipt_test" "$boundary_test" <<'PY'
from pathlib import Path
import hashlib, re, sys
paths = [Path(x) for x in sys.argv[1:]]
p, c, r, e, ct, rt, bt = [path.read_text() for path in paths]
def need(s, xs, label):
    for x in xs:
        if x not in s: raise SystemExit(f"ii-c0b-iv {label} drifted: {x}")
def target(name):
    found = re.findall(rf'(?ms)\.(?:executableT|t)arget\(\s*name:\s*"{name}"\s*,(.*?)^\s*\),', p)
    if len(found) != 1: raise SystemExit(f'ii-c0b-iv target cardinality drifted: {name}')
    return found[0]
support = target('StornautInvestigationMachineGateCoordinatorSupport')
executable = target('StornautInvestigationMachineGateCoordinator')
expected = ['StornautCodex', 'StornautCore', 'StornautInvestigation',
 'StornautInvestigationDiagnostic', 'StornautInvestigationHandoffContract',
 'StornautInvestigationMachineGateSupport', 'StornautInvestigationMachineLaunchSupport']
if re.findall(r'"([^"]+)"', re.search(r'(?ms)dependencies:\s*\[(.*?)\]', support).group(1)) != expected:
    raise SystemExit('ii-c0b-iv exact target graph drifted')
if re.findall(r'"([^"]+)"', re.search(r'(?ms)dependencies:\s*\[(.*?)\]', executable).group(1)) != ['StornautInvestigationMachineGateCoordinatorSupport']:
    raise SystemExit('ii-c0b-iv executable dependency drifted')
need(c, ['static func run() async -> Int32', 'InvestigationMachineGateCoordinatorOwnedAttempt', 'EvidenceStore(configuration: .memory)', 'saveScanSession', 'savePathSnapshots', 'saveClassifications', 'saveSpaceLedger', 'createInvestigation', 'InvestigationMachineCurrentSourceBindingSource()', 'InvestigationMachineCoordinatorConfigurationSetSource(', 'InvestigationProjectedCohortAuthor().author', 'InvestigationFixedGateHandoff().run', 'writeClose(.receipt(receipt))', 'writeClose(.closeOnly)'], 'composition')
call_edges = {'production':r'dependencies:\s*\.production\(context: context, sink: sink\)', 'store':r'EvidenceStore\(configuration: \.memory\)', 'author':r'InvestigationProjectedCohortAuthor\(\)\.author\(', 'handoff':r'InvestigationFixedGateHandoff\(\)\.run\(', 'receipt-write':r'dependencies\.writeClose\(\.receipt\(receipt\)\)'}
for label, pattern in call_edges.items():
    if len(re.findall(pattern, c)) != 1: raise SystemExit(f'ii-c0b-iv composition call-edge drifted: {label}')
clock = 'InvestigationHandoffAppLeafAdapterSystem.system.continuousNanoseconds'
if c.count(clock) != 1 or re.search(r'DispatchTime\s*\.\s*now', c): raise SystemExit('ii-c0b-iv production clock drifted')
need(r, ['stornaut.task39.machine.gate-coordinator-receipt.v1', 'maximumByteCount = 4_096', 'receiptSHA256Bytes: Data(', 'try value.encoded() == data'], 'receipt')
need(e, ['exit(await InvestigationMachineGateCoordinatorSupport.run())', 'exit(78)'], 'entry')
test_seals = {rt: '1e17ce1532e17b19da21e780e24ee739025925ebb0bbc717ccfc05f25fae75ba', bt: '524a64edf43bd8a2680e3854ff99e86c05fcef3920fb49480ca16fbce08fa5c2'}
for text, expected_sha in test_seals.items():
    if hashlib.sha256(text.encode()).hexdigest() != expected_sha: raise SystemExit('ii-c0b-iv critical test source seal drifted')
need(ct, ['@Test(arguments: InvestigationMachineGateCoordinatorOwnedAttempt.RootBootstrapStage.allCases)', '@Test(arguments: CoordinatorClockFault.allCases)', 'func preHandoffFailureStopsLaunchRetiresAndClosesWithoutReceipt(', 'func postSettlementFailureStillRetiresAttempt()', 'func writeCloseUncertaintyDominatesEarlierFailure()'], 'composition test matrix')
need(rt, ['@Test(arguments: CoordinatorReceiptValueMutation.allCases)', '@Test(arguments: CoordinatorReceiptEncodingMutation.allCases)'], 'receipt test matrix')
need(bt, ['func iiC0BIVB2VerifierPinsAggregateCompositionClosure()', 'critical-test-composition-vacuity', 'critical-test-receipt-vacuity', 'critical-test-boundary-vacuity', 'closed-image-coordinator-namespace', 'closed-image-receipt-domain'], 'boundary test matrix')
surface = '\n'.join(x for x in c.splitlines() if re.match(r'\s*package ', x))
if re.search(r'@escaping|Unsafe(File|Mutable)|FileDescriptor|\bURL\b', surface):
    raise SystemExit('ii-c0b-iv raw FD/path/generic callback escaped package surface')
for forbidden in ('StornautExecution', 'ActionExecutor', 'TrashMoving', 'RegisteredAction', 'signedRuntimeReady'):
    if forbidden in c + r + e:
        raise SystemExit(f'ii-c0b-iv prohibited authority drifted: {forbidden}')
PY
}

function verify_iic0bivb2_staged_scope() {
    local baseline=${1:-dc38ba61eca8897e662547b6c5ffed7250623351}
    local expected_baseline=dc38ba61eca8897e662547b6c5ffed7250623351
    local -a expected=(Package.swift Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorReceipt.swift tools/StornautInvestigationMachineGateCoordinator/main.swift Tests/StornautInvestigationTests/InvestigationMachineGateCoordinatorCompositionTests.swift Tests/StornautInvestigationTests/InvestigationMachineGateCoordinatorReceiptTests.swift Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift scripts/verify-contract scripts/verify-investigation-boundaries scripts/verify-app-release-boundaries)
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == $expected_baseline ]] || { print -u2 'ii-c0b-iv-b2 checkpoint baseline drifted'; return 1; }
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || { print -u2 'ii-c0b-iv-b2 checkpoint paths drifted'; return 1; }
    local changed
    changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {if($1=="-"||$2=="-") exit 2; n+=$1+$2} END{print n+0}') || { print -u2 'ii-c0b-iv-b2 binary checkpoint path rejected'; return 1; }
    (( changed <= 4000 )) || { print -u2 'ii-c0b-iv-b2 checkpoint budget drifted'; return 1; }
    local -a worktree_paths=(${(f)"$(git diff --name-only --diff-filter=ACMRD -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    local -a untracked_paths=(${(f)"$(git ls-files --others --exclude-standard -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    for observed_path in "${worktree_paths[@]}"; do (( ${expected[(Ie)$observed_path]} )) || { print -u2 'ii-c0b-iv-b2 checkpoint worktree paths drifted'; return 1; }; done
    (( ${#untracked_paths} == 0 )) || { print -u2 'ii-c0b-iv-b2 checkpoint untracked paths drifted'; return 1 }
    local item mode entry
    for item in "${expected[@]}"; do mode=100644; [[ $item == scripts/* ]] && mode=100755; entry=$(git ls-files -s -- "$item"); [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" == "$mode 0 $item" && "$(print -r -- "$entry" | awk '{print $2}')" == "$(git hash-object -- "$item")" ]] || { print -u2 "ii-c0b-iv-b2 staged source/mode drifted: $item"; return 1; }; done
}

