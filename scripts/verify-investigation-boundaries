function verify_iib5a0_staged_scope() {
    local baseline=${1:-HEAD}
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineClaimClient.swift
        Tests/StornautInvestigationTests/InvestigationMachineClaimClientTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-investigation-boundaries
    )
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0, "docs/") != 1')"})
    if git diff --cached --name-status "$baseline" \
        | awk '$1 == "D" && index($2, "docs/") != 1 { found = 1 } END { exit !found }'
    then
        print -u2 "ii-b5a0 staged checkpoint deleted a required path"
        return 1
    fi
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || {
        print -u2 "ii-b5a0 checkpoint paths drifted"
        return 1
    }
    local changed
    changed=$(git diff --cached --numstat "$baseline" | awk 'index($3, "docs/") != 1 {total += $1 + $2} END {print total + 0}')
    (( changed <= 800 )) || {
        print -u2 "ii-b5a0 checkpoint budget drifted"
        return 1
    }
}

function verify_iib5a_single_epoch_contract() {
    local composer_source=$1
    local focused_test_source=$2
