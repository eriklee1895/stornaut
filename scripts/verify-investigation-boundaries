    "verifier-foundation-canonical": ("verifier", "require(foundation_json(data) == data, \"noncanonical json\")", "require(True, \"noncanonical json\")"),
    "verifier-canonical-path": ("verifier", "root_path = canonical_absolute_path(root_path)", "root_path = os.path.realpath(root_path)"),
