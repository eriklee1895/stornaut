            raise SystemExit(
                "ii-b5b-i-b1 historical C target normalization drifted"
            )
        data = data.replace(later_c_target, b'', 1)
    if hashlib.sha256(data).hexdigest() != expected_sha:
        label = "package" if path == package_path else (
            "semantic" if path == semantic_path else "focused test"
        )
        raise SystemExit(f"ii-b5b-i-b1 canonical {label} source drifted")
PY
}

