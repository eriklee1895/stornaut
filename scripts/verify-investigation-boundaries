function verify_claim_asid_contract() {
    local source=$1
    python3 - "$source" <<'PY'
from pathlib import Path
import re
import sys


def swift_code_only(source):
    output = list(source)
    index = 0
    block_depth = 0
    string_delimiter = None
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if string_delimiter is not None:
            if source.startswith(string_delimiter, index):
                width = len(string_delimiter)
                output[index:index + width] = " " * width
                string_delimiter = None
                index += width
            elif string_delimiter == '"' and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source):
                    if source[index + 1] != "\n":
                        output[index + 1] = " "
                    index += 2
                else:
                    index += 1
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            if end < 0:
                end = len(source)
            for offset in range(index, end):
                output[offset] = " "
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif source.startswith('\"\"\"', index):
            output[index:index + 3] = "   "
            string_delimiter = '"""'
            index += 3
        elif source[index] == '"':
            output[index] = " "
            string_delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or string_delimiter is not None:
        raise SystemExit("claim contract has unterminated comment or string")
    return "".join(output)


def declaration_body(source, pattern, start=0):
    match = re.search(pattern, source[start:])
    if match is None:
        raise SystemExit(f"missing claim declaration: {pattern}")
    declaration_start = start + match.start()
    opening = source.find("{", start + match.end())
    if opening < 0:
        raise SystemExit(f"claim declaration has no body: {pattern}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[declaration_start:index + 1], index + 1
    raise SystemExit(f"claim declaration body is unterminated: {pattern}")


source = Path(sys.argv[1]).read_text(encoding="utf-8")
code = swift_code_only(source)
evidence_body, evidence_end = declaration_body(
    code, r"package\s+struct\s+InvestigationMachineClaimEvidence\b"
)
evidence_init, _ = declaration_body(
    evidence_body, r"package\s+init\s*\("
)
evidence_validate, _ = declaration_body(
    evidence_body, r"package\s+func\s+validate\s*\("
)
expectation_body, _ = declaration_body(
    code,
    r"package\s+struct\s+InvestigationMachineClaimExpectation\b",
    evidence_end,
)
expectation_init, _ = declaration_body(
    expectation_body, r"package\s+init\s*\("
)
required = (
    (evidence_init, r"l1Residue\.auditSessionID\s*==\s*"
        r"helperIdentity\.auditSessionID"),
    (expectation_body, r"package\s+let\s+"
        r"helperAuditSessionID:\s*UInt32"),
    (evidence_validate, r"l1Residue\.auditSessionID\s*==\s*"
        r"expectation\.helperAuditSessionID"),
    (expectation_init, r"helperAuditSessionID\s*=\s*"
        r"helperIdentity\.auditSessionID"),
)
for scoped_source, pattern in required:
    if re.search(pattern, scoped_source) is None:
        raise SystemExit(f"claim evidence helper ASID join drifted: {pattern}")
for pattern in (
    r"(?:appIdentity\.auditSessionID\s*==\s*"
        r"helperIdentity\.auditSessionID|"
        r"helperIdentity\.auditSessionID\s*==\s*"
        r"appIdentity\.auditSessionID)",
    r"(?:l1Residue\.auditSessionID\s*==\s*"
        r"appIdentity\.auditSessionID|"
        r"appIdentity\.auditSessionID\s*==\s*"
        r"l1Residue\.auditSessionID)",
    r"(?:auditSessionID|helperAuditSessionID)\s*=\s*"
        r"appIdentity\.auditSessionID",
):
    if re.search(pattern, evidence_body + expectation_body):
        raise SystemExit(
            f"claim evidence regained invalid App/helper ASID join: {pattern}"
        )
PY
}

function verify_deadline_state_contract() {
    local source=$1
    python3 - "$source" <<'PY'
from pathlib import Path
import re
import sys


def code_only(source):
    output = list(source)
    index = 0
    block_depth = 0
    delimiter = None
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if delimiter is not None:
            if source.startswith(delimiter, index):
                width = len(delimiter)
                output[index:index + width] = " " * width
                delimiter = None
                index += width
            elif delimiter == '"' and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source):
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif source.startswith('\"\"\"', index):
            output[index:index + 3] = "   "
            delimiter = '"""'
            index += 3
        elif source[index] == '"':
            output[index] = " "
            delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or delimiter is not None:
        raise SystemExit("deadline state has unterminated comment or string")
    return "".join(output)


def body(source, pattern):
    match = re.search(pattern, source)
    if match is None:
        raise SystemExit(f"deadline state declaration drifted: {pattern}")
    opening = source.find("{", match.end())
    if opening < 0:
        raise SystemExit(f"deadline state declaration has no body: {pattern}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    raise SystemExit(f"deadline state declaration is unterminated: {pattern}")


source = Path(sys.argv[1]).read_text(encoding="utf-8")
code = code_only(source)
imports = re.findall(r"(?m)^\s*import\s+([A-Za-z0-9_]+)\s*$", code)
if imports != ["Foundation"]:
    raise SystemExit(f"deadline state imports drifted: {imports}")
for import_line in re.findall(r"(?m)^\s*.*\bimport\b.*$", code):
    if import_line.strip() != "import Foundation":
        raise SystemExit(f"deadline state import surface drifted: {import_line!r}")
declaration_prefix = (
    r"(?m)^\s*(?:@[A-Za-z_][A-Za-z0-9_.]*(?:\([^\n]*\))?\s+)*"
    r"(?:(?:final|nonisolated|distributed|indirect|static|class|"
    r"mutating|nonmutating|borrowing|consuming)\s+)*"
)
if re.search(declaration_prefix + r"(?:public|open)\s+", code):
    raise SystemExit("deadline state exposed public surface")
if re.search(r"(?m)(?:^|[^/])/(?![/*])[^\n/]+/(?:[A-Za-z]*)", code) \
        or re.search(r"\b(?:Regex|RegexBuilder)\b", code):
    raise SystemExit("deadline state gained regex-literal spoofing surface")
required_types = (
    "LifecycleMachineRetirementDeadlineValueError",
    "LifecycleMachineRetirementDeadlineDigest",
    "LifecycleMachineRetirementDeadlineObservation",
    "LifecycleMachineRetirementDeadlineReservation",
    "LifecycleMachineRetirementDeadlineClaim",
    "LifecycleMachineRetirementDeadlineRelease",
    "LifecycleMachineRetirementDeadlineKind",
    "LifecycleMachineRetirementDeadlineTicket",
    "LifecycleMachineRetirementDeadlineTerminalReason",
    "LifecycleMachineRetirementDeadlinePhase",
    "LifecycleMachineRetirementDeadlineDisposition",
    "LifecycleMachineRetirementDeadlineEffect",
    "LifecycleMachineRetirementDeadlineTransition",
)
for name in required_types:
    if not re.search(rf"(?m)^package\s+(?:enum|struct)\s+{name}\b", code):
        raise SystemExit(f"deadline state package type drifted: {name}")
class_body = body(
    code,
    r"(?m)^package\s+final\s+class\s+"
    r"LifecycleMachineRetirementEscrowDeadlineState\b",
)
required_methods = (
    "reserve", "armSucceeded", "armFailed", "claim", "release",
    "replyDidDispatch", "replyDispatchFailed", "deadlineFired",
    "cancel", "invalidate",
)
methods = {}
for name in required_methods:
    methods[name] = body(class_body, rf"package\s+func\s+{name}\s*\(")
for marker in (
    "maximumClaimRequestWindowMicroseconds",
    "maximumReleaseWindowNanoseconds",
    "maximumPostReplyExitWindowNanoseconds",
    "lateArmCancellation",
    "NSLock()",
):
    if marker not in class_body:
        raise SystemExit(f"deadline state owner marker drifted: {marker}")
authority = re.compile(
    r"\b(?:Codable|Encodable|Decodable|NSXPC\w*|Dispatch\w*|Task|"
    r"FileManager|URLSession|Process|Security|ActionExecutor|Policy|Cleanup|"
    r"Executor|StornautInvestigationHandoffContract)\b|"
    r"\b(?:exit|kill|posix_spawn|unlink|rename)\s*\("
)
match = authority.search(code)
if match:
    raise SystemExit(f"deadline state gained authority: {match.group(0)!r}")
arm_success = methods["armSucceeded"]
if not (
    re.search(r"lateArmCancellation\.remove\(ticket\)\s*!=\s*nil", arm_success)
    and re.search(r"effects:\s*\[\.cancel\(ticket\)\]", arm_success)
):
    raise SystemExit("deadline stale arm success no longer cancels timer")
if "lateArmCancellation" in methods["armFailed"]:
    raise SystemExit("deadline stale arm failure clears pending cancellation")
deadline_fired = methods["deadlineFired"]
for pattern in (
    r"let\s+isPending\s*=\s*pendingTicketLocked\s*==\s*ticket",
    r"cancelCurrent:\s*!isPending",
    r"rememberLateArm:\s*isPending\s*\?\s*ticket\s*:\s*nil",
):
    if not re.search(pattern, deadline_fired):
        raise SystemExit(f"deadline pending/armed callback drifted: {pattern}")
reply = methods["replyDidDispatch"]
if "checkedAdd" in reply or "maximumPostReplyExitWindowNanoseconds" in reply:
    raise SystemExit("reply dispatch regained deadline extension authority")
if not re.search(
    r"observation\.monotonicNanoseconds\s*<\s*"
    r"context\.postReplyExitDeadlineNanoseconds",
    reply,
):
    raise SystemExit("reply dispatch no longer checks retained deadline")
PY
}

function verify_claim_server_scope() {
    python3 - <<'PY'
import subprocess

checkpoints = (
    (
        "147247ffadcb37c8a7ab83983bf884bd858ac51b",
        "0e6a377f020d3e446ea9a8d7b045516d0bd9515b",
        "617b73625180d05591061abcbbb5f470bab00656",
        {"scripts/verify-investigation-boundaries"},
        650,
        "b1",
    ),
    (
        "08184b0a769d904b895636455688ada9e3c3e9e3",
        "147247ffadcb37c8a7ab83983bf884bd858ac51b",
        "2d9a22d0e9fc5158898fd3c2a304582c93ec8a94",
        {"scripts/verify-contract"},
        400,
        "b2",
    ),
)
for commit, parent, tree, expected_paths, ceiling, label in checkpoints:
    observed_parent = subprocess.check_output(
        ["git", "show", "-s", "--format=%P", commit], text=True
    ).strip()
    observed_tree = subprocess.check_output(
        ["git", "show", "-s", "--format=%T", commit], text=True
    ).strip()
    if observed_parent != parent or observed_tree != tree:
        raise SystemExit(
            f"claim server historical {label} identity drifted"
        )
    paths = {
        path
        for path in subprocess.check_output(
            ["git", "diff-tree", "--no-commit-id", "--name-only",
             "-r", commit],
            text=True,
        ).splitlines()
        if not path.startswith("docs/")
    }
    if paths != expected_paths:
        raise SystemExit(
            f"claim server historical {label} paths drifted: {sorted(paths)}"
        )
    changed_lines = 0
    for row in subprocess.check_output(
        ["git", "diff-tree", "--numstat", "--no-commit-id",
         "-r", commit],
        text=True,
    ).splitlines():
        added, deleted, path = row.split("\t")
        if path in expected_paths and added != "-" and deleted != "-":
            changed_lines += int(added) + int(deleted)
    if changed_lines > ceiling:
        raise SystemExit(
            f"claim server historical {label} budget drifted: "
            f"{changed_lines} > {ceiling}"
        )
PY
}

function verify_legacy_machine_claim_scope() {
    python3 - <<'PY'
from pathlib import Path
import subprocess

