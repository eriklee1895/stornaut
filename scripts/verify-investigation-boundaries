function verify_iib5biii_b1_staged_scope() {
    local baseline=${1:-67306345f057398063aa20f6b9b2ae7f6175d9af}
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineEightEpochCohort.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineHelperEpochContinuity.swift
        Tests/StornautInvestigationTests/InvestigationMachineEightEpochCohortTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 7 )) || { print -u2 "iii-b1 checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == 67306345f057398063aa20f6b9b2ae7f6175d9af ]] || { print -u2 "iii-b1 checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" | grep -q .; then print -u2 "iii-b1 checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {f=1} END {exit !f}'; then print -u2 "iii-b1 binary checkpoint path rejected"; return 1; fi
    local observed_text worktree_text totals
    observed_text=$(git diff --cached --name-only --diff-filter=ACMRD "$baseline") || { print -u2 "shared-deadline checkpoint paths unreadable"; return 1; }
    local observed=(${(f)"$(print -r -- "$observed_text" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || { print -u2 "iii-b1 staged checkpoint paths drifted"; return 1; }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644; [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" == "$expected_mode 0 $expected_path" ]] || { print -u2 "iii-b1 checkpoint mode drifted: $expected_path"; return 1; }
    done
    local changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 3200 )) || { print -u2 "iii-b1 checkpoint budget drifted"; return 1; }
    [[ "$(git write-tree)" == b46d39bfcb4a24cee80b4be9562e281519450cb8 ]] \
        || { print -u2 "iii-b1 completed tree drifted"; return 1; }
}

