    raise SystemExit("ii-b5b-ii-b complete C snapshot drifted: group ceiling")
if compact_c.count("returnSTORNAUT_INVESTIGATION_IDENTITY_MISMATCH;") != 2:
    raise SystemExit("ii-b5b-ii-b complete C snapshot drifted: identity mismatch")
if source.count("system.narrowIdentity(processID: processClaim.processID)") != 2:
    raise SystemExit("ii-b5b-ii-b post-drop narrow identity sandwich drifted")
cross_source = re.search(
