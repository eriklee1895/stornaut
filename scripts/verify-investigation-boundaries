for source_name in driver_support_sources:
    source_path = driver_support_source_root / source_name
    if not source_path.is_file():
        raise SystemExit(
            f"Resolved Machine driver support source is missing: {source_path}"
        )
    source_bytes = source_path.read_bytes()
    observed_source_sha256 = hashlib.sha256(source_bytes).hexdigest()
    if observed_source_sha256 != expected_driver_support_sha256[source_name]:
        raise SystemExit(
            "Machine driver support source seal drifted: "
            f"{source_path}: {observed_source_sha256}"
        )
    source_text = source_bytes.decode("utf-8")
    imports = set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source_text))
    if imports != expected_driver_support_imports[source_name]:
        raise SystemExit(
            "Machine driver support import allowlist drifted: "
            f"{source_path}: {sorted(imports)}"
        )
    authority_source = source_text
    if source_name == "InvestigationMachineClaimClient.swift":
        if len(re.findall(r"\bconnect\s*\(", source_text)) != 3:
            raise SystemExit(
                "ii-b4 fixed claim connection cardinality drifted"
            )
        authority_source = authority_source.replace(
            "NSXPCConnection", "FixedMachineClaimConnection"
        )
        authority_source = re.sub(
            r"\bconnect(?=\s*\()",
            "fixedMachineClaimConnect",
            authority_source,
        )
    elif source_name == "InvestigationMachineSingleEpoch.swift":
        send_shape = (len(re.findall(r"\bsend\s*\(", source_text)),
                      source_text.count("try await send("),
                      source_text.count("func send("), source_text.count("session.send("))
        if send_shape != (8, 5, 2, 1):
            raise SystemExit(f"ii-b5a typed frame send shape drifted: {send_shape}")
        authority_source = re.sub(r"\bsend(?=\s*\()", "typedFrameSend", authority_source)
    match = driver_support_authority_pattern.search(authority_source)
    if match:
        raise SystemExit(
            "Machine driver support gained prohibited authority: "
            f"{source_path}: {match.group(0)!r}"
        )
    open_call_count = len(re.findall(r"\b(?:Darwin\.)?open\s*\(", source_text))
    if source_name == "DarwinInvestigationMachineInstalledDriverSystem.swift":
        expected_open_call = (
            "let descriptor = open(\n"
            "            Self.manifestPath,\n"
            "            O_RDONLY | O_CLOEXEC | O_NOFOLLOW_ANY | O_UNIQUE | "
            "O_NONBLOCK\n"
            "        )"
        )
        expected_executable_open_call = (
            "let descriptor = open(\n"
            "            Self.path,\n"
            "            O_RDONLY | O_CLOEXEC | O_NOFOLLOW_ANY | O_UNIQUE | "
            "O_NONBLOCK\n"
            "        )"
        )
        if (
            open_call_count != 2
            or source_text.count(expected_open_call) != 1
            or source_text.count(expected_executable_open_call) != 1
        ):
            raise SystemExit(
                "Machine driver support read-only open contract drifted: "
                f"{source_path}"
            )
        allowed_security_symbols = {
            "SecCSFlags", "SecCode", "SecCodeCheckValidity",
            "SecCodeCopySelf", "SecCodeCopySigningInformation",
            "SecCodeCopyStaticCode", "SecRequirement",
            "SecRequirementCopyData", "SecRequirementGetTypeID",
            "SecStaticCode", "SecStaticCodeCheckValidity",
            "SecStaticCodeCreateWithPath", "kSecCSRequirementInformation",
            "kSecCSSigningInformation", "kSecCSStrictValidate",
            "kSecCodeInfoDesignatedRequirement", "kSecCodeInfoFlags",
            "kSecCodeInfoIdentifier", "kSecCodeInfoUnique",
        }
        observed_security_symbols = set(re.findall(
            r"\b(?:(?:Sec|kSec)[A-Z]|Authorization|CSSM)[A-Za-z0-9_]*\b",
            source_text,
        ))
        if observed_security_symbols != allowed_security_symbols:
            raise SystemExit(
                "Machine driver Security symbol allowlist drifted: "
                f"{sorted(observed_security_symbols)}"
            )
    elif open_call_count:
        raise SystemExit(
            "Machine driver support gained an unexpected open call: "
            f"{source_path}"
        )
    readiness_source = source_text
    if source_name == "InvestigationMachineSingleEpoch.swift":
        if source_text.count("kind: .preDropReady") != 1:
            raise SystemExit("ii-b5a PRE_DROP_READY shape drifted")
        readiness_source = source_text.replace("preDropReady", "preDropFrame")
    match = machine_readiness_pattern.search(readiness_source)
    if match:
        raise SystemExit(
            "Machine driver support gained prohibited readiness: "
            f"{source_path}: {match.group(0)!r}"
        )
