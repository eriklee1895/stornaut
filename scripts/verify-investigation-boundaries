stub = stub_path.read_text(encoding="utf-8")
boundary = boundary_path.read_text(encoding="utf-8")

def fail(message):
    raise SystemExit(message)

def swift_code(source):
    output = []
    index = 0
    block_depth = 0
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                block_depth += 1; index += 2
            elif source.startswith("*/", index):
                block_depth -= 1; index += 2
            else:
                output.append("\n" if source[index] == "\n" else " ")
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            if end < 0:
                output.extend(" " * (len(source) - index)); break
            output.extend(" " * (end - index)); index = end; continue
        if source.startswith("/*", index):
            block_depth = 1; output.extend("  " ); index += 2; continue
        if source.startswith('"""', index):
            end = source.find('"""', index + 3)
            if end < 0: fail("iv-b1b-ii unterminated Swift multiline string")
            raw = source[index:end + 3]
            output.extend("\n" if char == "\n" else " " for char in raw)
            index = end + 3; continue
        if source[index] == '"':
            output.append(" " ); index += 1
            while index < len(source):
                char = source[index]
                output.append("\n" if char == "\n" else " ")
                index += 1
                if char == "\\" and index < len(source):
                    output.append(" " ); index += 1
                elif char == '"': break
            continue
        output.append(source[index]); index += 1
    if block_depth: fail("iv-b1b-ii unterminated Swift block comment")
    return "".join(output)

def target(name):
    matches = re.findall(
        rf'(?ms)\.(?:executableTarget|testTarget|target)\(\s*name:\s*"{re.escape(name)}"'
        rf'\s*,(?P<body>.*?)^\s*\),', package
    )
    if len(matches) != 1:
        fail(f"ii-c0b-iii-2a target cardinality drifted: {name}")
    return matches[0]

support = target("StornautInvestigationMachineGateSupport")
gate = target("StornautInvestigationMachineGate")
if re.search(r"\b(?:exclude|sources)\s*:", support):
    fail("ii-c0b-iii-2a GateSupport source inventory drifted")
