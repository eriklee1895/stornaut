    r"@objc public protocol\s+(\w+)(?:\s*:[^{]+)?\s*\{(.*?)^\}",
    source,
    re.MULTILINE | re.DOTALL,
):
    observed[match.group(1)] = re.findall(
        r"^\s+func\s+(\w+)\s*\(",
        match.group(2),
        re.MULTILINE,
    )
if observed != expected:
    raise SystemExit(
        "Lifecycle exported XPC selector allowlist drifted: "
        f"expected={expected!r} observed={observed!r}"
    )
