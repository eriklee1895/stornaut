function verify_iib5biii_b2a_iia1v_contract() {
    local session_source=$1 observer_source=$2 focused_test_source=$3
    local boundary_test_source=$4
    local source
    for source in "$session_source" "$observer_source" \
        "$focused_test_source" "$boundary_test_source"
    do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source"
    done
    python3 - "$session_source" "$observer_source" \
        "$focused_test_source" "$boundary_test_source" <<'PY'
from pathlib import Path
import re
import sys

session_path, observer_path, focused_path, boundary_path = map(Path, sys.argv[1:])
session, observer, focused, boundary = (
    path.read_text(encoding="utf-8")
    for path in (session_path, observer_path, focused_path, boundary_path)
)

def fail(message):
    raise SystemExit(message)

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

def declaration(source, pattern, label):
    match = re.search(pattern, source, re.MULTILINE)
    if match is None:
        fail(f"iii-b2a-ii-a1-v declaration missing: {label}")
    opening = source.find("{", match.end())
    if opening < 0:
        fail(f"iii-b2a-ii-a1-v declaration malformed: {label}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    fail(f"iii-b2a-ii-a1-v declaration unterminated: {label}")

expected_imports = {
    session_path: {
        "Darwin", "Foundation", "StornautInvestigationInstalledL2",
    },
    observer_path: {
        "CInvestigationIdentitySupport", "Darwin",
    },
}
for path, source in ((session_path, session), (observer_path, observer)):
    if imports(source) != expected_imports[path]:
        fail("iii-b2a-ii-a1-v import surface drifted")

semantic = session + observer
if re.search(r"(?m)^\s*(?:public|open)\s+", semantic):
    fail("iii-b2a-ii-a1-v package boundary drifted")
if re.search(r"\b(?:Codable|Encodable|Decodable)\b", semantic):
    fail("iii-b2a-ii-a1-v Codable surface drifted")
for pattern in (
    r"\b(?:Executor|MoveToTrash|RegisteredAction|readiness|"
    r"signedRuntimeReady|implementationAvailable|admission)\b",
    r"\b(?:CommandLine\.arguments\.dropFirst|ProcessInfo\.processInfo\.environment)\b",
    r"\bStornaut(?:Execution|Core|Lifecycle|Codex|InvestigationRuntime|"
    r"InvestigationDiagnostic|ProbeBridge|ProcessSupport)\b",
    r"\bNSXPC(?:Connection|Listener)?\b",
    r"\b(?:URLSession|AppKit|SwiftUI|Network|NWConnection)\b",
):
    if re.search(pattern, semantic, re.IGNORECASE):
        fail("iii-b2a-ii-a1-v authority or product reachability drifted")

def require_markers(markers, diagnostic):
    if any(marker not in semantic for marker in markers):
        fail(diagnostic)

require_markers((
    "package struct InvestigationMachineDarwinInnerRoleObservation",
    "package struct InvestigationMachineDarwinInnerRoleValidator",
    "struct InvestigationMachineDarwinInnerRoleSystem",
