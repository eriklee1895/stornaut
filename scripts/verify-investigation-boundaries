machine_driver_scratch=$(mktemp -d \
    "${TMPDIR:-/tmp}/stornaut-machine-driver-binary.XXXXXX")
trap 'rm -rf "$machine_driver_scratch"' EXIT

function machine_driver_projection_sha256() {
    print -rn -- "$1" | shasum -a 256 | awk '{print $1}'
}

function machine_driver_projection_lines() {
    if [[ -z "$1" ]]; then
        print 0
    else
        print -r -- "$1" | awk 'END { print NR }'
    fi
}

function machine_driver_projection_matches() {
    local undefined_symbols=$1
    local loaded_libraries=$2
    local owned_symbols=$3
    local expected_undefined_sha=$4
    local expected_undefined_lines=$5
    local expected_loads_sha=$6
    local expected_loads_lines=$7
    local expected_owned_sha=$8
    local expected_owned_lines=$9

    [[ "$(machine_driver_projection_sha256 "$undefined_symbols")" \
        == "$expected_undefined_sha" \
        && "$(machine_driver_projection_lines "$undefined_symbols")" \
        == "$expected_undefined_lines" \
        && "$(machine_driver_projection_sha256 "$loaded_libraries")" \
        == "$expected_loads_sha" \
        && "$(machine_driver_projection_lines "$loaded_libraries")" \
        == "$expected_loads_lines" \
        && "$(machine_driver_projection_sha256 "$owned_symbols")" \
        == "$expected_owned_sha" \
        && "$(machine_driver_projection_lines "$owned_symbols")" \
        == "$expected_owned_lines" ]]
}

function require_exact_machine_driver_projection() {
    local configuration=$1
    local undefined_symbols=$2
    local loaded_libraries=$3
    local owned_symbols=$4
    local expected_undefined_sha expected_undefined_lines
    local expected_loads_sha expected_loads_lines
    local expected_owned_sha expected_owned_lines
    # Historical iii-b2a-ii-a2-i Release projection evidence. Current
    # iii-b2b-0 admission uses the values in the release branch below.
    local historical_expected_release_undefined_sha=200b958fb36101f258f67621035f80b89b26c465271ae6708cf5856de7bf573b
    local historical_expected_release_owned_sha=2232cd8aede221e91439b6e3634bc7fc3b007fa5aa145b8b0e65f52e5f98666e
    local historical_expected_owned_lines=3877
    # SwiftPM and Xcode link the same reviewed sources through distinct build
    # graphs. Keep this SwiftPM projection separate from the Xcode projection
    # pinned by verify-app-release-boundaries; neither may stand in for the other.
    local iib5biii_b2b1a0_swiftpm_debug_owned_sha=af92aa80c452f4d3b4b539a334d149e8f41b9f98633b4b4aed1728c568052870
    local iib5biii_b2b1a0_swiftpm_debug_owned_lines=7874
    local iib5biii_b2b1a0_swiftpm_release_owned_sha=459abfb64cf21475780a79ed8dd7c6088603b386f8a196dac14c282b49fcc08c
    local iib5biii_b2b1a0_swiftpm_release_owned_lines=5503
    local iib5biii_b2b1a1_swiftpm_debug_owned_sha=9eed7d1f1d064fa35bb75525a1dde998fd5f8ded763381381e99d698aea920db
    local iib5biii_b2b1a1_swiftpm_debug_owned_lines=8200
    local iib5biii_b2b1a1_swiftpm_release_owned_sha=b85e9d441260f2fc2cf193ad1fdb76c0f5957e40ff84d4d1443882a2fccf555b
    local iib5biii_b2b1a1_swiftpm_release_owned_lines=5758
    # Preserve the completed iii-b2b-1a-1 projection as historical evidence.
    # Current iii-b2b-1b-ii admission uses separately measured values below.
    local iib5biii_b2b1a1_swiftpm_debug_undefined_sha=574d07d1ceb6fbe04619f6abde040833c87b3ee0098a3458169aa0f6c484e36f
    local iib5biii_b2b1a1_swiftpm_debug_undefined_lines=692
    local iib5biii_b2b1a1_swiftpm_release_undefined_sha=22beeec4664d72ad0809d4788f3574fdae93a239aba0055793245374a4549ba1
    local iib5biii_b2b1a1_swiftpm_release_undefined_lines=494
    # iii-b2b-1b-ii current-source projections were measured from a fresh
    # SwiftPM scratch build; Xcode values remain independently pinned.
    local iib5biii_b2b1b_swiftpm_debug_undefined_sha=f267aa32579fa4fc216b603638eecbc2065741569bdc81bc713a449bb61b8a8c
    local iib5biii_b2b1b_swiftpm_debug_undefined_lines=696
    local iib5biii_b2b1b_swiftpm_release_undefined_sha=7c404634c3da87081f3cd2d716c61df7ad45c8583d22103b95d3e6e956e6f981
    local iib5biii_b2b1b_swiftpm_release_undefined_lines=499
    local iib5biii_b2b1b_swiftpm_loads_sha=dde8b8c4542bf1afbf276ecb5d5341bb35f3f95529573d149d1143cb18c080c9
    local iib5biii_b2b1b_swiftpm_loads_lines=18
    local iib5biii_b2b1b_swiftpm_debug_owned_sha=09cbd025b5367b04fb8a762dab6b20739e77630fed36b21036129977588dbd92
    local iib5biii_b2b1b_swiftpm_debug_owned_lines=8662
    local iib5biii_b2b1b_swiftpm_release_owned_sha=8570228a2bb16262520142d397ecee0cd415f42a01b41e142abc983bf1a89270
    local iib5biii_b2b1b_swiftpm_release_owned_lines=5997
    # ii-c evidence verification adds only InstalledL2 semantic replay and the
    # typed epoch evidence commit path; authority deny-lists remain unchanged.
    local iic_evidence_debug_undefined_sha=d074185a004ead52e4a03578d4d5bfcca0acd157b8b5e30d7b92eac431866efd
    local iic_evidence_debug_undefined_lines=700
    local iic_evidence_release_undefined_sha=b9a223db4819b6831a1e424d91be1f614ed52ab91413c9b9f0d55de0df09d155
    local iic_evidence_release_undefined_lines=508
    local iic_evidence_debug_owned_sha=78c04b12d372f99e532906c448dc99aa7a79f586f31a2e77b6daa66388b69ece
    local iic_evidence_debug_owned_lines=9079
    local iic_evidence_release_owned_sha=9698db9e44494baed7c24d98ce1b03f3a9aef97b6f0dae5a45145cc6905430bc
    local iic_evidence_release_owned_lines=6306

    case "$configuration" in
        debug)
            expected_undefined_sha=$iic_evidence_debug_undefined_sha
            expected_undefined_lines=$iic_evidence_debug_undefined_lines
            expected_loads_sha=$iib5biii_b2b1b_swiftpm_loads_sha
            expected_loads_lines=$iib5biii_b2b1b_swiftpm_loads_lines
            expected_owned_sha=$iic_evidence_debug_owned_sha
            expected_owned_lines=$iic_evidence_debug_owned_lines
            ;;
        release)
            expected_undefined_sha=$iic_evidence_release_undefined_sha
            expected_undefined_lines=$iic_evidence_release_undefined_lines
            expected_loads_sha=$iib5biii_b2b1b_swiftpm_loads_sha
            expected_loads_lines=$iib5biii_b2b1b_swiftpm_loads_lines
            expected_owned_sha=$iic_evidence_release_owned_sha
            expected_owned_lines=$iic_evidence_release_owned_lines
            ;;
        *)
            print -u2 "Unknown Machine driver projection: $configuration"
            return 64
            ;;
    esac

    machine_driver_projection_matches \
        "$undefined_symbols" \
        "$loaded_libraries" \
        "$owned_symbols" \
        "$expected_undefined_sha" \
        "$expected_undefined_lines" \
        "$expected_loads_sha" \
        "$expected_loads_lines" \
        "$expected_owned_sha" \
        "$expected_owned_lines"
}

function verify_machine_driver_projection_mutations() {
    local configuration=$1
    local undefined_symbols=$2
    local loaded_libraries=$3
    local owned_symbols=$4
    local forbidden_added required_removed security_added
    local load_added owned_added

    forbidden_added=$(print -r -- "$undefined_symbols"$'\n''_unlink' \
        | LC_ALL=C sort -u)
    required_removed=$(print -r -- "$undefined_symbols" \
        | grep -Fxv -- _pread | LC_ALL=C sort -u)
    security_added=$(print -r -- "$undefined_symbols"$'\n''_SecItemCopyMatching' \
        | LC_ALL=C sort -u)
    load_added=$(print -r -- "$loaded_libraries"$'\n''/tmp/forbidden.dylib' \
        | LC_ALL=C sort -u)
    owned_added=$(print -r -- "$owned_symbols"$'\n''StornautInvestigationMachineDriverSupport.ForbiddenOwnedSymbol' \
        | LC_ALL=C sort -u)
    for mutation in \
        "$forbidden_added" \
        "$required_removed" \
        "$security_added"
    do
        if require_exact_machine_driver_projection \
            "$configuration" \
            "$mutation" \
            "$loaded_libraries" \
            "$owned_symbols"
        then
            print -u2 \
                "Machine driver projection mutation was accepted: $configuration"
            return 1
        fi
    done
    if require_exact_machine_driver_projection \
        "$configuration" "$undefined_symbols" "$load_added" "$owned_symbols"
    then
        print -u2 \
            "Machine driver load projection mutation was accepted: $configuration"
        return 1
    fi
    if require_exact_machine_driver_projection \
        "$configuration" "$undefined_symbols" "$loaded_libraries" "$owned_added"
    then
        print -u2 \
            "Machine driver owned projection mutation was accepted: $configuration"
        return 1
    fi
}

    authority_markers=(
        'StornautExecution.'
        'StornautCore.ActionExecutor'
        'StornautCore.TrashMoving'
        'StornautCore.FileManagerTrashAdapter'
        'StornautCore.Cleanup'
        'StornautCore.ActionPolicy'
        'StornautCore.ExecutionAuthorization'
        'StornautCore.RegisteredAction'
        'StornautCore.MoveToTrash'
        'StornautCore.ProposedCleanupAction'
        'Darwin.write'
        'Darwin.pwrite'
        'Darwin.unlink'
        'Darwin.rename'
        'Darwin.truncate'
        'Darwin.ftruncate'
        'Darwin.fork'
        'Darwin.exec'
        'Darwin.kill'
        'Darwin.socket'
        'Darwin.connect'
    )
    authority_imports=(
        _fork _vfork _execv _execve _execvp _execvP _execl _execlp
        _posix_spawnp _system _popen _dlopen _dlsym _syscall _fcntl _ioctl
