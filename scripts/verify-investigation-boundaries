function verify_iib5biii_b2a_iia2i_scope() {
    local baseline=${1:-8362b47351a7d3b3a141fc78ec03f9575199901d}
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinAppIdentityObservation.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochRetirement.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinAppIdentityObservationTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochRetirementTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 10 )) || {
        print -u2 "iii-b2a-ii-a2-i checkpoint path ceiling drifted"
        return 1
    }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" \
        == 8362b47351a7d3b3a141fc78ec03f9575199901d ]] || {
        print -u2 "iii-b2a-ii-a2-i checkpoint baseline drifted"
        return 1
    }
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "iii-b2a-ii-a2-i checkpoint deleted an existing path"
        return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "iii-b2a-ii-a2-i binary checkpoint path rejected"
        return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "iii-b2a-ii-a2-i staged checkpoint paths drifted"
        return 1
    }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644
        [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $expected_path" ]] || {
            print -u2 "iii-b2a-ii-a2-i checkpoint mode drifted: $expected_path"
            return 1
        }
    done
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 3200 )) || {
        print -u2 "iii-b2a-ii-a2-i checkpoint budget drifted"
        return 1
    }
}

