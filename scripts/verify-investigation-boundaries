function verify_iicb2b1_staged_scope() {
    local PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local baseline=${1:-61cdeddac657a18cac12e7cc04d62b551675b4bd}
    local expected_baseline=61cdeddac657a18cac12e7cc04d62b551675b4bd
    local -a expected=(
        Package.swift
        Sources/CInvestigationMachineCampaignSupport/include/CInvestigationMachineCampaignSupport.h
        Sources/CInvestigationMachineCampaignSupport/CInvestigationMachineCampaignSupport.c
        Sources/StornautInvestigationMachineCampaignSupport/InvestigationMachineCampaignHarness.swift
        Tests/StornautInvestigationTests/InvestigationMachineCampaignHarnessTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-investigation-boundaries
        scripts/verify-contract
    )
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == $expected_baseline ]] || { print -u2 "ii-c-b2b1 checkpoint baseline drifted"; return 1; }
    local deleted observed_text changed item mode entry
    deleted=$(git diff --cached --name-only --diff-filter=D "$baseline" | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    [[ -z $deleted ]] || { print -u2 "ii-c-b2b1 checkpoint deleted an existing path"; return 1; }
    observed_text=$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    local -a observed=(${(f)observed_text})
    (( ${#expected} == 8 && ${#observed} <= 8 )) || { print -u2 "ii-c-b2b1 checkpoint path ceiling drifted"; return 1; }
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || { print -u2 "ii-c-b2b1 checkpoint paths drifted"; return 1; }
    changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1&&$3!="AGENTS.md"&&$3!="README.md"{if($1=="-"||$2=="-")exit 2;n+=$1+$2}END{print n+0}') || { print -u2 "ii-c-b2b1 binary checkpoint path rejected"; return 1; }
    (( changed <= 2000 )) || { print -u2 "ii-c-b2b1 checkpoint budget drifted"; return 1; }
    local -a worktree_paths=(${(f)"$(git diff --name-only --diff-filter=ACMRD -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    local -a untracked_paths=(${(f)"$(git ls-files --others --exclude-standard -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    for item in "${worktree_paths[@]}" "${untracked_paths[@]}"; do (( ${expected[(Ie)$item]} )) || { print -u2 "ii-c-b2b1 checkpoint worktree paths drifted"; return 1; }; done
    for item in "${expected[@]}"; do
        mode=100644; [[ $item == scripts/* ]] && mode=100755; entry=$(git ls-files -s -- "$item")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" == "$mode 0 $item" && "$(print -r -- "$entry" | awk '{print $2}')" == "$(git hash-object -- "$item")" ]] || { print -u2 "ii-c-b2b1 staged source/mode drifted: $item"; return 1; }
    done
}

function verify_iicb2b2_source_contract() {
    local PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local -a p=("${iicb2b2_sources[@]}")
    if (( ${#p} == 0 )); then p=(
        Package.swift
        Sources/StornautInvestigationMachineCampaign/main.swift
        Sources/CInvestigationMachineCampaignSupport/CInvestigationMachineCampaignSupport.c
        Tests/Fixtures/InvestigationMachineCampaignCoordinator/main.swift
        Tests/StornautInvestigationTests/InvestigationMachineCampaignHarnessTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-investigation-boundaries
        scripts/verify-app-release-boundaries
        scripts/verify-contract
    ); fi
    (( ${#p} == 9 )) || { print -u2 "ii-c-b2b2 source cardinality drifted"; return 1; }
    local item
    for item in "${p[@]}"; do [[ -f $item && ! -L $item ]] \
        || { print -u2 "ii-c-b2b2 source path unavailable: $item"; return 1; }; done
    /usr/bin/xcrun swiftc -frontend -parse -enable-bare-slash-regex "${p[2]}"
    /usr/bin/xcrun swiftc -frontend -parse -enable-bare-slash-regex "${p[4]}"
    /usr/bin/xcrun swiftc -frontend -parse -enable-bare-slash-regex "${p[5]}"
    /usr/bin/xcrun swiftc -frontend -parse -enable-bare-slash-regex "${p[6]}"
    /usr/bin/xcrun clang -fsyntax-only \
        -I Sources/CInvestigationMachineCampaignSupport/include "${p[3]}"
    /bin/zsh -n "${p[7]}"; /bin/zsh -n "${p[8]}"; /bin/zsh -n "${p[9]}"
    /usr/bin/python3 -I - "${p[@]}" <<'PY'
from pathlib import Path
import re, sys
if len(sys.argv) != 10: raise SystemExit("ii-c-b2b2 source cardinality drifted")
package, executable, transport, fixture, tests, boundary, gate, release, contract = (Path(x).read_text() for x in sys.argv[1:])
target = '''        .executableTarget(
            name: "StornautInvestigationMachineCampaign",
            dependencies: [
                "StornautInvestigationMachineCampaignSupport",
            ],
            path: "Sources/StornautInvestigationMachineCampaign"
        ),'''
if package.count(target) != 1 or package.split("targets: [",1)[0].find("StornautInvestigationMachineCampaign") >= 0: raise SystemExit("ii-c-b2b2 package-only executable drifted")
if package.count('"StornautInvestigationMachineCampaign"') != 2: raise SystemExit("ii-c-b2b2 product or reverse dependency drifted")
if not executable.startswith("import CInvestigationIdentitySupport\nimport CInvestigationMachineCampaignSupport\nimport Darwin\nimport Dispatch\nimport Foundation\nimport StornautInvestigationHandoffContract\n\n#if DEBUG\nimport StornautInvestigationMachineCampaignSupport\n"): raise SystemExit("ii-c-b2b2 executable import boundary drifted")
for marker in ("CommandLine.argc == 1", "CampaignDarwinSystem", "stornaut_investigation_campaign_spawn_fixed", "stornaut_investigation_campaign_bootstrap_fixed", "bootstrapVerified", "proc_pidinfo", "proc_listallpids", "waitpid", "kill(-groupID, SIGKILL)", "static func main() { exit(78) }"):
    if marker not in executable: raise SystemExit("ii-c-b2b2 executable lifecycle drifted")
for marker in ("stornaut_campaign_preserve_terminal_output_bytes",
               "attributes.c_oflag &= (tcflag_t)~ONLCR",
               "stornaut_campaign_preserve_terminal_output_bytes(descriptors[1])"):
    if marker not in transport:
        raise SystemExit("ii-c-b2b2 exact PTY output drifted: " + marker)
if transport.index("stornaut_campaign_preserve_terminal_output_bytes(descriptors[1])") > transport.index("posix_spawn("):
    raise SystemExit("ii-c-b2b2 PTY output ordering drifted")
allowed_sudo = (
    'Self.runFixed("/usr/bin/sudo", ["-knv"], maximum: 4_096)',
    '["command":"/usr/bin/sudo -knv",',
    'runFixed("/usr/bin/sudo",\n            ["-k","--","/bin/zsh","-f","-s","--","--held-source",script.root,action]+script.hashes+[script.plist],standardInput:script.bytes,maximum:16_384)',
)
if any(executable.count(marker) != 1 for marker in allowed_sudo):
    raise SystemExit("ii-c-b2b2 fixed sudo contract drifted")
for marker in ("guard probe.status != 0 else { throw Failure.invalid }",
               "standardInput:script.bytes", "maximum:16_384"):
    if executable.count(marker) != 1:
        raise SystemExit("ii-c-b2b2 fixed sudo contract drifted")
authority_surface = executable
for marker in allowed_sudo:
    authority_surface = authority_surface.replace(marker, "", 1)
for forbidden in ("StornautCore","StornautCodex","StornautExecution","CoordinatorSupport","MachineLaunchSupport","NSXPC","URLSession","sudo","launchctl","MoveToTrash","RegisteredAction"):
    if forbidden in authority_surface + fixture: raise SystemExit("ii-c-b2b2 prohibited authority drifted")
for marker in ("CAMPAIGN_FIXTURE_TRUNCATED","CAMPAIGN_FIXTURE_TRAILING","CAMPAIGN_FIXTURE_MISSING_EOF","CAMPAIGN_FIXTURE_NONZERO","tcgetpgrp(STDERR_FILENO) == getpid()","STORNAUT_INVESTIGATION_CAMPAIGN_RECEIPT_FD",r'Data("campaign-physical-diagnostic\n".utf8)'):
    if marker not in fixture: raise SystemExit("ii-c-b2b2 fixture matrix drifted")
for marker in ("physicalExecutableUsesControllingPTYAndExactFD3","physicalFailuresRemainBoundedAndLeaveZeroResidue",r'report.diagnostic == "campaign-physical-diagnostic\n"',".truncated, .trailing, .missingEOF, .nonzero, .missingSibling","processGroupResidueCount == 0","sessionResidueCount == 0"):
    if marker not in tests: raise SystemExit("ii-c-b2b2 physical tests became vacuous")
for marker in ("iiCB2B2PhysicalCampaignPinsFinalNonPrivilegedBoundary","--iic-b2b2-source-contract-only","--iic-b2b2-staged-scope-contract-only","--iic-b2b2-component-boundary-only","--iic-b2b2-contract-only"):
    if marker not in boundary: raise SystemExit("ii-c-b2b2 boundary markers drifted")
if '"$gate" --iic-b2b2-source-contract-only' not in contract:
    raise SystemExit("ii-c-b2b2 current source gate wiring drifted")
if '"$release" --iic-b2b2-component-boundary-only' not in contract:
    raise SystemExit("ii-c-b2b2 component gate wiring drifted")
project = Path("Stornaut.xcodeproj/project.pbxproj").read_text(); schemes = "".join(p.read_text() for p in Path("Stornaut.xcodeproj/xcshareddata/xcschemes").glob("*.xcscheme"))
if "StornautInvestigationMachineCampaign" in project + schemes: raise SystemExit("ii-c-b2b2 Xcode reachability drifted")
PY
}

function verify_iicb2b2_staged_scope() {
    local PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local baseline=${1:-2b90430876c2515e811d84155160daa1b599fa98}
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == \
        2b90430876c2515e811d84155160daa1b599fa98 ]] || {
        print -u2 "ii-c-b2b2 checkpoint baseline drifted"; return 1
    }
    local -a expected=(
        Package.swift Sources/StornautInvestigationMachineCampaign/main.swift
        Tests/Fixtures/InvestigationMachineCampaignCoordinator/main.swift
        Tests/StornautInvestigationTests/InvestigationMachineCampaignHarnessTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-investigation-boundaries
        scripts/verify-app-release-boundaries scripts/verify-contract
    )
    local deleted observed_text changed item mode entry
    deleted=$(git diff --cached --name-only --diff-filter=D "$baseline" | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    [[ -z $deleted ]] || { print -u2 "ii-c-b2b2 checkpoint deleted an existing path"; return 1; }
    observed_text=$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    local -a observed=(${(f)observed_text})
    (( ${#expected} == 8 && ${#observed} <= 8 )) || { print -u2 "ii-c-b2b2 checkpoint path ceiling drifted"; return 1; }
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || { print -u2 "ii-c-b2b2 checkpoint paths drifted"; return 1; }
    changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1&&$3!="AGENTS.md"&&$3!="README.md"{if($1=="-"||$2=="-")exit 2;n+=$1+$2}END{print n+0}') || { print -u2 "ii-c-b2b2 binary checkpoint path rejected"; return 1; }
    (( changed <= 2000 )) || { print -u2 "ii-c-b2b2 checkpoint budget drifted"; return 1; }
    local -a worktree_paths=(${(f)"$(git diff --name-only --diff-filter=ACMRD -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    local -a untracked_paths=(${(f)"$(git ls-files --others --exclude-standard -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    for item in "${worktree_paths[@]}" "${untracked_paths[@]}"; do (( ${expected[(Ie)$item]} )) || { print -u2 "ii-c-b2b2 checkpoint worktree paths drifted"; return 1; }; done
    for item in "${expected[@]}"; do mode=100644; [[ $item == scripts/* ]] && mode=100755; entry=$(git ls-files -s -- "$item"); [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" == "$mode 0 $item" && "$(print -r -- "$entry" | awk '{print $2}')" == "$(git hash-object -- "$item")" ]] || { print -u2 "ii-c-b2b2 staged source/mode drifted: $item"; return 1; }; done
}

function verify_iic_root_driver_lineage_l1_source_contract() {
    local -a paths=("${iic_lineage_l1_sources[@]}")
    if (( ${#paths} == 0 )); then
        paths=(
            Package.swift
            Sources/StornautInvestigationHandoffContract/InvestigationResolvedRootDriverLineageContract.swift
            Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineResolvedRootDriverClaim.swift
            Sources/StornautInvestigationMachineGateSupport/InvestigationMachineResolvedRootDriverValidator.swift
            Tests/StornautInvestigationTests/InvestigationResolvedRootDriverLineageContractTests.swift
            Tests/StornautInvestigationTests/InvestigationMachineResolvedRootDriverClaimTests.swift
            Tests/StornautInvestigationTests/InvestigationMachineResolvedRootDriverValidatorTests.swift
            Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
            scripts/verify-investigation-boundaries
            scripts/verify-contract
            scripts/verify-app-release-boundaries
        )
    fi
    /usr/bin/python3 -I - \
        "$iic_lineage_l1_mutation_contract_only" \
        "$iic_lineage_l1_mutation_name" "$iic_lineage_l1_mutation_slot" \
        "$iic_lineage_l1_mutation_sha" "${paths[@]}" <<'PY'
from pathlib import Path
import hashlib, re, sys

mode, mutation_name, mutation_slot, mutation_sha = sys.argv[1:5]
slots = ("package", "contract", "claim", "validator",
         "contract_tests", "claim_tests", "validator_tests",
         "boundary_tests", "boundary", "contract_gate", "release")
canonical_paths = tuple(map(Path, (
    "Package.swift",
    "Sources/StornautInvestigationHandoffContract/InvestigationResolvedRootDriverLineageContract.swift",
    "Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineResolvedRootDriverClaim.swift",
    "Sources/StornautInvestigationMachineGateSupport/InvestigationMachineResolvedRootDriverValidator.swift",
    "Tests/StornautInvestigationTests/InvestigationResolvedRootDriverLineageContractTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineResolvedRootDriverClaimTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineResolvedRootDriverValidatorTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift",
    "scripts/verify-investigation-boundaries", "scripts/verify-contract",
    "scripts/verify-app-release-boundaries",
)))
paths = tuple(map(Path, sys.argv[5:]))
if len(paths) != 11:
    raise SystemExit("ii-c root-driver lineage L1 source cardinality drifted")
sources = dict(zip(slots, (path.read_text(encoding="utf-8") for path in paths)))
canonical = dict(zip(slots, (path.read_text(encoding="utf-8") for path in canonical_paths)))
if mode == "true":
    if mutation_slot not in slots or not mutation_name or re.fullmatch(r"[0-9a-f]{64}", mutation_sha) is None:
        raise SystemExit("ii-c root-driver lineage L1 mutation identity drifted")
    changed = [slot for slot in slots if sources[slot] != canonical[slot]]
    if changed != [mutation_slot]:
        raise SystemExit("ii-c root-driver lineage L1 mutation scope drifted")
    if hashlib.sha256(paths[slots.index(mutation_slot)].read_bytes()).hexdigest() != mutation_sha:
        raise SystemExit("ii-c root-driver lineage L1 mutation SHA drifted")
elif mode != "false" or mutation_name or mutation_slot or mutation_sha:
    raise SystemExit("ii-c root-driver lineage L1 mutation mode drifted")
elif sources != canonical:
    raise SystemExit("ii-c root-driver lineage L1 canonical source paths drifted")

package = sources["package"]
match = re.search(r'(?ms)\.target\(\s*name: "StornautInvestigationMachineGateSupport",(?P<body>.*?)\n        \),', package)
if match is None:
    raise SystemExit("ii-c root-driver lineage GateSupport target missing")
gate = match.group("body")
for marker in ("StornautInvestigationHandoffContract",
               "CInvestigationIdentitySupport",
               "StornautInvestigationInstalledL2",
               '.linkedFramework("Security")'):
    if gate.count(marker) != 1:
        raise SystemExit("ii-c root-driver lineage GateSupport dependency drifted")
for forbidden in ("StornautCore", "StornautExecution",
                  "CampaignSupport", "StornautProduct"):
    if forbidden in gate:
        raise SystemExit("ii-c root-driver lineage authority leaked into GateSupport")

for slot in ("contract", "claim", "validator"):
    source = sources[slot]
    if not source.strip() or "import StornautCore" in source \
            or "import StornautExecution" in source \
            or "import StornautInvestigationMachineCampaignSupport" in source:
        raise SystemExit("ii-c root-driver lineage source boundary drifted: " + slot)
    for forbidden in ("sudo", "launchctl", "URLSession",
                      "NWConnection", "production seam", "SecCode",
                      "SecStaticCode", "kSec", "Authorization"):
        if forbidden in source:
            raise SystemExit("ii-c root-driver lineage production authority drifted: " + slot)
    if re.search(r"(?<![A-Za-z0-9_])Process\s*\(", source):
        raise SystemExit("ii-c root-driver lineage process launch authority drifted: " + slot)
for slot in ("contract_tests", "claim_tests", "validator_tests"):
    if "@Test" not in sources[slot]:
        raise SystemExit("ii-c root-driver lineage focused tests became vacuous: " + slot)
validator = sources["validator"]
for marker in (
    "projectedCohortInput: InvestigationProjectedCohortInput",
    "input.projectedCohortInput.capsule.outerAttemptUUID",
    "input.projectedCohortInput.wholeInputSHA256",
    "input.projectedCohortInput.projections.allSatisfy",
):
    if marker not in validator:
        raise SystemExit("ii-c root-driver lineage projected-input binding drifted")
if "installedL2Projections" in validator:
    raise SystemExit("ii-c root-driver lineage accepted detached projections")
for marker in ("--iic-root-driver-lineage-l1-source-contract-only",
               "--iic-root-driver-lineage-l1-staged-scope-contract-only",
               "--iic-root-driver-lineage-l1-contract-only",
               "--iic-root-driver-lineage-l1-component-boundary-only"):
    if marker not in sources["boundary_tests"] + sources["boundary"] \
            + sources["contract_gate"] + sources["release"]:
        raise SystemExit("ii-c root-driver lineage verifier wiring drifted: " + marker)
component_prologue = (
    "function verify_iic_root_driver_lineage_l1_component_boundary() (\n"
    "    local -x PATH=/usr/bin:/bin:/usr/sbin:/sbin; "
    "local require_staged=${1:-true}"
)
if sources["release"].count(component_prologue) != 1:
    raise SystemExit("ii-c root-driver lineage component PATH export drifted")
release = sources["release"]
component_start = release.index(component_prologue)
component_end = release.index(
    "\n)\n\nif $legacy_machine_claim_contract_only", component_start
)
component = release[component_start:component_end]
for marker in (
    "'(^|[[:space:]])_(Authorization|Sec|kSec)[A-Za-z0-9_]+'",
    '[[ -f $image && ! -L $image',
    '/usr/bin/file -b "$image"',
    'symbols=$(xcrun nm -j "$image"',
    'ResolvedRootDriverClaimV1',
    'InvestigationMachineResolvedRootDriverClaimCollector',
    '$symbols != *InvestigationMachineResolvedRootDriverValidator*',
    'SurveyorBenchmark', 'stornaut-rule-compiler',
    'stornaut-lifecycle-spike', 'stornaut-capability-runtime-verifier',
):
    if component.count(marker) != 1:
        raise SystemExit("ii-c root-driver lineage component scan drifted: " + marker)
for forbidden in ('[[ -e $image ]] || continue', '|| true', 'return 0'):
    if forbidden in component:
        raise SystemExit("ii-c root-driver lineage component scan became fail-open")
if re.search(
    r'(?m)^verify_iic_root_driver_lineage_l1_component_boundary false$',
    release,
) is None:
    raise SystemExit("ii-c root-driver lineage default component dispatch drifted")
if sources["contract_gate"].count(
    'verify_iic_root_driver_lineage_l1_contract "$contract_root/iic-lineage-l1" false'
) != 1:
    raise SystemExit("ii-c root-driver lineage default contract dispatch drifted")
PY
}

function verify_iic_root_driver_lineage_l1_staged_scope() {
    local PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local expected_baseline=0815ee26624f83520e30ce68aa54396761c14566
    local baseline=${1:-$iic_lineage_l1_scope_baseline}
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == $expected_baseline ]] \
        || { print -u2 "ii-c root-driver lineage L1 checkpoint baseline drifted"; return 1; }
    local -A ceilings=(
        Package.swift 20
        Sources/StornautInvestigationHandoffContract/InvestigationResolvedRootDriverLineageContract.swift 520
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineResolvedRootDriverClaim.swift 520
        Sources/StornautInvestigationMachineGateSupport/InvestigationMachineResolvedRootDriverValidator.swift 700
        Tests/StornautInvestigationTests/InvestigationResolvedRootDriverLineageContractTests.swift 480
        Tests/StornautInvestigationTests/InvestigationMachineResolvedRootDriverClaimTests.swift 420
        Tests/StornautInvestigationTests/InvestigationMachineResolvedRootDriverValidatorTests.swift 600
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift 80
        scripts/verify-investigation-boundaries 350
        scripts/verify-contract 140
        scripts/verify-app-release-boundaries 80
    )
    local -A required=(
        Sources/StornautInvestigationMachineCampaign/main.swift 1
        Sources/StornautInvestigationMachineCampaignSupport/InvestigationMachineCampaignHarness.swift 1
        Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift 1
        Tests/StornautInvestigationTests/InvestigationMachineCampaignEvidenceTests.swift 1
    )
    local -a expected=(
        Package.swift
        Sources/StornautInvestigationHandoffContract/InvestigationResolvedRootDriverLineageContract.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineResolvedRootDriverClaim.swift
        Sources/StornautInvestigationMachineGateSupport/InvestigationMachineResolvedRootDriverValidator.swift
        Tests/StornautInvestigationTests/InvestigationResolvedRootDriverLineageContractTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineResolvedRootDriverClaimTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineResolvedRootDriverValidatorTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-investigation-boundaries scripts/verify-contract
        scripts/verify-app-release-boundaries
    )
    local deleted observed_text numstat checkpoint_path add delete ceiling total=0 entry mode
    deleted=$(git diff --cached --name-only --diff-filter=D "$baseline" -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    [[ -z $deleted ]] || { print -u2 "ii-c root-driver lineage L1 checkpoint deleted an existing path"; return 1; }
    observed_text=$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    local -a observed=(${(f)observed_text})
    (( ${#expected} == 11 && ${#observed} == 11 )) \
        || { print -u2 "ii-c root-driver lineage L1 checkpoint path cardinality drifted"; return 1; }
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] \
        || { print -u2 "ii-c root-driver lineage L1 checkpoint paths drifted"; return 1; }
    numstat=$(git diff --cached --numstat "$baseline" --) || return $?
    while IFS=$'\t' read -r add delete checkpoint_path; do
        [[ $checkpoint_path == docs/* || $checkpoint_path == AGENTS.md || $checkpoint_path == README.md ]] && continue
        [[ $add != - && $delete != - ]] || { print -u2 "ii-c root-driver lineage L1 binary path rejected"; return 1; }
        (( ${+ceilings[$checkpoint_path]} )) || { print -u2 "ii-c root-driver lineage L1 checkpoint paths drifted"; return 1; }
        ceiling=${ceilings[$checkpoint_path]}
        (( add + delete <= ceiling )) || { print -u2 "ii-c root-driver lineage L1 path budget drifted: $checkpoint_path"; return 1; }
        (( total += add + delete ))
    done <<< "$numstat"
    (( total <= 3900 )) || { print -u2 "ii-c root-driver lineage L1 aggregate budget drifted"; return 1; }
    local worktree=$(git diff --name-only --diff-filter=ACMRD -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    local untracked=$(git ls-files --others --exclude-standard -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    [[ -z $worktree && -z $untracked ]] || { print -u2 "ii-c root-driver lineage L1 index/worktree drifted"; return 1; }
    for checkpoint_path in "${expected[@]}"; do
        mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" == "$mode 0 $checkpoint_path" ]] \
            || { print -u2 "ii-c root-driver lineage L1 checkpoint mode drifted: $checkpoint_path"; return 1; }
        [[ "$(print -r -- "$entry" | awk '{print $2}')" == "$(git hash-object -- "$checkpoint_path")" ]] \
            || { print -u2 "ii-c root-driver lineage L1 staged/worktree blob drifted: $checkpoint_path"; return 1; }
    done
}

