interactive_native_source_contract_sources=()
if (( $# > 0 )); then
    if (( $# == 2 )) && [[ $1 == --claim-asid-contract-only ]]; then
        claim_asid_contract_only=true
        claim_asid_contract_source=$2
    elif (( $# == 2 )) && [[ $1 == --deadline-state-contract-only ]]; then
        deadline_state_contract_only=true
        deadline_state_contract_source=$2
    elif (( $# == 4 )) && [[ $1 == --claim-server-contract-only ]]; then
        claim_server_contract_only=true
        claim_server_adapter_source=$2
        claim_server_effects_source=$3
        claim_server_deadline_source=$4
    elif (( $# == 3 )) && [[ $1 == --claim-server-package-contract-only ]]; then
        claim_server_package_contract_only=true
        claim_server_package_graph=$2
        claim_server_package_manifest=$3
    elif (( $# == 5 )) \
        && [[ $1 == --legacy-machine-claim-contract-only ]]; then
