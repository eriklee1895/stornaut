function verify_iic_root_driver_lineage_l2_staged_scope() {
    local -x PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local baseline=${1:-$iic_lineage_l2_scope_baseline}
    local expected_baseline=cd8fc5d8645a8d40fb7571e4be41b8b9d1a70725
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == $expected_baseline ]] || { print -u2 "ii-c root-driver lineage L2 checkpoint baseline drifted"; return 1; }
    local -A ceilings=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineZeroArgumentEntry.swift 950 Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift 30
        Sources/StornautInvestigationMachineGateSupport/InvestigationMachineGateTransport.swift 320 Sources/StornautInvestigationMachineGateSupport/InvestigationMachineFixedGateLauncher.swift 300 Sources/StornautInvestigationMachineGateSupport/DarwinInvestigationMachineFixedGateSystem.swift 650
        Sources/StornautInvestigationMachineCampaignSupport/InvestigationMachineCampaignEvidenceContract.swift 250 Sources/StornautInvestigationMachineCampaign/main.swift 180
        Tests/StornautInvestigationTests/InvestigationMachineZeroArgumentEntryTests.swift 800 Tests/StornautInvestigationTests/InvestigationSudoShapedDriverLauncherTests.swift 550 Tests/StornautInvestigationTests/InvestigationMachineCampaignEvidenceTests.swift 400 Tests/StornautInvestigationTests/InvestigationFixedGateHandoffPhysicalTests.swift 60 Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift 60
        scripts/verify-investigation-runtime-machine-report 300 scripts/verify-investigation-boundaries 350 scripts/verify-contract 200)
    local -a expected=(${(k)ceilings}) observed
    local text checkpoint_path add delete total=0 mode entry
    [[ -z "$(git diff --cached --name-only --diff-filter=D "$baseline" -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')" ]] || { print -u2 "ii-c root-driver lineage L2 checkpoint deleted an existing path"; return 1; }
    text=$(git diff --cached --name-only --diff-filter=ACMR "$baseline" -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"'); observed=(${(f)text})
    (( ${#expected}==15 && ${#observed}==15 )) && [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || { print -u2 "ii-c root-driver lineage L2 checkpoint paths drifted"; return 1; }
    while IFS=$'\t' read -r add delete checkpoint_path; do [[ $checkpoint_path == docs/* || $checkpoint_path == AGENTS.md || $checkpoint_path == README.md ]] && continue; [[ $add != - && $delete != - ]] || { print -u2 "ii-c root-driver lineage L2 binary checkpoint path rejected: $checkpoint_path"; return 1; }; (( add+delete<=ceilings[$checkpoint_path] )) || { print -u2 "ii-c root-driver lineage L2 path budget drifted: $checkpoint_path"; return 1; }; (( total+=add+delete )); done <<< "$(git diff --cached --numstat "$baseline" --)"
    (( total<=3950 )) || { print -u2 "ii-c root-driver lineage L2 aggregate budget drifted"; return 1; }
    for checkpoint_path in "${expected[@]}"; do
        mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry"|awk '{print $1,$3,$4}')" == "$mode 0 $checkpoint_path" ]] || { print -u2 "ii-c root-driver lineage L2 staged source/mode drifted: $checkpoint_path"; return 1; }
    done
    [[ -z "$(git diff --name-only --diff-filter=ACMRD -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')" && -z "$(git ls-files --others --exclude-standard -- | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')" ]] || { print -u2 "ii-c root-driver lineage L2 index/worktree drifted"; return 1; }
    for checkpoint_path in "${expected[@]}"; do
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry"|awk '{print $2}')" == "$(git hash-object -- "$checkpoint_path")" ]] || { print -u2 "ii-c root-driver lineage L2 staged/worktree blob drifted: $checkpoint_path"; return 1; }
    done
}

