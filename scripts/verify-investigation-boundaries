function verify_live_claim_server_scope() {
    python3 - <<'PY'
from pathlib import Path
import subprocess


def verify_checkpoint(
    baseline, expected, ceiling, label, paths_diagnostic, budget_diagnostic,
    expected_commit=None, expected_tree=None
):
    descendants = subprocess.check_output(
        ["git", "rev-list", "--ancestry-path", "--reverse", f"{baseline}..HEAD"],
        text=True,
    ).splitlines()
    if descendants:
        checkpoint = descendants[0]
        parent = subprocess.check_output(
            ["git", "show", "-s", "--format=%P", checkpoint], text=True
        ).strip()
        if parent != baseline:
            raise SystemExit(f"{label} checkpoint is not the direct baseline child")
        if expected_commit is not None and checkpoint != expected_commit:
            raise SystemExit(f"{label} checkpoint commit drifted: {checkpoint}")
        if expected_tree is not None:
            tree = subprocess.check_output(
                ["git", "show", "-s", "--format=%T", checkpoint],
                text=True,
            ).strip()
            if tree != expected_tree:
                raise SystemExit(f"{label} checkpoint tree drifted: {tree}")
        diff_command = ["git", "diff", "--numstat", baseline, checkpoint, "--"]
        name_command = ["git", "diff", "--name-only", baseline, checkpoint, "--"]
        untracked = set()
    else:
        diff_command = ["git", "diff", "--numstat", baseline, "--"]
        name_command = ["git", "diff", "--name-only", baseline, "--"]
        untracked = set(subprocess.check_output(
            ["git", "ls-files", "--others", "--exclude-standard"],
            text=True,
        ).splitlines())
    paths = set(subprocess.check_output(name_command, text=True).splitlines()) | untracked
    non_document = {path for path in paths if not path.startswith("docs/")}
    if non_document != expected:
        raise SystemExit(f"{paths_diagnostic}: {sorted(non_document)}")
    changed_lines = 0
    counted = set()
    for row in subprocess.check_output(diff_command, text=True).splitlines():
        added, deleted, path = row.split("\t")
        if path in expected and added != "-" and deleted != "-":
            changed_lines += int(added) + int(deleted)
            counted.add(path)
    for path in expected & untracked:
        changed_lines += len(Path(path).read_text(encoding="utf-8").splitlines())
        counted.add(path)
    if counted != expected:
        raise SystemExit(f"{label} checkpoint numstat drifted: {sorted(counted)}")
    if changed_lines > ceiling:
        raise SystemExit(
            f"{budget_diagnostic}: {changed_lines} > {ceiling}"
        )


iii_b_i_expected = {
    "Stornaut.xcodeproj/project.pbxproj",
    "StornautLifecycleHelper/main.swift",
    "Sources/StornautLifecycle/LifecycleMachineRetirementEscrow.swift",
    "Sources/StornautInvestigationMachineClaimServer/InvestigationMachineClaimServerAdapter.swift",
    "Sources/StornautInvestigationMachineClaimServer/InvestigationMachineClaimServerEffects.swift",
    "Tests/StornautLifecycleTests/LifecycleMachineRetirementEscrowTests.swift",
    "Tests/StornautLifecycleTests/LifecycleMachineClaimXPCContractTests.swift",
    "Tests/StornautLifecycleTests/LifecycleInteractiveSessionContractTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineClaimServerAdapterTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift",
    "scripts/verify-app-release-boundaries",
    "scripts/verify-investigation-boundaries",
    "scripts/verify-contract",
}
verify_checkpoint(
    "17d9f1fecd670eb4ca7b7ddd92a27303c0c4bdb0",
    iii_b_i_expected,
    3_700,
    "iii-b-i",
    "iii-b-i checkpoint paths drifted",
    "iii-b-i checkpoint budget drifted",
    expected_commit="9d80821a591f4d331e66575d310cd63a3c0340e8",
    expected_tree="c0bbf8cd95b5c8e00f63deae0ca6fa22af84d853",
)

iii_b_ii_expected = {
    "Sources/StornautInvestigationMachineClaimServer/InvestigationMachineClaimServerAdapter.swift",
    "Sources/StornautInvestigationMachineClaimServer/InvestigationMachineClaimServerEffects.swift",
    "StornautLifecycleHelper/main.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineClaimServerAdapterTests.swift",
    "Tests/StornautLifecycleTests/LifecycleMachineClaimXPCContractTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift",
    "scripts/verify-investigation-boundaries",
    "scripts/verify-app-release-boundaries",
    "scripts/verify-contract",
}
verify_checkpoint(
    "520bd1006bc2d9ae4aed6da129184aa664300b82",
    iii_b_ii_expected,
    2_200,
    "iii-b-ii",
    "iii-b-ii checkpoint paths drifted",
    "iii-b-ii checkpoint budget drifted",
)
PY
}

