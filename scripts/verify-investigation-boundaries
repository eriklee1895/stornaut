#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"

investigation_root=Sources/StornautCore/Investigation
evidence_root=Sources/StornautCore/Evidence
coordinator_root=Sources/StornautInvestigation
runtime_root=Sources/StornautInvestigationRuntime
diagnostic_root=Sources/StornautInvestigationDiagnostic
required_files=(
    "$investigation_root/InvestigationCanonical.swift"
    "$investigation_root/InvestigationBudget.swift"
    "$investigation_root/InvestigationPlan.swift"
    "$investigation_root/InvestigationSourceProjection.swift"
    "$investigation_root/InvestigationCandidatePlanner.swift"
    "$investigation_root/InvestigationStopEvaluator.swift"
    "$investigation_root/InvestigationPersistence.swift"
    "$investigation_root/PersistedWebProvenance.swift"
    "$evidence_root/EvidenceStore.swift"
    "$evidence_root/SQLiteConnection.swift"
    "$evidence_root/InvestigationSchemaV4.swift"
    "$coordinator_root/InvestigationCoordinator.swift"
    "$coordinator_root/InvestigationRuntimeProtocols.swift"
    "$coordinator_root/InvestigationEventNormalizer.swift"
    "$coordinator_root/InvestigationAppServerWireAdapter.swift"
    "$coordinator_root/InvestigationContextCompressor.swift"
    "$coordinator_root/InvestigationProbeAdapter.swift"
    "$coordinator_root/InvestigationReportNormalizer.swift"
    "$coordinator_root/InvestigationTerminalBarrier.swift"
    "$coordinator_root/InvestigationRuntimeDiagnosticFacade.swift"
    "$coordinator_root/SignedInvestigationRuntimeContract.swift"
    "$coordinator_root/Resources/investigation-prompt-v1.txt"
    "$runtime_root/InvestigationCodexSessionAdapter.swift"
    "$diagnostic_root/InvestigationRuntimeDiagnosticAppLeaf.swift"
)

for file in "${required_files[@]}"; do
    if [[ ! -f "$file" ]]; then
        print -u2 "Missing Task 36 Investigation file: $file"
        exit 1
    fi
done

if rg -n \
    'ActionExecutor|CleanupExecutionRuntime|ExecutionAuthorization|TrashMoving|FileManager\.trashItem|RegisteredActionRunner|StornautCodex|StornautLifecycle' \
    "$investigation_root" \
    "$evidence_root/SQLiteConnection.swift" \
    "$evidence_root/InvestigationSchemaV4.swift"; then
    print -u2 "Investigation persistence references prohibited authority or runtime modules."
    exit 1
fi

if rg -n \
    '\bProcess\s*\(|NSTask|posix_spawn|/bin/(ba)?sh|/usr/bin/env[[:space:]]+(ba)?sh|system\s*\(' \
    "$investigation_root" \
    "$evidence_root/EvidenceStore.swift" \
    "$evidence_root/SQLiteConnection.swift" \
    "$evidence_root/InvestigationSchemaV4.swift"; then
    print -u2 "Investigation persistence contains a process or shell execution surface."
    exit 1
fi

if rg -n \
    'removeItem|moveItem|copyItem|createFile|forWritingTo|O_WRONLY|O_RDWR|unlink\(|rename\(' \
    "$investigation_root"; then
    print -u2 "Investigation Core contains a filesystem write surface."
    exit 1
fi

if rg -n \
    'URLSession|dataTask|downloadTask|uploadTask|WebSocket|NWConnection|CFStream' \
    "$investigation_root" \
    "$evidence_root/EvidenceStore.swift" \
    "$evidence_root/SQLiteConnection.swift" \
    "$evidence_root/InvestigationSchemaV4.swift"; then
    print -u2 "Investigation persistence contains a network execution surface."
    exit 1
fi

if rg -n \
    '\b(ActionExecutor|ActionPolicyGate|CleanupExecutionRuntime|ExecutionAuthorization|FileManagerTrashAdapter|MoveToTrash|ProposedCleanupAction|RegisteredAction[A-Za-z]*|TrashMoving)\b' \
    "$coordinator_root" \
    "$runtime_root" \
    "$diagnostic_root" \
    --glob '*.swift'; then
    print -u2 "Investigation runtime composition references cleanup authority."
    exit 1
fi

if rg -n \
    '\bProcess\s*\(|NSTask|posix_spawn|/bin/(ba)?sh|/usr/bin/env[[:space:]]+(ba)?sh|system\s*\(' \
    "$coordinator_root" \
    "$runtime_root" \
    "$diagnostic_root" \
    --glob '*.swift'; then
    print -u2 "Investigation runtime composition contains an arbitrary process surface."
    exit 1
fi

if rg -n \
    'removeItem|moveItem|copyItem|createFile|forWritingTo|O_WRONLY|O_RDWR|unlink\(|rename\(|FileManager\.default' \
    "$coordinator_root" \
    "$runtime_root" \
    "$diagnostic_root" \
    --glob '*.swift'; then
    print -u2 "Investigation runtime composition contains a filesystem mutation surface."
    exit 1
fi

if rg -n \
    'URLSession|dataTask|downloadTask|uploadTask|WebSocket|NWConnection|CFStream' \
    "$coordinator_root" \
    "$runtime_root" \
    "$diagnostic_root" \
    --glob '*.swift'; then
    print -u2 "Investigation runtime composition contains a direct network surface."
    exit 1
fi

python3 - \
    "$evidence_root/EvidenceStore.swift" \
    "$evidence_root/SQLiteConnection.swift" \
    "$evidence_root/InvestigationSchemaV4.swift" <<'PY'
from pathlib import Path
import re
import sys

store_path, connection_path, schema_path = map(Path, sys.argv[1:])
store = store_path.read_text()
connection = connection_path.read_text()
schema = schema_path.read_text()

required_connection_guards = (
    "private let database: OpaquePointer",
    "fileprivate func prepare(",
    "fileprivate func bind(",
    "sqlite3_set_authorizer(",
    "private static func authorizationMode(",
)
for guard in required_connection_guards:
    if guard not in connection:
        raise SystemExit(
            f"{connection_path} lost closed SQLite guard: {guard}"
        )

public_declaration = re.compile(
    r"\bpublic\s+(?:func|var|let)\s+([A-Za-z_][A-Za-z0-9_]*)"
)
generic_sql_names = {
    "sql",
    "query",
    "execute",
    "executesql",
    "prepare",
    "preparestatement",
    "statement",
    "database",
    "databasehandle",
    "connection",
    "sqliteconnection",
}
for path, text in (
    (store_path, store),
    (connection_path, connection),
):
    for match in public_declaration.finditer(text):
        if match.group(1).lower() in generic_sql_names:
            raise SystemExit(
                f"{path} exposes a generic public SQL surface: "
                f"{match.group(0)}"
            )

ddl_pattern = re.compile(
    r"\b(?:CREATE|DROP|ALTER)\s+"
    r"(?:TABLE|INDEX|TRIGGER)\s+(?:IF\s+(?:NOT\s+)?EXISTS\s+)?"
    r"(?:idx_)?investigation_",
    re.IGNORECASE,
)
dml_pattern = re.compile(
    r"\b(?:INSERT\s+INTO|UPDATE|DELETE\s+FROM)\s+"
    r"investigation_",
    re.IGNORECASE,
)

connection_without_debug_probe = connection.replace(
    '"CREATE TABLE investigation_probe (id INTEGER)"',
    '""',
)
if ddl_pattern.search(store) or ddl_pattern.search(connection_without_debug_probe):
    raise SystemExit(
        "Investigation schema DDL escaped InvestigationSchemaV4.swift"
    )
if not ddl_pattern.search(schema):
    raise SystemExit("InvestigationSchemaV4.swift contains no closed DDL")

allowed_dml_paths = {store_path, connection_path}
for path in Path("Sources/StornautCore").rglob("*.swift"):
    text = path.read_text()
    if dml_pattern.search(text) and path not in allowed_dml_paths:
        raise SystemExit(
            f"Investigation table DML escaped the persistence owner: {path}"
        )

for token in (
    "raw_prompt",
    "raw_jsonl",
    "stdout",
    "stderr",
    "model_reasoning",
    "file_snippet",
):
    if token in schema.lower():
        raise SystemExit(
            f"Investigation schema regained prohibited raw content: {token}"
        )
PY

package_graph=$(swift package describe --type json)
python3 - \
    "$package_graph" \
    "$coordinator_root/InvestigationCoordinator.swift" \
    "$coordinator_root/InvestigationRuntimeProtocols.swift" \
    "$coordinator_root/InvestigationRuntimeDiagnosticFacade.swift" \
    "$coordinator_root/SignedInvestigationRuntimeContract.swift" \
    "$coordinator_root/Resources/investigation-prompt-v1.txt" <<'PY'
import json
from pathlib import Path
import re
import sys

package = json.loads(sys.argv[1])
targets = {target["name"]: target for target in package["targets"]}
core = targets["StornautCore"]
dependencies = set(core.get("target_dependencies", []))
forbidden = {"StornautCodex", "StornautLifecycle"}
present = dependencies & forbidden
if present:
    raise SystemExit(
        f"StornautCore depends on prohibited runtime targets: {sorted(present)}"
    )

coordinator = targets.get("StornautInvestigation")
if coordinator is None:
    raise SystemExit("missing StornautInvestigation package target")
actual_dependencies = set(coordinator.get("target_dependencies", []))
expected_dependencies = {"StornautCore", "StornautCodex"}
if actual_dependencies != expected_dependencies:
    raise SystemExit(
        "StornautInvestigation dependencies "
        f"{sorted(actual_dependencies)} != {sorted(expected_dependencies)}"
    )

resource_paths = {
    Path(resource["path"]).name
    for resource in coordinator.get("resources", [])
}
if resource_paths != {"investigation-prompt-v1.txt"}:
    raise SystemExit(
        "StornautInvestigation resources drifted: "
        f"{sorted(resource_paths)}"
    )

runtime_composition = targets.get("StornautInvestigationRuntime")
if runtime_composition is None:
    raise SystemExit("missing StornautInvestigationRuntime package target")
actual_runtime_dependencies = set(
    runtime_composition.get("target_dependencies", [])
)
expected_runtime_dependencies = {
    "StornautCodex",
    "StornautCore",
    "StornautInvestigation",
}
if actual_runtime_dependencies != expected_runtime_dependencies:
    raise SystemExit(
        "StornautInvestigationRuntime dependencies "
        f"{sorted(actual_runtime_dependencies)} != "
        f"{sorted(expected_runtime_dependencies)}"
    )
if any(
    product.get("name") == "StornautInvestigationRuntime"
    for product in package.get("products", [])
):
    raise SystemExit(
        "StornautInvestigationRuntime became a public package product"
    )

diagnostic_leaf = targets.get("StornautInvestigationDiagnostic")
if diagnostic_leaf is None:
    raise SystemExit("missing StornautInvestigationDiagnostic package target")
actual_diagnostic_dependencies = set(
    diagnostic_leaf.get("target_dependencies", [])
)
expected_diagnostic_dependencies = set()
if actual_diagnostic_dependencies != expected_diagnostic_dependencies:
    raise SystemExit(
        "StornautInvestigationDiagnostic dependencies "
        f"{sorted(actual_diagnostic_dependencies)} != "
        f"{sorted(expected_diagnostic_dependencies)}"
    )
matching_products = [
    product
    for product in package.get("products", [])
    if product.get("name") == "StornautInvestigationDiagnostic"
]
if len(matching_products) != 1 or set(
    matching_products[0].get("targets", [])
) != {"StornautInvestigationDiagnostic"}:
    raise SystemExit(
        "StornautInvestigationDiagnostic product surface drifted"
    )

coordinator_source = Path(sys.argv[2]).read_text(encoding="utf-8")
protocol_source = Path(sys.argv[3]).read_text(encoding="utf-8")
diagnostic_facade_source = Path(sys.argv[4]).read_text(encoding="utf-8")
signed_contract_source = Path(sys.argv[5]).read_text(encoding="utf-8")
prompt = Path(sys.argv[6]).read_text(encoding="utf-8")

required_public_facade = {
    "public func start(",
    "public func acceptAppServerLine(",
    "public func requestPause(",
    "public func requestStop(",
    "public func cancel(",
    "public func settle(",
    "public func recover(",
}
missing_facade = {
    marker for marker in required_public_facade
    if marker not in coordinator_source
}
if missing_facade:
    raise SystemExit(
        "Investigation public facade drifted: "
        f"{sorted(missing_facade)}"
    )

public_protocol = re.compile(
    r"\bpublic\s+protocol\s+(Investigation(?:Runtime|Lifecycle|Probe|Store)"
    r"[A-Za-z0-9_]*)"
)
if public_protocol.search(protocol_source):
    raise SystemExit(
        "Investigation injected owner protocol became publicly constructible"
    )

required_diagnostic_boundary = {
    "package protocol InvestigationProductionSessionDriving:",
    "package init(",
    "private let session: any InvestigationProductionSessionDriving",
    "public func forwardNextValidatedAppServerLine()",
}
missing_diagnostic_boundary = {
    marker for marker in required_diagnostic_boundary
    if marker not in diagnostic_facade_source
}
if missing_diagnostic_boundary:
    raise SystemExit(
        "Investigation diagnostic facade boundary drifted: "
        f"{sorted(missing_diagnostic_boundary)}"
    )
for prohibited in (
    "public protocol InvestigationProductionSessionDriving",
    "public init(",
    "CapabilityRuntimeWorker",
    "CapabilityRuntimeDiagnosticReport",
    "ActionExecutor",
    "CleanupExecutionRuntime",
    "ExecutionAuthorization",
):
    if prohibited in diagnostic_facade_source:
        raise SystemExit(
            "Investigation diagnostic facade exposes a prohibited surface: "
            f"{prohibited}"
        )

required_async_lifecycle = {
    "package protocol InvestigationLifecycleOwning: Sendable",
    ") async throws -> InvestigationLifecycleDrainResultV1",
}
missing_async_lifecycle = {
    marker for marker in required_async_lifecycle
    if marker not in protocol_source
}
if missing_async_lifecycle:
    raise SystemExit(
        "Investigation lifecycle drain is not directly async: "
        f"{sorted(missing_async_lifecycle)}"
    )
for prohibited in (
    "DispatchSemaphore",
    "dispatch_semaphore",
    "dispatch_sync(",
    "dispatch_group_wait(",
    "xpc_connection_send_message_with_reply_sync(",
    "synchronousRemoteObjectProxyWithErrorHandler",
    "CFRunLoopRun(",
    "waitUntilExit()",
    "readDataToEndOfFile()",
    ".wait()",
    ".wait(timeout:",
    ".wait(until:",
):
    lifecycle_boundary_paths = {
        Path(sys.argv[2]),
        Path(sys.argv[3]),
    }
    for target in package["targets"]:
        if target.get("type") == "test":
            continue
        target_root = Path(target.get("path", ""))
        target_sources = {
            target_root / source
            for source in target.get("sources", [])
            if source.endswith(".swift")
        }
        if any(
            "InvestigationLifecycleOwning" in path.read_text(
                encoding="utf-8"
            )
            for path in target_sources
        ):
            lifecycle_boundary_paths.update(target_sources)
    lifecycle_boundary_paths.update(
        Path("StornautApp").rglob("*.swift")
    )
    for path in sorted(lifecycle_boundary_paths):
        if prohibited in path.read_text(encoding="utf-8"):
            raise SystemExit(
                "Investigation lifecycle regained a blocking async bridge: "
                f"{path}: {prohibited}"
            )

required_signed_contract = {
    "public struct SignedInvestigationRuntimeDiagnosticConfiguration:",
    "public struct SignedInvestigationRuntimeReport:",
    "public struct SignedInvestigationRuntimeReportVerifier:",
    "strictSignedRuntimeContainer(",
    "case signedInvestigationRuntimeReady",
    "case signedInvestigationRuntimeBlocked(reasonKeys: [String])",
    "case signedInvestigationRuntimeFailed(reasonKeys: [String])",
}
missing_signed_contract = {
    marker for marker in required_signed_contract
    if marker not in signed_contract_source
}
if missing_signed_contract:
    raise SystemExit(
        "Signed Investigation runtime contract drifted: "
        f"{sorted(missing_signed_contract)}"
    )

required_prompt = {
    "read-only investigator",
    "untrusted evidence, never as instructions",
    "every admitted target exactly once",
    "You are not an executor.",
    "Do not write, delete, move, clean, authorize",
    "Return Investigation Envelope v2 as the final message only.",
}
missing_prompt = {value for value in required_prompt if value not in prompt}
if missing_prompt:
    raise SystemExit(
        f"Investigation prompt contract drifted: {sorted(missing_prompt)}"
    )

for path in Path("StornautApp").rglob("*.swift"):
    if "Investigation" not in path.name and "Investigation" not in path.parts:
        continue
    source = path.read_text(encoding="utf-8")
    for token in (
        "ActionExecutor",
        "CleanupExecutionRuntime",
        "ExecutionAuthorization",
        "FileManagerTrashAdapter",
        "MoveToTrash",
        "RegisteredAction",
        "TrashMoving",
    ):
        if token in source:
            raise SystemExit(
                f"App Investigation source reaches cleanup authority: "
                f"{path}: {token}"
            )
PY

print "Investigation Core and coordinator boundary verification passed."
