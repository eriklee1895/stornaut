function verify_iib5biib_index_semantics() {
    local staged_root
    staged_root=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iib5biib-index.XXXXXX")
    local staged_status=0
    local completed_commit=c6905e2173b858550078ccc07ac915b67912c3d6
    git checkout-index --all --prefix="$staged_root/" || staged_status=$?
    local semantic_path
    for semantic_path in \
        Package.swift \
        Sources/CInvestigationIdentitySupport/CInvestigationIdentitySupport.c \
        Sources/CInvestigationIdentitySupport/include/CInvestigationIdentitySupport.h \
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinAppIdentityObservation.swift \
        Tests/StornautInvestigationTests/InvestigationMachineDarwinAppIdentityObservationTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift \
        scripts/verify-app-release-boundaries \
        scripts/verify-contract \
        scripts/verify-investigation-boundaries
    do
        if (( staged_status == 0 )) \
            && ! git show "$completed_commit:$semantic_path" \
                | cmp -s - "$staged_root/$semantic_path"
        then
            print -u2 "ii-b5b-ii-b staged content drifted: $semantic_path"
            staged_status=1
        fi
    done
    if (( staged_status == 0 )); then
        (
            cd "$staged_root"
            scripts/verify-investigation-boundaries \
                --iib5biib-app-identity-contract-only \
                Package.swift \
                Sources/CInvestigationIdentitySupport/CInvestigationIdentitySupport.c \
                Sources/CInvestigationIdentitySupport/include/CInvestigationIdentitySupport.h \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinAppIdentityObservation.swift \
                Tests/StornautInvestigationTests/InvestigationMachineDarwinAppIdentityObservationTests.swift
        ) || staged_status=$?
    fi
    if (( staged_status == 0 )); then
        python3 - \
            "$staged_root/scripts/verify-contract" \
            "$staged_root/scripts/verify-investigation-boundaries" \
            "$staged_root/scripts/verify-app-release-boundaries" <<'PY' \
            || staged_status=$?
from pathlib import Path
import hashlib, re, sys
contract_path, boundary_path, release_path = map(Path, sys.argv[1:])
contract = contract_path.read_text(encoding="utf-8")
self_match = re.findall(r"(?m)^ib2_self_sha=([0-9a-f]{64})$", contract)
if len(self_match) != 1:
    raise SystemExit("ii-b5b-ii-b staged verifier self-seal drifted")
normalized = re.sub(
    r"(?m)^ib2_self_sha=.*$", "ib2_self_sha=SELF", contract
).encode("utf-8")
if hashlib.sha256(normalized).hexdigest() != self_match[0]:
    raise SystemExit("ii-b5b-ii-b staged verifier self-seal drifted")
for path, label in (
    (boundary_path, "boundary"),
    (release_path, "App release boundary"),
):
    matches = re.findall(
        rf'Path\("{re.escape(str(path.relative_to(path.parents[1])))}"\):\s*'
        r'"([0-9a-f]{64})"',
        contract,
    )
    if (
        len(matches) != 1
        or hashlib.sha256(path.read_bytes()).hexdigest() != matches[0]
    ):
        raise SystemExit(f"ii-b5b-ii-b staged {label} seal drifted")
for marker in (
    "iib5biib_staged_scope_baseline=b7ade4476fc18c3f38683168f8a1488eabd9824d",
    "--iib5biib-app-identity-contract-only",
    "--iib5biib-staged-scope-contract-only",
    "ii-b5b-ii-b mutation accepted: $name",
    "ii-b5b-ii-b scope mutation accepted: $fixture",
    "over-budget",
    "iib5biia_historical_root",
):
    if marker not in contract + boundary_path.read_text(encoding="utf-8"):
        raise SystemExit(f"ii-b5b-ii-b staged verifier contract drifted: {marker}")
PY
    fi
    rm -rf "$staged_root"
    return $staged_status
}

function verify_iib5biib_staged_scope() {
    local baseline=${1:-b7ade4476fc18c3f38683168f8a1488eabd9824d}
    local expected=(
        Package.swift
        Sources/CInvestigationIdentitySupport/CInvestigationIdentitySupport.c
        Sources/CInvestigationIdentitySupport/include/CInvestigationIdentitySupport.h
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinAppIdentityObservation.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinAppIdentityObservationTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 9 )) || { print -u2 "ii-b5b-ii-b checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" \
        == b7ade4476fc18c3f38683168f8a1488eabd9824d ]] || { print -u2 "ii-b5b-ii-b checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" | grep -q .; then print -u2 "ii-b5b-ii-b checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "ii-b5b-ii-b binary checkpoint path rejected"
        return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || { print -u2 "ii-b5b-ii-b checkpoint paths drifted"; return 1; }
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 2800 )) || { print -u2 "ii-b5b-ii-b checkpoint budget drifted"; return 1; }
    verify_iib5biib_index_semantics
}

function verify_iib5biic_darwin_session_contract() {
    local composer_source=$1 session_source=$2 focused_test=$3
    local composer_test=$4 boundary_test=$5
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$composer_source"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$session_source"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$focused_test"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$composer_test"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$boundary_test"
    python3 - "$composer_source" "$session_source" "$focused_test" \
        "$composer_test" "$boundary_test" <<'PY'
from pathlib import Path
import re, sys
composer_path, session_path, focused_path, composer_test_path, boundary_path = map(Path, sys.argv[1:])
composer, session, focused, composer_test, boundary = [
    path.read_text(encoding="utf-8") for path in (
        composer_path, session_path, focused_path, composer_test_path, boundary_path
    )
]

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

def declaration(source, pattern, label):
    match = re.search(pattern, source, re.MULTILINE)
    if match is None:
        raise SystemExit(f"ii-b5b-ii-c declaration missing: {label}")
    opening = source.find("{", match.end())
    if opening < 0:
        raise SystemExit(f"ii-b5b-ii-c declaration malformed: {label}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    raise SystemExit(f"ii-b5b-ii-c declaration unterminated: {label}")

if imports(composer) != {"Foundation", "StornautInvestigationHandoffContract", "StornautInvestigationInstalledL2"}:
    raise SystemExit("ii-b5b-ii-c composer import surface drifted")
if imports(session) != {"CInvestigationIdentitySupport", "Darwin", "Dispatch", "Foundation", "StornautInvestigationHandoffContract", "StornautInvestigationInstalledL2"}:
    raise SystemExit("ii-b5b-ii-c session import surface drifted")
for label, source in (("composer", composer), ("session", session)):
    if re.search(r"(?m)^\s*(?:public|open)\s+", source):
        raise SystemExit(f"ii-b5b-ii-c {label} public surface drifted")
    for marker in ("Codable", "signedInvestigationRuntimeReady", "signedRuntimeReady", "StornautCore", "StornautExecution", "StornautLifecycle", "StornautInvestigationDiagnostic"):
        if marker in source:
            raise SystemExit(f"ii-b5b-ii-c {label} authority surface drifted: {marker}")
for marker in ("posix_spawnp", "/bin/sh", "/bin/zsh", "system(", "popen(", "kill(", "killpg(", "waitpid(", "signal(", "FileHandle(forWritingTo:", "Darwin.write(", "unlink(", "rename(", "connect(", "listen("):
    if marker in session:
        raise SystemExit(f"ii-b5b-ii-c session gained prohibited authority: {marker}")
if re.search(r"\bProcess\s*\(", session):
    raise SystemExit("ii-b5b-ii-c session gained prohibited authority: Process")
if len(re.findall(r"\bsocketpair\s*\(", session)) != 1:
    raise SystemExit("ii-b5b-ii-c socketpair cardinality drifted")
if len(re.findall(r"\bposix_spawn\s*\(", session)) != 1:
    raise SystemExit("ii-b5b-ii-c posix_spawn cardinality drifted")
if session.count("posix_spawn_file_actions_adddup2(") != 1:
    raise SystemExit("ii-b5b-ii-c FD7 duplication cardinality drifted")
for marker in (
    "executablePath: InvestigationInstalledL2FixedPaths()\n                .appExecutable.path",
    "arguments: [\n                InvestigationInstalledL2FixedPaths().appExecutable.path\n            ]",
    "environment: []",
    "static let fixedDescriptor: Int32 = 7",
    "POSIX_SPAWN_SETPGROUP | POSIX_SPAWN_CLOEXEC_DEFAULT",
    "request.arguments == [request.executablePath]",
    "request.environment.isEmpty",
    "posix_spawnattr_setpgroup(&attributes, 0)",
):
    if marker not in session:
        raise SystemExit(f"ii-b5b-ii-c fixed spawn contract drifted: {marker}")
if len(re.findall(
    r"InvestigationInstalledL2FixedPaths\(\)\s*\.appExecutable\.path",
    session,
)) != 3:
    raise SystemExit("ii-b5b-ii-c fixed spawn contract drifted: executable path")
if not re.search(r"\bcase(?:[ A-Za-z,]+,)?\s*terminalUncertain\b", session) or ".retirementUncertain" not in session:
    raise SystemExit("ii-b5b-ii-c typed terminal uncertainty drifted")
if session.count("return terminal(.terminalUncertain)") != 3:
    raise SystemExit("ii-b5b-ii-c terminal outcome truth drifted")
if (
    "protocol InvestigationMachineDarwinEpochRetirementOwning" not in session
    or "retirementOwner: any InvestigationMachineDarwinEpochRetirementOwning" not in session
    or "func retireSpawnedProcess(" not in session
    or "func retireOwnedProcessGroup(" not in session
    or "processGroupID" in re.search(
        r"struct InvestigationMachineDarwinSpawnedEpoch:.*?\n}\n",
        session, re.DOTALL,
    ).group(0)
):
    raise SystemExit("ii-b5b-ii-c opaque retirement ownership drifted")
untrusted_retirement = declaration(
    session, r"^\s*private func retireUntrustedGroup\(",
    "retireUntrustedGroup",
)
if "private func retireOwnedStartup(" in session:
    started_retirement = declaration(
        session, r"^\s*private func retireOwnedStartup\(",
        "retireOwnedStartup",
    )
    started_routing_valid = (
        started_retirement.count(
            "retirementOwner.retireOwnedProcessGroup(owned)"
        ) == 1
        and "retireSpawnedProcess" not in started_retirement
        and session.count("return await retireOwnedStartup(owned)") == 2
    )
else:
    started_retirement = declaration(
        session, r"^\s*private func retireStartedEpoch\(",
        "retireStartedEpoch",
    )
    started_routing_valid = (
        started_retirement.count(
            "retirementOwner.retireOwnedProcessGroup(owned)"
        ) == 1
        and started_retirement.count(
            "retirementOwner.retireSpawnedProcess(spawned)"
        ) == 1
        and "reapSuccessfulDirectChild" not in started_retirement
        and session.count(
            "return await retireStartedEpoch(retirementAuthority)"
        ) == 2
    )
if (
    untrusted_retirement.count("retirementOwner.retireSpawnedProcess(spawned)") != 1
    or "retireOwnedProcessGroup" in untrusted_retirement
    or not started_routing_valid
    or session.count("return await retireUntrustedGroup(spawned)") not in {2, 3}
):
    raise SystemExit("ii-b5b-ii-c opaque retirement routing drifted")
if session.count("kind.admitsPayloadByteCount(payloadCount)") != 1 or session.count("InvestigationHandoffFrame.headerByteCount") < 2:
    raise SystemExit("ii-b5b-ii-c kind-specific frame bound drifted")
blocking_read = declaration(
    session, r"^\s*private static func blockingRead\(", "blockingRead"
)
blocking_write = declaration(
    session, r"^\s*private static func blockingWrite\(", "blockingWrite"
)
poll_wait = declaration(
    session, r"^\s*private static func wait\(", "wait"
)
if (
    blocking_read.count("try requireBeforeDeadline(") != 3
    or not re.search(
        r"if count == 0\s*\{\s*try requireBeforeDeadline\("
        r"deadlineNanoseconds, clock: clock\)\s*return Data\(\)",
        blocking_read, re.DOTALL,
    )
    or not re.search(
        r"if allowsEOF && offset == 0\s*\{\s*"
        r"try requireBeforeDeadline\(\s*deadlineNanoseconds, clock: clock"
        r"\s*\)\s*return Data\(\)",
        blocking_read, re.DOTALL,
    )
    or not re.search(
        r"try requireBeforeDeadline\(deadlineNanoseconds, clock: clock\)"
        r"\s*return data\s*}\s*$",
        blocking_read, re.DOTALL,
    )
    or blocking_write.count("try requireBeforeDeadline(") != 1
    or not re.search(
        r"try requireBeforeDeadline\(deadlineNanoseconds, clock: clock\)"
        r"\s*}\s*$",
        blocking_write, re.DOTALL,
    )
    or poll_wait.count("try requireBeforeDeadline(") != 1
    or not re.search(
        r"try requireBeforeDeadline\(deadlineNanoseconds, clock: clock\)"
        r"\s*return\s*}\s*}\s*$",
        poll_wait, re.DOTALL,
    )
):
    raise SystemExit("ii-b5b-ii-c final deadline verification drifted")
for marker in (
    "case .stable(.firstIdentity):", "return firstIdentity",
    "case .stable(.repeatedIdentity):",
    "actor InvestigationMachineDarwinEpochSession",
    "case operation(UUID, poisoned: Bool)",
    "phase = .operation(ticket, poisoned: false)",
    "phase = .operation(ticket, poisoned: true)",
    "let ticket = try begin(expected)", "try finish(ticket, next: next)",
    "case .terminal, .retiring, .operation:", "phase = .retiring", "phase = .terminal",
):
    if marker not in session:
        raise SystemExit(f"ii-b5b-ii-c actor/session contract drifted: {marker}")
fresh_block = re.search(
    r"case \.stable\(\.repeatedIdentity\):(?P<body>.*?)\n\s*default:",
    session, re.DOTALL,
)
if (
    fresh_block is None
    or fresh_block.group("body").count("preparedIdentity.observe(") != 1
    or "firstIdentity!" in fresh_block.group("body")
):
    raise SystemExit("ii-b5b-ii-c repeated identity freshness drifted")
focused_markers = (
    "fixedFDAndSpawnContractAreExact", "kindSpecificPayloadBoundRejectsBeforePayloadRead",
    "wrongPhaseKindRejectsBeforeItsLargePayloadRead",
    "physicalIORechecksDeadlineAfterCompletion",
    "productionSpawnPrimitiveMapsOnlyFDSeven",
    "concurrentReceivePermanentlyConsumesTheSession",
    "concurrentInvalidCallCannotRetireBeforeInFlightIOCompletes",
    "retirementIsExactlyOnceAndSecondCallIsRejected",
    "canonicalSessionUsesCachedThenFreshIdentityAndRetires",
)
if any(marker not in focused for marker in focused_markers):
    raise SystemExit("ii-b5b-ii-c focused session coverage drifted")
physical_spawn_test = declaration(
    focused, r"^\s*(?:@Test\s+)?func productionSpawnPrimitiveMapsOnlyFDSeven\(",
    "productionSpawnPrimitiveMapsOnlyFDSeven",
)
physical_fixture = declaration(
    focused, r"^\s*private func compilePhysicalChildFixture\(",
    "compilePhysicalChildFixture",
)
compact_physical = re.sub(r"\s+", "", physical_spawn_test)
compact_fixture = re.sub(r"\s+", "", physical_fixture)
for marker in (
    "InvestigationMachineDarwinEpochSpawnPrimitive.spawn(",
    "arguments:[fixtureURL.path],environment:[]",
    "childTargetDescriptor:7",
    "POSIX_SPAWN_SETPGROUP|POSIX_SPAWN_CLOEXEC_DEFAULT",
    "#expect(getpgid(processID)==processID)",
    "#expect(processID!=getpgrp())",
    ".readUpToOne(parent,deadline).isEmpty",
    ".writeExactly(parent,Data([0x7e]),deadline)",
    "whilewaitpid(processID,&status,0)<0",
    "#expect(status==0)",
):
    if marker not in compact_physical:
        raise SystemExit(
            f"ii-b5b-ii-c physical spawn coverage drifted: {marker}"
        )
for marker in (
    "argc!=1", "envp[0]!=NULL", "getsockopt(7,SOL_SOCKET,SO_TYPE",
    "if(fd==7)continue", "shutdown(7,SHUT_WR)",
    "read(7,&exit_byte,1)",
):
    if marker not in compact_fixture:
        raise SystemExit(
            f"ii-b5b-ii-c physical spawn fixture drifted: {marker}"
        )
for label, test in (("focused", focused), ("composer", composer_test)):
    if test.count("@Test") == 0 or "#expect" not in test:
        raise SystemExit(f"ii-b5b-ii-c {label} test became vacuous")
for marker in (
    "InvestigationMachineDarwinEpochSession.swift",
    "InvestigationMachineDarwinOuterInnerProtocol.swift",
    "POSIX_SPAWN_SETPGROUP | POSIX_SPAWN_CLOEXEC_DEFAULT",
    "InvestigationMachineDarwinEpochRetirementOwning",
):
    if marker not in boundary:
        raise SystemExit(f"ii-b5b-ii-c boundary test drifted: {marker}")
PY
}

function verify_iib5biic_index_semantics() {
    local staged_root
    staged_root=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iib5biic-index.XXXXXX")
    local staged_status=0
    local completed_commit=d93542283fe5f3c4591b162abbcc69fbd361aa03
    git checkout-index --all --prefix="$staged_root/" || staged_status=$?
    local semantic_path
    for semantic_path in \
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpoch.swift \
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift \
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineSingleEpochTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift \
        scripts/verify-investigation-boundaries \
        scripts/verify-app-release-boundaries \
        scripts/verify-contract
    do
        if (( staged_status == 0 )) \
            && ! git show "$completed_commit:$semantic_path" \
                | cmp -s - "$staged_root/$semantic_path"
        then
            print -u2 \
                "ii-b5b-ii-c staged content drifted: $semantic_path"
            staged_status=1
        fi
    done
    if (( staged_status == 0 )); then
        (
            cd "$staged_root"
            scripts/verify-investigation-boundaries \
                --iib5biic-darwin-session-contract-only \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpoch.swift \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift \
                Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineSingleEpochTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        ) || staged_status=$?
    fi
    rm -rf "$staged_root"
    return $staged_status
}

function verify_iib5biic_staged_scope() {
    local baseline=${1:-30dc76c450517a3b7a887a7802132087beda147f}
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpoch.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineSingleEpochTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 8 )) || { print -u2 "ii-b5b-ii-c checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == 30dc76c450517a3b7a887a7802132087beda147f ]] || { print -u2 "ii-b5b-ii-c checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" | grep -q .; then print -u2 "ii-b5b-ii-c checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {f=1} END {exit !f}'; then print -u2 "ii-b5b-ii-c binary checkpoint path rejected"; return 1; fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || { print -u2 "ii-b5b-ii-c checkpoint paths drifted"; return 1; }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644
        [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $expected_path" ]] || {
            print -u2 "ii-b5b-ii-c checkpoint mode drifted: $expected_path"
            return 1
        }
    done
    local changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 3600 )) || { print -u2 "ii-b5b-ii-c checkpoint budget drifted"; return 1; }
    verify_iib5biic_index_semantics
}

function verify_iib5biid_darwin_retirement_contract() {
    local session_source=$1 retirement_source=$2 session_test=$3
    local retirement_test=$4 boundary_test=$5
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$session_source"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$retirement_source"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$session_test"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$retirement_test"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$boundary_test"
    python3 - "$session_source" "$retirement_source" "$session_test" \
        "$retirement_test" "$boundary_test" <<'PY'
from pathlib import Path
import re, sys
session_path, retirement_path, session_test_path, retirement_test_path, boundary_path = map(Path, sys.argv[1:])
session, retirement, session_test, retirement_test, boundary = [
    path.read_text(encoding="utf-8") for path in (
        session_path, retirement_path, session_test_path, retirement_test_path, boundary_path
    )
]

def declaration(source, pattern, label):
    match = re.search(pattern, source, re.MULTILINE)
    if match is None:
        raise SystemExit(f"ii-b5b-ii-d declaration missing: {label}")
    opening = source.find("{", match.end())
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{": depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0: return source[match.start():index + 1]
    raise SystemExit(f"ii-b5b-ii-d declaration malformed: {label}")

if set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", retirement)) != {"Darwin", "Dispatch", "Foundation"}:
    raise SystemExit("ii-b5b-ii-d retirement import surface drifted")
for source in (session, retirement):
    if re.search(r"(?m)^\s*(?:public|open)\s+", source):
        raise SystemExit("ii-b5b-ii-d public surface drifted")
    for marker in ("StornautCore", "StornautExecution", "StornautLifecycle", "StornautInvestigationDiagnostic", "Codable", "signedInvestigationRuntimeReady", "signedRuntimeReady"):
        if marker in source: raise SystemExit(f"ii-b5b-ii-d authority or admission drifted: {marker}")
protocol = declaration(session, r"^protocol InvestigationMachineDarwinEpochRetirementOwning", "retirement protocol")
spawned_match = re.search(r"func retireSpawnedProcess\(.*?\)\s*async throws(?P<tail>.*?)func retireOwnedProcessGroup", protocol, re.DOTALL)
if spawned_match is None:
    raise SystemExit("ii-b5b-ii-d spawned protocol method drifted")
if "InvestigationMachineSingleEpochRetirementProof" in spawned_match.group("tail"):
    raise SystemExit("ii-b5b-ii-d spawned-only proof drifted")
if protocol.count("InvestigationMachineSingleEpochRetirementProof") != 2:
    raise SystemExit("ii-b5b-ii-d owned proof cardinality drifted")
untrusted = declaration(session, r"^    private func retireUntrustedGroup\(", "untrusted retirement")
if untrusted.count("retirementOwner.retireSpawnedProcess(spawned)") != 1 or "retireOwnedProcessGroup" in untrusted or "terminal(.terminal(.init()))" in untrusted or untrusted.count("terminal(.terminalUncertain)") != 1:
    raise SystemExit("ii-b5b-ii-d spawned-only uncertainty drifted")
for forbidden in ("proc_listpids(", "waitid(", "waitpid(", "kill(", "killpg("):
    if forbidden in session: raise SystemExit(f"ii-b5b-ii-d syscall source path drifted: {forbidden}")
owned = declaration(
    retirement,
    r"^    private func retireOwnedProcessGroupSynchronously\(",
    "owned process-group retirement",
)
spawned = declaration(
    retirement,
    r"^    private func retireSpawnedProcessSynchronously\(",
    "spawned process retirement",
)
successful = declaration(
    retirement,
    r"^    private func reapSuccessfulDirectChildSynchronously\(",
    "successful direct-child retirement",
)
inventory = declaration(
    retirement, r"^    private func inventory\(", "inventory"
)
waitable = declaration(
    retirement, r"^    private func waitableLeader\(", "waitable leader"
)
reap = declaration(
    retirement, r"^    private func reapLeader\(", "leader reap"
)

required = (
    "static let maximumInventoryEntries = 4_096",
    "static let totalWindowNanoseconds: UInt64 = 5_000_000_000",
    "static let termWindowNanoseconds: UInt64 = 1_000_000_000",
    "private static let pollNanoseconds: UInt64 = 10_000_000",
    "epoch.processID > 1", "epoch.processGroupID > 1",
    "epoch.processGroupID == epoch.processID",
    "epoch.processGroupID != system.currentProcessGroup()",
    "UInt32(PROC_PGRP_ONLY)", "data.count.isMultiple(of: width)",
    "data.count < Self.maximumInventoryEntries * width",
    "values.allSatisfy({ $0 > 1 })", "Set(values).count == values.count",
    "Int32(WEXITED | WNOHANG | WNOWAIT)",
    "try signal(-epoch.processGroupID, SIGTERM)",
    "try signal(-epoch.processGroupID, SIGKILL)",
    "try signal(epoch.processID, SIGKILL)",
    "system.waitPID(processID, Int32(WNOHANG))",
    "let postReapMembers = try inventory(epoch.processGroupID)",
    "guard postReapMembers.isEmpty else",
    "let descriptorFailure = closeExactlyOnce(epoch.descriptors)",
    "return try await withTaskCancellationHandler",
    "Self.queue.async", "cancellationRequested",
    "proc_listpids(", "waitid(", "waitpid(", "Darwin.kill(",
    "Darwin.close(", "nanosleep(",
)
for marker in required:
    if marker not in retirement:
        raise SystemExit(f"ii-b5b-ii-d retirement contract drifted: {marker}")
for marker in (
    "epoch.processID > 1", "epoch.processGroupID > 1",
    "epoch.processGroupID == epoch.processID",
    "epoch.processGroupID != system.currentProcessGroup()",
    "try signal(-epoch.processGroupID, SIGTERM)",
    "try signal(-epoch.processGroupID, SIGKILL)",
    "let postReapMembers = try inventory(epoch.processGroupID)",
    "guard postReapMembers.isEmpty else",
    "guard !descriptorFailure else",
    "retirementProof: .init()",
    "directChildExit: try classifyDirectChildExit(",
):
    if marker not in owned:
        raise SystemExit(f"ii-b5b-ii-d owned retirement drifted: {marker}")
for marker in (
    "epoch.processID > 1", "try signal(epoch.processID, SIGKILL)",
    "guard !descriptorFailure else",
):
    if marker not in spawned:
        raise SystemExit(f"ii-b5b-ii-d spawned retirement drifted: {marker}")
for marker in (
    "epoch.processID > 1",
    "while try waitableLeader(epoch.processID, deadline: deadline) == nil",
    "let status = try reapStatus(epoch.processID, deadline: deadline)",
    "status.rawStatus & 0x7f == 0",
    "status.rawStatus >> 8 & 0xff == 0",
    "guard !descriptorFailure else", "return .init()",
):
    if marker not in successful:
        raise SystemExit(
            f"ii-b5b-ii-d successful direct-child drifted: {marker}"
        )
for forbidden in ("inventory(", "signal(", "SIGTERM", "SIGKILL"):
    if forbidden in successful:
        raise SystemExit(
            f"ii-b5b-ii-d successful direct-child authority drifted: {forbidden}"
        )
for marker in (
    "data.count.isMultiple(of: width)",
    "data.count < Self.maximumInventoryEntries * width",
    "values.allSatisfy({ $0 > 1 })",
    "Set(values).count == values.count",
):
    if marker not in inventory:
        raise SystemExit(f"ii-b5b-ii-d inventory drifted: {marker}")
if "Int32(WEXITED | WNOHANG | WNOWAIT)" not in waitable:
    raise SystemExit("ii-b5b-ii-d waitable leader drifted")
if "system.waitPID(processID, Int32(WNOHANG))" not in reap:
    raise SystemExit("ii-b5b-ii-d leader reap drifted")
if owned.count("retirementProof: .init()") != 1 \
        or successful.count("return .init()") != 1:
    raise SystemExit("ii-b5b-ii-d owned proof cardinality drifted")
for marker in ("killpg(", "SIGINT", "posix_spawn", "CommandLine.arguments", "ProcessInfo.processInfo.environment"):
    if marker in retirement: raise SystemExit(f"ii-b5b-ii-d retirement authority drifted: {marker}")
if re.search(r"(?<![A-Za-z0-9_])Process\s*\(", retirement):
    raise SystemExit("ii-b5b-ii-d retirement authority drifted: Process")
for name, count in {"proc_listpids": 1, "waitid": 1, "waitpid": 2, "kill": 1, "close": 1, "nanosleep": 1}.items():
    if len(re.findall(r"\b" + name + r"\s*\(", retirement)) != count:
        raise SystemExit(f"ii-b5b-ii-d syscall cardinality drifted: {name}")

test_markers = (
    "naturalExitUsesWaitableProofReapsLastAndMintsOneProof",
    "termDrainSignalsExactGroupAndNeverReapsBeforeDescendantsLeave",
    "termIgnoringDescendantEscalatesOnceToExactNegativeGroup",
    "retirementUsesFreshFixedWindowAtAnyMonotonicOrigin",
    "invalidOwnedAuthorityNeverInventoriesOrSignals",
    "malformedOrUnavailableInventoryNeverBecomesEmptyProof",
    "waitIDRetriesOnlyEINTRAndRequiresTheExactLeader",
    "waitPIDStatusRetriesOnlyEINTRAndRejectsNilWrongPIDAndErrors",
    "signalErrorsIncludingESRCHNeverMintProof",
    "postReapPGIDReuseWithholdsProofWithoutAnotherSignal",
    "descriptorFailureContinuesCleanupWithholdsProofAndNeverRetries",
    "cancellationWaitsForBlockingWorkerBeforeReturning",
    "duplicateAndConcurrentRetirementAreOneShot",
    "spawnedFallbackUsesPositivePIDOnlyAndCannotMintProof",
    "successfulDirectChildExitWaitsWithoutSignalAndRequiresExitZero",
    "successfulDirectChildExitRejectsNonzeroExitWithoutSignal",
    "successfulDirectChildExitTimesOutWithoutSignal",
    "physicalNaturalExitIsWaitableReapedAndLeavesNoGroup",
    "physicalTermIgnoringDescendantIsKilledReapedLastAndLeavesNoGroup",
)
if any(marker not in retirement_test for marker in test_markers) or retirement_test.count("@Test") < len(test_markers) or "#expect" not in retirement_test:
    raise SystemExit("ii-b5b-ii-d focused retirement coverage drifted")
for marker in (
    "InvestigationMachineDarwinEpochRetirement.swift", "proc_listpids",
    "waitid", "waitpid", 'for name in ["kill", "close"]',
):
    if marker not in boundary: raise SystemExit(f"ii-b5b-ii-d boundary test drifted: {marker}")
if "invalidProcessGroupRemainsUncertainAfterDirectCleanup" not in session_test:
    raise SystemExit("ii-b5b-ii-d session uncertainty coverage drifted")
if "inheritedCanonicalSessionUsesSuccessfulExitReaper" not in session_test:
    raise SystemExit("ii-b5b-ii-d successful session coverage drifted")
PY
}

function verify_iib5biid_index_semantics() {
    local staged_root
    staged_root=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iib5biid-index.XXXXXX")
    local staged_status=0
    local completed_commit=d89d201448a99281a554d9b3fca00512b4f0c0be
    git checkout-index --all --prefix="$staged_root/" || staged_status=$?
    local semantic_path
    for semantic_path in \
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift \
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochRetirement.swift \
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochRetirementTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift \
        scripts/verify-investigation-boundaries \
        scripts/verify-app-release-boundaries \
        scripts/verify-contract
    do
        if (( staged_status == 0 )) \
            && ! git show "$completed_commit:$semantic_path" \
                | cmp -s - "$staged_root/$semantic_path"
        then
            print -u2 "ii-b5b-ii-d staged content drifted: $semantic_path"
            staged_status=1
        fi
    done
    if (( staged_status == 0 )); then
        (cd "$staged_root"; scripts/verify-investigation-boundaries \
            --iib5biid-darwin-retirement-contract-only \
            Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift \
            Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochRetirement.swift \
            Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift \
            Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochRetirementTests.swift \
            Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift) || staged_status=$?
    fi
    rm -rf "$staged_root"
    return $staged_status
}

function verify_iib5biid_staged_scope() {
    local baseline=${1:-efe079f95a9f15a360d280ea656bf9548bfaa3c3}
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochRetirement.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochRetirementTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 8 )) || { print -u2 "ii-b5b-ii-d checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == efe079f95a9f15a360d280ea656bf9548bfaa3c3 ]] || { print -u2 "ii-b5b-ii-d checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" | grep -q .; then print -u2 "ii-b5b-ii-d checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {f=1} END {exit !f}'; then print -u2 "ii-b5b-ii-d binary checkpoint path rejected"; return 1; fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    local observed_sorted=("${(@on)observed}")
    local expected_sorted=("${(@on)expected}")
    [[ "${(j:\n:)observed_sorted}" == "${(j:\n:)expected_sorted}" ]] || { print -u2 "ii-b5b-ii-d checkpoint paths drifted"; return 1; }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644; [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" == "$expected_mode 0 $expected_path" ]] || { print -u2 "ii-b5b-ii-d checkpoint mode drifted: $expected_path"; return 1; }
    done
    local changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 3200 )) || { print -u2 "ii-b5b-ii-d checkpoint budget drifted"; return 1; }
    verify_iib5biid_index_semantics
}

function verify_iic0a_replay_source_contract() {
    local contract_source=$1
    zsh -n "$contract_source"
    python3 - "$contract_source" <<'PY'
from pathlib import Path
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")
start = source.find("function verify_immutable_historical_checkpoints() {")
end = source.find("\nif [[ ${1:-} == --historical-freeze-contract-only ]]", start)
if start < 0 or end < 0:
    raise SystemExit("ii-c0a historical replay source boundary drifted")
replay = source[start:end]
required = (
    'GIT_INDEX_FILE="$iib0a_index" git read-tree "$iib0a_commit^{tree}"',
    'GIT_INDEX_FILE="$iib0a_index" git checkout-index --all',
    'cd "$iib0a_root"\n                scripts/verify-investigation-boundaries',
    'GIT_INDEX_FILE="$iib5biid_index" git read-tree "$iib5biid_commit^{tree}"',
    'GIT_INDEX_FILE="$iib5biid_index" git checkout-index --all',
    'cd "$iib5biid_root"\n            scripts/verify-investigation-boundaries',
)
for marker in required:
    if replay.count(marker) != 1:
        raise SystemExit(
            f"ii-c0a historical replay execution drifted: {marker}"
        )
if replay.count("|| exit $?") != 4:
    raise SystemExit("ii-c0a historical replay failure propagation drifted")
for forbidden in (
    '$repo_root/scripts/verify-investigation-boundaries',
    '$repo_root/scripts/verify-app-release-boundaries',
):
    if forbidden in replay:
        raise SystemExit(
            f"ii-c0a historical replay substituted current verifier: {forbidden}"
        )
PY
}

function verify_iic0a_projection_capsule_contract() {
    local projection_source=$1 intake_source=$2 transport_test=$3
    local intake_test=$4 boundary_test=$5
    xcrun swiftc -frontend -parse "$projection_source"
    xcrun swiftc -frontend -parse "$intake_source"
    python3 - "$projection_source" "$intake_source" \
        "$transport_test" "$intake_test" "$boundary_test" <<'PY'
from pathlib import Path
import re
import sys

projection_path, intake_path, transport_path, intake_test_path, boundary_path = (
    map(Path, sys.argv[1:])
)
projection = projection_path.read_text(encoding="utf-8")
intake = intake_path.read_text(encoding="utf-8")
transport = transport_path.read_text(encoding="utf-8")
intake_test = intake_test_path.read_text(encoding="utf-8")
boundary = boundary_path.read_text(encoding="utf-8")
if set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", projection)) != {
    "Foundation"
}:
    raise SystemExit("ii-c0a projection dependency surface drifted")
if re.search(r"(?m)^\s*(?:public|open)\s+", projection):
    raise SystemExit("ii-c0a projection public surface drifted")
if "Codable" in projection:
    raise SystemExit("ii-c0a projection gained Codable surface")
for marker in (
    "package struct InvestigationProjectedCohortSelection",
    "package struct InvestigationProjectedCohortInput",
    '"stornaut.task39.l3c3cii.projected-cohort-input"',
    "projectionCount = InvestigationCohortCapsule.epochCount",
    "package static let maximumByteCount = 1_069_056",
    "package let capsule: InvestigationCohortCapsule",
    "package let projections: [InvestigationInstalledL2IdentityProjection]",
    "package let wholeInputSHA256: InvestigationHandoffSHA256",
    "try input.encoded() == data",
    "try capsule.encoded(),",
    "handoffData(UInt32(projectionCount))",
    "wholeInputSHA256.rawBytes",
    "fields.append(contentsOf: try projections.map { try $0.encoded() })",
    "projection.epochUUID == epoch.epochUUID",
    "projection.configurationNonce == epoch.configurationNonce",
    "projection.configurationSHA256 == epoch.configurationSHA256",
    "== epoch.signedRuntimeBindingSHA256",
):
    if projection.count(marker) != 1:
        raise SystemExit(f"ii-c0a projection contract drifted: {marker}")
for marker in (
    "wholeInputSHA256 = InvestigationHandoffSHA256.hashing(",
    "Data(repeating: 0, count: 32)",
    "try InvestigationCohortCapsule.decode(fields[0])",
    "try InvestigationInstalledL2IdentityProjection.decode($0)",
):
    if marker not in projection:
        raise SystemExit(f"ii-c0a strict decode or digest drifted: {marker}")
for label, source in (("projection", projection), ("intake", intake)):
    for forbidden in (
        r"\b(?:JSONDecoder|JSONEncoder|JSONSerialization|PropertyListDecoder|PropertyListEncoder)\b",
        r"\b(?:FileManager|FileHandle|OutputStream|FileWrapper|"
        r"NSData|NSMutableData|NSMutableString|UserDefaults|"
        r"NSFileCoordinator|NSFileVersion|NSUbiquitousKeyValueStore|"
        r"URLSession|NSURLConnection|"
        r"NWConnection|WebSocket|CFStream|CFReadStream|CFWriteStream|"
        r"DispatchIO|NSXPCConnection|Process|NSTask)\b",
        r"\b(?:posix_spawnp?|fork|vfork|execv|execve|execvp|execvP|"
        r"execl|execlp|system|popen|dlopen|dlsym)\s*\(",
        r"\bsudo\b",
        r"\b(?:Cleanup|Executor|Trash|RegisteredAction|readiness|signedRuntimeReady)\b",
        r"\.write\s*\(\s*(?:to|toFile):",
        r"\b(?:removeItem|moveItem|copyItem|trashItem|replaceItem|"
        r"createFile|createDirectory|createSymbolicLink|linkItem|"
        r"setAttributes|forWritingTo|writeabilityHandler)\b",
        r"\b(?:Darwin\.)?(?:open|openat|creat|fopen|freopen|write|"
        r"writev|pwrite|pwritev|unlink|unlinkat|rename|renameat|mkdir|"
        r"mkdirat|rmdir|chmod|fchmod|chown|fchown|symlink|link|truncate|"
        r"ftruncate|setxattr|fsetxattr|removexattr|fremovexattr|mmap|"
        r"msync|ioctl|copyfile|fcopyfile|clonefile|socket|socketpair|"
        r"connect|bind|listen|accept|accept4|send|sendto|sendmsg|recv|"
        r"recvfrom|recvmsg|getaddrinfo|kill|killpg|pthread_kill|raise)\s*\(",
        r"\b(?:O_WRONLY|O_RDWR|O_CREAT|O_TRUNC|O_APPEND)\b",
        r"\bCommandLine\.arguments\b",
        r"\bProcessInfo\.processInfo\.environment\b",
        r"\breadLine\s*\(",
        r"import\s+Stornaut(?:Core|Codex|Lifecycle|Execution|InvestigationRuntime|InvestigationDiagnostic)",
    ):
        if re.search(forbidden, source, re.IGNORECASE):
            raise SystemExit(
                f"ii-c0a {label} gained runtime authority: {forbidden}"
            )

selection_match = re.search(
    r"(?ms)^package struct InvestigationMachineFixedEpochSelection:.*?^}\n",
    intake,
)
if selection_match is None:
    raise SystemExit("ii-c0a paired selection surface drifted")
selection = selection_match.group(0)
for field in ("wholeInputSHA256", "epoch", "projection"):
    if selection.count(f"package let {field}:") != 1:
        raise SystemExit(f"ii-c0a paired selection field drifted: {field}")
for marker in (
    "private let input: InvestigationProjectedCohortInput",
    "selected = try input.selection(at: nextIndex)",
    "epoch: epoch,",
    "projection: selected.projection",
    "input: try InvestigationProjectedCohortInput.decode(encoded)",
    "<= InvestigationProjectedCohortInput.maximumByteCount",
):
    if intake.count(marker) != 1:
        raise SystemExit(f"ii-c0a paired intake drifted: {marker}")
for forbidden in ("ordinal:", "scenario:", "path:"):
    if re.search(r"package func read\s*\([^)]*" + re.escape(forbidden), intake):
        raise SystemExit("ii-c0a intake regained caller-selected input")

for marker in (
    "projectedCohortInputPreservesV1CapsuleAndPairsEveryProjection",
    "projectedCohortInputDigestUsesExactZeroBeforeHashRule",
    "projectedCohortInputRejectsEveryBindingMismatch",
    "projectedCohortInputRejectsCountOrderAndDigestDrift",
    "projectedCohortInputRejectsNestedProjectionDrift",
    "projectedCohortInputRejectsEveryOuterStructuralDrift",
    "projectedCohortInputRejectsNestedCapsuleDrift",
    "encoded.count == 1_984",
    "a5096b18fc2741906a561bedcee18b3168c6d7472bad8e3167c7abbccf634801",
    "47ce5039abd62cdd4e3c5fc011c42af84d9539cb4ccdd26b0723b0fb47df890f",
):
    if transport.count(marker) != 1:
        raise SystemExit(f"ii-c0a transport coverage drifted: {marker}")
for marker in (
    "validCapsuleReadsOnlyFDZeroAndYieldsCanonicalRows",
    "legacyCapsuleWithoutProjectionIsRejected",
    "planAliasesShareOneNonReplayableCursor",
    r"selections.map(\.projection) == projections",
    r"selections.map(\.wholeInputSHA256)",
):
    if marker not in intake_test:
        raise SystemExit(f"ii-c0a intake coverage drifted: {marker}")
for marker in (
    "iiC0AProjectionCapsuleVerifierPinsContractAndScope",
    "--iic0a-projection-capsule-contract-only",
    "--iic0a-staged-scope-contract-only",
):
    if marker not in boundary:
        raise SystemExit(f"ii-c0a boundary regression drifted: {marker}")
expected_sha256 = {
    projection_path:
        "f60d4f92da42293ff044c29756fc55692ce354035f49b9a3ec415166c89b885a",
    intake_path:
        "d4898e6f9196a169d29107a40063238adf52d9fd8842e2bacdf9b433e09c1dd6",
}
for path, expected in expected_sha256.items():
    if __import__("hashlib").sha256(path.read_bytes()).hexdigest() != expected:
        raise SystemExit(f"ii-c0a canonical source drifted: {path}")
PY
}

function verify_iic0a_index_semantics() {
    local staged_root
    staged_root=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iic0a-index.XXXXXX")
    local staged_status=0
    git checkout-index --all --prefix="$staged_root/" \
        || staged_status=$?
    if (( staged_status == 0 )); then
        (
            cd "$staged_root"
            scripts/verify-investigation-boundaries \
                --iic0a-projection-capsule-contract-only \
                Sources/StornautInvestigationHandoffContract/InvestigationProjectedCohortInput.swift \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineFixedCapsuleIntake.swift \
                Tests/StornautInvestigationTests/InvestigationHandoffTransportContractTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineFixedCapsuleIntakeTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift \
                || exit $?
            scripts/verify-app-release-boundaries \
                --iic0a-source-contract-only \
                Sources/StornautInvestigationHandoffContract/InvestigationProjectedCohortInput.swift \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineFixedCapsuleIntake.swift \
                || exit $?
            python3 - <<'PY'
from pathlib import Path
import hashlib
import re

contract = Path("scripts/verify-contract").read_text(encoding="utf-8")
self_match = re.findall(r"(?m)^ib2_self_sha=([0-9a-f]{64})$", contract)
normalized = re.sub(
    r"(?m)^ib2_self_sha=.*$", "ib2_self_sha=SELF", contract
).encode("utf-8")
if (
    len(self_match) != 1
    or hashlib.sha256(normalized).hexdigest() != self_match[0]
):
    raise SystemExit("ii-c0a staged verifier self-seal drifted")
expected = dict(re.findall(
    r'Path\("(scripts/verify-(?:investigation|app)[^"]*)"\):\s*'
    r'"([0-9a-f]{64})"',
    contract,
))
for relative in (
    "scripts/verify-investigation-boundaries",
    "scripts/verify-app-release-boundaries",
):
    if hashlib.sha256(Path(relative).read_bytes()).hexdigest() != expected.get(relative):
        raise SystemExit(f"ii-c0a staged verifier source seal drifted: {relative}")
PY
        ) || staged_status=$?
    fi
    rm -rf "$staged_root"
    return $staged_status
}

