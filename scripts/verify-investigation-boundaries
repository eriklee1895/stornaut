    (installed_join_test, "375a2265dcf42d9ea124f08945844203140542c7bf17362b964902d100524e58"),
):
    if hashlib.sha256(source.encode()).hexdigest() != expected:
        fail("iii-a focused test source seal drifted")
if "InvestigationMachineHelperEpochContinuityTests.swift" not in boundary:
    fail("iii-a boundary test omitted continuity coverage")
PY
}

