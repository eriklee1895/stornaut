    for product in manifest.get("products", [])
):
    raise SystemExit(
        "Machine driver was added to the explicit products list"
    )
matching_driver_products = [
    product
    for product in package.get("products", [])
    if product.get("name") == "StornautInvestigationMachineDriver"
]
if len(matching_driver_products) != 1 or set(
    matching_driver_products[0].get("targets", [])
) != {"StornautInvestigationMachineDriver"}:
    raise SystemExit(
        "Machine driver implicit executable product surface drifted"
    )
if set(machine.get("product_memberships", [])):
    raise SystemExit(
        "Machine target product membership drifted: "
        f"{machine.get('product_memberships', [])!r}"
    )
if set(driver_support.get("product_memberships", [])) != {
    "StornautInvestigationMachineDriverSupport",
    "StornautInvestigationMachineDriver",
}:
    raise SystemExit(
        "Machine driver support product membership drifted: "
        f"{driver_support.get('product_memberships', [])!r}"
    )
for product in package.get("products", []):
    targets_in_product = set(product.get("targets", []))
    if (
        "StornautInvestigationMachineDriver" in targets_in_product
        and product.get("name")
            != "StornautInvestigationMachineDriver"
    ):
        raise SystemExit(
            "Machine driver escaped into another package product"
        )
for target_name in (
    "StornautInvestigation",
    "StornautInvestigationRuntime",
    "StornautInvestigationDiagnostic",
):
    if "StornautInvestigationMachine" in set(
        targets[target_name].get("target_dependencies", [])
    ):
        raise SystemExit(
            f"{target_name} gained trusted machine implementation"
        )

