}

function verify_iib5biic_index_semantics() {
    local staged_root
    staged_root=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iib5biic-index.XXXXXX")
    local staged_status=0
    local completed_commit=d93542283fe5f3c4591b162abbcc69fbd361aa03
    git checkout-index --all --prefix="$staged_root/" || staged_status=$?
    local semantic_path
    for semantic_path in \
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpoch.swift \
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift \
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineSingleEpochTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift \
        scripts/verify-investigation-boundaries \
        scripts/verify-app-release-boundaries \
        scripts/verify-contract
    do
        if (( staged_status == 0 )) \
            && ! git show "$completed_commit:$semantic_path" \
                | cmp -s - "$staged_root/$semantic_path"
        then
            print -u2 \
                "ii-b5b-ii-c staged content drifted: $semantic_path"
            staged_status=1
        fi
    done
    if (( staged_status == 0 )); then
        (
            cd "$staged_root"
            scripts/verify-investigation-boundaries \
                --iib5biic-darwin-session-contract-only \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpoch.swift \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift \
                Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineSingleEpochTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        ) || staged_status=$?
    fi
    rm -rf "$staged_root"
    return $staged_status
}

function verify_iib5biic_staged_scope() {
    local baseline=${1:-30dc76c450517a3b7a887a7802132087beda147f}
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpoch.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineSingleEpochTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 8 )) || { print -u2 "ii-b5b-ii-c checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == 30dc76c450517a3b7a887a7802132087beda147f ]] || { print -u2 "ii-b5b-ii-c checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" | grep -q .; then print -u2 "ii-b5b-ii-c checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {f=1} END {exit !f}'; then print -u2 "ii-b5b-ii-c binary checkpoint path rejected"; return 1; fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || { print -u2 "ii-b5b-ii-c checkpoint paths drifted"; return 1; }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644
        [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $expected_path" ]] || {
            print -u2 "ii-b5b-ii-c checkpoint mode drifted: $expected_path"
            return 1
        }
    done
    local changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 3600 )) || { print -u2 "ii-b5b-ii-c checkpoint budget drifted"; return 1; }
    verify_iib5biic_index_semantics
}

function verify_iib5biid_darwin_retirement_contract() {
    local session_source=$1 retirement_source=$2 session_test=$3
    local retirement_test=$4 boundary_test=$5
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$session_source"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$retirement_source"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$session_test"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$retirement_test"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$boundary_test"
    python3 - "$session_source" "$retirement_source" "$session_test" \
        "$retirement_test" "$boundary_test" <<'PY'
from pathlib import Path
import re, sys
session_path, retirement_path, session_test_path, retirement_test_path, boundary_path = map(Path, sys.argv[1:])
session, retirement, session_test, retirement_test, boundary = [
    path.read_text(encoding="utf-8") for path in (
        session_path, retirement_path, session_test_path, retirement_test_path, boundary_path
    )
]

def declaration(source, pattern, label):
    match = re.search(pattern, source, re.MULTILINE)
    if match is None:
        raise SystemExit(f"ii-b5b-ii-d declaration missing: {label}")
    opening = source.find("{", match.end())
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{": depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0: return source[match.start():index + 1]
    raise SystemExit(f"ii-b5b-ii-d declaration malformed: {label}")

if set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", retirement)) != {"Darwin", "Dispatch", "Foundation"}:
    raise SystemExit("ii-b5b-ii-d retirement import surface drifted")
for source in (session, retirement):
    if re.search(r"(?m)^\s*(?:public|open)\s+", source):
        raise SystemExit("ii-b5b-ii-d public surface drifted")
    for marker in ("StornautCore", "StornautExecution", "StornautLifecycle", "StornautInvestigationDiagnostic", "Codable", "signedInvestigationRuntimeReady", "signedRuntimeReady"):
        if marker in source: raise SystemExit(f"ii-b5b-ii-d authority or admission drifted: {marker}")
protocol = declaration(session, r"^protocol InvestigationMachineDarwinEpochRetirementOwning", "retirement protocol")
spawned_match = re.search(r"func retireSpawnedProcess\(.*?\)\s*async throws(?P<tail>.*?)func retireOwnedProcessGroup", protocol, re.DOTALL)
if spawned_match is None:
    raise SystemExit("ii-b5b-ii-d spawned protocol method drifted")
if "InvestigationMachineSingleEpochRetirementProof" in spawned_match.group("tail"):
    raise SystemExit("ii-b5b-ii-d spawned-only proof drifted")
if protocol.count("InvestigationMachineSingleEpochRetirementProof") != 1:
    raise SystemExit("ii-b5b-ii-d owned proof cardinality drifted")
untrusted = declaration(session, r"^    private func retireUntrustedGroup\(", "untrusted retirement")
if untrusted.count("retirementOwner.retireSpawnedProcess(spawned)") != 1 or "retireOwnedProcessGroup" in untrusted or "terminal(.terminal(.init()))" in untrusted or untrusted.count("terminal(.terminalUncertain)") != 1:
    raise SystemExit("ii-b5b-ii-d spawned-only uncertainty drifted")
for forbidden in ("proc_listpids(", "waitid(", "waitpid(", "kill(", "killpg("):
    if forbidden in session: raise SystemExit(f"ii-b5b-ii-d syscall source path drifted: {forbidden}")
owned = declaration(
    retirement,
    r"^    private func retireOwnedProcessGroupSynchronously\(",
    "owned process-group retirement",
)
spawned = declaration(
    retirement,
    r"^    private func retireSpawnedProcessSynchronously\(",
    "spawned process retirement",
)
inventory = declaration(
    retirement, r"^    private func inventory\(", "inventory"
)
waitable = declaration(
    retirement, r"^    private func waitableLeader\(", "waitable leader"
)
reap = declaration(
    retirement, r"^    private func reapLeader\(", "leader reap"
)

required = (
    "static let maximumInventoryEntries = 4_096",
    "static let totalWindowNanoseconds: UInt64 = 5_000_000_000",
    "static let termWindowNanoseconds: UInt64 = 1_000_000_000",
    "private static let pollNanoseconds: UInt64 = 10_000_000",
    "epoch.processID > 1", "epoch.processGroupID > 1",
    "epoch.processGroupID == epoch.processID",
    "epoch.processGroupID != system.currentProcessGroup()",
    "UInt32(PROC_PGRP_ONLY)", "data.count.isMultiple(of: width)",
    "data.count < Self.maximumInventoryEntries * width",
    "values.allSatisfy({ $0 > 1 })", "Set(values).count == values.count",
    "Int32(WEXITED | WNOHANG | WNOWAIT)",
    "try signal(-epoch.processGroupID, SIGTERM)",
    "try signal(-epoch.processGroupID, SIGKILL)",
    "try signal(epoch.processID, SIGKILL)",
    "system.waitPID(processID, Int32(WNOHANG))",
    "let postReapMembers = try inventory(epoch.processGroupID)",
    "guard postReapMembers.isEmpty else",
    "let descriptorFailure = closeExactlyOnce(epoch.descriptors)",
    "return try await withTaskCancellationHandler",
    "Self.queue.async", "cancellationRequested",
    "proc_listpids(", "waitid(", "waitpid(", "Darwin.kill(",
    "Darwin.close(", "nanosleep(",
)
for marker in required:
    if marker not in retirement:
        raise SystemExit(f"ii-b5b-ii-d retirement contract drifted: {marker}")
for marker in (
    "epoch.processID > 1", "epoch.processGroupID > 1",
    "epoch.processGroupID == epoch.processID",
    "epoch.processGroupID != system.currentProcessGroup()",
    "try signal(-epoch.processGroupID, SIGTERM)",
    "try signal(-epoch.processGroupID, SIGKILL)",
    "let postReapMembers = try inventory(epoch.processGroupID)",
    "guard postReapMembers.isEmpty else",
    "guard !descriptorFailure else", "return .init()",
):
    if marker not in owned:
        raise SystemExit(f"ii-b5b-ii-d owned retirement drifted: {marker}")
for marker in (
    "epoch.processID > 1", "try signal(epoch.processID, SIGKILL)",
    "guard !descriptorFailure else",
):
    if marker not in spawned:
        raise SystemExit(f"ii-b5b-ii-d spawned retirement drifted: {marker}")
for marker in (
    "data.count.isMultiple(of: width)",
    "data.count < Self.maximumInventoryEntries * width",
    "values.allSatisfy({ $0 > 1 })",
    "Set(values).count == values.count",
):
    if marker not in inventory:
        raise SystemExit(f"ii-b5b-ii-d inventory drifted: {marker}")
if "Int32(WEXITED | WNOHANG | WNOWAIT)" not in waitable:
    raise SystemExit("ii-b5b-ii-d waitable leader drifted")
if "system.waitPID(processID, Int32(WNOHANG))" not in reap:
    raise SystemExit("ii-b5b-ii-d leader reap drifted")
if retirement.count("return .init()") != 1:
    raise SystemExit("ii-b5b-ii-d owned proof cardinality drifted")
for marker in ("killpg(", "SIGINT", "posix_spawn", "CommandLine.arguments", "ProcessInfo.processInfo.environment"):
    if marker in retirement: raise SystemExit(f"ii-b5b-ii-d retirement authority drifted: {marker}")
if re.search(r"(?<![A-Za-z0-9_])Process\s*\(", retirement):
    raise SystemExit("ii-b5b-ii-d retirement authority drifted: Process")
for name, count in {"proc_listpids": 1, "waitid": 1, "waitpid": 1, "kill": 1, "close": 1, "nanosleep": 1}.items():
    if len(re.findall(r"\b" + name + r"\s*\(", retirement)) != count:
        raise SystemExit(f"ii-b5b-ii-d syscall cardinality drifted: {name}")

test_markers = (
    "naturalExitUsesWaitableProofReapsLastAndMintsOneProof",
    "termDrainSignalsExactGroupAndNeverReapsBeforeDescendantsLeave",
    "termIgnoringDescendantEscalatesOnceToExactNegativeGroup",
    "retirementUsesFreshFixedWindowAtAnyMonotonicOrigin",
    "invalidOwnedAuthorityNeverInventoriesOrSignals",
    "malformedOrUnavailableInventoryNeverBecomesEmptyProof",
    "waitIDRetriesOnlyEINTRAndRequiresTheExactLeader",
    "waitPIDRetriesOnlyEINTRAndRejectsZeroWrongPIDAndErrors",
    "signalErrorsIncludingESRCHNeverMintProof",
    "postReapPGIDReuseWithholdsProofWithoutAnotherSignal",
    "descriptorFailureContinuesCleanupWithholdsProofAndNeverRetries",
    "cancellationWaitsForBlockingWorkerBeforeReturning",
    "duplicateAndConcurrentRetirementAreOneShot",
    "spawnedFallbackUsesPositivePIDOnlyAndCannotMintProof",
    "physicalNaturalExitIsWaitableReapedAndLeavesNoGroup",
    "physicalTermIgnoringDescendantIsKilledReapedLastAndLeavesNoGroup",
)
if any(marker not in retirement_test for marker in test_markers) or retirement_test.count("@Test") < len(test_markers) or "#expect" not in retirement_test:
    raise SystemExit("ii-b5b-ii-d focused retirement coverage drifted")
for marker in (
    "InvestigationMachineDarwinEpochRetirement.swift", "proc_listpids",
    "waitid", "waitpid", 'for name in ["kill", "close"]',
):
    if marker not in boundary: raise SystemExit(f"ii-b5b-ii-d boundary test drifted: {marker}")
if "invalidProcessGroupRemainsUncertainAfterDirectCleanup" not in session_test:
    raise SystemExit("ii-b5b-ii-d session uncertainty coverage drifted")
PY
}

