function verify_iic_evidence_verification_staged_scope() {
    local baseline=${1:-3e49956f6f8e44d5d191d47c9e86856dd00d6966}
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == \
        3e49956f6f8e44d5d191d47c9e86856dd00d6966 ]] || {
        print -u2 "ii-c evidence-verification checkpoint baseline drifted"
        return 1
    }
    local -a expected=(
        Sources/StornautInvestigationMachineCampaign/main.swift
        Sources/StornautInvestigationMachineCampaignSupport/InvestigationMachineCampaignEvidenceContract.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinOuterInnerComposition.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinOuterInnerProtocol.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineHelperEpochContinuity.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineZeroArgumentEntry.swift
        Tests/StornautInvestigationTests/InvestigationMachineCampaignEvidenceTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinOuterInnerProtocolTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries scripts/verify-contract
        scripts/verify-investigation-boundaries
        scripts/verify-investigation-runtime-machine-report
    )
    local deleted observed_text changed item mode entry added removed
    local -a ceilings=(90 770 5 610 35 5 850 530 20 80 150 400 340)
    local -A ceiling
    local -i index=1 path_changed
    for item in "${expected[@]}"; do ceiling[$item]=${ceilings[index++]}; done
    deleted=$(git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    [[ -z $deleted ]] || {
        print -u2 "ii-c evidence-verification checkpoint deleted a path"
        return 1
    }
    observed_text=$(git diff --cached --name-only --diff-filter=ACMR "$baseline" \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')
    local -a observed=(${(f)observed_text})
    (( ${#expected} == 13 && ${#observed} <= 13 )) || {
        print -u2 "ii-c evidence-verification checkpoint path ceiling drifted"
        return 1
    }
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "ii-c evidence-verification checkpoint paths drifted"
        return 1
    }
    changed=0
    while IFS=$'\t' read -r added removed item; do
        [[ $added != - && $removed != - ]] || {
            print -u2 "ii-c evidence-verification binary path rejected"; return 1
        }
        path_changed=$(( added + removed ))
        (( path_changed <= ceiling[$item] )) || {
            print -u2 "ii-c evidence-verification per-path budget drifted: $item"; return 1
        }
        (( changed += path_changed ))
    done <<< "$(git diff --cached --numstat "$baseline" -- "${expected[@]}")"
    (( changed <= 4000 )) || {
        print -u2 "ii-c evidence-verification checkpoint budget drifted"
        return 1
    }
    local -a worktree_paths=(${(f)"$(git diff --name-only --diff-filter=ACMRD -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    local -a untracked_paths=(${(f)"$(git ls-files --others --exclude-standard -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    for item in "${worktree_paths[@]}" "${untracked_paths[@]}"; do
        (( ${expected[(Ie)$item]} )) || {
            print -u2 "ii-c evidence-verification worktree paths drifted"
            return 1
        }
    done
    for item in "${expected[@]}"; do
        mode=100644; [[ $item == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$item")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" == \
            "$mode 0 $item" && "$(print -r -- "$entry" | awk '{print $2}')" == \
            "$(git hash-object -- "$item")" ]] || {
            print -u2 "ii-c evidence-verification staged source/mode drifted: $item"
            return 1
        }
    done
}

function verify_iicb2b1_source_contract() {
    local PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local -a paths=("${iicb2b1_sources[@]}")
    if (( ${#paths} == 0 )); then paths=(
        Package.swift
        Sources/CInvestigationMachineCampaignSupport/include/CInvestigationMachineCampaignSupport.h
        Sources/CInvestigationMachineCampaignSupport/CInvestigationMachineCampaignSupport.c
        Sources/StornautInvestigationMachineCampaignSupport/InvestigationMachineCampaignHarness.swift
        Tests/StornautInvestigationTests/InvestigationMachineCampaignHarnessTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-investigation-boundaries
        scripts/verify-contract
    ); fi
    (( ${#paths} == 8 )) || { print -u2 "ii-c-b2b1 source cardinality drifted"; return 1; }
    local source
