def compact(value):
    return re.sub(r"\s+", "", value)
def code_only(source):
    output = list(source)
    index = 0
    block_depth = 0
    string_end = None
    raw_hashes = ""
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "; block_depth += 1; index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "; block_depth -= 1; index += 2
            else:
                if source[index] != "\n": output[index] = " "
                index += 1
            continue
        if string_end is not None:
            if source.startswith(string_end, index):
                width = len(string_end); output[index:index + width] = " " * width
                index += width; string_end = None; raw_hashes = ""
            elif not raw_hashes and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source) and source[index + 1] != "\n":
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n": output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index); end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index); index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "; block_depth = 1; index += 2
        else:
            opener = re.match(r'(#+)?("""|")', source[index:])
            if opener is None: index += 1; continue
            hashes = opener.group(1) or ""; quote = opener.group(2)
            width = len(opener.group(0)); output[index:index + width] = " " * width
            string_end = quote + hashes; raw_hashes = hashes; index += width
    if block_depth or string_end is not None:
        raise SystemExit("interactive-native lexical scan drifted")
    return "".join(output)
