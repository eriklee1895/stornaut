    )
worker_start = lifecycle_helper_source.index(
    "private func runInteractiveWorkerMode("
)
worker_end = lifecycle_helper_source.index(
    "\n#endif",
    worker_start,
)
worker_source = lifecycle_helper_source[worker_start:worker_end]
drop_index = worker_source.index("setuid(identity.userID) == 0")
session_index = worker_source.index(
    "CodexContainedInteractiveSession()"
)
if session_index <= drop_index:
    raise SystemExit(
        "Contained Codex session is constructed before helper identity drop"
    )
root_helper_source = (
    lifecycle_helper_source[:worker_start]
    + lifecycle_helper_source[worker_end:]
)
if "CodexContainedInteractiveSession()" in root_helper_source:
    raise SystemExit(
        "Root helper gained a direct contained Codex session constructor"
    )

for source_name, source in (
