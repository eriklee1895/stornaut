machine_driver_scratch=$(mktemp -d \
    "${TMPDIR:-/tmp}/stornaut-machine-driver-binary.XXXXXX")
trap 'rm -rf "$machine_driver_scratch"' EXIT

function machine_driver_projection_sha256() {
    print -rn -- "$1" | shasum -a 256 | awk '{print $1}'
}

function machine_driver_projection_lines() {
    if [[ -z "$1" ]]; then
        print 0
    else
        print -r -- "$1" | awk 'END { print NR }'
    fi
}

function machine_driver_projection_matches() {
    local undefined_symbols=$1
    local loaded_libraries=$2
    local owned_symbols=$3
    local expected_undefined_sha=$4
    local expected_undefined_lines=$5
    local expected_loads_sha=$6
    local expected_loads_lines=$7
    local expected_owned_sha=$8
    local expected_owned_lines=$9

    [[ "$(machine_driver_projection_sha256 "$undefined_symbols")" \
        == "$expected_undefined_sha" \
        && "$(machine_driver_projection_lines "$undefined_symbols")" \
        == "$expected_undefined_lines" \
        && "$(machine_driver_projection_sha256 "$loaded_libraries")" \
        == "$expected_loads_sha" \
        && "$(machine_driver_projection_lines "$loaded_libraries")" \
        == "$expected_loads_lines" \
        && "$(machine_driver_projection_sha256 "$owned_symbols")" \
        == "$expected_owned_sha" \
        && "$(machine_driver_projection_lines "$owned_symbols")" \
        == "$expected_owned_lines" ]]
}

function require_exact_machine_driver_projection() {
    local configuration=$1
    local undefined_symbols=$2
    local loaded_libraries=$3
    local owned_symbols=$4
    local expected_undefined_sha expected_undefined_lines
    local expected_loads_sha expected_loads_lines
    local expected_owned_sha expected_owned_lines

    case "$configuration" in
        debug)
            expected_undefined_sha=579203c9d83f5884f633261d17966662a9d265455b92b94378034c7551e8e069
            expected_undefined_lines=667
            expected_loads_sha=dde8b8c4542bf1afbf276ecb5d5341bb35f3f95529573d149d1143cb18c080c9
            expected_loads_lines=18
            expected_owned_sha=f9a4938da7cfdf444715cd912d0728304d1021bed1d5ac9a7b6efe99321f3dcb
            expected_owned_lines=4267
            ;;
        release)
            expected_undefined_sha=f2ba1744c095da4b71e7906c52030b4cdea7258ef90cfb87be489b6758eb3894
            expected_undefined_lines=444
            expected_loads_sha=dde8b8c4542bf1afbf276ecb5d5341bb35f3f95529573d149d1143cb18c080c9
            expected_loads_lines=18
            expected_owned_sha=2dfe1c3a4dcb5e659fb50d2df2bc14a341f4f1dfb6077cefa08bdd8fb0179fe7
            expected_owned_lines=2719
            ;;
        *)
            print -u2 "Unknown Machine driver projection: $configuration"
            return 64
            ;;
    esac

    machine_driver_projection_matches \
        "$undefined_symbols" \
        "$loaded_libraries" \
        "$owned_symbols" \
        "$expected_undefined_sha" \
        "$expected_undefined_lines" \
        "$expected_loads_sha" \
        "$expected_loads_lines" \
        "$expected_owned_sha" \
        "$expected_owned_lines"
}

function verify_machine_driver_projection_mutations() {
    local configuration=$1
    local undefined_symbols=$2
    local loaded_libraries=$3
    local owned_symbols=$4
    local forbidden_added required_removed security_added
    local load_added owned_added

    forbidden_added=$(print -r -- "$undefined_symbols"$'\n''_write' \
        | LC_ALL=C sort -u)
    required_removed=$(print -r -- "$undefined_symbols" \
        | grep -Fxv -- _pread | LC_ALL=C sort -u)
    security_added=$(print -r -- "$undefined_symbols"$'\n''_SecItemCopyMatching' \
        | LC_ALL=C sort -u)
    load_added=$(print -r -- "$loaded_libraries"$'\n''/tmp/forbidden.dylib' \
        | LC_ALL=C sort -u)
    owned_added=$(print -r -- "$owned_symbols"$'\n''StornautInvestigationMachineDriverSupport.ForbiddenOwnedSymbol' \
        | LC_ALL=C sort -u)
    for mutation in \
        "$forbidden_added" \
        "$required_removed" \
        "$security_added"
    do
        if require_exact_machine_driver_projection \
            "$configuration" \
            "$mutation" \
            "$loaded_libraries" \
            "$owned_symbols"
        then
            print -u2 \
                "Machine driver projection mutation was accepted: $configuration"
            return 1
        fi
    done
    if require_exact_machine_driver_projection \
        "$configuration" "$undefined_symbols" "$load_added" "$owned_symbols"
    then
        print -u2 \
            "Machine driver load projection mutation was accepted: $configuration"
        return 1
    fi
    if require_exact_machine_driver_projection \
        "$configuration" "$undefined_symbols" "$loaded_libraries" "$owned_added"
    then
        print -u2 \
            "Machine driver owned projection mutation was accepted: $configuration"
        return 1
    fi
}

    authority_markers=(
        'StornautExecution.'
        'StornautCore.ActionExecutor'
        'StornautCore.TrashMoving'
        'StornautCore.FileManagerTrashAdapter'
        'StornautCore.Cleanup'
        'StornautCore.ActionPolicy'
        'StornautCore.ExecutionAuthorization'
        'StornautCore.RegisteredAction'
        'StornautCore.MoveToTrash'
        'StornautCore.ProposedCleanupAction'
        'Darwin.write'
        'Darwin.pwrite'
        'Darwin.unlink'
        'Darwin.rename'
        'Darwin.truncate'
        'Darwin.ftruncate'
        'Darwin.fork'
        'Darwin.exec'
        'Darwin.kill'
        'Darwin.socket'
        'Darwin.connect'
    )
    authority_imports=(
        _fork _vfork _execv _execve _execvp _execvP _execl _execlp
        _posix_spawnp _system _popen _dlopen _dlsym _syscall _fcntl _ioctl
        _setuid _seteuid _setreuid _setresuid _setgid _setegid _setregid
        _setresgid _initgroups _setgroups _setlogin _pthread_setugid_np
        _setsid _setpgid _daemon _chdir _fchdir _chroot _umask _nice
        _setpriority _setrlimit
        _mmap _msync _write _writev _pwrite _pwritev _unlink _unlinkat
        _rename _renameat _mkdir _mkdirat _rmdir _truncate _ftruncate
        _chmod _fchmod _fchmodat _chown _fchown _lchown _fchownat
        _chflags _fchflags _lchflags _setxattr _fsetxattr _removexattr
        _fremovexattr _acl_set_fd _acl_set_fd_np _acl_set_file
        _link _linkat _symlink _symlinkat _utime _utimes _futimes
        _setattrlist _fsetattrlist _copyfile _fcopyfile _clonefile
        _socket _connect _bind _listen _accept _accept4
        _sendto _sendmsg _recvfrom _recvmsg _getaddrinfo
        _killpg _pthread_kill _raise
    )
    iib5biic_debug_introduced_imports=(
        _free
        _getpgid
        _getpgrp
        _poll
        _posix_spawn
        _posix_spawn_file_actions_addclose
        _posix_spawn_file_actions_adddup2
        _posix_spawn_file_actions_destroy
        _posix_spawn_file_actions_init
        _posix_spawnattr_destroy
        _posix_spawnattr_init
        _posix_spawnattr_setflags
        _posix_spawnattr_setpgroup
        _recv
        _send
        _shutdown
        _socketpair
        _strdup
    )
    iib5biic_debug_required_fcntl_imports=(
        '_$s6Darwin5fcntlys5Int32VAD_A2DtF'
        '_$s6Darwin5fcntlys5Int32VAD_ADtF'
    )
    iib5biic_release_forbidden_imports=(
        _free
        _getpgid
        _getpgrp
        _poll
        _posix_spawn
        _posix_spawn_file_actions_addclose
        _posix_spawn_file_actions_adddup2
        _posix_spawn_file_actions_destroy
        _posix_spawn_file_actions_init
        _posix_spawnattr_destroy
        _posix_spawnattr_init
        _posix_spawnattr_setflags
        _posix_spawnattr_setpgroup
        _recv
        _send
        _shutdown
        _socketpair
        _strdup
    )
    iib5biid_debug_introduced_imports=(
        _kill _nanosleep _proc_listpids _waitid _waitpid
    )
    iib5biid_release_forbidden_imports=(
        _kill _nanosleep _proc_listpids _waitid _waitpid
    )
    required_readonly_imports=(
        '_$s6Darwin5fcntlys5Int32VAD_A2DtF'
        '_$s6Darwin5fcntlys5Int32VAD_ADtF'
        _read _pread _lseek _fstat _lstat _flistxattr
        _acl_free _acl_get_entry _acl_get_fd_np
        _proc_pidpath _SecCodeCopySelf _SecStaticCodeCreateWithPath
        _SMJobCopyDictionary _kSMDomainSystemLaunchd
        _proc_pidinfo _task_name_for_pid _task_info
        _mach_continuous_time _mach_timebase_info
        _audit_token_to_asid _audit_token_to_euid
        _audit_token_to_pid _audit_token_to_pidversion
    )
    expected_security_imports=$(
        print -rl -- \
            _SecCodeCheckValidity \
            _SecCodeCopyGuestWithAttributes \
            _SecCodeCopyPath \
            _SecCodeCopySelf \
            _SecCodeCopySigningInformation \
            _SecCodeCopyStaticCode \
            _SecRequirementCopyData \
            _SecRequirementGetTypeID \
            _SecStaticCodeCheckValidity \
            _SecStaticCodeCreateWithPath \
            _kSecCodeInfoDesignatedRequirement \
            _kSecCodeInfoFlags \
            _kSecCodeInfoIdentifier \
            _kSecCodeInfoUnique \
            _kSecGuestAttributeAudit \
            _kSecGuestAttributePid \
            | LC_ALL=C sort
    )
    for configuration in debug release; do
        scratch_path="$machine_driver_scratch/$configuration"
        mkdir -p "$scratch_path"
        swift build \
            --scratch-path "$scratch_path" \
            --configuration "$configuration" \
            --product StornautInvestigationMachineDriver
        driver=$(
            swift build \
                --scratch-path "$scratch_path" \
                --configuration "$configuration" \
                --show-bin-path
        )/StornautInvestigationMachineDriver
        [[ -x "$driver" && ! -L "$driver" ]] || {
            print -u2 "Machine driver binary is missing: $driver"
            exit 1
        }
        [[ "$(file -b "$driver")" == *"Mach-O 64-bit executable arm64"* ]]
        driver_status=0
        "$driver" || driver_status=$?
        if (( driver_status != 77 )); then
            print -u2 \
                "Machine driver fail-closed status drifted: $driver_status"
            exit 1
        fi
        driver_symbols=$(
            xcrun nm -j "$driver" 2>/dev/null \
                | xcrun swift-demangle 2>/dev/null
        ) || {
            print -u2 "Machine driver symbol scan failed: $driver"
            exit 1
        }
        driver_undefined_symbols=$(xcrun nm -u -j "$driver" 2>/dev/null \
            | LC_ALL=C sort -u) || {
            print -u2 "Machine driver undefined-symbol scan failed: $driver"
            exit 1
        }
        driver_loaded_libraries=$(otool -L "$driver" 2>/dev/null \
            | tail -n +2 \
            | sed 's/^[[:space:]]*//' \
            | LC_ALL=C sort -u) || {
            print -u2 "Machine driver load-command scan failed: $driver"
            exit 1
        }
        driver_owned_symbols=$(print -r -- "$driver_symbols" \
            | rg 'StornautInvestigationMachineDriver(Support)?' \
            | LC_ALL=C sort -u) || {
            print -u2 "Machine driver owned-symbol scan failed: $driver"
            exit 1
        }
        if ! require_exact_machine_driver_projection \
            "$configuration" \
            "$driver_undefined_symbols" \
            "$driver_loaded_libraries" \
            "$driver_owned_symbols"
        then
            print -u2 \
                "Machine driver exact projection drifted: $configuration"
            exit 1
        fi
        verify_machine_driver_projection_mutations \
            "$configuration" \
            "$driver_undefined_symbols" \
            "$driver_loaded_libraries" \
            "$driver_owned_symbols" || exit 1
        if [[ "$driver_symbols" != \
            *'Darwin.open(Swift.UnsafePointer<Swift.Int8>, Swift.Int32)'* ]]
        then
            print -u2 "Machine driver read-only Darwin.open is missing."
            exit 1
        fi
        for marker in "${authority_markers[@]}"; do
            if [[ "$driver_symbols" == *"$marker"* ]]; then
                print -u2 \
                    "Machine driver contains prohibited authority: $marker"
                exit 1
            fi
        done
        for marker in "${authority_imports[@]}"; do
            if print -r -- "$driver_undefined_symbols" \
                | grep -Fxq -- "$marker"
            then
                print -u2 \
                    "Machine driver imports prohibited authority: $marker"
                exit 1
            fi
        done
        for marker in "${required_readonly_imports[@]}"; do
            if ! print -r -- "$driver_undefined_symbols" \
                | grep -Fxq -- "$marker"
            then
                print -u2 \
                    "Machine driver read-only import is missing: $marker"
                exit 1
            fi
        done
        if [[ $configuration == debug ]]; then
            for marker in "${iib5biic_debug_introduced_imports[@]}"; do
                if ! print -r -- "$driver_undefined_symbols" \
                    | grep -Fxq -- "$marker"
                then
                    print -u2 \
                        "ii-b5b-ii-c Debug fixed-session import is missing: $marker"
                    exit 1
                fi
            done
            for marker in "${iib5biic_debug_required_fcntl_imports[@]}"; do
                if ! print -r -- "$driver_undefined_symbols" \
                    | grep -Fxq -- "$marker"
                then
                    print -u2 \
                        "ii-b5b-ii-c Debug fcntl import is missing: $marker"
                    exit 1
                fi
            done
            for marker in "${iib5biid_debug_introduced_imports[@]}"; do
                if ! print -r -- "$driver_undefined_symbols" \
                    | grep -Fxq -- "$marker"
                then
                    print -u2 \
                        "ii-b5b-ii-d Debug retirement import is missing: $marker"
                    exit 1
                fi
            done
        else
            for marker in "${iib5biic_release_forbidden_imports[@]}"; do
                if print -r -- "$driver_undefined_symbols" \
                    | grep -Fxq -- "$marker"
                then
                    print -u2 \
                        "ii-b5b-ii-c fixed-session import leaked into Release: $marker"
                    exit 1
                fi
            done
            for marker in "${iib5biid_release_forbidden_imports[@]}"; do
                if print -r -- "$driver_undefined_symbols" \
                    | grep -Fxq -- "$marker"
                then
                    print -u2 \
                        "ii-b5b-ii-d retirement import leaked into Release: $marker"
                    exit 1
                fi
            done
        fi
        observed_security_imports=$(
            print -r -- "$driver_undefined_symbols" \
                | grep -E '^_(Sec|kSec|Authorization|CSSM)' \
                | LC_ALL=C sort
        )
        if [[ "$observed_security_imports" != "$expected_security_imports" ]]; then
            print -u2 "Machine driver Security import allowlist drifted."
            exit 1
        fi
    done
rm -rf "$machine_driver_scratch"
trap - EXIT
print "Authority-closed Debug/Release Machine driver binaries passed."

print "Investigation Core and coordinator boundary verification passed."
