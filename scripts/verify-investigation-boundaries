if hashlib.sha256(collector_contract.encode()).hexdigest() != "12841b1d3b20a6d849f1ccd82f912a4fc64a035d55d4190e4e926b335f521b49":
    raise SystemExit("ii-b5b-i-c2a collector state machine drifted")

