function verify_iic0biia3_index_semantics() (
    local staged_root staged_status=0
    staged_root=$(mktemp -d \
        "${TMPDIR:-/tmp}/stornaut-iic0biia3-index.XXXXXX") || return $?
    trap 'rm -rf "$staged_root"' EXIT
    trap 'exit 130' INT; trap 'exit 143' TERM
    git checkout-index --all --prefix="$staged_root/" \
        || staged_status=$?
    if (( staged_status == 0 )); then
        (
            cd "$staged_root"
            scripts/verify-investigation-boundaries \
                --iic0b-ii-a3-retained-base-contract-only \
                Sources/StornautInvestigationMachineLaunchSupport/InvestigationMachineGateOwnership.swift \
                Tests/StornautInvestigationTests/InvestigationMachineGateOwnershipTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        ) || staged_status=$?
    fi
    return $staged_status
)

function verify_iic0biia3_staged_scope() {
    local baseline=${1:-fe3ea757432c4dc9cf960f210c167916697ce601}
    local expected=(
        Sources/StornautInvestigationMachineLaunchSupport/InvestigationMachineGateOwnership.swift
        Tests/StornautInvestigationTests/InvestigationMachineGateOwnershipTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 6 )) || {
        print -u2 "ii-c0b-ii-a3 checkpoint path ceiling drifted"; return 1
    }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == \
        fe3ea757432c4dc9cf960f210c167916697ce601 ]] \
        && [[ "$(git rev-parse "$baseline^{tree}" 2>/dev/null)" == \
        9533824602ff18b35581f191f9ff0140a52ec53c ]] || {
        print -u2 "ii-c0b-ii-a3 checkpoint baseline drifted"; return 1
    }
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-ii-a3 checkpoint deleted an existing path"; return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-ii-a3 binary checkpoint path rejected"; return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "ii-c0b-ii-a3 checkpoint paths drifted"; return 1
    }
    local checkpoint_path expected_mode entry
    for checkpoint_path in "${expected[@]}"; do
        expected_mode=100644
        [[ $checkpoint_path == scripts/* ]] && expected_mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $checkpoint_path" ]] || {
            print -u2 "ii-c0b-ii-a3 checkpoint mode drifted: $checkpoint_path"
            return 1
        }
    done
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 2750 )) || {
        print -u2 "ii-c0b-ii-a3 checkpoint budget drifted"; return 1
    }
    verify_iic0biia3_index_semantics
}

function verify_iic0biib_capsule_contract() {
    local package_path=$1 ownership_path=$2 capsule_path=$3
    local focused_test_path=$4 boundary_path=$5 source_path
    for source_path in "$ownership_path" "$capsule_path" \
        "$focused_test_path" "$boundary_path"
    do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex \
            "$source_path" || return $?
    done
    python3 - "$package_path" "$ownership_path" "$capsule_path" \
        "$focused_test_path" "$boundary_path" <<'PY'
from pathlib import Path
import hashlib
import re
import subprocess
import sys

package_path, ownership_path, capsule_path, focused_path, boundary_path = map(
    Path, sys.argv[1:]
)
package = package_path.read_text(encoding="utf-8")
ownership = ownership_path.read_text(encoding="utf-8")
capsule = capsule_path.read_text(encoding="utf-8")
focused = focused_path.read_text(encoding="utf-8")
boundary = boundary_path.read_text(encoding="utf-8")

def fail(message):
    raise SystemExit(message)

for label, source, expected_prefix in (
    ("ownership", ownership, ["import Darwin", "import Foundation", "#if DEBUG"]),
    ("capsule", capsule, [
        "import Darwin", "import Foundation",
        "import StornautInvestigationHandoffContract", "#if DEBUG",
    ]),
):
    lines = [line.strip() for line in source.splitlines() if line.strip()]
    if lines[:len(expected_prefix)] != expected_prefix \
            or lines[-1] != "#endif" \
            or lines.count("#if DEBUG") != 1 \
            or lines.count("#endif") != 1 \
            or any(line.startswith(("#else", "#elseif")) for line in lines):
        fail(f"ii-c0b-ii-b source DEBUG boundary drifted: {label}")

target = re.findall(
    r'(?ms)\.target\(\s*name:\s*'
    r'"StornautInvestigationMachineLaunchSupport"\s*,\s*'
    r'dependencies:\s*\[(?P<dependencies>.*?)\]\s*\)', package,
)
if len(target) != 1 or re.findall(r'"([^"]+)"', target[0]) != [
    "StornautInvestigationHandoffContract", "StornautInvestigationMachineGateSupport"
]:
    fail("ii-c0b-ii-b target dependency surface drifted")
if re.search(r"(?m)^\s*(?:public|open)\s+", ownership + capsule) \
        or re.search(r"\b(?:Codable|Encodable|Decodable)\b", capsule):
    fail("ii-c0b-ii-b package-only or Codable surface drifted")
package_headers = []
lines = capsule.splitlines()
for index, line in enumerate(lines):
    if not re.match(r"^\s*package\s+", line):
        continue
    header = line.strip()
    if re.search(r"\b(?:func|init|subscript)\b", header):
        cursor = index + 1
        while "{" not in header and cursor < len(lines) \
                and cursor <= index + 16:
            header += " " + lines[cursor].strip()
            cursor += 1
    package_headers.append(header.split("{", 1)[0])
package_declarations = "\n".join(package_headers)
if re.search(r"\b(?:Int32|CInt|FileDescriptor|UnsafeFileHandle|URL)\b",
             package_declarations) \
        or re.search(r"\b(?:path|fileDescriptor|descriptor)\b",
                     package_declarations, re.I) \
        or re.search(r"@escaping|\bfunc\s+\w+\s*<",
                     package_declarations):
    fail("ii-c0b-ii-b raw descriptor, path, URL or callback surface drifted")
if re.search(
    r"\b(?:FileManager|removeItem|replaceItem|moveItem|"
    r"removeItemRecursively|Darwin\.unlink)\b", capsule, re.I,
) or re.search(
    r"(?m)^(?!\s*func\s+unlink\b)[^\n]*"
    r"(?<![A-Za-z0-9_.])unlink\s*\(", capsule,
):
    fail("ii-c0b-ii-b broad cleanup or lock mutation drifted")
if re.search(
    r"\b(?:Date|CFAbsoluteTimeGetCurrent|ProcessInfo|mtime|"
    r"modificationDate|pid|processName|getpid|getppid)\b", capsule, re.I,
):
    fail("ii-c0b-ii-b retry or heuristic boundary drifted")
for forbidden in (
    "import StornautCore", "import StornautCodex",
    "import StornautLifecycle", "import StornautExecution",
    "import StornautInvestigationRuntime",
    "import StornautInvestigationDiagnostic",
    "import StornautProbeBridge", "NSXPCConnection",
    "AuthorizationCreate", "Foundation.Process(", "URLSession",
):
    if forbidden in ownership + capsule:
        fail(f"ii-c0b-ii-b product or privileged reachability drifted: {forbidden}")
for marker in (
    "InvestigationOwnerOnlyCapsuleSettlement",
    "monotonicNanoseconds",
    "EBUSY",
    "AT_NODELETEBUSY",
    "AT_UNIQUE",
    "AT_SYMLINK_NOFOLLOW_ANY",
    "AT_RESOLVE_BENEATH",
    "decoded.capsule.outerAttemptUUID == attemptUUID",
    "revalidateEmptyDirectoryPlan(",
):
    if marker not in capsule:
        fail(f"ii-c0b-ii-b retry or heuristic boundary drifted: {marker}")
for marker in (
    "InvestigationOwnerOnlyCapsuleSettlementToken",
    "InvestigationOwnerOnlyCapsuleExactGateReapedProof",
    "InvestigationOwnerOnlyCapsuleNeverHandedOffProof",
    "closeReaderForSettlement",
    "releaseOwnership",
    "private let settlementToken = InvestigationOwnerOnlyCapsuleSettlementToken()",
):
    if marker not in capsule:
        fail(f"ii-c0b-ii-b close and reap binding drifted: {marker}")
if capsule.count("private let settlementToken =") != 1 \
        or capsule.count("settlementToken.consume()") != 2:
    fail("ii-c0b-ii-b close and reap binding drifted")
if "private let settlementToken = InvestigationOwnerOnlyCapsuleSettlementToken()" \
        not in capsule:
    fail("ii-c0b-ii-b close and reap binding drifted")
if (ownership + capsule).count("InvestigationOwnerOnlyCapsuleLease.make(") != 1:
    fail("ii-c0b-ii-b one-shot lease cardinality drifted")
if "try? system.inventory" in capsule \
        or "try! system.inventory" in capsule:
    fail("ii-c0b-ii-b inventory failure was swallowed")
inventory = capsule.find("let inventory = try at(.inventory")
recovery = capsule.find(
    "InvestigationOwnerOnlyCapsuleSettlement.recoverStale", inventory
)
first_mutation = capsule.find("try system.createDirectory(")
if min(inventory, recovery, first_mutation) < 0 \
        or not inventory < recovery < first_mutation:
    fail("ii-c0b-ii-b mutation before complete inventory drifted")
retry = capsule.find("private static func unlinkWithBusyRetry(")
if retry < 0:
    fail("ii-c0b-ii-b retry or heuristic boundary drifted")
retry_end = capsule.find("\n    private static func requireAbsent(", retry)
if retry_end < 0:
    fail("ii-c0b-ii-b retry or heuristic boundary drifted")
retry_body = capsule[retry:retry_end]
for marker in (
    "where value == EBUSY",
    "now = try system.monotonicNanoseconds()",
    "now < deadline",
    "beforeWait = try system.monotonicNanoseconds()",
    "beforeWait < deadline",
    "system.waitForRetry(",
    "nanoseconds: min(1_000_000, deadline - beforeWait)",
    "afterWait = try system.monotonicNanoseconds()",
    "afterWait < deadline",
    "try revalidate()",
):
    if marker not in retry_body:
        fail(f"ii-c0b-ii-b retry or heuristic boundary drifted: {marker}")
if "maximumBusyRetries" in capsule \
        or re.search(r"\bretries?\s*(?:<=|<|==|>=|>)", retry_body):
    fail("ii-c0b-ii-b retry count cap drifted")
directory_revalidation = capsule.find(
    "private static func revalidateEmptyDirectoryPlan("
)
directory_identity_helper = capsule.find(
    "private static func hasStableDirectoryIdentityAndSecurity(",
    directory_revalidation,
)
if min(directory_revalidation, directory_identity_helper) < 0:
    fail("ii-c0b-ii-b directory retry revalidation drifted")
directory_body = capsule[directory_revalidation:directory_identity_helper]
for marker in (
    "system.openComponent(",
    "validateDirectory(",
    "system.inventory(",
    "inventory.reachedEnd",
    "inventory.entries.isEmpty",
    "system.close(descriptor: directory)",
):
    if marker not in directory_body:
        fail(f"ii-c0b-ii-b directory retry revalidation drifted: {marker}")
if directory_body.count("try system.close(descriptor: directory)") != 1:
    fail(
        "ii-c0b-ii-b directory retry revalidation drifted: "
        "system.close(descriptor: directory)"
    )
settlement_start = capsule.find(
    "enum InvestigationOwnerOnlyCapsuleSettlement {"
)
validate_directory = capsule.find(
    "\n    private static func validateDirectory(", settlement_start
)
validate_file = capsule.find(
    "private static func validateFile(", validate_directory
)
if min(settlement_start, validate_directory, validate_file) < 0:
    fail("ii-c0b-ii-b directory retry revalidation drifted")
validation_body = capsule[validate_directory:validate_file]
for marker in (
    "let held = try system.metadata(",
    "let named = try system.namedMetadata(",
    "held == named",
    "system.extendedACLIsEmpty(",
    "system.extendedAttributeNames(",
):
    if marker not in validation_body:
        fail(f"ii-c0b-ii-b directory retry revalidation drifted: {marker}")
remove_start = capsule.find("private static func remove(")
directory_unlink = capsule.find("flags: directoryUnlinkFlags", remove_start)
retry_start = capsule.rfind("try unlinkWithBusyRetry(", remove_start, directory_unlink)
first_directory_revalidation = capsule.rfind(
    "try revalidateEmptyDirectoryPlan(", remove_start, retry_start
)
retry_closure = capsule.find(
    "try revalidateEmptyDirectoryPlan(", retry_start
)
if min(remove_start, directory_unlink, retry_start, \
       first_directory_revalidation, retry_closure) < 0 \
        or not remove_start < first_directory_revalidation < retry_start \
        or not retry_start < directory_unlink < retry_closure:
    fail("ii-c0b-ii-b directory retry revalidation order drifted")
focused_markers = (
    "neverHandedOffProofSettlesPublishedNodeOnce",
    "validEmptyStaleLeafRecoversBeforeFreshPublication",
    "stalePayloadMustMatchAttemptDirectoryUUID",
    "directoryBusyRetryReopensAndFullyRevalidatesEmptyLeaf",
    "directoryBusyRetryRejectsMetadataOrContentDrift",
    "persistentBusyFailsOnlyWhenAbsoluteDeadlineIsReached",
    "clockFailuresPreserveStagePriorityResidueAndCleanup",
)
for marker in focused_markers:
    if marker not in focused:
        fail(f"ii-c0b-ii-b focused tests became vacuous: {marker}")
for marker in (
    "iiC0BIIBCapsuleVerifierPinsAggregateContractAndScope",
    "--iic0b-ii-b-capsule-contract-only",
    "--iic0b-ii-b-staged-scope-contract-only",
    "--iic0b-ii-b-source-contract-only",
    "--iic0b-ii-b-component-boundary-only",
):
    if marker not in boundary:
        fail(f"ii-c0b-ii-b boundary regression drifted: {marker}")
PY
}

function verify_iic0biib_index_semantics() (
    local staged_root staged_status=0
    staged_root=$(mktemp -d \
        "${TMPDIR:-/tmp}/stornaut-iic0biib-index.XXXXXX") || return $?
    trap 'rm -rf "$staged_root"' EXIT
    trap 'exit 130' INT; trap 'exit 143' TERM
    git checkout-index --all --prefix="$staged_root/" \
        || staged_status=$?
    if (( staged_status == 0 )); then
        (
            cd "$staged_root"
            scripts/verify-investigation-boundaries \
                --iic0b-ii-b-capsule-contract-only \
                Package.swift \
                Sources/StornautInvestigationMachineLaunchSupport/InvestigationMachineGateOwnership.swift \
                Sources/StornautInvestigationMachineLaunchSupport/InvestigationOwnerOnlyCapsule.swift \
                Tests/StornautInvestigationTests/InvestigationOwnerOnlyCapsuleTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
            scripts/verify-app-release-boundaries \
                --iic0b-ii-b-source-contract-only \
                Package.swift \
                Sources/StornautInvestigationMachineLaunchSupport/InvestigationMachineGateOwnership.swift \
                Sources/StornautInvestigationMachineLaunchSupport/InvestigationOwnerOnlyCapsule.swift \
                scripts/verify-app-release-boundaries
        ) || staged_status=$?
    fi
    return $staged_status
)

function verify_iic0biib_staged_scope() {
    local baseline=${1:-cbc469403f0ecfcdab17fb93baadd24d3c12f1ff}
    local expected=(
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 4 )) || {
        print -u2 "ii-c0b-ii-b aggregate checkpoint path ceiling drifted"; return 1
    }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == \
        cbc469403f0ecfcdab17fb93baadd24d3c12f1ff \
        && "$(git rev-parse "$baseline^{tree}" 2>/dev/null)" == \
        8ec89e24cece79ad7559a25c0fad9681442bae5d ]] || {
        print -u2 "ii-c0b-ii-b aggregate checkpoint baseline drifted"; return 1
    }
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-ii-b aggregate checkpoint deleted an existing path"; return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-ii-b aggregate binary checkpoint path rejected"; return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "ii-c0b-ii-b aggregate checkpoint paths drifted"; return 1
    }
    local checkpoint_path expected_mode entry
    for checkpoint_path in "${expected[@]}"; do
        expected_mode=100644
        [[ $checkpoint_path == scripts/* ]] && expected_mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $checkpoint_path" ]] || {
            print -u2 "ii-c0b-ii-b aggregate checkpoint mode drifted: $checkpoint_path"
            return 1
        }
    done
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 1800 )) || {
        print -u2 "ii-c0b-ii-b aggregate checkpoint budget drifted"; return 1
    }
    verify_iic0biib_index_semantics
}

function verify_iica_source_contract() {
    local -a sources=("$@")
    local canonical_mode=false
    if (( ${#sources} == 0 )); then
        canonical_mode=true
        sources=(
            Package.swift
            Sources/StornautInvestigationMachineGateSupport/InvestigationMachineFixedGateLauncher.swift
            Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift
            Stornaut.xcodeproj/project.pbxproj
            Stornaut.xcodeproj/xcshareddata/xcschemes/StornautInvestigationDiagnosticApp.xcscheme
            scripts/stornaut-r5-local-lifecycle
            Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
            Tests/StornautInvestigationTests/InvestigationClosedMachineArtifactInstallerTests.swift
        )
    fi
    (( ${#sources} == 8 )) || {
        print -u2 "ii-c-a source path count drifted"; return 1
    }
    local source_path
    for source_path in "${sources[@]}"; do
        [[ -f $source_path && ! -L $source_path ]] || {
            print -u2 "ii-c-a source path unavailable: $source_path"; return 1
        }
    done
    xcrun swiftc -frontend -parse -enable-bare-slash-regex \
        "${sources[2]}" "${sources[3]}" "${sources[7]}" \
        "${sources[8]}" || return $?
    zsh -n "${sources[6]}" || return $?
    python3 - "$canonical_mode" "${sources[@]}" <<'PY'
from pathlib import Path
import re
import sys
import xml.etree.ElementTree as ET

canonical_mode = sys.argv[1] == "true"
paths = list(map(Path, sys.argv[2:]))
root = Path.cwd().resolve()
expected = [
    root / "Package.swift",
    root / "Sources/StornautInvestigationMachineGateSupport/InvestigationMachineFixedGateLauncher.swift",
    root / "Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift",
    root / "Stornaut.xcodeproj/project.pbxproj",
    root / "Stornaut.xcodeproj/xcshareddata/xcschemes/StornautInvestigationDiagnosticApp.xcscheme",
    root / "scripts/stornaut-r5-local-lifecycle",
    root / "Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift",
    root / "Tests/StornautInvestigationTests/InvestigationClosedMachineArtifactInstallerTests.swift",
]
if canonical_mode and [path.resolve() for path in paths] != expected:
    raise SystemExit("ii-c-a source path identity drifted")
package_path, gate_path, coordinator_path, project_path, scheme_path, installer_path, boundary_path, focused_path = paths
package = package_path.read_text(encoding="utf-8")
gate = gate_path.read_text(encoding="utf-8")
coordinator = coordinator_path.read_text(encoding="utf-8")
project = project_path.read_text(encoding="utf-8")
scheme = scheme_path.read_text(encoding="utf-8")
installer = installer_path.read_text(encoding="utf-8")
boundary = boundary_path.read_text(encoding="utf-8")
focused = focused_path.read_text(encoding="utf-8")
tools = (
    ("StornautInvestigationMachineDriverNative", "StornautInvestigationMachineDriver", "StornautInvestigationMachineDriverSupport", "com.eriklee.stornaut.investigation.machine-driver", "Tools/StornautInvestigationMachineDriver/main.swift"),
    ("StornautInvestigationMachineGateNative", "StornautInvestigationMachineGate", "StornautInvestigationMachineGateSupport", "com.eriklee.stornaut.investigation.machine-gate", "tools/StornautInvestigationMachineGate/main.swift"),
    ("StornautInvestigationMachineGateCoordinatorNative", "StornautInvestigationMachineGateCoordinator", "StornautInvestigationMachineGateCoordinatorSupport", "com.eriklee.stornaut.investigation.machine-gate-coordinator", "tools/StornautInvestigationMachineGateCoordinator/main.swift"),
)
products = package.split("\n    targets: [\n", 1)[0]
for _target, _product, support, _identifier, _source in tools[1:]:
    pattern = rf'(?ms)\.library\(\s*name:\s*"{re.escape(support)}"\s*,\s*type:\s*\.static\s*,\s*targets:\s*\["{re.escape(support)}"\]\s*\),?'
    if len(re.findall(pattern, products)) != 1:
        raise SystemExit(f"ii-c-a static support product drifted: {support}")
if 'path: "tools/StornautInvestigationMachineGate"' not in package or 'path: "Tools/StornautInvestigationMachineGate"' in package:
    raise SystemExit("ii-c-a Gate source path case drifted")
for label, source, enum_name, run in (
    ("Gate", gate, "InvestigationMachineGateSupport", "public static func run() -> Int32"),
    ("Coordinator", coordinator, "InvestigationMachineGateCoordinatorSupport", "public static func run() async -> Int32"),
):
    if source.count("public ") != 2 or f"public enum {enum_name}" not in source or run not in source:
        raise SystemExit(f"ii-c-a {label} public API surface drifted")

native_section = project.split("/* Begin PBXNativeTarget section */", 1)[1].split("/* End PBXNativeTarget section */", 1)[0]
if native_section.count("isa = PBXNativeTarget;") != 10:
    raise SystemExit("ii-c-a native target count drifted")
for target, product, support, identifier, source in tools:
    for marker in (f"name = {target};", f"productName = {product};", f"productName = {support};", f"PRODUCT_BUNDLE_IDENTIFIER = {identifier};", f"path = {source};"):
        if marker not in project:
            raise SystemExit(f"ii-c-a tool graph drifted: {marker}")
    copy = re.findall(rf'(?m)^.*{re.escape(product)} in Copy Investigation Machine Tools.*$', project)
    if len(copy) != 2 or not any("CodeSignOnCopy" in row for row in copy):
        raise SystemExit(f"ii-c-a CodeSignOnCopy membership drifted: {product}")
    if scheme.count(f'BlueprintName = "{target}"') != 1 or scheme.count(f'BuildableName = "{product}"') != 1:
        raise SystemExit(f"ii-c-a diagnostic scheme membership drifted: {target}")
if project.count('name = "Copy Investigation Machine Tools";') != 1:
    raise SystemExit("ii-c-a machine-tool copy phase drifted")
copy_start = project.index("B00000000000000000000042 /* Copy Investigation Machine Tools */ = {")
copy_end = project.index("\n\t\t};", copy_start)
if project[copy_start:copy_end].count(" in Copy Investigation Machine Tools */") != 3:
    raise SystemExit("ii-c-a machine-tool copy inventory drifted")
for configuration_id, configuration_name in (
    ("A00000000000000000000190", "Debug"),
    ("A00000000000000000000191", "Release"),
):
    marker = f"{configuration_id} /* {configuration_name} */ = {{"
    start = project.index(marker)
    end = project.index("\n\t\t};", start)
    configuration = project[start:end]
    for setting in (
        'CONFIGURATION_BUILD_DIR = "$(BUILD_DIR)/$(CONFIGURATION)/StornautInvestigationMachineGateCoordinatorNative";',
        'SWIFT_INCLUDE_PATHS = "$(inherited) $(BUILD_DIR)/$(CONFIGURATION)";',
        'LD_RUNPATH_SEARCH_PATHS = "$(inherited) @executable_path/../Frameworks";',
    ):
        if configuration.count(setting) != 1:
            raise SystemExit(
                f"ii-c-a Coordinator {configuration_name} isolation drifted: {setting}"
            )
for configuration_id, configuration_name in (
    ("A00000000000000000000140", "Debug"),
    ("A00000000000000000000141", "Release"),
):
    marker = f"{configuration_id} /* {configuration_name} */ = {{"
    start = project.index(marker)
    end = project.index("\n\t\t};", start)
    configuration = project[start:end]
    for setting in (
        "CREATE_INFOPLIST_SECTION_IN_BINARY = YES;",
        "CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO;",
        "PRODUCT_BUNDLE_IDENTIFIER = com.eriklee.stornaut.lifecycle.helper;",
    ):
        if configuration.count(setting) != 1:
            raise SystemExit(
                f"ii-c-a helper {configuration_name} identity metadata drifted: {setting}"
            )
ET.parse(scheme_path)
for marker in (
    "validate_closed_executable_identity() {",
    "validate_closed_executable_artifact() {",
    "validate_closed_app_artifacts() {",
    "validate_closed_artifact_fixtures() {",
    "app_max_bytes=$((256 * 1024 * 1024))",
    "helper_max_bytes=$((256 * 1024 * 1024))",
    "machine_gate_max_bytes=$((64 * 1024 * 1024))",
    "machine_coordinator_max_bytes=$((64 * 1024 * 1024))",
):
    if installer.count(marker) != 1:
        raise SystemExit(f"ii-c-a installer closure drifted: {marker}")
if installer.count("machineClaimServiceIdentifier=$machine_claim_service") != 1:
    raise SystemExit("ii-c-a driver-only claim service association drifted")
closed_match = re.search(
    r'(?ms)^validate_closed_app_artifacts\(\) \{\n(.*?)(?=^\}\n\n)',
    installer,
)
if closed_match is None:
    raise SystemExit("ii-c-a closed App identity function drifted")
closed_app = closed_match.group(1)
roles = (
    ("StornautInvestigationDiagnostic", "com.eriklee.stornaut", "$app_max_bytes", '""'),
    ("StornautLifecycleHelper", "com.eriklee.stornaut.lifecycle.helper", "$helper_max_bytes", '""'),
    ("StornautInvestigationMachineDriver", "com.eriklee.stornaut.investigation.machine-driver", "$machine_driver_max_bytes", "$machine_claim_service"),
    ("StornautInvestigationMachineGate", "com.eriklee.stornaut.investigation.machine-gate", "$machine_gate_max_bytes", '""'),
    ("StornautInvestigationMachineGateCoordinator", "com.eriklee.stornaut.investigation.machine-gate-coordinator", "$machine_coordinator_max_bytes", '""'),
)
if closed_app.count("validate_closed_executable_artifact") != len(roles):
    raise SystemExit("ii-c-a installer role cardinality drifted")
for product, identifier, maximum, service in roles:
    for role_marker in (f"Contents/MacOS/{product}", identifier, maximum, service):
        if role_marker not in closed_app:
            raise SystemExit(f"ii-c-a installer role drifted: {product}: {role_marker}")
for identity_key in ("appIdentity={", "helperIdentity={", "machineDriverIdentity={", "machineGateIdentity={", "machineCoordinatorIdentity={"):
    if closed_app.count(identity_key) != 1:
        raise SystemExit(f"ii-c-a installer identity key drifted: {identity_key}")
for marker in (
    "iiCAMachinePackagingVerifierPinsClosedTopologyAndScope",
    "--iic-a-source-contract-only",
    "--iic-a-staged-scope-contract-only",
    "--iic-a-component-boundary-only",
    "--iic-a-contract-only",
):
    if marker not in boundary:
        raise SystemExit(f"ii-c-a boundary verifier coverage drifted: {marker}")
for marker in (
    "lifecycleHelperEmbedsStableSigningIdentifierMetadata",
    "installerBindsEachRoleToItsOwnIdentity",
    "installerRevalidatesClosedArtifactsBeforeStateChanges",
    "validationActionKeepsMachineToolChecksReadOnly",
):
    if marker not in focused:
        raise SystemExit(f"ii-c-a focused coverage drifted: {marker}")
PY
}

function verify_iic0biii2a_gate_contract() {
    local package_path=$1 transport_path=$2 launcher_path=$3 darwin_path=$4
    local entry_path=$5 launcher_test_path=$6 physical_test_path=$7
    local stub_path=$8 boundary_path=$9 source_path
    for source_path in "$package_path" "$transport_path" "$launcher_path" \
        "$darwin_path" "$entry_path" "$launcher_test_path" \
        "$physical_test_path" "$stub_path" "$boundary_path"
    do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source_path" \
            || return $?
    done
    python3 - "$package_path" "$transport_path" "$launcher_path" \
        "$darwin_path" "$entry_path" "$launcher_test_path" \
        "$physical_test_path" "$stub_path" "$boundary_path" <<'PY'
from pathlib import Path
import hashlib
import re
import sys

(package_path, transport_path, launcher_path, darwin_path, entry_path,
 launcher_test_path, physical_test_path, stub_path, boundary_path) = map(
    Path, sys.argv[1:]
)
package = package_path.read_text(encoding="utf-8")
transport = transport_path.read_text(encoding="utf-8")
launcher = launcher_path.read_text(encoding="utf-8")
darwin = darwin_path.read_text(encoding="utf-8")
entry = entry_path.read_text(encoding="utf-8")
launcher_test = launcher_test_path.read_text(encoding="utf-8")
