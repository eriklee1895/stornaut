if any(marker in lifecycle for marker in (
    "LifecycleRootTopologyPhase","provesInstalledTopology",
    "installedContractSatisfied","satisfiesPhaseContract",
    "case loaded(identity:","case loadedValid",
)) or "phase" in declaration(lifecycle,r"^package struct LifecycleRootTopologyObservationRequest\b","lifecycle request"):
    raise SystemExit("ii-b5b-i-c2a lifecycle phase surface remains")
if set(re.findall(r"(?m)^\s*case\s+([A-Za-z0-9_]+)",service_result)) != {"absent","unavailable"} or set(re.findall(r"(?m)^\s*case\s+([A-Za-z0-9_]+)",service_observation)) != {"absent","unavailable"}:
    raise SystemExit("ii-b5b-i-c2a lifecycle service surface drifted")
expected_post_contract="privatevarpostTeardownContractSatisfied:Bool{LifecycleRootTopologyArtifactRole.allCases.allSatisfy{artifacts[$0]==.absent}&&appProcess.provesOriginalIdentityAbsent&&helperProcess.provesOriginalIdentityAbsent&&service==.absent}"
