    /usr/bin/xcrun swiftc -frontend -parse -enable-bare-slash-regex "${paths[4]}"
    /usr/bin/xcrun swiftc -frontend -parse -enable-bare-slash-regex "${paths[5]}"
    /usr/bin/xcrun swiftc -frontend -parse -enable-bare-slash-regex "${paths[6]}"
    /bin/zsh -n "${paths[7]}"; /bin/zsh -n "${paths[8]}"
    /usr/bin/python3 -I - "$iicb2b1_mutation_contract_only" \
        "$iicb2b1_mutation_name" "$iicb2b1_mutation_slot" \
        "$iicb2b1_mutation_sha" "${paths[@]}" <<'PY'
