    ["git", "rev-list", "--ancestry-path", "--reverse",
     f"{baseline}..HEAD"],
    text=True,
).splitlines()
if descendants:
    checkpoint = descendants[0]
    parent = subprocess.check_output(
        ["git", "show", "-s", "--format=%P", checkpoint], text=True
    ).strip()
    if parent != baseline:
        raise SystemExit(
            "legacy machine claim checkpoint is not the direct baseline child"
        )
    diff_command = ["git", "diff", "--numstat", baseline, checkpoint, "--"]
    name_command = ["git", "diff", "--name-only", baseline, checkpoint, "--"]
    untracked = set()
else:
    diff_command = ["git", "diff", "--numstat", baseline, "--"]
    name_command = ["git", "diff", "--name-only", baseline, "--"]
    untracked = set(subprocess.check_output(
        ["git", "ls-files", "--others", "--exclude-standard"],
        text=True,
    ).splitlines())
paths = set(subprocess.check_output(name_command, text=True).splitlines()) | untracked
non_document = {path for path in paths if not path.startswith("docs/")}
if non_document != expected:
    raise SystemExit(
        "legacy machine claim checkpoint paths drifted: "
        f"{sorted(non_document)}"
    )
changed_lines = 0
counted = set()
for row in subprocess.check_output(diff_command, text=True).splitlines():
    added, deleted, path = row.split("\t")
    if path in expected and added != "-" and deleted != "-":
        changed_lines += int(added) + int(deleted)
        counted.add(path)
for path in expected & untracked:
    changed_lines += len(Path(path).read_text(encoding="utf-8").splitlines())
    counted.add(path)
if counted != expected:
    raise SystemExit(
        "legacy machine claim checkpoint numstat drifted: "
        f"{sorted(counted)}"
    )
if changed_lines > 3_000:
    raise SystemExit(
        f"legacy machine claim checkpoint budget drifted: {changed_lines} > 3000"
    )
PY
}

