PY
}

function verify_iib5biia_index_semantics() {
    local staged_root
    staged_root=$(mktemp -d \
        "${TMPDIR:-/tmp}/stornaut-iib5biia-index.XXXXXX")
    local staged_status=0
    git checkout-index --all --prefix="$staged_root/" \
        || staged_status=$?
    local semantic_path
    for semantic_path in \
        Sources/StornautInvestigationMachineDriverSupport/DarwinInvestigationMachineInstalledDriverSystem.swift \
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineFixedCapsuleIntake.swift \
        Tests/StornautInvestigationTests/InvestigationMachineDriverSupportTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineFixedCapsuleIntakeTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift \
        scripts/verify-contract \
        scripts/verify-investigation-boundaries
    do
        if (( staged_status == 0 )) \
            && ! cmp -s \
                "$repo_root/$semantic_path" \
                "$staged_root/$semantic_path"
        then
            print -u2 \
                "ii-b5b-ii-a staged content drifted: $semantic_path"
            staged_status=1
        fi
    done
    if (( staged_status == 0 )); then
        (
            cd "$staged_root"
            scripts/verify-investigation-boundaries \
                --iib5biia-fixed-capsule-contract-only \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineFixedCapsuleIntake.swift \
                Tests/StornautInvestigationTests/InvestigationMachineFixedCapsuleIntakeTests.swift
        ) || staged_status=$?
    fi
    if (( staged_status == 0 )); then
        python3 - \
            "$staged_root/scripts/verify-contract" \
            "$staged_root/scripts/verify-investigation-boundaries" <<'PY' \
            || staged_status=$?
from pathlib import Path
import hashlib
import re
import sys

contract_path, boundary_path = map(Path, sys.argv[1:])
contract = contract_path.read_text(encoding="utf-8")
boundary = boundary_path.read_bytes()
self_match = re.findall(
    r"(?m)^# ib2_self_sha=([0-9a-f]{64})$", contract
)
if len(self_match) != 1:
    raise SystemExit("ii-b5b-ii-a staged verifier self-seal drifted")
normalized = re.sub(
    r"(?m)^# ib2_self_sha=[0-9a-f]{64}$", "# ib2_self_sha=SELF", contract
).encode("utf-8")
if hashlib.sha256(normalized).hexdigest() != self_match[0]:
    raise SystemExit("ii-b5b-ii-a staged verifier self-seal drifted")
boundary_match = re.findall(
    r'Path\("scripts/verify-investigation-boundaries"\):\s*'
    r'"([0-9a-f]{64})"',
    contract,
)
if (
    len(boundary_match) != 1
    or hashlib.sha256(boundary).hexdigest() != boundary_match[0]
):
    raise SystemExit("ii-b5b-ii-a staged boundary seal drifted")
for marker in (
    "iib5biia_baseline=ddbc4a0be3ea059c7de239b85ef60c40c09affbb",
    "--iib5biia-fixed-capsule-contract-only",
    "--iib5biia-staged-scope-contract-only",
    "staged-semantic-drift",
    "ii-b5b-ii-a mutation accepted: $name",
    "ii-b5b-ii-a scope mutation accepted: $fixture",
):
    if marker not in contract:
        raise SystemExit(
            f"ii-b5b-ii-a staged verifier contract drifted: {marker}"
        )
PY
    fi
    rm -rf "$staged_root"
    (( staged_status == 0 )) || return "$staged_status"
}

function verify_iib5biia_staged_scope() {
    local baseline=${1:-ddbc4a0be3ea059c7de239b85ef60c40c09affbb}
    [[ "$(git rev-parse "$baseline^{commit}")" \
        == ddbc4a0be3ea059c7de239b85ef60c40c09affbb ]] || {
        print -u2 "ii-b5b-ii-a checkpoint baseline drifted"
        return 1
    }
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/DarwinInvestigationMachineInstalledDriverSystem.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineFixedCapsuleIntake.swift
        Tests/StornautInvestigationTests/InvestigationMachineDriverSupportTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineFixedCapsuleIntakeTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "ii-b5b-ii-a checkpoint deleted an existing path"
        return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "ii-b5b-ii-a binary checkpoint path rejected"
        return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1')"})
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || {
        print -u2 "ii-b5b-ii-a checkpoint paths drifted"
        return 1
    }
    local changed
    changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 {n+=$1+$2} END {print n+0}')
    (( changed <= 2000 )) || {
        print -u2 "ii-b5b-ii-a checkpoint budget drifted"
        return 1
    }
    verify_iib5biia_index_semantics
}

