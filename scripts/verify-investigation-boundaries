policy_probe = '"/usr/bin/sudo -knv"'
if contract.count(policy_probe) != 1 or verifier.count(policy_probe) != 1:
    raise SystemExit("ii-c-b2a2 policy probe evidence drifted")
authority_surface = (contract.replace(policy_probe, "", 1) + writer
                     + verifier.replace(policy_probe, "", 1))
for forbidden in ("Process(", "posix_spawn", "URLSession", "NSXPC", "socket(",
                  "launchctl", "sudo", "trashItem", "removeItem", "unlink(",
                  "StornautExecution", "ActionExecutor", "RegisteredAction"):
