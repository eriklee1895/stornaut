    xcrun swiftc -frontend -parse "$focused_test_source"
    python3 - "$package_source" "$artifact_source" "$focused_test_source" <<'PY'
from pathlib import Path
import re
import sys
package_path, source_path, test_path = map(Path, sys.argv[1:])
package = package_path.read_text(encoding="utf-8")
source = source_path.read_text(encoding="utf-8")
test = test_path.read_text(encoding="utf-8")
target = re.search(
    r'\.target\(\s*name: "StornautInvestigationInstalledL2",(.*?)\n\s*\),',
    package, re.DOTALL,
)
if target is None:
    raise SystemExit("ii-b5b-i-b2a package target missing")
body = target.group(1)
dependencies = set(re.findall(r'"(CInvestigationIdentitySupport|Stornaut[A-Za-z0-9]+)"', body))
frameworks = re.findall(r'\.linkedFramework\("([^"]+)"\)', body)
if dependencies != {"CInvestigationIdentitySupport", "StornautInvestigationHandoffContract"} or frameworks != ["Security", "ServiceManagement"]:
    raise SystemExit("ii-b5b-i-b2a dependency or framework surface drifted")
if set(re.findall(r'(?m)^import\s+([A-Za-z0-9_]+)\s*$', source)) != {
    "Darwin", "Foundation", "Security", "StornautInvestigationHandoffContract",
}:
    raise SystemExit("ii-b5b-i-b2a imports drifted")
if re.search(r'(?m)^\s*(?:public|open)\s+', source):
    raise SystemExit("ii-b5b-i-b2a public surface drifted")
for forbidden in (
    "FileManager", "FileHandle", "Process(", "NSXPC", "URLSession",
    "ServiceManagement", "posix_spawn", "Darwin.write", "unlink(",
    "rename(", "removeItem", "moveItem", "socket(", "connect(",
    "O_NOFOLLOW_ANY", "O_UNIQUE", "format == .xml",
):
    if forbidden in source:
        raise SystemExit("ii-b5b-i-b2a authority or contract surface drifted")
