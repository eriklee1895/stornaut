}

function verify_iib5biia_fixed_capsule_contract() {
    local capsule_source=$1 focused_test_source=$2
    local installed_source=Sources/StornautInvestigationMachineDriverSupport/DarwinInvestigationMachineInstalledDriverSystem.swift
    local installed_test=Tests/StornautInvestigationTests/InvestigationMachineDriverSupportTests.swift
    local boundary_test=Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
    xcrun swiftc -frontend -parse "$capsule_source"
    xcrun swiftc -frontend -parse "$focused_test_source"
    python3 - "$capsule_source" "$focused_test_source" \
        "$installed_source" "$installed_test" "$boundary_test" <<'PY'
from pathlib import Path
import hashlib
import re
import sys

source_path, test_path, installed_path, installed_test_path, boundary_path = (
    map(Path, sys.argv[1:])
)
source = source_path.read_text(encoding="utf-8")
test = test_path.read_text(encoding="utf-8")
installed = installed_path.read_text(encoding="utf-8")
installed_test = installed_test_path.read_text(encoding="utf-8")
boundary = boundary_path.read_text(encoding="utf-8")


def code_only(value, label):
    output = list(value)
    index = 0
    block_depth = 0
    delimiter = None
    while index < len(value):
        if block_depth:
            if value.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif value.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if value[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if delimiter is not None:
            if value.startswith(delimiter, index):
                width = len(delimiter)
                output[index:index + width] = " " * width
                delimiter = None
                index += width
            elif delimiter == '"' and value[index] == "\\":
                output[index] = " "
                if index + 1 < len(value):
                    output[index + 1] = " "
                index += 2
            else:
                if value[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if value.startswith("//", index):
            end = value.find("\n", index)
            end = len(value) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif value.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif value.startswith('"""', index):
            output[index:index + 3] = "   "
            delimiter = '"""'
            index += 3
        elif value[index] == '"':
            output[index] = " "
            delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or delimiter is not None:
        raise SystemExit(f"ii-b5b-ii-a {label} contains unterminated text")
    return "".join(output)


def declaration(value, pattern, label):
    match = re.search(pattern, value, re.MULTILINE)
    if match is None:
        raise SystemExit(f"ii-b5b-ii-a {label} drifted")
    opening = value.find("{", match.end())
    if opening < 0:
        raise SystemExit(f"ii-b5b-ii-a {label} has no body")
    depth = 0
    for index in range(opening, len(value)):
        if value[index] == "{":
            depth += 1
        elif value[index] == "}":
            depth -= 1
            if depth == 0:
                return value[match.start():index + 1]
    raise SystemExit(f"ii-b5b-ii-a {label} is unterminated")


def compact(value):
    return re.sub(r"\s+", "", value)


def require_order(value, markers, label):
    cursor = 0
    for marker in markers:
        position = value.find(marker, cursor)
        if position < 0:
            raise SystemExit(
                f"ii-b5b-ii-a {label} missing ordered marker: {marker}"
            )
        cursor = position + len(marker)


code = code_only(source, "source")
imports = set(re.findall(
