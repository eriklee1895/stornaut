    path.read_text(encoding="utf-8")
    for path in (
        composition_path, session_path, protocol_path, retirement_path,
        composition_test_path, session_test_path, protocol_test_path,
        retirement_test_path, boundary_path,
    )
)

def fail(message):
    raise SystemExit(f"iii-b2a-ii-a2-ii {message}")

def declaration(source, pattern, label):
    match = re.search(pattern, source, re.MULTILINE)
    if match is None:
        fail(f"{label} drifted")
    opening = source.find("{", match.end())
    if opening < 0:
        fail(f"{label} drifted")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    fail(f"{label} drifted")

def require_order(source, markers, label):
    cursor = 0
    for marker in markers:
        found = source.find(marker, cursor)
        if found < 0:
            fail(f"{label} drifted")
        cursor = found + len(marker)

