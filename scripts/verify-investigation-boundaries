if hashlib.sha256(normalized_cross_source.encode()).hexdigest() != (
    "beebdb641bb8900a010b7312937d778b8b8894833f2c4a0f0bb978972c140207"
):
    raise SystemExit("ii-b5b-ii-b C cross-source comparison drifted")
for marker in ("package func prepare(","package func observe(","kSecGuestAttributePid: NSNumber(value: pid_t(processID))","InvestigationInstalledL2NodeReader()","InvestigationInstalledL2StaticSigningReader()","facts.snapshot.startTimeSeconds == preDrop.startTimeSeconds","facts.snapshot.startTimeMicroseconds\n                == preDrop.startTimeMicroseconds","dropEvidence.auditTokenWords[0] == preDrop.auditTokenWords[0]","facts.staticSigning == preDrop.staticSigning","InvestigationMachineSingleEpochAppObservation(identity: identity)"):
    if marker not in source: raise SystemExit(f"ii-b5b-ii-b observer contract drifted: {marker}")
