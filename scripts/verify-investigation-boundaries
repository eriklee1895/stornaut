    "InvestigationInstalledL2SemanticContract.evaluate(":canonical_owner,
    "InvestigationInstalledL2Observer()":canonical_join,
}
for marker,expected_path in owners.items():
    hits=[source_path for source_path,text in sources.items() for _ in range(text.count(marker))]
    if hits != [expected_path]:
        raise SystemExit(f"ii-b5b-i-c2b installed physical-owner cardinality drifted: {marker}")
expected_hashes=(
    "05da8bd10712f769137c6c73158755e46fce17cc18650dce4508b31edc8c04b5",
    "376148fd9e0284c03e399ed281cd47696bed3c35630cf272fa639b7df99960d2",
)
if tuple(hashlib.sha256(path.read_bytes()).hexdigest() for path in paths[4:6]) != expected_hashes:
    raise SystemExit("ii-b5b-i-c2b canonical installed owner or join drifted")
expected_production_hashes={
    paths[0]:"0f5f0c7a166465bd703bd6eb0b374feedc82dca1d9a071be40df585c2f7bfd23",
    paths[1]:"5f2f069aef85a7aecbed661b785ca735209a45d3195f3baf740558e6fa9ae975",
    paths[2]:"8e153b1ad92d96d481aceb8958593ba68b0ca26b7d74fb72ceffbc78a842fd59",
    paths[3]:"8e61cd00614db2661657c4734e8cad540ebf7213605686f789106cf81c043ec5",
}
for path,expected in expected_production_hashes.items():
    if hashlib.sha256(path.read_bytes()).hexdigest() != expected:
        raise SystemExit(f"ii-b5b-i-c2b production source drifted: {path.name}")
PY
}

function verify_iib5bic2b_index_semantics() {
    local staged_root=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iib5bic2b-index.XXXXXX")
    local staged_status=0
    git checkout-index --all --prefix="$staged_root/" || staged_status=$?
    if (( staged_status == 0 )); then
        verify_iib5bic2b_absence_only_contract \
            "$staged_root/Sources/StornautLifecycle/LifecycleRootTopologyObservation.swift" \
            "$staged_root/Sources/StornautLifecycle/DarwinRootTopologySupport.swift" \
            "$staged_root/Sources/StornautInvestigationMachine/InvestigationLifecycleTopologyCollector.swift" \
            "$staged_root/Sources/StornautInvestigationMachine/FixedLifecycleServiceProbe.swift" \
            "$staged_root/Sources/StornautInvestigationInstalledL2/InstalledL2Observer.swift" \
            "$staged_root/Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpochInstalledL2Join.swift" \
            "$staged_root/Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift" \
            "$staged_root/Tests/StornautInvestigationTests/InvestigationLifecycleTopologyCollectorTests.swift" \
            "$staged_root/Sources" || staged_status=$?
    fi
    rm -rf "$staged_root"
    (( staged_status == 0 )) || return "$staged_status"
}

function verify_iib5bic2b_boundary_staged_scope() {
    local baseline=${1:-773a91f81d644071dfc5a4d22dac77bb9bf5b576}
    [[ "$(git rev-parse "$baseline^{commit}")" == 773a91f81d644071dfc5a4d22dac77bb9bf5b576 ]] || { print -u2 "ii-b5b-i-c2b-ii baseline drifted"; return 1; }
    local expected=(scripts/verify-investigation-boundaries)
    if git diff --cached --name-only --diff-filter=D "$baseline" | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'; then print -u2 "ii-b5b-i-c2b-ii checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'; then print -u2 "ii-b5b-i-c2b-ii binary checkpoint path rejected"; return 1; fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1')"})
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || { print -u2 "ii-b5b-i-c2b-ii checkpoint paths drifted"; return 1; }
    local changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 {n+=$1+$2} END {print n+0}')
    (( changed <= 800 )) || { print -u2 "ii-b5b-i-c2b-ii checkpoint budget drifted"; return 1; }
    verify_iib5bic2b_index_semantics
}

function verify_iib5bic2b_contract_staged_scope() {
