function verify_iib5bic2a_staged_scope() {
    local baseline=${1:-6e794274c8a427422e47df326231010b07f3413c}
    [[ "$(git rev-parse "$baseline^{commit}")" == 6e794274c8a427422e47df326231010b07f3413c ]] || { print -u2 "ii-b5b-i-c2a baseline drifted"; return 1; }
    local expected=(
        Sources/StornautInvestigationMachine/FixedLifecycleServiceProbe.swift Sources/StornautInvestigationMachine/InvestigationLifecycleTopologyCollector.swift Sources/StornautInvestigationMachine/InvestigationMachineScenarioDriver.swift
        Sources/StornautLifecycle/LifecycleRootTopologyObservation.swift
        Tests/StornautInvestigationTests/FixedLifecycleServiceProbeTests.swift Tests/StornautInvestigationTests/InvestigationLifecycleTopologyCollectorTests.swift Tests/StornautInvestigationTests/InvestigationLifecycleTopologyTestSupport.swift Tests/StornautInvestigationTests/InvestigationMachineDriverHostTests.swift Tests/StornautInvestigationTests/InvestigationMachineScenarioDriverTests.swift Tests/StornautInvestigationTests/InvestigationMachineScenarioTestSupport.swift Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        Tests/StornautLifecycleTests/LifecycleRootTopologyObservationTests.swift
        scripts/verify-contract scripts/verify-investigation-boundaries
    )
    if git diff --cached --name-only --diff-filter=D "$baseline" | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'; then print -u2 "ii-b5b-i-c2a checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'; then print -u2 "ii-b5b-i-c2a binary checkpoint path rejected"; return 1; fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1')"})
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || { print -u2 "ii-b5b-i-c2a checkpoint paths drifted"; return 1; }
    local changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 {n+=$1+$2} END {print n+0}')
    (( changed <= 2200 )) || { print -u2 "ii-b5b-i-c2a checkpoint budget drifted"; return 1; }

    local staged_root=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iib5bic2a-index.XXXXXX")
    local staged_status=0
    git checkout-index --all --prefix="$staged_root/" || staged_status=$?
    if (( staged_status == 0 )); then
        verify_iib5bic2a_legacy_owner_contract \
            "$staged_root/Sources/StornautLifecycle/LifecycleRootTopologyObservation.swift" \
            "$staged_root/Sources/StornautInvestigationMachine/InvestigationLifecycleTopologyCollector.swift" \
            "$staged_root/Sources/StornautInvestigationMachine/FixedLifecycleServiceProbe.swift" \
            "$staged_root/Sources/StornautInvestigationMachine/InvestigationMachineScenarioDriver.swift" \
            "$staged_root/Sources/StornautInvestigationInstalledL2/InstalledL2Observer.swift" \
            "$staged_root/Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpochInstalledL2Join.swift" \
            "$staged_root/Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift" \
            "$staged_root/Sources" || staged_status=$?
    fi
    rm -rf "$staged_root"
    (( staged_status == 0 )) || return "$staged_status"
}

