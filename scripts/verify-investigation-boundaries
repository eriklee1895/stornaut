        raise SystemExit("ii-c-b2a2 prohibited authority drifted")
if "value.artifacts == entries, try value.encoded() == data" not in contract:
    raise SystemExit("ii-c-b2a2 producer canonical contract drifted")
if writer.index("try validateCompleteTree()") > writer.index("try publishManifest(manifestBytes)"):
    raise SystemExit("ii-c-b2a2 manifest-last producer drifted")
required_verifier = (
    "#!/bin/zsh -f\n", "[[ $# == 2 ]]", "exec /usr/bin/python3 -I -",
    "sys.flags.optimize", "O_NOFOLLOW_ANY", "O_RESOLVE_BENEATH", "O_UNIQUE",
    "os.open", "dir_fd=", "os.fstat", "follow_symlinks=False", "os.pread",
    "canonical re-encode", "manifest requires an exact external seal",
    "Foundation.framework/Foundation",
    'require(foundation_json(data) == data, "noncanonical json")',
    "root_path = canonical_absolute_path(root_path)",
    "seal_path = canonical_absolute_path(seal_path)",
    "def require_exact_component(parent_fd, component):",
    "require_exact_component(parent_fd, component)",
    '            parent_fd = walk["fds"][-1]\n            require_exact_component(parent_fd, component)',
    "require_exact_component(parent_fd, component)",
    '    for parent_fd, component, descriptor, identity, expected_regular in walk["nodes"]:\n        require_exact_component(parent_fd, component)',
    "open_absolute", "revalidate_absolute_walk",
    "held_files.append((parent_fd, name, fd, before, hashlib.sha256(data).digest()))",
    '            walk["fds"].append(descriptor)\n            watch(descriptor, final)\n            held = os.fstat(descriptor)',
    "change_queue = select.kqueue()", "VNODE_CONTENT", 'require(change_queue.control([event], 0, 0) == [], "vnode watch registration")',
