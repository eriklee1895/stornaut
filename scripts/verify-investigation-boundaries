def declaration_block(source, declaration, next_declaration):
    start = source.find(declaration)
    end = source.find(next_declaration, start + len(declaration))
    if start < 0 or end < 0:
        raise SystemExit(
            f"missing closed declaration block: {declaration}"
        )
    return source[start:end]

def require_schema(source, declaration, next_declaration, version):
    declaration_source = declaration_block(
        source, declaration, next_declaration
    )
    marker = f"public static let schemaVersion = {version}"
    if marker not in declaration_source:
        raise SystemExit(
            f"strict schema drifted: {declaration} != {version}"
        )
    return declaration_source

