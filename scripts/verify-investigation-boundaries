    raise SystemExit("machine claim server source allowlist drifted")
products = [
    product for product in package.get("products", [])
    if "StornautInvestigationMachineClaimServer" in product.get("targets", [])
]
if len(products) != 1 or products[0].get("name") != (
    "StornautInvestigationMachineClaimServer"
):
    raise SystemExit("machine claim server product ownership drifted")
manifest_products = {product["name"]: product for product in manifest["products"]}
product = manifest_products.get("StornautInvestigationMachineClaimServer")
