function verify_iib3b_start_retire_contract() {
    local source_path=$1
    python3 - "$source_path" <<'PY'
from pathlib import Path
import re
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")
def code_only(value):
    output = list(value)
    index = 0
    block_depth = 0
    delimiter = None
    while index < len(value):
        if block_depth:
            if value.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif value.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if value[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if delimiter is not None:
            if value.startswith(delimiter, index):
                width = len(delimiter)
                output[index:index + width] = " " * width
                delimiter = None
                index += width
            elif delimiter == '"' and value[index] == "\\":
                output[index] = " "
                if index + 1 < len(value):
                    output[index + 1] = " "
                index += 2
            else:
                if value[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if value.startswith("//", index):
            end = value.find("\n", index)
            end = len(value) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif value.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif value.startswith('"""', index):
            output[index:index + 3] = "   "
            delimiter = '"""'
            index += 3
        elif value[index] == '"':
            output[index] = " "
            delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or delimiter is not None:
        raise SystemExit("start-retire source has unterminated text")
    return "".join(output)

code = code_only(source)
match = re.search(
    r"(?m)^\s*package func startAndRetireWithEvidence\(\) async throws\s*$",
    code,
)
if match is None:
    raise SystemExit("start-retire seam package API drifted")
if code.count("startAndRetireWithEvidence") != 1:
    raise SystemExit("start-retire seam forwarding surface drifted")
opening = code.find("{", match.end())
depth = 0
closing = -1
for index in range(opening, len(code)):
    if code[index] == "{":
        depth += 1
    elif code[index] == "}":
        depth -= 1
        if depth == 0:
            closing = index + 1
            break
if opening < 0 or closing < 0:
    raise SystemExit("start-retire seam body is unterminated")
projected_body = code[match.start():closing]
body = re.sub(r"\s+", "", projected_body)
required = (
    "acquireOperation(cancellationSensitive:false)",
    "guardstate==.ready",
    "startIfNeeded()",
    "startRequestDispatched",
    "Task{tryawaitself.retireWithEvidenceCore()}",
    "letevidence=tryawaitretirement.value",
    "ifletstartFailure",
    "guard!cancelledAfterStart,!Task.isCancelled",
    "returnevidence",
)
missing = [value for value in required if value not in body]
if missing:
    raise SystemExit(f"start-retire seam contract drifted: {missing!r}")
for forbidden in (
    "writeLine", "readLine", "CodexInteractiveAppServerClient",
    "prepareRoot", "authProjection", "initialize", "login",
    "thread", "turn", "capabilityEvidence", "modelEvidence",
    "networkEvidence", "Process", "NSXPCConnection",
    "DispatchSemaphore",
):
    if re.search(
        rf"(?<![A-Za-z0-9_]){re.escape(forbidden)}(?![A-Za-z0-9_])",
        projected_body,
        re.IGNORECASE,
    ):
        raise SystemExit(f"start-retire seam gained prohibited surface: {forbidden}")
PY
}

