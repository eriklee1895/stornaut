function verify_iib5biic_darwin_session_contract() {
    local composer_source=$1 session_source=$2 focused_test=$3
    local composer_test=$4 boundary_test=$5
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$composer_source"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$session_source"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$focused_test"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$composer_test"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$boundary_test"
    python3 - "$composer_source" "$session_source" "$focused_test" \
        "$composer_test" "$boundary_test" <<'PY'
from pathlib import Path
import re, sys
composer_path, session_path, focused_path, composer_test_path, boundary_path = map(Path, sys.argv[1:])
composer, session, focused, composer_test, boundary = [
    path.read_text(encoding="utf-8") for path in (
        composer_path, session_path, focused_path, composer_test_path, boundary_path
    )
]

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

def declaration(source, pattern, label):
    match = re.search(pattern, source, re.MULTILINE)
    if match is None:
        raise SystemExit(f"ii-b5b-ii-c declaration missing: {label}")
    opening = source.find("{", match.end())
    if opening < 0:
        raise SystemExit(f"ii-b5b-ii-c declaration malformed: {label}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    raise SystemExit(f"ii-b5b-ii-c declaration unterminated: {label}")

if imports(composer) != {"Foundation", "StornautInvestigationHandoffContract", "StornautInvestigationInstalledL2"}:
    raise SystemExit("ii-b5b-ii-c composer import surface drifted")
if imports(session) != {"CInvestigationIdentitySupport", "Darwin", "Dispatch", "Foundation", "StornautInvestigationHandoffContract", "StornautInvestigationInstalledL2"}:
    raise SystemExit("ii-b5b-ii-c session import surface drifted")
for label, source in (("composer", composer), ("session", session)):
    if re.search(r"(?m)^\s*(?:public|open)\s+", source):
        raise SystemExit(f"ii-b5b-ii-c {label} public surface drifted")
    for marker in ("Codable", "signedInvestigationRuntimeReady", "signedRuntimeReady", "StornautCore", "StornautExecution", "StornautLifecycle", "StornautInvestigationDiagnostic"):
        if marker in source:
            raise SystemExit(f"ii-b5b-ii-c {label} authority surface drifted: {marker}")
for marker in ("posix_spawnp", "/bin/sh", "/bin/zsh", "system(", "popen(", "kill(", "killpg(", "waitpid(", "signal(", "FileHandle(forWritingTo:", "Darwin.write(", "unlink(", "rename(", "connect(", "listen("):
    if marker in session:
        raise SystemExit(f"ii-b5b-ii-c session gained prohibited authority: {marker}")
if re.search(r"\bProcess\s*\(", session):
    raise SystemExit("ii-b5b-ii-c session gained prohibited authority: Process")
if len(re.findall(r"\bsocketpair\s*\(", session)) != 1:
    raise SystemExit("ii-b5b-ii-c socketpair cardinality drifted")
if len(re.findall(r"\bposix_spawn\s*\(", session)) != 1:
    raise SystemExit("ii-b5b-ii-c posix_spawn cardinality drifted")
if session.count("posix_spawn_file_actions_adddup2(") != 1:
    raise SystemExit("ii-b5b-ii-c FD7 duplication cardinality drifted")
for marker in (
    "executablePath: InvestigationInstalledL2FixedPaths()\n                .appExecutable.path",
    "arguments: [\n                InvestigationInstalledL2FixedPaths().appExecutable.path\n            ]",
    "environment: []",
    "static let fixedDescriptor: Int32 = 7",
    "POSIX_SPAWN_SETPGROUP | POSIX_SPAWN_CLOEXEC_DEFAULT",
    "request.arguments == [request.executablePath]",
    "request.environment.isEmpty",
    "posix_spawnattr_setpgroup(&attributes, 0)",
):
    if marker not in session:
        raise SystemExit(f"ii-b5b-ii-c fixed spawn contract drifted: {marker}")
if len(re.findall(
    r"InvestigationInstalledL2FixedPaths\(\)\s*\.appExecutable\.path",
    session,
)) != 3:
    raise SystemExit("ii-b5b-ii-c fixed spawn contract drifted: executable path")
if not re.search(r"\bcase(?:[ A-Za-z,]+,)?\s*terminalUncertain\b", session) or ".retirementUncertain" not in session:
    raise SystemExit("ii-b5b-ii-c typed terminal uncertainty drifted")
if session.count("return terminal(.terminalUncertain)") != 3:
    raise SystemExit("ii-b5b-ii-c terminal outcome truth drifted")
if (
    "protocol InvestigationMachineDarwinEpochRetirementOwning" not in session
    or "retirementOwner: any InvestigationMachineDarwinEpochRetirementOwning" not in session
    or "func retireSpawnedProcess(" not in session
    or "func retireOwnedProcessGroup(" not in session
    or "processGroupID" in re.search(
        r"struct InvestigationMachineDarwinSpawnedEpoch:.*?\n}\n",
        session, re.DOTALL,
    ).group(0)
):
    raise SystemExit("ii-b5b-ii-c opaque retirement ownership drifted")
untrusted_retirement = declaration(
    session, r"^\s*private func retireUntrustedGroup\(",
    "retireUntrustedGroup",
)
owned_retirement = declaration(
    session, r"^\s*private func retireOwnedStartup\(",
    "retireOwnedStartup",
)
if (
    untrusted_retirement.count("retirementOwner.retireSpawnedProcess(spawned)") != 1
    or "retireOwnedProcessGroup" in untrusted_retirement
    or owned_retirement.count("retirementOwner.retireOwnedProcessGroup(owned)") != 1
    or "retireSpawnedProcess" in owned_retirement
    or session.count("return await retireUntrustedGroup(spawned)") != 2
    or session.count("return await retireOwnedStartup(owned)") != 2
):
    raise SystemExit("ii-b5b-ii-c opaque retirement routing drifted")
if session.count("kind.admitsPayloadByteCount(payloadCount)") != 1 or session.count("InvestigationHandoffFrame.headerByteCount") < 2:
    raise SystemExit("ii-b5b-ii-c kind-specific frame bound drifted")
blocking_read = declaration(
    session, r"^\s*private static func blockingRead\(", "blockingRead"
)
blocking_write = declaration(
    session, r"^\s*private static func blockingWrite\(", "blockingWrite"
)
poll_wait = declaration(
    session, r"^\s*private static func wait\(", "wait"
)
if (
    blocking_read.count("try requireBeforeDeadline(") != 3
    or not re.search(
        r"if count == 0\s*\{\s*try requireBeforeDeadline\("
        r"deadlineNanoseconds, clock: clock\)\s*return Data\(\)",
        blocking_read, re.DOTALL,
    )
    or not re.search(
        r"if allowsEOF && offset == 0\s*\{\s*"
        r"try requireBeforeDeadline\(\s*deadlineNanoseconds, clock: clock"
        r"\s*\)\s*return Data\(\)",
        blocking_read, re.DOTALL,
    )
    or not re.search(
        r"try requireBeforeDeadline\(deadlineNanoseconds, clock: clock\)"
        r"\s*return data\s*}\s*$",
        blocking_read, re.DOTALL,
    )
    or blocking_write.count("try requireBeforeDeadline(") != 1
    or not re.search(
        r"try requireBeforeDeadline\(deadlineNanoseconds, clock: clock\)"
        r"\s*}\s*$",
        blocking_write, re.DOTALL,
    )
    or poll_wait.count("try requireBeforeDeadline(") != 1
    or not re.search(
        r"try requireBeforeDeadline\(deadlineNanoseconds, clock: clock\)"
        r"\s*return\s*}\s*}\s*$",
        poll_wait, re.DOTALL,
    )
):
    raise SystemExit("ii-b5b-ii-c final deadline verification drifted")
for marker in (
    "case .stable(.firstIdentity):", "return firstIdentity",
    "case .stable(.repeatedIdentity):",
    "actor InvestigationMachineDarwinEpochSession",
    "case operation(UUID, poisoned: Bool)",
    "phase = .operation(ticket, poisoned: false)",
    "phase = .operation(ticket, poisoned: true)",
    "let ticket = try begin(expected)", "try finish(ticket, next: next)",
    "case .terminal, .retiring, .operation:", "phase = .retiring", "phase = .terminal",
):
    if marker not in session:
        raise SystemExit(f"ii-b5b-ii-c actor/session contract drifted: {marker}")
fresh_block = re.search(
    r"case \.stable\(\.repeatedIdentity\):(?P<body>.*?)\n\s*default:",
    session, re.DOTALL,
)
if (
    fresh_block is None
    or fresh_block.group("body").count("preparedIdentity.observe(") != 1
    or "firstIdentity!" in fresh_block.group("body")
):
    raise SystemExit("ii-b5b-ii-c repeated identity freshness drifted")
focused_markers = (
    "fixedFDAndSpawnContractAreExact", "kindSpecificPayloadBoundRejectsBeforePayloadRead",
    "wrongPhaseKindRejectsBeforeItsLargePayloadRead",
    "physicalIORechecksDeadlineAfterCompletion",
    "productionSpawnPrimitiveMapsOnlyFDSeven",
    "concurrentReceivePermanentlyConsumesTheSession",
    "concurrentInvalidCallCannotRetireBeforeInFlightIOCompletes",
    "retirementIsExactlyOnceAndSecondCallIsRejected",
    "canonicalSessionUsesCachedThenFreshIdentityAndRetires",
)
if any(marker not in focused for marker in focused_markers):
    raise SystemExit("ii-b5b-ii-c focused session coverage drifted")
physical_spawn_test = declaration(
    focused, r"^\s*(?:@Test\s+)?func productionSpawnPrimitiveMapsOnlyFDSeven\(",
    "productionSpawnPrimitiveMapsOnlyFDSeven",
)
physical_fixture = declaration(
    focused, r"^\s*private func compilePhysicalChildFixture\(",
    "compilePhysicalChildFixture",
)
compact_physical = re.sub(r"\s+", "", physical_spawn_test)
compact_fixture = re.sub(r"\s+", "", physical_fixture)
for marker in (
    "InvestigationMachineDarwinEpochSpawnPrimitive.spawn(",
    "arguments:[fixtureURL.path],environment:[]",
    "childTargetDescriptor:7",
    "POSIX_SPAWN_SETPGROUP|POSIX_SPAWN_CLOEXEC_DEFAULT",
    "#expect(getpgid(processID)==processID)",
    "#expect(processID!=getpgrp())",
    ".readUpToOne(parent,deadline).isEmpty",
    ".writeExactly(parent,Data([0x7e]),deadline)",
    "whilewaitpid(processID,&status,0)<0",
    "#expect(status==0)",
):
    if marker not in compact_physical:
        raise SystemExit(
            f"ii-b5b-ii-c physical spawn coverage drifted: {marker}"
        )
for marker in (
    "argc!=1", "envp[0]!=NULL", "getsockopt(7,SOL_SOCKET,SO_TYPE",
    "if(fd==7)continue", "shutdown(7,SHUT_WR)",
    "read(7,&exit_byte,1)",
):
    if marker not in compact_fixture:
        raise SystemExit(
            f"ii-b5b-ii-c physical spawn fixture drifted: {marker}"
        )
for label, test in (("focused", focused), ("composer", composer_test)):
    if test.count("@Test") == 0 or "#expect" not in test:
        raise SystemExit(f"ii-b5b-ii-c {label} test became vacuous")
for marker in (
    "InvestigationMachineDarwinEpochSession.swift",
    "POSIX_SPAWN_SETPGROUP | POSIX_SPAWN_CLOEXEC_DEFAULT",
    "InvestigationMachineDarwinEpochRetirementOwning",
):
    if marker not in boundary:
        raise SystemExit(f"ii-b5b-ii-c boundary test drifted: {marker}")
