function verify_iib5biii_b2b1a0_scope() {
    local baseline=${1:-d643b8fd500be29736a962dcd0c270304b490828}
    local implementation_tree=f9322fa0c71910ca96a44cf6d3a7f70e3245f1fa
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpochComposition.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpochPhysicalBridge.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinOuterInnerProtocolTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineSingleEpochPhysicalBridgeTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 8 )) || {
        print -u2 "iii-b2b-1a-0 checkpoint path ceiling drifted"; return 1
    }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == \
        d643b8fd500be29736a962dcd0c270304b490828 ]] || {
        print -u2 "iii-b2b-1a-0 checkpoint baseline drifted"; return 1
    }
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "iii-b2b-1a-0 checkpoint deleted an existing path"; return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "iii-b2b-1a-0 binary checkpoint path rejected"; return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "iii-b2b-1a-0 staged checkpoint paths drifted"; return 1
    }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644
        [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $expected_path" ]] || {
            print -u2 "iii-b2b-1a-0 checkpoint mode drifted: $expected_path"
            return 1
        }
    done
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 2200 )) || {
        print -u2 "iii-b2b-1a-0 checkpoint budget drifted"; return 1
    }
    local preflight=docs/reports/phase-d-task-39b2c-l3c3c-ii-b5b-iii-b2b-1a-outer-observation-preflight.md
    git diff --cached --name-only --diff-filter=ACMRD "$baseline" \
        | grep -Fxq -- "$preflight" || {
        print -u2 "iii-b2b-1a-0 required preflight document missing"; return 1
    }
    [[ "$(git write-tree)" == "$implementation_tree" ]] || {
        print -u2 "iii-b2b-1a-0 completed tree drifted"
        return 1
    }
    (( changed == 1336 )) || {
        print -u2 "iii-b2b-1a-0 implementation line count drifted"
        return 1
    }
}

