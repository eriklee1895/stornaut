        /usr/bin/xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source" \
            || return $?
    done
    /usr/bin/python3 -I - "${p[@]}" <<'PY'
from pathlib import Path
import sys
if len(sys.argv) != 5:
    raise SystemExit("ii-c-c suspended-sudo source cardinality drifted")
