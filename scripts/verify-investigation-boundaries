    r'\b(?:write|writev|pwrite|pwritev|creat|truncate|ftruncate)\s*\('
    r'|\bO_(?:WRONLY|RDWR|CREAT|TRUNC|APPEND)\b', source,
):
    raise SystemExit("ii-b5b-i-b2a write authority drifted")
safe_open = re.compile(
    r'var flags = O_RDONLY \| O_CLOEXEC \| O_NOFOLLOW \| O_NONBLOCK\s*'
    r'if kind == \.directory \{\s*flags \|= O_DIRECTORY\s*\}\s*'
    r'let descriptor = Darwin\.open\(url\.path, flags\)', re.DOTALL,
)
