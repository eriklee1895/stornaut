    raise SystemExit("ii-b5b-i-c2a lifecycle post-teardown contract drifted")

for marker in (
    "InvestigationLifecycleTopologyObserving","DarwinInvestigationLifecycleTopologyObserver",
    "installedTopologyUnproved","installedTopology","provesInstalledTopology",
    "phase: .installed","DarwinFixedLifecycleServiceProbe",
):
    if marker in collector: raise SystemExit("ii-b5b-i-c2a collector installed branch remains")
for marker in (
    "protocol InvestigationLifecyclePostTeardownObserving: Sendable",
    "struct DarwinInvestigationLifecyclePostTeardownObserver:",
    "any InvestigationLifecyclePostTeardownObserving",
):
    if marker not in collector: raise SystemExit("ii-b5b-i-c2a collector post-teardown contract drifted")
