function verify_claim_server_package_contract() {
    local describe_json=$1
    local dump_json=$2
    python3 - "$describe_json" "$dump_json" <<'PY'
import json
from pathlib import Path
import sys

package = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
manifest = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
targets = {target["name"]: target for target in package["targets"]}
server = targets.get("StornautInvestigationMachineClaimServer")
if server is None:
    raise SystemExit("missing StornautInvestigationMachineClaimServer target")
if Path(server.get("path", "")) != Path(
    "Sources/StornautInvestigationMachineClaimServer"
):
    raise SystemExit("machine claim server target path drifted")
if set(server.get("target_dependencies", [])) != {
    "StornautInvestigationHandoffContract", "StornautLifecycle",
}:
    raise SystemExit("machine claim server dependencies drifted")
if set(server.get("sources", [])) != {
    "InvestigationMachineClaimServerAdapter.swift",
    "InvestigationMachineClaimServerEffects.swift",
}:
    raise SystemExit("machine claim server source allowlist drifted")
products = [
    product for product in package.get("products", [])
    if "StornautInvestigationMachineClaimServer" in product.get("targets", [])
]
if len(products) != 1 or products[0].get("name") != (
    "StornautInvestigationMachineClaimServer"
):
    raise SystemExit("machine claim server product ownership drifted")
manifest_products = {product["name"]: product for product in manifest["products"]}
product = manifest_products.get("StornautInvestigationMachineClaimServer")
if (
    product is None
    or product.get("targets") != ["StornautInvestigationMachineClaimServer"]
    or product.get("type") != {"library": ["static"]}
):
    raise SystemExit("machine claim server static product drifted")
consumers = {
    target["name"] for target in package["targets"]
    if "StornautInvestigationMachineClaimServer"
    in target.get("target_dependencies", [])
}
if consumers != {"StornautInvestigationTests"}:
    raise SystemExit(f"machine claim server consumers drifted: {sorted(consumers)}")
if "StornautInvestigationHandoffContract" in set(
    targets["StornautLifecycle"].get("target_dependencies", [])
):
    raise SystemExit("Lifecycle gained HandoffContract dependency")
PY
}

function verify_live_claim_server_contract() {
    local project_source=$1
    local package_source=$2
    local handoff_root=$3
    local scheme_root=$4
    local lifecycle_source=$5
    local adapter_source=$6
    local effects_source=$7
    local helper_source=$8
    python3 - "$project_source" "$package_source" \
        "$handoff_root" "$scheme_root" "$lifecycle_source" \
        "$adapter_source" "$effects_source" "$helper_source" <<'PY'
import hashlib
from pathlib import Path
import re
import sys

project_path, package_path, handoff_root, scheme_root, lifecycle_path, \
    adapter_path, effects_path, helper_path = map(Path, sys.argv[1:])


def read(path):
    return path.read_text(encoding="utf-8")


def code_only(source, label):
    output = list(source)
    index = 0
    block_depth = 0
    delimiter = None
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if delimiter is not None:
            if source.startswith(delimiter, index):
                width = len(delimiter)
                output[index:index + width] = " " * width
                delimiter = None
                index += width
            elif delimiter == '"' and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source):
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif source.startswith('"""', index):
            output[index:index + 3] = "   "
            delimiter = '"""'
            index += 3
        elif source[index] == '"':
            output[index] = " "
            delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or delimiter is not None:
        raise SystemExit(f"live claim server {label} has unterminated text")
    return "".join(output)


def declaration(source, pattern, label, flags=re.MULTILINE | re.DOTALL):
    match = re.search(pattern, source, flags)
    if match is None:
        raise SystemExit(f"live claim server {label} drifted")
    opening = source.find("{", match.end())
    if opening < 0:
        raise SystemExit(f"live claim server {label} has no body")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    raise SystemExit(f"live claim server {label} is unterminated")


def require(source, patterns, label):
    diagnostic = {
        "physical clock": "live claim server physical clock drifted",
        "physical scheduler": "live claim server physical scheduler drifted",
        "physical terminal": "live claim server physical terminal drifted",
    }.get(label, f"live claim server {label} drifted")
    for pattern in patterns:
        if re.search(pattern, source, re.MULTILINE | re.DOTALL) is None:
            raise SystemExit(f"{diagnostic}: {pattern}")


def compact(source):
    return re.sub(r"\s+", "", source)


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


expected_frozen = {
    scheme_root / "Stornaut.xcscheme": "5d0d87082e3c0efed4165566e13f4fa560906137785c61a55b25d63a8ab2d987",
    scheme_root / "StornautInvestigationDiagnosticApp.xcscheme": "deb1b2fe0db76a7981759fcff865da270ceedc990ad78858e444f9eed3fe96b5",
    handoff_root / "HandoffBinaryTranscript.swift": "dd286134478b715f51f190ec4cdbc3cf10449b330ddb60b11cc06777a4a5a7c9",
    handoff_root / "InvestigationCohortCapsuleContract.swift": "d08046025cbebe320161732883d89dbaf710f1073d0a41ca3254e4eea828e437",
    handoff_root / "InvestigationHandoffEpochBootstrapContract.swift": "c295fdefeea11ffc767fc45865a87b5b399cf2ca51b877c5425ed30ed86100fd",
    handoff_root / "InvestigationHandoffFrameContract.swift": "33bf13d57d4acfc621cf7a5baf7ca3deaa8819d1c723573039ae91f07a21b4d9",
    handoff_root / "InvestigationMachineClaimContract.swift": "1b01315aaf822ac126d7d4a7391d7af3c93efcf444892d73ac0f88642dc4f352",
}
package = read(package_path)
later_driver_support_dependency = '                "CInvestigationIdentitySupport",\n'
driver_support_target = re.search(
    r'        \.target\(\n            name: "StornautInvestigationMachineDriverSupport",'
    r'(.*?)\n        \),',
    package,
    re.DOTALL,
)
if (
    driver_support_target is None
    or driver_support_target.group(1).count(later_driver_support_dependency) != 1
):
    raise SystemExit(
        "live claim server later DriverSupport C dependency drifted"
    )
historical_package = package.replace(later_driver_support_dependency, "", 1)
later_installed_l2_target = '''        .target(
            name: "StornautInvestigationInstalledL2",
            dependencies: [
                "CInvestigationIdentitySupport",
                "StornautInvestigationHandoffContract",
            ],
            linkerSettings: [
                .linkedFramework("Security"),
                .linkedFramework("ServiceManagement"),
            ]
        ),
'''
if historical_package.count(later_installed_l2_target) != 1:
    raise SystemExit("live claim server later InstalledL2 target drifted")
historical_package = historical_package.replace(later_installed_l2_target, "", 1)
later_c_target = '''        .target(
            name: "CInvestigationIdentitySupport",
            path: "Sources/CInvestigationIdentitySupport",
            publicHeadersPath: "include",
            linkerSettings: [
                .linkedLibrary("bsm"),
            ]
        ),
'''
if historical_package.count(later_c_target) != 1:
