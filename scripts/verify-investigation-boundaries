    if canonical[mutation_slot].count(old) != 1 or sources[mutation_slot] != canonical[mutation_slot].replace(old, new, 1):
        raise SystemExit("ii-c-b2a2 unrecognized mutation")
    for slot in slot_names:
        if slot != mutation_slot and sources[slot] != canonical[slot]:
            raise SystemExit("ii-c-b2a2 mutation changed another source")

package, contract, writer, evidence, boundary, verifier = (sources[name] for name in slot_names)
