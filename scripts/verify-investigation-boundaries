    "package static let maximumByteCount = 512",
    "HandoffBinaryTranscript.encode(", "HandoffBinaryTranscript.decode(",
    "repeating: 0,", "try value.encoded() == data",
    "guard InvestigationHandoffSHA256.hashing(zeroed)\n"
    "                == completionSHA256",
    "struct InvestigationMachineZeroArgumentRoleSelector",
    "struct InvestigationMachineZeroArgumentOutputWriter",
    "struct InvestigationMachineZeroArgumentEntry",
    "static func production(", "func run() async throws",
    "InvestigationMachineInstalledDriverObserver(",
    "InvestigationMachineFixedCapsuleIntake().read()",
    "InvestigationMachineEightEpochCohort(",
    "InvestigationMachineDarwinOuterInnerExecutionFactory()",
    "InvestigationMachineDarwinOuterInnerComposition()", ".runInner()",
    "checkCancellation: {", "guard !Task.isCancelled else",
    "Darwin.write(descriptor, bytes.baseAddress, bytes.count)",
    "node.inode > 0 && node.fileType != 0",
    "try requireBeforeDeadline(deadline.partialValue)",
)
if any(marker not in entry for marker in entry_required):
    fail("iii-b2b-1b fixed production composition drifted")
for call, count in {
    "fcntl": 6, "fstat": 2, "isatty": 1, "tcgetpgrp": 1,
    "poll": 1,
}.items():
    if len(re.findall(rf"\b{call}\s*\(", entry)) != count:
        fail(f"iii-b2b-1b fixed Darwin call drifted: {call}")
if entry.count("Darwin.write(") != 1:
    fail("iii-b2b-1b bounded stdout authority drifted")
if "node.deviceID > 0 && node.inode > 0" in entry:
    fail("iii-b2b-1b fixed production composition drifted")
if entry.count("case .cancelled: return .containmentUncertain") != 2:
    fail("iii-b2b-1b cancellation precedence drifted")
if entry.count("if offset == data.count { return }") != 1:
    fail("iii-b2b-1b final output commitment drifted")
if entry.count("try requireBeforeDeadline(deadline.partialValue)") != 2:
    fail("iii-b2b-1b output deadline drifted")
for descriptor in ("STDIN_FILENO", "STDOUT_FILENO", "STDERR_FILENO"):
    if descriptor not in entry:
        fail("iii-b2b-1b fixed descriptor admission drifted")
for marker in ("requireAbsent(7)", "requireAbsent(8)", "requireAbsent(9)"):
    if marker not in entry:
        fail("iii-b2b-1b fixed descriptor admission drifted")
run_start = entry.index("    func run() async throws")
run_end = entry.index("    private static func knownOrUncertain(", run_start)
run = entry[run_start:run_end]
cursor = 0
for marker in (
    "dependencies.validateInvocation()", "dependencies.selectRole()",
    "dependencies.observeInstalledDriver()", "dependencies.readPlan()",
    "dependencies.prepareEvidencePlan(plan)",
    "dependencies.runCohort(boundPlan)",
    "dependencies.finishEvidenceCollection(summary)",
    "dependencies.checkCancellation()",
    "dependencies.revalidateOuter(observation)",
    "dependencies.writeEvidence(evidence)",
    "InvestigationMachineDriverCompletionArtifact(",
    "dependencies.writeArtifact(encoded)",
):
    index = run.find(marker, cursor)
    if index < 0:
        fail("iii-b2b-1b outer operation ordering drifted")
    cursor = index + len(marker)

for marker in (
    "exitStatusesMatchTheFrozenDriverContract",
    "DriverSupportInvalidInvocation.allCases",
    "runtimeMapsEveryEntryFailureWithoutInvokingTheDriver",
    "DriverSupportStatusScenario.allCases",
    "runtimeReturnsSuccessOnlyAfterTheInjectedEntryCompletes",
):
    if marker not in support_test:
        fail("iii-b2b-1b facade tests became vacuous")
for marker in (
    "completionArtifactMatchesIndependentGoldenAndZeroBeforeHash",
    "completionArtifactRejectsEveryEncodingMutation",
    "CompletionEncodingMutation.allCases",
    "roleSelectorPreparesAndRevalidatesExactOuterDescriptors",
    "roleSelectorRejectsAmbiguousOrInvalidShape",
    "InvalidRoleShape.allCases",
    "failureBeforeOutputCommitsNoArtifact",
    "outputWriterUsesFixedDescriptorAndDeadline",
    "outputWriterRetriesWaitsAndShortWritesExactly",
    "outputWriterRejectsDeadlineWaitAndWriteFailures",
    "outputWriterDoesNotRecheckLateCancellation",
    "darwinAnonymousPipeIdentityIsAdmittedAsOuterOutput",
    "compositionCancellationCannotMaskContainmentUncertainty",
    "completedFinalWriteIsNotReclassifiedByALateClockSample",
    "deadlineAfterReadiness", "deadlineAfterPartialWrite",
):
    if marker not in entry_test:
        fail("iii-b2b-1b focused tests became vacuous")
for marker in (
    "iiiB2B1BIIVerifierPinsZeroArgumentEntryAndMutableScope",
    "--iib5biii-b2b1b-zero-entry-contract-only",
    "--iib5biii-b2b1b-staged-scope-contract-only",
    "--iib5biii-b2b1b-source-contract-only",
