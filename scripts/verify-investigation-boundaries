        exit 64
    fi
fi

function verify_app_peer_admission_contract() {
    local policy_source=$1
    local adapter_source=$2
    python3 - "$policy_source" "$adapter_source" <<'PY'
from pathlib import Path
import hashlib
import re
import sys

policy_path, adapter_path = map(Path, sys.argv[1:])
policy = policy_path.read_text(encoding="utf-8")
adapter = adapter_path.read_text(encoding="utf-8")
compact_policy = re.sub(r"\s+", "", policy)
compact_adapter = re.sub(r"\s+", "", adapter)

required_policy = (
    "package struct LifecycleMachineDriverPeerAdmissionEvidence",
    "package func authorizeAndObserveStableEvidence(",
    "authorizeAndObserveStableEvidence(identity) != nil",
    "This is current-peer evidence, not installer-authenticated provenance.",
    "signingEvidence(contract.machineDriverExecutableURL) == staticEvidence",
    "codeSigningVerifier.verify(",
    "signingEvidence: staticEvidence",
)
missing = [
    value for value in required_policy
    if re.sub(r"\s+", "", value) not in compact_policy
]
if missing:
    raise SystemExit(f"App peer admission policy drifted: {missing!r}")
for forbidden in (
    "public struct LifecycleMachineDriverPeerAdmissionEvidence",
    "public func authorizeAndObserveStableEvidence(",
    "expectedExecutableSHA256",
    "expectedEvidence:",
):
    if forbidden in policy:
        raise SystemExit(f"App peer admission trust surface widened: {forbidden}")

required_adapter = (
    "#if DEBUG",
    "package actor InvestigationHandoffAppLeafAdapter",
    "package static let fixedDescriptor: Int32 = 7",
    "bootstrapWindowNanoseconds: UInt64 = 5_000_000_000",
    "maximumEpochWindowNanoseconds: UInt64 = 140_000_000_000",
    "LOCAL_PEERTOKEN",
    ".authorizeAndObserveStableEvidence($0)",
    "identity = try system.peerIdentity(Self.fixedDescriptor)",
    "bytes = try await system.readExactly(",
    "observedAt < bootstrapDeadline.partialValue",
    "observedAt < bootstrap.epochDeadlineNanoseconds",
    "bootstrap.epochDeadlineNanoseconds <= maximumDeadline.partialValue",
    "frame.kind.direction == .driverToApp",
    "frame.sender == observation.driverClaim",
    "frame.kind.direction == .appToDriver",
    "frame.sender == currentClaim",
    "system.initializeGroups(identity.username, identity.groupID) == 0",
    "system.setGroupID(identity.groupID) == 0",
    "system.setUserID(identity.userID) == 0",
    "system.attemptSetUserID(0)",
    "system.attemptSetEffectiveUserID(0)",
    "system.attemptSetGroupID(0)",
    "regainUser == EPERM",
    "regainEffective == EPERM",
    "regainGroup == EPERM",
    "private var ioInProgress = false",
    "!ioInProgress,",
    "guard try system.continuousNanoseconds() < peerObservation.bootstrap.epochDeadlineNanoseconds",
    "private var terminalFailure = false",
    "withTaskCancellationHandler",
    "withCheckedThrowingContinuation",
    "shutdown(descriptor, SHUT_RDWR)",
    "MSG_DONTWAIT | MSG_NOSIGNAL",
    "PROC_PIDTBSDINFO",
)
missing = [
    value for value in required_adapter
    if re.sub(r"\s+", "", value) not in compact_adapter
]
if missing:
    raise SystemExit(f"App peer adapter contract drifted: {missing!r}")
for forbidden in (
    "DispatchSemaphore", "dispatch_semaphore", "Codable", "FileManager",
    "Process(", "NSXPCConnection", "URLSession", "CodexInteractiveAppServer",
    "prepareRoot", "EvidenceStore", "ProbeBroker", "ActionExecutor",
    "Cleanup", "Trash", "RegisteredAction", "signedRuntimeReady",
    "signedInvestigationRuntimeReady", "CommandLine.arguments",
    "ProcessInfo.processInfo.environment", "expectedExecutableSHA256",
):
    if forbidden in adapter:
        raise SystemExit(f"App peer adapter gained prohibited surface: {forbidden}")

deadline = adapter.find("guard try system.continuousNanoseconds()")
initgroups = adapter.find("system.initializeGroups(identity.username, identity.groupID) == 0")
setgid = adapter.find("system.setGroupID(identity.groupID) == 0")
setuid = adapter.find("system.setUserID(identity.userID) == 0")
if min(deadline, initgroups, setgid, setuid) < 0 or not (deadline < initgroups < setgid < setuid):
    raise SystemExit("App peer adapter credential-drop order drifted")
peer = adapter.find("identity = try system.peerIdentity(Self.fixedDescriptor)")
first_read = adapter.find("bytes = try await system.readExactly(")
if peer < 0 or first_read < 0 or peer >= first_read:
    raise SystemExit("App peer admission no longer precedes first byte")
if not adapter.endswith("#endif\n"):
    raise SystemExit("App peer adapter Debug guard drifted")
PY
}

function verify_iib4_driver_support_contract() {
    local package_manifest=$1
    local client_source=$2
    python3 - "$package_manifest" "$client_source" <<'PY'
from pathlib import Path
import hashlib
import re
import sys

package_manifest = Path(sys.argv[1]).read_text(encoding="utf-8")
source = Path(sys.argv[2]).read_text(encoding="utf-8")
if re.search(r"//|/\*|\*/", source):
    raise SystemExit("ii-b4 driver support source contains comment camouflage")

target_match = re.search(
    r'(?ms)\.target\(\s*name:\s*"StornautInvestigationMachineDriverSupport"\s*,'
    r'(?P<body>.*?)\n\s*\)',
    package_manifest,
)
if target_match is None:
    raise SystemExit("ii-b4 driver support package dependency drifted")
target_body = target_match.group("body")
dependencies = re.search(
    r'(?ms)dependencies:\s*\[(?P<body>.*?)\]', target_body
)
if dependencies is None or re.findall(
    r'"([^"]+)"', dependencies.group("body")
) != ["StornautInvestigationHandoffContract"]:
    raise SystemExit("ii-b4 driver support package dependency drifted")
if '.linkedFramework("Security")' not in target_body:
    raise SystemExit("ii-b4 static/dynamic audit-token binding drifted")

required_markers = (
    'fixedLifecycleProgram',
    '"com.eriklee.stornaut.lifecycle.helper"',
    'transport.connect(',
    'serviceName: Constants.machineClaimServiceIdentifier',
    'codeSigningRequirement:',
    'let connection = NSXPCConnection(',
    'connection.setCodeSigningRequirement(codeSigningRequirement)',
    'proxy.claimMachineRetirement(request)',
    'proxy.releaseMachineRetirement(request)',
    'func invalidate() async',
    'await session.invalidate()',
    'auditTokenWords: [UInt32]',
    'guard auditTokenWords.count == 8 else',
    'kSecGuestAttributeAudit',
    'kSecGuestAttributeAudit: tokenData as CFData',
    'SecCodeCopyGuestWithAttributes(',
    'SecCodeCopyPath(',
    'currentConnectionIdentity()',
    'helperEpochObserver.observe(',
    '.originalHelperAbsent',
    'connection.invalidationHandler =',
    'connection.interruptionHandler =',
    'withTaskCancellationHandler',
    'guard epoch.beginDispatch(resolver) else',
    'previousHelperIdentity != evidence.helperIdentity',
    'replyObservation.continuousNanoseconds\n                    < claimedState.evidence.releaseDeadlineNanoseconds,',
    'try released.validateEcho(of: release)',
    'try await confirmHelperEpochTransition(',
    'await claimedState.session.invalidate()',
    'throw InvestigationMachineClaimClientError.outcomeUnknown',
    'try machineClaimContinuousNanoseconds()',
)
missing = [marker for marker in required_markers if marker not in source]
if missing:
    raise SystemExit(f"ii-b4 driver support contract drifted: {missing!r}")

if source.count('serviceName: Constants.machineClaimServiceIdentifier') not in (2, 3):
    raise SystemExit("ii-b4 fixed helper service drifted")
if 'InvestigationMachineInstalledDriverObservation.fixedLifecycleProgram' not in source:
    raise SystemExit("ii-b4 fixed helper path drifted")
if 'import StornautLifecycle' in source or 'LifecycleSupervisorXPCClient' in source:
    raise SystemExit("ii-b4 broad lifecycle machine-claim client remains")
if source.count('proxy.claimMachineRetirement(request)') != 1 or source.count('proxy.releaseMachineRetirement(request)') != 1:
    raise SystemExit("ii-b4 exact claim/release selector drifted")
if source.count('let connection = NSXPCConnection(') != 1:
    raise SystemExit("ii-b4 fixed claim connection cardinality drifted")
if 'observation.signingIdentifier == Constants.helperSigningIdentifier' not in source:
    raise SystemExit("ii-b4 fixed helper signing identifier drifted")
if source.count(
    'let dynamicObservation = try dynamicHelperIdentityReader.readHelperIdentity(\n'
    '            auditTokenWords: evidence.helperIdentity.auditTokenWords\n'
    '        )'
) != 1:
    raise SystemExit("ii-b4 static/dynamic audit-token binding drifted")
for marker in (
    'processIDVersion',
    'auditSessionID',
    'executablePath',
    'isAdHoc',
):
    if marker not in source:
        raise SystemExit("ii-b4 static/dynamic audit-token binding drifted")
if (
    'while current < deadline' not in source
    or 'afterObservation < deadline' not in source
    or 'if observation == .originalHelperAbsent { return }\n            let next = min(' not in source
    or 'afterObservation.addingReportingOverflow(100_000_000)' not in source
    or 'sampled <= deadline' not in source
):
    raise SystemExit("ii-b4 helper absence handling drifted")
if source.count('throw InvestigationMachineClaimClientError.outcomeUnknown') < 20:
    raise SystemExit("ii-b4 outcomeUnknown priority drifted")
if source.count('await session.invalidate()') < 1 or source.count('await claimedState.session.invalidate()') < 2:
    raise SystemExit("ii-b4 delayed invalidation drifted")
claim_dispatch = source.find('reply = try await session.claim(')
claim_publish = source.find('state = .claimed(', claim_dispatch)
first_claim_invalidation = source.find('await session.invalidate()')
release_identity = source.find(
    'try await validateConnectionIdentity(\n'
    '                    session: claimedState.session,',
    claim_publish
)
release_observation = source.find(
    'let releaseObservation = try clock.observe()',
    release_identity
)
release_dispatch = source.find(
    'reply = try await claimedState.session.release(', release_observation
)
release_echo = source.find('try released.validateEcho(of: release)', release_dispatch)
reply_observation = source.find('replyObservation = try clock.observe()', release_echo)
absence = source.find('try await confirmHelperEpochTransition(', reply_observation)
success_invalidation = source.find(
    'await claimedState.session.invalidate()', absence
)
if (
    min(claim_dispatch, claim_publish, first_claim_invalidation,
        release_identity, release_observation, release_dispatch,
        release_echo, reply_observation, absence, success_invalidation) < 0
    or not (claim_dispatch < claim_publish < release_identity
        < release_observation < release_dispatch < release_echo
        < reply_observation < absence < success_invalidation)
    or first_claim_invalidation < claim_publish
    or source.find('await session.invalidate()', claim_dispatch, claim_publish) >= 0
):
    raise SystemExit("ii-b4 delayed invalidation drifted")
connect_index = source.find('let connection = NSXPCConnection(')
requirement_index = source.find(
    'connection.setCodeSigningRequirement(codeSigningRequirement)',
    connect_index
)
activate_index = source.find('connection.activate()', requirement_index)
if min(connect_index, requirement_index, activate_index) < 0 or not (
    connect_index < requirement_index < activate_index
):
    raise SystemExit("ii-b4 static/dynamic audit-token binding drifted")

for forbidden in (
    'import StornautLifecycle',
    'LifecycleSupervisorXPCClient',
    'LifecycleInteractiveSessionXPCClient',
    'ProcessInfo.processInfo.environment',
    'URLSession',
    'socket(',
    'Darwin.write(',
    'kill(',
    'posix_spawn',
    'FileManager.default',
    'signedInvestigationRuntimeReady',
):
