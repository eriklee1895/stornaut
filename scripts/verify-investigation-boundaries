        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 9 )) || { print -u2 "ii-b5b-ii-b checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" \
        == b7ade4476fc18c3f38683168f8a1488eabd9824d ]] || { print -u2 "ii-b5b-ii-b checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" | grep -q .; then print -u2 "ii-b5b-ii-b checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "ii-b5b-ii-b binary checkpoint path rejected"
        return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || { print -u2 "ii-b5b-ii-b checkpoint paths drifted"; return 1; }
    local changed=$(git diff --cached --numstat "$baseline" \
