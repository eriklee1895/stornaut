def swift_code(source):
    output=[]; index=0; block=0
    while index < len(source):
        if block:
            if source.startswith("/*", index): block += 1; index += 2
            elif source.startswith("*/", index): block -= 1; index += 2
            else:
                output.append("\n" if source[index] == "\n" else " ")
                index += 1
            continue
        if source.startswith("//", index):
            end=source.find("\n", index)
            if end < 0: output.extend(" " * (len(source)-index)); break
            output.extend(" " * (end-index)); index=end; continue
        if source.startswith("/*", index):
            block=1; output.extend("  " ); index += 2; continue
        if source[index] == '"':
            output.append(" " ); index += 1
            while index < len(source):
                char=source[index]
                output.append("\n" if char == "\n" else " ")
                index += 1
                if char == "\\" and index < len(source):
                    output.append(" " ); index += 1
                elif char == '"': break
            continue
        output.append(source[index]); index += 1
    if block: raise SystemExit("ii-c-c suspended-sudo unterminated comment")
    return "".join(output)
