function verify_iib5bic2a_legacy_owner_contract() {
    local lifecycle_source=$1
    local collector_source=$2
    local service_probe_source=$3
    local scenario_driver_source=$4
    local installed_owner_source=$5
    local installed_join_source=$6
    local focused_test_source=$7
    local production_source_root=${8:-Sources}
    local inputs=(
        "$lifecycle_source" "$collector_source" "$service_probe_source"
        "$scenario_driver_source" "$installed_owner_source"
        "$installed_join_source" "$focused_test_source"
    ) source
    for source in "${inputs[@]}"; do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source" \
            || return $?
    done
    python3 - "${inputs[@]}" "$production_source_root" <<'PY' || return $?
from pathlib import Path
import hashlib,re,sys
paths=list(map(Path,sys.argv[1:8]))
source_root=Path(sys.argv[8])
repository_root=source_root.parent
lifecycle,collector,probe,scenario,owner,join,focused_test=[p.read_text(encoding="utf-8") for p in paths]

def compact(value): return re.sub(r"\s+","",value)
def declaration(value, pattern, label):
    match=re.search(pattern,value,re.MULTILINE)
    if match is None: raise SystemExit(f"ii-b5b-i-c2a {label} drifted")
    opening=value.find("{",match.end())
    depth=0
    for index in range(opening,len(value)):
        if value[index]=="{": depth+=1
        elif value[index]=="}":
            depth-=1
            if depth==0: return value[match.start():index+1]
    raise SystemExit(f"ii-b5b-i-c2a {label} drifted")

service_result=declaration(lifecycle,r"^package enum LifecycleRootTopologyServiceProbeResult\b","lifecycle service surface")
