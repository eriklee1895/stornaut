function verify_iib5biii_b2a_iia1v_scope() {
    local baseline=${1:-72d506de45deccb0cc0d6337b04a8f0e7ad751eb}
    local implementation_tree=a66564f527004ea7065b5f6ffeca05a9c12e5fac
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinDriverChildObservation.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinOuterInnerSession.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinOuterInnerSessionTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 7 )) \
        || { print -u2 "iii-b2a-ii-a1-v checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" \
        == 72d506de45deccb0cc0d6337b04a8f0e7ad751eb ]] \
        || { print -u2 "iii-b2a-ii-a1-v checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "iii-b2a-ii-a1-v checkpoint deleted an existing path"
        return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "iii-b2a-ii-a1-v binary checkpoint path rejected"
        return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] \
        || { print -u2 "iii-b2a-ii-a1-v staged checkpoint paths drifted"; return 1; }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644
        [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $expected_path" ]] \
            || { print -u2 "iii-b2a-ii-a1-v checkpoint mode drifted: $expected_path"; return 1; }
    done
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 2400 )) \
        || { print -u2 "iii-b2a-ii-a1-v checkpoint budget drifted"; return 1; }
    local documentation=(${(f)"$(git diff --cached --name-only \
        --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")==1')"})
    local preflight=docs/reports/phase-d-task-39b2c-l3c3c-ii-b5b-iii-b2a-ii-a1-v-verifier-preflight.md
    (( ${documentation[(Ie)$preflight]} == 1 )) \
        || { print -u2 "iii-b2a-ii-a1-v required preflight document missing"; return 1; }
    [[ "$(git write-tree)" == "$implementation_tree" ]] \
        || { print -u2 "iii-b2a-ii-a1-v completed tree drifted"; return 1; }
}

