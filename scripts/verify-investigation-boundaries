    r"\b(?:O_WRONLY|O_RDWR|O_CREAT|O_TRUNC|O_APPEND)\b",
    r"\b(?:Cleanup|Executor|MoveToTrash|TrashMoving|RegisteredAction|StornautExecution)\b",
