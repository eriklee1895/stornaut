    package_path: "acb012b94533a6cb437501e09d3414b07b36a80767daf6fa742be96d3b3bb51d",
    semantic_path: "d09b907d2fe5309827a0a2a2339d3e74f30c49dca7ac721c4a1a13e91f8e473c",
    test_path: "82fb444b3d99a27414829b8ce959ccf3042f1d83267fe60fb1b7da12336d8e78",
}
for path, expected_sha in expected.items():
    data = path.read_bytes()
    if path == package_path and hashlib.sha256(data).hexdigest() != expected_sha:
        current = (
            b'        .target(\n'
            b'            name: "StornautInvestigationInstalledL2",\n'
            b'            dependencies: [\n'
            b'                "CInvestigationIdentitySupport",\n'
            b'                "StornautInvestigationHandoffContract",\n'
