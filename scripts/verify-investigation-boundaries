function verify_iib5biii_b1_cohort_contract() {
    local cohort_source=$1 continuity_source=$2 focused_test_source=$3
    local boundary_test_source=$4
    for source in "$cohort_source" "$continuity_source" \
        "$focused_test_source" "$boundary_test_source"; do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source"
    done
    python3 - "$cohort_source" "$continuity_source" \
        "$focused_test_source" "$boundary_test_source" <<'PY'
from pathlib import Path
import hashlib
import re
import sys

cohort_path, continuity_path, test_path, boundary_path = map(
    Path, sys.argv[1:]
)
cohort = cohort_path.read_text(encoding="utf-8")
continuity = continuity_path.read_text(encoding="utf-8")
test = test_path.read_text(encoding="utf-8")
boundary = boundary_path.read_text(encoding="utf-8")

def fail(message):
    raise SystemExit(message)

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

if imports(cohort) != {"Foundation", "StornautInvestigationHandoffContract"}:
    fail("iii-b1 dependency surface drifted")
if imports(continuity) != {"Foundation", "StornautInvestigationHandoffContract"}:
    fail("iii-b1 continuity dependency surface drifted")
semantic = cohort + continuity
if re.search(r"(?m)^\s*(?:public|open)\s+", semantic):
    fail("iii-b1 public surface drifted")
for marker in (
    "package enum InvestigationMachineEightEpochCohortError",
    "protocol InvestigationMachineEightEpochPlan: Sendable",
    "package protocol InvestigationMachineEightEpochExecutionFactory",
    "package final class InvestigationMachineEightEpochExecution",
    "package struct InvestigationMachineEightEpochCompletionSummary",
    "package actor InvestigationMachineEightEpochCohort",
    "package func run() async throws",
    "package func destroyAfterFinal(",
):
    if marker not in semantic:
        fail(f"iii-b1 package/internal surface drifted: {marker}")

authority_patterns = (
    r"\b(?:Codable|Encodable|Decodable)\b",
    r"\b(?:Darwin|Glibc|AppKit|SwiftUI)\b",
    r"\b(?:posix_spawn|posix_spawnp|fork|execve|system)\s*\(",
    r"\b(?:FileManager|FileHandle|URL|URLRequest|Path|URLSession|NSXPCConnection|Process)\b",
    r"\b(?:open|openat|creat|write|pwrite|truncate|ftruncate|rename|unlink|remove|mkdir|rmdir|chmod|chown|copyfile|clonefile|socket|socketpair|connect|bind|listen|accept|send|recv|kill|killpg|waitpid|waitid)\s*\(",
    r"\b(?:O_WRONLY|O_RDWR|O_CREAT|O_TRUNC|O_APPEND)\b",
    r"\b(?:fileDescriptor|descriptor|FD_CLOEXEC|STDIN_FILENO|PGID)\b",
    r"\b(?:CommandLine\.arguments|ProcessInfo\.processInfo\.environment|readLine)\b",
    r"\b(?:Executor|MoveToTrash|RegisteredAction|readiness|signedRuntimeReady|signedInvestigationRuntimeReady|implementationUnavailable)\b",
    r"\bStornaut(?:Execution|Core|Lifecycle|Codex|InvestigationRuntime|InvestigationDiagnostic|ProbeBridge|ProcessSupport)\b",
    r"(?m)^\s*@main\b",
)
for pattern in authority_patterns:
    if re.search(pattern, semantic, re.IGNORECASE):
        fail("iii-b1 authority or product reachability drifted")

run_start = cohort.index("package func run() async throws")
run_end = cohort.index("    private func validate(", run_start)
run = cohort[run_start:run_end]
for marker, message in (
    ("guard case .ready = state else", "iii-b1 one-shot state ordering drifted"),
    ("state = .running", "iii-b1 one-shot state ordering drifted"),
