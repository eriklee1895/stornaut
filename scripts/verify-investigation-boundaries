}

function verify_iib5a_staged_scope() {
    local baseline=${1:-HEAD}
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpoch.swift
        Tests/StornautInvestigationTests/InvestigationMachineSingleEpochTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0, "docs/") != 1')"})
    if git diff --cached --numstat "$baseline" | awk 'index($3, "docs/") != 1 && ($1 == "-" || $2 == "-") { found = 1 } END { exit !found }'; then
        print -u2 "ii-b5a binary checkpoint path rejected"; return 1
    fi
    if git diff --cached --name-status "$baseline" | awk '$1 == "D" && index($2, "docs/") != 1 { found = 1 } END { exit !found }'; then
        print -u2 "ii-b5a staged checkpoint deleted a required path"; return 1
    fi
    local required
    for required in "${expected[@]}"; do
        (( ${observed[(Ie)$required]} )) || { print -u2 "ii-b5a staged checkpoint deleted a required path"; return 1; }
    done
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || {
        print -u2 "ii-b5a checkpoint paths drifted"; return 1
    }
    local changed
    changed=$(git diff --cached --numstat "$baseline" | awk 'index($3, "docs/") != 1 {total += $1 + $2} END {print total + 0}')
    (( changed <= 1500 )) || { print -u2 "ii-b5a checkpoint budget drifted"; return 1; }
}

function verify_iib5biii_a_single_epoch_contract() {
    local single_epoch_source=$1 composition_source=$2 continuity_source=$3
    local continuity_test_source=$4 single_epoch_test_source=$5
    local installed_join_test_source=$6 boundary_test_source=$7
    for source in "$single_epoch_source" "$composition_source" \
        "$continuity_source" "$continuity_test_source" \
        "$single_epoch_test_source" "$installed_join_test_source" \
        "$boundary_test_source"; do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source"
    done
    python3 - "$single_epoch_source" "$composition_source" \
        "$continuity_source" "$continuity_test_source" \
        "$single_epoch_test_source" "$installed_join_test_source" \
        "$boundary_test_source" <<'PY'
from pathlib import Path
import hashlib
import re
import sys

paths = list(map(Path, sys.argv[1:]))
single, composition, continuity, continuity_test, single_test, installed_join_test, boundary = [
    path.read_text(encoding="utf-8") for path in paths
]

def fail(message):
    raise SystemExit(message)

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

if imports(single) != {"Foundation", "StornautInvestigationHandoffContract", "StornautInvestigationInstalledL2"}:
    fail("iii-a dependency surface drifted")
if imports(composition) != {"Foundation", "StornautInvestigationHandoffContract", "StornautInvestigationInstalledL2"}:
    fail("iii-a composition dependency surface drifted")
if imports(continuity) != {"Foundation", "StornautInvestigationHandoffContract"}:
    fail("iii-a continuity dependency surface drifted")

semantic = single + composition + continuity
if re.search(r"(?m)^\s*(?:public|open)\s+", semantic):
    fail("iii-a public continuity or configuration surface drifted")
for forbidden in (
    "Codable", "Encodable", "Decodable", "CommandLine.arguments",
    "ProcessInfo.processInfo.environment", "posix_spawn", "posix_spawnp",
    "fork(", "socketpair(", "kill(", "killpg(", "waitpid(", "waitid(",
    "setuid(", "setgid(", "initgroups(", "FileManager", "FileHandle",
    "Process(", "URLSession", "StornautExecution", "StornautLifecycle",
    "StornautCodex", "StornautCore", "StornautInvestigationRuntime",
    "StornautInvestigationDiagnostic", "signedRuntimeReady",
    "signedInvestigationRuntimeReady", "readFD0", "FD 0", "FD 8", "FD 9",
    "PGID",
):
    if forbidden in semantic:
        fail("iii-a authority or admission surface drifted")

required = {
    single: (
        "previousHelperIdentity: InvestigationMachineProcessIdentity?",
        "previousHelperIdentity: previousHelperIdentity",
        "claimOrProveTerminal(", "case localCompletion(",
        "case ownershipTransferred(",
        "InvestigationMachineSingleEpochOwnershipSuspending",
        "let ownershipResolution = await Task.detached {",
        "await suspender.suspend(ownership)",
        "claimReleaseAttempted = true", "return .localCompletion(try .init(",
        "guard localTeardownAuthority else { throw terminalError }",
        "previousHelperIdentity != evidence.helperIdentity",
        "outerAttemptUUID != UUID(",
        "wholeCapsuleSHA256.rawBytes.contains(where: { $0 != 0 })",
        "wholeInputSHA256.rawBytes.contains(where: { $0 != 0 })",
        "package init(\n        selection: InvestigationMachineFixedEpochSelection",
    ),
    composition: (
        "InvestigationMachineSingleEpochComposition",
        "commitment.wholeInputSHA256.rawBytes.contains(\n"
        "                where: { $0 != 0 }\n"
        "            ),",
        "let predecessorMaterial = try predecessor.consume(",
        "predecessorMaterial.previousHelperIdentity",
        "predecessor: predecessorMaterial",
        "composer.run(", "return try await outerJoin.seal(",
        "predecessorMaterial.previousHelperIdentity != currentHelper",
        "private var consumed = false",
    ),
    continuity: (
        "private init(", "package static func genesis(",
        "fileprivate static func successor(", "outerAttemptUUID",
        "wholeCapsuleSHA256", "wholeInputSHA256", "completedOrdinal",
        "helperIdentity", "completionBindingSHA256", "predecessorSHA256",
        "terminalProofSHA256",
        "predecessorSHA256 = predecessor.continuitySHA256",
        "proof.terminalProofSHA256.rawBytes.contains(",
        "try predecessor.consume(selection)",
        "ownership.outerAttemptUUID == selection.outerAttemptUUID",
        "ownership.wholeCapsuleSHA256",
        "ownership.wholeInputSHA256 == selection.wholeInputSHA256",
        "proof.completedOrdinal == completedOrdinal",
        "proof.helperIdentity == helperIdentity", "selection.epoch.ordinal == 0",
        "addingReportingOverflow(1)", "guard !consumed else", "Task.isCancelled",
        "terminalUncertain", "InvestigationMachineHelperEpochContinuity.successor(",
        "init(\n        selection: InvestigationMachineFixedEpochSelection,\n"
        "        result: InvestigationMachineSingleEpochResult,\n"
        "        predecessor: InvestigationMachineHelperEpochPredecessor,\n"
        "        terminalProofSHA256: InvestigationHandoffSHA256\n"
        "    ) throws {\n"
        "        guard terminalProofSHA256.rawBytes.contains(where: { $0 != 0 }) else {",
    ),
}

for source, markers in required.items():
    for marker in markers:
        if marker not in source:
            fail(f"iii-a semantic marker drifted: {marker}")

successor_transcript = (
    'domain:\n'
    '                    "stornaut.task39.machine.helper-continuity.successor",\n'
    '                businessFields: [\n'
    '                    continuityData(selection.outerAttemptUUID),\n'
    '                    selection.wholeCapsuleSHA256.rawBytes,\n'
    '                    selection.wholeInputSHA256.rawBytes,\n'
    '                    continuityData(selection.epoch.ordinal),\n'
    '                    continuityData(selection.epoch.epochUUID),\n'
    '                    try helperIdentity.encoded(),\n'
    '                    predecessor.continuitySHA256.rawBytes,\n'
    '                    proof.completionBindingSHA256.rawBytes,\n'
    '                    proof.terminalProofSHA256.rawBytes,\n'
    '                    Data([proof.mode.rawValue]),\n'
    '                ],\n'
    '                maximumByteCount: 4_096'
)
if continuity.count(successor_transcript) != 1:
    fail("iii-a successor transcript binding drifted")

if not single.index("let ownershipResolution = await Task.detached {") < single.index("claimReleaseAttempted = true") < single.index("return .localCompletion(try .init("):
    fail("iii-a ownership suspension or completion ordering drifted")
claim_start = single.index("evidence = try await createdClaimClient.claim(")
claim_end = single.index("claimSucceeded = true", claim_start)
claim_call = single[claim_start:claim_end]
if "previousHelperIdentity: previousHelperIdentity" not in claim_call or "previousHelperIdentity: nil" in claim_call:
    fail("iii-a predecessor identity propagation drifted")
if "guard (epoch.ordinal == 0) == (previousHelperIdentity == nil)" not in single:
    fail("iii-a ordinal/genesis guard drifted")
if "previousHelperIdentity != evidence.helperIdentity" not in single:
    fail("iii-a same-helper rejection drifted")
if "init(\n        epoch: InvestigationCohortEpoch" in single:
    fail("iii-a unbound commitment initializer returned")
if composition.index("composer.run(") > composition.index("return try await outerJoin.seal("):
    fail("iii-a successor mint moved before epoch composition")
outcome = continuity.index("let outcome = await Task.detached {")
if not outcome < continuity.index("guard case let .contained(proof) = outcome else {", outcome) < continuity.index("guard proof == expected else {", outcome) < continuity.index("guard !Task.isCancelled else {", outcome):
    fail("iii-a external containment outcome priority drifted")

for source, expected in (
    (continuity_test, "1b2d1e792b3aaea094ff0c737adc23b700c0a62cfc3edc7a23cc9188ff8b3844"),
    (single_test, "8c2b3e45a6a377d9ab13c418cdcd8b33501560cf3930b90bbe225d2b4f0bb2be"),
    (installed_join_test, "375a2265dcf42d9ea124f08945844203140542c7bf17362b964902d100524e58"),
