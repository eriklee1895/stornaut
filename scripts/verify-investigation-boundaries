function verify_iib5biii_b2a_iia2i_contract() {
    local session_source=$1 observer_source=$2 retirement_source=$3
    local session_test_source=$4 observer_test_source=$5
    local retirement_test_source=$6 boundary_test_source=$7
    local source
    for source in "$session_source" "$observer_source" \
        "$retirement_source" "$session_test_source" \
        "$observer_test_source" "$retirement_test_source" \
        "$boundary_test_source"
    do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source"
    done
    python3 - "$session_source" "$observer_source" \
        "$retirement_source" "$session_test_source" \
        "$observer_test_source" "$retirement_test_source" \
        "$boundary_test_source" <<'PY'
from pathlib import Path
import re
import sys

session_path, observer_path, retirement_path, session_test_path, \
observer_test_path, retirement_test_path, boundary_path = map(Path, sys.argv[1:])
session, observer, retirement, session_test, observer_test, retirement_test, boundary = (
    path.read_text(encoding="utf-8")
    for path in (
        session_path, observer_path, retirement_path, session_test_path,
        observer_test_path, retirement_test_path, boundary_path,
    )
)

def fail(message):
    raise SystemExit(f"iii-b2a-ii-a2-i {message}")

def declaration(source, pattern, label):
    match = re.search(pattern, source, re.MULTILINE)
    if match is None:
        fail(f"{label} drifted")
    opening = source.find("{", match.end())
    if opening < 0:
        fail(f"{label} drifted")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    fail(f"{label} drifted")

def compact(source):
    return re.sub(r"\s+", "", source)

semantic = session + observer
if re.search(r"(?m)^\s*(?:public|open)\s+", semantic):
    fail("topology policy drifted")
if re.search(r"\b(?:Codable|Encodable|Decodable)\b", semantic):
    fail("topology policy drifted")
for marker in (
    "StornautCore", "StornautExecution", "StornautLifecycle",
    "StornautInvestigationDiagnostic", "ActionPolicyGate",
    "CleanupPolicyGate", "CanonicalPathPolicy", "RegisteredAction",
    "MoveToTrash",
):
    if marker in semantic:
        fail("topology policy drifted")

policy = declaration(
    session, r"(?m)^enum InvestigationMachineDarwinEpochTopologyPolicy\b",
    "topology policy",
)
if (
    "case appOwnedProcessGroup" not in policy
    or "case inheritedInnerProcessGroup" not in policy
    or len(re.findall(r"(?m)^\s*case\s+", policy)) != 2
):
    fail("topology policy drifted")
authority = declaration(
    session,
    r"(?m)^private enum InvestigationMachineDarwinEpochRetirementAuthority\b",
    "topology policy",
)
for marker in (
    "case ownedProcessGroup(InvestigationMachineDarwinOwnedEpoch)",
    "case directChild(InvestigationMachineDarwinSpawnedEpoch)",
):
    if marker not in authority:
        fail("topology policy drifted")
if "topologyPolicy: InvestigationMachineDarwinEpochTopologyPolicy =" not in session \
    or ".appOwnedProcessGroup" not in session:
    fail("topology policy drifted")

factory = declaration(
    session, r"(?m)^actor InvestigationMachineDarwinEpochSessionFactory\b",
    "spawn contract",
)
factory_start = declaration(
    factory, r"(?m)^    func start\(", "spawn contract"
)
for marker in (
    "static let spawnFlags = Int16(",
