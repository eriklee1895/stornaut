function verify_iic0bi_producer_contract() {
    local author_path=$1 composition_path=$2 focused_test_path=$3
    local boundary_path=$4 source_path
    for source_path in "$author_path" "$composition_path" \
        "$focused_test_path" "$boundary_path"
    do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source_path"
    done
    python3 - "$author_path" "$composition_path" \
        "$focused_test_path" "$boundary_path" <<'PY'
from pathlib import Path
import re
import sys

author_path, composition_path, test_path, boundary_path = map(
    Path, sys.argv[1:]
)
author = author_path.read_text(encoding="utf-8")
composition = composition_path.read_text(encoding="utf-8")
focused_test = test_path.read_text(encoding="utf-8")
boundary = boundary_path.read_text(encoding="utf-8")

def fail(message):
    raise SystemExit(message)

lines = [line.strip() for line in author.splitlines() if line.strip()]
if not lines or lines[0] != "#if DEBUG" or lines[-1] != "#endif" \
        or lines.count("#if DEBUG") != 1 or lines.count("#endif") != 1:
    fail("ii-c0b-i author DEBUG boundary drifted")
imports = set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", author))
if imports != {
    "Foundation", "StornautInvestigation",
    "StornautInvestigationHandoffContract",
}:
    fail("ii-c0b-i dependency surface drifted")
if re.search(r"(?m)^\s*(?:public|open)\s+", author) or re.search(
    r"\b(?:Codable|Encodable|Decodable)\b", author
):
    fail("ii-c0b-i package-only or Codable surface drifted")
for marker in (
    "package struct InvestigationProjectedCohortInstalledBinding",
    "struct InvestigationProjectedCohortGeneratedIdentifiers",
    "let outerAttemptUUID: UUID",
    "let epochUUIDs: [UUID]",
    "package struct InvestigationProjectedCohortAuthor",
    "package init()",
    "package func author(",
    "configurationData: [Data]",
    "installedBinding: InvestigationProjectedCohortInstalledBinding",
    ".decodeMachineCohortValidated(",
    "canonicalJSONData()",
    "machineConfigurationSHA256()",
    "capabilityEvidenceBindingSHA256()",
    "InvestigationProjectedCohortInput(",
    "InvestigationHandoffScenarioMapping.handoffScenario(",
):
    if marker not in author:
        fail(f"ii-c0b-i producer semantic contract drifted: {marker}")
for field in (
    "appExecutableSHA256", "appBundleIdentifier",
    "helperExecutableSHA256", "helperServiceIdentifier",
    "machineDriverExecutableSHA256", "machineDriverSigningIdentifier",
    "machineDriverDesignatedRequirementSHA256",
    "machineDriverCodeDirectoryHash", "machineClaimServiceIdentifier",
):
    if author.count(field) < 2:
        fail(f"ii-c0b-i installed binding projection drifted: {field}")
binding = re.search(
    r"(?ms)^package struct InvestigationProjectedCohortInstalledBinding.*?^}\n",
    author,
)
if binding is None or re.search(r"\b(?:URL|path|descriptor)\b", binding.group(0), re.I):
    fail("ii-c0b-i installed binding gained path or descriptor surface")
top_level_types = re.findall(
    r"(?m)^(?:package|internal|public|open|private)?\s*"
    r"(?:enum|struct|class|actor)\s+([A-Za-z_][A-Za-z0-9_]*)", author
)
if top_level_types != [
    "InvestigationProjectedCohortAuthorError",
    "InvestigationProjectedCohortInstalledBinding",
    "InvestigationProjectedCohortGeneratedIdentifiers",
    "InvestigationProjectedCohortAuthor",
]:
    fail("ii-c0b-i producer gained premature production call site")
if re.search(r"package\s+(?:struct InvestigationProjectedCohortGeneratedIdentifiers|typealias (?:Clock|IdentifierProvider)|init\(\s*now:)", author):
    fail("ii-c0b-i injectable production constructor drifted")
if re.search(r"(?m)^(?:(?:package|internal)\s+)?(?:let|var)\s+", author):
    fail("ii-c0b-i producer gained premature production call site")
top_level_functions = re.findall(
    r"(?m)^(?:package|internal|public|open|private)?\s*func\s+"
    r"([A-Za-z_][A-Za-z0-9_]*)", author
)
if top_level_functions != ["lowercaseHexNibble"]:
    fail("ii-c0b-i producer gained premature production call site")
if re.findall(
    r"(?m)^(?:package|internal|public|open|private)?\s*extension\s+"
    r"([A-Za-z_][A-Za-z0-9_]*)", author
) != ["Data"] or author.count("private extension Data {") != 1:
    fail("ii-c0b-i producer gained premature production call site")
if "InvestigationProjectedCohortAuthor" in composition:
    fail("ii-c0b-i producer gained premature production call site")
mapping = re.findall(
    r"(?ms)^package enum InvestigationHandoffScenarioMapping.*?^}\n",
    composition,
)
if len(mapping) != 1 \
        or mapping[0].count("package static func handoffScenario(") != 1 \
        or mapping[0].count("switch scenario") != 1 \
        or re.search(r"\bswitch\s+scenario\b", author):
    fail("ii-c0b-i scenario mapping ownership drifted")
for scenario in (
    "success", "cancellation", "timeout", "invalidEnvelope",
    "identityMismatch", "transportLoss", "lifecycleRecovery",
    "artifactCleanupFailure",
):
    if mapping[0].count(f"case .{scenario}: .{scenario}") != 1:
        fail(f"ii-c0b-i scenario mapping drifted: {scenario}")
for forbidden in (
    r"import\s+(?:StornautExecution|StornautLifecycle|StornautProcessSupport)",
    r"\b(?:ActionExecutor|TrashMoving|RegisteredAction|CleanupExecutionRuntime)\b",
    r"\b(?:NSXPCConnection|NSXPCListener|URLSession|NWConnection|Process|FileManager|FileHandle)\b",
    r"\bCommandLine\b|\bProcessInfo\.processInfo\.(?:arguments|environment)\b|\bUserDefaults\b",
    r"\b(?:getenv|environ|_NSGetArgc|_NSGetArgv)\b",
    r"\b(?:posix_spawnp?|fork|execv|execve|system|popen|AuthorizationCreate)\s*\(",
    r"\b(?:Darwin\.)?(?:open|openat|write|unlink|rename|mkdir|socket|connect|send|recv)\s*\(",
    r"\b(?:O_WRONLY|O_RDWR|O_CREAT|O_TRUNC|O_APPEND)\b",
    r"\b(?:signedRuntimeReady|readiness)\b",
):
    if re.search(forbidden, author, re.I):
        fail("ii-c0b-i producer gained prohibited authority")
if __import__("hashlib").sha256(author.encode()).hexdigest() != "d650ce1a72623415020b8874360f44c2de03e1e9cc604a8b13f0d13dbf7b5dbc":
    fail("ii-c0b-i producer source seal drifted")
for marker in (
    "canonicalizesAdversarialScenarioOrderAndProjectsEveryField",
    "rejectsInvalidConfigurationsBeforeIdentifierGeneration",
    "rejectsBindingAndIdentifierFailures",
    "rejectsNonCanonicalDriverCodeDirectoryHashes",
    "rejectsEveryInvalidInstalledBindingField",
    "roundTripsAsCanonicalProjectedCohortInput",
    "producerSurfaceRemainsPackageOnlyAndAuthorityFree",
):
    if marker not in focused_test:
        fail("ii-c0b-i focused tests became vacuous")
if __import__("hashlib").sha256(focused_test.encode()).hexdigest() != "95a8c01bb29e19020f56d29072ea991e95f3c96dca73fa8397a9bf8cb4454300":
    fail("ii-c0b-i focused test source seal drifted")
for marker in (
    "iiC0BICanonicalProducerVerifierPinsContractAndScope",
    "--iic0b-i-producer-contract-only",
    "--iic0b-i-staged-scope-contract-only",
    "--iic0b-i-source-contract-only",
    "--iic0b-i-component-boundary-only",
):
    if marker not in boundary:
        fail(f"ii-c0b-i boundary regression drifted: {marker}")
PY
}

function verify_iic0bi_index_semantics() (
    local staged_root staged_status=0
    staged_root=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iic0bi-index.XXXXXX") || return $?
    trap 'rm -rf "$staged_root"' EXIT
    trap 'exit 130' INT; trap 'exit 143' TERM
    git checkout-index --all --prefix="$staged_root/" \
        || staged_status=$?
    if (( staged_status == 0 )); then
        (
            cd "$staged_root"
            scripts/verify-investigation-boundaries \
                --iic0b-i-producer-contract-only \
                Sources/StornautInvestigationDiagnostic/InvestigationProjectedCohortAuthor.swift \
                Sources/StornautInvestigationDiagnostic/InvestigationRuntimeDiagnosticComposition.swift \
                Tests/StornautInvestigationTests/InvestigationProjectedCohortAuthorTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift \
                || exit $?
            scripts/verify-app-release-boundaries \
                --iic0b-i-source-contract-only \
                Sources/StornautInvestigationDiagnostic/InvestigationProjectedCohortAuthor.swift \
                Sources/StornautInvestigationDiagnostic/InvestigationRuntimeDiagnosticComposition.swift \
                scripts/verify-app-release-boundaries \
                || exit $?
            scripts/verify-investigation-boundaries \
                --iic0a-replay-source-contract-only scripts/verify-contract \
                || exit $?
        ) || staged_status=$?
    fi
    return $staged_status
)

function verify_iic0bi_staged_scope() {
    local baseline=${1:-e5ed33e27195d9252f02a89ab39664df3848f1ed}
    local expected=(
        Sources/StornautInvestigationDiagnostic/InvestigationProjectedCohortAuthor.swift
        Sources/StornautInvestigationDiagnostic/InvestigationRuntimeDiagnosticComposition.swift
        Tests/StornautInvestigationTests/InvestigationProjectedCohortAuthorTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 7 )) || {
        print -u2 "ii-c0b-i checkpoint path ceiling drifted"; return 1
    }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == \
        e5ed33e27195d9252f02a89ab39664df3848f1ed ]] || {
        print -u2 "ii-c0b-i checkpoint baseline drifted"; return 1
    }
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-i checkpoint deleted an existing path"; return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-i binary checkpoint path rejected"; return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "ii-c0b-i checkpoint paths drifted"; return 1
    }
    local checkpoint_path expected_mode entry
    for checkpoint_path in "${expected[@]}"; do
        expected_mode=100644
        [[ $checkpoint_path == scripts/* ]] && expected_mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $checkpoint_path" ]] || {
            print -u2 "ii-c0b-i checkpoint mode drifted: $checkpoint_path"
            return 1
        }
    done
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 1900 )) || {
        print -u2 "ii-c0b-i checkpoint budget drifted"; return 1
    }
    verify_iic0bi_index_semantics
}

