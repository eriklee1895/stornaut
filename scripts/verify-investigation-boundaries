            )
    elif source_name == "InvestigationMachineFixedCapsuleIntake.swift":
        if re.sub(r"\s+", "", source_text).count(
            "return.success(result==0)"
        ) != 1:
            raise SystemExit(
                "Machine fixed capsule ACL semantics drifted"
            )
    match = driver_support_authority_pattern.search(authority_source)
    if match:
        raise SystemExit(
            "Machine driver support gained prohibited authority: "
            f"{source_path}: {match.group(0)!r}"
        )
    open_call_count = len(re.findall(r"\b(?:Darwin\.)?open\s*\(", source_text))
    if source_name == "DarwinInvestigationMachineInstalledDriverSystem.swift":
        expected_open_call = (
            "let descriptor = open(\n"
            "            Self.manifestPath,\n"
            "            O_RDONLY | O_CLOEXEC | O_NOFOLLOW_ANY | O_UNIQUE | "
            "O_NONBLOCK\n"
            "        )"
        )
        expected_executable_open_call = (
            "let descriptor = open(\n"
            "            Self.path,\n"
            "            O_RDONLY | O_CLOEXEC | O_NOFOLLOW_ANY | O_UNIQUE | "
            "O_NONBLOCK\n"
            "        )"
        )
        if (
            open_call_count != 2
            or source_text.count(expected_open_call) != 1
            or source_text.count(expected_executable_open_call) != 1
        ):
            raise SystemExit(
                "Machine driver support read-only open contract drifted: "
                f"{source_path}"
            )
        allowed_security_symbols = {
            "SecCSFlags", "SecCode", "SecCodeCheckValidity",
            "SecCodeCopySelf", "SecCodeCopySigningInformation",
            "SecCodeCopyStaticCode", "SecRequirement",
            "SecRequirementCopyData", "SecRequirementGetTypeID",
            "SecStaticCode", "SecStaticCodeCheckValidity",
            "SecStaticCodeCreateWithPath", "kSecCSRequirementInformation",
            "kSecCSSigningInformation", "kSecCSStrictValidate",
            "kSecCodeInfoDesignatedRequirement", "kSecCodeInfoFlags",
            "kSecCodeInfoIdentifier", "kSecCodeInfoUnique",
        }
        observed_security_symbols = set(re.findall(
            r"\b(?:(?:Sec|kSec)[A-Z]|Authorization|CSSM)[A-Za-z0-9_]*\b",
            source_text,
        ))
        if observed_security_symbols != allowed_security_symbols:
            raise SystemExit(
                "Machine driver Security symbol allowlist drifted: "
                f"{sorted(observed_security_symbols)}"
            )
    elif open_call_count:
        raise SystemExit(
            "Machine driver support gained an unexpected open call: "
            f"{source_path}"
        )
    readiness_source = source_text
    if source_name == "InvestigationMachineSingleEpoch.swift":
        if source_text.count("kind: .preDropReady") != 1:
            raise SystemExit("ii-b5a PRE_DROP_READY shape drifted")
        readiness_source = source_text.replace("preDropReady", "preDropFrame")
    elif source_name == "InvestigationMachineDarwinEpochSession.swift":
        if source_text.count("preDropReady") != 8:
            raise SystemExit("ii-b5b-ii-c PRE_DROP_READY shape drifted")
        readiness_source = source_text.replace("preDropReady", "preDropFrame")
    match = machine_readiness_pattern.search(readiness_source)
    if match:
        raise SystemExit(
            "Machine driver support gained prohibited readiness: "
            f"{source_path}: {match.group(0)!r}"
        )
expected_driver_dependencies = {
