machine_source_root = Path(machine.get("path", ""))
machine_sources = machine.get("sources", [])
if not machine_source_root.is_dir() or not machine_sources:
    raise SystemExit("Machine target has no resolved source graph")
machine_authority_pattern = re.compile(
    r"import\s+StornautExecution"
    r"|import\s+StornautInvestigationDiagnostic"
    r"|\b(?:ActionExecutor|TrashMoving|RegisteredAction|"
    r"FileManagerTrashAdapter|CleanupExecutionRuntime|"
    r"CleanupExecutionCoordinator|CleanupActionExecuting|"
    r"CleanupAuthorizationController|ExecutionAuthorization|"
    r"ActionPolicyGate|CleanupPolicyGate|MoveToTrash|"
    r"ProposedCleanupAction|CleanupAction|URLSession|"
    r"NWConnection|NSTask|posix_spawn|O_WRONLY|O_RDWR|O_CREAT|"
    r"O_TRUNC|O_APPEND)\b"
    r"|\bProcess\s*\("
    r"|FileManager\.default\.(?:remove|move|copy|trash|replace|"
    r"createDirectory|createSymbolicLink|link|setAttributes)"
    r"|\b(?:removeItem|moveItem|copyItem|trashItem|replaceItem|"
    r"createFile|createDirectory|createSymbolicLink|linkItem|"
    r"setAttributes|forWritingTo|writeabilityHandler)\b"
    r"|\bFileHandle\s*\(\s*forWritingTo:"
    r"|\b(?:write|writeData|synchronizeFile|truncateFile)\s*\("
    r"|\.write\s*\(\s*to:"
    r"|\b(?:unlink|rename|fopen|mkdir|rmdir|chmod|chown|"
    r"symlink|link|truncate|kill)\s*\("
    r"|Darwin\.write\s*\("
    r"|\b(?:Darwin\.)?(?:socket|connect|send|sendto|recv|recvfrom)\b"
    r"|CommandLine\.arguments"
    r"|ProcessInfo\.processInfo\.environment"
    r"|readLine\s*\("
    r"|NSXPCConnection"
    r"|signedInvestigationRuntimeReady"
)
machine_readiness_pattern = re.compile(
    r"\b(?:SignedInvestigationCapabilityEvidenceReceipt|"
    r"SignedInvestigationRuntimeMachineReport|"
    r"signedInvestigationRuntimeReady|signedRuntimeReady|"
    r"[A-Za-z_][A-Za-z0-9_]*Ready|readiness|Readiness)\b"
)
machine_readiness_baseline = {
    "SignedInvestigationRuntimeMachineContract.swift": [
        (643, "public struct SignedInvestigationRuntimeMachineReport:"),
        (1116, ") throws -> SignedInvestigationRuntimeMachineReport"),
        (1146, ") throws -> SignedInvestigationRuntimeMachineReport"),
        (1196, ") throws -> SignedInvestigationRuntimeMachineReport {"),
        (1264, "try SignedInvestigationCapabilityEvidenceReceipt("),
        (1273, "== .signedRuntimeReady,"),
        (1298, "let report = try SignedInvestigationRuntimeMachineReport("),
        (1350, "_ report: SignedInvestigationRuntimeMachineReport,"),
        (1354, ") throws -> SignedInvestigationRuntimeMachineReport"),
        (1373, "_ report: SignedInvestigationRuntimeMachineReport,"),
        (1386, ") throws -> SignedInvestigationRuntimeMachineReport"),
        (1721, "package extension SignedInvestigationCapabilityEvidenceReceipt {"),
    ],
}
for source_name in machine_sources:
    source_path = machine_source_root / source_name
    if not source_path.is_file():
        raise SystemExit(
            f"Resolved Machine source is missing: {source_path}"
        )
    match = machine_authority_pattern.search(
        source_path.read_text(encoding="utf-8")
    )
    if match:
        raise SystemExit(
            "StornautInvestigationMachine source gained prohibited "
            f"authority: {source_path}: {match.group(0)!r}"
        )
    source_lines = source_path.read_text(encoding="utf-8").splitlines()
    observed_readiness = [
        (line_number, line.strip())
        for line_number, line in enumerate(source_lines, start=1)
        if machine_readiness_pattern.search(line)
    ]
    expected_readiness = machine_readiness_baseline.get(source_name, [])
    if observed_readiness != expected_readiness:
        raise SystemExit(
            "StornautInvestigationMachine readiness surface drifted: "
            f"{source_path}: {observed_readiness!r} != "
            f"{expected_readiness!r}"
        )
