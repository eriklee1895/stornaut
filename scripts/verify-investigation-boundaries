function verify_shared_deadline_scope() {
    local baseline=${1:-66453397ae70c59347f02fff4e1a5528926c5141}
    local expected_baseline=66453397ae70c59347f02fff4e1a5528926c5141
    local -a expected=(Sources/StornautInvestigation/SignedInvestigationRuntimeContract.swift Sources/StornautInvestigationDiagnostic/InvestigationProjectedCohortAuthor.swift Sources/StornautInvestigationDiagnostic/InvestigationRuntimeDiagnosticComposition.swift Sources/StornautInvestigationMachine/InvestigationFixedScenarioRunner.swift Sources/StornautInvestigationMachine/SignedInvestigationRuntimeMachineContract.swift Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineCoordinatorConfigurationSet.swift Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift Tests/StornautInvestigationTests/InvestigationLifecycleTopologyTestSupport.swift Tests/StornautInvestigationTests/InvestigationMachineCoordinatorBindingSourceTests.swift Tests/StornautInvestigationTests/SignedRuntimeContractTests.swift Tests/StornautInvestigationTests/InvestigationHandoffConcreteCompositionTests.swift Tests/StornautInvestigationTests/InvestigationMachineGateCoordinatorCompositionTests.swift scripts/verify-investigation-boundaries scripts/verify-contract)
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == $expected_baseline ]] || { print -u2 "shared-deadline checkpoint baseline drifted"; return 1; }
    local observed_text observed_filtered worktree_text totals
    observed_text=$(git diff --cached --name-only --diff-filter=ACMRD "$baseline") || { print -u2 "shared-deadline checkpoint paths unreadable"; return 1; }
    observed_filtered=$(print -r -- "$observed_text" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"') || { print -u2 "shared-deadline checkpoint paths unreadable"; return 1; }
    local observed=(${(f)observed_filtered})
    (( ${#expected} == 14 )) && [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || { print -u2 "shared-deadline checkpoint paths drifted"; return 1; }
    worktree_text=$( { git diff --name-only --diff-filter=ACMRD -- && git ls-files --others --exclude-standard --; } | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"' | LC_ALL=C sort -u) || { print -u2 "shared-deadline checkpoint worktree paths unreadable"; return 1; }
    local worktree=(${(f)worktree_text})
    local item; for item in "${worktree[@]}"; do (( ${expected[(Ie)$item]} )) || { print -u2 "shared-deadline checkpoint worktree paths drifted"; return 1; }; done
    totals=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1&&$3!="AGENTS.md"&&$3!="README.md" {if($1=="-"||$2=="-"){bad=1;next};n=$1+$2;t+=n;if($3~/^Sources\//)p+=n;else if($3~/^Tests\//)q+=n;else if($3~/^scripts\//)v+=n;else bad=1} END{if(bad)exit 2;print t+0,p+0,q+0,v+0}') || { print -u2 "shared-deadline checkpoint binary or category drifted"; return 1; }
    local total production tests verifiers; read total production tests verifiers <<<"$totals"
    (( total <= 1600 && production <= 350 && tests <= 750 && verifiers <= 500 )) || { print -u2 "shared-deadline checkpoint budget drifted"; return 1; }
    local mode entry
    for item in "${expected[@]}"; do mode=100644; [[ $item == scripts/* ]] && mode=100755; entry=$(git ls-files -s -- "$item"); [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" == "$mode 0 $item" && "$(print -r -- "$entry" | awk '{print $2}')" == "$(git hash-object -- "$item")" ]] || { print -u2 "shared-deadline staged source/mode drifted: $item"; return 1; }; done
}

function verify_fixed_gate_deadline_cleanup_contract() {
    local -a paths=("${fixed_gate_deadline_cleanup_sources[@]}")
    if (( ${#paths} == 0 )); then paths=(
        Sources/StornautInvestigationMachineLaunchSupport/InvestigationFixedGateDarwinLifecycle.swift
        Tests/StornautInvestigationTests/InvestigationFixedGateDarwinLifecycleTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        Sources/StornautInvestigationMachineLaunchSupport/DarwinInvestigationFixedGateHandoffSystem.swift
    ); fi
    local lifecycle=${paths[1]} focused=${paths[2]} boundary=${paths[3]}
    local darwin=${paths[4]}
    for source in "$lifecycle" "$focused" "$boundary" "$darwin"; do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source"
    done
    python3 - "$fixed_gate_deadline_cleanup_mutation_only" \
        "$fixed_gate_deadline_cleanup_mutation_name" \
        "$fixed_gate_deadline_cleanup_mutation_slot" \
        "$fixed_gate_deadline_cleanup_mutation_sha" \
        "$lifecycle" "$focused" "$boundary" "$darwin" <<'PY'
