    "gateStatus.st_mode&S_IFMT!=S_IFLNK",
    "gateStatus.st_uid==geteuid()",
    "gateStatus.st_gid==getegid()",
    "gateStatus.st_uid!=0",
    "gateStatus.st_gid!=0",
    "gateStatus.st_mode&0o777==0o755",
    "letevidence=tryfixture.run(.success)",
    "evidence.coordinator.userID==501",
    "evidence.coordinator.groupID==20",
    "evidence.coordinatorAbsentAfterReap",
    "evidence.gatePIDRecordAbsent",
    "!report.succeeded",
    "report.gateProcessID==nil",
    "report.gateProcessGroupID==nil",
    "!report.exactGateExited",
    "report.capsuleRemoved",
    "report.foregroundRestored",
    "tryfixture.machineGateAttemptNames().isEmpty",
):
    if physical_test.count(marker) != 1:
        raise SystemExit("ii-c-b1 physical rejection test became vacuous")
if "return" in physical_test or "requireSuccessfulPhysicalHandoff" in physical_test \
        or "cleanupTimeout" in physical_test or "for(" in physical_test:
    raise SystemExit("ii-c-b1 physical rejection test became vacuous")
raw_physical_test = function_body(physical, physical_signature)
if raw_physical_test.count('#expect(report.error == "spawnFailedBeforeTransfer")') != 1:
    raise SystemExit("ii-c-b1 physical rejection test became vacuous")
compact_physical = re.sub(r"\s+", "", lexical_physical)
for marker in (
    "coordinatorObservation=tryphysicalDirectChildObservation(pid)",
    "kill(pid,SIGCONT)",
    "physicalReap(coordinatorToken,deadline:deadline)",
    "physicalProcessToken(pid)!=coordinatorToken",
    "gatePIDRecordAbsent:!FileManager.default.fileExists(atPath:gateRecord.path)",
    "userID:uid_t(value.pbi_uid),groupID:gid_t(value.pbi_gid)",
):
    if compact_physical.count(marker) != 1:
        raise SystemExit("ii-c-b1 physical rejection test became vacuous")
if compact_physical.find("coordinatorObservation=tryphysicalDirectChildObservation(pid)") \
        > compact_physical.find("kill(pid,SIGCONT)"):
    raise SystemExit("ii-c-b1 physical rejection test became vacuous")
for marker in (
    "iiCB1RootOwnedGateVerifierPinsCurrentTreeContractAndScope",
    "--iic-b1-root-owned-gate-source-contract-only",
    "--iic-b1-root-owned-gate-mutation-contract-only",
    "--iic-b1-root-owned-gate-staged-scope-contract-only",
    "--iic-b1-root-owned-gate-component-boundary-only",
    "--iic-b1-root-owned-gate-contract-only",
):
    if marker not in boundary:
        raise SystemExit("ii-c-b1 boundary marker drifted")
for forbidden in (
    r"\bsudo\b", r"\bAuthorization\b", r"\blaunchctl\b",
    r"\bProcess\s*\(", r"\bposix_spawn", r"\bset(?:e)?uid\s*\(",
    r"\bset(?:e)?gid\s*\(", r"\bchown\s*\(", r"\bchmod\s*\(",
    r"\bremoveItem\b", r"\btrashItem\b", r"\bRegisteredAction\b",
    r"\bActionExecutor\b", r"\bsignedRuntimeReady\b", r"\breadiness\b",
):
    if re.search(forbidden, lexical_lifecycle):
        raise SystemExit("ii-c-b1 prohibited authority drifted")
PY
}

function verify_iicb1_root_owned_gate_staged_scope() {
    local baseline=${1:-41f5dba1b7ff7f1272d5a2607ae9794b266e6c47}
    local expected_baseline=41f5dba1b7ff7f1272d5a2607ae9794b266e6c47
    local -a expected=(
        Sources/StornautInvestigationMachineLaunchSupport/InvestigationFixedGateDarwinLifecycle.swift
        Tests/StornautInvestigationTests/InvestigationFixedGateDarwinLifecycleTests.swift
        Tests/StornautInvestigationTests/InvestigationFixedGateHandoffPhysicalTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-investigation-boundaries
        scripts/verify-app-release-boundaries
        scripts/verify-contract
    )
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == \
        $expected_baseline ]] || {
        print -u2 "ii-c-b1 checkpoint baseline drifted"; return 1
    }
    local filtered deleted_text observed_text changed item mode entry
    deleted_text=$(git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')
    [[ -z $deleted_text ]] || {
        print -u2 "ii-c-b1 checkpoint deleted an existing path"; return 1
    }
    observed_text=$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')
    local -a observed=(${(f)observed_text})
    (( ${#expected} == 7 && ${#observed} <= 7 )) || {
        print -u2 "ii-c-b1 checkpoint path ceiling drifted"; return 1
    }
    [[ "${(j:\n:)${(@on)observed}}" == \
        "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "ii-c-b1 checkpoint paths drifted"; return 1
    }
    changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {if($1=="-"||$2=="-")exit 2;n+=$1+$2} END{print n+0}') || {
        print -u2 "ii-c-b1 binary checkpoint path rejected"; return 1
    }
    (( changed <= 1900 )) || {
        print -u2 "ii-c-b1 checkpoint budget drifted"; return 1
    }
    local worktree_text
    worktree_text=$(git diff --name-only --diff-filter=ACMRD -- \
        | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')
    local -a worktree_paths=(${(f)worktree_text})
    for item in "${worktree_paths[@]}"; do
        (( ${expected[(Ie)$item]} )) || {
            print -u2 "ii-c-b1 checkpoint worktree paths drifted"; return 1
        }
    done
    local untracked_text
    untracked_text=$(git ls-files --others --exclude-standard -- \
        | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')
    [[ -z $untracked_text ]] || {
        print -u2 "ii-c-b1 checkpoint untracked paths drifted"; return 1
    }
    for item in "${expected[@]}"; do
        mode=100644; [[ $item == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$item")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" \
                == "$mode 0 $item" ]] || {
            print -u2 "ii-c-b1 staged source/mode drifted: $item"; return 1
        }
        [[ "$(print -r -- "$entry" | awk '{print $2}')" \
                == "$(git hash-object -- "$item")" ]] || {
            print -u2 "ii-c-b1 staged/worktree source drifted: $item"; return 1
        }
    done
}

function verify_iicb2a2_source_contract() {
