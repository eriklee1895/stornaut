for required in ("task_name_for_pid(","TASK_AUDIT_TOKEN","mach_port_deallocate(","PROC_PIDT_SHORTBSDINFO","audit_token_words[8]"):
    if required not in c+header: raise SystemExit("ii-b5b-i-b2b-a identity extraction drifted")
for required in ("SecCodeCopyGuestWithAttributes(","kSecGuestAttributeAudit: tokenData as CFData","SecCodeCheckValidity(","SecStaticCodeCheckValidity(","kSecCodeInfoFlags","finalKernel == initialKernel","finalPath == initialPath"):
    if required not in swift: raise SystemExit("ii-b5b-i-b2b-a process contract drifted")
