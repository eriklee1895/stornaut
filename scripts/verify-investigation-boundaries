if mode=="true":
    if name not in mutations or slot!=mutations[name][0] or not re.fullmatch(r"[0-9a-f]{64}",sha): raise SystemExit("ii-c root-driver lineage L2 mutation identity drifted")
    mutation_index=slots.index(slot)
    if any(argument != canonical_arguments[index]
           for index,argument in enumerate(source_arguments)
