positions=[collector.find(marker) for marker in order]
if any(position<0 for position in positions) or positions!=sorted(positions) or any(collector.count(marker)!=1 for marker in order) or collector.count("postTeardownObserver.observePostTeardown(")!=1 or collector.count("post.startedAt >= transitionedAt")!=1:
    raise SystemExit("ii-b5b-i-c2a transition observation order drifted")
