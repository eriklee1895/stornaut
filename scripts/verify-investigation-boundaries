    "dcdb198be26abff6965cfd45d73ba60b85454314f6dddae796409a8413567e45",
)
if mutation_mode == "true":
    if mutation_slot not in slot_names:
        raise SystemExit("shared-deadline mutation slot drifted")
    if re.fullmatch(r"[0-9a-f]{64}", mutation_sha) is None:
        raise SystemExit("shared-deadline mutation SHA drifted")
    mutation_index = slot_names.index(mutation_slot)
    if mutation_sha == expected[mutation_index]:
        raise SystemExit("shared-deadline mutation source unchanged")
    expected = expected[:mutation_index] + (mutation_sha,) + expected[mutation_index + 1:]
elif mutation_mode != "false" or mutation_slot or mutation_sha:
    raise SystemExit("shared-deadline mutation mode drifted")
if tuple(hashlib.sha256(x.encode()).hexdigest() for x in raw_sources) != expected:
    raise SystemExit("shared-deadline mutation digest drifted" if mutation_mode == "true" else "shared-deadline sealed source drifted")
if mutation_mode == "true":
    import subprocess
    parsed = subprocess.run(
        ["xcrun", "swiftc", "-frontend", "-dump-parse",
         "-enable-bare-slash-regex", sys.argv[4 + mutation_index]],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False
    )
    if parsed.returncode != 0: raise SystemExit("shared-deadline Swift parse drifted")
    if "regex_literal_expr" in parsed.stdout:
        raise SystemExit("shared-deadline regex literal rejected")
def code_only(source):
    output=list(source); index=0; block_depth=0; string_end=None; raw_hashes=""
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index): output[index:index+2]="  "; block_depth+=1; index+=2
            elif source.startswith("*/", index): output[index:index+2]="  "; block_depth-=1; index+=2
            else:
                if source[index] != "\n": output[index]=" "
                index+=1
            continue
        if string_end is not None:
            if source.startswith(string_end, index):
                width=len(string_end); output[index:index+width]=" "*width; index+=width; string_end=None; raw_hashes=""
            elif not raw_hashes and source[index] == "\\":
                output[index]=" "
                if index+1 < len(source) and source[index+1] != "\n": output[index+1]=" "
                index+=2
            else:
                if source[index] != "\n": output[index]=" "
                index+=1
            continue
        if source.startswith("//", index):
            end=source.find("\n", index); end=len(source) if end < 0 else end
            output[index:end]=" "*(end-index); index=end
        elif source.startswith("/*", index): output[index:index+2]="  "; block_depth=1; index+=2
        else:
            opener=re.match(r'(#+)?("""|")', source[index:])
            if opener is None: index+=1; continue
            hashes=opener.group(1) or ""; quote=opener.group(2); width=len(opener.group(0))
            output[index:index+width]=" "*width; string_end=quote+hashes; raw_hashes=hashes; index+=width
    if block_depth or string_end is not None: raise SystemExit("shared-deadline Swift lexical scan drifted")
    return "".join(output)
c, a, d, r, m, s, g, ct, dt, lt, st, gt = tuple(code_only(x) for x in raw_sources)
def compact(x): return re.sub(r"\s+", "", x)
def exact(x, marker, count, label):
    projected=compact(code_only(marker))
    if not projected or compact(x).count(projected) != count: raise SystemExit(label)
def body(source, name):
    match = re.search(rf"(?m)^\s*(?:private\s+|fileprivate\s+|package\s+|public\s+)?func\s+{re.escape(name)}\b", source)
    if not match: raise SystemExit(f"shared-deadline focused test missing: {name}")
    opening = source.find("{", match.end()); depth = 0
    for index in range(opening, len(source)):
        depth += source[index] == "{"; depth -= source[index] == "}"
        if depth == 0: return source[opening + 1:index]
    raise SystemExit(f"shared-deadline focused test unterminated: {name}")
def test(source, name, *markers):
    value = body(source, name)
    for marker in markers: exact(value, marker, 1, "shared-deadline focused tests became vacuous")
exact(c, "package static let maximumMachineCohortValiditySeconds: TimeInterval = 1_200", 1, "shared-deadline 1200 constant drifted")
exact(c, "package static let maximumMachineEpochWallClockSeconds = 140", 1, "shared-deadline 140 constant drifted")
exact(c, "validBefore.timeIntervalSince(now) <= 900", 1, "generic 900-second validity drifted")
for marker in ("maximumWallClockSeconds == Self.maximumMachineEpochWallClockSeconds", "maximumTurns == 3", "maximumProbeCalls == 16", "maximumContextBytes == 1_048_576"):
    exact(c, marker, 1, "machine-only exact profile drifted")
exact(c, "try decoded.validateMachineCohort(now: now, outputs: outputs)", 1, "machine-only decoder drifted")
exact(c, "CompletedSignedInvestigationRuntimeConfiguration.self", 1, "completed-output machine decoder drifted")
exact(a, "configuration = try .decodeMachineCohortValidated(from: bytes, now: now)", 1, "machine-only author decoder drifted")
exact(a, "byOrdinal.values.allSatisfy({ $0.0.validBefore == validBefore })", 1, "mixed cohort deadline rejection drifted")
exact(d, ".decodeMachineCohortValidated(from: bytes, now: observedAt)", 1, "machine-only App decoder drifted")
operations = d[d.index("package actor InvestigationHandoffConcreteAppLeafOperations"):d.index("package enum InvestigationHandoffScenarioMapping")]
if "epochStartedAt:Date?" in compact(operations): raise SystemExit("App epoch deadline became caller-controlled")
clock = d[d.index("private func investigationMonotonicWallClock"):d.index("package struct InvestigationRuntimeDiagnosticBindingObservation")]
for marker in ("let wallAnchor = wall(), anchor = try continuous()", "deadline ?? anchor.addingReportingOverflow(maximum).partialValue", "let remaining = limit.subtractingReportingOverflow(anchor)", "let tick = try? continuous(), tick >= anchor", "return projected.timeIntervalSince1970.isFinite ? projected : validBefore", "else { return validBefore }"):
    exact(clock, marker, 1, "shared App monotonic clock drifted")
