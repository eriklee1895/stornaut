function verify_iib5bib1_semantic_contract() {
    local package_source=$1 semantic_source=$2 focused_test_source=$3
    xcrun swiftc -frontend -parse "$semantic_source"
    xcrun swiftc -frontend -parse "$focused_test_source"
    python3 - "$package_source" "$semantic_source" "$focused_test_source" <<'PY'
from pathlib import Path
import hashlib
import re
import sys
package_path, semantic_path, test_path = map(Path, sys.argv[1:])
package = package_path.read_text(encoding="utf-8")
semantic = semantic_path.read_text(encoding="utf-8")
test = test_path.read_text(encoding="utf-8")
target = re.search(
    r'\.target\(\s*name: "StornautInvestigationInstalledL2",(.*?)\n\s*\),',
    package, re.DOTALL,
)
if target is None:
    raise SystemExit("ii-b5b-i-b1 package target missing")
dependencies = set(re.findall(r'"(Stornaut[A-Za-z0-9]+)"', target.group(1)))
if dependencies != {"StornautInvestigationHandoffContract"}:
    raise SystemExit("ii-b5b-i-b1 dependency surface drifted")
if set(re.findall(r'(?m)^import\s+([A-Za-z0-9_]+)\s*$', semantic)) != {
    "Foundation", "StornautInvestigationHandoffContract",
}:
    raise SystemExit("ii-b5b-i-b1 source imports drifted")
if re.search(r'(?m)^\s*(?:public|open)\s+', semantic):
    raise SystemExit("ii-b5b-i-b1 public surface drifted")
for forbidden in (
    "Codable", "Encodable", "Decodable", "JSONDecoder", "JSONEncoder",
    "FileManager", "FileHandle", "Process(", "NSXPC", "URLSession",
    "Darwin", "Security", "ServiceManagement", "socket", "spawn",
    "kill(", "write(", "removeItem", "moveItem", "readiness",
    "receipt", "SignedInvestigationRuntime", "InvestigationMachineClaimEvidence",
    "InvestigationHandoffRetirementHandle", "ActionExecutor", "TrashMoving",
):
    if forbidden in semantic:
        raise SystemExit("ii-b5b-i-b1 authority or schema surface drifted")
for required in (
    "package enum InvestigationInstalledL2ArtifactRole:",
    "case installedRoot", "case installedApp", "case appExecutable",
    "case helperExecutable", "case machineDriverExecutable",
    "case launchDaemonPlist", "case runtimeRoot", "case leaseRoot",
    "package struct InvestigationInstalledL2SemanticObservation:",
    "package init(",
    "package let app: InvestigationInstalledL2ProcessEvidence",
    "package let helper: InvestigationInstalledL2ProcessEvidence",
    "package let machineDriver: InvestigationInstalledL2MachineDriverEvidence",
    "package let service: InvestigationInstalledL2ServiceObservation",
    "Set(artifacts.keys) == allRoles",
    "app.staticSigning == app.liveSigning",
    "helper.staticSigning == helper.liveSigning",
    "machineDriver.staticSigning == machineDriver.liveSigning",
    "service == .loaded(identity: helper.identity)",
    "observed.wallUTC < projection.configurationValidBefore",
    "started.continuousNanoseconds <= observed.continuousNanoseconds",
):
    if required not in semantic:
        raise SystemExit("ii-b5b-i-b1 semantic contract drifted")
expected = {
    package_path: "acb012b94533a6cb437501e09d3414b07b36a80767daf6fa742be96d3b3bb51d",
    semantic_path: "d09b907d2fe5309827a0a2a2339d3e74f30c49dca7ac721c4a1a13e91f8e473c",
    test_path: "82fb444b3d99a27414829b8ce959ccf3042f1d83267fe60fb1b7da12336d8e78",
}
for path, expected_sha in expected.items():
    data = path.read_bytes()
    if path == package_path:
        current = (
            b'        .target(\n'
            b'            name: "StornautInvestigationInstalledL2",\n'
            b'            dependencies: [\n'
            b'                "CInvestigationIdentitySupport",\n'
            b'                "StornautInvestigationHandoffContract",\n'
            b'            ],\n'
            b'            linkerSettings: [\n'
            b'                .linkedFramework("Security"),\n'
            b'                .linkedFramework("ServiceManagement"),\n'
            b'            ]\n'
            b'        ),\n'
        )
        historical = (
            b'        .target(\n'
            b'            name: "StornautInvestigationInstalledL2",\n'
            b'            dependencies: [\n'
            b'                "StornautInvestigationHandoffContract",\n'
            b'            ]\n'
            b'        ),\n'
        )
        if data.count(current) != 1:
            raise SystemExit(
                "ii-b5b-i-b1 historical Package normalization drifted"
            )
        data = data.replace(current, historical, 1)
        later_c_target = (
            b'        .target(\n'
            b'            name: "CInvestigationIdentitySupport",\n'
            b'            path: "Sources/CInvestigationIdentitySupport",\n'
            b'            publicHeadersPath: "include",\n'
            b'            linkerSettings: [\n'
            b'                .linkedLibrary("bsm"),\n'
            b'            ]\n'
            b'        ),\n'
        )
        if data.count(later_c_target) != 1:
            raise SystemExit(
                "ii-b5b-i-b1 historical C target normalization drifted"
            )
        data = data.replace(later_c_target, b'', 1)
    if hashlib.sha256(data).hexdigest() != expected_sha:
        label = "package" if path == package_path else (
            "semantic" if path == semantic_path else "focused test"
        )
        raise SystemExit(f"ii-b5b-i-b1 canonical {label} source drifted")
PY
}

