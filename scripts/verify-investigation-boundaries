function verify_iic0biia_staged_scope() {
    local baseline=${1:-d18354bc7ca7dd2ddb04180298f9fb4f2e7c60e3}
    local expected=(
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 4 )) || {
        print -u2 "ii-c0b-ii-a checkpoint path ceiling drifted"; return 1
    }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == \
        d18354bc7ca7dd2ddb04180298f9fb4f2e7c60e3 ]] \
        && [[ "$(git rev-parse "$baseline^{tree}" 2>/dev/null)" == \
        d6a4b0ea9f6ee53101fb986fdab5ac4b509de7ad ]] || {
        print -u2 "ii-c0b-ii-a checkpoint baseline drifted"; return 1
    }
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-ii-a checkpoint deleted an existing path"; return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "ii-c0b-ii-a binary checkpoint path rejected"; return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || {
        print -u2 "ii-c0b-ii-a checkpoint paths drifted"; return 1
    }
    local checkpoint_path expected_mode entry
    for checkpoint_path in "${expected[@]}"; do
        expected_mode=100644
        [[ $checkpoint_path == scripts/* ]] && expected_mode=100755
        entry=$(git ls-files -s -- "$checkpoint_path")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $checkpoint_path" ]] || {
            print -u2 "ii-c0b-ii-a checkpoint mode drifted: $checkpoint_path"
            return 1
        }
    done
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 1200 && 1981 + changed <= 2870 )) || {
        print -u2 "ii-c0b-ii-a checkpoint budget drifted"; return 1
    }
    verify_iic0biia_index_semantics
}

function verify_iic0biia3_retained_base_contract() {
    local ownership_path=$1 focused_test_path=$2 boundary_path=$3 source_path
    for source_path in "$ownership_path" "$focused_test_path" "$boundary_path"; do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source_path"
    done
    python3 - "$ownership_path" "$focused_test_path" "$boundary_path" <<'PY'
from pathlib import Path
import re
import sys

ownership_path, focused_test_path, boundary_path = map(Path, sys.argv[1:])
ownership = ownership_path.read_text(encoding="utf-8")
focused_test = focused_test_path.read_text(encoding="utf-8")
boundary = boundary_path.read_text(encoding="utf-8")
compact = re.sub(r"\s+", "", ownership)
expected_sha256 = {
    ownership_path: "3e8c1a586e692e705c14399acfcb637f1565da497a8e4b8cfdc2dfe7f3dd146a",
    focused_test_path: "3d6ba434eab3703baa4881941853c8cd4fe56ed42d5827b7bb24db98d5acf4fa",
}

def fail(message):
    raise SystemExit(message)

for path, expected in expected_sha256.items():
    observed = __import__("hashlib").sha256(path.read_bytes()).hexdigest()
    if observed != expected:
        fail("ii-c0b-ii-a3 source or focused-test seal drifted")
print("ii-c0b-ii-a3 source seal admitted")

def mask_swift_lexemes(source):
    if '"""' in source or re.search(r'#+"', source) \
            or "//" in source or "/*" in source or "*/" in source:
        fail("ii-c0b-ii-a3 owner member allowlist drifted")
    masked = list(source)
    in_string = False
    escaped = False
    for index, character in enumerate(source):
        if in_string:
            if character == "\n":
                fail("ii-c0b-ii-a3 owner member allowlist drifted")
            masked[index] = " "
            if escaped:
                escaped = False
            elif character == "\\":
                escaped = True
            elif character == '"':
                in_string = False
        elif character == '"':
            masked[index] = " "
            in_string = True
        elif character == "/":
            fail("ii-c0b-ii-a3 owner member allowlist drifted")
    if in_string:
        fail("ii-c0b-ii-a3 owner member allowlist drifted")
    return "".join(masked)

lexical_ownership = mask_swift_lexemes(ownership)
if re.search(r"\b(?:typealias|associatedtype)\b", lexical_ownership):
    fail("ii-c0b-ii-a3 callback type alias drifted")

def matching_delimiter(source, opening, left, right):
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == left:
            depth += 1
        elif source[index] == right:
            depth -= 1
            if depth == 0:
                return index
            if depth < 0:
                break
    fail("ii-c0b-ii-a3 declaration boundary drifted")

def reject_callback_surface(source):
    callable_declaration = re.compile(r"(?<!\.)\b(?:func|init|subscript)\b")
    declarations = list(callable_declaration.finditer(source))
    ordinary_return_arrows = set()
    for position, declaration in enumerate(declarations):
        boundary = declarations[position + 1].start() \
            if position + 1 < len(declarations) else len(source)
        opening = source.find("(", declaration.end(), boundary)
        if opening < 0:
            continue
        closing = matching_delimiter(source, opening, "(", ")")
        if re.search(r"->", source[opening + 1:closing]):
            fail("ii-c0b-ii-a3 callback surface drifted")
        body_opening = source.find("{", closing + 1, boundary)
        header_end = body_opening if body_opening >= 0 else boundary
        header_arrows = [
            closing + 1 + match.start()
            for match in re.finditer(r"->", source[closing + 1:header_end])
        ]
        if len(header_arrows) > 1:
            fail("ii-c0b-ii-a3 callback surface drifted")
        ordinary_return_arrows.update(header_arrows)
    all_arrows = {match.start() for match in re.finditer(r"->", source)}
    if all_arrows != ordinary_return_arrows:
        fail("ii-c0b-ii-a3 callback surface drifted")

reject_callback_surface(lexical_ownership)

def direct_owner_declarations(body):
    declaration = re.compile(
        r"\b(struct|enum|class|actor|protocol|extension|typealias|"
        r"associatedtype|let|var|init|deinit|func|subscript|macro|"
        r"operator)\b"
        r"(?:\s+([A-Za-z_][A-Za-z0-9_]*))?"
    )
    observed = []
    depths = []
    depth = 0
    for character in body:
        depths.append(depth)
        depth += (character == "{") - (character == "}")
        if depth < 0:
            fail("ii-c0b-ii-a3 owner member allowlist drifted")
    if depth != 0:
        fail("ii-c0b-ii-a3 owner member allowlist drifted")
    for match in declaration.finditer(body):
        if depths[match.start()] != 0:
            continue
        kind, name = match.groups()
        name = name if kind not in {"init", "deinit", "subscript"} else kind
        prefix_start = max(
            body.rfind("\n", 0, match.start()),
            body.rfind(";", 0, match.start()),
            body.rfind("}", 0, match.start()),
        ) + 1
        visibility = "private" if re.search(
            r"\b(?:private|fileprivate)\b", body[prefix_start:match.start()]
        ) else "internal"
        observed.append({
            "label": f"{visibility}:{kind}:{name}",
            "kind": kind, "name": name, "start": match.start(),
            "end": match.end(),
        })
    return observed

def declaration_labels(declarations):
    return [declaration["label"] for declaration in declarations]

def unique_declaration(declarations, kind, name):
    matches = [
        declaration for declaration in declarations
        if declaration["kind"] == kind and declaration["name"] == name
    ]
    if len(matches) != 1:
        fail(f"ii-c0b-ii-a3 direct declaration drifted: {kind} {name}")
    return matches[0]

def direct_declaration_body(body, declaration, declarations, exact_body=None):
    following = [
        candidate["start"] for candidate in declarations
        if candidate["start"] > declaration["start"]
    ]
    limit = min(following) if following else len(body)
    opening = body.find("{", declaration["end"], limit)
    if opening < 0:
        fail("ii-c0b-ii-a3 direct declaration body drifted")
    closing = matching_delimiter(body, opening, "{", "}")
    if closing >= limit:
        fail("ii-c0b-ii-a3 direct declaration body drifted")
    return (exact_body or body)[opening + 1:closing]

