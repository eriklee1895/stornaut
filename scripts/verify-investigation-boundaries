    raise SystemExit("ii-b5b-i-b2a safe open binding drifted")
for required in (
    "O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK",
    "flags |= O_DIRECTORY",
    "InvestigationHandoffSHA256.hashing(value) != expectedSHA256",
    "SecStaticCodeCreateWithPath(", "SecStaticCodeCheckValidity(",
    "kSecCSStrictValidate", "kSecCSSigningInformation",
    "kSecCSRequirementInformation", "kSecCodeInfoDesignatedRequirement",
    "SecRequirementCopyData(", "CFBooleanGetTypeID()", "CFNumberGetTypeID()",
    "package struct InvestigationInstalledL2ArtifactFacts:",
    "package struct InvestigationInstalledL2ArtifactReader: Sendable",
    "defer { system.close(descriptor) }",
    "/Library/Application Support/Stornaut",
    "/Library/LaunchDaemons/com.eriklee.stornaut.lifecycle.plist",
    "/private/var/db/com.eriklee.stornaut.r5",
):
    if required not in source:
        raise SystemExit("ii-b5b-i-b2a artifact contract drifted")
if source.count("system.metadata(for: descriptor)") != 2:
    raise SystemExit("ii-b5b-i-b2a descriptor revalidation drifted")
if source.count("system.metadata(at: expectation.url)") != 2:
    raise SystemExit("ii-b5b-i-b2a path revalidation drifted")
