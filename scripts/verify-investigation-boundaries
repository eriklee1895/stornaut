function verify_iib5biid_staged_scope() {
    local baseline=${1:-efe079f95a9f15a360d280ea656bf9548bfaa3c3}
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochRetirement.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochRetirementTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 8 )) || { print -u2 "ii-b5b-ii-d checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == efe079f95a9f15a360d280ea656bf9548bfaa3c3 ]] || { print -u2 "ii-b5b-ii-d checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" | grep -q .; then print -u2 "ii-b5b-ii-d checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {f=1} END {exit !f}'; then print -u2 "ii-b5b-ii-d binary checkpoint path rejected"; return 1; fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    local observed_sorted=("${(@on)observed}")
    local expected_sorted=("${(@on)expected}")
    [[ "${(j:\n:)observed_sorted}" == "${(j:\n:)expected_sorted}" ]] || { print -u2 "ii-b5b-ii-d checkpoint paths drifted"; return 1; }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644; [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" == "$expected_mode 0 $expected_path" ]] || { print -u2 "ii-b5b-ii-d checkpoint mode drifted: $expected_path"; return 1; }
    done
    local changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 3200 )) || { print -u2 "ii-b5b-ii-d checkpoint budget drifted"; return 1; }
    verify_iib5biid_index_semantics
}

function verify_iic0a_replay_source_contract() {
    local contract_source=$1
    zsh -n "$contract_source"
    python3 - "$contract_source" <<'PY'
from pathlib import Path
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")
start = source.find("function verify_immutable_historical_checkpoints() {")
end = source.find("\nif [[ ${1:-} == --historical-freeze-contract-only ]]", start)
if start < 0 or end < 0:
    raise SystemExit("ii-c0a historical replay source boundary drifted")
replay = source[start:end]
required = (
    'GIT_INDEX_FILE="$iib0a_index" git read-tree "$iib0a_commit^{tree}"',
    'GIT_INDEX_FILE="$iib0a_index" git checkout-index --all',
    'cd "$iib0a_root"\n                scripts/verify-investigation-boundaries',
    'GIT_INDEX_FILE="$iib5biid_index" git read-tree "$iib5biid_commit^{tree}"',
    'GIT_INDEX_FILE="$iib5biid_index" git checkout-index --all',
    'cd "$iib5biid_root"\n            scripts/verify-investigation-boundaries',
)
for marker in required:
    if replay.count(marker) != 1:
        raise SystemExit(
            f"ii-c0a historical replay execution drifted: {marker}"
        )
if replay.count("|| exit $?") != 4:
    raise SystemExit("ii-c0a historical replay failure propagation drifted")
for forbidden in (
    '$repo_root/scripts/verify-investigation-boundaries',
    '$repo_root/scripts/verify-app-release-boundaries',
):
    if forbidden in replay:
        raise SystemExit(
            f"ii-c0a historical replay substituted current verifier: {forbidden}"
        )
PY
}

function verify_iic0a_projection_capsule_contract() {
    local projection_source=$1 intake_source=$2 transport_test=$3
    local intake_test=$4 boundary_test=$5
    xcrun swiftc -frontend -parse "$projection_source"
    xcrun swiftc -frontend -parse "$intake_source"
    python3 - "$projection_source" "$intake_source" \
        "$transport_test" "$intake_test" "$boundary_test" <<'PY'
from pathlib import Path
import re
import sys

projection_path, intake_path, transport_path, intake_test_path, boundary_path = (
    map(Path, sys.argv[1:])
)
projection = projection_path.read_text(encoding="utf-8")
intake = intake_path.read_text(encoding="utf-8")
transport = transport_path.read_text(encoding="utf-8")
intake_test = intake_test_path.read_text(encoding="utf-8")
boundary = boundary_path.read_text(encoding="utf-8")
if set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", projection)) != {
    "Foundation"
}:
    raise SystemExit("ii-c0a projection dependency surface drifted")
if re.search(r"(?m)^\s*(?:public|open)\s+", projection):
    raise SystemExit("ii-c0a projection public surface drifted")
if "Codable" in projection:
    raise SystemExit("ii-c0a projection gained Codable surface")
for marker in (
    "package struct InvestigationProjectedCohortSelection",
    "package struct InvestigationProjectedCohortInput",
    '"stornaut.task39.l3c3cii.projected-cohort-input"',
    "projectionCount = InvestigationCohortCapsule.epochCount",
    "package static let maximumByteCount = 1_069_056",
    "package let capsule: InvestigationCohortCapsule",
    "package let projections: [InvestigationInstalledL2IdentityProjection]",
    "package let wholeInputSHA256: InvestigationHandoffSHA256",
    "try input.encoded() == data",
    "try capsule.encoded(),",
    "handoffData(UInt32(projectionCount))",
    "wholeInputSHA256.rawBytes",
    "fields.append(contentsOf: try projections.map { try $0.encoded() })",
    "projection.epochUUID == epoch.epochUUID",
    "projection.configurationNonce == epoch.configurationNonce",
    "projection.configurationSHA256 == epoch.configurationSHA256",
    "== epoch.signedRuntimeBindingSHA256",
):
    if projection.count(marker) != 1:
        raise SystemExit(f"ii-c0a projection contract drifted: {marker}")
for marker in (
    "wholeInputSHA256 = InvestigationHandoffSHA256.hashing(",
    "Data(repeating: 0, count: 32)",
    "try InvestigationCohortCapsule.decode(fields[0])",
    "try InvestigationInstalledL2IdentityProjection.decode($0)",
):
    if marker not in projection:
        raise SystemExit(f"ii-c0a strict decode or digest drifted: {marker}")
for label, source in (("projection", projection), ("intake", intake)):
    for forbidden in (
        r"\b(?:JSONDecoder|JSONEncoder|JSONSerialization|PropertyListDecoder|PropertyListEncoder)\b",
        r"\b(?:FileManager|FileHandle|OutputStream|FileWrapper|"
        r"NSData|NSMutableData|NSMutableString|UserDefaults|"
        r"NSFileCoordinator|NSFileVersion|NSUbiquitousKeyValueStore|"
        r"URLSession|NSURLConnection|"
        r"NWConnection|WebSocket|CFStream|CFReadStream|CFWriteStream|"
        r"DispatchIO|NSXPCConnection|Process|NSTask)\b",
        r"\b(?:posix_spawnp?|fork|vfork|execv|execve|execvp|execvP|"
        r"execl|execlp|system|popen|dlopen|dlsym)\s*\(",
        r"\bsudo\b",
        r"\b(?:Cleanup|Executor|Trash|RegisteredAction|readiness|signedRuntimeReady)\b",
        r"\.write\s*\(\s*(?:to|toFile):",
        r"\b(?:removeItem|moveItem|copyItem|trashItem|replaceItem|"
        r"createFile|createDirectory|createSymbolicLink|linkItem|"
        r"setAttributes|forWritingTo|writeabilityHandler)\b",
        r"\b(?:Darwin\.)?(?:open|openat|creat|fopen|freopen|write|"
        r"writev|pwrite|pwritev|unlink|unlinkat|rename|renameat|mkdir|"
        r"mkdirat|rmdir|chmod|fchmod|chown|fchown|symlink|link|truncate|"
        r"ftruncate|setxattr|fsetxattr|removexattr|fremovexattr|mmap|"
        r"msync|ioctl|copyfile|fcopyfile|clonefile|socket|socketpair|"
        r"connect|bind|listen|accept|accept4|send|sendto|sendmsg|recv|"
        r"recvfrom|recvmsg|getaddrinfo|kill|killpg|pthread_kill|raise)\s*\(",
        r"\b(?:O_WRONLY|O_RDWR|O_CREAT|O_TRUNC|O_APPEND)\b",
        r"\bCommandLine\.arguments\b",
        r"\bProcessInfo\.processInfo\.environment\b",
        r"\breadLine\s*\(",
        r"import\s+Stornaut(?:Core|Codex|Lifecycle|Execution|InvestigationRuntime|InvestigationDiagnostic)",
    ):
        if re.search(forbidden, source, re.IGNORECASE):
            raise SystemExit(
                f"ii-c0a {label} gained runtime authority: {forbidden}"
            )

selection_match = re.search(
    r"(?ms)^package struct InvestigationMachineFixedEpochSelection:.*?^}\n",
    intake,
)
if selection_match is None:
    raise SystemExit("ii-c0a paired selection surface drifted")
selection = selection_match.group(0)
for field in ("wholeInputSHA256", "epoch", "projection"):
    if selection.count(f"package let {field}:") != 1:
        raise SystemExit(f"ii-c0a paired selection field drifted: {field}")
for marker in (
    "private let input: InvestigationProjectedCohortInput",
    "selected = try input.selection(at: nextIndex)",
    "epoch: epoch,",
    "projection: selected.projection",
    "input: try InvestigationProjectedCohortInput.decode(encoded)",
    "<= InvestigationProjectedCohortInput.maximumByteCount",
):
    if intake.count(marker) != 1:
        raise SystemExit(f"ii-c0a paired intake drifted: {marker}")
for forbidden in ("ordinal:", "scenario:", "path:"):
    if re.search(r"package func read\s*\([^)]*" + re.escape(forbidden), intake):
        raise SystemExit("ii-c0a intake regained caller-selected input")

for marker in (
    "projectedCohortInputPreservesV1CapsuleAndPairsEveryProjection",
    "projectedCohortInputDigestUsesExactZeroBeforeHashRule",
    "projectedCohortInputRejectsEveryBindingMismatch",
    "projectedCohortInputRejectsCountOrderAndDigestDrift",
    "projectedCohortInputRejectsNestedProjectionDrift",
    "projectedCohortInputRejectsEveryOuterStructuralDrift",
    "projectedCohortInputRejectsNestedCapsuleDrift",
    "encoded.count == 1_984",
    "a5096b18fc2741906a561bedcee18b3168c6d7472bad8e3167c7abbccf634801",
    "47ce5039abd62cdd4e3c5fc011c42af84d9539cb4ccdd26b0723b0fb47df890f",
):
    if transport.count(marker) != 1:
        raise SystemExit(f"ii-c0a transport coverage drifted: {marker}")
for marker in (
    "validCapsuleReadsOnlyFDZeroAndYieldsCanonicalRows",
    "legacyCapsuleWithoutProjectionIsRejected",
    "planAliasesShareOneNonReplayableCursor",
    r"selections.map(\.projection) == projections",
    r"selections.map(\.wholeInputSHA256)",
):
    if marker not in intake_test:
        raise SystemExit(f"ii-c0a intake coverage drifted: {marker}")
for marker in (
    "iiC0AProjectionCapsuleVerifierPinsContractAndScope",
    "--iic0a-projection-capsule-contract-only",
    "--iic0a-staged-scope-contract-only",
):
    if marker not in boundary:
        raise SystemExit(f"ii-c0a boundary regression drifted: {marker}")
expected_sha256 = {
    projection_path:
        "f60d4f92da42293ff044c29756fc55692ce354035f49b9a3ec415166c89b885a",
    intake_path:
        "d4898e6f9196a169d29107a40063238adf52d9fd8842e2bacdf9b433e09c1dd6",
}
for path, expected in expected_sha256.items():
    if __import__("hashlib").sha256(path.read_bytes()).hexdigest() != expected:
        raise SystemExit(f"ii-c0a canonical source drifted: {path}")
PY
}

function verify_iic0a_index_semantics() {
    local staged_root
    staged_root=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iic0a-index.XXXXXX")
    local staged_status=0
    git checkout-index --all --prefix="$staged_root/" \
        || staged_status=$?
    if (( staged_status == 0 )); then
        (
            cd "$staged_root"
            scripts/verify-investigation-boundaries \
                --iic0a-projection-capsule-contract-only \
                Sources/StornautInvestigationHandoffContract/InvestigationProjectedCohortInput.swift \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineFixedCapsuleIntake.swift \
                Tests/StornautInvestigationTests/InvestigationHandoffTransportContractTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineFixedCapsuleIntakeTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift \
                || exit $?
            scripts/verify-app-release-boundaries \
                --iic0a-source-contract-only \
                Sources/StornautInvestigationHandoffContract/InvestigationProjectedCohortInput.swift \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineFixedCapsuleIntake.swift \
                || exit $?
            python3 - <<'PY'
from pathlib import Path
import hashlib
import re

contract = Path("scripts/verify-contract").read_text(encoding="utf-8")
self_match = re.findall(r"(?m)^ib2_self_sha=([0-9a-f]{64})$", contract)
normalized = re.sub(
    r"(?m)^ib2_self_sha=.*$", "ib2_self_sha=SELF", contract
).encode("utf-8")
if (
    len(self_match) != 1
    or hashlib.sha256(normalized).hexdigest() != self_match[0]
):
    raise SystemExit("ii-c0a staged verifier self-seal drifted")
expected = dict(re.findall(
    r'Path\("(scripts/verify-(?:investigation|app)[^"]*)"\):\s*'
    r'"([0-9a-f]{64})"',
    contract,
))
for relative in (
    "scripts/verify-investigation-boundaries",
    "scripts/verify-app-release-boundaries",
):
    if hashlib.sha256(Path(relative).read_bytes()).hexdigest() != expected.get(relative):
        raise SystemExit(f"ii-c0a staged verifier source seal drifted: {relative}")
PY
        ) || staged_status=$?
    fi
    rm -rf "$staged_root"
    return $staged_status
}

function verify_iic0a_staged_scope() {
    local baseline=${1:-e4a95d4916a55a6bc2854c1b2168c98f7245cd0f}
    local expected=(
        Sources/StornautInvestigationHandoffContract/InvestigationProjectedCohortInput.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineFixedCapsuleIntake.swift
        Tests/StornautInvestigationTests/InvestigationHandoffTransportContractTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineFixedCapsuleIntakeTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 8 )) || { print -u2 "ii-c0a checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == e4a95d4916a55a6bc2854c1b2168c98f7245cd0f ]] || { print -u2 "ii-c0a checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" | grep -q .; then print -u2 "ii-c0a checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {f=1} END {exit !f}'; then print -u2 "ii-c0a binary checkpoint path rejected"; return 1; fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || { print -u2 "ii-c0a checkpoint paths drifted"; return 1; }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644; [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" == "$expected_mode 0 $expected_path" ]] || { print -u2 "ii-c0a checkpoint mode drifted: $expected_path"; return 1; }
    done
    local changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 2600 )) || { print -u2 "ii-c0a checkpoint budget drifted"; return 1; }
    verify_iic0a_index_semantics
}

