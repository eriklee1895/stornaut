    local expected_exports=$(print -rl -- \
        _stornaut_investigation_identity_for_pid \
        _stornaut_investigation_process_snapshot_for_pid \
        | LC_ALL=C sort)
    [[ "$exports" == "$expected_exports" ]] || { rm -rf "$object_dir"; print -u2 "ii-b5b-i-b2b-a object export drifted"; return 1; }
    local undefined=$(xcrun nm -u -j "$object_dir/identity.o" | LC_ALL=C sort -u)
    local expected_undefined=$(print -rl -- ___error ___memcpy_chk ___memset_chk ___stack_chk_fail ___stack_chk_guard _audit_token_to_asid _audit_token_to_euid _audit_token_to_pid _audit_token_to_pidversion _mach_port_deallocate _mach_task_self_ _memset _proc_pidinfo _task_info _task_name_for_pid | LC_ALL=C sort)
    local later_undefined=$(print -rl -- _audit_get_pinfo_addr _bzero _memcpy _sysctl | LC_ALL=C sort)
    local normalized_undefined=$(comm -23 \
        <(print -r -- "$undefined" | LC_ALL=C sort) \
        <(print -r -- "$later_undefined" | LC_ALL=C sort))
    [[ "$normalized_undefined" == "$expected_undefined" ]] || { rm -rf "$object_dir"; print -u2 "ii-b5b-i-b2b-a object authority drifted"; return 1; }
    rm -rf "$object_dir"
}

