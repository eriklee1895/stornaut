    "PRODUCT_MODULE_NAME = StornautInvestigationDiagnosticReleaseShellApp",
    "PRODUCT_BUNDLE_IDENTIFIER = "
        "com.eriklee.stornaut.investigation-diagnostic-release-shell",
):
    if required not in release_configuration:
        raise SystemExit(f"Release shell configuration drifted: {required}")
if "STORNAUT_INVESTIGATION_DIAGNOSTIC" in release_configuration:
    raise SystemExit("Release shell gained the Debug diagnostic condition")

driver_copy_phase = copy_by_name["Copy Investigation Machine Tools"][0]
driver_copy_body = copy_by_name["Copy Investigation Machine Tools"][2]
if (
    value(driver_copy_body, "dstPath") != "Contents/MacOS"
    or value(driver_copy_body, "dstSubfolderSpec") != "1"
):
    raise SystemExit("Machine driver copy destination drifted")
driver_copy_build_files = [
    object_id for object_id, _ in references(driver_copy_body, "files")
]
if len(driver_copy_build_files) != 3:
    raise SystemExit(
        "Copy Investigation Machine Tools must contain exactly three build files"
    )
expected_product_refs = set(tool_product_refs.values())
for copy_build_file in driver_copy_build_files:
    copy_build_body = build_files[copy_build_file][1]
    if reference(copy_build_body, "fileRef")[0] not in expected_product_refs:
        raise SystemExit("Machine tool copy phase references a wrong product")
    if re.search(
        r"settings = \{[ \t]*ATTRIBUTES = \("
        r"[ \t]*CodeSignOnCopy,[ \t]*\);[ \t]*\};",
        copy_build_body,
    ) is None:
        raise SystemExit(
            "Machine tool copy member must have exactly CodeSignOnCopy"
        )
code_sign_on_copy_build_files = [
    object_id
    for object_id, (_, body) in build_files.items()
    if "CodeSignOnCopy" in body
]
if set(code_sign_on_copy_build_files) != set(driver_copy_build_files):
    raise SystemExit(
        "CodeSignOnCopy must belong only to the three Machine tool copy members"
    )

copy_phase_owners = {}
for target_name, (_, body) in native_by_name.items():
    for phase_id, _ in references(body, "buildPhases"):
        if phase_id in copy_phases:
            copy_phase_owners.setdefault(phase_id, []).append(target_name)
expected_copy_owners = {
    copy_by_name["Copy Helper"][0]: ["StornautApp"],
    copy_by_name["Copy Investigation Helper"][0]: [diagnostic_name],
    driver_copy_phase: [diagnostic_name],
}
if copy_phase_owners != expected_copy_owners:
    raise SystemExit(
        f"Xcode copy phase ownership drifted: {copy_phase_owners!r}"
    )
diagnostic_phase_ids = [
    object_id
    for object_id, _ in references(diagnostic_body, "buildPhases")
]
if diagnostic_phase_ids.count(driver_copy_phase) != 1:
    raise SystemExit(
        "Diagnostic App must contain one separate Machine driver copy phase"
    )
for copy_build_file in driver_copy_build_files:
    memberships = [
        phase_id for phase_id, (_, body) in copy_phases.items()
        if copy_build_file in {object_id for object_id, _ in references(body, "files")}
    ]
    if memberships != [driver_copy_phase]:
        raise SystemExit("Machine tool copy member escaped its dedicated copy phase")

driver_free_targets = (
    "StornautApp",
    "StornautAppTests",
    "StornautAppUITests",
    "StornautLifecycleHelper",
    "StornautInvestigationDiagnosticAppTests",
    "StornautInvestigationDiagnosticReleaseShell",
)
driver_artifact_build_files = tool_artifact_build_files | set(driver_copy_build_files)
all_phase_objects = {**copy_phases, **source_phases, **framework_phases}
for target_name in driver_free_targets:
    _, body = native_by_name[target_name]
    dependency_ids = {
        object_id for object_id, _ in references(body, "dependencies")
    }
    if dependency_ids & set(tool_dependency_objects.values()):
        raise SystemExit(f"{target_name} gained Machine tool dependency")
    package_ids = {
        object_id
        for object_id, _ in references(
            body,
            "packageProductDependencies",
        )
    }
    if package_ids & set(tool_support_products.values()):
        raise SystemExit(f"{target_name} gained Machine tool support membership")
    target_phase_ids = {
        object_id for object_id, _ in references(body, "buildPhases")
    }
    if driver_copy_phase in target_phase_ids:
        raise SystemExit(f"{target_name} gained Machine driver copy phase")
    member_build_files = set()
    for phase_id in target_phase_ids:
        phase = all_phase_objects.get(phase_id)
        if phase is not None:
            member_build_files.update(
                object_id
                for object_id, _ in references(phase[1], "files")
            )
    escaped = member_build_files & driver_artifact_build_files
    if escaped:
        raise SystemExit(
            f"{target_name} gained Machine driver build membership: "
            f"{sorted(escaped)}"
        )


def load_scheme(path):
    try:
        return path.read_text(encoding="utf-8"), ET.parse(path).getroot()
    except (OSError, ET.ParseError) as error:
        raise SystemExit(f"Cannot parse Xcode scheme {path}: {error}")


ordinary_scheme_text, ordinary_scheme_root = load_scheme(ordinary_scheme_path)
diagnostic_scheme_text, diagnostic_scheme_root = load_scheme(
    diagnostic_scheme_path
)
expected_driver_entry = {
    "buildForTesting": "YES",
    "buildForRunning": "YES",
    "buildForProfiling": "NO",
    "buildForArchiving": "NO",
    "buildForAnalyzing": "YES",
}
for tool_name, product_name, _support_name, _main_path, _identifier in tool_specs:
    tool_id = tool_ids[tool_name]
    tool_identity = {tool_id, tool_name, product_name}
    if any(token in ordinary_scheme_text for token in tool_identity):
        raise SystemExit(f"Ordinary scheme gained Machine tool identity: {tool_name}")
    references_for_tool = [
        element for element in diagnostic_scheme_root.iter("BuildableReference")
        if tool_identity & {
            element.get("BlueprintIdentifier", ""),
            element.get("BlueprintName", ""),
            element.get("BuildableName", ""),
        }
    ]
    if len(references_for_tool) != 1:
        raise SystemExit(f"Diagnostic scheme Machine tool reference drifted: {tool_name}")
    tool_reference = references_for_tool[0]
    if tool_reference.attrib != {
        "BuildableIdentifier": "primary",
        "BlueprintIdentifier": tool_id,
        "BuildableName": product_name,
        "BlueprintName": tool_name,
        "ReferencedContainer": "container:Stornaut.xcodeproj",
    }:
        raise SystemExit(f"Diagnostic scheme Machine tool identity drifted: {tool_name}")
    entries = [
        entry for entry in diagnostic_scheme_root.findall(
            "./BuildAction/BuildActionEntries/BuildActionEntry"
        ) if tool_reference in entry.findall("./BuildableReference")
    ]
    expected_entry = dict(expected_driver_entry)
    if tool_name == "StornautInvestigationMachineGateCoordinatorNative":
        expected_entry["buildForTesting"] = "NO"
    if len(entries) != 1 or entries[0].attrib != expected_entry:
        raise SystemExit(f"Diagnostic scheme Machine tool entry drifted: {tool_name}")
    if diagnostic_scheme_text.count(tool_id) != 1:
        raise SystemExit(f"Diagnostic scheme Machine tool target ID drifted: {tool_name}")
