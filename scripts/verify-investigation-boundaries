    "snapshot.mode==0o600", "snapshot.linkCount==1",
    "snapshot.size>0",
    "snapshot.size<=InvestigationCohortCapsule.maximumByteCount",
    "snapshot.flags==0",
):
    if compact_valid.count(marker) != 1:
        raise SystemExit(f"ii-b5b-ii-a metadata policy drifted: {marker}")
if compact_intake.count("requiredOwnerUserID:uid_t=501") != 1:
    raise SystemExit("ii-b5b-ii-a fixed owner drifted")
if compact_intake.count("readChunkByteCount=16*1_024") != 1:
    raise SystemExit("ii-b5b-ii-a read bound drifted")
if compact_intake.count("maximumExtendedAttributeListBytes=4*1_024") != 1:
    raise SystemExit("ii-b5b-ii-a xattr bound drifted")

darwin = declaration(
    code,
    r"^struct\s+DarwinInvestigationMachineFixedCapsuleSystem\b",
    "Darwin adapter",
)
compact_darwin = compact(darwin)
fcntl_shapes = (
    "fcntl(descriptor,F_GETFD)",
    "fcntl(descriptor,F_GETFL)",
    "fcntl(descriptor,F_SETFD,flags)",
)
if len(re.findall(r"\bfcntl\s*\(", darwin)) != 3 or any(
    compact_darwin.count(shape) != 1 for shape in fcntl_shapes
):
    raise SystemExit("ii-b5b-ii-a exact fcntl shape drifted")
for marker in (
    "deviceID:UInt64(status.st_dev)",
    "inode:UInt64(status.st_ino)",
    "generation:status.st_gen",
    "isRegularFile:status.st_mode&S_IFMT==S_IFREG",
    "ownerUserID:status.st_uid", "ownerGroupID:status.st_gid",
    "mode:status.st_mode&0o7777",
    "linkCount:UInt64(status.st_nlink)", "size:status.st_size",
    "flags:status.st_flags",
    "modificationSeconds:Int64(status.st_mtimespec.tv_sec)",
    "modificationNanoseconds:Int64(status.st_mtimespec.tv_nsec)",
    "statusChangeSeconds:Int64(status.st_ctimespec.tv_sec)",
    "statusChangeNanoseconds:Int64(status.st_ctimespec.tv_nsec)",
):
    if compact_darwin.count(marker) != 1:
        raise SystemExit(f"ii-b5b-ii-a Darwin metadata mapping drifted: {marker}")
for marker in (
    "acl_get_fd_np(descriptor,ACL_TYPE_EXTENDED)",
    "Darwin.errno==ENOENT?.success(false):.failure(.init(errno:Darwin.errno))",
    "acl_get_entry(acl,Int32(ACL_FIRST_ENTRY.rawValue),&entry)",
    "guardresult>=0else{", "return.success(result==0)",
    "flistxattr(descriptor,nil,0,0)", "return.success(count>0)",
):
    if compact_darwin.count(marker) != 1:
        raise SystemExit(f"ii-b5b-ii-a ACL or xattr semantics drifted: {marker}")

forbidden_patterns = (
    r"(?<![A-Za-z0-9_])(?:Darwin\.)?open(?:at)?\s*\(",
    r"\b(?:path|fileURL|root)\b",
    r"\b(?:func|init)\s*\([^)]*(?:ordinal|scenario)\s*:",
    r"\b(?:URL|URLComponents|FilePath|FileHandle|FileManager)\b",
    r"\b(?:JSONDecoder|JSONEncoder|JSONSerialization|Codable|Encodable|Decodable)\b",
