    r'"([0-9a-f]{64})"',
    contract,
)
if (
    len(boundary_match) != 1
    or hashlib.sha256(boundary).hexdigest() != boundary_match[0]
):
    raise SystemExit("ii-b5b-ii-a staged boundary seal drifted")
for marker in (
    "iib5biia_baseline=ddbc4a0be3ea059c7de239b85ef60c40c09affbb",
    "--iib5biia-fixed-capsule-contract-only",
    "--iib5biia-staged-scope-contract-only",
