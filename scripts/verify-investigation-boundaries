if bridge.count("1...InvestigationMachineClaimEvidence.maximumByteCount") != 2:
    fail("iii-b2b-1a-0 ownership field shape drifted")
if bridge.count("bridgeClaimEvidenceIsBound(") != 4:
    fail("iii-b2b-1a-0 semantic join call shape drifted")

