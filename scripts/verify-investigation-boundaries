function verify_iib3c_concrete_entry_contract() {
    local leaf_path=$1 adapter_path=$2 composition_path=$3 harness_path=$4
    python3 - "$leaf_path" "$adapter_path" "$composition_path" "$harness_path" <<'PY'
from pathlib import Path
import re
import sys

leaf_path, adapter_path, composition_path, harness_path = map(Path, sys.argv[1:])
leaf = leaf_path.read_text(encoding="utf-8")
adapter = adapter_path.read_text(encoding="utf-8")
composition = composition_path.read_text(encoding="utf-8")
harness = harness_path.read_text(encoding="utf-8")

def code_only(value, label):
    output = list(value)
    index = 0
    block_depth = 0
    delimiter = None
    while index < len(value):
        if block_depth:
            if value.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif value.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if value[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if delimiter is not None:
            if value.startswith(delimiter, index):
                width = len(delimiter)
                output[index:index + width] = " " * width
                delimiter = None
                index += width
            elif delimiter == '"' and value[index] == "\\":
                output[index] = " "
                if index + 1 < len(value):
                    output[index + 1] = " "
                index += 2
            else:
                if value[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if value.startswith("//", index):
            end = value.find("\n", index)
            end = len(value) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif value.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif value.startswith('"""', index):
            output[index:index + 3] = "   "
            delimiter = '"""'
            index += 3
        elif value[index] == '"':
            output[index] = " "
            delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or delimiter is not None:
        raise SystemExit(f"ii-b3c {label} has unterminated text")
    return "".join(output)

def compact(value):
    return re.sub(r"\s+", "", value)

leaf_code = code_only(leaf, "leaf")
adapter_code = code_only(adapter, "adapter")
raw_concrete_end = composition.find(
    "public final class InvestigationRuntimeDiagnosticComposition"
)
if raw_concrete_end < 0:
    raise SystemExit("ii-b3c concrete region delimiter is missing")
if "\\(" in composition[:raw_concrete_end]:
    raise SystemExit(
        "ii-b3c concrete region contains Swift string interpolation"
    )
composition_code = code_only(composition, "composition")
harness_code = code_only(harness, "harness")

entry_start = leaf_code.find("package final class InvestigationHandoffAppLeafEntryAdmission")
if entry_start < 0:
    raise SystemExit("ii-b3c entry admission is missing")
entry = leaf_code[entry_start:]
if len(re.findall(r"(?m)^\s*public\s+static\s+func\s+run\(\)\s+async\s+->\s+Int32", entry)) != 1:
    raise SystemExit("ii-b3c public async entry surface drifted")
if len(re.findall(r"(?m)^\s*public\s+", entry)) != 2:
    raise SystemExit("ii-b3c public entry surface widened")
entry_compact = compact(entry)
claim_contract = compact("""
package func claim() -> Bool {
    lock.withLock {
        guard !consumed else { return false }
        consumed = true
        return true
    }
}
""")
if entry_compact.count(claim_contract) != 1:
    raise SystemExit(
        "ii-b3c entry admission claim linearization drifted"
    )
for required in (
    "private let lock = NSLock()",
    "package func claim() -> Bool",
    "lock.withLock {",
    "guard !consumed else { return false }",
    "consumed = true",
    "private static let admission = InvestigationHandoffAppLeafEntryAdmission()",
    "guard admission.claim() else",
    "let adapter = InvestigationHandoffAppLeafAdapter(system: .system)",
    "let peer = try await adapter.admitPeerAndBootstrap()",
    "let operations = try InvestigationHandoffConcreteAppLeafOperations(",
    "return try await leaf.run()",
):
    if compact(required) not in entry_compact:
        raise SystemExit(f"ii-b3c entry contract drifted: {required}")

adapter_compact = compact(adapter_code)
for required in (
    "package protocol InvestigationHandoffAppLeafAdapting: Sendable",
    "package actor InvestigationHandoffAppLeafAdapter: InvestigationHandoffAppLeafAdapting",
):
    if compact(required) not in adapter_compact:
        raise SystemExit(f"ii-b3c adapter seam drifted: {required}")
if "public protocol InvestigationHandoffAppLeafAdapting" in adapter_code:
    raise SystemExit("ii-b3c adapter seam became public")

concrete_end = composition_code.find("public final class InvestigationRuntimeDiagnosticComposition")
if concrete_end < 0:
    raise SystemExit("ii-b3c concrete region delimiter is missing")
concrete = composition_code[:concrete_end]
concrete_compact = compact(concrete)
for required in (
    "package actor InvestigationHandoffConcreteAppLeafOperations",
    "package enum InvestigationHandoffNoAuthRetirement",
    "decoded.canonicalJSONData() == bytes",
    "guard wireSHA.lowercaseHex == machineSHA else",
    "decoded.capabilityEvidenceBindingSHA256()",
    "peer.signingEvidence.executableSHA256 == binding.executableSHA256",
    "peer.signingEvidence.identity.signingIdentifier == binding.signingIdentifier",
    "peer.signingEvidence.identity.designatedRequirementSHA256 == binding.designatedRequirementSHA256",
    "peer.signingEvidence.identity.codeDirectoryHash == binding.codeDirectoryHash",
    "transport.startAndRetireWithEvidence()",
    "evidenceStore.consume()",
    "guard let stored = await evidenceStore.consume(), stored == returned else",
    "session.invalidate()",
    "private enum Phase: Equatable",
    "case operation(UUID)",
    "case retiring(UUID)",
    "try Task.checkCancellation()",
    "guard phase == expected else",
    "validRetirementDeadline(",
    "let maximum = completed.addingReportingOverflow(30_000_000)",
    "validBeforeMicroseconds > completed",
    "validBeforeMicroseconds <= configuration",
    "validBeforeMicroseconds <= maximum.partialValue",
):
    if compact(required) not in concrete_compact:
        raise SystemExit(f"ii-b3c concrete contract drifted: {required}")
if concrete_compact.count(compact(
    "guard machineDriverMatchesPeer(decoded.binding.machineDriver) else"
)) != 1:
    raise SystemExit("ii-b3c concrete peer binding guard drifted")
for forbidden in (
    "prepareRoot", "writeLine", "readLine",
    "CodexInteractiveAppServerClient", "currentAuthSourceURL",
    "InvestigationRuntimeDiagnosticFacade", "ProbeBroker",
    "ActionExecutor", "MoveToTrash", "RegisteredAction",
    "DispatchSemaphore", "dispatch_semaphore",
):
    if re.search(rf"(?<![A-Za-z0-9_]){re.escape(forbidden)}(?![A-Za-z0-9_])", concrete):
        raise SystemExit(f"ii-b3c concrete authority widened: {forbidden}")
for public_type in (
    "InvestigationHandoffConcreteAppLeafOperations",
    "InvestigationHandoffNoAuthRetirement",
    "InvestigationHandoffAppLeafEntryAdmission",
):
    if re.search(rf"(?m)^\s*public\s+(?:actor|class|final class|enum|struct)\s+{public_type}\b", leaf_code + concrete):
        raise SystemExit(f"ii-b3c concrete type became public: {public_type}")

harness_compact = compact(harness_code)
for required in (
    "handoffEntry: @escaping @Sendable () async -> Int32",
    "return await handoffEntry()",
    "InvestigationHandoffDescriptorAdmission.admits(",
):
    if compact(required) not in harness_compact:
        raise SystemExit(f"ii-b3c async harness drifted: {required}")
PY
}

function verify_iib3c_staged_scope() {
    local baseline=${1:-HEAD}
    local expected=(
        Sources/StornautInvestigationDiagnostic/InvestigationHandoffAppLeaf.swift
        Sources/StornautInvestigationDiagnostic/InvestigationHandoffAppLeafAdapter.swift
        Sources/StornautInvestigationDiagnostic/InvestigationRuntimeDiagnosticComposition.swift
        StornautApp/Diagnostics/InvestigationRuntimeDiagnosticHarness.swift
        StornautAppTests/InvestigationRuntimeDiagnosticTests.swift
        Tests/StornautInvestigationTests/InvestigationHandoffAppLeafTests.swift
        Tests/StornautInvestigationTests/InvestigationHandoffConcreteCompositionTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0, "docs/") != 1')"})
    if git diff --cached --name-status "$baseline" \
        | awk '$1 == "D" && index($2, "docs/") != 1 { found = 1 } END { exit !found }'
    then
        print -u2 "ii-b3c staged checkpoint deleted a required path"
        return 1
    fi
    [[ "${(j:\n:)${(on)observed}}" == "${(j:\n:)${(on)expected}}" ]] || {
        print -u2 "ii-b3c staged checkpoint paths drifted"
        return 1
    }
    local changed
    changed=$(git diff --cached --numstat "$baseline" | awk 'index($3, "docs/") != 1 {total += $1 + $2} END {print total + 0}')
    (( changed <= 2800 )) || {
        print -u2 "ii-b3c staged checkpoint budget drifted"
        return 1
    }
}

function verify_retirement_handle_v3_contract() {
    local lifecycle_source=$1
    local adapter_source=$2
    python3 - "$lifecycle_source" "$adapter_source" <<'PY'
from pathlib import Path
import re
import sys


def code_only(source, label):
    output = list(source)
    index = 0
    block_depth = 0
    delimiter = None
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if delimiter is not None:
            if source.startswith(delimiter, index):
                width = len(delimiter)
                output[index:index + width] = " " * width
                delimiter = None
                index += width
            elif delimiter == '"' and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source):
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif source.startswith('"""', index):
            output[index:index + 3] = "   "
            delimiter = '"""'
            index += 3
        elif source[index] == '"':
            output[index] = " "
            delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or delimiter is not None:
        raise SystemExit(
            f"retirement handle {label} has unterminated text"
        )
    return "".join(output)


def declaration(source, pattern, label):
    match = re.search(pattern, source, re.MULTILINE)
    if match is None:
        raise SystemExit(f"retirement handle {label} missing")
    opening = source.find("{", match.end())
    if opening < 0:
        raise SystemExit(f"retirement handle {label} has no body")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    raise SystemExit(f"retirement handle {label} is unterminated")


def compact(source):
    return re.sub(r"\s+", "", source)


lifecycle_path, adapter_path = map(Path, sys.argv[1:])
lifecycle = code_only(
    lifecycle_path.read_text(encoding="utf-8"), "Lifecycle source"
)
adapter = code_only(
    adapter_path.read_text(encoding="utf-8"), "server adapter"
)
handle = declaration(
    lifecycle,
    r"^public\s+struct\s+LifecycleMachineRetirementHandle\s*:",
    "v3 declaration",
)
if not re.search(
    r"public\s+static\s+let\s+protocolVersion\s*=\s*3\b",
    handle,
):
    raise SystemExit("retirement handle protocol version drifted")
top_level_property_lines = []
depth = 0
property_keyword = re.compile(r"(?<![A-Za-z0-9_])(?:let|var)(?![A-Za-z0-9_])")
for line in handle.splitlines():
    stripped = line.strip()
    if depth == 1 and stripped.startswith("@"):
        raise SystemExit(
            "retirement handle canonical storage drifted: "
            f"top-level attribute {stripped!r}"
        )
    if depth == 1 and property_keyword.search(stripped):
        top_level_property_lines.append(re.sub(r"\s+", "", stripped))
    depth += line.count("{") - line.count("}")
expected_property_lines = [
    "publicstaticletprotocolVersion=3",
    "publiclettoken:UUID",
    "publicletinvestigationID:LifecycleInvestigationID",
    "publicletretireOperationID:UUID",
    "publicletconfigurationSHA256:String",
    "publicletvalidBeforeUTCMicroseconds:Int64",
    "publicvarvalidBefore:Date{",
]
if top_level_property_lines != expected_property_lines:
    raise SystemExit(
        "retirement handle canonical storage drifted: "
        f"{top_level_property_lines!r}"
    )
projection = declaration(
    handle, r"public\s+var\s+validBefore\s*:\s*Date",
    "computed Date projection",
)
if "TimeInterval(validBeforeUTCMicroseconds)/1_000_000" not in compact(
    projection
):
    raise SystemExit("retirement handle Date projection drifted")
coding_keys = declaration(
    handle, r"private\s+enum\s+CodingKeys\s*:", "CodingKeys"
)
observed_keys = re.findall(r"(?m)^\s*case\s+(\w+)\s*$", coding_keys)
expected_keys = [
    "protocolVersion",
    "token",
    "investigationID",
    "retireOperationID",
    "configurationSHA256",
    "validBeforeUTCMicroseconds",
]
if observed_keys != expected_keys:
    raise SystemExit(
        f"retirement handle coding keys drifted: {observed_keys!r}"
    )
decoder = declaration(
    handle, r"public\s+init\s*\(\s*from\s+decoder", "decoder"
)
decoder_compact = compact(decoder)
if (
    "container.decode(Int64.self,forKey:.init(CodingKeys."
    "validBeforeUTCMicroseconds.rawValue))" not in decoder_compact
    or "container.decode(Date.self" in decoder_compact
):
    raise SystemExit("retirement handle integer decoder drifted")
if r"machineStrictContainer(decoder,keys:Set(CodingKeys.allCases.map(\.rawValue)))" \
        not in decoder_compact:
    raise SystemExit("retirement handle strict decoder drifted")
encoder = declaration(
    handle, r"public\s+func\s+encode\s*\(", "encoder"
)
encoder_compact = compact(encoder)
if (
    "container.encode(validBeforeUTCMicroseconds,forKey:.init("
    "CodingKeys.validBeforeUTCMicroseconds.rawValue))" not in encoder_compact
    or re.search(
        r"container\.encode\(validBefore(?!UTCMicroseconds)",
        encoder_compact,
    )
):
    raise SystemExit("retirement handle integer encoder drifted")
date_initializer = declaration(
    handle, r"public\s+init\s*\(\s*token\s*:",
    "Date initializer",
)
if compact(date_initializer).count(
    "machineUTCMicroseconds(validBefore)"
) != 1:
    raise SystemExit("retirement handle Date quantization drifted")
integer_initializer = declaration(
    handle, r"fileprivate\s+init\s*\(\s*token\s*:",
    "integer initializer",
)
if (
    "validBeforeUTCMicroseconds>0" not in compact(integer_initializer)
    or "self.validBeforeUTCMicroseconds=validBeforeUTCMicroseconds"
        not in compact(integer_initializer)
):
    raise SystemExit("retirement handle integer initializer drifted")

quantizer = declaration(
    lifecycle, r"^private\s+func\s+machineUTCMicroseconds\s*\(",
    "Date quantizer",
)
quantizer_compact = compact(quantizer)
for marker in (
    "seconds.isFinite",
    "seconds>0",
    "scaled.isFinite",
    "scaled>=1",
    "scaled<Double(Int64.max)",
    "Int64(scaled.rounded(.down))",
):
    if marker not in quantizer_compact:
        raise SystemExit(
            f"retirement handle checked quantizer drifted: {marker}"
        )

transfer = declaration(
    lifecycle,
    r"^package\s+struct\s+LifecycleMachineRetirementReservationTransfer",
    "reservation transfer",
)
if not re.search(
    r"(?m)^\s*package\s+let\s+validBeforeUTCMicroseconds"
    r"\s*:\s*Int64\s*$",
    transfer,
) or re.search(
    r"(?m)^\s*package\s+let\s+validBefore\s*:\s*Date\s*$",
    transfer,
):
    raise SystemExit(
        "retirement reservation transfer canonical deadline drifted"
    )
transfer_initializer = declaration(
    transfer, r"init\s*\(\s*reservationID\s*:",
    "reservation transfer initializer",
)
transfer_initializer_compact = compact(transfer_initializer)
if (
    "reservationID:UUID" not in transfer_initializer_compact
    or "self.reservationID=reservationID"
        not in transfer_initializer_compact
    or "validBeforeUTCMicroseconds:Int64"
        not in transfer_initializer_compact
    or "self.validBeforeUTCMicroseconds=validBeforeUTCMicroseconds"
        not in transfer_initializer_compact
):
    raise SystemExit(
        "retirement reservation transfer initializer drifted"
    )
escrow = declaration(
    lifecycle,
    r"^public\s+final\s+class\s+LifecycleMachineRetirementEscrow",
    "escrow owner",
)
entry = declaration(escrow, r"fileprivate\s+struct\s+Entry", "Entry")
if not re.search(
    r"(?m)^\s*let\s+validBeforeUTCMicroseconds\s*:\s*Int64\s*$",
    entry,
) or re.search(
    r"(?m)^\s*let\s+validBefore\s*:\s*Date\s*$", entry
):
    raise SystemExit(
        "retirement escrow entry canonical deadline drifted"
    )
transfer_method = declaration(
    escrow, r"package\s+func\s+transferReservation\s*\(",
    "one-shot transfer",
)
transfer_compact = compact(transfer_method)
if (
    "validBeforeUTCMicroseconds:entry.validBeforeUTCMicroseconds"
        not in transfer_compact
    or "validBefore:entry.validBefore" in transfer_compact
):
    raise SystemExit("retirement escrow transfer deadline drifted")
record = declaration(
    escrow, r"public\s+func\s+record\s*\(", "record"
)
record_compact = compact(record)
if (
    record_compact.count("machineUTCMicroseconds(validBefore)") != 1
    or record_compact.count(
        "validBeforeUTCMicroseconds:validBeforeUTCMicroseconds"
    ) != 2
):
    raise SystemExit("retirement escrow single quantization drifted")
claim = declaration(
    escrow, r"private\s+func\s+claimLocked\s*\(", "legacy claim"
)
claim_compact = compact(claim)
if (
    "request.handle.validBeforeUTCMicroseconds=="
    "entry.validBeforeUTCMicroseconds" not in claim_compact
    or "request.handle.validBefore==entry.validBefore" in claim_compact
):
    raise SystemExit("retirement legacy claim integer binding drifted")

server_projection = declaration(
    adapter,
    r"private\s+struct\s+InvestigationMachineClaimServerProjection",
    "server projection",
)
server_initializer = declaration(
    server_projection, r"init\s*\(\s*transfer\s*:",
    "server projection initializer",
)
server_compact = compact(server_initializer)
if (
    "validBefore=tryInvestigationHandoffUTCMicroseconds("
    "rawValue:transfer.validBeforeUTCMicroseconds)" not in server_compact
    or re.search(r"transfer\.validBefore\b", server_initializer)
):
    raise SystemExit(
        "claim server valid-before direct projection drifted"
    )
PY
}

function verify_legacy_machine_claim_contract() {
    local lifecycle_source=$1
    local helper_source=$2
    local host_source=$3
    local claim_source=$4
    python3 - "$lifecycle_source" "$helper_source" \
        "$host_source" "$claim_source" <<'PY'
from pathlib import Path
import re
import sys


def code_only(source, label):
    output = list(source)
    index = 0
    block_depth = 0
    delimiter = None
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if delimiter is not None:
            if source.startswith(delimiter, index):
                width = len(delimiter)
                output[index:index + width] = " " * width
                delimiter = None
                index += width
            elif delimiter == '"' and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source):
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif source.startswith('"""', index):
            output[index:index + 3] = "   "
            delimiter = '"""'
            index += 3
        elif source[index] == '"':
            output[index] = " "
            delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or delimiter is not None:
        raise SystemExit(f"legacy machine claim {label} has unterminated text")
    return "".join(output)


def declaration(source, pattern, label):
    match = re.search(pattern, source, re.MULTILINE | re.DOTALL)
    if match is None:
        raise SystemExit(f"legacy machine claim {label} missing")
    opening = source.find("{", match.end())
    if opening < 0:
        raise SystemExit(f"legacy machine claim {label} has no body")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1], source[opening + 1:index]
    raise SystemExit(f"legacy machine claim {label} is unterminated")


lifecycle_path, helper_path, host_path, claim_path = map(Path, sys.argv[1:])
lifecycle_raw = lifecycle_path.read_text(encoding="utf-8")
helper_raw = helper_path.read_text(encoding="utf-8")
host_raw = host_path.read_text(encoding="utf-8")
claim_raw = claim_path.read_text(encoding="utf-8")
lifecycle = code_only(lifecycle_raw, "Lifecycle source")
helper = code_only(helper_raw, "helper source")
host = code_only(host_raw, "Machine host")
claim = code_only(claim_raw, "Machine claim source")

if re.search(
    r"@objc\s+private\s+protocol\s+LifecycleMachineClaimXPCWire\b",
    helper,
):
    raise SystemExit("legacy machine claim server-only wire remains")
if helper_raw.count(
    'private let machineClaimServiceName =\n'
    '    "com.eriklee.stornaut.lifecycle.machine-claim"'
) != 1:
    raise SystemExit(
        "live machine claim fixed helper service drifted"
    )
if helper.count("machineClaimServiceName") != 2:
    raise SystemExit(
        "live machine claim helper service selection cardinality drifted"
    )

for marker in (
    "LifecycleMachineClaimXPCWire",
    "public actor LifecycleMachineClaimXPCClient",
    "LifecycleMachineClaimXPCClient()",
    "LifecycleMachineClaimXPCServerNamespace",
    "LifecycleMachineClaimXPCReplyResolver",
    "LifecycleMachineClaimResult",
    "LifecycleMachineClaimXPCError",
    "proxy as? LifecycleMachineClaimXPCWire",
    "with: LifecycleMachineClaimXPCWire.self",
    "machServiceName: LifecycleMachineClaimXPCClient.serviceName",
):
    if marker in lifecycle:
        raise SystemExit(
            f"legacy machine claim concrete client remains: {marker}"
        )
for marker in (
    "LifecycleMachineClaimXPCClient",
    "LifecycleMachineClaimXPCServerNamespace",
    "LifecycleMachineClaimXPCReplyResolver",
    "remoteObjectProxy",
    "activeConnection",
):
    if marker in helper:
        raise SystemExit(
            f"legacy machine claim helper gained client authority: {marker}"
        )

combined_machine = host + "\n" + claim
for marker in (
    "LifecycleMachineClaimXPCClient",
    "LifecycleMachineClaimXPCWire",
    "LifecycleMachineClaimXPCError",
    "NSXPCConnection",
    "LifecycleLocalInstallationContract",
    "helperExecutableURL",
    "SecurityLifecycleCodeSigningVerifier",
):
    if marker in combined_machine:
        raise SystemExit(
            f"legacy machine claim Machine consumer remains: {marker}"
        )

strict_source, _ = declaration(
    host,
    r"struct\s+StrictMachineRetirementClaimSource\s*:",
    "injected Machine source",
)
if strict_source.count("init(") != 1 or re.search(
    r"init\s*\(\s*fetch:", strict_source
) is None:
    raise SystemExit(
        "legacy machine claim injected source initializer drifted"
    )
for marker in (
    "init()",
    "serviceName",
    "machServiceName",
    "remoteObject",
    "activeConnection",
):
    if marker in strict_source:
        raise SystemExit(
            f"legacy machine claim injected source gained transport: {marker}"
        )

_, production_body = declaration(
    host,
    r"static\s+func\s+production\s*\(",
    "production factory",
)
normalized_production = re.sub(r"\s+", "", production_body)
expected_production = (
    "_=(configuration,appProcessIdentity,userID,handoff,transition,"
    "effectiveUserID,now)"
    "throwInvestigationMachineDriverHostError.implementationUnavailable"
)
if normalized_production != expected_production:
    raise SystemExit(
        "legacy machine claim production is not immediately typed unavailable"
    )

source_error, _ = declaration(
    claim,
    r"enum\s+InvestigationMachineRetirementClaimSourceError\s*:",
    "Machine-local source error",
)
if (
    "case outcomeUnknown" not in source_error
    or "public " in source_error
    or "package " in source_error
):
    raise SystemExit(
        "legacy machine claim Machine-local source error drifted"
    )
outcome_catch = re.search(
    r"catch\s+InvestigationMachineRetirementClaimSourceError"
    r"\.outcomeUnknown\s*\{(?P<body>.*?)\}",
    claim,
    re.DOTALL,
)
if outcome_catch is None:
    raise SystemExit(
        "legacy machine claim outcome-unknown mapping is missing"
    )
outcome_body = re.sub(r"\s+", "", outcome_catch.group("body"))
if outcome_body != (
    "throwInvestigationMachineRetirementClaimError.outcomeUnknown"
):
    raise SystemExit(
        "legacy machine claim external-state outcome priority drifted"
    )
PY
}

function verify_claim_server_contract() {
    local adapter_source=$1
    local effects_source=$2
    local deadline_source=$3
    python3 - "$adapter_source" "$effects_source" "$deadline_source" <<'PY'
from pathlib import Path
import re
import sys


def code_only(source, label):
    output = list(source)
    index = 0
    block_depth = 0
    delimiter = None
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if delimiter is not None:
            if source.startswith(delimiter, index):
                width = len(delimiter)
                output[index:index + width] = " " * width
                delimiter = None
                index += width
            elif delimiter == '"' and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source):
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        elif source.startswith('"""', index):
            output[index:index + 3] = "   "
            delimiter = '"""'
            index += 3
        elif source[index] == '"':
            output[index] = " "
            delimiter = '"'
            index += 1
        else:
            index += 1
    if block_depth or delimiter is not None:
        raise SystemExit(f"{label} has an unterminated comment or string")
    return "".join(output)


def body(source, pattern, label):
    match = re.search(pattern, source)
    if match is None:
        raise SystemExit(f"claim server {label} drifted: {pattern}")
    opening = source.find("{", match.end())
    if opening < 0:
        raise SystemExit(f"claim server {label} has no body: {pattern}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[match.start():index + 1]
    raise SystemExit(f"claim server {label} body is unterminated: {pattern}")


def bodies(source, pattern, label):
    results = []
    for match in re.finditer(pattern, source):
        opening = source.find("{", match.end())
        if opening < 0:
            raise SystemExit(f"claim server {label} has no body: {pattern}")
        depth = 0
        for index in range(opening, len(source)):
            if source[index] == "{":
                depth += 1
            elif source[index] == "}":
                depth -= 1
                if depth == 0:
                    results.append(source[match.start():index + 1])
                    break
        else:
            raise SystemExit(
                f"claim server {label} body is unterminated: {pattern}"
            )
    return results


def require_patterns(source, patterns, label):
    for pattern in patterns:
        if re.search(pattern, source) is None:
            raise SystemExit(f"claim server {label} drifted: {pattern}")


adapter_path, effects_path, deadline_path = map(Path, sys.argv[1:])
raw_sources = {
    "adapter": adapter_path.read_text(encoding="utf-8"),
    "effects": effects_path.read_text(encoding="utf-8"),
    "deadline": deadline_path.read_text(encoding="utf-8"),
}
for source_name, source in raw_sources.items():
    if re.search(r"#+(?:\"|/)", source):
        raise SystemExit(
            f"claim server {source_name} gained raw literal or regex"
        )
adapter = code_only(raw_sources["adapter"], "adapter")
effects = code_only(raw_sources["effects"], "effects")
deadline = code_only(raw_sources["deadline"], "deadline")
for source_name, source in (
    ("adapter", adapter), ("effects", effects), ("deadline", deadline),
):
    if re.search(r"(?m)^\s*#(?:if|elseif|else|endif)\b", source):
        raise SystemExit(
            f"claim server {source_name} gained conditional compilation"
