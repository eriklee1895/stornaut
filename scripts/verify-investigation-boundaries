        "${p[@]}" <<'PY'
from pathlib import Path
import re, sys
if len(sys.argv) != 16: raise SystemExit("shared-deadline source cardinality drifted")
mutation_mode, mutation_slot, mutation_sha = sys.argv[1:4]
slot_names = ("contract","author","composition","runner","machine","configuration","coordinator","ct","dt","lt","st","gt")
raw_sources = tuple(Path(x).read_text() for x in sys.argv[4:])
import hashlib
expected = (
