import json
import hashlib
from pathlib import Path
import re
import sys

package = json.loads(sys.argv[1])
manifest = json.loads(sys.argv[2])
targets = {target["name"]: target for target in package["targets"]}
handoff = targets.get("StornautInvestigationHandoffContract")
if handoff is None:
    raise SystemExit("missing StornautInvestigationHandoffContract target")
if set(handoff.get("target_dependencies", [])):
    raise SystemExit("handoff contract gained a target dependency")
if Path(handoff.get("path", "")) != Path(
    "Sources/StornautInvestigationHandoffContract"
):
    raise SystemExit("handoff contract target path drifted")
expected_handoff_sources = {
    "HandoffBinaryTranscript.swift",
    "InvestigationInstalledL2ProjectionContract.swift",
    "InvestigationHandoffEpochBootstrapContract.swift",
    "InvestigationHandoffFrameContract.swift",
    "InvestigationCohortCapsuleContract.swift",
    "InvestigationMachineClaimContract.swift",
}
if set(handoff.get("sources", [])) != expected_handoff_sources:
    raise SystemExit("handoff contract source allowlist drifted")
if any("StornautInvestigationHandoffContract" in product.get("targets", [])
       for product in package.get("products", [])):
    raise SystemExit("handoff contract became a package product")
consumers = {target["name"] for target in package["targets"]
             if "StornautInvestigationHandoffContract"
             in target.get("target_dependencies", [])}
if consumers != {
    "StornautInvestigationDiagnostic",
    "StornautInvestigationInstalledL2",
    "StornautInvestigationMachineClaimServer",
    "StornautInvestigationMachineDriverSupport",
    "StornautInvestigationTests",
}:
    raise SystemExit(f"handoff contract consumers drifted: {sorted(consumers)}")
expected_imports = {
    "HandoffBinaryTranscript.swift": {"CryptoKit", "Foundation"},
    "InvestigationInstalledL2ProjectionContract.swift": {"Foundation"},
    "InvestigationHandoffEpochBootstrapContract.swift": {"Foundation"},
    "InvestigationHandoffFrameContract.swift": {"Foundation"},
    "InvestigationCohortCapsuleContract.swift": {"Foundation"},
    "InvestigationMachineClaimContract.swift": {"Foundation"},
}
handoff_forbidden = re.compile(
    r"\b(?:Codable|NSXPC|Process|FileManager|URLSession|posix_spawn|"
    r"O_WRONLY|O_RDWR|O_CREAT|Darwin\.write)\b|import\s+Stornaut"
)
for source_name in expected_handoff_sources:
    text = (Path(handoff["path"]) / source_name).read_text(encoding="utf-8")
    imports = set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", text))
    public_count = text.count("public ")
    public_valid = (
        source_name == "InvestigationMachineClaimContract.swift"
        and public_count == 1
        and "public protocol InvestigationMachineClaimXPCWire" in text
        and "@objc(StornautInvestigationMachineClaimXPCWire)" in text
    ) or (source_name != "InvestigationMachineClaimContract.swift"
          and public_count == 0)
    if imports != expected_imports[source_name] or not public_valid:
        raise SystemExit(f"handoff contract surface drifted: {source_name}")
    match = handoff_forbidden.search(text)
    if match:
        raise SystemExit(f"handoff contract gained authority: {source_name}: {match.group(0)!r}")
    forbidden_runtime = re.search(
            r"\b(?:NSXPCConnection|NSXPCListener|DispatchSource|"
            r"DispatchQueue|RunLoop|ContinuousClock|SuspendingClock|"
            r"CFAbsoluteTimeGetCurrent|mach_continuous_time|mach_wait_until|"
            r"clock_gettime|gettimeofday|mach_absolute_time|FileHandle|"
            r"InputStream|OutputStream|FileWrapper|NSData|NSLock)\b|"
            r"\b(?:Timer|Date|nanosleep|usleep|sleep)\s*\(|"
            r"\bDate\s*\.\s*now\b|"
            r"\bTask\s*\.\s*(?:sleep|detached)\b|"
            r"ProcessInfo\s*\.\s*processInfo\s*\.\s*systemUptime|"
            r"\b(?:Data|String)\s*\(\s*contentsOf\s*:|"
            r"\.\s*write\s*\(\s*to\s*:|"
            r"\bDarwin\s*\.\s*(?:open|read)\b|"
            r"\b(?:pread|stat|lstat|fstat|readlink|opendir|readdir|closedir)"
            r"\s*\(|\bactor\s+|\bclass\s+|\bstatic\s+var\s+|"
            r"import\s+Security",
        text,
    )
    if forbidden_runtime:
        raise SystemExit(
            "handoff contract gained runtime ownership: "
            f"{source_name}: {forbidden_runtime.group(0)!r}"
        )
core = targets["StornautCore"]
dependencies = set(core.get("target_dependencies", []))
