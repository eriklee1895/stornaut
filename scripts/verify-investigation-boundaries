def fail(message):
    raise SystemExit(message)

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

def swift_code_only(source):
    output = list(source)
    index = 0
    block_depth = 0
    string_end = None
    raw_hashes = ""
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if string_end is not None:
            if source.startswith(string_end, index):
                width = len(string_end)
                output[index:index + width] = " " * width
                index += width
                string_end = None
                raw_hashes = ""
            elif not raw_hashes and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source) and source[index + 1] != "\n":
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        else:
            opener = re.match(r'(#+)?("""|")', source[index:])
            if opener is None:
                index += 1
                continue
            hashes = opener.group(1) or ""
            quote = opener.group(2)
            width = len(opener.group(0))
            output[index:index + width] = " " * width
            string_end = quote + hashes
            raw_hashes = hashes
            index += width
    if block_depth or string_end is not None:
        fail("iii-b2b-1a-0 Swift lexical scan drifted")
    return "".join(output)

def swift_parse_tree(path):
    completed = subprocess.run(
        ["xcrun", "swiftc", "-frontend", "-dump-parse", str(path)],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    if completed.returncode != 0:
        fail("iii-b2b-1a-0 Swift lexical scan drifted")
    return completed.stdout

composition_code = swift_code_only(composition)
bridge_code = swift_code_only(bridge)

if imports(composition_code) != {
    "Foundation", "StornautInvestigationHandoffContract",
    "StornautInvestigationInstalledL2",
} or imports(bridge_code) != {
    "Foundation", "StornautInvestigationHandoffContract",
}:
    fail("iii-b2b-1a-0 dependency surface drifted")

semantic = composition_code + bridge_code
if re.search(r"(?m)^\s*(?:public|open)\s+", semantic):
    fail("iii-b2b-1a-0 public surface drifted")
if re.search(r"(?m)^\s*package\s+(?:let|var)\s+claimEvidence\b", semantic):
    fail("iii-b2b-1a-0 claim evidence escaped the module")
for pattern in (
    r"\b(?:Codable|Encodable|Decodable)\b",
    r"\bStornaut(?:Execution|Core|Lifecycle|Codex|InvestigationRuntime|InvestigationDiagnostic|ProbeBridge|ProcessSupport)\b",
    r"\b(?:Executor|MoveToTrash|RegisteredAction|signedRuntimeReady|readiness)\b",
):
    if re.search(pattern, semantic, re.IGNORECASE):
        fail("iii-b2b-1a-0 authority or product reachability drifted")
physical_authority_symbols = (
    "Darwin", "Glibc", "AppKit", "SwiftUI", "NSXPCConnection",
    "NSXPCListener", "URLSession", "NWConnection", "Process",
    "FileManager", "FileHandle",
)
