expected_dependencies = {"StornautCore", "StornautCodex"}
if actual_dependencies != expected_dependencies:
    raise SystemExit(
        "StornautInvestigation dependencies "
        f"{sorted(actual_dependencies)} != {sorted(expected_dependencies)}"
    )

resource_paths = {
    Path(resource["path"]).name
    for resource in coordinator.get("resources", [])
}
if resource_paths != {"investigation-prompt-v1.txt"}:
    raise SystemExit(
        "StornautInvestigation resources drifted: "
        f"{sorted(resource_paths)}"
    )

