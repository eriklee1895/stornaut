function verify_iib5biii_a_staged_scope() {
    local baseline=${1:-5933bd0590d5e1c9ab696445fa4475d180e5143e}
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpoch.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpochComposition.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineHelperEpochContinuity.swift
        Tests/StornautInvestigationTests/InvestigationMachineHelperEpochContinuityTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineSingleEpochTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineSingleEpochInstalledL2JoinTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 10 )) || { print -u2 "iii-a checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == 5933bd0590d5e1c9ab696445fa4475d180e5143e ]] || { print -u2 "iii-a checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" | grep -q .; then print -u2 "iii-a checkpoint deleted an existing path"; return 1; fi
    if git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {f=1} END {exit !f}'; then print -u2 "iii-a binary checkpoint path rejected"; return 1; fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] || { print -u2 "iii-a staged checkpoint paths drifted"; return 1; }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644; [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" == "$expected_mode 0 $expected_path" ]] || { print -u2 "iii-a checkpoint mode drifted: $expected_path"; return 1; }
    done
    local changed=$(git diff --cached --numstat "$baseline" | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 3200 )) || { print -u2 "iii-a checkpoint budget drifted"; return 1; }
}

