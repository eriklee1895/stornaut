import pathlib
import re
import sys

source = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
expected = {
    "LifecycleSupervisorXPCWire": ["attestHelper", "handle"],
    "LifecycleInteractiveSessionXPCWire": ["handleInteractive"],
}
observed = {}
