function verify_iib5biii_b2ai_r1_scope() {
    local baseline=${1:-2f3a116be4644829fc513bcc2287c6bd2a1ea0ec}
    local expected=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinOuterInnerProtocol.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineHelperEpochContinuity.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineSingleEpochPhysicalBridge.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinOuterInnerProtocolTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    (( ${#expected} == 8 )) \
        || { print -u2 "iii-b2a-i-r1 checkpoint path ceiling drifted"; return 1; }
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" \
        == 2f3a116be4644829fc513bcc2287c6bd2a1ea0ec ]] \
        || { print -u2 "iii-b2a-i-r1 checkpoint baseline drifted"; return 1; }
    if git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 {found=1} END {exit !found}'
    then
        print -u2 "iii-b2a-i-r1 checkpoint deleted an existing path"
        return 1
    fi
    if git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && ($1=="-" || $2=="-") {found=1} END {exit !found}'
    then
        print -u2 "iii-b2a-i-r1 binary checkpoint path rejected"
        return 1
    fi
    local observed=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRD \
        "$baseline" | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')"})
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] \
        || { print -u2 "iii-b2a-i-r1 staged checkpoint paths drifted"; return 1; }
    local expected_path expected_mode observed_entry
    for expected_path in "${expected[@]}"; do
        expected_mode=100644
        [[ $expected_path == scripts/* ]] && expected_mode=100755
        observed_entry=$(git ls-files -s -- "$expected_path")
        [[ "$(print -r -- "$observed_entry" | awk '{print $1, $3, $4}')" \
            == "$expected_mode 0 $expected_path" ]] \
            || { print -u2 "iii-b2a-i-r1 checkpoint mode drifted: $expected_path"; return 1; }
    done
    local changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n+=$1+$2} END {print n+0}')
    (( changed <= 1200 )) \
        || { print -u2 "iii-b2a-i-r1 checkpoint budget drifted"; return 1; }
    local documentation=(${(f)"$(git diff --cached --name-only \
        --diff-filter=ACMRD "$baseline" | awk 'index($0,"docs/")==1')"})
    local preflight=docs/reports/phase-d-task-39b2c-l3c3c-ii-b5b-iii-b2a-i-r1-post-review-closure-preflight.md
    (( ${documentation[(Ie)$preflight]} == 1 )) \
        || { print -u2 "iii-b2a-i-r1 required preflight document missing"; return 1; }
    [[ "$(git write-tree)" == 62994279cc5a262dee3a490d845dc2f32a8fa4b6 ]] \
        || { print -u2 "iii-b2a-i-r1 completed tree drifted"; return 1; }
}

