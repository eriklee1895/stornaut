#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"

investigation_root=Sources/StornautCore/Investigation
evidence_root=Sources/StornautCore/Evidence
coordinator_root=Sources/StornautInvestigation
machine_root=Sources/StornautInvestigationMachine
machine_driver_host=$machine_root/InvestigationMachineDriverHost.swift
machine_scenario_runner=$machine_root/InvestigationFixedScenarioRunner.swift
machine_scenario_driver=$machine_root/InvestigationMachineScenarioDriver.swift
machine_driver_main=Tools/StornautInvestigationMachineDriver/main.swift
machine_driver_support=Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDriverSupport.swift
runtime_root=Sources/StornautInvestigationRuntime
diagnostic_root=Sources/StornautInvestigationDiagnostic
lifecycle_root=Sources/StornautLifecycle
lifecycle_helper=StornautLifecycleHelper/main.swift
contained_session=Sources/StornautCodex/Runtime/CodexContainedInteractiveSession.swift
registered_action_contract=Sources/StornautCore/Actions/RegisteredActionRunner.swift
registered_action_runner=Sources/StornautExecution/Actions/FoundationRegisteredActionRunner.swift
required_files=(
    "$investigation_root/InvestigationCanonical.swift"
    "$investigation_root/InvestigationBudget.swift"
    "$investigation_root/InvestigationPlan.swift"
    "$investigation_root/InvestigationSourceProjection.swift"
    "$investigation_root/InvestigationCandidatePlanner.swift"
    "$investigation_root/InvestigationStopEvaluator.swift"
    "$investigation_root/InvestigationPersistence.swift"
    "$investigation_root/PersistedWebProvenance.swift"
    "$evidence_root/EvidenceStore.swift"
    "$evidence_root/SQLiteConnection.swift"
    "$evidence_root/InvestigationSchemaV4.swift"
    "$coordinator_root/InvestigationCoordinator.swift"
    "$coordinator_root/InvestigationRuntimeProtocols.swift"
    "$coordinator_root/InvestigationEventNormalizer.swift"
    "$coordinator_root/InvestigationAppServerWireAdapter.swift"
    "$coordinator_root/InvestigationContextCompressor.swift"
    "$coordinator_root/InvestigationProbeAdapter.swift"
    "$coordinator_root/InvestigationReportNormalizer.swift"
    "$coordinator_root/InvestigationTerminalBarrier.swift"
    "$coordinator_root/InvestigationRuntimeDiagnosticFacade.swift"
    "$coordinator_root/SignedInvestigationRuntimeContract.swift"
    "$machine_root/SignedInvestigationRuntimeMachineContract.swift"
    "$machine_root/FixedLifecycleServiceProbe.swift"
    "$machine_root/InvestigationLifecycleTopologyCollector.swift"
    "$machine_driver_host"
    "$machine_scenario_runner"
    "$machine_scenario_driver"
    "$machine_driver_main"
    "$machine_driver_support"
    "$coordinator_root/Resources/investigation-prompt-v1.txt"
    "$runtime_root/InvestigationCodexSessionAdapter.swift"
    "$runtime_root/InvestigationLifecycleAppServerTransport.swift"
    "$diagnostic_root/InvestigationRuntimeDiagnosticAppLeaf.swift"
    "$diagnostic_root/InvestigationRuntimeDiagnosticComposition.swift"
    "$lifecycle_root/LifecycleInteractiveSessionContract.swift"
    "$lifecycle_root/DarwinFixedSystemServiceRegistry.swift"
    "$lifecycle_root/LifecycleRootTopologyObservation.swift"
    "$lifecycle_root/LifecycleSupervisorXPC.swift"
    "$contained_session"
    "$registered_action_contract"
    "$registered_action_runner"
    "$lifecycle_helper"
)

for file in "${required_files[@]}"; do
    if [[ ! -f "$file" ]]; then
        print -u2 "Missing Investigation boundary file: $file"
        exit 1
    fi
done

machine_collector_source="$machine_root/InvestigationLifecycleTopologyCollector.swift"
machine_service_source="$machine_root/FixedLifecycleServiceProbe.swift"
machine_claim_source="$machine_root/InvestigationMachineRetirementClaim.swift"
[[ -f "$machine_claim_source" ]] || {
    print -u2 "Missing trusted machine retirement claim source."
    exit 1
}
for marker in \
    'actor InvestigationLifecycleTopologyCollector' \
    'struct InvestigationLifecycleTopologyCohort' \
    'await retirementClaimStore.consume()' \
    'InvestigationMachineRetirementClaimStore' \
    'case rootAuthorityRequired' \
    'case collectorConsumed' \
    'provesInstalledTopology' \
    'provesPostTeardownTopology'; do
    rg -q --fixed-strings -- "$marker" "$machine_collector_source" || {
        print -u2 "Trusted lifecycle collector marker missing: $marker"
        exit 1
    }
done
if rg -q --fixed-strings -- 'InvestigationLifecycleRetirementEvidenceStore' \
    "$machine_collector_source"; then
    print -u2 "Collector still accepts App-local retirement evidence."
    exit 1
fi
for marker in \
    'protocol InvestigationMachineRetirementClaimSource' \
    'struct InvestigationMachineRetirementClaim' \
    'actor InvestigationMachineRetirementClaimStore'; do
    rg -q --fixed-strings -- "$marker" "$machine_claim_source" || {
        print -u2 "Machine retirement claim marker missing: $marker"
        exit 1
    }
done
if rg -n \
    'Codable|JSONDecoder|JSONEncoder|PropertyListDecoder|PropertyListEncoder|NSXPCConnection|LifecycleSupervisorXPCWire|LifecycleInteractiveSessionXPCWire|StornautExecution|ActionExecutor|TrashMoving|signedInvestigationRuntimeReady' \
    "$machine_claim_source"; then
    print -u2 "Machine retirement claim gained prohibited authority."
    exit 1
fi
for marker in \
    'package enum InvestigationMachineDriverEntryPoint' \
    'package static func run() async -> Int32' \
    'actor InvestigationMachineDriverHost' \
    'struct StrictMachineRetirementClaimSource' \
    'LifecycleMachineClaimXPCClient()' \
    'struct InstalledMachineRetirementHelperSigningVerifier' \
    'contract.helperExecutableURL' \
    'SecurityLifecycleCodeSigningVerifier().verify(' \
    'InvestigationMachineRetirementClaimStore()' \
    'InvestigationLifecycleTopologyCollectionRequest(' \
    'DarwinInvestigationLifecycleTopologyObserver('; do
    rg -q --fixed-strings -- "$marker" "$machine_driver_host" || {
        print -u2 "Machine driver host marker missing: $marker"
        exit 1
    }
done
package_surface_count=$(rg -o --fixed-strings -- 'package ' \
    "$machine_driver_host" | wc -l | tr -d ' ')
if [[ "$package_surface_count" != 2 ]]; then
    print -u2 \
        "Machine driver package surface drifted: $package_surface_count"
    exit 1
fi
for declaration in \
    'protocol InvestigationMachineRetirementHandleHandoff' \
    'protocol InvestigationMachineRetirementClaiming' \
    'struct InvestigationMachineTopologyAuthority' \
    'actor InvestigationMachineDriverHost'; do
    if rg -q --fixed-strings -- "public $declaration" "$machine_driver_host" \
        || rg -q --fixed-strings -- "package $declaration" "$machine_driver_host"; then
        print -u2 "Machine driver authority escaped module scope: $declaration"
        exit 1
    fi
done
for marker in \
    'import StornautInvestigationMachineDriverSupport' \
    'await InvestigationMachineDriverSupport.run()'; do
    rg -q --fixed-strings -- "$marker" "$machine_driver_main" || {
        print -u2 "Machine driver executable marker missing: $marker"
        exit 1
    }
done
if rg -n \
    'StornautExecution|StornautInvestigationDiagnostic|ActionExecutor|TrashMoving|RegisteredAction|SignedInvestigationRuntimeMachineAssembler|SignedInvestigationRuntimeMachineVerifier|signedInvestigationRuntimeReady|JSONEncoder|JSONDecoder|PropertyListEncoder|PropertyListDecoder|NSXPCConnection|URLSession|posix_spawn|removeItem|moveItem|copyItem|CommandLine\.arguments|ProcessInfo\.processInfo\.environment|readLine\(|kill\(' \
    "$machine_driver_host" "$machine_driver_main"; then
    print -u2 "Machine driver host gained prohibited input or authority."
    exit 1
fi
for marker in \
    'import Darwin' \
    'public enum InvestigationMachineDriverSupport' \
    'public static func run() async -> Int32' \
    'static func status(effectiveUserID: uid_t) -> Int32' \
    'rootAuthorityRequiredExitStatus: Int32 = 77' \
    'handoffUnavailableExitStatus: Int32 = 78'; do
    rg -q --fixed-strings -- "$marker" "$machine_driver_support" || {
        print -u2 "Authority-closed driver support marker missing: $marker"
        exit 1
    }
done
public_support_surface_count=$(rg -o --fixed-strings -- 'public static ' \
    "$machine_driver_support" | wc -l | tr -d ' ')
if [[ "$public_support_surface_count" != 1 ]]; then
    print -u2 \
        "Driver support public static surface drifted: $public_support_surface_count"
    exit 1
fi
for marker in \
    'actor InvestigationFixedScenarioRunner' \
    'typealias Operation = @Sendable () async throws' \
    'struct InvestigationFixedScenarioObservation' \
    'actor InvestigationMachineScenarioDriver' \
    'struct InvestigationMachineScenarioAttempt' \
    'struct InvestigationMachineSyntheticSuccessEvidence' \
    'async throws -> SignedInvestigationRuntimeFailureMatrix' \
    'let authority = try await attempt.host.run()' \
    'try await attempt.runner.consumeObservation()'; do
    rg -q --fixed-strings -- "$marker" \
        "$machine_scenario_runner" "$machine_scenario_driver" || {
        print -u2 "Machine scenario driver marker missing: $marker"
        exit 1
    }
done
if rg -n '^[[:space:]]*(?:@[A-Za-z_][A-Za-z0-9_.]*(?:\([^)]*\))?[[:space:]]+|(?:final|indirect|nonisolated|override|required|static|class|mutating|nonmutating|convenience|distributed)[[:space:]]+)*(?:public|package)(?:\(set\))?[[:space:]]+' \
    "$machine_scenario_runner" "$machine_scenario_driver"; then
    print -u2 "Machine scenario source escaped module scope."
    exit 1
fi
if rg -n \
    'import StornautExecution|import StornautInvestigationDiagnostic|import StornautCodex|ActionExecutor|TrashMoving|RegisteredAction|FileManagerTrashAdapter|CleanupExecutionRuntime|ExecutionAuthorization|ActionPolicyGate|CleanupPolicyGate|MoveToTrash|ProposedCleanupAction|CleanupAction|SignedInvestigationCapabilityEvidenceReceipt|SignedInvestigationRuntimeMachineAssembler|SignedInvestigationRuntimeMachineVerifier|SignedInvestigationRuntimeMachineReport|signedInvestigationRuntimeReady|signedRuntimeReady|readiness|Readiness|Codable|JSONEncoder|JSONDecoder|PropertyListEncoder|PropertyListDecoder|FileManager\.default|NSXPCConnection|URLSession|NWConnection|WebSocket|CFStream|NSTask|posix_spawn|O_WRONLY|O_RDWR|O_CREAT|O_TRUNC|O_APPEND|Process[[:space:]]*\(|removeItem|moveItem|copyItem|trashItem|replaceItem|createDirectory|createFile|createSymbolicLink|linkItem|setAttributes|forWritingTo|writeabilityHandler|unlink[[:space:]]*\(|rename[[:space:]]*\(|fopen[[:space:]]*\(|mkdir[[:space:]]*\(|rmdir[[:space:]]*\(|chmod[[:space:]]*\(|chown[[:space:]]*\(|symlink[[:space:]]*\(|truncate[[:space:]]*\(|kill[[:space:]]*\(|CommandLine\.arguments|ProcessInfo\.processInfo\.environment|readLine[[:space:]]*\(' \
    "$machine_scenario_runner" "$machine_scenario_driver"; then
    print -u2 \
        "Machine scenario driver gained authority or readiness output."
    exit 1
fi
machine_xpc_source="$lifecycle_root/LifecycleSupervisorXPC.swift"
machine_authorization_source="$lifecycle_root/LifecycleAppAuthorization.swift"
machine_escrow_source="$lifecycle_root/LifecycleMachineRetirementEscrow.swift"
machine_registration_source="$lifecycle_root/LifecycleServiceRegistration.swift"
for marker in \
    'com.eriklee.stornaut.lifecycle.machine-claim' \
    'com.eriklee.stornaut.investigation.machine-driver' \
    'Contents/MacOS/StornautInvestigationMachineDriver'; do
    rg -q --fixed-strings -- "$marker" "$machine_registration_source" || {
        print -u2 "Fixed Machine claim topology marker missing: $marker"
        exit 1
    }
done
for marker in \
    'public struct LifecycleMachineDriverAdmissionPolicy' \
    'identity.effectiveUserID == 0' \
    'processIdentity(identity.processID) == identity' \
    'contract.machineDriverExecutableURL' \
    'contract.machineDriverSigningIdentifier'; do
    rg -q --fixed-strings -- "$marker" "$machine_authorization_source" || {
        print -u2 "Machine driver admission marker missing: $marker"
        exit 1
    }
done
for marker in \
    '@objc public protocol LifecycleMachineClaimXPCWire' \
    'public actor LifecycleMachineClaimXPCClient' \
    'func claimMachineRetirement(' \
    'LifecycleMachineClaimXPCReplyResolver' \
    'options: .privileged'; do
    rg -q --fixed-strings -- "$marker" "$machine_xpc_source" || {
        print -u2 "Machine claim XPC marker missing: $marker"
        exit 1
    }
done
for marker in \
    'LifecycleMachineClaimListenerDelegate' \
    'LifecycleMachineClaimHelperService' \
    'listener === expectedListener' \
    'connection.effectiveUserIdentifier == 0' \
    'LifecycleMachineDriverAdmissionPolicy().authorize(' \
    'machineDriverIdentity: callerIdentity'; do
    rg -q --fixed-strings -- "$marker" "$lifecycle_helper" || {
        print -u2 "Machine claim helper marker missing: $marker"
        exit 1
    }
done
if rg -n \
    'public protocol LifecycleMachineDriverClaimAdmitting|package protocol LifecycleMachineDriverClaimAdmitting|authorized: true|authorized: false' \
    "$machine_authorization_source" "$machine_escrow_source" \
    "$machine_xpc_source" "$lifecycle_helper"; then
    print -u2 "Machine claim route exposes a caller-mintable authorization."
    exit 1
fi
if rg -n \
    'StornautExecution|ActionExecutor|TrashMoving|RegisteredAction|signedInvestigationRuntimeReady' \
    "$machine_authorization_source" "$machine_escrow_source" \
    "$machine_xpc_source" "$lifecycle_helper"; then
    print -u2 "Machine claim transport gained prohibited authority."
    exit 1
fi
python3 - "$lifecycle_root/LifecycleSupervisorXPC.swift" <<'PY'
import pathlib
import re
import sys

source = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
expected = {
    "LifecycleSupervisorXPCWire": ["attestHelper", "handle"],
    "LifecycleInteractiveSessionXPCWire": ["handleInteractive"],
    "LifecycleMachineClaimXPCWire": ["claimMachineRetirement"],
}
observed = {}
for match in re.finditer(
    r"@objc public protocol\s+(\w+)(?:\s*:[^{]+)?\s*\{(.*?)^\}",
    source,
    re.MULTILINE | re.DOTALL,
):
    observed[match.group(1)] = re.findall(
        r"^\s+func\s+(\w+)\s*\(",
        match.group(2),
        re.MULTILINE,
    )
if observed != expected:
    raise SystemExit(
        "Lifecycle exported XPC selector allowlist drifted: "
        f"expected={expected!r} observed={observed!r}"
    )
PY
if rg -q --fixed-strings -- 'SignedInvestigationRuntimeResidue(' \
    "$machine_collector_source"; then
    print -u2 "L3b2 over-claimed final machine residue."
    exit 1
fi
for marker in \
    'struct DarwinFixedLifecycleServiceProbe' \
    'DarwinLifecycleFixedSystemServiceRegistry().lookup()' \
    'runtime.topology.service-label-mismatch' \
    'runtime.topology.service-identity-mismatch'; do
    rg -q --fixed-strings -- "$marker" "$machine_service_source" || {
        print -u2 "Fixed service observer marker missing: $marker"
        exit 1
    }
done
for source in "$machine_collector_source" "$machine_service_source"; do
    if rg -n \
        'StornautExecution|StornautInvestigationDiagnostic|ActionExecutor|TrashMoving|RegisteredAction|SignedInvestigationRuntimeMachineAssembler|SignedInvestigationRuntimeMachineVerifier|signedInvestigationRuntimeReady|Codable|JSONEncoder|JSONDecoder|bootout|bootstrap system|removeItem|moveItem|copyItem|posix_spawn|Process\(' \
        "$source"; then
        print -u2 "L3b2 trusted collector contains prohibited authority."
        exit 1
    fi
done
if rg -n \
    ': InvestigationLifecycleTopologyTransitioning' \
    "$machine_root"; then
    print -u2 "L3b2 production target gained topology mutation authority."
    exit 1
fi
if rg -n \
    'package (protocol LifecycleRootTopologyArtifactReading|protocol LifecycleRootTopologyProcessReading|enum LifecycleRootTopologyProcessReadResult|struct LifecycleRootTopologyProcessSnapshot)' \
    "$lifecycle_root/LifecycleRootTopologyObservation.swift"; then
    print -u2 "L2 observation injection seam escaped module scope."
    exit 1
fi
fixed_registry_source="$lifecycle_root/DarwinFixedSystemServiceRegistry.swift"
for marker in \
    'package struct DarwinLifecycleFixedSystemServiceRegistry' \
    'SMJobCopyDictionary(' \
    'SMAppService.statusForLegacyPlist(' \
    'kSMDomainSystemLaunchd' \
    'status == .notRegistered || status == .notFound' \
    'status == .enabled' \
    'dictionary["Label"] as? String' \
    'dictionary["PID"] as? NSNumber' \
    'label == contract.label' \
    'fieldCount <= 128' \
    'rawProcessID <= Int64(Int32.max)'; do
    rg -q --fixed-strings -- "$marker" "$fixed_registry_source" || {
        print -u2 "Fixed system service registry marker missing: $marker"
        exit 1
    }
done
if rg -n \
    'launchctl|pgrep|pkill|killall|ps -U|bootstrap_look_up|SMCopyAllJobDictionaries' \
    "$fixed_registry_source" "$machine_service_source"; then
    print -u2 "Fixed service observer gained text/global process discovery."
    exit 1
fi

if [[ -e "$coordinator_root/SignedInvestigationRuntimeMachineContract.swift" ]]; then
    print -u2 "Trusted machine implementation remained in StornautInvestigation."
    exit 1
fi

machine_source="$machine_root/SignedInvestigationRuntimeMachineContract.swift"
for declaration in \
    'protocol SignedInvestigationRuntimeSealedCohortAuthority' \
    'struct SignedInvestigationRuntimeMachineAssembler' \
    'struct SignedInvestigationRuntimeMachineVerifier'; do
    rg -q --fixed-strings -- "$declaration" "$machine_source" || {
        print -u2 "Trusted machine declaration is missing: $declaration"
        exit 1
    }
    if rg -q --fixed-strings -- "public $declaration" "$machine_source" \
        || rg -q --fixed-strings -- "package $declaration" "$machine_source"; then
        print -u2 "Trusted machine declaration escaped module scope: $declaration"
        exit 1
    fi
done

for prohibited in \
    StornautExecution StornautLifecycle ActionExecutor TrashMoving \
    FileManagerTrashAdapter RegisteredAction posix_spawn NSTask \
    'Process(' URLSession NWConnection removeItem moveItem copyItem \
    createFile forWritingTo O_WRONLY O_RDWR 'unlink(' 'rename(' \
    FileManager.default Darwin.write signedInvestigationRuntimeReady; do
    if rg -q --fixed-strings -- "$prohibited" "$machine_source"; then
        print -u2 "Trusted machine target contains prohibited surface: $prohibited"
        exit 1
    fi
done

if rg -n \
    'FoundationRegisteredActionRunner|posix_spawn|ProcessTreeTerminator|waitpid\(|kill\(' \
    "$registered_action_contract"; then
    print -u2 "StornautCore contains Registered Action process authority."
    exit 1
fi

for marker in \
    'public struct FoundationRegisteredActionRunner' \
    'posix_spawn' \
    'ProcessTreeTerminator'; do
    if ! rg -q --fixed-strings -- "$marker" "$registered_action_runner"; then
        print -u2 \
            "StornautExecution Registered Action runner is incomplete: $marker"
        exit 1
    fi
done

if rg -n \
    'ActionExecutor|CleanupExecutionRuntime|ExecutionAuthorization|TrashMoving|FileManager\.trashItem|RegisteredActionRunner|StornautCodex|StornautLifecycle' \
    "$investigation_root" \
    "$evidence_root/SQLiteConnection.swift" \
    "$evidence_root/InvestigationSchemaV4.swift"; then
    print -u2 "Investigation persistence references prohibited authority or runtime modules."
    exit 1
fi

if rg -n \
    '\bProcess\s*\(|NSTask|posix_spawn|/bin/(ba)?sh|/usr/bin/env[[:space:]]+(ba)?sh|system\s*\(' \
    "$investigation_root" \
    "$evidence_root/EvidenceStore.swift" \
    "$evidence_root/SQLiteConnection.swift" \
    "$evidence_root/InvestigationSchemaV4.swift"; then
    print -u2 "Investigation persistence contains a process or shell execution surface."
    exit 1
fi

if rg -n \
    'removeItem|moveItem|copyItem|createFile|forWritingTo|O_WRONLY|O_RDWR|unlink\(|rename\(' \
    "$investigation_root"; then
    print -u2 "Investigation Core contains a filesystem write surface."
    exit 1
fi

if rg -n \
    'URLSession|dataTask|downloadTask|uploadTask|WebSocket|NWConnection|CFStream' \
    "$investigation_root" \
    "$evidence_root/EvidenceStore.swift" \
    "$evidence_root/SQLiteConnection.swift" \
    "$evidence_root/InvestigationSchemaV4.swift"; then
    print -u2 "Investigation persistence contains a network execution surface."
    exit 1
fi

if rg -n \
    '\b(ActionExecutor|ActionPolicyGate|CleanupExecutionRuntime|ExecutionAuthorization|FileManagerTrashAdapter|MoveToTrash|ProposedCleanupAction|RegisteredAction[A-Za-z]*|TrashMoving)\b' \
    "$coordinator_root" \
    "$runtime_root" \
    "$diagnostic_root" \
    --glob '*.swift'; then
    print -u2 "Investigation runtime composition references cleanup authority."
    exit 1
fi

if rg -n \
    '\bProcess\s*\(|NSTask|posix_spawn|/bin/(ba)?sh|/usr/bin/env[[:space:]]+(ba)?sh|system\s*\(' \
    "$coordinator_root" \
    "$runtime_root" \
    "$diagnostic_root" \
    --glob '*.swift'; then
    print -u2 "Investigation runtime composition contains an arbitrary process surface."
    exit 1
fi

if rg -n \
    'removeItem|moveItem|copyItem|createFile|forWritingTo|O_WRONLY|O_RDWR|unlink\(|rename\(|FileManager\.default' \
    "$coordinator_root" \
    "$runtime_root" \
    "$diagnostic_root" \
    --glob '*.swift'; then
    print -u2 "Investigation runtime composition contains a filesystem mutation surface."
    exit 1
fi

if rg -n \
    'URLSession|dataTask|downloadTask|uploadTask|WebSocket|NWConnection|CFStream' \
    "$coordinator_root" \
    "$runtime_root" \
    "$diagnostic_root" \
    --glob '*.swift'; then
    print -u2 "Investigation runtime composition contains a direct network surface."
    exit 1
fi

python3 - \
    "$evidence_root/EvidenceStore.swift" \
    "$evidence_root/SQLiteConnection.swift" \
    "$evidence_root/InvestigationSchemaV4.swift" <<'PY'
from pathlib import Path
import re
import sys

store_path, connection_path, schema_path = map(Path, sys.argv[1:])
store = store_path.read_text()
connection = connection_path.read_text()
schema = schema_path.read_text()

required_connection_guards = (
    "private let database: OpaquePointer",
    "fileprivate func prepare(",
    "fileprivate func bind(",
    "sqlite3_set_authorizer(",
    "private static func authorizationMode(",
)
for guard in required_connection_guards:
    if guard not in connection:
        raise SystemExit(
            f"{connection_path} lost closed SQLite guard: {guard}"
        )

public_declaration = re.compile(
    r"\bpublic\s+(?:func|var|let)\s+([A-Za-z_][A-Za-z0-9_]*)"
)
generic_sql_names = {
    "sql",
    "query",
    "execute",
    "executesql",
    "prepare",
    "preparestatement",
    "statement",
    "database",
    "databasehandle",
    "connection",
    "sqliteconnection",
}
for path, text in (
    (store_path, store),
    (connection_path, connection),
):
    for match in public_declaration.finditer(text):
        if match.group(1).lower() in generic_sql_names:
            raise SystemExit(
                f"{path} exposes a generic public SQL surface: "
                f"{match.group(0)}"
            )

ddl_pattern = re.compile(
    r"\b(?:CREATE|DROP|ALTER)\s+"
    r"(?:TABLE|INDEX|TRIGGER)\s+(?:IF\s+(?:NOT\s+)?EXISTS\s+)?"
    r"(?:idx_)?investigation_",
    re.IGNORECASE,
)
dml_pattern = re.compile(
    r"\b(?:INSERT\s+INTO|UPDATE|DELETE\s+FROM)\s+"
    r"investigation_",
    re.IGNORECASE,
)

connection_without_debug_probe = connection.replace(
    '"CREATE TABLE investigation_probe (id INTEGER)"',
    '""',
)
if ddl_pattern.search(store) or ddl_pattern.search(connection_without_debug_probe):
    raise SystemExit(
        "Investigation schema DDL escaped InvestigationSchemaV4.swift"
    )
if not ddl_pattern.search(schema):
    raise SystemExit("InvestigationSchemaV4.swift contains no closed DDL")

allowed_dml_paths = {store_path, connection_path}
for path in Path("Sources/StornautCore").rglob("*.swift"):
    text = path.read_text()
    if dml_pattern.search(text) and path not in allowed_dml_paths:
        raise SystemExit(
            f"Investigation table DML escaped the persistence owner: {path}"
        )

for token in (
    "raw_prompt",
    "raw_jsonl",
    "stdout",
    "stderr",
    "model_reasoning",
    "file_snippet",
):
    if token in schema.lower():
        raise SystemExit(
            f"Investigation schema regained prohibited raw content: {token}"
        )
PY

package_graph=$(swift package describe --type json)
package_manifest=$(swift package dump-package)
python3 - \
    "$package_graph" \
    "$package_manifest" \
    "$coordinator_root/InvestigationCoordinator.swift" \
    "$coordinator_root/InvestigationRuntimeProtocols.swift" \
    "$coordinator_root/InvestigationRuntimeDiagnosticFacade.swift" \
    "$coordinator_root/SignedInvestigationRuntimeContract.swift" \
    "$coordinator_root/Resources/investigation-prompt-v1.txt" \
    "$lifecycle_root/LifecycleInteractiveSessionContract.swift" \
    "$lifecycle_root/LifecycleSupervisorXPC.swift" \
    "$runtime_root/InvestigationLifecycleAppServerTransport.swift" \
    "$lifecycle_helper" \
    "$contained_session" \
    "$diagnostic_root/InvestigationRuntimeDiagnosticComposition.swift" \
    "$diagnostic_root/InvestigationRuntimeDiagnosticAppLeaf.swift" \
    "$machine_root/SignedInvestigationRuntimeMachineContract.swift" <<'PY'
import json
from pathlib import Path
import re
import sys

package = json.loads(sys.argv[1])
manifest = json.loads(sys.argv[2])
targets = {target["name"]: target for target in package["targets"]}
core = targets["StornautCore"]
dependencies = set(core.get("target_dependencies", []))
forbidden = {"StornautCodex", "StornautLifecycle"}
present = dependencies & forbidden
if present:
    raise SystemExit(
        f"StornautCore depends on prohibited runtime targets: {sorted(present)}"
    )

coordinator = targets.get("StornautInvestigation")
if coordinator is None:
    raise SystemExit("missing StornautInvestigation package target")
