function verify_iicb2a2_staged_scope() {
    local PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local baseline=${1:-cf1cbed8beff60cdd606bf7025fcef8a2768ff99}
    local expected_baseline=cf1cbed8beff60cdd606bf7025fcef8a2768ff99
    local -a expected=(
        Tests/StornautInvestigationTests/InvestigationMachineCampaignEvidenceTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-investigation-runtime-machine-report
        scripts/verify-investigation-boundaries
        scripts/verify-app-release-boundaries
        scripts/verify-contract
    )
    [[ "$(git rev-parse "$baseline^{commit}" 2>/dev/null)" == $expected_baseline ]] \
        || { print -u2 "ii-c-b2a2 checkpoint baseline drifted"; return 1; }
    local deleted observed_text changed item mode entry
    deleted=$(git diff --cached --name-only --diff-filter=D "$baseline" \
        | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')
    [[ -z $deleted ]] || { print -u2 "ii-c-b2a2 checkpoint deleted an existing path"; return 1; }
    observed_text=$(git diff --cached --name-only --diff-filter=ACMRD "$baseline" \
        | awk 'index($0,"docs/")!=1 && $0!="AGENTS.md" && $0!="README.md"')
    local -a observed=(${(f)observed_text})
    (( ${#expected} == 6 && ${#observed} <= 6 )) \
        || { print -u2 "ii-c-b2a2 checkpoint path ceiling drifted"; return 1; }
    [[ "${(j:\n:)${(@on)observed}}" == "${(j:\n:)${(@on)expected}}" ]] \
        || { print -u2 "ii-c-b2a2 checkpoint paths drifted"; return 1; }
    changed=$(git diff --cached --numstat "$baseline" \
        | awk 'index($3,"docs/")!=1&&$3!="AGENTS.md"&&$3!="README.md"{if($1=="-"||$2=="-")exit 2;n+=$1+$2}END{print n+0}') \
        || { print -u2 "ii-c-b2a2 binary checkpoint path rejected"; return 1; }
    (( changed <= 2000 )) || { print -u2 "ii-c-b2a2 checkpoint budget drifted"; return 1; }
    local -a worktree_paths=(${(f)"$(git diff --name-only --diff-filter=ACMRD -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    for item in "${worktree_paths[@]}"; do (( ${expected[(Ie)$item]} )) \
        || { print -u2 "ii-c-b2a2 checkpoint worktree paths drifted"; return 1; }; done
    local -a untracked_paths=(${(f)"$(git ls-files --others --exclude-standard -- \
        | awk 'index($0,"docs/")!=1&&$0!="AGENTS.md"&&$0!="README.md"')"})
    for item in "${untracked_paths[@]}"; do (( ${expected[(Ie)$item]} )) \
        || { print -u2 "ii-c-b2a2 checkpoint untracked paths drifted"; return 1; }; done
    for item in "${expected[@]}"; do
        mode=100644; [[ $item == scripts/* ]] && mode=100755
        entry=$(git ls-files -s -- "$item")
        [[ "$(print -r -- "$entry" | awk '{print $1, $3, $4}')" == "$mode 0 $item" \
            && "$(print -r -- "$entry" | awk '{print $2}')" == "$(git hash-object -- "$item")" ]] \
            || { print -u2 "ii-c-b2a2 staged source/mode drifted: $item"; return 1; }
    done
}

function verify_iic_evidence_verification_source_contract() {
    /usr/bin/python3 -I - "$iic_evidence_verification_mutation_only" \
        "$iic_evidence_verification_mutation_name" \
        "$iic_evidence_verification_mutation_slot" \
        "$iic_evidence_verification_mutation_sha" \
        "${iic_evidence_verification_sources[@]}" <<'PY'
