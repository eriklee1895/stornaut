)
for marker in required_tests:
    if test.count(marker) != 1:
        raise SystemExit(f"ii-b5b-ii-a focused coverage drifted: {marker}")
required_mutations = (
    "case initialOffset, flagsRead, flagsWrite, flagsNotSet",
    "case statusFlagsRead, writableDescriptor, finalDescriptorFlagsDrift",
    "case zeroDevice, zeroInode, nonRegular, wrongOwner, wrongMode",
    "case multipleLinks, unexpectedFileFlags",
    "case empty, oversized, initialACL, initialXattr",
    "case prematureEOF, trailingGrowth, finalOffset, metadataDrift",
    "case finalACL, finalXattr, readFailure",
    ".valid(deviceID: 0)", ".valid(inode: 0)",
    ".valid(flags: 1)",
    "case .initialACL:", "case .finalACL:",
    "case .finalDescriptorFlagsDrift:",
    "#expect(try !system.hasExtendedACL(initialDescriptor).get())",
    "#expect(hasACL)",
)
for marker in required_mutations:
    if marker not in test:
        raise SystemExit(f"ii-b5b-ii-a focused mutation drifted: {marker}")
if "@Test(arguments: FixedCapsuleInputMutation.allCases)" not in test:
    raise SystemExit("ii-b5b-ii-a focused mutation matrix drifted")
if re.sub(r"\s+", "", installed).count("returnresult==0") != 2:
    raise SystemExit("ii-b5b-ii-a installed ACL semantics drifted")
for marker in (
    "darwinSourceRecognizesARealExtendedACL",
    "#expect(try !system.hasExtendedACL(initialDescriptor))",
    "#expect(try system.hasExtendedACL(descriptor))",
    '"everyone allow read"',
):
    if marker not in installed_test:
        raise SystemExit(
            f"ii-b5b-ii-a installed ACL regression drifted: {marker}"
        )
for marker in (
    "InvestigationMachineFixedCapsuleIntake.swift",
    "iiB5BIIAVerifierPinsFixedCapsuleAndNarrowFcntlContract",
    "Machine fixed capsule exact fcntl contract drifted",
    "Machine driver installed ACL semantics drifted",
):
    if marker not in boundary:
        raise SystemExit(
            f"ii-b5b-ii-a boundary regression drifted: {marker}"
        )

expected = {
    source_path: "9f3a33cd0f5792e28d2c5c69b28250463509883114196fa4530141ea048c799d",
    test_path: "5524411c895237fbd28983e91d8eb6b5a57c03881b175556b908e9b9fa7d0f87",
}
for path, digest in expected.items():
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        label = "source" if path == source_path else "focused test"
        raise SystemExit(f"ii-b5b-ii-a canonical {label} drifted")
PY
}

