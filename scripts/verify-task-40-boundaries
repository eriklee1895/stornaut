def function_block(source, signature, label):
    code = code_without_comments_or_strings(source)
    start = code.find(signature)
    if start < 0:
        raise SystemExit(f"Task 40 {label} is missing")
    opening = code.find("{", start)
    if opening < 0:
        raise SystemExit(f"Task 40 {label} body is missing")
    depth = 0
    for index in range(opening, len(code)):
        if code[index] == "{":
            depth += 1
        elif code[index] == "}":
            depth -= 1
            if depth == 0:
                return source[start:index + 1]
    raise SystemExit(f"Task 40 {label} body is unterminated")

def require_block_seal(block, expected, label):
    if hashlib.sha256(block.encode()).hexdigest() != expected:
        raise SystemExit(f"Task 40 {label} source seal drifted")

