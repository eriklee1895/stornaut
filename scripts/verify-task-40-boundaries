        r"\bpublic\s+(?:(?:static|class|nonisolated(?:\s*\(\s*unsafe\s*\))?)\s+)*func\b[^{}]{0,1024}\b(?:CleanupPlan|ReviewProjection)\b[^{}]*\{",
        r"\bpublic\s+extension\s+(?:CleanupPlan|ReviewProjection)\b",
