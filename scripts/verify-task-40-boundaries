     ), "display constructor"),
)
for mutated, expected_label in internal_surface_mutations:
    normalized = re.sub(
        r"\s+", " ", code_without_comments_or_strings(mutated))
    checks = {
        "raw Store snapshot": r"\bpublic\s+(?:(?:final|nonisolated(?:\s*\(\s*unsafe\s*\))?)\s+)*struct\s+InvestigationReportReadSnapshot\b",
        "raw Store reader": r"\bpublic\s+(?:(?:static|class|nonisolated(?:\s*\(\s*unsafe\s*\))?)\s+)*func\s+investigationReportReadSnapshot\b",
        "raw projection factory": r"\bpublic\s+(?:(?:class|nonisolated(?:\s*\(\s*unsafe\s*\))?)\s+)*static\s+func\s+make\b",
        "display constructor": r"\bpublic\s+(?:(?:required|convenience|nonisolated(?:\s*\(\s*unsafe\s*\))?)\s+)*init\s*\([^)]*\)",
    }
    if not re.search(checks[expected_label], normalized):
        raise SystemExit(
            "Task 40 internal-surface mutation accepted: " + expected_label
        )

