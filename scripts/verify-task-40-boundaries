def code_without_comments_or_strings(source):
    output = []
    index = 0
    block_depth = 0
    line_comment = False
    string_delimiter = None
    while index < len(source):
        if line_comment:
            if source[index] == "\n":
                line_comment = False
                output.append("\n")
            else:
                output.append(" " )
            index += 1
            continue
        if block_depth:
            if source.startswith("/*", index):
                block_depth += 1
                output.extend("  " )
                index += 2
            elif source.startswith("*/", index):
                block_depth -= 1
                output.extend("  " )
                index += 2
            else:
                output.append("\n" if source[index] == "\n" else " " )
                index += 1
            continue
        if string_delimiter is not None:
            if source.startswith(string_delimiter, index):
                output.extend(" " * len(string_delimiter))
                index += len(string_delimiter)
                string_delimiter = None
            elif source[index] == "\\" and string_delimiter == '"':
                output.extend("  " )
                index += min(2, len(source) - index)
            else:
                output.append("\n" if source[index] == "\n" else " " )
                index += 1
            continue
        if source.startswith("//", index):
            line_comment = True
            output.extend("  " )
            index += 2
        elif source.startswith("/*", index):
            block_depth = 1
            output.extend("  " )
            index += 2
        elif source.startswith('"""', index):
            string_delimiter = '"""'
            output.extend("   " )
            index += 3
        elif source[index] == '"':
            string_delimiter = '"'
            output.append(" " )
            index += 1
        else:
            output.append(source[index])
            index += 1
    return "".join(output)

def code_without_comments(source):
    source = re.sub(r"(?s)/\*.*?\*/", "", source)
    return re.sub(r"(?m)//.*$", "", source)

def validate_authority(source, label, allowed=()):
    identifiers = set(re.findall(r"[A-Za-z_][A-Za-z0-9_]*", source))
    forbidden_identifiers = {
        "StornautExecution", "CleanupPlan", "CleanupPlanItem",
        "CleanupPolicyGate", "CleanupPlanBuilder", "ReviewProjection",
        "TrashMoving", "AuthorizationServices",
        "FileManager", "FileHandle", "Process", "URLSession",
        "OutputStream", "Darwin", "Glibc",
        "open", "openat", "creat", "fopen", "freopen", "fdopen",
        "write", "writev", "pwrite", "pwritev", "fwrite",
        "fputs", "fprintf", "putc", "fputc",
        "link", "linkat", "symlink", "symlinkat",
        "unlink", "unlinkat", "rename", "renameat", "remove",
        "removeItem", "moveItem", "copyItem", "replaceItem",
        "createFile", "createDirectory", "rmdir", "mkdir",
        "mkstemp", "mkdtemp", "mkfifo", "mkfifoat", "mknod",
        "mknodat", "chmod", "fchmod", "chown",
        "fchown", "truncate", "ftruncate", "setxattr",
        "removexattr", "posix_spawn", "popen",
        "execv", "execve", "kill", "killpg", "socket",
        "connect", "bind", "listen", "accept", "send",
    }
    forbidden = sorted(
        identifiers.intersection(forbidden_identifiers).difference(allowed)
    )
    if forbidden:
        raise ValueError(
            f"Task 40 {label} gained authority: {','.join(forbidden)}"
        )
    if re.search(r"\bsystem\s*\(", source):
        raise ValueError(f"Task 40 {label} gained authority: system")

def validate_public_surface(source, label):
    code = code_without_comments_or_strings(source)
    normalized = re.sub(r"\s+", " ", code)
    if re.search(r"\bpublic\s+extension\b", normalized):
        raise ValueError(
            f"Task 40 {label} public extension bypasses surface review"
        )
    declarations = re.findall(r"\bpublic\b.{0,512}?(?=\{|$)", normalized)
    forbidden = ("path", "action", "authorization", "command",
                 "authorize", "execute", "delete", "remove",
                 "move", "trash", "policy", "rawpayload",
                 "rawdata", "rawjson")
    for declaration in declarations:
        folded = declaration.lower()
        if any(token in folded for token in forbidden):
            raise ValueError(
                f"Task 40 {label} public surface exposes authority/path field"
            )
        if re.search(r"\b(?:CleanupPlan|ReviewProjection)\b", declaration):
            raise ValueError(
                f"Task 40 {label} public surface exposes raw Plan/projection"
            )
    for match in re.finditer(
        r"\bpublic\s+(?:indirect\s+)?(?:enum|protocol)\s+"
        r"[A-Za-z_][A-Za-z0-9_]*[^{}]*\{", code
    ):
        opening = code.find("{", match.start())
        depth = 0
        closing = None
        for index in range(opening, len(code)):
            if code[index] == "{":
                depth += 1
            elif code[index] == "}":
                depth -= 1
                if depth == 0:
                    closing = index
                    break
        if closing is None:
            raise ValueError(f"Task 40 {label} public container is unterminated")
        if re.search(
            r"\b(?:CleanupPlan|ReviewProjection)\b",
            code[opening + 1:closing],
        ):
            raise ValueError(
                f"Task 40 {label} public container exposes raw Plan/projection"
            )

for source, label, allowed in (
