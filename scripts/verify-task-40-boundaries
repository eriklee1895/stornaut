    if path == review_path:
        allowed_authority.update({
            "CleanupPlan", "CleanupPlanBuilder", "ReviewProjection",
        })
    try:
        validate_authority(source, str(path), allowed_authority)
    except ValueError as error:
        raise SystemExit(str(error))
if "try await store.saveCleanupPlan(canonicalPlan)" not in builder:
