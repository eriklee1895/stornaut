        hashlib.sha256(reconciler.encode()).hexdigest():
    raise SystemExit("Task 40 Store-alias mutation was not observable")

internal_surface_mutations = (
    (reconciler.replace(
        "struct InvestigationReportReadSnapshot",
        "public nonisolated(unsafe) struct InvestigationReportReadSnapshot", 1
     ), "raw Store snapshot"),
    (store.replace(
        "    func investigationReportReadSnapshot(",
