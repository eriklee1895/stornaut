def registered_test_functions(source):
    code = code_without_comments_or_strings(source)
    registered = set()
    for match in re.finditer(
        r"(?m)^\s*func\s+([A-Za-z][A-Za-z0-9_]*)\s*\(", code
    ):
        cursor = match.start()
        attribute_start = code.rfind("@Test", max(0, cursor - 2_048), cursor)
        previous_function = code.rfind("func ", max(0, cursor - 2_048), cursor)
        if attribute_start > previous_function and any(
            marker in code[attribute_start:cursor]
            for marker in (".disabled", ".enabled")
        ):
            continue
        while cursor > 0 and code[cursor - 1].isspace():
            cursor -= 1
        if code[:cursor].endswith("@Test"):
            registered.add(match.group(1))
            continue
        if cursor == 0 or code[cursor - 1] != ")":
            continue
        depth = 0
        opening = None
        for index in range(cursor - 1, -1, -1):
            if code[index] == ")":
                depth += 1
            elif code[index] == "(":
                depth -= 1
                if depth == 0:
                    opening = index
                    break
        if opening is None:
            continue
        prefix = opening
        while prefix > 0 and code[prefix - 1].isspace():
            prefix -= 1
        if code[:prefix].endswith("@Test"):
            registered.add(match.group(1))
    return registered

