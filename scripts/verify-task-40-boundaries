#!/bin/zsh -f

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"

projection=Sources/StornautCore/Investigation/InvestigationReportProjection.swift
reconciler=Sources/StornautCore/Investigation/InvestigationReportReconciler.swift
review=Sources/StornautCore/Investigation/InvestigationReviewProjection.swift
continuation=Sources/StornautCore/Investigation/InvestigationContinuationPlanner.swift
store=Sources/StornautCore/Evidence/EvidenceStore.swift
sqlite=Sources/StornautCore/Evidence/SQLiteConnection.swift
builder=Sources/StornautCore/Review/CleanupPlanBuilder.swift
projection_tests=Tests/StornautCoreTests/InvestigationReportProjectionTests.swift
reconciler_tests=Tests/StornautCoreTests/InvestigationReportReconcilerTests.swift
review_tests=Tests/StornautCoreTests/InvestigationReviewProjectionTests.swift
continuation_tests=Tests/StornautCoreTests/InvestigationContinuationPlannerTests.swift
builder_tests=Tests/StornautCoreTests/CleanupPlanBuilderTests.swift
performance_tests=Tests/StornautCoreTests/InvestigationStorePerformanceTests.swift
app_model_tests=StornautAppTests/InvestigationReportModelTests.swift
investigation_source_root=Sources/StornautCore/Investigation
investigation_sources=(
    "${(@f)$(find "$repo_root/$investigation_source_root" -type f \
        -name '*.swift' -print | LC_ALL=C sort)}"
)

for path in $projection $reconciler $review $continuation $store $sqlite $builder \
    $projection_tests $reconciler_tests $review_tests $continuation_tests \
    $builder_tests $performance_tests $app_model_tests; do
    [[ -f $path && ! -L $path ]] || {
        print -u2 "Task 40 boundary source unavailable: $path"
        exit 1
    }
done
for path in "${investigation_sources[@]}"; do
    [[ -f $path && ! -L $path ]] || {
        print -u2 "Task 40 Investigation source unavailable: $path"
        exit 1
    }
done
[[ $(/usr/bin/shasum -a 256 $projection | /usr/bin/awk '{print $1}') \
    == 58749f15f91290be3474a56e0d897d90330f76157212fbbac78a2a22f603855d ]] || {
    print -u2 "Task 40 projection source seal drifted"
    exit 1
}
[[ $(/usr/bin/shasum -a 256 $reconciler | /usr/bin/awk '{print $1}') \
    == 71aa8338ddd428db3a1d675f441c3c518073a809fac5ded4e54c472625875ae7 ]] || {
    print -u2 "Task 40 reconciler source seal drifted"
    exit 1
}
[[ $(/usr/bin/shasum -a 256 $review | /usr/bin/awk '{print $1}') \
    == cfaabf29eae9f03011f63fb284efb9c0f3b684f9deab1be290aacb8396320520 ]] || {
    print -u2 "Task 40 Review projection source seal drifted"
    exit 1
}
[[ $(/usr/bin/shasum -a 256 $continuation | /usr/bin/awk '{print $1}') \
    == 2d035a736c3b2cce6ce91b51609eae3b4a9cd19fb979337c43c386cf85a97b54 ]] || {
    print -u2 "Task 40 continuation source seal drifted"
    exit 1
}

/usr/bin/xcrun swiftc -frontend -parse -enable-bare-slash-regex \
    $projection $reconciler $review $continuation $projection_tests \
    $reconciler_tests $review_tests $continuation_tests $builder_tests \
    $performance_tests $app_model_tests

/usr/bin/python3 -I - \
    $projection $reconciler $review $continuation $store $sqlite $builder \
    $projection_tests $reconciler_tests $review_tests $continuation_tests \
    $builder_tests $performance_tests $app_model_tests <<'PY'
