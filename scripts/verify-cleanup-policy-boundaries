#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"

policy_root=Sources/StornautCore/Policy
required_files=(
    "$policy_root/CleanupSelection.swift"
    "$policy_root/CleanupPolicyGate.swift"
    "$policy_root/CleanupPolicyContextCollector.swift"
    "$policy_root/CleanupAuthorization.swift"
)

for file in "${required_files[@]}"; do
    [[ -f "$file" ]] || {
        print -u2 "Missing Task 30 cleanup policy file: $file"
        exit 1
    }
done

if rg -n \
    'StornautCodex|ProbeBridge|Adapter|ActionExecutor|TrashMoving|trashItem|FileManagerTrashAdapter|RegisteredActionDefinition|FoundationRegisteredActionRunner|Process\(|posix_spawn|URLSession' \
    "${required_files[@]}"; then
    print -u2 "Cleanup Policy contains a prohibited runtime or write dependency."
    exit 1
fi

if rg -n \
    'removeItem|moveItem|copyItem|createFile|forWritingTo|O_WRONLY|O_RDWR|unlink\(|rename\(' \
    "${required_files[@]}"; then
    print -u2 "Cleanup Policy contains a target-write surface."
    exit 1
fi

if rg -n '^import (SwiftUI|AppKit)$' "${required_files[@]}"; then
    print -u2 "Cleanup Policy imports an App/UI framework."
    exit 1
fi

if rg -n \
    'FileManager|EvidenceStore|RunningActivityProvider|BuiltInRuleCatalog|BuiltInExecutionProfileCatalog|Bundle\.module|NSWorkspace' \
    "$policy_root/CleanupPolicyGate.swift"; then
    print -u2 "Pure CleanupPolicyGate performs or reaches mutable I/O."
    exit 1
fi

python3 - "$policy_root/CleanupAuthorization.swift" <<'PY'
import sys

source = open(sys.argv[1], encoding="utf-8").read()

def declaration_body(marker):
    start = source.find(marker)
    if start < 0:
        raise SystemExit(f"missing declaration {marker}")
    opening = source.find("{", start)
    if opening < 0:
        raise SystemExit(f"missing body for {marker}")
    depth = 0
    for index in range(opening, len(source)):
        if source[index] == "{":
            depth += 1
        elif source[index] == "}":
            depth -= 1
            if depth == 0:
                return source[opening + 1:index]
    raise SystemExit(f"unterminated declaration {marker}")

authorization = declaration_body("public struct ExecutionAuthorization:")
for forbidden in {
    "public init(",
    "Codable",
    "Decodable",
    "Encodable",
    "Equatable",
    "Hashable",
}:
    if forbidden in authorization:
        raise SystemExit(
            f"ExecutionAuthorization exposes replayable surface: {forbidden}"
        )

if "public actor CleanupAuthorizationController" in source:
    raise SystemExit("authorization minting actor escaped StornautCore")
if "states[authorization.nonce] = .consumed" not in source:
    raise SystemExit("authorization is not consumed before admission checks")
if "CleanupPolicyContext.maximumAge" not in source:
    raise SystemExit("authorization omits the 30-second admission bound")
PY

rg -Fq 'ActionRegistry(definitions: [])' \
    Sources/StornautCore/Policy/ActionPolicyGate.swift
rg -q 'private static let schemaVersion = 4' \
    Sources/StornautCore/Evidence/EvidenceStore.swift
rg -q '^package actor CleanupAuthorizationController' \
    "$policy_root/CleanupAuthorization.swift"
rg -q 'public struct ExecutionAuthorization: Sendable' \
    "$policy_root/CleanupAuthorization.swift"
rg -q 'public static let maximumAge: TimeInterval = 30' \
    "$policy_root/CleanupPolicyGate.swift"

echo "Cleanup Policy boundary verification passed."
