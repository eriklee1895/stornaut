function verify_iib5biii_b2ai_source_contract() {
    local single_path=$1 composition_path=$2 continuity_path=$3
    local bridge_path=$4 protocol_path=$5
    local source_path
    for source_path in "$single_path" "$composition_path" \
        "$continuity_path" "$bridge_path" "$protocol_path"
    do
        xcrun swiftc -frontend -parse "$source_path"
    done
    python3 - "$single_path" "$composition_path" "$continuity_path" \
        "$bridge_path" "$protocol_path" <<'PY'
from pathlib import Path
import re
import subprocess
import sys

single_path, composition_path, continuity_path, bridge_path, protocol_path = (
    map(Path, sys.argv[1:])
)
sources = {path: path.read_text(encoding="utf-8") for path in (
    single_path, composition_path, continuity_path, bridge_path, protocol_path
)}

def swift_code_only(source):
    output = list(source)
    index = 0
    block_depth = 0
    string_end = None
    raw_hashes = ""
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if string_end is not None:
            if source.startswith(string_end, index):
                width = len(string_end)
                output[index:index + width] = " " * width
                index += width
                string_end = None
                raw_hashes = ""
            elif not raw_hashes and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source) and source[index + 1] != "\n":
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        else:
            opener = re.match(r'(#+)?("""|")', source[index:])
            if opener is None:
                index += 1
                continue
            hashes = opener.group(1) or ""
            quote = opener.group(2)
            width = len(opener.group(0))
            output[index:index + width] = " " * width
            string_end = quote + hashes
            raw_hashes = hashes
            index += width
    if block_depth or string_end is not None:
        raise SystemExit("iii-b2a-i source-only Swift lexical scan drifted")
    return "".join(output)

code_sources = {path: swift_code_only(source) for path, source in sources.items()}
def swift_parse_tree(path):
    completed = subprocess.run(
        ["xcrun", "swiftc", "-frontend", "-dump-parse", str(path)],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    if completed.returncode != 0:
        raise SystemExit(
            "iii-b2a-i source-only Swift lexical scan drifted"
        )
    return completed.stdout

parse_trees = {path: swift_parse_tree(path) for path in sources}
expected_imports = {
    single_path: {
        "Foundation", "StornautInvestigationHandoffContract",
        "StornautInvestigationInstalledL2",
    },
    composition_path: {
        "Foundation", "StornautInvestigationHandoffContract",
        "StornautInvestigationInstalledL2",
    },
    continuity_path: {
        "Foundation", "StornautInvestigationHandoffContract",
    },
    bridge_path: {
        "Foundation", "StornautInvestigationHandoffContract",
    },
    protocol_path: {
        "Foundation", "StornautInvestigationHandoffContract",
    },
}
for path, source in sources.items():
    imports = set(re.findall(
        r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", code_sources[path]
    ))
    if imports != expected_imports[path]:
        raise SystemExit("iii-b2a-i source-only import surface drifted")
semantic = "\n".join(sources.values())
code_semantic = "\n".join(code_sources.values())
if re.search(r"(?m)^\s*(?:public|open)\s+", code_semantic):
    raise SystemExit("iii-b2a-i source-only public surface drifted")
if re.search(r"\b(?:Codable|Encodable|Decodable)\b", code_semantic):
    raise SystemExit("iii-b2a-i source-only Codable surface drifted")
for forbidden in (
    r"\b(?:Executor|MoveToTrash|RegisteredAction|readiness|"
    r"signedRuntimeReady|implementationAvailable)\b",
    r"\b(?:CommandLine\.arguments|ProcessInfo\.processInfo\.environment)\b",
    r"\bStornaut(?:Execution|Core|Lifecycle|Codex|InvestigationRuntime|"
    r"InvestigationDiagnostic|ProbeBridge|ProcessSupport)\b",
):
    if re.search(forbidden, code_semantic, re.IGNORECASE):
        raise SystemExit(
            "iii-b2a-i source-only App boundary gained physical authority"
        )
physical_authority_symbols = (
    "Darwin", "Glibc", "AppKit", "SwiftUI", "NSXPCConnection",
    "URLSession", "Process", "FileManager", "FileHandle",
    "NWConnection", "Network", "posix_spawn", "fork", "execve",
    "open", "openat", "write", "pwrite", "socket", "connect",
    "recv", "kill", "killpg", "waitpid", "waitid", "dup2",
    "fcntl", "close", "fileDescriptor", "STDIN_FILENO",
    "STDOUT_FILENO", "STDERR_FILENO", "O_WRONLY", "O_RDWR",
    "O_CREAT", "SIGTERM", "SIGKILL",
)
physical_authority = re.compile(
    r'(?:name|id|field)="(?:'
    + "|".join(map(re.escape, physical_authority_symbols))
    + r')"'
)
for path, parse_tree in parse_trees.items():
    if physical_authority.search(parse_tree):
        raise SystemExit(
            "iii-b2a-i source-only physical authority drifted"
        )

# `send` is also the name of the existing injected frame-transport method.
# Pin its exact source-only shapes instead of globally allowing an unqualified
# Darwin `send(2)` call to hide beside that abstraction.
unqualified_send = re.compile(
    r'\(unresolved_decl_ref_expr[^\n]*name="send" function_ref=unapplied\)'
)
if len(unqualified_send.findall(parse_trees[single_path])) != 5:
    raise SystemExit(
        "iii-b2a-i source-only physical authority drifted"
    )
for path in (composition_path, continuity_path, bridge_path, protocol_path):
    if unqualified_send.search(parse_trees[path]):
        raise SystemExit(
            "iii-b2a-i source-only physical authority drifted"
        )
for marker in (
    "package actor InvestigationMachineDarwinInnerProtocolState",
    "package actor InvestigationMachineDarwinOuterAdmission",
    "package struct InvestigationMachineSingleEpochAdmittedPhysicalResult",
    "fileprivate init(",
    "protocol InvestigationMachinePhysicalSingleEpochComposing:",
    "case admittedPhysical(",
    "case let .admittedPhysical(admitted):",
    "epochDeadlineNanoseconds: request.epochDeadlineNanoseconds",
    "evidence.appChild == exchange.appChild",
    "== exchange.physicalOwnership.helperIdentity",
    "private static let maximumAdmissionByteCount = 192 * 1_024",
    "normal.physicalResult.driverObservationSHA256",
    "case let .admittedPhysical(admitted) = result",
    "admittedBy admissionOwner: UUID",
    "guard proof.isBound(",
    "activeRequest == request, activeDecision.kind == .continue",
):
    if marker not in semantic:
        raise SystemExit(
            f"iii-b2a-i source-only semantic marker drifted: {marker}"
        )
if semantic.count("InvestigationMachineSingleEpochAdmittedPhysicalResult(") != 1:
    raise SystemExit("iii-b2a-i source-only admitted token mint drifted")
for forbidden in (
    "case physical(InvestigationMachineSingleEpochPhysicalResult)",
    "case admittedPhysical(InvestigationMachineSingleEpochPhysicalResult)",
    "init(physical: InvestigationMachineSingleEpochPhysicalResult)",
):
    if forbidden in semantic:
        raise SystemExit(
            "iii-b2a-i source-only raw DTO admission drifted"
        )
PY
}

function verify_iib5biii_b2a_iia1v_source_contract() {
    local session_path=$1 observer_path=$2
    local source_path
    for source_path in "$session_path" "$observer_path"; do
        xcrun swiftc -frontend -parse "$source_path"
    done
    python3 - "$session_path" "$observer_path" \
        "$repo_root/scripts/verify-app-release-boundaries" <<'PY'
from pathlib import Path
import re
import sys

session_path, observer_path, verifier_path = map(Path, sys.argv[1:])
repo_root = verifier_path.parent.parent.resolve()
expected_session_path = (
    repo_root / "Sources/StornautInvestigationMachineDriverSupport"
    / "InvestigationMachineDarwinOuterInnerSession.swift"
).resolve()
expected_observer_path = (
    repo_root / "Sources/StornautInvestigationMachineDriverSupport"
    / "InvestigationMachineDarwinDriverChildObservation.swift"
).resolve()
if session_path.resolve() != expected_session_path:
    raise SystemExit("iii-b2a-ii-a1-v outer-inner source path drifted")
if observer_path.resolve() != expected_observer_path:
    raise SystemExit("iii-b2a-ii-a1-v child-observation source path drifted")
session = session_path.read_text(encoding="utf-8")
observer = observer_path.read_text(encoding="utf-8")
for path, source in ((session_path, session), (observer_path, observer)):
    if source.count("#if DEBUG") != 1 or source.count("#endif") != 1:
        raise SystemExit(
            f"iii-b2a-ii-a1-v Debug-only source boundary drifted: {path}"
        )
    if not source.rstrip().endswith("#endif"):
        raise SystemExit(
            f"iii-b2a-ii-a1-v Debug-only source boundary drifted: {path}"
        )

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

if imports(session) != {
    "Darwin", "Foundation", "StornautInvestigationInstalledL2",
}:
    raise SystemExit("iii-b2a-ii-a1-v outer-inner import surface drifted")
if imports(observer) != {"CInvestigationIdentitySupport", "Darwin"}:
    raise SystemExit("iii-b2a-ii-a1-v observer import surface drifted")

semantic = session + "\n" + observer
if re.search(r"(?m)^\s*(?:public|open)\s+", semantic):
    raise SystemExit("iii-b2a-ii-a1-v public surface drifted")
if re.search(r"\b(?:Codable|Encodable|Decodable)\b", semantic):
    raise SystemExit("iii-b2a-ii-a1-v Codable surface drifted")
for forbidden in (
    r"\b(?:Executor|MoveToTrash|RegisteredAction|Cleanup|Policy|readiness|"
    r"signedRuntimeReady|implementationAvailable|admission)\b",
    r"\bStornaut(?:Execution|Core|Lifecycle|Codex|InvestigationRuntime|"
    r"InvestigationDiagnostic|ProbeBridge|ProcessSupport)\b",
    r"\b(?:NSXPCConnection|NSXPCListener|URLSession|NWConnection|AppKit|SwiftUI)\b",
    r"\b(?:FileManager|FileHandle|Process)\s*(?:\.|\()",
    r"\b(?:open|openat|creat|unlink|rename|truncate|mkdir|rmdir|chmod|chown)\s*\(",
    r"\b(?:fork|vfork|execv|execve|execvp|posix_spawnp|system|popen)\s*\(",
    r"\b(?:setuid|seteuid|setgid|setegid|setgroups|initgroups|setsid|setpgid)\s*\(",
):
    if re.search(forbidden, semantic, re.IGNORECASE):
        raise SystemExit(
            "iii-b2a-ii-a1-v source gained non-dormant or product authority"
        )

# These are the only two source files allowed to carry the dormant physical
# driver authority introduced by a1. This exception does not apply target-wide.
session_required = (
    "package struct InvestigationMachineDarwinInnerRoleValidator",
    "package func validate() throws",
    "system.argumentCount() == 1",
    "for descriptor in Int32(0)...Int32(9)",
    "error.errno == EBADF",
    "try innerRoleDescriptor(system, STDERR_FILENO) & FD_CLOEXEC == 0",
    "try innerRoleDescriptor(system, 8) & FD_CLOEXEC == 0",
    "try innerRoleDescriptor(system, 9) & FD_CLOEXEC == 0",
    "try innerRoleStatus(system, 8) & O_ACCMODE == O_RDWR",
    "try innerRoleStatus(system, 9) & O_ACCMODE == O_WRONLY",
    "try innerRoleSocket(system, 8) == SOCK_STREAM",
    "try innerRoleSocketEndpoints(system, 8) == .init(",
    "localFamily: sa_family_t(AF_UNIX)",
    "peerFamily: sa_family_t(AF_UNIX)",
    "system.noSigpipe(8) == 1, system.noSigpipe(9) == 1",
    "descriptorNodes[0].deviceID == initialStandardError.deviceID",
    "descriptorNodes[1].fileType == mode_t(S_IFSOCK)",
    "descriptorNodes[2].fileType == mode_t(S_IFIFO)",
    "Set(descriptorNodes).count == descriptorNodes.count",
    "let initialStandardError = try innerRoleStandardError(system)",
    "let finalStandardError = try innerRoleStandardError(system)",
    "deviceID: UInt64(bitPattern: Int64(status.st_dev))",
    "return observation.inode > 0",
    "identity.processID == processID",
    "identity.parentProcessID == parentProcessID",
    "identity.processGroupID == processID",
    "identity.effectiveUserID == 0",
    "initialStandardError == finalStandardError",
    "POSIX_SPAWN_SETPGROUP | POSIX_SPAWN_CLOEXEC_DEFAULT",
    "posix_spawn_file_actions_adddup2",
    "posix_spawnattr_setpgroup",
    "socketpair(AF_UNIX, SOCK_STREAM",
    "fcntl(descriptor, F_SETNOSIGPIPE, 1)",
    "Darwin.write(",
    "Darwin.read(",
)
observer_required = (
    "package struct InvestigationMachineDarwinDriverChildObserver",
    "firstNarrow = try system.narrowIdentity(processID)",
    "firstSnapshot = try system.processSnapshot(processID)",
    "secondSnapshot = try system.processSnapshot(processID)",
    "secondNarrow = try system.narrowIdentity(processID)",
    "firstNarrow == secondNarrow, firstSnapshot == secondSnapshot",
    "firstSnapshot.parentProcessID == expectedParentProcessID",
    "firstSnapshot.processGroupID == processID",
    "stornaut_investigation_identity_for_pid(",
    "stornaut_investigation_process_snapshot_for_pid(",
)
for marker in session_required:
    if marker not in session:
        raise SystemExit(
            f"iii-b2a-ii-a1-v dormant session authority drifted: {marker}"
        )
for marker in observer_required:
    if marker not in observer:
        raise SystemExit(
            f"iii-b2a-ii-a1-v dormant observer authority drifted: {marker}"
        )
for forbidden in (
    "recordIO", "CommandLine.arguments.dropFirst",
    "ProcessInfo.processInfo.environment",
):
    if forbidden in semantic:
        raise SystemExit(
            f"iii-b2a-ii-a1-v dormant authority escape drifted: {forbidden}"
        )

verifier = verifier_path.read_text(encoding="utf-8")
for marker in (
    "iib5biii_b2a_iia1v_debug_symbols=(",
    "iib5biii_b2a_iia1v_debug_authority_markers=(",
    "iib5biii_b2a_iia1v_debug_authority_imports=(",
    "iib5biii_b2a_iia1v_closed_images=(",
    "verify_iib5biii_b2a_iia1v_macho() {",
    '"$diagnostic_machine_driver" "$marker"',
    'for closed_image in "${iib5biii_b2a_iia1v_closed_images[@]}"; do',
    "iii-b2a-ii-a1-v Debug Machine driver positive control is missing",
    "iii-b2a-ii-a1-v dormant authority leaked into a closed image",
    "\nverify_iib5biii_b2a_iia1v_macho\n",
):
    if marker not in verifier:
        raise SystemExit(
            f"iii-b2a-ii-a1-v Mach-O source contract drifted: {marker}"
        )

def shell_array(name):
    match = re.search(
        rf"(?ms)^{re.escape(name)}=\(\n(?P<body>.*?)^\)\n", verifier
    )
    if match is None:
        raise SystemExit(f"iii-b2a-ii-a1-v Mach-O array missing: {name}")
    values = []
    for line in match.group("body").splitlines():
        value = line.strip()
        quoted = re.fullmatch(r"(['\"])(.*?)\1", value)
        if quoted is None:
            raise SystemExit(f"iii-b2a-ii-a1-v Mach-O array malformed: {name}")
        values.append(quoted.group(2))
    return values

if shell_array("iib5biii_b2a_iia1v_debug_symbols") != [
    "StornautInvestigationMachineDriverSupport.InvestigationMachineDarwinInnerRoleValidator",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineDarwinDriverChildObserver",
]:
    raise SystemExit("iii-b2a-ii-a1-v Debug symbol allowlist drifted")
if shell_array("iib5biii_b2a_iia1v_debug_authority_markers") != [
    "Darwin.write",
]:
    raise SystemExit("iii-b2a-ii-a1-v Debug authority-marker allowlist drifted")
if shell_array("iib5biii_b2a_iia1v_debug_authority_imports") != [
    "_write",
]:
    raise SystemExit("iii-b2a-ii-a1-v Debug authority-import allowlist drifted")
if shell_array("iib5biii_b2a_iia1v_closed_images") != [
    "$release_machine_driver",
    "$debug_app/Contents/MacOS/Stornaut",
    "$debug_app/Contents/MacOS/Stornaut.debug.dylib",
    "$debug_app/Contents/MacOS/__preview.dylib",
    "$release_app/Contents/MacOS/Stornaut",
    "$debug_app/Contents/MacOS/StornautLifecycleHelper",
    "$release_app/Contents/MacOS/StornautLifecycleHelper",
    "$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic",
    "$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic.debug.dylib",
    "$diagnostic_debug_app/Contents/MacOS/__preview.dylib",
    "$diagnostic_debug_app/Contents/MacOS/StornautLifecycleHelper",
    "$diagnostic_release_app/Contents/MacOS/StornautInvestigationDiagnosticReleaseShell",
]:
    raise SystemExit("iii-b2a-ii-a1-v closed-image allowlist drifted")
PY
}

