    macho_functions[0].encode("utf-8")
).hexdigest() != "36653bb270603fc041ee5b5761d871efeb151492cc3602c6cce33a14e35af858":
    raise SystemExit("iii-b2b-1a-1 Mach-O function body drifted")
if verifier.count("\nverify_iib5biii_b2b1a1_macho\n") != 1:
    raise SystemExit("iii-b2b-1a-1 Mach-O invocation drifted")
PY
}

function verify_iib5biii_b2b1b_source_contract() {
    local support_path=$1 entry_path=$2 verifier_path=$3 source_path
    for source_path in "$support_path" "$entry_path"; do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source_path"
    done
    python3 - "$support_path" "$entry_path" "$verifier_path" \
        "${ZSH_SCRIPT:A}" <<'PY'
from pathlib import Path
import re
import sys

support_path, entry_path, verifier_path, canonical_verifier = map(
    Path, sys.argv[1:]
)
if verifier_path.read_bytes() != canonical_verifier.read_bytes():
    raise SystemExit("iii-b2b-1b Mach-O verifier source drifted")
repo_root = verifier_path.parent.parent.resolve()
expected = {
    support_path: repo_root / "Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDriverSupport.swift",
    entry_path: repo_root / "Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineZeroArgumentEntry.swift",
}
for path, canonical in expected.items():
    if path.resolve() != canonical.resolve():
        raise SystemExit(f"iii-b2b-1b source path drifted: {path}")
support = support_path.read_text(encoding="utf-8")
entry = entry_path.read_text(encoding="utf-8")
if re.search(r"(?m)^import\s+(?!Darwin$|Foundation$|StornautInvestigationHandoffContract$)", support + entry):
    raise SystemExit("iii-b2b-1b import surface drifted")
if "#if DEBUG" in support + entry or "#endif" in support + entry:
    raise SystemExit("iii-b2b-1b source became Debug-gated")
for marker in (
    "InvestigationMachineZeroArgumentEntry.production(",
    "try await entry.run()",
    "package struct InvestigationMachineDriverCompletionArtifact",
    "stornaut.task39.machine.driver-completion",
    "InvestigationMachineFixedCapsuleIntake().read()",
    "InvestigationMachineEightEpochCohort(",
    "InvestigationMachineDarwinOuterInnerExecutionFactory()",
    "InvestigationMachineDarwinOuterInnerComposition()",
    "Darwin.write(descriptor, bytes.baseAddress, bytes.count)",
):
    if marker not in support + entry:
        raise SystemExit(f"iii-b2b-1b source semantic drifted: {marker}")
verifier = verifier_path.read_text(encoding="utf-8")
for marker in (
    "iib5biii_b2b1b_symbols=(",
    "iib5biii_b2b1b_positive_drivers=(",
    "iib5biii_b2b1b_closed_images=(",
    "verify_iib5biii_b2b1b_macho()",
    "iii-b2b-1b driver positive control is missing",
    "iii-b2b-1b zero-entry leaked into a closed image",
    "\nverify_iib5biii_b2b1b_macho\n",
):
    if marker not in verifier:
        raise SystemExit(f"iii-b2b-1b Mach-O source contract drifted: {marker}")
expected_projection = {
    "iib5biii_b2b1b_xcode_debug_undefined_sha256":
        "f267aa32579fa4fc216b603638eecbc2065741569bdc81bc713a449bb61b8a8c",
    "iib5biii_b2b1b_xcode_debug_undefined_lines": "696",
    "iib5biii_b2b1b_xcode_release_undefined_sha256":
        "7c404634c3da87081f3cd2d716c61df7ad45c8583d22103b95d3e6e956e6f981",
    "iib5biii_b2b1b_xcode_release_undefined_lines": "499",
    "iib5biii_b2b1b_xcode_loads_sha256":
        "dde8b8c4542bf1afbf276ecb5d5341bb35f3f95529573d149d1143cb18c080c9",
    "iib5biii_b2b1b_xcode_loads_lines": "18",
    "iib5biii_b2b1b_xcode_debug_owned_sha256":
        "1046c7407fe71790270fc29576d1ff2d1ac0e29f1f8d3aa4c6a9cf0527e6f559",
    "iib5biii_b2b1b_xcode_debug_owned_lines": "8661",
    "iib5biii_b2b1b_xcode_release_owned_sha256":
        "a82a4909089c97d1f8d262d46c8dabbdd179713855b7485598369a72dd049d7d",
    "iib5biii_b2b1b_xcode_release_owned_lines": "5996",
}
for name, expected_value in expected_projection.items():
    observed = re.findall(
        rf"(?m)^{re.escape(name)}=([0-9a-f]+)$", verifier
    )
    if observed != [expected_value]:
        raise SystemExit(f"iii-b2b-1b exact Xcode projection drifted: {name}")

def shell_array(name):
    matches = re.findall(
        rf"(?ms)^{re.escape(name)}=\(\n(?P<body>.*?)^\)\n", verifier
    )
    if len(matches) != 1:
        raise SystemExit(f"iii-b2b-1b Mach-O array malformed: {name}")
    values = []
    for line in matches[0].splitlines():
        quoted = re.fullmatch(r"(['\"])(.*?)\1", line.strip())
        if quoted is None:
            raise SystemExit(f"iii-b2b-1b Mach-O array malformed: {name}")
        values.append(quoted.group(2))
    return values

if shell_array("iib5biii_b2b1b_symbols") != [
    "StornautInvestigationMachineDriverSupport.InvestigationMachineZeroArgumentEntry",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineDriverCompletionArtifact",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineZeroArgumentRoleSelector",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineZeroArgumentOutputWriter",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineFixedCapsuleIntake",
