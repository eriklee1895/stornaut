import sys

project = Path(sys.argv[1]).read_text(encoding="utf-8")

native_target_section_start = project.find(
    "/* Begin PBXNativeTarget section */"
)
native_target_section_end = project.find(
    "/* End PBXNativeTarget section */",
    native_target_section_start,
)
if native_target_section_start < 0 or native_target_section_end < 0:
    raise SystemExit("missing PBX native-target section")
native_target_section = project[
    native_target_section_start:native_target_section_end
]
if native_target_section.count("isa = PBXNativeTarget;") != 10:
    raise SystemExit("L3c3b-i Xcode native-target allowlist drifted")
expected_native_targets = {
    "StornautApp",
    "StornautAppTests",
    "StornautAppUITests",
    "StornautLifecycleHelper",
    "StornautInvestigationDiagnosticApp",
    "StornautInvestigationDiagnosticAppTests",
    "StornautInvestigationDiagnosticReleaseShell",
    "StornautInvestigationMachineDriverNative",
    "StornautInvestigationMachineGateNative",
    "StornautInvestigationMachineGateCoordinatorNative",
}
for target_name in expected_native_targets:
    if native_target_section.count(f"name = {target_name};") != 1:
        raise SystemExit(
            f"L3c3b-i Xcode target identity drifted: {target_name}"
        )

copy_phase_section_start = project.find(
    "/* Begin PBXCopyFilesBuildPhase section */"
)
copy_phase_section_end = project.find(
    "/* End PBXCopyFilesBuildPhase section */",
    copy_phase_section_start,
