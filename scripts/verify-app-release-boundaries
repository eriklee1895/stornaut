        "$repo_root/scripts/verify-app-release-boundaries" <<'PY'
from pathlib import Path
import re
import sys

session_path, observer_path, verifier_path = map(Path, sys.argv[1:])
repo_root = verifier_path.parent.parent.resolve()
expected_session_path = (
