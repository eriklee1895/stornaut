mach_o_image_has_raw_string() {
    local image=$1
    local marker=$2
    local kind strings

    if [[ ! -f "$image" || -L "$image" ]]; then
        print -u2 "Mach-O raw-string scan target is invalid: $image"
        return 2
    fi
    if ! kind=$(file "$image" 2>/dev/null) \
        || [[ "$kind" != *'Mach-O'* ]]
    then
        print -u2 "Mach-O raw-string scan target is not Mach-O: $image"
        return 2
    fi
    if ! strings=$(xcrun strings -a "$image" 2>/dev/null); then
        print -u2 "Mach-O raw-string scan failed: $image"
        return 2
    fi
    [[ "$strings" == *"$marker"* ]]
}

mach_o_image_machine_retirement_selectors() {
    local image=$1
    local kind strings

    if [[ ! -f "$image" || -L "$image" ]]; then
        print -u2 "Mach-O selector scan target is invalid: $image"
        return 2
    fi
    if ! kind=$(file "$image" 2>/dev/null) \
        || [[ "$kind" != *'Mach-O'* ]]
    then
        print -u2 "Mach-O selector scan target is not Mach-O: $image"
        return 2
    fi
    if ! strings=$(xcrun strings -a "$image" 2>/dev/null); then
        print -u2 "Mach-O selector scan failed: $image"
        return 2
    fi
    print -r -- "$strings" \
        | awk \
            '$0 ~ /^[[:alpha:]_][[:alnum:]_]*MachineRetirement:withReply:$/' \
        | LC_ALL=C sort -u
}

