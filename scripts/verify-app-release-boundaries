    /usr/bin/codesign -d --verbose=4 "$diagnostic_machine_driver" 2>&1 | /usr/bin/sed -n 's/^CDHash=//p'
)
print -r -- "$machine_driver_product_cdhash" | /usr/bin/grep -Eq '^[0-9a-f]{40}([0-9a-f]{24})?$'
test "$diagnostic_machine_driver_cdhash" = "$machine_driver_product_cdhash"
machine_driver_product_requirement=$(
    /usr/bin/codesign -d -r- "$machine_driver_product" 2>&1 | /usr/bin/sed -n 's/^# //p'
)
diagnostic_machine_driver_requirement=$(
    /usr/bin/codesign -d -r- "$diagnostic_machine_driver" 2>&1 | /usr/bin/sed -n 's/^# //p'
)
test "$machine_driver_product_requirement" = "designated => cdhash H\"$machine_driver_product_cdhash\""
test "$diagnostic_machine_driver_requirement" = "$machine_driver_product_requirement"
machine_driver_product_sha256=$(
    /usr/bin/shasum -a 256 "$machine_driver_product" | /usr/bin/awk '{print $1}'
)
diagnostic_machine_driver_sha256=$(
    /usr/bin/shasum -a 256 "$diagnostic_machine_driver" | /usr/bin/awk '{print $1}'
)
print -r -- "$machine_driver_product_sha256" | /usr/bin/grep -Eq '^[0-9a-f]{64}$'
test "$diagnostic_machine_driver_sha256" = "$machine_driver_product_sha256"
test "$diagnostic_machine_driver_identifier" = "$machine_driver_product_identifier"
test "$(/usr/bin/stat -f '%d:%i' "$machine_driver_product")" = \
    "$machine_driver_product_node"
test "$(/usr/bin/stat -f '%d:%i' "$diagnostic_machine_driver")" = \
    "$diagnostic_machine_driver_node"
test ! -e \
    "$debug_app/Contents/Library/LaunchDaemons/com.eriklee.stornaut.lifecycle.plist"
test ! -e \
    "$release_app/Contents/Library/LaunchDaemons/com.eriklee.stornaut.lifecycle.plist"

verify_closed_machine_tool_disposable_matrix() {
    (
        setopt local_options pipe_fail

        local validator="$repo_root/scripts/stornaut-r5-local-lifecycle"
        local authorization="I authorize one bounded disposable read-only Stornaut L3c3b-ii Machine driver validation."
        local temporary_root outside_temporary_root
        local built_app staging_app installed_app identity_mismatch_app
        local acl_mismatch_app missing_gate_app swapped_gate_coordinator_app
        local hardlinked_coordinator_app mutation_before_move_app
        local mutation_before_bootstrap_app
        local symlinked_gate_app wrong_mode_gate_app wrong_signature_gate_app
        local outside_built_app outside_staging_app outside_installed_app
        local positive_output

        mkdir -p "$repo_root/.derivedData"
        temporary_root=$(
            mktemp -d \
                "$repo_root/.derivedData/machine-driver-validation.XXXXXX"
        )
        outside_temporary_root=$(
            mktemp -d \
                /private/tmp/stornaut-machine-driver-outside-root.XXXXXX
        )
        cleanup_machine_driver_disposable_matrix() {
            rm -rf -- "$temporary_root" "$outside_temporary_root"
        }
        trap cleanup_machine_driver_disposable_matrix EXIT INT TERM

        built_app="$temporary_root/built.app"
        staging_app="$temporary_root/staging.app"
        installed_app="$temporary_root/installed.app"
        identity_mismatch_app="$temporary_root/identity-mismatch.app"
        acl_mismatch_app="$temporary_root/acl-mismatch.app"
        missing_gate_app="$temporary_root/missing-gate.app"
        swapped_gate_coordinator_app="$temporary_root/swapped-gate-coordinator.app"
        hardlinked_coordinator_app="$temporary_root/hardlinked-coordinator.app"
        mutation_before_move_app="$temporary_root/mutation-before-move.app"
        mutation_before_bootstrap_app="$temporary_root/mutation-before-bootstrap.app"
        symlinked_gate_app="$temporary_root/symlinked-gate.app"
        wrong_mode_gate_app="$temporary_root/wrong-mode-gate.app"
        wrong_signature_gate_app="$temporary_root/wrong-signature-gate.app"
        outside_built_app="$outside_temporary_root/built.app"
        outside_staging_app="$outside_temporary_root/staging.app"
        outside_installed_app="$outside_temporary_root/installed.app"

        for disposable_app in \
            "$built_app" \
            "$staging_app" \
            "$installed_app" \
            "$identity_mismatch_app" \
            "$acl_mismatch_app" \
            "$missing_gate_app" \
            "$swapped_gate_coordinator_app" \
            "$hardlinked_coordinator_app" \
            "$mutation_before_move_app" \
            "$mutation_before_bootstrap_app" \
            "$symlinked_gate_app" \
            "$wrong_mode_gate_app" \
            "$wrong_signature_gate_app" \
            "$outside_built_app" \
            "$outside_staging_app" \
            "$outside_installed_app"
        do
            /usr/bin/ditto --noqtn \
                "$diagnostic_debug_app" "$disposable_app"
        done

        # positive: all three disposable planes carry one exact identity.
        positive_output=$(
            "$validator" validate-machine-driver \
                "$authorization" \
                "$temporary_root" \
                "$built_app" \
                "$staging_app" \
                "$installed_app"
        )
        test "$positive_output" = \
            "lifecycle.local.machine-driver-validation=complete"

        # wrong-token: exact authorization text is mandatory.
        if "$validator" validate-machine-driver \
            "wrong-token" \
            "$temporary_root" \
            "$built_app" \
            "$staging_app" \
            "$installed_app" >/dev/null 2>&1
        then
            print -u2 "wrong-token Machine driver validation passed"
            return 1
        fi

        /bin/rm -f -- \
            "$symlinked_gate_app/Contents/MacOS/StornautInvestigationMachineGate"
        /bin/ln -s StornautInvestigationMachineDriver \
            "$symlinked_gate_app/Contents/MacOS/StornautInvestigationMachineGate"
        # symlinked-gate: no role may be admitted through a symlink.
        if "$validator" validate-machine-driver \
            "$authorization" "$temporary_root" "$built_app" \
            "$staging_app" "$symlinked_gate_app" >/dev/null 2>&1
        then
            print -u2 "symlinked-gate validation passed"
            return 1
        fi

        /bin/chmod 0700 \
            "$wrong_mode_gate_app/Contents/MacOS/StornautInvestigationMachineGate"
        # wrong-mode-gate: every executable has exact mode 0755.
        if "$validator" validate-machine-driver \
            "$authorization" "$temporary_root" "$built_app" \
            "$staging_app" "$wrong_mode_gate_app" >/dev/null 2>&1
        then
            print -u2 "wrong-mode-gate validation passed"
            return 1
        fi

        /usr/bin/codesign --remove-signature \
            "$wrong_signature_gate_app/Contents/MacOS/StornautInvestigationMachineGate"
        # wrong-signature-gate: strict code-signing admission is mandatory.
        if "$validator" validate-machine-driver \
            "$authorization" "$temporary_root" "$built_app" \
            "$staging_app" "$wrong_signature_gate_app" >/dev/null 2>&1
        then
            print -u2 "wrong-signature-gate validation passed"
            return 1
        fi

        /bin/rm -f -- \
            "$missing_gate_app/Contents/MacOS/StornautInvestigationMachineGate"
        # missing-gate: every plane must contain the complete closed role set.
        if "$validator" validate-machine-driver \
            "$authorization" "$temporary_root" "$built_app" \
            "$staging_app" "$missing_gate_app" >/dev/null 2>&1
        then
            print -u2 "missing-gate closed machine validation passed"
            return 1
        fi

        /bin/cp -f \
            "$swapped_gate_coordinator_app/Contents/MacOS/StornautInvestigationMachineGateCoordinator" \
            "$swapped_gate_coordinator_app/Contents/MacOS/StornautInvestigationMachineGate"
        # swapped-gate-coordinator: a valid sibling cannot satisfy another role.
        if "$validator" validate-machine-driver \
            "$authorization" "$temporary_root" "$built_app" \
            "$staging_app" "$swapped_gate_coordinator_app" >/dev/null 2>&1
        then
            print -u2 "swapped-gate-coordinator validation passed"
            return 1
        fi

        /bin/rm -f -- \
            "$hardlinked_coordinator_app/Contents/MacOS/StornautInvestigationMachineGateCoordinator"
        /bin/ln \
            "$hardlinked_coordinator_app/Contents/MacOS/StornautInvestigationMachineDriver" \
            "$hardlinked_coordinator_app/Contents/MacOS/StornautInvestigationMachineGateCoordinator"
        # hardlinked-coordinator: every machine tool must have link count one.
        if "$validator" validate-machine-driver \
            "$authorization" "$temporary_root" "$built_app" \
            "$staging_app" "$hardlinked_coordinator_app" >/dev/null 2>&1
        then
            print -u2 "hardlinked-coordinator validation passed"
            return 1
        fi

        /bin/chmod 0700 \
            "$mutation_before_move_app/Contents/MacOS/StornautInvestigationMachineGate"
        if "$validator" validate-machine-driver \
            "$authorization" "$temporary_root" "$built_app" \
            "$mutation_before_move_app" "$installed_app" >/dev/null 2>&1
        then
            print -u2 "mutation-before-move validation passed"
            return 1
        fi

        /usr/bin/codesign --remove-signature \
            "$mutation_before_bootstrap_app/Contents/MacOS/StornautInvestigationMachineGateCoordinator"
        if "$validator" validate-machine-driver \
            "$authorization" "$temporary_root" "$built_app" \
            "$staging_app" "$mutation_before_bootstrap_app" >/dev/null 2>&1
        then
            print -u2 "mutation-before-bootstrap validation passed"
            return 1
        fi

        # outside-root: canonical root outside repo .derivedData is rejected.
        if "$validator" validate-machine-driver \
            "$authorization" \
            "$outside_temporary_root" \
            "$outside_built_app" \
            "$outside_staging_app" \
            "$outside_installed_app" >/dev/null 2>&1
        then
            print -u2 "outside-root Machine driver validation passed"
            return 1
        fi

        # duplicate-app: the three validation planes must be distinct.
        if "$validator" validate-machine-driver \
            "$authorization" \
            "$temporary_root" \
            "$built_app" \
            "$built_app" \
            "$installed_app" >/dev/null 2>&1
        then
            print -u2 "duplicate-app Machine driver validation passed"
            return 1
        fi

        /bin/cp -f \
            "$identity_mismatch_app/Contents/MacOS/StornautLifecycleHelper" \
            "$identity_mismatch_app/Contents/MacOS/StornautInvestigationMachineDriver"
        # identity-mismatch: installed plane must equal the built identity.
        if "$validator" validate-machine-driver \
            "$authorization" \
            "$temporary_root" \
            "$built_app" \
            "$staging_app" \
            "$identity_mismatch_app" >/dev/null 2>&1
        then
            print -u2 "identity-mismatch Machine driver validation passed"
            return 1
        fi

        /bin/chmod +a \
            "user:$(/usr/bin/id -un) allow read,write" \
            "$acl_mismatch_app/Contents/MacOS/StornautInvestigationMachineDriver"
        # acl-mismatch: no validation plane may carry an extended ACL.
        if "$validator" validate-machine-driver \
            "$authorization" \
            "$temporary_root" \
            "$built_app" \
            "$staging_app" \
            "$acl_mismatch_app" >/dev/null 2>&1
        then
            print -u2 "acl-mismatch Machine driver validation passed"
            return 1
        fi
    )
}

verify_closed_machine_tool_disposable_matrix

