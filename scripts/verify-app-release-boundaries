    'for marker in "${iib4_machine_claim_required_security_imports[@]}"; do',
    'for closed_image in "${iib4_machine_claim_closed_images[@]}"; do',
):
    if marker not in runtime_source[start:end]:
        raise SystemExit(f"ii-b4 machine-claim source contract drifted: {[marker]!r}")

for forbidden in (
    "$machine_driver_product",
    "$diagnostic_machine_driver",
    "$debug_app/Contents/MacOS/StornautLifecycleHelper",
    "$release_app/Contents/MacOS/StornautLifecycleHelper",
    "$diagnostic_debug_app/Contents/MacOS/StornautLifecycleHelper",
):
    if forbidden in array_values("iib4_machine_claim_closed_images"):
        raise SystemExit(
            "ii-b4 machine-claim negative-image scope drifted: "
            f"{forbidden}"
        )
PY
}

function verify_iib5biic_machine_driver_source_contract() {
    local source_path=$1
    python3 - "$source_path" <<'PY'
from pathlib import Path
import re
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")
runtime_source = source[source.index(
    "\nscripts/verify-contract --iic-a-contract-only\n"
):]

def array_values(name):
    match = re.search(
        rf"(?ms)^{re.escape(name)}=\(\n(?P<body>.*?)^\)\n",
        runtime_source,
    )
    if match is None:
        raise SystemExit(f"ii-b5b-ii-c Machine driver array missing: {name}")
    values = []
    for line in match.group("body").splitlines():
        quoted = re.fullmatch(r"\s+(['\"])(.*?)\1\s*", line)
        bare = re.fullmatch(
            r"\s+([A-Za-z0-9_.$:/-]+(?:\s+[A-Za-z0-9_.$:/-]+)*)\s*",
            line,
        )
        if quoted is not None:
            values.append(quoted.group(2))
        elif bare is not None:
            values.extend(bare.group(1).split())
        else:
            raise SystemExit(
                f"ii-b5b-ii-c Machine driver array malformed: {name}"
            )
    return values

introduced = [
    "_free", "_getpgid", "_getpgrp", "_poll", "_posix_spawn",
    "_posix_spawn_file_actions_addclose",
    "_posix_spawn_file_actions_adddup2",
    "_posix_spawn_file_actions_destroy",
    "_posix_spawn_file_actions_init",
    "_posix_spawnattr_destroy", "_posix_spawnattr_init",
    "_posix_spawnattr_setflags", "_posix_spawnattr_setpgroup",
    "_recv", "_send", "_shutdown", "_socketpair", "_strdup",
]
expected_arrays = {
    "iib5biic_debug_introduced_imports": introduced,
    "iib5biic_debug_required_fcntl_imports": [
        "_$s6Darwin5fcntlys5Int32VAD_A2DtF",
        "_$s6Darwin5fcntlys5Int32VAD_ADtF",
    ],
    "iib5biic_release_forbidden_imports": introduced,
}

for name, expected in expected_arrays.items():
    observed = array_values(name)
    if observed != expected:
        raise SystemExit(
            f"ii-b5b-ii-c Machine driver array drifted: {name}: "
            f"{observed!r}"
        )

forbidden = set(array_values("machine_driver_authority_forbidden_imports"))
for exempt in ("_posix_spawn", "_socketpair", "_send", "_recv"):
    if exempt in forbidden:
        raise SystemExit(
            f"ii-b5b-ii-c fixed import remains categorically forbidden: {exempt}"
        )
for retained in (
    "_posix_spawnp", "_execve", "_connect", "_bind", "_listen",
    "_sendto", "_recvfrom", "_write",
):
    if retained not in forbidden:
        raise SystemExit(
            f"ii-b5b-ii-c sibling authority prohibition drifted: {retained}"
        )

def loop_body(header, label):
    loop_header = f'for marker in "${{{header}[@]}}"; do'
    if runtime_source.count(loop_header) != 1:
        raise SystemExit(f"ii-b5b-ii-c {label} loop drifted")
    match = re.search(
        rf'(?ms)^for marker in "\$\{{{re.escape(header)}\[@\]\}}"; do\n'
        rf'(?P<body>.*?)^done$',
        runtime_source,
    )
    if match is None:
        raise SystemExit(f"ii-b5b-ii-c {label} loop drifted")
    return re.sub(r"\s+", " ", match.group("body")).strip()

debug_body = loop_body(
    "iib5biic_debug_introduced_imports", "Debug positive-import"
)
fcntl_body = loop_body(
    "iib5biic_debug_required_fcntl_imports", "Debug fcntl-import"
)
release_body = loop_body(
    "iib5biic_release_forbidden_imports", "Release negative-import"
)
for body, image, message in (
    (debug_body, "$machine_driver_undefined_symbols",
     "ii-b5b-ii-c Debug fixed-session import is missing: $marker"),
    (fcntl_body, "$machine_driver_undefined_symbols",
     "ii-b5b-ii-c Debug fcntl import is missing: $marker"),
    (release_body, "$release_machine_driver_undefined_symbols",
     "ii-b5b-ii-c fixed-session import leaked into Release: $marker"),
):
    for required in (image, "grep -Fxq -- \"$marker\"", message):
        if body.count(required) != 1:
            raise SystemExit(
                f"ii-b5b-ii-c Machine driver scanner drifted: {required}"
            )
PY
}

function verify_iib5biid_machine_driver_source_contract() {
    local source_path=$1
    python3 - "$source_path" <<'PY'
from pathlib import Path
import re, sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
runtime = source[source.index(
    "\nscripts/verify-contract --iic-a-contract-only\n"
):]
def values(name):
    match = re.search(rf"(?ms)^{name}=\(\n(?P<body>.*?)^\)\n", runtime)
    if match is None: raise SystemExit(f"ii-b5b-ii-d array missing: {name}")
    result=[]
    for line in match.group("body").splitlines():
        value=line.strip().strip("'\"")
        if value: result.extend(value.split())
    return result
expected=["_kill", "_nanosleep", "_proc_listpids", "_waitid", "_waitpid"]
for name in ("iib5biid_debug_introduced_imports", "iib5biid_release_forbidden_imports"):
    if values(name) != expected: raise SystemExit(f"ii-b5b-ii-d Machine driver array drifted: {name}")
for exempt in expected:
    if exempt in values("machine_driver_authority_forbidden_imports"):
        raise SystemExit(f"ii-b5b-ii-d fixed import remains categorically forbidden: {exempt}")
for retained in ("_killpg", "_pthread_kill", "_raise", "_write", "_posix_spawnp"):
    if retained not in values("machine_driver_authority_forbidden_imports"):
        raise SystemExit(f"ii-b5b-ii-d sibling authority prohibition drifted: {retained}")
for name, image, message in (
    ("iib5biid_debug_introduced_imports", "$machine_driver_undefined_symbols", "ii-b5b-ii-d Debug retirement import is missing: $marker"),
    ("iib5biid_release_forbidden_imports", "$release_machine_driver_undefined_symbols", "ii-b5b-ii-d retirement import leaked into Release: $marker"),
):
    match=re.search(rf'(?ms)^for marker in "\$\{{{name}\[@\]\}}"; do\n(?P<body>.*?)^done$',runtime)
    if match is None: raise SystemExit(f"ii-b5b-ii-d Machine driver scanner drifted: {name}")
    body=match.group("body")
    for marker in (image, 'grep -Fxq -- "$marker"', message):
        if body.count(marker)!=1: raise SystemExit(f"ii-b5b-ii-d Machine driver scanner drifted: {marker}")
PY
}

function verify_iic0a_source_contract() {
    local projection_path=$1 intake_path=$2
    python3 - "$projection_path" "$intake_path" <<'PY'
from pathlib import Path
import re
import sys
projection_path, intake_path = map(Path, sys.argv[1:])
projection = projection_path.read_text(encoding="utf-8")
intake = intake_path.read_text(encoding="utf-8")
imports = lambda value: set(re.findall(
    r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", value
))
if imports(projection) != {"Foundation"}:
    raise SystemExit("ii-c0a projection import surface drifted")
if imports(intake) != {
    "Darwin", "Foundation", "StornautInvestigationHandoffContract"
}:
    raise SystemExit("ii-c0a intake import surface drifted")
for label, source in (("projection", projection), ("intake", intake)):
    for forbidden in (
        r"import\s+(?:StornautCore|StornautCodex|StornautLifecycle|StornautExecution|StornautInvestigationRuntime|StornautInvestigationDiagnostic)",
        r"\b(?:JSONDecoder|JSONEncoder|PropertyListDecoder|PropertyListEncoder)\b",
        r"\b(?:ActionExecutor|TrashMoving|RegisteredAction|CleanupExecutionRuntime)\b",
        r"\b(?:URLSession|NSURLConnection|NSXPCConnection|NWConnection|"
        r"WebSocket|CFStream|CFReadStream|CFWriteStream|DispatchIO)\b",
        r"\b(?:posix_spawnp?|fork|execv|execve|execvp|execl|execlp|"
        r"system|popen|AuthorizationCreate)\s*\(",
        r"\bsudo\b",
        r"\b(?:FileManager|FileHandle|NSFileHandle|OutputStream|FileWrapper|"
        r"NSData|NSMutableData|NSMutableString|UserDefaults|"
        r"NSFileCoordinator|NSFileVersion|NSUbiquitousKeyValueStore)\b",
        r"\.write\s*\(\s*(?:to|toFile):",
        r"\b(?:removeItem|moveItem|copyItem|trashItem|replaceItem|"
        r"createFile|createDirectory|createSymbolicLink|linkItem|"
        r"setAttributes|forWritingTo|writeabilityHandler)\b",
        r"\b(?:Darwin\.)?(?:open|openat|creat|fopen|freopen|write|"
        r"writev|pwrite|pwritev|unlink|unlinkat|rename|renameat|mkdir|"
        r"mkdirat|rmdir|chmod|fchmod|chown|fchown|symlink|link|truncate|"
        r"ftruncate|setxattr|fsetxattr|removexattr|fremovexattr|mmap|"
        r"msync|ioctl|copyfile|fcopyfile|clonefile|socket|socketpair|"
        r"connect|bind|listen|accept|accept4|send|sendto|sendmsg|recv|"
        r"recvfrom|recvmsg|getaddrinfo|kill|killpg|pthread_kill|raise)\s*\(",
        r"\b(?:O_WRONLY|O_RDWR|O_CREAT|O_TRUNC|O_APPEND)\b",
        r"\bCommandLine\.arguments\b",
        r"\bProcessInfo\.processInfo\.environment\b",
        r"\breadLine\s*\(",
        r"\b(?:signedInvestigationRuntimeReady|signedRuntimeReady|readiness)\b",
    ):
        if re.search(forbidden, source, re.IGNORECASE):
            raise SystemExit(
                f"ii-c0a {label} gained runtime import or authority: {forbidden}"
            )
for marker in (
    "package struct InvestigationProjectedCohortInput",
    "package let projections: [InvestigationInstalledL2IdentityProjection]",
):
    if marker not in projection:
        raise SystemExit(f"ii-c0a projection source marker drifted: {marker}")
for marker in (
    "input: try InvestigationProjectedCohortInput.decode(encoded)",
    "projection: selected.projection",
):
    if marker not in intake:
        raise SystemExit(f"ii-c0a intake source marker drifted: {marker}")
expected_sha256 = {
    projection_path:
        "f60d4f92da42293ff044c29756fc55692ce354035f49b9a3ec415166c89b885a",
    intake_path:
        "d4898e6f9196a169d29107a40063238adf52d9fd8842e2bacdf9b433e09c1dd6",
}
for path, expected in expected_sha256.items():
    if __import__("hashlib").sha256(path.read_bytes()).hexdigest() != expected:
        raise SystemExit(f"ii-c0a source seal drifted: {path}")
PY
}

function verify_iic0bi_source_contract() {
    local author_path=$1 composition_path=$2 verifier_path=$3 source_path
    for source_path in "$author_path" "$composition_path"; do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source_path"
    done
    python3 - "$author_path" "$composition_path" "$verifier_path" \
        "${ZSH_SCRIPT:A}" <<'PY'
from pathlib import Path
import re
import sys

author_path, composition_path, verifier_path, canonical_path = map(
    Path, sys.argv[1:]
)
if verifier_path.read_bytes() != canonical_path.read_bytes():
    raise SystemExit("ii-c0b-i component verifier source drifted")
root = canonical_path.parent.parent.resolve()
expected_paths = {
    author_path: root / "Sources/StornautInvestigationDiagnostic/InvestigationProjectedCohortAuthor.swift",
    composition_path: root / "Sources/StornautInvestigationDiagnostic/InvestigationRuntimeDiagnosticComposition.swift",
}
for path, expected in expected_paths.items():
    if path.resolve() != expected.resolve():
        raise SystemExit(f"ii-c0b-i source path drifted: {path}")
author = author_path.read_text(encoding="utf-8")
composition = composition_path.read_text(encoding="utf-8")
lines = [line.strip() for line in author.splitlines() if line.strip()]
if not lines or lines[0] != "#if DEBUG" or lines[-1] != "#endif" \
        or lines.count("#if DEBUG") != 1 or lines.count("#endif") != 1:
    raise SystemExit("ii-c0b-i author DEBUG boundary drifted")
if re.search(r"(?m)^\s*(?:public|open)\s+", author) or re.search(
    r"\b(?:Codable|Encodable|Decodable)\b", author
):
    raise SystemExit("ii-c0b-i package-only or Codable surface drifted")
if "package init()" not in author or re.search(
    r"package\s+(?:struct InvestigationProjectedCohortGeneratedIdentifiers|typealias (?:Clock|IdentifierProvider)|init\(\s*now:)", author,
):
    raise SystemExit("ii-c0b-i injectable production constructor drifted")
if re.search(r"(?m)^(?:(?:package|internal)\s+)?(?:let|var)\s+", author):
    raise SystemExit("ii-c0b-i producer gained premature production call site")
mapping = re.findall(
    r"(?ms)^package enum InvestigationHandoffScenarioMapping.*?^}\n",
    composition,
)
if len(mapping) != 1 or mapping[0].count("switch scenario") != 1 \
        or re.search(r"\bswitch\s+scenario\b", author) \
        or "InvestigationHandoffScenarioMapping.handoffScenario(" not in author:
    raise SystemExit("ii-c0b-i scenario mapping ownership drifted")
top_level_types = re.findall(
    r"(?m)^(?:package|internal|public|open|private)?\s*"
    r"(?:enum|struct|class|actor)\s+([A-Za-z_][A-Za-z0-9_]*)", author
)
top_level_functions = re.findall(
    r"(?m)^(?:package|internal|public|open|private)?\s*func\s+"
    r"([A-Za-z_][A-Za-z0-9_]*)", author
)
if top_level_types != [
    "InvestigationProjectedCohortAuthorError",
    "InvestigationProjectedCohortInstalledBinding",
    "InvestigationProjectedCohortGeneratedIdentifiers",
    "InvestigationProjectedCohortAuthor",
] or top_level_functions != ["lowercaseHexNibble"]:
    raise SystemExit("ii-c0b-i producer gained premature production call site")
if re.findall(
    r"(?m)^(?:package|internal|public|open|private)?\s*extension\s+"
    r"([A-Za-z_][A-Za-z0-9_]*)", author
) != ["Data"] or author.count("private extension Data {") != 1:
    raise SystemExit("ii-c0b-i producer gained premature production call site")
if "InvestigationProjectedCohortAuthor" in composition:
    raise SystemExit("ii-c0b-i producer gained premature production call site")
for source in (author, composition):
    if re.search(r"import\s+(?:StornautExecution|StornautProcessSupport)", source):
        raise SystemExit("ii-c0b-i dependency surface drifted")
    if re.search(
        r"\b(?:ActionExecutor|TrashMoving|RegisteredAction|CleanupExecutionRuntime)\b"
        r"|\bCommandLine\b|\bProcessInfo\.processInfo\.(?:arguments|environment)\b"
        r"|\bUserDefaults\b|\b(?:getenv|environ|_NSGetArgc|_NSGetArgv)\b",
        source, re.I,
    ):
        raise SystemExit("ii-c0b-i producer gained prohibited authority")
if __import__("hashlib").sha256(author.encode()).hexdigest() != "33036861e4edbd52cd96f8de3acd4843550365105a55ce32d63ab39a25789ea5":
    raise SystemExit("ii-c0b-i producer source seal drifted")
verifier = verifier_path.read_text(encoding="utf-8")
for marker in (
    "iic0bi_component_symbols=(",
    "iic0bi_swiftpm_debug_object=",
    "iic0bi_swiftpm_release_object=",
    "iic0bi_debug_diagnostic_image=",
    "iic0bi_debug_machine_drivers=(",
    "iic0bi_closed_images=(",
    "ii-c0b-i Debug SwiftPM object positive control is missing",
    "ii-c0b-i Debug diagnostic carriage positive control is missing",
    "ii-c0b-i Debug Machine driver negative control is missing",
    "ii-c0b-i producer leaked into Release SwiftPM object",
    "ii-c0b-i producer leaked into a final image",
    "verify_iic0bi_component_boundary",
):
    if marker not in verifier:
        raise SystemExit(f"ii-c0b-i component boundary drifted: {marker}")
if "iic0bi_" + "positive_drivers" in verifier \
        or "ii-c0b-i producer missing from " + "diagnostic App" in verifier:
    raise SystemExit("ii-c0b-i made a premature final-App positive claim")
PY
}

function verify_iic0bi_component_boundary() {
    local scratch
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iic0bi-component.XXXXXX")
    local result_code=0
    (
        trap 'rm -rf "$scratch"' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        swift build --scratch-path "$scratch/swiftpm-debug" \
            --configuration debug --target StornautInvestigationDiagnostic || exit $?
        swift build --scratch-path "$scratch/swiftpm-release" \
            --configuration release --target StornautInvestigationDiagnostic || exit $?

        iic0bi_swiftpm_debug_object=$(find "$scratch/swiftpm-debug" \
            -type f -name 'InvestigationProjectedCohortAuthor.swift.o' \
            -print -quit)
        iic0bi_swiftpm_release_object=$(find "$scratch/swiftpm-release" \
            -type f -name 'InvestigationProjectedCohortAuthor.swift.o' \
            -print -quit)
        [[ -n "$iic0bi_swiftpm_debug_object" ]] || {
            print -u2 "ii-c0b-i Debug SwiftPM object positive control is missing"
            exit 1
        }
        local debug_symbols release_symbols=
        debug_symbols=$(xcrun nm -j "$iic0bi_swiftpm_debug_object" \
            | xcrun swift-demangle) || exit $?
        if [[ -n "$iic0bi_swiftpm_release_object" ]]; then
            release_symbols=$(xcrun nm -j "$iic0bi_swiftpm_release_object" \
                | xcrun swift-demangle) || exit $?
        fi
        iic0bi_component_symbols=(
            'StornautInvestigationDiagnostic.InvestigationProjectedCohortInstalledBinding'
            'StornautInvestigationDiagnostic.InvestigationProjectedCohortGeneratedIdentifiers'
            'StornautInvestigationDiagnostic.InvestigationProjectedCohortAuthor'
            'author(configurationData:'
        )
        local marker
        for marker in "${iic0bi_component_symbols[@]}"; do
            [[ "$debug_symbols" == *"$marker"* ]] || {
                print -u2 \
                    "ii-c0b-i Debug SwiftPM object positive control is missing: $marker"
                exit 1
            }
            [[ "$release_symbols" != *"$marker"* ]] || {
                print -u2 \
                    "ii-c0b-i producer leaked into Release SwiftPM object: $marker"
                exit 1
            }
        done

        xcodebuild -quiet -project Stornaut.xcodeproj -scheme Stornaut \
            -configuration Debug -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$scratch/xcode-product" build || exit $?
        xcodebuild -quiet -project Stornaut.xcodeproj -scheme Stornaut \
            -configuration Release -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$scratch/xcode-product" build || exit $?
        xcodebuild -quiet -project Stornaut.xcodeproj \
            -scheme StornautInvestigationDiagnosticApp -configuration Debug \
            -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$scratch/xcode-diagnostic" build || exit $?
        xcodebuild -quiet -project Stornaut.xcodeproj \
            -scheme StornautInvestigationDiagnosticReleaseShell \
            -configuration Release -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$scratch/xcode-diagnostic" build || exit $?
        xcodebuild -quiet -project Stornaut.xcodeproj \
            -scheme StornautInvestigationMachineDriverNative \
            -configuration Release -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$scratch/xcode-diagnostic" build || exit $?
        iic0bi_debug_diagnostic_image="$scratch/xcode-diagnostic/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationDiagnostic.debug.dylib"
        [[ -f "$iic0bi_debug_diagnostic_image" ]] || {
            print -u2 "ii-c0b-i Debug diagnostic carriage positive control is missing"
            exit 1
        }
        local diagnostic_symbols
        diagnostic_symbols=$(xcrun nm -j "$iic0bi_debug_diagnostic_image" \
            | xcrun swift-demangle) || exit $?
        for marker in "${iic0bi_component_symbols[@]}"; do
            [[ "$diagnostic_symbols" == *"$marker"* ]] || {
                print -u2 \
                    "ii-c0b-i Debug diagnostic carriage positive control is missing: $marker"
                exit 1
            }
        done
        iic0bi_debug_machine_drivers=(
            "$scratch/xcode-diagnostic/Build/Products/Debug/StornautInvestigationMachineDriver"
            "$scratch/xcode-diagnostic/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationMachineDriver"
        )
        local debug_driver
        for debug_driver in "${iic0bi_debug_machine_drivers[@]}"; do
            [[ -f "$debug_driver" && ! -L "$debug_driver" ]] || {
                print -u2 "ii-c0b-i Debug Machine driver negative control is missing: $debug_driver"
                exit 1
            }
        done

        iic0bi_closed_images=(
            "$scratch/xcode-product/Build/Products/Debug/Stornaut.app"
            "$scratch/xcode-product/Build/Products/Release/Stornaut.app"
            "$scratch/xcode-diagnostic/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"
            "$scratch/xcode-diagnostic/Build/Products/Release/StornautInvestigationMachineDriver"
            "${iic0bi_debug_machine_drivers[@]}"
        )
        local image file kind symbols strings scan_status
        for image in "${iic0bi_closed_images[@]}"; do
            [[ -e "$image" && ! -L "$image" ]] || {
                print -u2 "ii-c0b-i final-image negative control is missing: $image"
                exit 1
            }
            while IFS= read -r -d '' file; do
                kind=$(file "$file" 2>/dev/null) || {
                    print -u2 "ii-c0b-i final-image type scan failed: $file"
                    exit 1
                }
                [[ "$kind" == *'Mach-O'* ]] || continue
                symbols=$(xcrun nm -j "$file" 2>/dev/null \
                    | xcrun swift-demangle 2>/dev/null) || {
                    print -u2 "ii-c0b-i final-image symbol scan failed: $file"
                    exit 1
                }
                strings=$(xcrun strings -a "$file" 2>/dev/null) || {
                    print -u2 "ii-c0b-i final-image string scan failed: $file"
                    exit 1
                }
                for marker in "${iic0bi_component_symbols[@]}"; do
                    if [[ "$symbols" == *"$marker"* \
                        || "$strings" == *"$marker"* ]]
                    then
                        print -u2 \
                            "ii-c0b-i producer leaked into a final image: $file: $marker"
                        exit 1
                    fi
                done
            done < <(find "$image" -type f -print0)
        done
    ) || result_code=$?
    rm -rf "$scratch"
    return $result_code
}

function verify_iic0biia_source_contract() {
    local package_path=$1 ownership_path=$2 verifier_path=$3 source_path
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$package_path"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$ownership_path"
    python3 - "$package_path" "$ownership_path" "$verifier_path" \
        "${ZSH_SCRIPT:A}" <<'PY'
from pathlib import Path
import re
import sys

package_path, ownership_path, verifier_path, canonical_path = map(
    Path, sys.argv[1:]
)
if verifier_path.read_bytes() != canonical_path.read_bytes():
    raise SystemExit("ii-c0b-ii-a component verifier source drifted")
root = canonical_path.parent.parent.resolve()
expected_paths = {
    package_path: root / "Package.swift",
    ownership_path: root / (
        "Sources/StornautInvestigationMachineLaunchSupport/"
        "InvestigationMachineGateOwnership.swift"
    ),
}
for path, expected in expected_paths.items():
    if path.resolve() != expected.resolve():
        raise SystemExit(f"ii-c0b-ii-a source path drifted: {path}")
package = package_path.read_text(encoding="utf-8")
ownership = ownership_path.read_text(encoding="utf-8")
lines = [line.strip() for line in ownership.splitlines() if line.strip()]
if lines[:3] != ["import Darwin", "import Foundation", "#if DEBUG"] \
        or lines[-1] != "#endif" \
        or lines.count("#if DEBUG") != 1 or lines.count("#endif") != 1:
    raise SystemExit("ii-c0b-ii-a source DEBUG boundary drifted")
imports = set(re.findall(
    r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", ownership
))
if imports != {"Darwin", "Foundation"}:
    raise SystemExit("ii-c0b-ii-a source import surface drifted")
target = re.findall(
    r'(?ms)\.target\(\s*name:\s*'
    r'"StornautInvestigationMachineLaunchSupport"\s*,\s*'
    r'dependencies:\s*\[(?P<dependencies>.*?)\]\s*\)',
    package,
)
if len(target) != 1 or re.findall(r'"([^"]+)"', target[0]) != [
    "StornautInvestigationHandoffContract"
]:
    raise SystemExit("ii-c0b-ii-a target dependency surface drifted")
products_prefix = package.split("    targets: [", 1)[0]
if "StornautInvestigationMachineLaunchSupport" in products_prefix:
    raise SystemExit("ii-c0b-ii-a target became a package product")
project_path = root / "Stornaut.xcodeproj/project.pbxproj"
if not project_path.is_file():
    raise SystemExit("ii-c0b-ii-a Xcode project boundary unavailable")
if "StornautInvestigationMachineLaunchSupport" in project_path.read_text(
    encoding="utf-8"
):
    raise SystemExit("ii-c0b-ii-a target gained Xcode membership")
if re.search(
    r"(?m)^\s*(?:public|open|package).*\b(?:URL|path|fileDescriptor|"
    r"descriptor|Int32)\b", ownership
):
    raise SystemExit("ii-c0b-ii-a path or descriptor exposure drifted")
if re.search(r"(?m)^\s*(?:public|open|package)\s+", ownership) \
        or re.search(r"\b(?:Codable|Encodable|Decodable)\b", ownership):
    raise SystemExit("ii-c0b-ii-a package-only or Codable surface drifted")
for forbidden in (
    r"import\s+Stornaut(?:Core|Codex|Lifecycle|Execution|ProcessSupport|"
    r"InvestigationRuntime|InvestigationDiagnostic|ProbeBridge)",
    r"\b(?:NSXPCConnection|URLSession|NWConnection|Process|FileManager|"
    r"FileHandle|CommandLine|UserDefaults)\b",
    r"\b(?:posix_spawnp?|fork|execv|execve|system|popen|"
    r"AuthorizationCreate)\s*\(",
    r"\b(?:socket|socketpair|connect|bind|listen|accept|send|recv)\s*\(",
    r"\b(?:unlink|unlinkat|rename|renameat|renameatx_np|rmdir|"
    r"removeItem|replaceItem|moveItem)\s*\(",
    r"\b(?:dup|dup2|dup3|F_DUPFD|F_DUPFD_CLOEXEC)\b",
    r"\b(?:PID|pidFile|mtime|modificationDate|processName)\b",
    r"kill\s*\([^,]+,\s*0\s*\)",
    r"\b(?:sudo|setuid|seteuid|setgid|setegid|readiness|signedRuntimeReady|containment|"
    r"ActionExecutor|TrashMoving|RegisteredAction)\b",
):
    if re.search(forbidden, ownership, re.I):
        raise SystemExit(
            "ii-c0b-ii-a source gained prohibited authority or heuristic"
        )
compact = re.sub(r"\s+", "", ownership)
flag_shapes = {
    "directoryFlags": "directoryFlags=Int32(O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW_ANY)",
    "relativeDirectoryFlags": "relativeDirectoryFlags=Int32(directoryFlags|O_RESOLVE_BENEATH)",
    "lockFlags": "lockFlags=Int32(O_RDWR|O_CLOEXEC|O_NONBLOCK|O_NOFOLLOW_ANY|O_RESOLVE_BENEATH|O_UNIQUE)",
    "directoryNamedFlags": "directoryNamedFlags=Int32(AT_SYMLINK_NOFOLLOW_ANY|AT_RESOLVE_BENEATH|AT_UNIQUE)",
    "lockNamedFlags": "lockNamedFlags=Int32(directoryNamedFlags|AT_UNIQUE)",
}
for label, shape in flag_shapes.items():
    if compact.count(shape) != 1:
        raise SystemExit(f"ii-c0b-ii-a source flag shape drifted: {label}")
for token, count in {"O_NOFOLLOW_ANY": 2, "O_RESOLVE_BENEATH": 2,
                     "O_UNIQUE": 1, "AT_UNIQUE": 2}.items():
    if compact.count(token) != count:
        raise SystemExit(f"ii-c0b-ii-a source flag count drifted: {token}")
for marker in (
    "getpwuid_r(", "getuid()", "geteuid()", "getgid()",
    "getegid()", "fcntl(descriptor,F_GETFD)",
    "fcntl(descriptor,F_GETFL)",
    "flock(descriptor,LOCK_EX|LOCK_NB)",
    "descriptorFlags&FD_CLOEXEC==FD_CLOEXEC",
    "statusFlags&O_NONBLOCK==O_NONBLOCK",
    "statusFlags&O_ACCMODE==accessMode",
    "flags:Self.lockFlags|O_CREAT|O_EXCL",
    "flags:Self.lockFlags,mode:nil,accessMode:O_RDWR",
    "acl_get_fd_np(descriptor,ACL_TYPE_EXTENDED)",
    "flistxattr(descriptor,nil,0,0)",
):
    if marker not in compact:
        raise SystemExit(f"ii-c0b-ii-a source semantic marker drifted: {marker}")
for marker in (
    "iic0biia_component_symbols=(",
    "iic0biia_swiftpm_debug_objects=(",
    "iic0biia_swiftpm_release_objects=(",
    "iic0biia_closed_images=(",
    "ii-c0b-ii-a Debug SwiftPM object positive control is missing",
    "ii-c0b-ii-a source leaked into Release SwiftPM object",
    "ii-c0b-ii-a source leaked into a closed image",
    "verify_iic0biia_component_boundary",
):
    if marker not in verifier_path.read_text(encoding="utf-8"):
        raise SystemExit(
            f"ii-c0b-ii-a component boundary drifted: {marker}"
        )
PY
    scripts/verify-investigation-boundaries --iic0b-ii-a-ownership-contract-only \
        "$package_path" "$ownership_path" Tests/StornautInvestigationTests/InvestigationMachineGateOwnershipTests.swift Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
}

function verify_iic0biia_component_boundary() {
    (( $# == 0 || $# == 2 )) || return 64
    local scratch result_code=0
    scratch=$(mktemp -d \
        "${TMPDIR:-/tmp}/stornaut-iic0biia-component.XXXXXX")
    (
        trap 'rm -rf "$scratch"' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        swift build --scratch-path "$scratch/swiftpm-debug" \
            --configuration debug \
            --target StornautInvestigationMachineLaunchSupport || exit $?
        swift build --scratch-path "$scratch/swiftpm-release" \
            --configuration release \
            --target StornautInvestigationMachineLaunchSupport || exit $?

        iic0biia_swiftpm_debug_objects=(
            ${(f)"$(find "$scratch/swiftpm-debug" -type f \
                -name 'InvestigationMachineGateOwnership.swift.o' -print)"}
        )
        iic0biia_swiftpm_release_objects=(
            ${(f)"$(find "$scratch/swiftpm-release" -type f \
                -name 'InvestigationMachineGateOwnership.swift.o' -print)"}
        )
        (( ${#iic0biia_swiftpm_debug_objects} == 1 )) || {
            print -u2 \
                "ii-c0b-ii-a Debug SwiftPM object positive control is missing"
            exit 1
        }
        (( ${#iic0biia_swiftpm_release_objects} == 1 )) || {
            print -u2 "ii-c0b-ii-a Release SwiftPM object negative control is missing"
            exit 1
        }
        local debug_symbols release_symbols= debug_strings release_strings= marker object
        debug_symbols=$(xcrun nm -j "$iic0biia_swiftpm_debug_objects[1]" | xcrun swift-demangle) || exit $?
        debug_strings=$(xcrun strings -a "$iic0biia_swiftpm_debug_objects[1]") || exit $?
        for object in "${iic0biia_swiftpm_release_objects[@]}"; do
            release_symbols+="$(xcrun nm -j "$object" | xcrun swift-demangle)" || exit $?
            release_strings+="$(xcrun strings -a "$object")" || exit $?
        done
        for marker in '.owner-lock-v1' 'com.eriklee.stornaut.task39-machine-gate'; do
            [[ "$debug_strings" == *"$marker"* && "$release_strings" != *"$marker"* ]] || {
                print -u2 "ii-c0b-ii-a fixed ownership string boundary drifted: $marker"; exit 1
            }
        done
        iic0biia_component_symbols=(
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnershipAcquirer'
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnership'
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnershipSystem'
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnershipMutex'
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnership.release()'
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnership.withExclusiveOwnership'
        )
        for marker in "${iic0biia_component_symbols[@]}"; do
            [[ "$debug_symbols" == *"$marker"* ]] || {
                print -u2 \
                    "ii-c0b-ii-a Debug SwiftPM object positive control is missing: $marker"
                exit 1
            }
            [[ "$release_symbols" != *"$marker"* ]] || {
                print -u2 \
                    "ii-c0b-ii-a source leaked into Release SwiftPM object: $marker"
                exit 1
            }
        done

        swift build --scratch-path "$scratch/machine-debug" \
            --configuration debug --target StornautInvestigationMachine \
            || exit $?
        swift build --scratch-path "$scratch/machine-release" \
            --configuration release --target StornautInvestigationMachine \
            || exit $?
        if (( $# == 2 )); then
            [[ -d $1 && -d $2 ]] || exit 1
            ln -s "$1" "$scratch/xcode-product"; ln -s "$2" "$scratch/xcode-diagnostic"
        else
        xcodebuild -quiet -project Stornaut.xcodeproj -scheme Stornaut \
            -configuration Debug -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$scratch/xcode-product" build || exit $?
        xcodebuild -quiet -project Stornaut.xcodeproj -scheme Stornaut \
            -configuration Release -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$scratch/xcode-product" build || exit $?
        xcodebuild -quiet -project Stornaut.xcodeproj \
            -scheme StornautInvestigationDiagnosticApp -configuration Debug \
            -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$scratch/xcode-diagnostic" build || exit $?
        xcodebuild -quiet -project Stornaut.xcodeproj \
            -scheme StornautInvestigationDiagnosticReleaseShell \
            -configuration Release -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$scratch/xcode-diagnostic" build || exit $?
        xcodebuild -quiet -project Stornaut.xcodeproj \
            -scheme StornautInvestigationMachineDriverNative \
            -configuration Release -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$scratch/xcode-diagnostic" build || exit $?
        fi
        local -a machine_objects
        for image in "$scratch/machine-debug" "$scratch/machine-release"; do
            machine_objects=("$image"/**/StornautInvestigationMachine.build/*.swift.o(N))
            (( ${#machine_objects} == 7 )) || {
                print -u2 "ii-c0b-ii-a Machine object negative control is incomplete: $image"; exit 1
            }
        done
        iic0biia_closed_images=(
            "$scratch/machine-debug" "$scratch/machine-release"
            "$scratch/xcode-product/Build/Products/Debug/Stornaut.app"
            "$scratch/xcode-product/Build/Products/Release/Stornaut.app"
            "$scratch/xcode-diagnostic/Build/Products/Debug/StornautInvestigationDiagnostic.app"
            "$scratch/xcode-diagnostic/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"
            "$scratch/xcode-diagnostic/Build/Products/Release/StornautInvestigationMachineDriver"
        )
        iic0biia_required_executables=(
            "$scratch/xcode-product/Build/Products/Debug/Stornaut.app/Contents/MacOS/Stornaut"
            "$scratch/xcode-product/Build/Products/Debug/Stornaut.app/Contents/MacOS/StornautLifecycleHelper"
            "$scratch/xcode-product/Build/Products/Release/Stornaut.app/Contents/MacOS/Stornaut"
            "$scratch/xcode-product/Build/Products/Release/Stornaut.app/Contents/MacOS/StornautLifecycleHelper"
            "$scratch/xcode-diagnostic/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationDiagnostic"
            "$scratch/xcode-diagnostic/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautLifecycleHelper"
            "$scratch/xcode-diagnostic/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationMachineDriver"
            "$scratch/xcode-diagnostic/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app/Contents/MacOS/StornautInvestigationDiagnosticReleaseShell"
            "$scratch/xcode-diagnostic/Build/Products/Release/StornautInvestigationMachineDriver"
        )
        for image in "${iic0biia_required_executables[@]}"; do
            [[ -f "$image" && ! -L "$image" ]] || {
                print -u2 "ii-c0b-ii-a required executable negative control is missing: $image"; exit 1
            }
        done
        local image file kind symbols strings inventory="$scratch/closed-image-files"
        for image in "${iic0biia_closed_images[@]}"; do
            [[ -e "$image" && ! -L "$image" ]] || {
                print -u2 "ii-c0b-ii-a closed-image negative control is missing: $image"
                exit 1
            }
            find "$image" -type f -print0 >"$inventory" || {
                print -u2 "ii-c0b-ii-a closed-image enumeration failed: $image"; exit 1
            }
            while IFS= read -r -d '' file; do
                kind=$(file "$file" 2>/dev/null) || {
                    print -u2 "ii-c0b-ii-a closed-image type scan failed: $file"
                    exit 1
                }
                [[ "$kind" == *'Mach-O'* ]] || continue
                symbols=$(xcrun nm -j "$file" 2>/dev/null \
                    | xcrun swift-demangle 2>/dev/null) || {
                    print -u2 "ii-c0b-ii-a closed-image symbol scan failed: $file"
                    exit 1
                }
                strings=$(xcrun strings -a "$file" 2>/dev/null) || {
                    print -u2 "ii-c0b-ii-a closed-image string scan failed: $file"
                    exit 1
                }
                for marker in "${iic0biia_component_symbols[@]}"; do
                    if [[ "$symbols" == *"$marker"* \
                        || "$strings" == *"$marker"* ]]
                    then
                        print -u2 \
                            "ii-c0b-ii-a source leaked into a closed image: $file: $marker"
                        exit 1
                    fi
                done
                [[ "$strings" != *'.owner-lock-v1'* \
                    && "$strings" != *'com.eriklee.stornaut.task39-machine-gate'* ]] || {
                    print -u2 "ii-c0b-ii-a fixed ownership string leaked into a closed image: $file"; exit 1
                }
            done <"$inventory"
        done
    ) || result_code=$?
    rm -rf "$scratch"
    return $result_code
}

function verify_iic0biia3_source_contract() {
    local package_path=$1 ownership_path=$2 verifier_path=$3
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$package_path"
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$ownership_path"
    scripts/verify-investigation-boundaries \
        --iic0b-ii-a3-retained-base-contract-only \
        "$ownership_path" \
        Tests/StornautInvestigationTests/InvestigationMachineGateOwnershipTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
    python3 - "$package_path" "$ownership_path" "$verifier_path" \
        "${ZSH_SCRIPT:A}" <<'PY'
from pathlib import Path
import re
import sys

package_path, ownership_path, verifier_path, canonical_path = map(
    Path, sys.argv[1:]
)
if verifier_path.read_bytes() != canonical_path.read_bytes():
    raise SystemExit(
        "ii-c0b-ii-a3 component verifier source drifted"
    )
root = canonical_path.parent.parent.resolve()
expected_paths = {
    package_path: root / "Package.swift",
    ownership_path: root / (
        "Sources/StornautInvestigationMachineLaunchSupport/"
        "InvestigationMachineGateOwnership.swift"
    ),
}
for path, expected in expected_paths.items():
    if path.resolve() != expected.resolve():
        raise SystemExit(
            f"ii-c0b-ii-a3 source path drifted: {path}"
        )
package = package_path.read_text(encoding="utf-8")
ownership = ownership_path.read_text(encoding="utf-8")
lines = [line.strip() for line in ownership.splitlines() if line.strip()]
if __import__("hashlib").sha256(ownership_path.read_bytes()).hexdigest() != \
        "3e8c1a586e692e705c14399acfcb637f1565da497a8e4b8cfdc2dfe7f3dd146a":
    raise SystemExit("ii-c0b-ii-a3 source seal drifted")
print("ii-c0b-ii-a3 source seal admitted")

if lines[:3] != ["import Darwin", "import Foundation", "#if DEBUG"] \
        or lines[-1] != "#endif" \
        or lines.count("#if DEBUG") != 1 \
        or lines.count("#endif") != 1:
    raise SystemExit(
        "ii-c0b-ii-a3 source DEBUG boundary drifted"
    )
imports = set(re.findall(
    r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", ownership
))
if imports != {"Darwin", "Foundation"}:
    raise SystemExit(
        "ii-c0b-ii-a3 source import surface drifted"
    )
target = re.findall(
    r'(?ms)\.target\(\s*name:\s*'
    r'"StornautInvestigationMachineLaunchSupport"\s*,\s*'
    r'dependencies:\s*\[(?P<dependencies>.*?)\]\s*\)',
    package,
)
if len(target) != 1 or re.findall(r'"([^"]+)"', target[0]) != [
    "StornautInvestigationHandoffContract"
]:
    raise SystemExit(
        "ii-c0b-ii-a3 target dependency surface drifted"
    )
products_prefix = package.split("    targets: [", 1)[0]
if "StornautInvestigationMachineLaunchSupport" in products_prefix:
    raise SystemExit(
        "ii-c0b-ii-a3 target became a package product"
    )
project_path = root / "Stornaut.xcodeproj/project.pbxproj"
if not project_path.is_file():
    raise SystemExit(
        "ii-c0b-ii-a3 Xcode project boundary unavailable"
    )
if "StornautInvestigationMachineLaunchSupport" in project_path.read_text(
    encoding="utf-8"
):
    raise SystemExit(
        "ii-c0b-ii-a3 target gained Xcode membership"
    )
source_root = root / (
    "Sources/StornautInvestigationMachineLaunchSupport"
)
observed_sources = sorted(
    str(path.relative_to(source_root))
    for path in source_root.rglob("*.swift")
)
if observed_sources != ["InvestigationMachineGateOwnership.swift"]:
    raise SystemExit(
        "ii-c0b-ii-a3 target source inventory drifted"
    )
if re.search(r"(?m)^\s*(?:public|open)\s+", ownership) \
        or re.search(r"\b(?:Codable|Encodable|Decodable)\b", ownership):
    raise SystemExit(
        "ii-c0b-ii-a3 package-only or Codable surface drifted"
    )
if re.search(
    r"(?m)^\s*(?:public|open|package).*\b(?:URL|path|fileDescriptor|"
    r"descriptor|Int32)\b", ownership
):
    raise SystemExit(
        "ii-c0b-ii-a3 raw capability surface drifted"
    )
for forbidden in (
    r"import\s+Stornaut(?:Core|Codex|Lifecycle|Execution|ProcessSupport|"
    r"InvestigationRuntime|InvestigationDiagnostic|ProbeBridge)",
    r"\b(?:NSXPCConnection|URLSession|NWConnection|Process|FileManager|"
    r"FileHandle|CommandLine|UserDefaults)\b",
    r"\b(?:posix_spawnp?|fork|execv|execve|system|popen|"
    r"AuthorizationCreate)\s*\(",
    r"\b(?:socket|socketpair|connect|bind|listen|accept|send|recv)\s*\(",
    r"\b(?:unlink|unlinkat|rename|renameat|renameatx_np|rmdir|"
    r"removeItem|replaceItem|moveItem)\s*\(",
    r"\b(?:dup|dup2|dup3|F_DUPFD|F_DUPFD_CLOEXEC)\b",
    r"\b(?:opendir|fdopendir|readdir|write|writev|pwrite)\s*\(",
    r"\b(?:PID|pidFile|mtime|modificationDate|processName)\b",
    r"kill\s*\([^,]+,\s*0\s*\)",
    r"\b(?:sudo|setuid|seteuid|setgid|setegid|readiness|"
    r"signedRuntimeReady|containment|ActionExecutor|TrashMoving|"
    r"RegisteredAction)\b",
    r"\b(?:capsule|attempt-[A-Za-z]|recovery|retry)\b",
):
    if re.search(forbidden, ownership, re.I):
        raise SystemExit(
            "ii-c0b-ii-a3 source gained prohibited authority or mutation"
        )
compact = re.sub(r"\s+", "", ownership)
for marker in (
    "ledger.transfer(base)",
    "ledger.transfer(lock)",
    "revalidateOwnership",
    "baseDescriptor",
    "lockDescriptor",
    "baseRelativePath",
    "revalidateOwnedBaseAndLock(baseDescriptor:active.baseDescriptor,"
        "lockDescriptor:active.lockDescriptor,"
        "baseRelativePath:active.baseRelativePath)",
    "closeRemainingDescriptorsBaseFirst()",
):
    if marker not in compact:
        raise SystemExit(
            f"ii-c0b-ii-a3 retained-base semantic marker drifted: {marker}"
        )
if re.search(
    r"\b(?:InvestigationMachineGateOwnedBase|withUnsafeDescriptor|"
    r"withOwnedBase|withExclusiveOwnership)\b",
    ownership,
):
    raise SystemExit(
        "ii-c0b-ii-a3 raw descriptor capability resurfaced"
    )
extension_lines = [
    line.strip()
    for line in ownership.splitlines()
    if re.search(r"\bextension\b", line)
    and not line.lstrip().startswith("//")
]
if extension_lines != [
    "extension NSLock: InvestigationMachineGateOwnershipMutex {}"
]:
    raise SystemExit("ii-c0b-ii-a3 extension surface drifted")
for marker in (
    "iic0biia3_component_symbols=(",
    "iic0biia3_swiftpm_debug_objects=(",
    "iic0biia3_swiftpm_release_objects=(",
    "iic0biia3_closed_images=(",
    "ii-c0b-ii-a3 Debug SwiftPM object positive control is missing",
    "ii-c0b-ii-a3 source leaked into Release SwiftPM object",
    "ii-c0b-ii-a3 source leaked into a closed image",
    "verify_iic0biia3_component_boundary",
):
    if marker not in verifier_path.read_text(encoding="utf-8"):
        raise SystemExit(
            f"ii-c0b-ii-a3 component boundary drifted: {marker}"
        )
PY
}

function verify_iic0biia3_component_boundary() {
    (( $# == 0 || $# == 2 )) || return 64
    local scratch result_code=0
    scratch=$(mktemp -d \
        "${TMPDIR:-/tmp}/stornaut-iic0biia3-component.XXXXXX")
    (
        trap 'rm -rf "$scratch"' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        swift build --scratch-path "$scratch/swiftpm-debug" \
            --configuration debug \
            --target StornautInvestigationMachineLaunchSupport || exit $?
        swift build --scratch-path "$scratch/swiftpm-release" \
            --configuration release \
            --target StornautInvestigationMachineLaunchSupport || exit $?

        local -a iic0biia3_swiftpm_debug_objects
        local -a iic0biia3_swiftpm_release_objects
        iic0biia3_swiftpm_debug_objects=(
            ${(f)"$(find "$scratch/swiftpm-debug" -type f \
                -name 'InvestigationMachineGateOwnership.swift.o' -print)"}
        )
        iic0biia3_swiftpm_release_objects=(
            ${(f)"$(find "$scratch/swiftpm-release" -type f \
                -name 'InvestigationMachineGateOwnership.swift.o' -print)"}
        )
        (( ${#iic0biia3_swiftpm_debug_objects} == 1 )) || {
            print -u2 \
                "ii-c0b-ii-a3 Debug SwiftPM object positive control is missing"
            exit 1
        }
        (( ${#iic0biia3_swiftpm_release_objects} == 1 )) || {
            print -u2 \
                "ii-c0b-ii-a3 Release SwiftPM object negative control is missing"
            exit 1
        }
        local debug_symbols release_symbols= debug_strings release_strings=
        local marker object image file kind symbols strings
        debug_symbols=$(xcrun nm -j \
            "$iic0biia3_swiftpm_debug_objects[1]" \
            | xcrun swift-demangle) || exit $?
        debug_strings=$(xcrun strings -a \
            "$iic0biia3_swiftpm_debug_objects[1]") || exit $?
        for object in "${iic0biia3_swiftpm_release_objects[@]}"; do
            release_symbols+="$(xcrun nm -j "$object" \
                | xcrun swift-demangle)" || exit $?
            release_strings+="$(xcrun strings -a "$object")" || exit $?
        done
        for marker in \
            '.owner-lock-v1' \
            'com.eriklee.stornaut.task39-machine-gate'
        do
            [[ "$debug_strings" == *"$marker"* \
                && "$release_strings" != *"$marker"* ]] || {
                print -u2 \
                    "ii-c0b-ii-a3 fixed ownership string boundary drifted: $marker"
                exit 1
            }
        done
        local -a iic0biia3_component_symbols
        iic0biia3_component_symbols=(
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnershipAcquirer'
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnership'
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnershipSystem'
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnershipMutex'
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnership.release()'
            'StornautInvestigationMachineLaunchSupport.InvestigationMachineGateOwnership.revalidateOwnership()'
        )
        for marker in "${iic0biia3_component_symbols[@]}"; do
            [[ "$debug_symbols" == *"$marker"* ]] || {
                print -u2 \
                    "ii-c0b-ii-a3 Debug SwiftPM object positive control is missing: $marker"
                exit 1
            }
            [[ "$release_symbols" != *"$marker"* ]] || {
                print -u2 \
                    "ii-c0b-ii-a3 source leaked into Release SwiftPM object: $marker"
                exit 1
            }
        done

        swift build --scratch-path "$scratch/machine-debug" \
            --configuration debug --target StornautInvestigationMachine \
            || exit $?
        swift build --scratch-path "$scratch/machine-release" \
            --configuration release --target StornautInvestigationMachine \
            || exit $?
        local -a machine_objects
        for image in "$scratch/machine-debug" "$scratch/machine-release"; do
            machine_objects=("$image"/**/StornautInvestigationMachine.build/*.swift.o(N))
            (( ${#machine_objects} == 7 )) || {
                print -u2 \
                    "ii-c0b-ii-a3 Machine object negative control is incomplete: $image"
                exit 1
            }
            for object in "${machine_objects[@]}"; do
                symbols=$(xcrun nm -j "$object" \
                    | xcrun swift-demangle) || exit $?
                strings=$(xcrun strings -a "$object") || exit $?
                for marker in "${iic0biia3_component_symbols[@]}"; do
                    [[ "$symbols" != *"$marker"* \
                        && "$strings" != *"$marker"* ]] || {
                        print -u2 \
                            "ii-c0b-ii-a3 source leaked into Machine object: $object: $marker"
                        exit 1
                    }
                done
            done
        done

        local product_derived_data diagnostic_derived_data
        if (( $# == 2 )); then
            [[ -d $1 && -d $2 ]] || {
                print -u2 \
                    "ii-c0b-ii-a3 existing DerivedData boundary unavailable"
                exit 1
            }
            product_derived_data=$1
            diagnostic_derived_data=$2
        else
            product_derived_data="$scratch/xcode-product"
            diagnostic_derived_data="$scratch/xcode-diagnostic"
            xcodebuild -quiet -project Stornaut.xcodeproj -scheme Stornaut \
                -configuration Debug -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$product_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj -scheme Stornaut \
                -configuration Release -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$product_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationDiagnosticApp \
                -configuration Debug -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationDiagnosticReleaseShell \
                -configuration Release -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationMachineDriverNative \
                -configuration Release -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
        fi
        local -a iic0biia3_closed_images
        local -a iic0biia3_required_executables
        iic0biia3_closed_images=(
                "$product_derived_data/Build/Products/Debug/Stornaut.app"
                "$product_derived_data/Build/Products/Release/Stornaut.app"
                "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app"
                "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"
                "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationMachineDriver"
        )
        iic0biia3_required_executables=(
                "$product_derived_data/Build/Products/Debug/Stornaut.app/Contents/MacOS/Stornaut"
                "$product_derived_data/Build/Products/Debug/Stornaut.app/Contents/MacOS/StornautLifecycleHelper"
                "$product_derived_data/Build/Products/Release/Stornaut.app/Contents/MacOS/Stornaut"
                "$product_derived_data/Build/Products/Release/Stornaut.app/Contents/MacOS/StornautLifecycleHelper"
                "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationDiagnostic"
                "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautLifecycleHelper"
                "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationMachineDriver"
                "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app/Contents/MacOS/StornautInvestigationDiagnosticReleaseShell"
                "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationMachineDriver"
        )
        for image in "${iic0biia3_required_executables[@]}"; do
                [[ -f "$image" && ! -L "$image" ]] || {
                    print -u2 \
                        "ii-c0b-ii-a3 required executable negative control is missing: $image"
                    exit 1
                }
        done
        local inventory="$scratch/closed-image-files"
        for image in "${iic0biia3_closed_images[@]}"; do
                [[ -e "$image" && ! -L "$image" ]] || {
                    print -u2 \
                        "ii-c0b-ii-a3 closed-image negative control is missing: $image"
                    exit 1
                }
                find "$image" -type f -print0 >"$inventory" || {
                    print -u2 \
                        "ii-c0b-ii-a3 closed-image enumeration failed: $image"
                    exit 1
                }
                while IFS= read -r -d '' file; do
                    kind=$(file "$file" 2>/dev/null) || {
                        print -u2 \
                            "ii-c0b-ii-a3 closed-image type scan failed: $file"
                        exit 1
                    }
                    [[ "$kind" == *'Mach-O'* ]] || continue
                    symbols=$(xcrun nm -j "$file" 2>/dev/null \
                        | xcrun swift-demangle 2>/dev/null) || {
                        print -u2 \
                            "ii-c0b-ii-a3 closed-image symbol scan failed: $file"
                        exit 1
                    }
                    strings=$(xcrun strings -a "$file" 2>/dev/null) || {
                        print -u2 \
                            "ii-c0b-ii-a3 closed-image string scan failed: $file"
                        exit 1
                    }
                    for marker in "${iic0biia3_component_symbols[@]}"; do
                        [[ "$symbols" != *"$marker"* \
                            && "$strings" != *"$marker"* ]] || {
                            print -u2 \
                                "ii-c0b-ii-a3 source leaked into a closed image: $file: $marker"
                            exit 1
                        }
                    done
                    [[ "$strings" != *'.owner-lock-v1'* \
                        && "$strings" != *'com.eriklee.stornaut.task39-machine-gate'* ]] || {
                        print -u2 \
                            "ii-c0b-ii-a3 fixed ownership string leaked into a closed image: $file"
                        exit 1
                    }
                done <"$inventory"
        done
        # Reuse the exact artifacts built by the enclosing a3 component gate.
        verify_iic0biib_component_boundary \
            "$product_derived_data" "$diagnostic_derived_data" \
            "$scratch/swiftpm-debug" "$scratch/swiftpm-release" \
            "$scratch/machine-debug" "$scratch/machine-release"
    ) || result_code=$?
    rm -rf "$scratch"
    return $result_code
}

function verify_iic0biib_source_contract() {
    local package_path=$1 ownership_path=$2 capsule_path=$3 verifier_path=$4
    xcrun swiftc -frontend -parse -enable-bare-slash-regex \
        "$package_path" || return $?
    xcrun swiftc -frontend -parse -enable-bare-slash-regex \
        "$ownership_path" || return $?
    xcrun swiftc -frontend -parse -enable-bare-slash-regex \
        "$capsule_path" || return $?
    scripts/verify-investigation-boundaries \
        --iic0b-ii-b-capsule-contract-only \
        "$package_path" "$ownership_path" "$capsule_path" \
        Tests/StornautInvestigationTests/InvestigationOwnerOnlyCapsuleTests.swift \
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift \
        || return $?
    python3 - "$package_path" "$ownership_path" "$capsule_path" \
        "$verifier_path" "${ZSH_SCRIPT:A}" <<'PY'
from pathlib import Path
import re
import sys

package_path, ownership_path, capsule_path, verifier_path, canonical_path = map(
    Path, sys.argv[1:]
)
if verifier_path.read_bytes() != canonical_path.read_bytes():
    raise SystemExit("ii-c0b-ii-b component verifier source drifted")
root = canonical_path.parent.parent.resolve()
expected = {
    package_path: root / "Package.swift",
    ownership_path: root / (
        "Sources/StornautInvestigationMachineLaunchSupport/"
        "InvestigationMachineGateOwnership.swift"
    ),
    capsule_path: root / (
        "Sources/StornautInvestigationMachineLaunchSupport/"
        "InvestigationOwnerOnlyCapsule.swift"
    ),
}
for path, canonical in expected.items():
    if path.resolve() != canonical.resolve():
        raise SystemExit(f"ii-c0b-ii-b source path drifted: {path}")
package = package_path.read_text(encoding="utf-8")
ownership = ownership_path.read_text(encoding="utf-8")
capsule = capsule_path.read_text(encoding="utf-8")
for label, source, expected_prefix in (
    ("ownership", ownership, ["import Darwin", "import Foundation", "#if DEBUG"]),
    ("capsule", capsule, [
        "import Darwin", "import Foundation",
        "import StornautInvestigationHandoffContract", "#if DEBUG",
    ]),
):
    lines = [line.strip() for line in source.splitlines() if line.strip()]
    if lines[:len(expected_prefix)] != expected_prefix \
            or lines[-1] != "#endif" \
            or lines.count("#if DEBUG") != 1 \
            or lines.count("#endif") != 1 \
            or any(line.startswith(("#else", "#elseif")) for line in lines):
        raise SystemExit(f"ii-c0b-ii-b source DEBUG boundary drifted: {label}")
target = re.findall(
    r'(?ms)\.target\(\s*name:\s*'
    r'"StornautInvestigationMachineLaunchSupport"\s*,\s*'
    r'dependencies:\s*\[(?P<dependencies>.*?)\]\s*\)', package,
)
if len(target) != 1 or re.findall(r'"([^"]+)"', target[0]) != [
    "StornautInvestigationHandoffContract", "StornautInvestigationMachineGateSupport"
]:
    raise SystemExit("ii-c0b-ii-b target dependency surface drifted")
products = package.split("    targets: [", 1)[0]
if "StornautInvestigationMachineLaunchSupport" in products:
    raise SystemExit("ii-c0b-ii-b target became a package product")
project = root / "Stornaut.xcodeproj/project.pbxproj"
if "StornautInvestigationMachineLaunchSupport" in project.read_text(
    encoding="utf-8"
):
    raise SystemExit("ii-c0b-ii-b target gained Xcode membership")
source_root = root / "Sources/StornautInvestigationMachineLaunchSupport"
observed_sources = sorted(
    str(path.relative_to(source_root)) for path in source_root.rglob("*.swift")
)
if observed_sources != [
    "DarwinInvestigationFixedGateHandoffSystem.swift", "InvestigationFixedGateDarwinLifecycle.swift", "InvestigationFixedGateHandoff.swift",
    "InvestigationMachineGateHandoffReceipt.swift", "InvestigationMachineGateOwnership.swift", "InvestigationOwnerOnlyCapsule.swift",
]:
    raise SystemExit("ii-c0b-ii-b target source inventory drifted")
if re.search(r"(?m)^\s*(?:public|open)\s+", capsule) \
        or re.search(r"\b(?:Codable|Encodable|Decodable)\b", capsule):
    raise SystemExit("ii-c0b-ii-b package-only or Codable surface drifted")
for marker in (
    "iic0biib_component_symbols=(",
    "iic0biib_swiftpm_debug_objects=(",
    "iic0biib_swiftpm_release_objects=(",
    "iic0biib_closed_images=(",
    "iic0biib_required_executables=(",
    "verify_iic0biib_component_boundary",
):
    if marker not in verifier_path.read_text(encoding="utf-8"):
        raise SystemExit(f"ii-c0b-ii-b component boundary drifted: {marker}")
PY
}

function verify_iic0biib_component_boundary() {
    (( $# == 0 || $# == 6 )) || return 64
    local scratch result_code=0
    scratch=$(mktemp -d \
        "${TMPDIR:-/tmp}/stornaut-iic0biib-component.XXXXXX")
    (
        trap 'rm -rf "$scratch"' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        local product_derived_data diagnostic_derived_data
        local swiftpm_debug swiftpm_release machine_debug machine_release
        if (( $# == 6 )); then
            product_derived_data=$1; diagnostic_derived_data=$2
            swiftpm_debug=$3; swiftpm_release=$4
            machine_debug=$5; machine_release=$6
            [[ -d $product_derived_data && -d $diagnostic_derived_data \
                && -d $swiftpm_debug && -d $swiftpm_release \
                && -d $machine_debug && -d $machine_release ]] || {
                print -u2 "ii-c0b-ii-b existing component roots unavailable"
                exit 1
            }
        else
            product_derived_data="$scratch/xcode-product"
            diagnostic_derived_data="$scratch/xcode-diagnostic"
            swiftpm_debug="$scratch/swiftpm-debug"
            swiftpm_release="$scratch/swiftpm-release"
            machine_debug="$scratch/machine-debug"
            machine_release="$scratch/machine-release"
            swift build --scratch-path "$swiftpm_debug" \
                --configuration debug \
                --target StornautInvestigationMachineLaunchSupport || exit $?
            swift build --scratch-path "$swiftpm_release" \
                --configuration release \
                --target StornautInvestigationMachineLaunchSupport || exit $?
            swift build --scratch-path "$machine_debug" \
                --configuration debug --target StornautInvestigationMachine \
                || exit $?
            swift build --scratch-path "$machine_release" \
                --configuration release --target StornautInvestigationMachine \
                || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj -scheme Stornaut \
                -configuration Debug -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$product_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj -scheme Stornaut \
                -configuration Release -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$product_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationDiagnosticApp \
                -configuration Debug -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationDiagnosticReleaseShell \
                -configuration Release -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationMachineDriverNative \
                -configuration Release -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
        fi

        local -a iic0biib_swiftpm_debug_objects
        local -a iic0biib_swiftpm_release_objects
        iic0biib_swiftpm_debug_objects=(
            ${(f)"$(find "$swiftpm_debug" -type f \
                -name 'InvestigationOwnerOnlyCapsule.swift.o' -print)"}
        )
        iic0biib_swiftpm_release_objects=(
            ${(f)"$(find "$swiftpm_release" -type f \
                -name 'InvestigationOwnerOnlyCapsule.swift.o' -print)"}
        )
        (( ${#iic0biib_swiftpm_debug_objects} == 1 )) || {
            print -u2 "ii-c0b-ii-b Debug SwiftPM object positive control is missing"
            exit 1
        }
        (( ${#iic0biib_swiftpm_release_objects} == 1 )) || {
            print -u2 "ii-c0b-ii-b Release SwiftPM object negative control is missing"
            exit 1
        }
        local debug_symbols debug_strings release_symbols= release_strings=
        local object marker image file kind symbols strings
        local iic0biib_module_namespace='StornautInvestigationMachineLaunchSupport.'
        debug_symbols=$(xcrun nm -j "$iic0biib_swiftpm_debug_objects[1]" \
            | xcrun swift-demangle) || exit $?
        debug_strings=$(xcrun strings -a \
            "$iic0biib_swiftpm_debug_objects[1]") || exit $?
        for object in "${iic0biib_swiftpm_release_objects[@]}"; do
            release_symbols+="$(xcrun nm -j "$object" \
                | xcrun swift-demangle)" || exit $?
            release_strings+="$(xcrun strings -a "$object")" || exit $?
        done
        local -a iic0biib_component_symbols
        iic0biib_component_symbols=(
            'StornautInvestigationMachineLaunchSupport.InvestigationOwnerOnlyCapsulePublisher'
            'StornautInvestigationMachineLaunchSupport.InvestigationOwnerOnlyCapsuleLease'
            'StornautInvestigationMachineLaunchSupport.InvestigationOwnerOnlyCapsuleExactGateReapedProof'
            'StornautInvestigationMachineLaunchSupport.InvestigationOwnerOnlyCapsuleNeverHandedOffProof'
            'StornautInvestigationMachineLaunchSupport.InvestigationOwnerOnlyCapsuleSettlement'
        )
        for marker in "${iic0biib_component_symbols[@]}"; do
            [[ "$debug_symbols" == *"$marker"* ]] || {
                print -u2 \
                    "ii-c0b-ii-b Debug SwiftPM object positive control is missing: $marker"
                exit 1
            }
            [[ "$release_symbols" != *"$marker"* ]] || {
                print -u2 \
                    "ii-c0b-ii-b source leaked into Release SwiftPM object: $marker"
                exit 1
            }
        done
        [[ "$debug_symbols" == *"$iic0biib_module_namespace"* ]] || {
            print -u2 "ii-c0b-ii-b Debug module namespace positive control is missing"
            exit 1
        }
        [[ "$release_symbols$release_strings" != *"$iic0biib_module_namespace"* ]] || {
            print -u2 "ii-c0b-ii-b module namespace leaked into Release SwiftPM object"
            exit 1
        }
        for marker in capsule.pending projected-cohort-; do
            [[ "$debug_strings" == *"$marker"* \
                && "$release_strings" != *"$marker"* ]] || {
                print -u2 "ii-c0b-ii-b fixed capsule string boundary drifted: $marker"
                exit 1
            }
        done

        local -a machine_objects
        for image in "$machine_debug" "$machine_release"; do
            machine_objects=("$image"/**/StornautInvestigationMachine.build/*.swift.o(N))
            (( ${#machine_objects} == 7 )) || {
                print -u2 \
                    "ii-c0b-ii-b Machine object negative control is incomplete: $image"
                exit 1
            }
            for object in "${machine_objects[@]}"; do
                symbols=$(xcrun nm -j "$object" \
                    | xcrun swift-demangle) || exit $?
                strings=$(xcrun strings -a "$object") || exit $?
                [[ "$symbols$strings" != *"$iic0biib_module_namespace"* ]] || {
                    print -u2 \
                        "ii-c0b-ii-b module namespace leaked into Machine object: $object"
                    exit 1
                }
                for marker in "${iic0biib_component_symbols[@]}"; do
                    [[ "$symbols" != *"$marker"* \
                        && "$strings" != *"$marker"* ]] || {
                        print -u2 \
                            "ii-c0b-ii-b source leaked into Machine object: $object: $marker"
                        exit 1
                    }
                done
            done
        done

        local -a iic0biib_closed_images
        local -a iic0biib_required_executables
        iic0biib_closed_images=(
            "$product_derived_data/Build/Products/Debug/Stornaut.app"
            "$product_derived_data/Build/Products/Release/Stornaut.app"
            "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app"
            "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"
            "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationMachineDriver"
        )
        iic0biib_required_executables=(
            "$product_derived_data/Build/Products/Debug/Stornaut.app/Contents/MacOS/Stornaut"
            "$product_derived_data/Build/Products/Debug/Stornaut.app/Contents/MacOS/StornautLifecycleHelper"
            "$product_derived_data/Build/Products/Release/Stornaut.app/Contents/MacOS/Stornaut"
            "$product_derived_data/Build/Products/Release/Stornaut.app/Contents/MacOS/StornautLifecycleHelper"
            "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationDiagnostic"
            "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautLifecycleHelper"
            "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationMachineDriver"
            "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app/Contents/MacOS/StornautInvestigationDiagnosticReleaseShell"
            "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationMachineDriver"
        )
        for image in "${iic0biib_required_executables[@]}"; do
            [[ -f "$image" && ! -L "$image" ]] || {
                print -u2 \
                    "ii-c0b-ii-b required executable negative control is missing: $image"
                exit 1
            }
        done
        local inventory="$scratch/closed-image-files"
        for image in "${iic0biib_closed_images[@]}"; do
            [[ -e "$image" && ! -L "$image" ]] || {
                print -u2 "ii-c0b-ii-b closed-image negative control is missing: $image"
                exit 1
            }
            find "$image" -type f -print0 >"$inventory" || {
                print -u2 "ii-c0b-ii-b closed-image enumeration failed: $image"
                exit 1
            }
            while IFS= read -r -d '' file; do
                kind=$(file "$file" 2>/dev/null) || {
                    print -u2 "ii-c0b-ii-b closed-image type scan failed: $file"
                    exit 1
                }
                [[ "$kind" == *'Mach-O'* ]] || continue
                symbols=$(xcrun nm -j "$file" 2>/dev/null \
                    | xcrun swift-demangle 2>/dev/null) || {
                    print -u2 "ii-c0b-ii-b closed-image symbol scan failed: $file"
                    exit 1
                }
                strings=$(xcrun strings -a "$file" 2>/dev/null) || {
                    print -u2 "ii-c0b-ii-b closed-image string scan failed: $file"
                    exit 1
                }
                [[ "$symbols$strings" != *"$iic0biib_module_namespace"* ]] || {
                    print -u2 \
                        "ii-c0b-ii-b module namespace leaked into a closed image: $file"
                    exit 1
                }
                for marker in "${iic0biib_component_symbols[@]}"; do
                    [[ "$symbols" != *"$marker"* \
                        && "$strings" != *"$marker"* ]] || {
                        print -u2 \
                            "ii-c0b-ii-b source leaked into a closed image: $file: $marker"
                        exit 1
                    }
                done
            done <"$inventory"
        done
    ) || result_code=$?
    rm -rf "$scratch"
    return $result_code
}

function verify_iic0biii2a_source_contract() {
    local package_path=$1 transport_path=$2 launcher_path=$3 darwin_path=$4
    local entry_path=$5 verifier_path=$6 source_path
    for source_path in "$package_path" "$transport_path" "$launcher_path" \
        "$darwin_path" "$entry_path"
    do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source_path" \
            || return $?
    done
    python3 - "$package_path" "$transport_path" "$launcher_path" \
        "$darwin_path" "$entry_path" "$verifier_path" \
        "${ZSH_SCRIPT:A}" <<'PY'
from pathlib import Path
import re
import sys

package_path, transport_path, launcher_path, darwin_path, entry_path, verifier_path, canonical_path = map(Path, sys.argv[1:])
if verifier_path.read_bytes() != canonical_path.read_bytes():
    raise SystemExit("ii-c0b-iii-2a component verifier source drifted")
root = canonical_path.parent.parent.resolve()
expected_paths = {
    package_path: root / "Package.swift",
    transport_path: root / "Sources/StornautInvestigationMachineGateSupport/InvestigationMachineGateTransport.swift",
    launcher_path: root / "Sources/StornautInvestigationMachineGateSupport/InvestigationMachineFixedGateLauncher.swift",
    darwin_path: root / "Sources/StornautInvestigationMachineGateSupport/DarwinInvestigationMachineFixedGateSystem.swift",
    entry_path: root / "Tools/StornautInvestigationMachineGate/main.swift",
}
for path, expected in expected_paths.items():
    if path.resolve() != expected.resolve():
        raise SystemExit(f"ii-c0b-iii-2a source path drifted: {path}")
package = package_path.read_text(encoding="utf-8")
transport = transport_path.read_text(encoding="utf-8")
launcher = launcher_path.read_text(encoding="utf-8")
darwin = darwin_path.read_text(encoding="utf-8")
entry = entry_path.read_text(encoding="utf-8")

def target(name):
    matches = re.findall(
        rf'(?ms)\.(?:executableT|t)arget\(\s*name:\s*"{re.escape(name)}"\s*,(?P<body>.*?)^\s*\),',
        package,
    )
    if len(matches) != 1:
        raise SystemExit(f"ii-c0b-iii-2a target cardinality drifted: {name}")
    return matches[0]

support = target("StornautInvestigationMachineGateSupport")
gate = target("StornautInvestigationMachineGate")
if re.search(r"\b(?:exclude|sources)\s*:", support):
    raise SystemExit("ii-c0b-iii-2a GateSupport source inventory drifted")
if re.findall(r'"([^"]+)"', re.search(r'(?ms)dependencies:\s*\[(.*?)\]', support).group(1)) != ["StornautInvestigationHandoffContract"]:
    raise SystemExit("ii-c0b-iii-2a GateSupport target dependency surface drifted")
if re.findall(r'"([^"]+)"', re.search(r'(?ms)dependencies:\s*\[(.*?)\]', gate).group(1)) != ["StornautInvestigationMachineGateSupport"]:
    raise SystemExit("ii-c0b-iii-2a Gate target dependency surface drifted")
if 'path: "Tools/StornautInvestigationMachineGate"' not in gate:
    raise SystemExit("ii-c0b-iii-2a Gate target path drifted")
if "StornautInvestigationMachineGateSupport" in package.split("    targets: [", 1)[0]:
    raise SystemExit("ii-c0b-iii-2a GateSupport became an explicit product")
if package.count('"StornautInvestigationMachineGateSupport"') != 3:
    raise SystemExit("ii-c0b-iii-2a GateSupport consumer surface drifted")
project = (root / "Stornaut.xcodeproj/project.pbxproj").read_text(encoding="utf-8")
if "StornautInvestigationMachineGateSupport" in project \
        or "StornautInvestigationMachineGate" in project:
    raise SystemExit("ii-c0b-iii-2a Gate target gained Xcode membership")
source_root = root / "Sources/StornautInvestigationMachineGateSupport"
if sorted(path.name for path in source_root.glob("*.swift")) != [
    "DarwinInvestigationMachineFixedGateSystem.swift",
    "InvestigationMachineFixedGateLauncher.swift",
    "InvestigationMachineGateTransport.swift",
]:
    raise SystemExit("ii-c0b-iii-2a GateSupport source inventory drifted")
for label, source in (("transport", transport), ("launcher", launcher),
                      ("darwin", darwin)):
    imports = set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))
    if imports != {"Darwin", "Foundation", "StornautInvestigationHandoffContract"}:
        raise SystemExit("ii-c0b-iii-2a GateSupport import surface drifted")
    if re.search(r"(?m)^\s*(?:public|open)\s+", source) \
            or re.search(r"\b(?:Codable|Encodable|Decodable)\b", source):
        raise SystemExit("ii-c0b-iii-2a package-only or Codable surface drifted")
    debug_blocks = re.findall(r"(?ms)^#if DEBUG\n(.*?)^#endif$", source)
    if label == "transport":
        if len(debug_blocks) != 2 or any(
            "extension InvestigationMachineGate" not in block
            or block.count("throw InvestigationMachineGateError.invalid") != 1
            for block in debug_blocks
        ):
            raise SystemExit("ii-c0b-iii-2a test-only constructor boundary drifted")
    elif debug_blocks or "#if DEBUG" in source:
        raise SystemExit("ii-c0b-iii-2a production source became Debug-gated")
if [line.strip() for line in entry.splitlines() if line.strip()] != [
    "import Darwin", "import StornautInvestigationMachineGateSupport",
    "@main", "struct StornautInvestigationMachineGateCommand {",
    "static func main() {",
    "exit(InvestigationMachineGateSupport.run())", "}", "}",
]:
    raise SystemExit("ii-c0b-iii-2a entry surface drifted")
if re.search(r"\b(?:CommandLine|ProcessInfo|getenv|environ|posix_spawn|Process)\b", entry):
    raise SystemExit("ii-c0b-iii-2a entry selector or authority drifted")
production = transport + launcher + darwin + entry
for forbidden in (
    r"(?m)^import\s+Stornaut(?:Core|Execution|Codex|Lifecycle|InvestigationRuntime|InvestigationDiagnostic|InvestigationMachine|InvestigationMachineDriverSupport|InvestigationMachineLaunchSupport|ProcessSupport)\s*$",
    r"\b(?:ActionExecutor|TrashMoving|RegisteredAction|NSXPCConnection|URLSession|NWConnection|signedRuntimeReady|readiness)\b",
    r"\b(?:unlink|unlinkat|rename|renameat|mkdir|mkdirat|rmdir|chmod|chown|setxattr|removexattr)\s*\(",
):
    if re.search(forbidden, production, re.I):
        raise SystemExit("ii-c0b-iii-2a prohibited authority or readiness drifted")
for marker in (
    "iic0biii2a_gate_symbols=(", "iic0biii2a_positive_gates=(",
    "iic0biii2a_closed_images=(",
    "iic0biii2a_forbidden_gate_markers=(",
    "expected_debug_undefined_sha=512c8ea1fbd27b9df403a5db438ba3352aa2e6ebb2a9cdcaf877cf27cc73bc15",
    "expected_release_owned_sha=42a692726b9e81a3657e9c730288e5d183374ca69d26dee67fad1de960c76202",
    "verify_iic0biii2a_component_boundary",
):
    if marker not in verifier_path.read_text(encoding="utf-8"):
        raise SystemExit(f"ii-c0b-iii-2a component boundary drifted: {marker}")
verifier = verifier_path.read_text(encoding="utf-8")
component_start = verifier.index(
    "\nfunction verify_iic0biii2a_component_boundary() {"
) + 1
component_end = verifier.index(
    "\nfunction verify_iib5biii_a_source_contract() {",
    component_start,
)
component = verifier[component_start:component_end]
def shell_array(name):
    match = re.search(
        rf'(?ms)^\s*{re.escape(name)}=\(\n(?P<body>.*?)^\s*\)\n',
        component,
    )
    if match is None:
        raise SystemExit(f"ii-c0b-iii-2a component array missing: {name}")
    return [line.strip().strip('\"\'') for line in match.group("body").splitlines()]
if shell_array("iic0biii2a_gate_symbols") != [
    "StornautInvestigationMachineGateSupport.InvestigationMachineGateSupport.run()",
    "StornautInvestigationMachineGateSupport.InvestigationMachineFixedGateLauncher.run(inheritedCapsuleDescriptor:",
    "StornautInvestigationMachineGateSupport.InvestigationMachineGateTransportReceipt.decode",
]:
    raise SystemExit("ii-c0b-iii-2a Gate symbol allowlist drifted")
if shell_array("iic0biii2a_positive_gates") != [
    "$debug_gate", "$release_gate",
]:
    raise SystemExit("ii-c0b-iii-2a positive Gate allowlist drifted")
if shell_array("iic0biii2a_closed_images") != [
    "$product_derived_data/Build/Products/Debug/Stornaut.app",
    "$product_derived_data/Build/Products/Release/Stornaut.app",
    "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app",
    "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app",
    "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationMachineDriver",
]:
    raise SystemExit("ii-c0b-iii-2a closed-image allowlist drifted")
projection_guard = r'''        local index value expected expected_lines label
        for index in {1..6}; do
            value=$projection_values[$index]
            expected=$projection_hashes[$index]
            expected_lines=$projection_lines[$index]
            label=$projection_labels[$index]
            [[ "$(print -rn -- "$value" | shasum -a 256 | awk '{print $1}')" \
                == "$expected" \
                && "$(print -r -- "$value" | awk 'NF {n++} END {print n+0}')" \
                    == "$expected_lines" ]] || {
                print -u2 "ii-c0b-iii-2a exact projection drifted: $label"
                exit 1
            }
        done
'''
if component.count(projection_guard) != 1:
    raise SystemExit("ii-c0b-iii-2a projection guard drifted")
PY
}

function verify_iica_source_contract() {
    scripts/verify-investigation-boundaries \
        --iic-a-source-contract-only || return $?
    python3 - Stornaut.xcodeproj/project.pbxproj \
        Stornaut.xcodeproj/xcshareddata/xcschemes/StornautInvestigationDiagnosticApp.xcscheme \
        Stornaut.xcodeproj/xcshareddata/xcschemes/Stornaut.xcscheme <<'PY'
from pathlib import Path
import sys

project_path, diagnostic_scheme_path, ordinary_scheme_path = map(Path, sys.argv[1:])
project = project_path.read_text(encoding="utf-8")
diagnostic_scheme = diagnostic_scheme_path.read_text(encoding="utf-8")
ordinary_scheme = ordinary_scheme_path.read_text(encoding="utf-8")
tools = (
    ("StornautInvestigationMachineDriverNative", "StornautInvestigationMachineDriver", "StornautInvestigationMachineDriverSupport"),
    ("StornautInvestigationMachineGateNative", "StornautInvestigationMachineGate", "StornautInvestigationMachineGateSupport"),
    ("StornautInvestigationMachineGateCoordinatorNative", "StornautInvestigationMachineGateCoordinator", "StornautInvestigationMachineGateCoordinatorSupport"),
)

def block(identifier, comment):
    marker = f"{identifier} /* {comment} */ = {{"
    start = project.index(marker)
    end = project.index("\n\t\t};", start)
    return project[start:end]

ordinary = block("A00000000000000000000001", "StornautApp")
diagnostic = block("A00000000000000000000005", "StornautInvestigationDiagnosticApp")
release_shell = block("A00000000000000000000008", "StornautInvestigationDiagnosticReleaseShell")
copy_phase = block("B00000000000000000000042", "Copy Investigation Machine Tools")
if diagnostic.count("PBXTargetDependency") != 4 or "Copy Investigation Machine Tools" not in diagnostic:
    raise SystemExit("ii-c-a diagnostic target composition drifted")
if copy_phase.count(" in Copy Investigation Machine Tools */") != 3:
    raise SystemExit("ii-c-a copy phase membership drifted")
for target, product, support in tools:
    if project.count(f"name = {target};") != 1:
        raise SystemExit(f"ii-c-a target identity drifted: {target}")
    if project.count(f"{product} in Copy Investigation Machine Tools") != 2:
        raise SystemExit(f"ii-c-a copy identity drifted: {product}")
    if diagnostic_scheme.count(f'BlueprintName = "{target}"') != 1:
        raise SystemExit(f"ii-c-a diagnostic scheme drifted: {target}")
    for closed_name, closed in (("ordinary App", ordinary), ("Release shell", release_shell)):
        if any(value in closed for value in (target, product, support, "Copy Investigation Machine Tools")):
            raise SystemExit(f"ii-c-a machine tool leaked into {closed_name}: {product}")
    if any(value in ordinary_scheme for value in (target, product, support)):
        raise SystemExit(f"ii-c-a ordinary scheme gained machine tool: {product}")
PY
}

function verify_iica_installation_source_contract() {
    local installer=${1:-scripts/stornaut-r5-local-lifecycle}
    local expected_installer_sha=2274081f29fcecde69a9f025e796e242de2f83bbf5adf4f1b1d2c63eebc04e97
    [[ "$(shasum -a 256 "$installer" | awk '{print $1}')" == \
        "$expected_installer_sha" ]] || {
        print -u2 "ii-c-a installer source seal drifted"
        return 1
    }
    python3 - "$installer" <<'PY'
from pathlib import Path
import re
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")

def body(name):
    match = re.search(
        rf'(?ms)^{re.escape(name)}\(\) \{{\n(.*?)(?=^\}}\n\n)',
        source,
    )
    if match is None:
        raise SystemExit(f"ii-c-a installer function missing: {name}")
    return match.group(1)

identity = body("validate_closed_executable_identity")
artifact = body("validate_closed_executable_artifact")
app = body("validate_closed_app_artifacts")
fixtures = body("validate_closed_artifact_fixtures")
install = body("install")
rollback = body("rollback_failed_lifecycle")
uninstall = body("uninstall")
flat = lambda value: re.sub(r'\s+', ' ', value.replace('\\\n', ' ')).strip()

for marker in (
    "/usr/bin/codesign -d --verbose=4", "/usr/bin/codesign -d -r-",
    "designated => cdhash H", "/usr/bin/shasum -a 256",
    "$expected_signing_identifier", "$expected_node",
    "machineClaimServiceIdentifier=$machine_claim_service",
):
    if marker not in identity:
        raise SystemExit(f"ii-c-a identity contract drifted: {marker}")
if identity.count("machineClaimServiceIdentifier=$machine_claim_service") != 1:
    raise SystemExit("ii-c-a driver claim-service cardinality drifted")
for marker in (
    "sysopen -r -o nofollow", "zstat -H descriptor_stat -f",
    "executable_size <= max_bytes", "/usr/bin/lipo -archs",
    "validate_closed_executable_identity", "$expected_identity",
):
    if marker not in artifact:
        raise SystemExit(f"ii-c-a executable artifact contract drifted: {marker}")
roles = (
    ("StornautInvestigationMachineDriver", "com.eriklee.stornaut.investigation.machine-driver", "$machine_driver_max_bytes", "$machine_claim_service"),
    ("StornautInvestigationMachineGate", "com.eriklee.stornaut.investigation.machine-gate", "$machine_gate_max_bytes", '""'),
    ("StornautInvestigationMachineGateCoordinator", "com.eriklee.stornaut.investigation.machine-gate-coordinator", "$machine_coordinator_max_bytes", '""'),
)
if app.count("validate_closed_executable_artifact") != 3:
    raise SystemExit("ii-c-a role cardinality drifted")
for product, identifier, maximum, service in roles:
    for marker in (f"Contents/MacOS/{product}", identifier, maximum, service):
        if marker not in app:
            raise SystemExit(f"ii-c-a role binding drifted: {product}: {marker}")
for role in ("machineDriverIdentity={", "machineGateIdentity={", "machineCoordinatorIdentity={"):
    if app.count(role) != 1:
        raise SystemExit(f"ii-c-a role identity key drifted: {role}")
if fixtures.count("validate_closed_app_artifacts") != 3:
    raise SystemExit("ii-c-a three-plane identity join drifted")
for marker in (
    "built_closed_artifact_identity", "staging_closed_artifact_identity",
    "installed_closed_artifact_identity",
):
    if marker not in fixtures:
        raise SystemExit(f"ii-c-a plane identity drifted: {marker}")

def require_order(text, markers, label):
    cursor = 0
    for marker in markers:
        position = text.find(marker, cursor)
        if position < 0:
            raise SystemExit(f"ii-c-a {label} missing: {marker}")
        cursor = position + len(marker)

require_order(flat(install), (
    "built_closed_artifact_identity=$(validate_built_app)",
    "staging_app_created=1",
    '/bin/mkdir -m 0755 "$staging_app"',
    "staging_app_node=$(",
    'exact_directory_metadata "$staging_app" root wheel 0755',
    '/usr/bin/ditto --noqtn "$built_app" "$staging_app"',
    "staging_closed_artifact_identity=$(",
    "validate_closed_app_artifacts",
    '"$staging_app_node"',
    "installed_app_node=$staging_app_node",
    '/bin/mv -n "$staging_app" "$installed_app"',
    '"$installed_app_node"',
    "installed_closed_artifact_identity=$(",
    "validate_installed_artifacts",
    '/bin/launchctl bootstrap system "$installed_plist"',
), "install transaction")
for label, text, markers in (
    ("rollback", rollback, ("[[ -z ${staging_app_node:-} ||", "${installed_app_node:-}", "${built_closed_artifact_identity:-}", "validate_closed_app_artifacts")),
    ("uninstall", uninstall, ("uninstall_app_node", "uninstall_closed_artifact_identity", "validate_closed_app_artifacts")),
):
    for marker in markers:
        if marker not in text:
            raise SystemExit(f"ii-c-a {label} pre-delete validation drifted: {marker}")
validation_action = re.search(
    r'(?ms)^    validate-machine-driver\)\n(?P<body>.*?)^        ;;$',
    source,
)
if validation_action is None or "validate_closed_artifact_fixtures" not in validation_action.group("body"):
    raise SystemExit("ii-c-a validation action drifted")
validation_only = "".join(
    body(name) for name in (
        "exact_file_metadata", "exact_directory_metadata",
        "validate_closed_executable_identity",
        "validate_closed_executable_artifact",
        "validate_closed_app_artifacts",
        "validate_closed_artifact_fixtures",
    )
) + validation_action.group("body")
for forbidden in (
    "launchctl", "mkdir", "chown", "chmod", "ditto",
    "/bin/mv", "/bin/rm", "/usr/bin/install", "/Library/",
    "/private/var/", "posix_spawn", "exec ", "eval ", "xargs",
):
    if forbidden in validation_only:
        raise SystemExit(f"ii-c-a validation-only live action drifted: {forbidden}")
PY
}

function verify_iic0biii2a_closed_image() (
    local file=$1 kind symbols strings combined inventory marker
    if [[ -d $file ]]; then
        inventory=$(mktemp "${TMPDIR:-/tmp}/stornaut-iic0biii2a-inventory.XXXXXX")
        trap 'rm -f "$inventory"' EXIT
        find "$file" -type f -print0 >"$inventory" || {
            print -u2 "ii-c0b-iii-2a closed-image enumeration failed: $file"
            return 1
        }
        while IFS= read -r -d '' file; do
            kind=$(file "$file" 2>/dev/null) || {
                print -u2 "ii-c0b-iii-2a closed-image type scan failed: $file"
                return 1
            }
            [[ $kind == *Mach-O* ]] || continue
            verify_iic0biii2a_closed_image "$file" || return $?
        done <"$inventory"
        return 0
    fi
    symbols=$(xcrun nm -j "$file" 2>/dev/null \
        | xcrun swift-demangle 2>/dev/null) || {
        print -u2 "ii-c0b-iii-2a closed-image symbol scan failed: $file"
        return 1
    }
    strings=$(xcrun strings -a "$file" 2>/dev/null) || {
        print -u2 "ii-c0b-iii-2a closed-image string scan failed: $file"
        return 1
    }
    combined="$symbols$strings"
    for marker in 'StornautInvestigationMachineGateSupport.' 'StornautInvestigationMachineGateCoordinatorSupport.' 'stornaut.task39.machine.gate-coordinator-receipt.v1'; do
        [[ "$combined" != *"$marker"* ]] || { print -u2 "ii-c0b-iii-2a forbidden namespace or receipt domain leaked into a closed image: $file: $marker"; return 1; }
    done
)

function verify_iic0biii2a_component_boundary() {
    (( $# == 0 || $# == 2 )) || return 64
    local scratch result_code=0
    scratch=$(mktemp -d \
        "${TMPDIR:-/tmp}/stornaut-iic0biii2a-component.XXXXXX")
    (
        trap 'rm -rf "$scratch"' EXIT
        trap 'exit 130' INT; trap 'exit 143' TERM
        local debug_root="$scratch/gate-debug"
        local release_root="$scratch/gate-release"
        local product_derived_data diagnostic_derived_data
        if (( $# == 2 )); then
            product_derived_data=$1; diagnostic_derived_data=$2
            [[ -d $product_derived_data && -d $diagnostic_derived_data ]] || {
                print -u2 "ii-c0b-iii-2a existing component roots unavailable"
                exit 1
            }
        else
            product_derived_data="$scratch/xcode-product"
            diagnostic_derived_data="$scratch/xcode-diagnostic"
            for configuration in Debug Release; do
                xcodebuild -quiet -project Stornaut.xcodeproj -scheme Stornaut \
                    -configuration "$configuration" \
                    -destination 'platform=macOS,arch=arm64' \
                    -derivedDataPath "$product_derived_data" build || exit $?
            done
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationDiagnosticApp -configuration Debug \
                -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationDiagnosticReleaseShell \
                -configuration Release -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationMachineDriverNative \
                -configuration Release -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
        fi
        swift build --scratch-path "$debug_root" \
            --configuration debug --product StornautInvestigationMachineGate \
            || exit $?
        swift build --scratch-path "$release_root" \
            --configuration release --product StornautInvestigationMachineGate \
            || exit $?
        local debug_gate release_gate
        debug_gate=$(swift build --scratch-path "$debug_root" \
            --configuration debug --show-bin-path)/StornautInvestigationMachineGate
        release_gate=$(swift build --scratch-path "$release_root" \
            --configuration release --show-bin-path)/StornautInvestigationMachineGate
        iic0biii2a_positive_gates=(
            "$debug_gate"
            "$release_gate"
        )
        [[ -f $debug_gate && ! -L $debug_gate ]] || {
            print -u2 "ii-c0b-iii-2a Debug Gate positive control is missing"
            exit 1
        }
        [[ -f $release_gate && ! -L $release_gate ]] || {
            print -u2 "ii-c0b-iii-2a Release Gate positive control is missing"
            exit 1
        }
        iic0biii2a_gate_symbols=(
            'StornautInvestigationMachineGateSupport.InvestigationMachineGateSupport.run()'
            'StornautInvestigationMachineGateSupport.InvestigationMachineFixedGateLauncher.run(inheritedCapsuleDescriptor:'
            'StornautInvestigationMachineGateSupport.InvestigationMachineGateTransportReceipt.decode'
        )
        iic0biii2a_forbidden_gate_markers=(
            'StornautCore.' 'StornautExecution.' 'StornautCodex.'
            'StornautLifecycle.' 'StornautInvestigationRuntime.'
            'StornautInvestigationDiagnostic.'
            'StornautInvestigationMachineDriverSupport.'
            'StornautInvestigationMachineLaunchSupport.'
            'StornautInvestigationMachineClaimServer.'
            'ActionExecutor' 'TrashMoving' 'RegisteredAction'
            'NSXPCConnection' 'URLSession' 'NWConnection'
            'signedRuntimeReady' 'readiness'
            'InvestigationMachineGateStub' '--coordinator' '--hold'
            'stornaut-signal-physical-v1'
        )
        local configuration gate symbols strings marker
        for configuration gate in debug "$debug_gate" release "$release_gate"; do
            symbols=$(xcrun nm -j "$gate" | xcrun swift-demangle) || exit $?
            strings=$(xcrun strings -a "$gate") || exit $?
            for marker in "${iic0biii2a_gate_symbols[@]}"; do
                [[ "$symbols" == *"$marker"* ]] || {
                    print -u2 "ii-c0b-iii-2a ${configuration:u} Gate positive control is missing: $marker"
                    exit 1
                }
            done
            for marker in "${iic0biii2a_forbidden_gate_markers[@]}"; do
                [[ "$symbols$strings" != *"$marker"* ]] || {
                    print -u2 \
                        "ii-c0b-iii-2a forbidden authority leaked into Gate: $configuration: $marker"
                    exit 1
                }
            done
            [[ "$strings" == *'/usr/bin/sudo'* \
                && "$strings" == *'Stornaut Task 39 ii-c administrator authorization: '* \
                && "$strings" == *'stornaut.task39.machine-gate.prepared-frame'* \
                && "$strings" == *'stornaut.task39.machine-gate.transport-receipt'* ]] || {
                print -u2 "ii-c0b-iii-2a fixed Gate string positive control is missing"
                exit 1
            }
        done

        local debug_undefined release_undefined debug_loads release_loads
        local debug_owned release_owned
        debug_undefined=$(xcrun nm -u -j "$debug_gate" | LC_ALL=C sort -u) || exit $?
        release_undefined=$(xcrun nm -u -j "$release_gate" | LC_ALL=C sort -u) || exit $?
        debug_loads=$(otool -L "$debug_gate" | tail -n +2 \
            | sed 's/^[[:space:]]*//' | LC_ALL=C sort -u) || exit $?
        release_loads=$(otool -L "$release_gate" | tail -n +2 \
            | sed 's/^[[:space:]]*//' | LC_ALL=C sort -u) || exit $?
        debug_owned=$(print -r -- "$(xcrun nm -j "$debug_gate" \
            | xcrun swift-demangle)" | rg 'StornautInvestigationMachineGate(Support)?' \
            | LC_ALL=C sort -u) || exit $?
        release_owned=$(print -r -- "$(xcrun nm -j "$release_gate" \
            | xcrun swift-demangle)" | rg 'StornautInvestigationMachineGate(Support)?' \
            | LC_ALL=C sort -u) || exit $?
        local expected_debug_undefined_sha=512c8ea1fbd27b9df403a5db438ba3352aa2e6ebb2a9cdcaf877cf27cc73bc15
        local expected_debug_undefined_lines=397
        local expected_release_undefined_sha=283d051cf84401d378cd29370e4045a1c053b03cfc4bbcf2ae600feb6ec8c761
        local expected_release_undefined_lines=314
        local expected_debug_loads_sha=a0c9d3ffb52720905af57106a895be6d7fc377ac5cf1fe2342919beeeb253c4c
        local expected_debug_loads_lines=14
        local expected_release_loads_sha=a0c9d3ffb52720905af57106a895be6d7fc377ac5cf1fe2342919beeeb253c4c
        local expected_release_loads_lines=14
        local expected_debug_owned_sha=7425ab957846c165b53d7c8ed3ffa26cbf71ddc08b1a15f2ca05b25da6db526e
        local expected_debug_owned_lines=1374
        local expected_release_owned_sha=42a692726b9e81a3657e9c730288e5d183374ca69d26dee67fad1de960c76202
        local expected_release_owned_lines=860
        local -a projection_values=(
            "$debug_undefined" "$release_undefined"
            "$debug_loads" "$release_loads"
            "$debug_owned" "$release_owned"
        )
        local -a projection_hashes=(
            "$expected_debug_undefined_sha" "$expected_release_undefined_sha"
            "$expected_debug_loads_sha" "$expected_release_loads_sha"
            "$expected_debug_owned_sha" "$expected_release_owned_sha"
        )
        local -a projection_lines=(
            "$expected_debug_undefined_lines" "$expected_release_undefined_lines"
            "$expected_debug_loads_lines" "$expected_release_loads_lines"
            "$expected_debug_owned_lines" "$expected_release_owned_lines"
        )
        local -a projection_labels=(
            debug-undefined release-undefined debug-loads release-loads
            debug-owned release-owned
        )
        local index value expected expected_lines label
        for index in {1..6}; do
            value=$projection_values[$index]
            expected=$projection_hashes[$index]
            expected_lines=$projection_lines[$index]
            label=$projection_labels[$index]
            [[ "$(print -rn -- "$value" | shasum -a 256 | awk '{print $1}')" \
                == "$expected" \
                && "$(print -r -- "$value" | awk 'NF {n++} END {print n+0}')" \
                    == "$expected_lines" ]] || {
                print -u2 "ii-c0b-iii-2a exact projection drifted: $label"
                exit 1
            }
        done

        iic0biii2a_closed_images=(
            "$product_derived_data/Build/Products/Debug/Stornaut.app"
            "$product_derived_data/Build/Products/Release/Stornaut.app"
            "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app"
            "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"
            "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationMachineDriver"
        )
        local -a iic0biii2a_required_closed_executables=(
            "$product_derived_data/Build/Products/Debug/Stornaut.app/Contents/MacOS/Stornaut"
            "$product_derived_data/Build/Products/Debug/Stornaut.app/Contents/MacOS/StornautLifecycleHelper"
            "$product_derived_data/Build/Products/Release/Stornaut.app/Contents/MacOS/Stornaut"
            "$product_derived_data/Build/Products/Release/Stornaut.app/Contents/MacOS/StornautLifecycleHelper"
            "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationDiagnostic"
            "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautLifecycleHelper"
            "$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationMachineDriver"
            "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app/Contents/MacOS/StornautInvestigationDiagnosticReleaseShell"
            "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationMachineDriver"
        )
        local closed_root required
        for required in "${iic0biii2a_required_closed_executables[@]}"; do
            [[ -f $required && ! -L $required ]] || {
                print -u2 \
                    "ii-c0b-iii-2a required closed-image control is missing: $required"
                exit 1
            }
        done
        for closed_root in "${iic0biii2a_closed_images[@]}"; do
            [[ -e $closed_root && ! -L $closed_root ]] || {
                print -u2 "ii-c0b-iii-2a closed image is missing: $closed_root"
                exit 1
            }
            verify_iic0biii2a_closed_image "$closed_root" || exit $?
        done
    ) || result_code=$?
    rm -rf "$scratch"
    return $result_code
}

function verify_iic0bivb2_component_boundary() (
    python3 - "${STORNAUT_IIC0BIVB2_COMPONENT_SOURCE:-${ZSH_SCRIPT:A}}" <<'PY'
from pathlib import Path
import sys
s=Path(sys.argv[1]).read_text(); a=s.index('\nfunction verify_iic0bivb2_component_boundary() (')+1; c=s.index('\nfunction verify_iic0biii2a_closed_image() (')+1; body=s[a:s.index('\nfunction verify_iib5biii_a_source_contract()',a)]; scanner=s[c:s.index('\nfunction verify_iic0biii2a_component_boundary()',c)]
required=['verify_iic0biii2a_'+'component_boundary || exit $?', 'StornautInvestigationMachineGateCoordinatorSupport.', 'stornaut.task39.machine.gate-coordinator-receipt.v1']
if body.count(required[0]) != 1 or any(scanner.count(x) != 1 for x in required[1:]): raise SystemExit('ii-c0b-iv component call-edge drifted')
PY
    verify_iic0biii2a_component_boundary || exit $?
    local scratch=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iic0bivb2-component.XXXXXX")
    trap 'rm -rf "$scratch"' EXIT
    local configuration binary symbols strings marker
    for configuration in debug release; do
        swift build --scratch-path "$scratch/$configuration" --configuration "$configuration" --product StornautInvestigationMachineGateCoordinator || exit $?
        binary=$(swift build --scratch-path "$scratch/$configuration" --configuration "$configuration" --show-bin-path)/StornautInvestigationMachineGateCoordinator
        [[ -f $binary && ! -L $binary ]] || exit 1
        symbols=$(xcrun nm -j "$binary" | xcrun swift-demangle) || exit $?
        strings=$(xcrun strings -a "$binary") || exit $?
        if [[ $configuration == debug ]]; then
            for marker in 'InvestigationMachineGateCoordinatorSupport.run()' 'InvestigationMachineGateCoordinatorOwnedAttempt' 'InvestigationMachineGateCoordinatorReceiptV1'
            do [[ "$symbols" == *"$marker"* ]] || {
                print -u2 "ii-c0b-iv Debug coordinator positive control is missing: $marker"
                exit 1
            }; done
        else
            [[ "$symbols$strings" != *'InvestigationMachineGateCoordinatorOwnedAttempt'* \
                && "$symbols$strings" != *'gate-coordinator-receipt.v1'* ]] || {
                print -u2 "ii-c0b-iv coordinator implementation leaked into Release"
                exit 1
            }
            local coordinator_exit=0
            "$binary" >/dev/null 2>&1 || coordinator_exit=$?
            [[ $coordinator_exit == 78 ]] || exit 1
        fi
    done
)

function verify_iica_component_boundary() (
    local product_derived_data=${1:-}
    local diagnostic_derived_data=${2:-}
    local scratch result_code=0
    if (( $# != 0 && $# != 2 )); then
        print -u2 "Usage: verify_iica_component_boundary [product-derived-data diagnostic-derived-data]"
        return 64
    fi
    scratch=$(mktemp -d \
        "${TMPDIR:-/tmp}/stornaut-iica-component.XXXXXX") || return $?
    (
        trap 'rm -rf "$scratch"' EXIT
        if (( $# == 0 )); then
            product_derived_data="$scratch/product"
            diagnostic_derived_data="$scratch/diagnostic"
            for configuration in Debug Release; do
                xcodebuild -quiet -project Stornaut.xcodeproj -scheme Stornaut \
                    -configuration "$configuration" \
                    -destination 'platform=macOS,arch=arm64' \
                    -derivedDataPath "$product_derived_data" build || exit $?
            done
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationDiagnosticApp -configuration Debug \
                -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
            xcodebuild -quiet -project Stornaut.xcodeproj \
                -scheme StornautInvestigationDiagnosticReleaseShell \
                -configuration Release -destination 'platform=macOS,arch=arm64' \
                -derivedDataPath "$diagnostic_derived_data" build || exit $?
            for scheme in StornautInvestigationMachineDriverNative \
                StornautInvestigationMachineGateNative \
                StornautInvestigationMachineGateCoordinatorNative
            do
                xcodebuild -quiet -project Stornaut.xcodeproj -scheme "$scheme" \
                    -configuration Release -destination 'platform=macOS,arch=arm64' \
                    -derivedDataPath "$diagnostic_derived_data" build || exit $?
            done
        fi
        local diagnostic_app="$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app"
        local release_shell="$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"
        local inventory="$scratch/diagnostic-inventory" relative candidate
        find "$diagnostic_app" -type f -print0 | while IFS= read -r -d '' candidate; do
            if file "$candidate" 2>/dev/null | grep -q Mach-O; then
                print -r -- "${candidate#$diagnostic_app/}"
            fi
        done | LC_ALL=C sort >"$inventory" || exit $?
        local expected_diagnostic_mach_o_paths=$'Contents/MacOS/StornautInvestigationDiagnostic\nContents/MacOS/StornautInvestigationDiagnostic.debug.dylib\nContents/MacOS/StornautInvestigationMachineDriver\nContents/MacOS/StornautInvestigationMachineGate\nContents/MacOS/StornautInvestigationMachineGateCoordinator\nContents/MacOS/StornautLifecycleHelper\nContents/MacOS/__preview.dylib'
        [[ "$(<"$inventory")" == "$expected_diagnostic_mach_o_paths" ]] || {
            print -u2 "ii-c-a diagnostic Mach-O allowlist drifted"; exit 1
        }
        local -a names=(
            StornautInvestigationMachineDriver
            StornautInvestigationMachineGate
            StornautInvestigationMachineGateCoordinator
        )
        local -a identifiers=(
            com.eriklee.stornaut.investigation.machine-driver
            com.eriklee.stornaut.investigation.machine-gate
            com.eriklee.stornaut.investigation.machine-gate-coordinator
        )
        local -a maximums=($((16 * 1024 * 1024)) $((64 * 1024 * 1024)) $((64 * 1024 * 1024)))
        local index name product product_directory nested identifier product_sha nested_sha product_cdhash nested_cdhash bytes
        for index in {1..3}; do
            name=$names[$index]; identifier=$identifiers[$index]
            product_directory="$diagnostic_derived_data/Build/Products/Debug"
            if [[ $name == StornautInvestigationMachineGateCoordinator ]]; then
                product_directory+=/StornautInvestigationMachineGateCoordinatorNative
            fi
            product="$product_directory/$name"
            nested="$diagnostic_app/Contents/MacOS/$name"
            for candidate in "$product" "$nested"; do
                [[ -f $candidate && ! -L $candidate ]] || exit 1
                [[ "$(stat -f '%HT:%Lp:%l' "$candidate")" == \
                    "Regular File:755:1" ]] || exit 1
                bytes=$(stat -f '%z' "$candidate")
                (( bytes > 0 && bytes <= maximums[$index] )) || exit 1
                [[ "$(lipo -archs "$candidate")" == arm64 ]] || exit 1
                /usr/bin/codesign --verify --strict "$candidate" || exit $?
                [[ "$(/usr/bin/codesign -d --verbose=4 "$candidate" 2>&1 | sed -n 's/^Identifier=//p')" == "$identifier" ]] || exit 1
                [[ "$(/usr/bin/codesign -d --verbose=4 "$candidate" 2>&1 | sed -n 's/^Signature=//p')" == adhoc ]] || exit 1
            done
            product_sha=$(shasum -a 256 "$product" | awk '{print $1}')
            nested_sha=$(shasum -a 256 "$nested" | awk '{print $1}')
            [[ $product_sha == $nested_sha ]] || exit 1
            product_cdhash=$(/usr/bin/codesign -d --verbose=4 "$product" 2>&1 | sed -n 's/^CDHash=//p')
            nested_cdhash=$(/usr/bin/codesign -d --verbose=4 "$nested" 2>&1 | sed -n 's/^CDHash=//p')
            [[ $product_cdhash == $nested_cdhash ]] || exit 1
            [[ "$(/usr/bin/codesign -d -r- "$nested" 2>&1 | sed -n 's/^# //p')" == \
                "designated => cdhash H\"$nested_cdhash\"" ]] || exit 1
            if [[ $name == StornautInvestigationMachineGateCoordinator ]]; then
                local coordinator_rpaths coordinator_load
                coordinator_rpaths=$(otool -l "$nested" | awk \
                    '/cmd LC_RPATH/ { want = 1; next } want && /path / { print $2; want = 0 }') || exit $?
                [[ $coordinator_rpaths == *'@executable_path/../Frameworks'* ]] || {
                    print -u2 "ii-c-a Coordinator App-relative runpath is missing"
                    exit 1
                }
                for coordinator_load in ${(f)"$(otool -L "$nested" \
                    | tail -n +2 | sed 's/^[[:space:]]*//' \
                    | awk '$1 ~ /^@rpath\// { print $1 }')"}; do
                    [[ -f "$diagnostic_app/Contents/Frameworks/${coordinator_load#@rpath/}" ]] || {
                        print -u2 \
                            "ii-c-a Coordinator framework dependency is unresolved: $coordinator_load"
                        exit 1
                    }
                done
            fi
            local release_product_directory="$diagnostic_derived_data/Build/Products/Release"
            if [[ $name == StornautInvestigationMachineGateCoordinator ]]; then
                release_product_directory+=/StornautInvestigationMachineGateCoordinatorNative
            fi
            local release_product="$release_product_directory/$name"
            [[ -f $release_product && ! -L $release_product ]] || exit 1
            [[ "$(lipo -archs "$release_product")" == arm64 ]] || exit 1
            /usr/bin/codesign --verify --strict "$release_product" || exit $?
            [[ "$(/usr/bin/codesign -d --verbose=4 "$release_product" 2>&1 | sed -n 's/^Identifier=//p')" == "$identifier" ]] || exit 1
        done
        /usr/bin/codesign --verify --deep --strict "$diagnostic_app" || exit $?
        for closed_app in \
            "$product_derived_data/Build/Products/Debug/Stornaut.app" \
            "$product_derived_data/Build/Products/Release/Stornaut.app" \
            "$release_shell"
        do
            for name in "${names[@]}"; do
                [[ ! -e "$closed_app/Contents/MacOS/$name" && \
                    ! -L "$closed_app/Contents/MacOS/$name" ]] || {
                    print -u2 "ii-c-a machine tool leaked into closed App: $closed_app/$name"; exit 1
                }
            done
        done
    ) || result_code=$?
    rm -rf "$scratch"
    return $result_code
)
function run_iicb1_root_owned_gate_component_snapshot() (
    umask 022
    local snapshot_mode=${1:-b1}
    local environment_name
    for environment_name in ${(k)parameters}; do
        [[ $environment_name == GIT_* ]] && unset "$environment_name"
    done
    PATH=/usr/bin:/bin:/usr/sbin:/sbin
    LC_ALL=C
    LANG=C
    export PATH LC_ALL LANG
    export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_SYSTEM=/dev/null \
        GIT_CONFIG_GLOBAL=/dev/null GIT_NO_REPLACE_OBJECTS=1 \
        GIT_OPTIONAL_LOCKS=0 GIT_TERMINAL_PROMPT=0
    (( $# <= 1 )) && [[ $snapshot_mode == b1 || $snapshot_mode == b2a2 \
        || $snapshot_mode == evidence ]] || {
        print -u2 "ii-c-b1 independent snapshot argument drifted"
        return 64
    }
    if [[ $snapshot_mode == evidence ]]; then
        scripts/verify-investigation-boundaries \
            --iic-evidence-verification-staged-scope-contract-only \
            3e49956f6f8e44d5d191d47c9e86856dd00d6966 || return $?
    elif [[ $snapshot_mode == b2a2 ]]; then
        scripts/verify-investigation-boundaries \
            --iic-b2a2-staged-scope-contract-only \
            cf1cbed8beff60cdd606bf7025fcef8a2768ff99 || return $?
    else
        scripts/verify-investigation-boundaries \
            --iic-b1-root-owned-gate-staged-scope-contract-only \
            41f5dba1b7ff7f1272d5a2607ae9794b266e6c47 || return $?
    fi
    /usr/bin/git diff-files --quiet --ignore-submodules -- || {
        print -u2 "ii-c-b1 independent snapshot tracked source drifted"
        return 1
    }
    [[ -z $(/usr/bin/git ls-files --others --exclude-standard) ]] || {
        print -u2 "ii-c-b1 independent snapshot untracked source drifted"
        return 1
    }
    local source_tree source_head container snapshot_root build_root
    local validation_home validation_tmp validation_user
    local manifest materialization_index
    source_tree=$(/usr/bin/git write-tree) || return $?
    source_head=$(/usr/bin/git rev-parse --verify 'HEAD^{commit}') || return $?
    container=$(/usr/bin/mktemp -d \
        /private/tmp/stornaut-iicb1-independent.XXXXXX) || return $?
    [[ -d $container && ! -L $container \
        && ${container:t} == stornaut-iicb1-independent.* ]] || {
        print -u2 "ii-c-b1 independent snapshot root is unsafe"
        return 1
    }
    trap '/bin/rm -rf -- "$container"' EXIT
    snapshot_root="$container/repository"
    build_root="$container/build"
    validation_home="$build_root/home"
    validation_tmp="$build_root/tmp"
    validation_user=$(/usr/bin/id -un) || return $?
    manifest="$container/source.manifest"
    materialization_index="$container/source.index"
    /bin/mkdir -m 700 "$snapshot_root" "$build_root" \
        "$validation_home" "$validation_tmp" || return $?
    /usr/bin/git ls-tree -rz --full-tree "$source_tree" >"$manifest" \
        || return $?
    /usr/bin/python3 -I - "$manifest" <<'PY' || return $?
import sys, unicodedata
with open(sys.argv[1], "rb") as source:
    records = source.read().split(b"\0")
if len(records) < 2 or records[-1]:
    raise SystemExit(1)
seen = set()
for record in records[:-1]:
    try:
        header, raw_path = record.split(b"\t", 1)
        mode, kind, object_id = header.split()
        path = raw_path.decode("utf-8")
    except (UnicodeDecodeError, ValueError):
        raise SystemExit(1)
    parts = path.split("/")
    canonical_key = unicodedata.normalize("NFD", path).casefold()
    if (mode not in (b"100644", b"100755") or kind != b"blob"
        or len(object_id) != 40
        or any(byte not in b"0123456789abcdef" for byte in object_id)
        or path.encode("utf-8") != raw_path
        or any(part in ("", ".", "..") for part in parts)
        or parts[0] == ".git" or canonical_key in seen):
        raise SystemExit(1)
    seen.add(canonical_key)
PY
    GIT_INDEX_FILE="$materialization_index" \
        /usr/bin/git read-tree "$source_tree" || return $?
    GIT_INDEX_FILE="$materialization_index" \
        /usr/bin/git checkout-index --all --prefix="$snapshot_root/" \
        || return $?
    /bin/rm -f -- "$manifest" "$materialization_index" || return $?
    /usr/bin/git -C "$snapshot_root" init -q --object-format=sha1 \
        || return $?
    /usr/bin/env -i HOME=/var/empty XDG_CONFIG_HOME=/var/empty \
        PATH=/usr/bin:/bin LC_ALL=C GIT_CONFIG_NOSYSTEM=1 \
        GIT_CONFIG_SYSTEM=/dev/null GIT_CONFIG_GLOBAL=/dev/null \
        GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 \
        GIT_TERMINAL_PROMPT=0 /usr/bin/git -C "$snapshot_root" \
        -c core.autocrlf=false -c core.filemode=true add --all --force \
        || return $?
    local materialized_tree validation_commit observed_status
    materialized_tree=$(/usr/bin/git -C "$snapshot_root" write-tree) \
        || return $?
    [[ $materialized_tree == $source_tree ]] || {
        print -u2 "ii-c-b1 independent snapshot tree drifted"
        return 1
    }
    validation_commit=$(
        print -r -- 'Stornaut ii-c-b1 independent staged snapshot' \
            | /usr/bin/env -i HOME=/var/empty XDG_CONFIG_HOME=/var/empty \
                PATH=/usr/bin:/bin LC_ALL=C GIT_CONFIG_NOSYSTEM=1 \
                GIT_CONFIG_SYSTEM=/dev/null GIT_CONFIG_GLOBAL=/dev/null \
                GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 \
                GIT_TERMINAL_PROMPT=0 \
                GIT_AUTHOR_NAME='Stornaut Validation' \
                GIT_AUTHOR_EMAIL='stornaut-validation@example.invalid' \
                GIT_COMMITTER_NAME='Stornaut Validation' \
                GIT_COMMITTER_EMAIL='stornaut-validation@example.invalid' \
                GIT_AUTHOR_DATE='2000-01-01T00:00:00Z' \
                GIT_COMMITTER_DATE='2000-01-01T00:00:00Z' \
                /usr/bin/git -C "$snapshot_root" commit-tree \
                    "$materialized_tree"
    ) || return $?
    /usr/bin/git -C "$snapshot_root" update-ref \
        refs/heads/iicb1-validation "$validation_commit" || return $?
    /usr/bin/git -C "$snapshot_root" symbolic-ref \
        HEAD refs/heads/iicb1-validation || return $?
    observed_status=$(/usr/bin/git -C "$snapshot_root" status \
        --porcelain=v1 --untracked-files=all) || return $?
    /usr/bin/git diff-files --quiet --ignore-submodules -- || {
        print -u2 "ii-c-b1 source worktree changed during component build"
        return 1
    }
    [[ -z $observed_status \
        && $(/usr/bin/git -C "$snapshot_root" rev-parse --verify HEAD) \
            == $validation_commit \
        && $(/usr/bin/git -C "$snapshot_root" rev-parse --verify 'HEAD^{tree}') \
            == $source_tree \
        && $(/usr/bin/git rev-parse --verify 'HEAD^{commit}') == $source_head \
        && $(/usr/bin/git write-tree) == $source_tree ]] || {
        print -u2 "ii-c-b1 independent snapshot provenance drifted"
        return 1
    }
    local child_status=0
    (
        cd "$snapshot_root"
        HOME="$validation_home"
        USER="$validation_user"
        LOGNAME="$validation_user"
        PATH=/usr/bin:/bin:/usr/sbin:/sbin
        LC_ALL=C
        LANG=C
        TMPDIR="$validation_tmp"
        DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
        STORNAUT_VALIDATION_COMMIT="$validation_commit"
        STORNAUT_VALIDATION_SOURCE=staged
        export HOME USER LOGNAME PATH LC_ALL LANG TMPDIR DEVELOPER_DIR \
            STORNAUT_VALIDATION_COMMIT STORNAUT_VALIDATION_SOURCE
        unset XBS_DISABLE_SANDBOXED_BUILDS SWIFTPM_SANDBOX \
            IDEPackageSupportDisableManifestSandbox \
            IDEPackageSupportDisablePluginExecutionSandbox OTHER_SWIFT_FLAGS \
            SWIFT_EXEC TOOLCHAINS SDKROOT XCODE_XCCONFIG_FILE
        repo_root="$snapshot_root"
        if [[ $snapshot_mode == b2a2 || $snapshot_mode == evidence ]]; then
            verify_iicb2a2_component_boundary
        else
            verify_iicb1_root_owned_gate_component_boundary \
                "$snapshot_root/scripts/verify-app-release-boundaries"
        fi
    ) || child_status=$?
    /usr/bin/git -C "$snapshot_root" diff-files \
        --quiet --ignore-submodules -- || {
        print -u2 "ii-c-b1 independent snapshot source changed during build"
        return 1
    }
    observed_status=$(/usr/bin/git -C "$snapshot_root" status \
        --porcelain=v1 --untracked-files=all) || return $?
    [[ -z $observed_status \
        && $(/usr/bin/git -C "$snapshot_root" rev-parse --verify HEAD) \
            == $validation_commit \
        && $(/usr/bin/git -C "$snapshot_root" rev-parse --verify 'HEAD^{tree}') \
            == $source_tree \
        && $(/usr/bin/git rev-parse --verify 'HEAD^{commit}') == $source_head \
        && $(/usr/bin/git write-tree) == $source_tree \
        && -z $(/usr/bin/git ls-files --others --exclude-standard) ]] || {
        print -u2 "ii-c-b1 independent snapshot post-build drifted"
        return 1
    }
    return $child_status
)
