#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"

mkdir -p "$repo_root/.derivedData"
derived_data=$(
    mktemp -d "$repo_root/.derivedData/app-release-boundaries.XXXXXX"
)
diagnostic_derived_data=$(
    mktemp -d \
        "$repo_root/.derivedData/investigation-diagnostic-boundary.XXXXXX"
)
cleanup() {
    rm -rf "$derived_data" "$diagnostic_derived_data" || true
}
trap cleanup EXIT

for configuration in Debug Release; do
    xcodebuild -quiet \
        -project Stornaut.xcodeproj \
        -scheme Stornaut \
        -configuration "$configuration" \
        -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath "$derived_data" \
        build
done

diagnostic_scheme=StornautInvestigationDiagnosticApp
xcodebuild -quiet \
    -project Stornaut.xcodeproj \
    -scheme "$diagnostic_scheme" \
    -configuration Debug \
    -destination 'platform=macOS,arch=arm64' \
    -derivedDataPath "$diagnostic_derived_data" \
    build

debug_app="$derived_data/Build/Products/Debug/Stornaut.app"
release_app="$derived_data/Build/Products/Release/Stornaut.app"
diagnostic_debug_app="$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app"
authority_object="$derived_data/Build/Products/Debug/StornautExecution.o"
test -x "$debug_app/Contents/MacOS/Stornaut"
test -x "$release_app/Contents/MacOS/Stornaut"
test -x \
    "$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic"
test -f "$authority_object"
file "$authority_object" | grep -q 'Mach-O'
test -x "$debug_app/Contents/MacOS/StornautLifecycleHelper"
test -x "$release_app/Contents/MacOS/StornautLifecycleHelper"
test ! -e \
    "$diagnostic_debug_app/Contents/MacOS/StornautLifecycleHelper"
test ! -e \
    "$debug_app/Contents/Library/LaunchDaemons/com.eriklee.stornaut.lifecycle.plist"
test ! -e \
    "$release_app/Contents/Library/LaunchDaemons/com.eriklee.stornaut.lifecycle.plist"

helper_source="StornautLifecycleHelper/main.swift"
rg -q 'func invalidateAndDrain\(\)' "$helper_source"
rg -q 'try self\?\.cancelActive\(\)' "$helper_source"
rg -q 'LifecycleInheritedSessionAdmission\(\)\.validate' "$helper_source"
rg -q 'LifecycleWorkerEvidenceReceipt\.decodeLine' "$helper_source"
rg -q 'paths\.userRootURL' "$helper_source"
rg -q 'POSIX_SPAWN_SETSID' "$helper_source"
rg -q 'getsid\(child\) == child' "$helper_source"
rg -q 'getpgid\(child\) == child' "$helper_source"
rg -q 'crashDescendantReadyLine' "$helper_source"
if rg -q '"setsid ' "$helper_source"; then
    print -u2 "R5 crash fixture relies on a non-portable setsid command."
    exit 1
fi
python3 - "$helper_source" <<'PY'
import sys

source = open(sys.argv[1], encoding="utf-8").read()
start = source.find("private func prepareDiagnosticDirectories(\n")
end = source.find("\n}\n\nprivate func prepareRootDirectory(", start)
if start < 0 or end < 0:
    raise SystemExit("missing closed R5 diagnostic-directory preparation")
body = source[start:end]
required = [
    "paths.userRootURL",
    "ownerUserID: 0",
    "ownerGroupID: 0",
    "mode: 0o711",
    "paths.rootURL",
    "ownerUserID: identity.userID",
    "ownerGroupID: identity.groupID",
    "mode: 0o700",
    "mustCreate: true",
]
if not all(value in body for value in required):
    raise SystemExit("R5 diagnostic directory ownership boundary is incomplete")
PY

lifecycle_script="scripts/stornaut-r5-local-lifecycle"
diagnostic_script="scripts/verify-codex-runtime-diagnostic"
gate_script="scripts/verify-codex-runtime-gate"
python3 - "$lifecycle_script" <<'PY'
import sys

source = open(sys.argv[1], encoding="utf-8").read()

def function_body(name, next_marker):
    start = source.find(f"{name}() {{\n")
    end = source.find(next_marker, start)
    if start < 0 or end < 0:
        raise SystemExit(f"missing closed R5 {name} function")
    return source[start:end]

recovery_body = function_body(
    "recover_runtime_roots_after_bootout",
    "\n}\n\nrollback_install() {",
)
uninstall_body = function_body(
    "uninstall",
    "\n}\n\ncase \"$action\" in",
)
recovery_call = uninstall_body.find("recover_runtime_roots_after_bootout")
early_validation = uninstall_body.find("validate_runtime_roots_drained")
if recovery_call < 0:
    raise SystemExit("R5 uninstall omits stale-runtime recovery")
if 0 <= early_validation < recovery_call:
    raise SystemExit(
        "R5 uninstall refuses stale runtime roots before attempting recovery"
    )
ordered_recovery_steps = [
    "runtime_roots_are_drained && return",
    '/bin/launchctl bootstrap system "$installed_plist"',
    '/bin/launchctl kickstart "system/$label"',
    '/bin/launchctl bootout "system/$label"',
]
positions = [recovery_body.find(step) for step in ordered_recovery_steps]
if any(position < 0 for position in positions) or positions != sorted(positions):
    raise SystemExit("R5 stale-runtime recovery sequence is incomplete")
if recovery_body.rfind("validate_runtime_roots_drained") <= positions[-1]:
    raise SystemExit("R5 stale-runtime recovery lacks final drained validation")

bundle_validation = function_body(
    "validate_bundle_permissions",
    "\n}\n\nvalidate_installed_state() {",
)
if '/usr/bin/find "$app" -type f -print0' in bundle_validation:
    raise SystemExit(
        "R5 bundle validation checks file owners but skips directory owners"
    )
required_bundle_checks = [
    '/usr/bin/find "$app" -print0',
    '"$owner" == root',
    '"$group" == wheel',
    '"$file_type" == "Directory"',
    '"$file_type" == "Regular File"',
    '"$links" == 1',
]
if not all(check in bundle_validation for check in required_bundle_checks):
    raise SystemExit("R5 bundle ownership/type validation is incomplete")

artifact_validation = function_body(
    "validate_installed_artifacts",
    "\n}\n\nvalidate_installed_state() {",
)
required_artifact_checks = [
    'exact_directory_metadata "$installed_app" root wheel 0755',
    'exact_file_metadata "$installed_plist" root wheel 0644',
    'validate_plist "$installed_plist"',
    '/usr/bin/cmp -s "$source_plist" "$installed_plist"',
    '/usr/bin/codesign --verify --deep --strict "$installed_app"',
    'validate_bundle_permissions "$installed_app"',
    '"$installed_app/Contents/MacOS/StornautLifecycleHelper"',
]
if not all(check in artifact_validation for check in required_artifact_checks):
    raise SystemExit("R5 installed artifact validation is incomplete")
artifact_call = recovery_body.find("validate_installed_artifacts")
bootstrap = recovery_body.find(
    '/bin/launchctl bootstrap system "$installed_plist"'
)
if artifact_call < 0 or artifact_call > bootstrap:
    raise SystemExit("R5 recovery bootstraps before validating installed artifacts")
uninstall_artifact_call = uninstall_body.find("validate_installed_artifacts")
uninstall_bootout = uninstall_body.find(
    '/bin/launchctl bootout "system/$label"'
)
if uninstall_artifact_call < 0 or uninstall_artifact_call > uninstall_bootout:
    raise SystemExit("R5 uninstall acts before validating installed artifacts")
runtime_removal = uninstall_body.find('/bin/rmdir -- "$diagnostic_root"')
installed_root_removal = uninstall_body.find('/bin/rmdir -- "$installed_root"')
if (
    runtime_removal < 0
    or installed_root_removal < 0
    or runtime_removal > installed_root_removal
):
    raise SystemExit("R5 uninstall removes the runtime parent too early")
PY

python3 - "$diagnostic_script" <<'PY'
import sys

source = open(sys.argv[1], encoding="utf-8").read()
required = [
    'built_app="$repo_root/.derivedData/xcodebuildmcp/Build/Products/Debug/Stornaut.app"',
    '/usr/bin/codesign --verify --deep --strict "$built_app"',
    '/usr/bin/codesign --verify --deep --strict "$installed_app"',
    '/usr/bin/diff -qr "$built_app" "$installed_app" >/dev/null',
]
if not all(value in source for value in required):
    raise SystemExit(
        "R5 machine diagnostic does not bind the installed App "
        "to the current Xcode build"
    )
PY

python3 - "$gate_script" <<'PY'
import sys

source = open(sys.argv[1], encoding="utf-8").read()
required = [
    'report.get("outcome") != {"signedRuntimeReady": {}}',
    'metadata.get("model") != "gpt-5.6-luna"',
    'metadata.get("provider") != "openai"',
]
if not all(value in source for value in required):
    raise SystemExit(
        "R5 machine gate does not validate the canonical ready outcome"
    )
PY

app_contains() {
    local app=$1
    local marker=$2
    mach_o_contains "$app" "$marker"
}

mach_o_contains() {
    local root=$1
    local marker=$2
    local file

    while IFS= read -r -d '' file; do
        if file "$file" 2>/dev/null | grep -q 'Mach-O' \
            && rg -a -q --fixed-strings -- "$marker" "$file"; then
            return 0
        fi
    done < <(find "$root" -type f -print0)
    return 1
}

authority_object_markers=(
    'ActionExecutor'
    'TrashMoving'
    'FileManagerTrashAdapter'
    'RecordingFileManagerTrashAdapter'
    'DenyRegisteredActionRunner'
    'FoundationRegisteredActionRunner'
    'spawnRegisteredActionWithPipes'
)

for marker in "${authority_object_markers[@]}"; do
    if ! rg -a -q --fixed-strings -- "$marker" "$authority_object"; then
        print -u2 \
            "Execution authority positive control is missing: $marker"
        exit 1
    fi
done

if ! mach_o_contains \
    "$diagnostic_debug_app" \
    'InvestigationRuntimeDiagnosticAppLeaf'; then
    print -u2 "Investigation diagnostic Mach-O positive control is missing."
    exit 1
fi

debug_markers=(
    '--stornaut-debug-fixture='
    '--stornaut-debug-history='
    '--stornaut-debug-history-presentation='
    '--stornaut-debug-review='
    '--stornaut-debug-cleanup='
    '--stornaut-debug-auto-cleanup-terminal'
    '--stornaut-debug-destination='
    '--stornaut-debug-settings='
    '--stornaut-debug-settings-section='
    '--stornaut-debug-open-settings'
    '--stornaut-ui-test-appearance='
    'app.appearance.requested'
    'scan-fixture-'
    'scope-fixture-'
    'snapshot-fixture-'
    'classification-fixture-'
    'fixture-catalog-v1'
    'fixture.volume'
    '/tmp/stornaut-fixture'
    '/tmp/stornaut-settings-fixture'
    '--stornaut-capability-runtime-config='
    '--stornaut-r5-worker'
    '--stornaut-r5-network-denial-probe'
    'stornaut-r5-worker-ready'
    'stornaut-r5-evidence'
    'STORNAUT_R5_'
    'stornaut-r5-diagnostic'
    'runtime.lifecycle.worker-failed'
    '--stornaut-phase-c-trash-config='
    '--stornaut-phase-c-trash-recovery-config='
    'STORNAUT_PHASE_C_TRASH_OPT_IN'
    'STORNAUT_PHASE_C_TRASH_RECOVERY_OPT_IN'
    'stornaut-phase-c-trash-item:'
    'signedAppTrashReady'
    'signedAppTrashRecoveryReady'
    'I authorize Stornaut Task 35 to Trash and restore only this disposable fixture.'
    'I authorize Stornaut Task 35 to recover the retained journal and restore only its exact disposable fixture without another Trash attempt.'
)

for marker in "${debug_markers[@]}"; do
    if ! app_contains "$debug_app" "$marker"; then
        print -u2 "Release gate positive control missed DEBUG marker: $marker"
        exit 1
    fi
    if app_contains "$release_app" "$marker"; then
        print -u2 "DEBUG fixture marker leaked into the Release App: $marker"
        exit 1
    fi
done

investigation_diagnostic_markers=(
    '--stornaut-investigation-runtime-config='
    'InvestigationRuntimeDiagnosticAppLeaf'
    'investigationRuntimeDebugCompositionPrepared'
    'I authorize one bounded disposable read-only Stornaut Investigation diagnostic.'
)

for marker in "${investigation_diagnostic_markers[@]}"; do
    if app_contains "$debug_app" "$marker"; then
        print -u2 "Investigation diagnostic leaked into the ordinary DEBUG App: $marker"
        exit 1
    fi
    if app_contains "$release_app" "$marker"; then
        print -u2 "Investigation diagnostic leaked into the Release App: $marker"
        exit 1
    fi
    if ! app_contains "$diagnostic_debug_app" "$marker"; then
        print -u2 "Investigation diagnostic positive control is missing: $marker"
        exit 1
    fi
done

diagnostic_forbidden_activation_markers=(
    '--stornaut-debug-fixture='
    '--stornaut-capability-runtime-config='
    '--stornaut-isolation-probe-config='
    '--stornaut-phase-c-trash-config='
    '--stornaut-phase-c-trash-recovery-config='
    'signedAppTrashReady'
    'signedAppTrashRecoveryReady'
    'PhaseCTrashDiagnosticHarness'
    'StornautAppModel'
    'AppDependencies'
    'StornautLifecycleHelper'
    'InvestigationCodexSessionAdapter'
    'InteractiveCodexAppServerClient'
)

for marker in "${diagnostic_forbidden_activation_markers[@]}"; do
    if app_contains "$diagnostic_debug_app" "$marker"; then
        print -u2 \
            "Forbidden surface leaked into Investigation diagnostic App: $marker"
        exit 1
    fi
done

diagnostic_authority_forbidden_markers=(
    'ActionExecutor'
    'TrashMoving'
    'FileManagerTrashAdapter'
    'RecordingFileManagerTrashAdapter'
    'DenyRegisteredActionRunner'
    'FoundationRegisteredActionRunner'
    'spawnRegisteredActionWithPipes'
)

for marker in "${diagnostic_authority_forbidden_markers[@]}"; do
    if mach_o_contains "$diagnostic_debug_app" "$marker"; then
        print -u2 \
            "Concrete authority leaked into Investigation diagnostic Mach-O: $marker"
        exit 1
    fi
done

python3 - Stornaut.xcodeproj/project.pbxproj <<'PY'
from pathlib import Path
import sys

project = Path(sys.argv[1]).read_text(encoding="utf-8")

def target_body(identifier, name, next_identifier):
    marker = f"{identifier} /* {name} */ = {{"
    start = project.find(marker)
    end = project.find(next_identifier, start)
    if start < 0 or end < 0:
        raise SystemExit(f"missing Xcode target boundary for {name}")
    return project[start:end]

ordinary_app = target_body(
    "A00000000000000000000001",
    "StornautApp",
    "\n\t\tA00000000000000000000002 /* StornautAppTests */",
)
ordinary_tests = target_body(
    "A00000000000000000000002",
    "StornautAppTests",
    "\n\t\tA00000000000000000000003 /* StornautAppUITests */",
)
ordinary_ui_tests = target_body(
    "A00000000000000000000003",
    "StornautAppUITests",
    "\n\t\tA00000000000000000000004 /* StornautLifecycleHelper */",
)
lifecycle_helper = target_body(
    "A00000000000000000000004",
    "StornautLifecycleHelper",
    "\n\t\tA00000000000000000000005 "
    "/* StornautInvestigationDiagnosticApp */",
)
diagnostic_app = target_body(
    "A00000000000000000000005",
    "StornautInvestigationDiagnosticApp",
    "\n\t\tA00000000000000000000006 "
    "/* StornautInvestigationDiagnosticAppTests */",
)
diagnostic_tests = target_body(
    "A00000000000000000000006",
    "StornautInvestigationDiagnosticAppTests",
    "\n/* End PBXNativeTarget section */",
)
for name, body in (
    ("StornautApp", ordinary_app),
    ("StornautAppTests", ordinary_tests),
):
    if "StornautInvestigationDiagnostic" in body:
        raise SystemExit(
            f"{name} regained the Investigation diagnostic package product"
        )
if "StornautInvestigationDiagnostic" not in diagnostic_app:
    raise SystemExit(
        "dedicated Investigation diagnostic App lost its package product"
    )
target_execution_dependencies = {
    name
    for name, body in (
        ("StornautApp", ordinary_app),
        ("StornautAppTests", ordinary_tests),
        ("StornautAppUITests", ordinary_ui_tests),
        ("StornautLifecycleHelper", lifecycle_helper),
        ("StornautInvestigationDiagnosticApp", diagnostic_app),
        ("StornautInvestigationDiagnosticAppTests", diagnostic_tests),
    )
    if "StornautExecution" in body
}
if target_execution_dependencies != {"StornautApp"}:
    raise SystemExit(
        "StornautExecution Xcode dependency allowlist drifted: "
        f"{sorted(target_execution_dependencies)}"
    )
for forbidden in (
    "StornautCore",
    "StornautCodex",
    "StornautLifecycle",
    "StornautExecution",
    "Copy Helper",
    "fileSystemSynchronizedGroups",
    "PBXTargetDependency",
):
    if forbidden in diagnostic_app:
        raise SystemExit(
            "dedicated Investigation diagnostic App regained forbidden "
            f"target surface: {forbidden}"
        )

source_phase_marker = (
    "B00000000000000000000024 /* Sources */ = {"
)
source_phase_start = project.find(source_phase_marker)
source_phase_end = project.find(
    "\n\t\tB00000000000000000000025 /* Sources */",
    source_phase_start,
)
if source_phase_start < 0 or source_phase_end < 0:
    raise SystemExit("missing dedicated diagnostic Sources phase")
source_phase = project[source_phase_start:source_phase_end]
expected_source = (
    "B00000000000000000000017 "
    "/* InvestigationRuntimeDiagnosticHarness.swift in Sources */"
)
if source_phase.count(" in Sources */") != 1 or expected_source not in source_phase:
    raise SystemExit(
        "dedicated Investigation diagnostic source allowlist drifted"
    )

framework_phase_marker = (
    "B00000000000000000000014 /* Frameworks */ = {"
)
framework_phase_start = project.find(framework_phase_marker)
framework_phase_end = project.find(
    "\n\t\tB00000000000000000000015 /* Frameworks */",
    framework_phase_start,
)
if framework_phase_start < 0 or framework_phase_end < 0:
    raise SystemExit("missing dedicated diagnostic Frameworks phase")
framework_phase = project[framework_phase_start:framework_phase_end]
expected_framework = (
    "B00000000000000000000009 "
    "/* StornautInvestigationDiagnostic in Frameworks */"
)
if (
    framework_phase.count(" in Frameworks */") != 1
    or expected_framework not in framework_phase
):
    raise SystemExit(
        "dedicated Investigation diagnostic dependency allowlist drifted"
    )

execution_framework_phases = []
phase_start = project.find("/* Begin PBXFrameworksBuildPhase section */")
phase_end = project.find("/* End PBXFrameworksBuildPhase section */")
if phase_start < 0 or phase_end < 0:
    raise SystemExit("missing Xcode Frameworks phase section")
frameworks = project[phase_start:phase_end]
cursor = 0
while True:
    start = frameworks.find("/* Frameworks */ = {", cursor)
    if start < 0:
        break
    line_start = frameworks.rfind("\n", 0, start) + 1
    end = frameworks.find("\n\t\t};", start)
    if end < 0:
        raise SystemExit("malformed Xcode Frameworks phase")
    body = frameworks[line_start:end]
    if "StornautExecution in Frameworks" in body:
        execution_framework_phases.append(body)
    cursor = end + 1
if (
    len(execution_framework_phases) != 1
    or "B00000000000000000000010 /* Frameworks */"
    not in execution_framework_phases[0]
    or execution_framework_phases[0].count(
        "StornautExecution in Frameworks"
    )
    != 1
):
    raise SystemExit(
        "StornautExecution Xcode dependency allowlist drifted in Frameworks"
    )

required_exact_membership = [
    (
        "B00000000000000000000017 "
        "/* InvestigationRuntimeDiagnosticHarness.swift in Sources */ = "
        "{isa = PBXBuildFile; fileRef = "
        "D00000000000000000000009 "
        "/* InvestigationRuntimeDiagnosticHarness.swift */; };"
    ),
    (
        "D00000000000000000000009 "
        "/* InvestigationRuntimeDiagnosticHarness.swift */ = "
        "{isa = PBXFileReference; lastKnownFileType = sourcecode.swift; "
        "path = "
        "StornautApp/Diagnostics/InvestigationRuntimeDiagnosticHarness.swift; "
        "sourceTree = SOURCE_ROOT; };"
    ),
]
if not all(value in project for value in required_exact_membership):
    raise SystemExit(
        "dedicated Investigation diagnostic source identity drifted"
    )
if (
    "Diagnostics/InvestigationRuntimeDiagnosticHarness.swift"
    not in project
    or "target = A00000000000000000000001 /* StornautApp */"
    not in project
):
    raise SystemExit(
        "ordinary App lost its diagnostic harness membership exclusion"
    )
PY

python3 - \
    Stornaut.xcodeproj/xcshareddata/xcschemes/StornautInvestigationDiagnosticApp.xcscheme \
    <<'PY'
from pathlib import Path
import sys

scheme = Path(sys.argv[1]).read_text(encoding="utf-8")
if "StornautLifecycleHelper" in scheme:
    raise SystemExit(
        "dedicated Investigation diagnostic scheme regained the lifecycle helper"
    )
if scheme.count('BlueprintName = "StornautInvestigationDiagnosticApp"') != 4:
    raise SystemExit("dedicated diagnostic scheme App identity drifted")
PY

xcodebuild -quiet \
    -project Stornaut.xcodeproj \
    -scheme "$diagnostic_scheme" \
    -configuration Debug \
    -destination 'platform=macOS,arch=arm64' \
    -derivedDataPath "$diagnostic_derived_data" \
    -only-testing:StornautInvestigationDiagnosticAppTests \
    test

print "Release App fixture boundary verification passed."
