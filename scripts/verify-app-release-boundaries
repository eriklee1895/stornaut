for marker in "${iib5biic_debug_introduced_imports[@]}"; do
    print -r -- "$machine_driver_undefined_symbols" \
        | grep -Fxq -- "$marker" || {
        print -u2 \
            "ii-b5b-ii-c Debug fixed-session import is missing: $marker"
        exit 1
    }
done
for marker in "${iib5biic_debug_required_fcntl_imports[@]}"; do
    print -r -- "$machine_driver_undefined_symbols" \
        | grep -Fxq -- "$marker" || {
        print -u2 "ii-b5b-ii-c Debug fcntl import is missing: $marker"
        exit 1
    }
done
for marker in "${iib5biid_debug_introduced_imports[@]}"; do
    print -r -- "$machine_driver_undefined_symbols" | grep -Fxq -- "$marker" || {
        print -u2 "ii-b5b-ii-d Debug retirement import is missing: $marker"; exit 1
    }
done
observed_machine_driver_security_imports=$(
    print -r -- "$machine_driver_undefined_symbols" \
        | grep -E '^_(Sec|kSec|Authorization|CSSM)' \
        | LC_ALL=C sort
)
if [[ "$observed_machine_driver_security_imports" != \
    "$expected_machine_driver_security_imports" ]]
then
    print -u2 "Machine driver Security import allowlist drifted."
    exit 1
fi
release_machine_driver_undefined_symbols=$(
    xcrun nm -u -j "$release_machine_driver" 2>/dev/null | LC_ALL=C sort -u
)
release_machine_driver_loaded_libraries=$(
    otool -L "$release_machine_driver" 2>/dev/null \
        | tail -n +2 | sed 's/^[[:space:]]*//' | LC_ALL=C sort -u
)
release_machine_driver_owned_symbols=$(
    xcrun nm -j "$release_machine_driver" 2>/dev/null \
        | xcrun swift-demangle 2>/dev/null \
        | rg 'StornautInvestigationMachineDriver(Support)?' | LC_ALL=C sort -u
)
require_projection "$release_machine_driver_undefined_symbols" \
    7c78e48e09da412dda28562f31c063cde5da02dfeed5d7fd2e0c74442d6ceb7c 451 release-undefined
require_projection "$release_machine_driver_loaded_libraries" \
    dde8b8c4542bf1afbf276ecb5d5341bb35f3f95529573d149d1143cb18c080c9 18 release-load-command
require_projection "$release_machine_driver_owned_symbols" \
    95be330898b63e980131417289c11ac11ccad9580f536885ea3e3c2e81238703 3690 release-owned-symbol
for marker in "${machine_driver_authority_forbidden_markers[@]}"; do
    if mach_o_has_demangled_symbol "$release_machine_driver" "$marker"; then
        print -u2 "Authority or readiness leaked into Release Machine driver: $marker"
        exit 1
    else
        symbol_scan_status=$?
    fi
    (( symbol_scan_status != 2 )) || exit 1
done
for marker in "${machine_driver_authority_forbidden_imports[@]}"; do
    ! print -r -- "$release_machine_driver_undefined_symbols" | grep -Fxq -- "$marker" || {
        print -u2 "Release Machine driver imports prohibited authority: $marker"; exit 1
    }
done
for marker in "${machine_driver_required_readonly_imports[@]}"; do
    print -r -- "$release_machine_driver_undefined_symbols" | grep -Fxq -- "$marker" || {
        print -u2 "Release Machine driver read-only import is missing: $marker"; exit 1
    }
done
for marker in "${iib5biic_release_forbidden_imports[@]}"; do
    if print -r -- "$release_machine_driver_undefined_symbols" \
        | grep -Fxq -- "$marker"
    then
        print -u2 \
            "ii-b5b-ii-c fixed-session import leaked into Release: $marker"
        exit 1
    fi
done
for marker in "${iib5biid_release_forbidden_imports[@]}"; do
    if print -r -- "$release_machine_driver_undefined_symbols" | grep -Fxq -- "$marker"; then
        print -u2 "ii-b5b-ii-d retirement import leaked into Release: $marker"; exit 1
    fi
done
[[ "$(print -r -- "$release_machine_driver_undefined_symbols" \
    | grep -E '^_(Sec|kSec|Authorization|CSSM)' | LC_ALL=C sort)" \
    == "$expected_machine_driver_security_imports" ]] || {
    print -u2 "Release Machine driver Security import allowlist drifted."; exit 1
}
