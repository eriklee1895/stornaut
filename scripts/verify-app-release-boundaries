for build_id, file_id, product in (
    ("B0000000000000000000001D", "D0000000000000000000000A", "StornautInvestigationMachineDriver"),
    ("B00000000000000000000052", "D0000000000000000000000D", "StornautInvestigationMachineGate"),
    ("B00000000000000000000055", "D0000000000000000000000F", "StornautInvestigationMachineGateCoordinator"),
