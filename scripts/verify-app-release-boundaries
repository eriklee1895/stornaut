app_contains() {
    local app=$1
    local marker=$2
    mach_o_contains "$app" "$marker"
}

mach_o_contains() {
    local root=$1
    local marker=$2
    local file

    while IFS= read -r -d '' file; do
        if file "$file" 2>/dev/null | grep -q 'Mach-O' \
            && rg -a -q --fixed-strings -- "$marker" "$file"; then
            return 0
        fi
    done < <(find "$root" -type f -print0)
    return 1
}

mach_o_has_demangled_symbol() {
    local root=$1
    local marker=$2
    local file
    local symbols

    while IFS= read -r -d '' file; do
        if ! file "$file" 2>/dev/null | grep -q 'Mach-O'; then
            continue
        fi
        if ! symbols=$(
            xcrun nm -j "$file" 2>/dev/null \
                | xcrun swift-demangle 2>/dev/null
        ); then
            print -u2 "Demangled symbol scan failed: $file"
            return 2
        fi
        if [[ "$symbols" == *"$marker"* ]]; then
            return 0
        fi
    done < <(find "$root" -type f -print0)
    return 1
}

ordinary_machine_claim_forbidden_symbols=(
    'StornautLifecycle.LifecycleMachineClaimXPCWire'
    'StornautLifecycle.LifecycleMachineClaimXPCClient.init'
    'StornautLifecycle.LifecycleMachineClaimXPCClient.claim'
    'StornautLifecycle.LifecycleMachineClaimXPCClient.activeConnection'
    'StornautLifecycle.LifecycleMachineClaimXPCClient.serviceName'
    'StornautLifecycle.LifecycleMachineClaimXPCReplyResolver'
    'StornautLifecycle.LifecycleMachineClaimResult'
    'StornautLifecycle.LifecycleMachineClaimXPCError'
    'StornautLifecycle.LifecycleMachineClaimXPCServerNamespace'
)

verify_ordinary_machine_claim_main_macho() {
    local executable=$1
    local label=$2
    local debug_dylib="${executable:h}/${executable:t:r}.debug.dylib"
    local main_images=("$executable")
    local image
    local marker
    local symbol_scan_status
    if [[ -e "$debug_dylib" ]]; then
        test -f "$debug_dylib"
        test ! -L "$debug_dylib"
        main_images+=("$debug_dylib")
    fi
    for marker in "${ordinary_machine_claim_forbidden_symbols[@]}"; do
        for image in "${main_images[@]}"; do
            if mach_o_has_demangled_symbol "$image" "$marker"; then
                print -u2 \
                    "Legacy machine-claim authority leaked into ordinary $label main Mach-O: $marker"
                exit 1
            else
                symbol_scan_status=$?
            fi
            if (( symbol_scan_status == 2 )); then
                exit 1
            fi
        done
    done
}

verify_ordinary_machine_claim_main_macho \
    "$debug_app/Contents/MacOS/Stornaut" Debug
verify_ordinary_machine_claim_main_macho \
    "$release_app/Contents/MacOS/Stornaut" Release

