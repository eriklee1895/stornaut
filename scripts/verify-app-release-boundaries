        "StornautExecution symbol leaked into Investigation diagnostic Mach-O."
    exit 1
else
    symbol_scan_status=$?
fi
if (( symbol_scan_status == 2 )); then
    exit 1
fi

python3 - Stornaut.xcodeproj/project.pbxproj <<'PY'
from pathlib import Path
import sys

project = Path(sys.argv[1]).read_text(encoding="utf-8")

native_target_section_start = project.find(
    "/* Begin PBXNativeTarget section */"
)
native_target_section_end = project.find(
    "/* End PBXNativeTarget section */",
    native_target_section_start,
)
if native_target_section_start < 0 or native_target_section_end < 0:
    raise SystemExit("missing PBX native-target section")
native_target_section = project[
    native_target_section_start:native_target_section_end
]
if native_target_section.count("isa = PBXNativeTarget;") != 8:
    raise SystemExit("L3c3b-i Xcode native-target allowlist drifted")
expected_native_targets = {
    "StornautApp",
    "StornautAppTests",
    "StornautAppUITests",
    "StornautLifecycleHelper",
    "StornautInvestigationDiagnosticApp",
    "StornautInvestigationDiagnosticAppTests",
    "StornautInvestigationDiagnosticReleaseShell",
    "StornautInvestigationMachineDriverNative",
}
for target_name in expected_native_targets:
    if native_target_section.count(f"name = {target_name};") != 1:
        raise SystemExit(
            f"L3c3b-i Xcode target identity drifted: {target_name}"
        )

copy_phase_section_start = project.find(
    "/* Begin PBXCopyFilesBuildPhase section */"
)
copy_phase_section_end = project.find(
    "/* End PBXCopyFilesBuildPhase section */",
    copy_phase_section_start,
)
if copy_phase_section_start < 0 or copy_phase_section_end < 0:
    raise SystemExit("missing PBX copy-phase section")
copy_phase_section = project[
    copy_phase_section_start:copy_phase_section_end
]
if copy_phase_section.count("isa = PBXCopyFilesBuildPhase;") != 3:
    raise SystemExit("L3c3b-i Xcode copy-phase allowlist drifted")
for phase_name in (
    "Copy Helper",
    "Copy Investigation Helper",
    "Copy Investigation Driver",
):
    if copy_phase_section.count(f'name = "{phase_name}";') != 1:
        raise SystemExit(
            f"L3c3b-i copy-phase identity drifted: {phase_name}"
        )

def target_body(identifier, name, next_identifier):
    marker = f"{identifier} /* {name} */ = {{"
    start = project.find(marker)
    end = project.find(next_identifier, start)
    if start < 0 or end < 0:
        raise SystemExit(f"missing Xcode target boundary for {name}")
    return project[start:end]

ordinary_app = target_body(
    "A00000000000000000000001",
    "StornautApp",
    "\n\t\tA00000000000000000000002 /* StornautAppTests */",
)
ordinary_tests = target_body(
    "A00000000000000000000002",
    "StornautAppTests",
    "\n\t\tA00000000000000000000003 /* StornautAppUITests */",
)
ordinary_ui_tests = target_body(
    "A00000000000000000000003",
    "StornautAppUITests",
    "\n\t\tA00000000000000000000004 /* StornautLifecycleHelper */",
)
lifecycle_helper = target_body(
