verify_helper_claim_server_macho() {
    local image=$1 marker selectors scan_status

    for marker in \
        "${claim_server_module_symbols[@]}" \
        "${claim_server_lifecycle_support_symbols[@]}"
    do
        if mach_o_image_has_demangled_symbol "$image" "$marker"; then
            continue
        else
            scan_status=$?
        fi
        if (( scan_status == 2 )); then
            exit 1
        fi
        print -u2 \
            "helper claim-server Mach-O positive drifted: $image: $marker"
        exit 1
    done
    for marker in "${claim_server_handoff_markers[@]}"; do
        if mach_o_image_has_raw_string "$image" "$marker"; then
            continue
        else
            scan_status=$?
        fi
        if (( scan_status == 2 )); then
            exit 1
        fi
        print -u2 \
            "helper claim-server Mach-O positive drifted: $image: $marker"
        exit 1
    done
    for marker in "${helper_claim_server_forbidden_symbols[@]}"; do
        if mach_o_image_has_demangled_symbol "$image" "$marker"; then
            print -u2 \
                "helper claim-server Mach-O gained forbidden dependency: $image: $marker"
            exit 1
        else
            scan_status=$?
        fi
        if (( scan_status == 2 )); then
            exit 1
        fi
    done
    if ! selectors=$(mach_o_image_machine_retirement_selectors "$image"); then
        print -u2 "claim-server selector scan failed: $image"
        exit 1
    fi
    if [[ "$selectors" != "$claim_server_selectors" ]]; then
        print -u2 \
            "claim-server two-selector surface drifted: $image: ${(qqq)selectors}"
        exit 1
    fi
}

verify_non_helper_claim_server_macho() {
    local image=$1 marker scan_status

    for marker in "${claim_server_module_symbols[@]}"; do
        if mach_o_image_has_demangled_symbol "$image" "$marker"; then
            print -u2 \
                "non-helper claim-server Mach-O leakage: $image: $marker"
            exit 1
        else
            scan_status=$?
        fi
        if (( scan_status == 2 )); then
            exit 1
        fi
    done
}

for helper_claim_server_image in "${helper_claim_server_images[@]}"; do
    verify_helper_claim_server_macho "$helper_claim_server_image"
done
for non_helper_claim_server_image in "${non_helper_claim_server_images[@]}"; do
    verify_non_helper_claim_server_macho "$non_helper_claim_server_image"
done
