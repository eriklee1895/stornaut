    "StornautInvestigationMachineDriverSupport.InvestigationMachineDarwinOuterInnerExecutionFactory",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineDarwinOuterObserver",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineDarwinInnerRoleValidator",
]:
    raise SystemExit("iii-b2b-1b Mach-O symbol allowlist drifted")
if shell_array("iib5biii_b2b1b_positive_drivers") != [
    "$machine_driver_product", "$diagnostic_machine_driver",
    "$release_machine_driver",
]:
    raise SystemExit("iii-b2b-1b Mach-O positive-driver allowlist drifted")
if shell_array("iib5biii_b2b1b_closed_images") != [
    "$debug_app/Contents/MacOS/Stornaut",
    "$debug_app/Contents/MacOS/Stornaut.debug.dylib",
    "$debug_app/Contents/MacOS/__preview.dylib",
    "$release_app/Contents/MacOS/Stornaut",
    "$debug_app/Contents/MacOS/StornautLifecycleHelper",
    "$release_app/Contents/MacOS/StornautLifecycleHelper",
    "$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic",
    "$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic.debug.dylib",
    "$diagnostic_debug_app/Contents/MacOS/__preview.dylib",
    "$diagnostic_debug_app/Contents/MacOS/StornautLifecycleHelper",
    "$diagnostic_release_app/Contents/MacOS/StornautInvestigationDiagnosticReleaseShell",
]:
    raise SystemExit("iii-b2b-1b Mach-O closed-image allowlist drifted")
macho_functions = re.findall(
    r"(?ms)^verify_iib5biii_b2b1b_macho\(\) \{\n.*?^\}\n", verifier
)
if len(macho_functions) != 1:
    raise SystemExit("iii-b2b-1b Mach-O function cardinality drifted")
macho = macho_functions[0]
for marker in (
    'for positive_driver in "${iib5biii_b2b1b_positive_drivers[@]}"',
    'for marker in "${iib5biii_b2b1b_symbols[@]}"',
    'mach_o_image_has_demangled_symbol "$positive_driver" "$marker"',
    'for closed_image in "${iib5biii_b2b1b_closed_images[@]}"',
    'mach_o_image_has_demangled_symbol "$closed_image" "$marker"',
    "(( scan_status != 2 )) || return 1",
):
    if marker not in macho:
        raise SystemExit(f"iii-b2b-1b Mach-O function drifted: {marker}")
if verifier.count("\nverify_iib5biii_b2b1b_macho\n") != 1 \
    or "\nexit 0\nverify_iib5biii_b2b1b_macho\n" in verifier:
    raise SystemExit("iii-b2b-1b Mach-O invocation drifted")
PY
}

function verify_iib5biii_b2a_iia2ii_source_contract() {
    local composition_path=$1 session_path=$2 protocol_path=$3
    local retirement_path=$4 source_path
    for source_path in "$composition_path" "$session_path" \
        "$protocol_path" "$retirement_path"
    do
        xcrun swiftc -frontend -parse -enable-bare-slash-regex "$source_path"
    done
    python3 - "$composition_path" "$session_path" "$protocol_path" \
        "$retirement_path" \
        "$repo_root/scripts/verify-app-release-boundaries" <<'PY'
from pathlib import Path
import re
import sys

composition_path, session_path, protocol_path, retirement_path, verifier_path = (
    map(Path, sys.argv[1:])
)
repo_root = verifier_path.parent.parent.resolve()
expected = {
    composition_path: repo_root / "Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinOuterInnerComposition.swift",
    session_path: repo_root / "Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinOuterInnerSession.swift",
    protocol_path: repo_root / "Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinOuterInnerProtocol.swift",
    retirement_path: repo_root / "Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochRetirement.swift",
}
for path, canonical in expected.items():
    if path.resolve() != canonical.resolve():
        raise SystemExit(f"iii-b2a-ii-a2-ii source path drifted: {path}")
composition, session, protocol, retirement = (
    path.read_text(encoding="utf-8")
    for path in (composition_path, session_path, protocol_path, retirement_path)
)
if composition.count("#if DEBUG") != 1 \
        or composition.count("#endif") != 1 \
        or not composition.rstrip().endswith("#endif"):
    raise SystemExit("iii-b2a-ii-a2-ii Debug-only source boundary drifted")
imports = set(re.findall(
    r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", composition
))
if imports != {
    "Darwin", "Foundation", "StornautInvestigationHandoffContract",
}:
    raise SystemExit("iii-b2a-ii-a2-ii composition import surface drifted")
semantic = "\n".join((composition, session, protocol, retirement))
if re.search(r"(?m)^\s*(?:public|open)\s+", semantic):
    raise SystemExit("iii-b2a-ii-a2-ii public surface drifted")
if re.search(r"\b(?:Codable|Encodable|Decodable)\b", semantic):
    raise SystemExit("iii-b2a-ii-a2-ii Codable surface drifted")
for marker in (
    "import StornautCore", "import StornautExecution",
    "import StornautLifecycle", "import StornautInvestigation\n",
    "import StornautCodex", "ActionPolicyGate", "CleanupPolicyGate",
    "CanonicalPathPolicy", "RegisteredAction", "MoveToTrash",
    "TrashMoving", "Executor", "URLSession", "NWConnection",
    "NSXPCConnection", "FileManager.default", "Foundation.Process(",
    "pkill", "killall", "pgrep", "ps -U",
):
    if marker in semantic:
        raise SystemExit(
            f"iii-b2a-ii-a2-ii authority surface drifted: {marker}"
        )
for marker in (
    "package actor InvestigationMachineDarwinOuterInnerComposition",
    "package struct InvestigationMachineDarwinOuterInnerExecutionFactory",
    "package struct InvestigationMachineDarwinInnerPhysicalRunner",
    "package struct InvestigationMachineDarwinInnerOwnershipExchange",
    "package struct InvestigationMachineDarwinFixedInnerChannel",
    "Darwin._exit(Self.deliberateExitStatus)",
):
    if marker not in composition:
        raise SystemExit(
            f"iii-b2a-ii-a2-ii DEBUG composition marker drifted: {marker}"
        )
if composition.count("fileprivate init(") != 1 or not re.search(
    r"fileprivate init\(\s*selection: "
    r"InvestigationMachineFixedEpochSelection,\s*admission: "
    r"InvestigationMachineDarwinOuterAdmission,", composition, re.DOTALL,
):
    raise SystemExit(
        "iii-b2a-ii-a2-ii outer composition initializer drifted"
    )
for marker in (
    "enum AbsenceProof: Sendable, Equatable",
    "fileprivate let appAbsence: AbsenceProof",
    "fileprivate let helperAbsence: AbsenceProof",
    "fileprivate let l1ResidueAbsence: AbsenceProof",
):
    if marker not in composition:
        raise SystemExit(
            "iii-b2a-ii-a2-ii terminal absence proof drifted"
        )
if "package func physicalOwnership(" not in protocol:
    raise SystemExit("iii-b2a-ii-a2-ii physical ownership boundary drifted")
if "fileprivate init(" not in retirement \
        or "InvestigationMachineDarwinOuterRetirementOutcome" not in retirement:
    raise SystemExit("iii-b2a-ii-a2-ii retirement outcome opacity drifted")
if "retireOwnedProcessGroupWithOutcome()" not in session:
    raise SystemExit("iii-b2a-ii-a2-ii session outcome bridge drifted")

verifier = verifier_path.read_text(encoding="utf-8")
for marker in (
    "iib5biii_b2a_iia2ii_debug_symbols=(",
    "iib5biii_b2a_iia2ii_debug_imports=(",
    "iib5biii_b2a_iia2ii_closed_images=(",
    "verify_iib5biii_b2a_iia2ii_macho() {",
    '"$diagnostic_machine_driver" "$marker"',
    'for closed_image in "${iib5biii_b2a_iia2ii_closed_images[@]}"; do',
    "iii-b2a-ii-a2-ii Debug Machine driver positive control is missing",
    "iii-b2a-ii-a2-ii DEBUG symbol leaked into a closed image",
    "iii-b2a-ii-a2-ii Debug import is missing",
    "iii-b2a-ii-a2-ii DEBUG import leaked into Release",
    "\nverify_iib5biii_b2a_iia2ii_macho\n",
):
    if marker not in verifier:
        raise SystemExit(
            f"iii-b2a-ii-a2-ii Mach-O source contract drifted: {marker}"
        )

def shell_array(name):
    match = re.search(
        rf"(?ms)^{re.escape(name)}=\(\n(?P<body>.*?)^\)\n", verifier
    )
    if match is None:
        raise SystemExit(f"iii-b2a-ii-a2-ii Mach-O array missing: {name}")
    values = []
    for line in match.group("body").splitlines():
        value = line.strip()
        quoted = re.fullmatch(r"(['\"])(.*?)\1", value)
        if quoted is None:
            raise SystemExit(
                f"iii-b2a-ii-a2-ii Mach-O array malformed: {name}"
            )
        values.append(quoted.group(2))
    return values

if shell_array("iib5biii_b2a_iia2ii_debug_symbols") != [
    "StornautInvestigationMachineDriverSupport.InvestigationMachineDarwinOuterInnerComposition",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineDarwinOuterInnerExecutionFactory",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineDarwinInnerPhysicalRunner",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineDarwinInnerOwnershipExchange",
    "StornautInvestigationMachineDriverSupport.InvestigationMachineDarwinFixedInnerChannel",
]:
    raise SystemExit("iii-b2a-ii-a2-ii Debug symbol allowlist drifted")
if shell_array("iib5biii_b2a_iia2ii_debug_imports") != ["__exit"]:
    raise SystemExit("iii-b2a-ii-a2-ii Debug import allowlist drifted")
PY
}

function verify_iicb2b2_component_boundary() (
    local PATH=/usr/bin:/bin:/usr/sbin:/sbin
    export PATH
    export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
    local scratch
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iicb2b2-component.XXXXXX")
    trap 'rm -rf "$scratch"' EXIT
    /usr/bin/swift build --scratch-path "$scratch/debug" \
        --configuration debug --product StornautInvestigationMachineCampaign \
        --disable-sandbox
    /usr/bin/swift build --scratch-path "$scratch/release" \
        --configuration release --product StornautInvestigationMachineCampaign \
        --disable-sandbox
    local debug release run_status=0 symbols
    debug=$(/usr/bin/swift build --scratch-path "$scratch/debug" \
        --configuration debug --show-bin-path)/StornautInvestigationMachineCampaign
    release=$(/usr/bin/swift build --scratch-path "$scratch/release" \
        --configuration release --show-bin-path)/StornautInvestigationMachineCampaign
    [[ -x $debug && -x $release && ! -L $debug && ! -L $release ]] || return 1
    "$debug" >/dev/null 2>&1 || run_status=$?
    (( run_status == 70 )) || { print -u2 "ii-c-b2b2 Debug missing-sibling status drifted"; return 1; }
    run_status=0; "$release" >/dev/null 2>&1 || run_status=$?
    (( run_status == 78 )) || { print -u2 "ii-c-b2b2 Release status drifted"; return 1; }
    symbols=$(xcrun nm -j "$debug" 2>/dev/null | xcrun swift-demangle) || return $?
    [[ $symbols == *InvestigationMachineCampaignExecutable* \
        && $symbols == *stornaut_investigation_campaign_spawn_fixed* ]] || {
        print -u2 "ii-c-b2b2 Debug positive control unavailable"; return 1
    }
    symbols=$(xcrun nm -j "$release" 2>/dev/null | xcrun swift-demangle) || return $?
    for forbidden in InvestigationMachineCampaignHarness \
        InvestigationMachineCampaignExecutable \
        stornaut_investigation_campaign_spawn_fixed TIOCSCTTY; do
        [[ $symbols != *$forbidden* ]] || {
            print -u2 "ii-c-b2b2 campaign authority leaked into Release"; return 1
        }
    done
    local project schemes
    project=$(<Stornaut.xcodeproj/project.pbxproj)
    schemes=$(cat Stornaut.xcodeproj/xcshareddata/xcschemes/*.xcscheme)
    [[ $project$schemes != *StornautInvestigationMachineCampaign* ]] || {
        print -u2 "ii-c-b2b2 campaign target reached Xcode products"; return 1
    }
)

function verify_iic_root_driver_lineage_l1_component_boundary() (
    local -x PATH=/usr/bin:/bin:/usr/sbin:/sbin; local require_staged=${1:-true}
    [[ $require_staged == false ]] || [[ ${STORNAUT_VALIDATION_SOURCE:-} == staged \
        && ${#STORNAUT_VALIDATION_COMMIT:-} == 40 \
        && ${STORNAUT_VALIDATION_COMMIT:-} != *[^0-9a-f]* \
        && "$(git rev-parse 'HEAD^{commit}')" == $STORNAUT_VALIDATION_COMMIT \
        && -z "$(git status --porcelain=v1 --untracked-files=all)" ]] || {
            print -u2 "ii-c root-driver lineage L1 staged validation snapshot unavailable"; return 1
        }
    scripts/verify-investigation-boundaries \
        --iic-root-driver-lineage-l1-source-contract-only || return $?
    local scratch
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iic-lineage-l1.XXXXXX") \
        || return $?
    trap 'rm -rf "$scratch"' EXIT
    /usr/bin/swift build --scratch-path "$scratch/debug" \
        --configuration debug --disable-sandbox || return $?
    local build_root=$scratch/debug/arm64-apple-macosx/debug
    local contract_object=$build_root/StornautInvestigationHandoffContract.build/InvestigationResolvedRootDriverLineageContract.swift.o
    local claim_object=$build_root/StornautInvestigationMachineDriverSupport.build/InvestigationMachineResolvedRootDriverClaim.swift.o
    local validator_object=$build_root/StornautInvestigationMachineGateSupport.build/InvestigationMachineResolvedRootDriverValidator.swift.o
    [[ -f $contract_object && -f $claim_object && -f $validator_object ]] || {
        print -u2 "ii-c root-driver lineage L1 object positive controls unavailable"
        return 1
    }
    local symbols imports object image
    for object in $contract_object $claim_object $validator_object; do
        symbols=$(xcrun nm -j "$object" 2>/dev/null | xcrun swift-demangle) || return $?
        [[ $symbols == *ResolvedRootDriver* ]] || {
            print -u2 "ii-c root-driver lineage L1 namespace positive control unavailable"
            return 1
        }
    done
    for object in $contract_object $claim_object $validator_object; do
        imports=$(xcrun nm -um "$object" 2>/dev/null) || return $?
        ! print -r -- "$imports" | grep -Eq \
            '(^|[[:space:]])_(Authorization|Sec|kSec)[A-Za-z0-9_]+' || {
            print -u2 "ii-c root-driver lineage L1 gained premature Security authority"
            return 1
        }
    done
    local -a closed_images=(
        "$build_root/SurveyorBenchmark" "$build_root/stornaut-rule-compiler"
        "$build_root/stornaut-lifecycle-spike" "$build_root/stornaut-capability-runtime-verifier"
    )
    for image in "${closed_images[@]}"; do
        [[ -f $image && ! -L $image \
            && "$(/usr/bin/file -b "$image")" == *'Mach-O 64-bit executable arm64'* ]] \
            || { print -u2 "ii-c root-driver lineage L1 closed image unavailable: $image"; return 1; }
        symbols=$(xcrun nm -j "$image" 2>/dev/null | xcrun swift-demangle) || return $?
        [[ -n $symbols ]] || return 1
        [[ $symbols != *ResolvedRootDriverClaimV1* \
            && $symbols != *InvestigationMachineResolvedRootDriverClaimCollector* \
            && $symbols != *InvestigationMachineResolvedRootDriverValidator* ]] || {
            print -u2 "ii-c root-driver lineage L1 namespace leaked into closed image"
            return 1
        }
    done
)

