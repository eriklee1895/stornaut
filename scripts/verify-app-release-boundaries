#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"

handoff_only=false
legacy_machine_claim_contract_only=false
legacy_machine_claim_contract_source=
iib4_machine_claim_contract_only=false
iib4_machine_claim_contract_source=
iib5biic_machine_driver_contract_only=false
iib5biic_machine_driver_contract_source=
iib5biid_machine_driver_contract_only=false
iib5biid_machine_driver_contract_source=
iic0a_source_contract_only=false
iic0a_projection_contract_source=
iic0a_intake_contract_source=
iib5biii_a_source_contract_only=false
iib5biii_a_single_epoch_source=
iib5biii_a_composition_source=
iib5biii_a_continuity_source=
iib5biii_b1_source_contract_only=false
iib5biii_b1_cohort_source=
iib5biii_b1_continuity_source=
iib5biii_b2a0_source_contract_only=false
iib5biii_b2a0_composition_source=
iib5biii_b2a0_continuity_source=
iib5biii_b2a0_bridge_source=
iib5biii_b2ai_source_contract_only=false
iib5biii_b2ai_single_epoch_source=
iib5biii_b2ai_composition_source=
iib5biii_b2ai_continuity_source=
iib5biii_b2ai_bridge_source=
iib5biii_b2ai_protocol_source=
iib5biii_b2a_iia1v_source_contract_only=false
iib5biii_b2a_iia1v_session_source=
iib5biii_b2a_iia1v_observer_source=
if [[ $# == 1 && $1 == --investigation-handoff-only ]]; then
    handoff_only=true
elif [[ $# == 2 && $1 == --legacy-machine-claim-contract-only ]]; then
    legacy_machine_claim_contract_only=true
    legacy_machine_claim_contract_source=$2
elif [[ $# == 2 && $1 == --iib4-machine-claim-contract-only ]]; then
    iib4_machine_claim_contract_only=true
    iib4_machine_claim_contract_source=$2
elif [[ $# == 2 && $1 == --iib5biic-machine-driver-contract-only ]]; then
    iib5biic_machine_driver_contract_only=true
    iib5biic_machine_driver_contract_source=$2
elif [[ $# == 2 && $1 == --iib5biid-machine-driver-contract-only ]]; then
    iib5biid_machine_driver_contract_only=true
    iib5biid_machine_driver_contract_source=$2
elif [[ $# == 3 && $1 == --iic0a-source-contract-only ]]; then
    iic0a_source_contract_only=true
    iic0a_projection_contract_source=$2
    iic0a_intake_contract_source=$3
elif [[ $# == 4 && $1 == --iib5biii-a-source-contract-only ]]; then
    iib5biii_a_source_contract_only=true
    iib5biii_a_single_epoch_source=$2
    iib5biii_a_composition_source=$3
    iib5biii_a_continuity_source=$4
elif [[ $# == 3 && $1 == --iib5biii-b1-source-contract-only ]]; then
    iib5biii_b1_source_contract_only=true
    iib5biii_b1_cohort_source=$2
    iib5biii_b1_continuity_source=$3
elif [[ $# == 4 && $1 == --iib5biii-b2a0-source-contract-only ]]; then
    iib5biii_b2a0_source_contract_only=true
    iib5biii_b2a0_composition_source=$2
    iib5biii_b2a0_continuity_source=$3
    iib5biii_b2a0_bridge_source=$4
elif [[ $# == 6 && $1 == --iib5biii-b2a-i-source-contract-only ]]; then
    iib5biii_b2ai_source_contract_only=true
    iib5biii_b2ai_single_epoch_source=$2
    iib5biii_b2ai_composition_source=$3
    iib5biii_b2ai_continuity_source=$4
    iib5biii_b2ai_bridge_source=$5
    iib5biii_b2ai_protocol_source=$6
elif [[ $# == 3 && $1 == --iib5biii-b2a-ii-a1v-source-contract-only ]]; then
    iib5biii_b2a_iia1v_source_contract_only=true
    iib5biii_b2a_iia1v_session_source=$2
    iib5biii_b2a_iia1v_observer_source=$3
elif (( $# != 0 )); then
    print -u2 \
        "Usage: scripts/verify-app-release-boundaries [--investigation-handoff-only | --legacy-machine-claim-contract-only <source> | --iib4-machine-claim-contract-only <source> | --iib5biic-machine-driver-contract-only <source> | --iib5biid-machine-driver-contract-only <source> | --iic0a-source-contract-only <projection> <intake> | --iib5biii-a-source-contract-only <single-epoch> <composition> <continuity> | --iib5biii-b1-source-contract-only <cohort> <continuity> | --iib5biii-b2a0-source-contract-only <composition> <continuity> <bridge> | --iib5biii-b2a-i-source-contract-only <single-epoch> <composition> <continuity> <bridge> <protocol> | --iib5biii-b2a-ii-a1v-source-contract-only <outer-inner-session> <driver-child-observation>]"
    exit 64
fi

function verify_claim_server_macho_source_contract() {
    local source_path=$1
    python3 - "$source_path" <<'PY'
from pathlib import Path
import re
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")
runtime_source = source[source.index("\nscripts/verify-contract\n"):]

required_fragments = (
    "claim_server_module_symbols=(",
    "claim_server_handoff_markers=(",
    "claim_server_lifecycle_support_symbols=(",
    "helper_claim_server_forbidden_symbols=(",
    "'StornautInvestigationMachineClaimXPCWire'",
    "'claimMachineRetirement:withReply:'",
    "'releaseMachineRetirement:withReply:'",
    "helper_claim_server_images=(",
    '"$debug_app/Contents/MacOS/StornautLifecycleHelper"',
    '"$release_app/Contents/MacOS/StornautLifecycleHelper"',
    '"$diagnostic_debug_app/Contents/MacOS/StornautLifecycleHelper"',
    "non_helper_claim_server_images=(",
    '"$debug_app/Contents/MacOS/Stornaut"',
    '"$debug_app/Contents/MacOS/Stornaut.debug.dylib"',
    '"$debug_app/Contents/MacOS/__preview.dylib"',
    '"$release_app/Contents/MacOS/Stornaut"',
    '"$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic"',
    '"$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic.debug.dylib"',
    '"$diagnostic_debug_app/Contents/MacOS/__preview.dylib"',
    '"$diagnostic_release_app/Contents/MacOS/StornautInvestigationDiagnosticReleaseShell"',
    '"$machine_driver_product"',
    '"$diagnostic_machine_driver"',
    "claim_server_handoff_negative_images=(",
    "mach_o_image_has_demangled_symbol()",
    "mach_o_image_has_raw_string()",
    "mach_o_image_machine_retirement_selectors()",
    "verify_helper_claim_server_macho()",
    "verify_non_helper_claim_server_macho()",
    "helper claim-server Mach-O positive drifted",
    "helper claim-server Mach-O gained forbidden dependency",
    "non-helper claim-server Mach-O leakage",
    "claim-server two-selector surface drifted",
    "scan_status=$?",
    "if (( scan_status == 2 )); then",
    "app_peer_adapter_forbidden_markers=(",
    "app_peer_adapter_closed_images=(",
    '"$debug_app/Contents/MacOS/Stornaut.debug.dylib"',
    '"$debug_app/Contents/MacOS/__preview.dylib"',
    'for forbidden_image in "${app_peer_adapter_closed_images[@]}"; do',
    "App peer adapter leaked into a closed image",
    "start_retire_seam_forbidden_markers=(",
    "start_retire_seam_closed_images=(",
    'for forbidden_image in "${start_retire_seam_closed_images[@]}"; do',
    "Start-retire seam leaked into a closed image",
    "b3c_concrete_markers=(",
    "b3c_closed_images=(",
    'for marker in "${b3c_concrete_markers[@]}"; do',
    "ii-b3c concrete entry missing from diagnostic Debug image",
    "ii-b3c concrete entry leaked into a closed image",
)
missing = [
    fragment for fragment in required_fragments
    if fragment not in runtime_source
]
if missing:
    raise SystemExit(f"claim-server Mach-O source contract drifted: {missing!r}")

if "bundle_mach_o_contains" in runtime_source:
    raise SystemExit(
        "claim-server Mach-O gate became bundle-recursive: "
        "bundle_mach_o_contains"
    )

def array_values(name):
    match = re.search(
        rf"(?ms)^{re.escape(name)}=\(\n(?P<body>.*?)^\)\n",
        runtime_source,
    )
    if match is None:
        raise SystemExit(f"claim-server Mach-O array missing: {name}")
    values = []
    for line in match.group("body").splitlines():
        value = re.fullmatch(r"\s+(['\"])(.*?)\1\s*", line)
        if value is None:
            raise SystemExit(f"claim-server Mach-O array malformed: {name}")
        values.append(value.group(2))
    return values

expected_arrays = {
    "app_peer_adapter_forbidden_markers": [
        "InvestigationHandoffAppLeafAdapter",
        "InvestigationHandoffPhysicalIO",
        "com.eriklee.stornaut.investigation-handoff-io",
        "LOCAL_PEERTOKEN",
    ],
    "app_peer_adapter_closed_images": [
        "$debug_app/Contents/MacOS/Stornaut",
        "$debug_app/Contents/MacOS/Stornaut.debug.dylib",
        "$debug_app/Contents/MacOS/__preview.dylib",
        "$release_app/Contents/MacOS/Stornaut",
        "$diagnostic_release_app/Contents/MacOS/StornautInvestigationDiagnosticReleaseShell",
    ],
    "start_retire_seam_forbidden_markers": [
        "startAndRetireWithEvidence",
    ],
    "start_retire_seam_closed_images": [
        "$debug_app/Contents/MacOS/Stornaut",
        "$debug_app/Contents/MacOS/Stornaut.debug.dylib",
        "$debug_app/Contents/MacOS/__preview.dylib",
        "$release_app/Contents/MacOS/Stornaut",
        (
            "$diagnostic_debug_app/Contents/MacOS/"
            "StornautInvestigationDiagnostic"
        ),
        "$diagnostic_debug_app/Contents/MacOS/__preview.dylib",
        (
            "$diagnostic_release_app/Contents/MacOS/"
            "StornautInvestigationDiagnosticReleaseShell"
        ),
    ],
    "b3c_concrete_markers": [
        "InvestigationHandoffAppLeafEntryAdmission",
        "InvestigationHandoffConcreteAppLeafOperations",
        "InvestigationHandoffNoAuthRetirement",
        "startAndRetireWithEvidence",
    ],
    "b3c_closed_images": [
        "$debug_app/Contents/MacOS/Stornaut",
        "$debug_app/Contents/MacOS/Stornaut.debug.dylib",
        "$debug_app/Contents/MacOS/__preview.dylib",
        "$release_app/Contents/MacOS/Stornaut",
        "$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic",
        "$diagnostic_debug_app/Contents/MacOS/__preview.dylib",
        (
            "$diagnostic_release_app/Contents/MacOS/"
            "StornautInvestigationDiagnosticReleaseShell"
        ),
    ],
    "claim_server_module_symbols": [
        (
            "StornautInvestigationMachineClaimServer."
            "InvestigationMachineClaimServer"
        ),
        (
            "StornautInvestigationMachineClaimServer."
            "InvestigationMachineClaimServerEffectExecutor"
        ),
        (
            "StornautInvestigationMachineClaimServer."
            "InvestigationMachineClaimServerPhysicalClock"
        ),
        (
            "StornautInvestigationMachineClaimServer."
            "InvestigationMachineClaimServerPhysicalScheduler"
        ),
        (
            "StornautInvestigationMachineClaimServer."
            "InvestigationMachineClaimServerPhysicalTerminal"
        ),
    ],
    "claim_server_handoff_markers": [
        "StornautInvestigationMachineClaimXPCWire",
        "stornaut.task39.machine-claim.request",
        "stornaut.task39.machine-claim.evidence",
        "stornaut.task39.machine-claim.release",
        "stornaut.task39.machine-claim.released",
    ],
    "claim_server_lifecycle_support_symbols": [
        "StornautLifecycle.LifecycleMachineRetirementEscrowDeadlineState",
    ],
    "helper_claim_server_forbidden_symbols": [
        "StornautInvestigationMachine.",
        "StornautCore.",
        "StornautExecution.",
    ],
    "helper_claim_server_images": [
        "$debug_app/Contents/MacOS/StornautLifecycleHelper",
        "$release_app/Contents/MacOS/StornautLifecycleHelper",
        "$diagnostic_debug_app/Contents/MacOS/StornautLifecycleHelper",
    ],
    "non_helper_claim_server_images": [
        "$debug_app/Contents/MacOS/Stornaut",
        "$debug_app/Contents/MacOS/Stornaut.debug.dylib",
        "$debug_app/Contents/MacOS/__preview.dylib",
        "$release_app/Contents/MacOS/Stornaut",
        (
            "$diagnostic_debug_app/Contents/MacOS/"
            "StornautInvestigationDiagnostic"
        ),
        (
            "$diagnostic_debug_app/Contents/MacOS/"
            "StornautInvestigationDiagnostic.debug.dylib"
        ),
        "$diagnostic_debug_app/Contents/MacOS/__preview.dylib",
        (
            "$diagnostic_release_app/Contents/MacOS/"
            "StornautInvestigationDiagnosticReleaseShell"
        ),
    ],
    "claim_server_handoff_negative_images": [
        "$debug_app/Contents/MacOS/Stornaut",
        "$debug_app/Contents/MacOS/Stornaut.debug.dylib",
        "$debug_app/Contents/MacOS/__preview.dylib",
        "$release_app/Contents/MacOS/Stornaut",
        (
            "$diagnostic_debug_app/Contents/MacOS/"
            "StornautInvestigationDiagnostic"
        ),
        "$diagnostic_debug_app/Contents/MacOS/__preview.dylib",
        (
            "$diagnostic_release_app/Contents/MacOS/"
            "StornautInvestigationDiagnosticReleaseShell"
        ),
    ],
}
for name, expected in expected_arrays.items():
    observed = array_values(name)
    if observed != expected:
        raise SystemExit(
            f"claim-server Mach-O array drifted: {name}: {observed!r}"
        )
seam_start = runtime_source.index(
    'for marker in "${start_retire_seam_forbidden_markers[@]}"; do'
)
seam_end = runtime_source.index(
    '\nverify_b3c_concrete_macho() {', seam_start
)
seam_loop = runtime_source[seam_start:seam_end]
for required in (
    'for forbidden_image in "${start_retire_seam_closed_images[@]}"; do',
    'mach_o_image_has_raw_string "$forbidden_image" "$marker"',
    'Start-retire seam leaked into a closed image',
    'if (( raw_scan_status == 2 )); then',
):
    if seam_loop.count(required) != 1:
        raise SystemExit("start-retire seam image scan drifted")

b3c_start = runtime_source.index(
    'verify_b3c_concrete_macho() {'
)
b3c_end = runtime_source.index(
    '\nfor marker in "${handoff_debug_markers[@]}"; do', b3c_start
)
b3c_loop = runtime_source[b3c_start:b3c_end].strip()
expected_b3c_loop = r'''verify_b3c_concrete_macho() {
    for marker in "${b3c_concrete_markers[@]}"; do
        if ! mach_o_image_has_demangled_symbol \
            "$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic.debug.dylib" \
            "$marker"
        then
            raw_scan_status=$?
            (( raw_scan_status != 2 )) || return 1
            print -u2 "ii-b3c concrete entry missing from diagnostic Debug image: $marker"
            return 1
        fi
        for forbidden_image in "${b3c_closed_images[@]}"; do
            if mach_o_image_has_demangled_symbol "$forbidden_image" "$marker"; then
                print -u2 "ii-b3c concrete entry leaked into a closed image: $forbidden_image: $marker"
                return 1
            else
                raw_scan_status=$?
            fi
            (( raw_scan_status != 2 )) || return 1
        done
    done
}'''
if b3c_loop != expected_b3c_loop:
    raise SystemExit("ii-b3c demangled symbol scan drifted")
if runtime_source.count("\nverify_b3c_concrete_macho\n") != 1:
    raise SystemExit("ii-b3c artifact gate invocation drifted")

selector_literal = (
    "claim_server_selectors=$'claimMachineRetirement:withReply:"
    "\\nreleaseMachineRetirement:withReply:'"
)
if runtime_source.count(selector_literal) != 1:
    raise SystemExit("claim-server two-selector source contract drifted")

for obsolete in (
    "ordinary_machine_claim_forbidden_symbols",
    "verify_ordinary_machine_claim_main_macho",
    "StornautLifecycle.LifecycleMachineClaimXPCWire",
    "StornautLifecycle.LifecycleMachineClaimXPCClient",
    "Legacy machine-claim authority",
):
    if obsolete in runtime_source:
        raise SystemExit(
            f"claim-server Mach-O contract retained old private wire: {obsolete}"
        )

for function_name in (
    "mach_o_image_has_demangled_symbol",
    "mach_o_image_has_raw_string",
    "mach_o_image_machine_retirement_selectors",
):
    match = re.search(
        rf"(?ms)^{function_name}\(\) \{{\n(?P<body>.*?)(?=^\}}\n)",
        source,
    )
    if match is None or match.group("body").count("return 2") != 3:
        raise SystemExit(
            f"claim-server fail-closed scanner drifted: {function_name}"
        )
non_helper = re.search(
    r"(?ms)^verify_non_helper_claim_server_macho\(\) \{\n"
    r"(?P<body>.*?)(?=^\}\n)",
    runtime_source,
)
if non_helper is None:
    raise SystemExit(
        "claim-server non-helper physical symbol scan drifted"
    )
non_helper_body = non_helper.group("body")
for required in (
    'for marker in "${claim_server_module_symbols[@]}"; do',
    'mach_o_image_has_demangled_symbol "$image" "$marker"',
    '"non-helper claim-server Mach-O leakage: $image: $marker"',
):
    if non_helper_body.count(required) != 1:
        raise SystemExit(
            "claim-server non-helper physical symbol scan drifted"
        )
PY
}

function verify_iib4_machine_claim_source_contract() {
    local source_path=$1
    python3 - "$source_path" <<'PY'
from pathlib import Path
import re
import subprocess
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")
runtime_source = source[source.index("\nscripts/verify-contract\n"):]

for fragment in (
    "iib4_machine_claim_positive_images=(",
    "iib4_machine_claim_positive_symbols=(",
    "iib4_machine_claim_positive_raw_markers=(",
    "iib4_machine_claim_required_security_imports=(",
    "iib4_machine_claim_closed_images=(",
    "verify_iib4_machine_claim_macho() {",
    'ii-b4 machine-claim Mach-O positive drifted',
    'ii-b4 machine-claim raw marker positive drifted',
    'ii-b4 machine-claim import positive drifted',
    'ii-b4 machine-claim leaked into a closed image',
    "\nverify_iib4_machine_claim_macho\n",
):
    if fragment not in runtime_source:
        raise SystemExit(
            f"ii-b4 machine-claim source contract drifted: {[fragment]!r}"
        )
if "--iib4-machine-claim-contract-only <source>" not in source:
    raise SystemExit(
        "ii-b4 machine-claim source contract drifted: "
        "['--iib4-machine-claim-contract-only <source>']"
    )

def array_values(name):
    match = re.search(
        rf"(?ms)^{re.escape(name)}=\(\n(?P<body>.*?)^\)\n",
        runtime_source,
    )
    if match is None:
        raise SystemExit(f"ii-b4 machine-claim array missing: {name}")
    values = []
    for line in match.group("body").splitlines():
        quoted = re.fullmatch(r"\s+(['\"])(.*?)\1\s*", line)
        bare = re.fullmatch(r"\s+([A-Za-z0-9_.$:/-]+)\s*", line)
        if quoted is not None:
            values.append(quoted.group(2))
        elif bare is not None:
            values.append(bare.group(1))
        else:
            raise SystemExit(f"ii-b4 machine-claim array malformed: {name}")
    return values

expected_arrays = {
    "iib4_machine_claim_positive_images": [
        "$machine_driver_product",
        "$diagnostic_machine_driver",
        "$release_machine_driver",
    ],
    "iib4_machine_claim_positive_symbols": [
        "StornautInvestigationMachineDriverSupport.InvestigationMachineClaimClient",
        "withTaskCancellationHandler",
        "InvestigationMachineClaimClientConnectionEpoch",
        "InvestigationMachineClaimClientReplyResolver",
        "beginDispatch",
    ],
    "iib4_machine_claim_positive_raw_markers": [
        "com.eriklee.stornaut.lifecycle.machine-claim",
        "claimMachineRetirement:withReply:",
        "releaseMachineRetirement:withReply:",
    ],
    "iib4_machine_claim_required_security_imports": [
        "_SecCodeCheckValidity",
        "_SecCodeCopyGuestWithAttributes",
        "_SecCodeCopyPath",
        "_SecCodeCopySelf",
        "_SecCodeCopySigningInformation",
        "_SecCodeCopyStaticCode",
        "_SecStaticCodeCheckValidity",
        "_SecStaticCodeCreateWithPath",
        "_kSecGuestAttributeAudit",
    ],
    "iib4_machine_claim_closed_images": [
        "$debug_app/Contents/MacOS/Stornaut",
        "$debug_app/Contents/MacOS/Stornaut.debug.dylib",
        "$debug_app/Contents/MacOS/__preview.dylib",
        "$release_app/Contents/MacOS/Stornaut",
        "$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic",
        "$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic.debug.dylib",
        "$diagnostic_debug_app/Contents/MacOS/__preview.dylib",
        "$diagnostic_release_app/Contents/MacOS/StornautInvestigationDiagnosticReleaseShell",
    ],
}
for name, expected in expected_arrays.items():
    observed = array_values(name)
    if observed != expected:
        raise SystemExit(
            f"ii-b4 machine-claim array drifted: {name}: {observed!r}"
        )
start = runtime_source.index("verify_iib4_machine_claim_macho() {")
end = runtime_source.index("\nif mach_o_has_demangled_symbol", start)
import hashlib
if hashlib.sha256(runtime_source[start:end].encode()).hexdigest() != (
    "8f2dc9384215f3dfdca982412dad9724156014a7148cd1c2382e2da93142257a"
):
    raise SystemExit("ii-b4 machine-claim Mach-O loop drifted")
for marker in (
    'mach_o_image_has_demangled_symbol "$positive_image" "$marker"',
    'mach_o_image_has_raw_string "$positive_image" "$marker"',
    'grep -Fxq -- "$marker"',
    'for marker in "${iib4_machine_claim_positive_symbols[@]}"; do',
    'for marker in "${iib4_machine_claim_positive_raw_markers[@]}"; do',
    'for marker in "${iib4_machine_claim_required_security_imports[@]}"; do',
    'for closed_image in "${iib4_machine_claim_closed_images[@]}"; do',
):
    if marker not in runtime_source[start:end]:
        raise SystemExit(f"ii-b4 machine-claim source contract drifted: {[marker]!r}")

for forbidden in (
    "$machine_driver_product",
    "$diagnostic_machine_driver",
    "$debug_app/Contents/MacOS/StornautLifecycleHelper",
    "$release_app/Contents/MacOS/StornautLifecycleHelper",
    "$diagnostic_debug_app/Contents/MacOS/StornautLifecycleHelper",
):
    if forbidden in array_values("iib4_machine_claim_closed_images"):
        raise SystemExit(
            "ii-b4 machine-claim negative-image scope drifted: "
            f"{forbidden}"
        )
PY
}

function verify_iib5biic_machine_driver_source_contract() {
    local source_path=$1
    python3 - "$source_path" <<'PY'
from pathlib import Path
import re
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")
runtime_source = source[source.index("\nscripts/verify-contract\n"):]

def array_values(name):
    match = re.search(
        rf"(?ms)^{re.escape(name)}=\(\n(?P<body>.*?)^\)\n",
        runtime_source,
    )
    if match is None:
        raise SystemExit(f"ii-b5b-ii-c Machine driver array missing: {name}")
    values = []
    for line in match.group("body").splitlines():
        quoted = re.fullmatch(r"\s+(['\"])(.*?)\1\s*", line)
        bare = re.fullmatch(
            r"\s+([A-Za-z0-9_.$:/-]+(?:\s+[A-Za-z0-9_.$:/-]+)*)\s*",
            line,
        )
        if quoted is not None:
            values.append(quoted.group(2))
        elif bare is not None:
            values.extend(bare.group(1).split())
        else:
            raise SystemExit(
                f"ii-b5b-ii-c Machine driver array malformed: {name}"
            )
    return values

introduced = [
    "_free", "_getpgid", "_getpgrp", "_poll", "_posix_spawn",
    "_posix_spawn_file_actions_addclose",
    "_posix_spawn_file_actions_adddup2",
    "_posix_spawn_file_actions_destroy",
    "_posix_spawn_file_actions_init",
    "_posix_spawnattr_destroy", "_posix_spawnattr_init",
    "_posix_spawnattr_setflags", "_posix_spawnattr_setpgroup",
    "_recv", "_send", "_shutdown", "_socketpair", "_strdup",
]
expected_arrays = {
    "iib5biic_debug_introduced_imports": introduced,
    "iib5biic_debug_required_fcntl_imports": [
        "_$s6Darwin5fcntlys5Int32VAD_A2DtF",
        "_$s6Darwin5fcntlys5Int32VAD_ADtF",
    ],
    "iib5biic_release_forbidden_imports": introduced,
}

for name, expected in expected_arrays.items():
    observed = array_values(name)
    if observed != expected:
        raise SystemExit(
            f"ii-b5b-ii-c Machine driver array drifted: {name}: "
            f"{observed!r}"
        )

forbidden = set(array_values("machine_driver_authority_forbidden_imports"))
for exempt in ("_posix_spawn", "_socketpair", "_send", "_recv"):
    if exempt in forbidden:
        raise SystemExit(
            f"ii-b5b-ii-c fixed import remains categorically forbidden: {exempt}"
        )
for retained in (
    "_posix_spawnp", "_execve", "_connect", "_bind", "_listen",
    "_sendto", "_recvfrom", "_write",
):
    if retained not in forbidden:
        raise SystemExit(
            f"ii-b5b-ii-c sibling authority prohibition drifted: {retained}"
        )

def loop_body(header, label):
    loop_header = f'for marker in "${{{header}[@]}}"; do'
    if runtime_source.count(loop_header) != 1:
        raise SystemExit(f"ii-b5b-ii-c {label} loop drifted")
    match = re.search(
        rf'(?ms)^for marker in "\$\{{{re.escape(header)}\[@\]\}}"; do\n'
        rf'(?P<body>.*?)^done$',
        runtime_source,
    )
    if match is None:
        raise SystemExit(f"ii-b5b-ii-c {label} loop drifted")
    return re.sub(r"\s+", " ", match.group("body")).strip()

debug_body = loop_body(
    "iib5biic_debug_introduced_imports", "Debug positive-import"
)
fcntl_body = loop_body(
    "iib5biic_debug_required_fcntl_imports", "Debug fcntl-import"
)
release_body = loop_body(
    "iib5biic_release_forbidden_imports", "Release negative-import"
)
for body, image, message in (
    (debug_body, "$machine_driver_undefined_symbols",
     "ii-b5b-ii-c Debug fixed-session import is missing: $marker"),
    (fcntl_body, "$machine_driver_undefined_symbols",
     "ii-b5b-ii-c Debug fcntl import is missing: $marker"),
    (release_body, "$release_machine_driver_undefined_symbols",
     "ii-b5b-ii-c fixed-session import leaked into Release: $marker"),
):
    for required in (image, "grep -Fxq -- \"$marker\"", message):
        if body.count(required) != 1:
            raise SystemExit(
                f"ii-b5b-ii-c Machine driver scanner drifted: {required}"
            )
PY
}

function verify_iib5biid_machine_driver_source_contract() {
    local source_path=$1
    python3 - "$source_path" <<'PY'
from pathlib import Path
import re, sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
runtime = source[source.index("\nscripts/verify-contract\n"):]
def values(name):
    match = re.search(rf"(?ms)^{name}=\(\n(?P<body>.*?)^\)\n", runtime)
    if match is None: raise SystemExit(f"ii-b5b-ii-d array missing: {name}")
    result=[]
    for line in match.group("body").splitlines():
        value=line.strip().strip("'\"")
        if value: result.extend(value.split())
    return result
expected=["_kill", "_nanosleep", "_proc_listpids", "_waitid", "_waitpid"]
for name in ("iib5biid_debug_introduced_imports", "iib5biid_release_forbidden_imports"):
    if values(name) != expected: raise SystemExit(f"ii-b5b-ii-d Machine driver array drifted: {name}")
for exempt in expected:
    if exempt in values("machine_driver_authority_forbidden_imports"):
        raise SystemExit(f"ii-b5b-ii-d fixed import remains categorically forbidden: {exempt}")
for retained in ("_killpg", "_pthread_kill", "_raise", "_write", "_posix_spawnp"):
    if retained not in values("machine_driver_authority_forbidden_imports"):
        raise SystemExit(f"ii-b5b-ii-d sibling authority prohibition drifted: {retained}")
for name, image, message in (
    ("iib5biid_debug_introduced_imports", "$machine_driver_undefined_symbols", "ii-b5b-ii-d Debug retirement import is missing: $marker"),
    ("iib5biid_release_forbidden_imports", "$release_machine_driver_undefined_symbols", "ii-b5b-ii-d retirement import leaked into Release: $marker"),
):
    match=re.search(rf'(?ms)^for marker in "\$\{{{name}\[@\]\}}"; do\n(?P<body>.*?)^done$',runtime)
    if match is None: raise SystemExit(f"ii-b5b-ii-d Machine driver scanner drifted: {name}")
    body=match.group("body")
    for marker in (image, 'grep -Fxq -- "$marker"', message):
        if body.count(marker)!=1: raise SystemExit(f"ii-b5b-ii-d Machine driver scanner drifted: {marker}")
PY
}

