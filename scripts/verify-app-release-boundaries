#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"

handoff_only=false
legacy_machine_claim_contract_only=false
legacy_machine_claim_contract_source=
if [[ $# == 1 && $1 == --investigation-handoff-only ]]; then
    handoff_only=true
elif [[ $# == 2 && $1 == --legacy-machine-claim-contract-only ]]; then
    legacy_machine_claim_contract_only=true
    legacy_machine_claim_contract_source=$2
elif (( $# != 0 )); then
    print -u2 \
        "Usage: scripts/verify-app-release-boundaries [--investigation-handoff-only | --legacy-machine-claim-contract-only <source>]"
    exit 64
fi

function verify_ordinary_machine_claim_macho_source_contract() {
    local source_path=$1
    python3 - "$source_path" <<'PY'
from pathlib import Path
import re
import sys

source = Path(sys.argv[1]).read_text(encoding="utf-8")

array_match = re.search(
    r"ordinary_machine_claim_forbidden_symbols=\(\n"
    r"(?P<body>.*?)^\)\n",
    source,
    re.MULTILINE | re.DOTALL,
)
if array_match is None:
    raise SystemExit(
        "ordinary App machine-claim Mach-O symbol allowlist is missing"
    )
observed_symbols = re.findall(
    r"^\s+'([^']+)'\s*$", array_match.group("body"), re.MULTILINE
)
expected_symbols = [
    "StornautLifecycle.LifecycleMachineClaimXPCWire",
    "StornautLifecycle.LifecycleMachineClaimXPCClient.init",
    "StornautLifecycle.LifecycleMachineClaimXPCClient.claim",
    "StornautLifecycle.LifecycleMachineClaimXPCClient.activeConnection",
    "StornautLifecycle.LifecycleMachineClaimXPCClient.serviceName",
    "StornautLifecycle.LifecycleMachineClaimXPCReplyResolver",
    "StornautLifecycle.LifecycleMachineClaimResult",
    "StornautLifecycle.LifecycleMachineClaimXPCError",
    "StornautLifecycle.LifecycleMachineClaimXPCServerNamespace",
]
if observed_symbols != expected_symbols:
    raise SystemExit(
        "ordinary App machine-claim Mach-O symbol allowlist drifted: "
        f"{observed_symbols!r}"
    )

function_match = re.search(
    r"verify_ordinary_machine_claim_main_macho\(\) \{\n"
    r"(?P<body>.*?)^\}\n",
    source,
    re.MULTILINE | re.DOTALL,
)
if function_match is None:
    raise SystemExit(
        "ordinary App machine-claim Mach-O verifier is missing"
    )
body = function_match.group("body")
required_body_fragments = (
    "local executable=$1",
    "local label=$2",
    'local debug_dylib="${executable:h}/${executable:t:r}.debug.dylib"',
    'local main_images=("$executable")',
    'if [[ -e "$debug_dylib" ]]; then',
    'test -f "$debug_dylib"',
    'test ! -L "$debug_dylib"',
    'main_images+=("$debug_dylib")',
    'for marker in "${ordinary_machine_claim_forbidden_symbols[@]}"; do',
    'for image in "${main_images[@]}"; do',
    'if mach_o_has_demangled_symbol "$image" "$marker"; then',
    "Legacy machine-claim authority leaked into ordinary "
    "$label main Mach-O: $marker",
    "symbol_scan_status=$?",
    "if (( symbol_scan_status == 2 )); then",
    "exit 1",
)
missing_body = [marker for marker in required_body_fragments if marker not in body]
if missing_body:
    raise SystemExit(
        "ordinary App machine-claim Mach-O verifier body drifted: "
        f"{missing_body!r}"
    )
if body.count("mach_o_has_demangled_symbol") != 1 or body.count("exit 1") != 2:
    raise SystemExit(
        "ordinary App machine-claim Mach-O verifier cardinality drifted"
    )

normalized_source = " ".join(
    source.replace(chr(92) + chr(10), " " ).split()
)
expected_calls = (
    'verify_ordinary_machine_claim_main_macho '
    '"$debug_app/Contents/MacOS/Stornaut" Debug',
    'verify_ordinary_machine_claim_main_macho '
    '"$release_app/Contents/MacOS/Stornaut" Release',
)
for call in expected_calls:
    if normalized_source.count(call) != 1:
        raise SystemExit(
            "ordinary App machine-claim main-Mach-O call drifted: "
            f"{call!r}"
        )
runtime_source = source[array_match.end():]
normalized_runtime = " ".join(
    runtime_source.replace(chr(92) + chr(10), " " ).split()
)
for forbidden in (
    'verify_ordinary_machine_claim_main_macho "$debug_app" Debug',
    'verify_ordinary_machine_claim_main_macho "$release_app" Release',
    'bundle_mach_o_contains "$debug_app"',
    'bundle_mach_o_contains "$release_app"',
):
    if forbidden in normalized_runtime:
        raise SystemExit(
            "ordinary App machine-claim gate became bundle-recursive: "
            f"{forbidden}"
        )
PY
}

if $legacy_machine_claim_contract_only; then
    verify_ordinary_machine_claim_macho_source_contract \
        "$legacy_machine_claim_contract_source"
    print "Ordinary App machine-claim main-Mach-O contract verification passed."
    exit 0
fi

scripts/verify-contract

mkdir -p "$repo_root/.derivedData"
derived_data=$(
    mktemp -d "$repo_root/.derivedData/app-release-boundaries.XXXXXX"
)
diagnostic_derived_data=$(
    mktemp -d \
        "$repo_root/.derivedData/investigation-diagnostic-boundary.XXXXXX"
)
cleanup() {
    rm -rf "$derived_data" "$diagnostic_derived_data" || true
}
trap cleanup EXIT

for configuration in Debug Release; do
    xcodebuild -quiet \
        -project Stornaut.xcodeproj \
        -scheme Stornaut \
        -configuration "$configuration" \
        -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath "$derived_data" \
        build
done

diagnostic_scheme=StornautInvestigationDiagnosticApp
release_shell_scheme=StornautInvestigationDiagnosticReleaseShell
xcodebuild -quiet \
    -project Stornaut.xcodeproj \
    -scheme "$diagnostic_scheme" \
    -configuration Debug \
    -destination 'platform=macOS,arch=arm64' \
    -derivedDataPath "$diagnostic_derived_data" \
    build
xcodebuild -quiet \
    -project Stornaut.xcodeproj \
    -scheme "$release_shell_scheme" \
    -configuration Release \
    -destination 'platform=macOS,arch=arm64' \
    -derivedDataPath "$diagnostic_derived_data" \
    build

debug_app="$derived_data/Build/Products/Debug/Stornaut.app"
release_app="$derived_data/Build/Products/Release/Stornaut.app"
diagnostic_debug_app="$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app"
diagnostic_release_app="$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"
legacy_diagnostic_release_app="$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnostic.app"
machine_driver_product="$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationMachineDriver"
diagnostic_machine_driver="$diagnostic_debug_app/Contents/MacOS/StornautInvestigationMachineDriver"
machine_driver_max_bytes=$((16 * 1024 * 1024))
authority_object="$derived_data/Build/Products/Debug/StornautExecution.o"
test -x "$debug_app/Contents/MacOS/Stornaut"
test -x "$release_app/Contents/MacOS/Stornaut"
test -x \
    "$diagnostic_debug_app/Contents/MacOS/StornautInvestigationDiagnostic"
test -x \
    "$diagnostic_release_app/Contents/MacOS/StornautInvestigationDiagnosticReleaseShell"
test ! -e "$legacy_diagnostic_release_app"
test ! -L "$legacy_diagnostic_release_app"

bundle_mach_o_contains() {
    local bundle=$1
    local marker=$2
    local candidate

    while IFS= read -r -d '' candidate; do
        if file "$candidate" 2>/dev/null | grep -q 'Mach-O' \
            && rg -a -q --fixed-strings -- "$marker" "$candidate"; then
            return 0
        fi
    done < <(find "$bundle" -path '*/Contents/PlugIns' -prune \
        -o -type f -print0)
    return 1
}

handoff_debug_markers=(
    'StornautInvestigationHandoffContract.'
    'StornautInvestigationMachineClaimXPCWire'
    'InvestigationHandoffAppLeaf'
    'InvestigationHandoffAppLeafEntryPoint'
    'InvestigationHandoffDescriptorAdmission'
)
for marker in "${handoff_debug_markers[@]}"; do
    for forbidden_bundle in \
        "$debug_app" \
        "$release_app" \
        "$diagnostic_release_app"
    do
        if bundle_mach_o_contains "$forbidden_bundle" "$marker"; then
            print -u2 "Handoff contract leaked into an App bundle: $forbidden_bundle: $marker"
            exit 1
        fi
    done
    if ! bundle_mach_o_contains "$diagnostic_debug_app" "$marker"; then
        print -u2 "Investigation handoff Debug marker is missing: $marker"
        exit 1
    fi
done
if ! bundle_mach_o_contains \
    "$diagnostic_release_app" \
    'StornautInvestigationDiagnosticReleaseShell'
then
    print -u2 "Investigation diagnostic Release shell is missing."
    exit 1
fi
release_shell_mach_o_paths=$(
    find "$diagnostic_release_app" -type f -print0 \
        | while IFS= read -r -d '' candidate; do
            if file "$candidate" 2>/dev/null | grep -q 'Mach-O'; then
                print -r -- "${candidate#$diagnostic_release_app/}"
            fi
        done \
        | LC_ALL=C sort
)
if [[ "$release_shell_mach_o_paths" != \
    'Contents/MacOS/StornautInvestigationDiagnosticReleaseShell' ]]
then
    print -u2 "Investigation Release shell Mach-O allowlist drifted."
    exit 1
fi
for forbidden_shell_artifact in \
    StornautInvestigationDiagnostic \
    StornautInvestigationMachineDriver \
    StornautLifecycleHelper
do
    if find "$diagnostic_release_app" -type f \
        -name "$forbidden_shell_artifact" -print -quit | grep -q .
    then
        print -u2 \
            "Investigation Release shell gained artifact: $forbidden_shell_artifact"
        exit 1
    fi
done
if find "$diagnostic_release_app" -type f \
    \( -name '*.a' -o -name '*.o' -o -name '*.bundle' -o -name '*.plugin' \) \
    -print -quit | grep -q .
then
    print -u2 "Investigation Release shell contains a packaged binary."
    exit 1
fi
/usr/bin/codesign --verify --deep --strict "$diagnostic_release_app"
release_shell_link_files=(
    "$diagnostic_derived_data"/Build/Intermediates.noindex/Stornaut.build/Release/StornautInvestigationDiagnosticReleaseShell.build/Objects-normal/arm64/*.LinkFileList(N)
)
if (( ${#release_shell_link_files} != 1 )); then
    print -u2 "Investigation Release shell LinkFileList is not unique."
    exit 1
fi
release_shell_link_entries=(
    "${(@f)$(sed '/^[[:space:]]*$/d' "$release_shell_link_files[1]")}"
)
if (( ${#release_shell_link_entries} != 1 )) \
    || [[ "${release_shell_link_entries[1]:t}" \
        != InvestigationRuntimeDiagnosticHarness.o ]] \
    || [[ "${release_shell_link_entries[1]}" == \
        *'/Build/Products/Release/'* ]]
then
    print -u2 "Investigation Release shell link inputs drifted."
    exit 1
fi

if $handoff_only; then
    xcodebuild -quiet \
        -project Stornaut.xcodeproj \
        -scheme "$diagnostic_scheme" \
        -configuration Debug \
        -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath "$diagnostic_derived_data" \
        -only-testing:StornautInvestigationDiagnosticAppTests \
        test
    print "Investigation handoff App boundary verification passed."
    exit 0
fi
test -f "$authority_object"
file "$authority_object" | grep -q 'Mach-O'
test -x "$debug_app/Contents/MacOS/StornautLifecycleHelper"
test -x "$release_app/Contents/MacOS/StornautLifecycleHelper"
test -x \
    "$diagnostic_debug_app/Contents/MacOS/StornautLifecycleHelper"
for app_without_machine_driver in \
    "$debug_app" \
    "$release_app"
do
    test ! -e \
        "$app_without_machine_driver/Contents/MacOS/StornautInvestigationMachineDriver"
    test ! -L \
        "$app_without_machine_driver/Contents/MacOS/StornautInvestigationMachineDriver"
done
test -f "$machine_driver_product"
test -x "$diagnostic_machine_driver"
test ! -L "$machine_driver_product"
test ! -L "$diagnostic_machine_driver"
diagnostic_mach_o_paths=$(
    find "$diagnostic_debug_app" -type f -print0 \
        | while IFS= read -r -d '' candidate; do
            if file "$candidate" 2>/dev/null | grep -q 'Mach-O'; then
                print -r -- "${candidate#$diagnostic_debug_app/}"
            fi
        done \
        | LC_ALL=C sort
)
expected_diagnostic_mach_o_paths=$'Contents/MacOS/StornautInvestigationDiagnostic\nContents/MacOS/StornautInvestigationDiagnostic.debug.dylib\nContents/MacOS/StornautInvestigationMachineDriver\nContents/MacOS/StornautLifecycleHelper\nContents/MacOS/__preview.dylib'
if [[ "$diagnostic_mach_o_paths" != "$expected_diagnostic_mach_o_paths" ]]; then
    print -u2 "Investigation diagnostic Mach-O allowlist drifted."
    exit 1
fi
if find "$diagnostic_debug_app" -type f \
    \( -name '*.a' -o -name '*.o' -o -name '*.bundle' -o -name '*.plugin' \) \
    -print -quit | grep -q .
then
    print -u2 "Investigation diagnostic contains a prohibited packaged binary."
    exit 1
fi
machine_driver_product_node=$(/usr/bin/stat -f '%d:%i' "$machine_driver_product")
diagnostic_machine_driver_node=$(/usr/bin/stat -f '%d:%i' "$diagnostic_machine_driver")
test "$(/usr/bin/find "$diagnostic_debug_app" -type f \
    -name StornautInvestigationMachineDriver -print | /usr/bin/wc -l | tr -d ' ')" = 1
for machine_driver in "$machine_driver_product" "$diagnostic_machine_driver"; do
    test "$(/usr/bin/stat -f '%HT' "$machine_driver")" = "Regular File"
    test "$(/usr/bin/stat -f '%Lp' "$machine_driver")" = 755
    test "$(/usr/bin/stat -f '%l' "$machine_driver")" = 1
    machine_driver_bytes=$(/usr/bin/stat -f '%z' "$machine_driver")
    (( machine_driver_bytes > 0 && machine_driver_bytes <= machine_driver_max_bytes ))
    test "$(/usr/bin/lipo -archs "$machine_driver")" = arm64
    /usr/bin/codesign --verify --strict "$machine_driver"
done
/usr/bin/codesign --verify --deep --strict "$diagnostic_debug_app"

machine_driver_product_identifier=$(
    /usr/bin/codesign -d --verbose=4 "$machine_driver_product" 2>&1 | /usr/bin/sed -n 's/^Identifier=//p'
)
diagnostic_machine_driver_identifier=$(
    /usr/bin/codesign -d --verbose=4 "$diagnostic_machine_driver" 2>&1 | /usr/bin/sed -n 's/^Identifier=//p'
)
expected_machine_driver_identifier_line="Identifier=com.eriklee.stornaut.investigation.machine-driver"
test "Identifier=$machine_driver_product_identifier" = "$expected_machine_driver_identifier_line"
test "Identifier=$diagnostic_machine_driver_identifier" = "$expected_machine_driver_identifier_line"
machine_driver_product_cdhash=$(
    /usr/bin/codesign -d --verbose=4 "$machine_driver_product" 2>&1 | /usr/bin/sed -n 's/^CDHash=//p'
)
diagnostic_machine_driver_cdhash=$(
    /usr/bin/codesign -d --verbose=4 "$diagnostic_machine_driver" 2>&1 | /usr/bin/sed -n 's/^CDHash=//p'
)
print -r -- "$machine_driver_product_cdhash" | /usr/bin/grep -Eq '^[0-9a-f]{40}([0-9a-f]{24})?$'
test "$diagnostic_machine_driver_cdhash" = "$machine_driver_product_cdhash"
machine_driver_product_requirement=$(
    /usr/bin/codesign -d -r- "$machine_driver_product" 2>&1 | /usr/bin/sed -n 's/^# //p'
)
diagnostic_machine_driver_requirement=$(
    /usr/bin/codesign -d -r- "$diagnostic_machine_driver" 2>&1 | /usr/bin/sed -n 's/^# //p'
)
test "$machine_driver_product_requirement" = "designated => cdhash H\"$machine_driver_product_cdhash\""
test "$diagnostic_machine_driver_requirement" = "$machine_driver_product_requirement"
machine_driver_product_sha256=$(
    /usr/bin/shasum -a 256 "$machine_driver_product" | /usr/bin/awk '{print $1}'
)
diagnostic_machine_driver_sha256=$(
    /usr/bin/shasum -a 256 "$diagnostic_machine_driver" | /usr/bin/awk '{print $1}'
)
print -r -- "$machine_driver_product_sha256" | /usr/bin/grep -Eq '^[0-9a-f]{64}$'
test "$diagnostic_machine_driver_sha256" = "$machine_driver_product_sha256"
test "$diagnostic_machine_driver_identifier" = "$machine_driver_product_identifier"
test "$(/usr/bin/stat -f '%d:%i' "$machine_driver_product")" = \
    "$machine_driver_product_node"
test "$(/usr/bin/stat -f '%d:%i' "$diagnostic_machine_driver")" = \
    "$diagnostic_machine_driver_node"
test ! -e \
    "$debug_app/Contents/Library/LaunchDaemons/com.eriklee.stornaut.lifecycle.plist"
test ! -e \
    "$release_app/Contents/Library/LaunchDaemons/com.eriklee.stornaut.lifecycle.plist"

verify_machine_driver_disposable_matrix() {
    (
        setopt local_options pipe_fail

        local validator="$repo_root/scripts/stornaut-r5-local-lifecycle"
        local authorization="I authorize one bounded disposable read-only Stornaut L3c3b-ii Machine driver validation."
        local temporary_root outside_temporary_root
        local built_app staging_app installed_app identity_mismatch_app
        local acl_mismatch_app
        local outside_built_app outside_staging_app outside_installed_app
        local positive_output

        mkdir -p "$repo_root/.derivedData"
        temporary_root=$(
            mktemp -d \
                "$repo_root/.derivedData/machine-driver-validation.XXXXXX"
        )
        outside_temporary_root=$(
            mktemp -d \
                /private/tmp/stornaut-machine-driver-outside-root.XXXXXX
        )
        cleanup_machine_driver_disposable_matrix() {
            rm -rf -- "$temporary_root" "$outside_temporary_root"
        }
        trap cleanup_machine_driver_disposable_matrix EXIT INT TERM

        built_app="$temporary_root/built.app"
        staging_app="$temporary_root/staging.app"
        installed_app="$temporary_root/installed.app"
        identity_mismatch_app="$temporary_root/identity-mismatch.app"
        acl_mismatch_app="$temporary_root/acl-mismatch.app"
        outside_built_app="$outside_temporary_root/built.app"
        outside_staging_app="$outside_temporary_root/staging.app"
        outside_installed_app="$outside_temporary_root/installed.app"

        for disposable_app in \
            "$built_app" \
            "$staging_app" \
            "$installed_app" \
            "$identity_mismatch_app" \
            "$acl_mismatch_app" \
            "$outside_built_app" \
            "$outside_staging_app" \
            "$outside_installed_app"
        do
            /usr/bin/ditto --noqtn \
                "$diagnostic_debug_app" "$disposable_app"
        done

        # positive: all three disposable planes carry one exact identity.
        positive_output=$(
            "$validator" validate-machine-driver \
                "$authorization" \
                "$temporary_root" \
                "$built_app" \
                "$staging_app" \
                "$installed_app"
        )
        test "$positive_output" = \
            "lifecycle.local.machine-driver-validation=complete"

        # wrong-token: exact authorization text is mandatory.
        if "$validator" validate-machine-driver \
            "wrong-token" \
            "$temporary_root" \
            "$built_app" \
            "$staging_app" \
            "$installed_app" >/dev/null 2>&1
        then
            print -u2 "wrong-token Machine driver validation passed"
            return 1
        fi

        # outside-root: canonical root outside repo .derivedData is rejected.
        if "$validator" validate-machine-driver \
            "$authorization" \
            "$outside_temporary_root" \
            "$outside_built_app" \
            "$outside_staging_app" \
            "$outside_installed_app" >/dev/null 2>&1
        then
            print -u2 "outside-root Machine driver validation passed"
            return 1
        fi

        # duplicate-app: the three validation planes must be distinct.
        if "$validator" validate-machine-driver \
            "$authorization" \
            "$temporary_root" \
            "$built_app" \
            "$built_app" \
            "$installed_app" >/dev/null 2>&1
        then
            print -u2 "duplicate-app Machine driver validation passed"
            return 1
        fi

        /bin/cp -f \
            "$identity_mismatch_app/Contents/MacOS/StornautLifecycleHelper" \
            "$identity_mismatch_app/Contents/MacOS/StornautInvestigationMachineDriver"
        # identity-mismatch: installed plane must equal the built identity.
        if "$validator" validate-machine-driver \
            "$authorization" \
            "$temporary_root" \
            "$built_app" \
            "$staging_app" \
            "$identity_mismatch_app" >/dev/null 2>&1
        then
            print -u2 "identity-mismatch Machine driver validation passed"
            return 1
        fi

        /bin/chmod +a \
            "user:$(/usr/bin/id -un) allow read,write" \
            "$acl_mismatch_app/Contents/MacOS/StornautInvestigationMachineDriver"
        # acl-mismatch: no validation plane may carry an extended ACL.
        if "$validator" validate-machine-driver \
            "$authorization" \
            "$temporary_root" \
            "$built_app" \
            "$staging_app" \
            "$acl_mismatch_app" >/dev/null 2>&1
        then
            print -u2 "acl-mismatch Machine driver validation passed"
            return 1
        fi
    )
}

verify_machine_driver_disposable_matrix

helper_source="StornautLifecycleHelper/main.swift"
rg -q 'func invalidateAndDrain\(\)' "$helper_source"
rg -q 'try self\?\.cancelActive\(\)' "$helper_source"
rg -q 'LifecycleInheritedSessionAdmission\(\)\.validate' "$helper_source"
rg -q 'LifecycleWorkerEvidenceReceipt\.decodeLine' "$helper_source"
rg -q 'paths\.userRootURL' "$helper_source"
rg -q 'POSIX_SPAWN_SETSID' "$helper_source"
rg -q 'getsid\(child\) == child' "$helper_source"
rg -q 'getpgid\(child\) == child' "$helper_source"
rg -q 'crashDescendantReadyLine' "$helper_source"
rg -q 'LifecycleMachineClaimListenerDelegate' "$helper_source"
rg -q 'LifecycleMachineClaimHelperService' "$helper_source"
rg -q 'listener === expectedListener' "$helper_source"
rg -q 'connection.effectiveUserIdentifier == 0' "$helper_source"
rg -q 'machineDriverIdentity: callerIdentity' "$helper_source"
if rg -q 'authorized: true' "$helper_source"; then
    print -u2 "Root helper bypasses fixed Machine driver admission."
    exit 1
fi
if rg -q '"setsid ' "$helper_source"; then
    print -u2 "R5 crash fixture relies on a non-portable setsid command."
    exit 1
fi
python3 - "$helper_source" <<'PY'
import sys

source = open(sys.argv[1], encoding="utf-8").read()
start = source.find("private func prepareDiagnosticDirectories(\n")
end = source.find("\n}\n\nprivate func prepareRootDirectory(", start)
if start < 0 or end < 0:
    raise SystemExit("missing closed R5 diagnostic-directory preparation")
body = source[start:end]
required = [
    "paths.userRootURL",
    "ownerUserID: 0",
    "ownerGroupID: 0",
    "mode: 0o711",
    "paths.rootURL",
    "ownerUserID: identity.userID",
    "ownerGroupID: identity.groupID",
    "mode: 0o700",
    "mustCreate: true",
]
if not all(value in body for value in required):
    raise SystemExit("R5 diagnostic directory ownership boundary is incomplete")
PY

lifecycle_script="scripts/stornaut-r5-local-lifecycle"
diagnostic_script="scripts/verify-codex-runtime-diagnostic"
gate_script="scripts/verify-codex-runtime-gate"
python3 - "$lifecycle_script" <<'PY'
import sys

source = open(sys.argv[1], encoding="utf-8").read()

def function_body(name, next_marker):
    start = source.find(f"{name}() {{\n")
    end = source.find(next_marker, start)
    if start < 0 or end < 0:
        raise SystemExit(f"missing closed R5 {name} function")
    return source[start:end]

recovery_body = function_body(
    "recover_runtime_roots_after_bootout",
    "\n}\n\nrollback_failed_lifecycle() {",
)
uninstall_body = function_body(
    "uninstall",
    "\n}\n\ncase \"$action\" in",
)
recovery_call = uninstall_body.find("recover_runtime_roots_after_bootout")
early_validation = uninstall_body.find("validate_runtime_roots_drained")
if recovery_call < 0:
    raise SystemExit("R5 uninstall omits stale-runtime recovery")
if 0 <= early_validation < recovery_call:
    raise SystemExit(
        "R5 uninstall refuses stale runtime roots before attempting recovery"
    )
ordered_recovery_steps = [
    "runtime_roots_are_drained && return",
    '/bin/launchctl bootstrap system "$installed_plist"',
    '/bin/launchctl kickstart "system/$label"',
    '/bin/launchctl bootout "system/$label"',
]
positions = [recovery_body.find(step) for step in ordered_recovery_steps]
if any(position < 0 for position in positions) or positions != sorted(positions):
    raise SystemExit("R5 stale-runtime recovery sequence is incomplete")
if recovery_body.rfind("validate_runtime_roots_drained") <= positions[-1]:
    raise SystemExit("R5 stale-runtime recovery lacks final drained validation")

bundle_validation = function_body(
    "validate_bundle_permissions",
    "\n}\n\nvalidate_installed_state() {",
)
if '/usr/bin/find "$app" -type f -print0' in bundle_validation:
    raise SystemExit(
        "R5 bundle validation checks file owners but skips directory owners"
    )
required_bundle_checks = [
    '/usr/bin/find "$app" -print0',
    '"$owner" == root',
    '"$group" == wheel',
    '"$file_type" == "Directory"',
    '"$file_type" == "Regular File"',
    '"$links" == 1',
]
if not all(check in bundle_validation for check in required_bundle_checks):
    raise SystemExit("R5 bundle ownership/type validation is incomplete")

artifact_validation = function_body(
    "validate_installed_artifacts",
    "\n}\n\nvalidate_installed_state() {",
)
required_artifact_checks = [
    'exact_directory_metadata "$installed_app" root wheel 0755',
    'exact_file_metadata "$installed_plist" root wheel 0644',
    'validate_plist "$installed_plist"',
    '/usr/bin/cmp -s "$source_plist" "$installed_plist"',
    '/usr/bin/codesign --verify --deep --strict "$installed_app"',
    'validate_bundle_permissions "$installed_app"',
    '"$installed_app/Contents/MacOS/StornautInvestigationDiagnostic"',
    '"$installed_app/Contents/MacOS/StornautLifecycleHelper"',
    '"$installed_app/Contents/MacOS/StornautInvestigationMachineDriver"',
    'validate_machine_driver_artifact',
    '[[ -n "$installed_machine_driver_identity" ]]',
]
if not all(check in artifact_validation for check in required_artifact_checks):
    raise SystemExit("R5 installed artifact validation is incomplete")
if "validate_built_app" in artifact_validation or ".derivedData" in artifact_validation:
    raise SystemExit(
        "installed Machine driver validation depends on a local build"
    )
installed_state_body = function_body(
    "validate_installed_state",
    "\n}\n\nvalidate_runtime_roots_drained() {",
)
if 'validate_installed_artifacts "$expected_machine_driver_identity"' \
        not in installed_state_body:
    raise SystemExit(
        "installed state does not preserve optional transaction identity"
    )
artifact_call = recovery_body.find("validate_installed_artifacts")
bootstrap = recovery_body.find(
    '/bin/launchctl bootstrap system "$installed_plist"'
)
if artifact_call < 0 or artifact_call > bootstrap:
    raise SystemExit("R5 recovery bootstraps before validating installed artifacts")
uninstall_artifact_call = uninstall_body.find("validate_installed_artifacts")
uninstall_bootout = uninstall_body.find(
    '/bin/launchctl bootout "system/$label"'
)
if uninstall_artifact_call < 0 or uninstall_artifact_call > uninstall_bootout:
    raise SystemExit("R5 uninstall acts before validating installed artifacts")
for context, body in (
    ("recovery", recovery_body),
    ("uninstall", uninstall_body),
):
    if not any(
        line.strip() == "validate_installed_artifacts"
        for line in body.splitlines()
    ):
        raise SystemExit(
            f"R5 {context} no longer validates installed identity independently"
        )
status_body = function_body("status", "\n}\n\ninstall() {")
if "validate_installed_state >/dev/null 2>&1" not in status_body:
    raise SystemExit(
        "R5 status no longer validates fixed installed identity"
    )
runtime_removal = uninstall_body.find('/bin/rmdir -- "$diagnostic_root"')
installed_root_removal = uninstall_body.find('/bin/rmdir -- "$installed_root"')
if (
    runtime_removal < 0
    or installed_root_removal < 0
    or runtime_removal > installed_root_removal
):
    raise SystemExit("R5 uninstall removes the runtime parent too early")
PY

