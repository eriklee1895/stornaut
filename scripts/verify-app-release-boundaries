verify_iib5biii_b2a_iia2ii_macho() {
    local marker closed_image scan_status
    for marker in "${iib5biii_b2a_iia2ii_debug_symbols[@]}"; do
        if mach_o_image_has_demangled_symbol \
            "$diagnostic_machine_driver" "$marker"
        then
            :
        else
            scan_status=$?
            (( scan_status != 2 )) || return 1
            print -u2 \
                "iii-b2a-ii-a2-ii Debug Machine driver positive control is missing: $marker"
            return 1
        fi
        for closed_image in "${iib5biii_b2a_iia2ii_closed_images[@]}"; do
            if mach_o_image_has_demangled_symbol "$closed_image" "$marker"; then
                print -u2 \
                    "iii-b2a-ii-a2-ii DEBUG symbol leaked into a closed image: $closed_image: $marker"
                return 1
            else
                scan_status=$?
            fi
            (( scan_status != 2 )) || return 1
        done
    done
    for marker in "${iib5biii_b2a_iia2ii_debug_imports[@]}"; do
        print -r -- "$machine_driver_undefined_symbols" \
            | grep -Fxq -- "$marker" || {
            print -u2 "iii-b2a-ii-a2-ii Debug import is missing: $marker"
            return 1
        }
        if print -r -- "$release_machine_driver_undefined_symbols" \
            | grep -Fxq -- "$marker"
        then
            print -u2 \
                "iii-b2a-ii-a2-ii DEBUG import leaked into Release: $marker"
            return 1
        fi
    done
}
