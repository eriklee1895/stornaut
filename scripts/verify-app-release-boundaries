    done
    python3 - "$observer_path" "$session_path" "$composition_path" \
        "$repo_root/scripts/verify-app-release-boundaries" <<'PY'
from pathlib import Path
import re
import sys

observer_path, session_path, composition_path, verifier_path = map(
    Path, sys.argv[1:]
)
repo_root = verifier_path.parent.parent.resolve()
expected = {
    observer_path:
        repo_root
        / "Sources/StornautInvestigationMachineDriverSupport"
        / "InvestigationMachineDarwinDriverChildObservation.swift",
    session_path:
        repo_root
        / "Sources/StornautInvestigationMachineDriverSupport"
        / "InvestigationMachineDarwinOuterInnerSession.swift",
    composition_path:
        repo_root
