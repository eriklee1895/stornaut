function require_projection() {
    local value=$1 expected_sha=$2 expected_lines=$3 label=$4
    local observed_sha observed_lines
    observed_sha=$(print -rn -- "$value" | shasum -a 256 | awk '{print $1}')
    observed_lines=$(print -r -- "$value" | awk 'END {print NR}')
    if [[ "$observed_sha" != "$expected_sha" \
        || "$observed_lines" != "$expected_lines" ]]
    then
        print -u2 "Machine driver $label projection drifted."
        exit 1
    fi
}
require_projection \
    "$machine_driver_undefined_symbols" \
    d9ede342877a7c2bae9edb3cc6795b0284ed69d43b251a4ea8f55a99c3b27b61 \
    336 \
    undefined
require_projection \
    "$machine_driver_loaded_libraries" \
    e3c05d8766d8aa37e87a834a3f37fd71d925f1d34ac349528cee4970db9d3841 \
    16 \
    load-command
require_projection \
    "$machine_driver_owned_symbols" \
    d1ba2a7e19f07e2ebee198bb603fe516d3eee9148460563ebf3e6b6aa9eaf2f7 \
    637 \
    owned-symbol
if ! mach_o_has_demangled_symbol \
