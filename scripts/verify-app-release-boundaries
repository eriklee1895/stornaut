def shell_array(name):
    match = re.search(
        rf"(?ms)^{re.escape(name)}=\(\n(?P<body>.*?)^\)\n", verifier
    )
    if match is None:
        raise SystemExit(f"iii-b2b-0 Mach-O array missing: {name}")
    values = []
    for line in match.group("body").splitlines():
        value = line.strip()
        quoted = re.fullmatch(r"(['\"])(.*?)\1", value)
        if quoted is None:
            raise SystemExit(f"iii-b2b-0 Mach-O array malformed: {name}")
        values.append(quoted.group(2))
    return values

