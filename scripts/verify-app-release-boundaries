        'claimMachineRetirement:withReply:' \
        'releaseMachineRetirement:withReply:'
    do
        if mach_o_image_has_raw_string \
            "$claim_server_handoff_negative_image" \
            "$claim_server_handoff_marker"
        then
            print -u2 \
                "non-helper claim-server Mach-O leakage: $claim_server_handoff_negative_image: $claim_server_handoff_marker"
            exit 1
        else
            scan_status=$?
        fi
        if (( scan_status == 2 )); then
            exit 1
        fi
    done
done

