            buildForArchiving = "NO"
            buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "A00000000000000000000004"
               BuildableName = "StornautLifecycleHelper"
               BlueprintName = "StornautLifecycleHelper"
               ReferencedContainer = "container:Stornaut.xcodeproj">
            </BuildableReference>
         </BuildActionEntry>
"""
