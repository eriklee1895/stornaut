function verify_iib5biii_b2b1a0_source_contract() {
    local composition_path=$1 bridge_path=$2 source_path
    for source_path in "$composition_path" "$bridge_path"; do
        xcrun swiftc -frontend -parse "$source_path"
    done
    python3 - "$composition_path" "$bridge_path" \
        "$repo_root/scripts/verify-app-release-boundaries" <<'PY'
from pathlib import Path
import re
import subprocess
import sys

composition_path, bridge_path, verifier_path = map(Path, sys.argv[1:])
repo_root = verifier_path.parent.parent.resolve()
expected = {
    composition_path:
        repo_root
        / "Sources/StornautInvestigationMachineDriverSupport"
        / "InvestigationMachineSingleEpochComposition.swift",
    bridge_path:
        repo_root
        / "Sources/StornautInvestigationMachineDriverSupport"
        / "InvestigationMachineSingleEpochPhysicalBridge.swift",
}
for path, canonical in expected.items():
    if path.resolve() != canonical.resolve():
        raise SystemExit(f"iii-b2b-1a-0 source path drifted: {path}")

composition = composition_path.read_text(encoding="utf-8")
bridge = bridge_path.read_text(encoding="utf-8")
for path, source in ((composition_path, composition), (bridge_path, bridge)):
    if "#if DEBUG" in source:
        raise SystemExit(
            f"iii-b2b-1a-0 source became Debug-gated: {path}"
        )

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

def swift_code_only(source):
    output = list(source)
    index = 0
    block_depth = 0
    string_end = None
    raw_hashes = ""
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if string_end is not None:
            if source.startswith(string_end, index):
                width = len(string_end)
                output[index:index + width] = " " * width
                index += width
                string_end = None
                raw_hashes = ""
            elif not raw_hashes and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source) and source[index + 1] != "\n":
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        else:
            opener = re.match(r'(#+)?("""|")', source[index:])
            if opener is None:
                index += 1
                continue
            hashes = opener.group(1) or ""
            quote = opener.group(2)
            width = len(opener.group(0))
            output[index:index + width] = " " * width
            string_end = quote + hashes
            raw_hashes = hashes
            index += width
    if block_depth or string_end is not None:
        raise SystemExit("iii-b2b-1a-0 Swift lexical scan drifted")
    return "".join(output)

def swift_parse_tree(path):
    completed = subprocess.run(
        ["xcrun", "swiftc", "-frontend", "-dump-parse", str(path)],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    if completed.returncode != 0:
        raise SystemExit("iii-b2b-1a-0 Swift lexical scan drifted")
    return completed.stdout

composition_code = swift_code_only(composition)
bridge_code = swift_code_only(bridge)

if imports(composition_code) != {
    "Foundation", "StornautInvestigationHandoffContract",
    "StornautInvestigationInstalledL2",
}:
    raise SystemExit("iii-b2b-1a-0 composition import surface drifted")
if imports(bridge_code) != {
    "Foundation", "StornautInvestigationHandoffContract",
}:
    raise SystemExit("iii-b2b-1a-0 bridge import surface drifted")

semantic = composition_code + "\n" + bridge_code
if re.search(r"(?m)^\s*(?:public|open)\s+", semantic):
    raise SystemExit("iii-b2b-1a-0 public surface drifted")
if re.search(r"\b(?:Codable|Encodable|Decodable)\b", semantic):
    raise SystemExit("iii-b2b-1a-0 Codable surface drifted")
if re.search(
    r"(?m)^\s*package\s+(?:let|var)\s+claimEvidence\b", semantic
):
    raise SystemExit("iii-b2b-1a-0 claim evidence escaped the module")
for forbidden in (
    r"\bStornaut(?:Execution|Core|Lifecycle|Codex|InvestigationRuntime|"
    r"InvestigationDiagnostic|ProbeBridge|ProcessSupport)\b",
    r"\b(?:Executor|MoveToTrash|RegisteredAction|signedRuntimeReady|"
    r"signedInvestigationRuntimeReady|readiness)\b",
):
    if re.search(forbidden, semantic, re.IGNORECASE):
        raise SystemExit(
            "iii-b2b-1a-0 source gained physical or product authority"
        )
physical_authority_symbols = (
    "Darwin", "Glibc", "AppKit", "SwiftUI", "NSXPCConnection",
    "NSXPCListener", "URLSession", "NWConnection", "Process",
    "FileManager", "FileHandle", "CommandLine", "ProcessInfo",
    "readLine",
)
physical_authority_calls = (
    "posix_spawn", "fork", "execve", "open",
    "openat", "write", "pwrite", "socket", "connect", "send",
    "recv", "kill", "killpg", "waitpid", "waitid",
)
physical_authority_reference = re.compile(
    r'(?:name|id|field)="(?:'
    + "|".join(map(re.escape, physical_authority_symbols))
    + r')"'
)
physical_authority_call = re.compile(
    r'\((?:unresolved_decl_ref_expr|unresolved_dot_expr)[^\n]*'
    r'(?:name|field)="(?:'
    + "|".join(map(re.escape, physical_authority_calls))
    + r')"[^\n]*function_ref='
)
for path in (composition_path, bridge_path):
    parse_tree = swift_parse_tree(path)
    if (
        physical_authority_reference.search(parse_tree)
        or physical_authority_call.search(parse_tree)
    ):
        raise SystemExit(
            "iii-b2b-1a-0 authority or product reachability drifted"
        )

composition_required = (
    "let configurationNonce: UUID",
    "let claimEvidence: InvestigationMachineClaimEvidence",
    "claimEvidence.l1Residue.investigationUUID",
    "== epoch.configurationNonce",
    "claimEvidence.l1Residue.auditSessionID",
    "== claimEvidence.helperIdentity.auditSessionID",
    "claimEvidence.l1Residue.userID == appIdentity.effectiveUserID",
    "claimEvidence.l1Residue.remainingAuditSessionMembers == 0",
    "claimEvidence.l1Residue.matchingLeases == 0",
    "claimEvidence.l1Residue.leaseRootEntries == 0",
    "claimEvidence.l1Residue.investigationArtifacts == 0",
    "let claimEvidenceBytes = try claimEvidence.encoded()",
    "claimEvidenceBytes,",
    "self.claimEvidence = claimEvidence",
)
bridge_required = (
    "package static let maximumOwnershipByteCount = 32 * 1_024",
    "let claimEvidence: InvestigationMachineClaimEvidence",
    "try claimEvidence.encoded(),",
    "1...InvestigationMachineClaimEvidence.maximumByteCount",
    "claimEvidence: try InvestigationMachineClaimEvidence",
    ".decode(fields[9])",
    "try value.claimEvidence.encoded() == fields[9]",
    "claimEvidenceSHA256: try bridgeDigest(fields[10])",
    "installedL2ProofSHA256: try bridgeDigest(fields[11])",
    "releaseDeadlineNanoseconds: try bridgeUInt64(fields[12])",
    "epochDeadlineNanoseconds: try bridgeUInt64(fields[13])",
    "bindingSHA256: try bridgeDigest(fields[14])",
    "bridgeClaimEvidenceIsBound(",
    "claimEvidenceSHA256",
    "== .hashing(claimEvidenceBytes)",
    "evidence.l1Residue.investigationUUID == selectionNonce",
    "evidence.l1Residue.auditSessionID == helperIdentity.auditSessionID",
    "evidence.l1Residue.userID == appIdentity.effectiveUserID",
    "evidence.l1Residue.remainingAuditSessionMembers == 0",
    "evidence.l1Residue.matchingLeases == 0",
    "evidence.l1Residue.leaseRootEntries == 0",
    "evidence.l1Residue.investigationArtifacts == 0",
    "evidence.releaseDeadlineNanoseconds == releaseDeadlineNanoseconds",
)
for marker in composition_required:
    if marker not in composition:
        raise SystemExit(
            f"iii-b2b-1a-0 composition linkage drifted: {marker}"
        )
for marker in bridge_required:
    if marker not in bridge:
        raise SystemExit(
            f"iii-b2b-1a-0 bridge linkage drifted: {marker}"
        )
if bridge.count("bridgeClaimEvidenceIsBound(") != 4:
    raise SystemExit("iii-b2b-1a-0 provenance join cardinality drifted")
compact_bridge = re.sub(r"\s+", "", bridge)
ownership_shape = (
    "expectedBusinessFieldByteCounts:[16...16,32...32,32...32,"
    "16...16,4...4,4...4,32...32,"
    "1...InvestigationMachineProcessIdentity.maximumByteCount,"
    "1...InvestigationMachineProcessIdentity.maximumByteCount,"
    "1...InvestigationMachineClaimEvidence.maximumByteCount,"
    "32...32,32...32,8...8,8...8,32...32,]"
)
if compact_bridge.count(ownership_shape) != 1:
    raise SystemExit("iii-b2b-1a-0 15-field ownership wire drifted")
PY
}

