verify_iib4_machine_claim_macho() {
    local positive_image marker scan_status

    for positive_image in "${iib4_machine_claim_positive_images[@]}"; do
        for marker in "${iib4_machine_claim_positive_symbols[@]}"; do
            if mach_o_image_has_demangled_symbol "$positive_image" "$marker"; then
                continue
            else
                scan_status=$?
            fi
            if (( scan_status == 2 )); then
                exit 1
            fi
            print -u2 \
                "ii-b4 machine-claim Mach-O positive drifted: $positive_image: $marker"
            exit 1
        done
        for marker in "${iib4_machine_claim_positive_raw_markers[@]}"; do
            if mach_o_image_has_raw_string "$positive_image" "$marker"; then
                continue
            else
                scan_status=$?
            fi
            if (( scan_status == 2 )); then
                exit 1
            fi
            print -u2 \
                "ii-b4 machine-claim raw marker positive drifted: $positive_image: $marker"
            exit 1
        done
    done
    for marker in "${iib4_machine_claim_required_security_imports[@]}"; do
        if ! print -r -- "$machine_driver_undefined_symbols" \
            | grep -Fxq -- "$marker"
        then
            print -u2 "ii-b4 machine-claim import positive drifted: $marker"
            exit 1
        fi
    done
    for closed_image in "${iib4_machine_claim_closed_images[@]}"; do
        for marker in \
            'StornautInvestigationMachineDriverSupport.InvestigationMachineClaimClient' \
            'InvestigationMachineClaimClientConnectionEpoch' \
            'InvestigationMachineClaimClientReplyResolver'
        do
            if mach_o_image_has_demangled_symbol "$closed_image" "$marker"; then
                print -u2 \
                    "ii-b4 machine-claim leaked into a closed image: $closed_image: $marker"
                exit 1
            else
                scan_status=$?
            fi
            if (( scan_status == 2 )); then
                exit 1
            fi
        done
    done
}
