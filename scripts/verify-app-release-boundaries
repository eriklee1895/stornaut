function verify_iicb1_root_owned_gate_component_boundary() (
    local snapshot_container=${repo_root:h}
    local expected_owner_mode git_common forbidden_name
    expected_owner_mode="$(/usr/bin/id -u):700"
    [[ ${repo_root:h:h} == /private/tmp \
        && ${snapshot_container:t} == stornaut-iicb1-independent.* \
        && ${repo_root:t} == repository \
        && $HOME == "$snapshot_container/build/home" \
        && $TMPDIR == "$snapshot_container/build/tmp" \
        && -d $snapshot_container && ! -L $snapshot_container \
        && -d $repo_root && ! -L $repo_root \
        && -d $HOME && ! -L $HOME \
        && -d $TMPDIR && ! -L $TMPDIR \
        && -d $repo_root/.git && ! -L $repo_root/.git \
        && $(/usr/bin/stat -f '%u:%Lp' "$snapshot_container") \
            == $expected_owner_mode \
        && $(/usr/bin/stat -f '%u:%Lp' "$repo_root") \
            == $expected_owner_mode \
        && $(/usr/bin/stat -f '%u:%Lp' "$HOME") \
            == $expected_owner_mode \
        && $(/usr/bin/stat -f '%u:%Lp' "$TMPDIR") \
            == $expected_owner_mode ]] || {
        print -u2 "ii-c-b1 independent snapshot invocation rejected"
        return 1
    }
    git_common=$(cd "$(/usr/bin/git rev-parse --git-common-dir)" && pwd -P) \
        || return $?
    [[ $git_common == "$repo_root/.git" \
        && ! -e $repo_root/.git/objects/info/alternates \
        && $PATH == /usr/bin:/bin:/usr/sbin:/sbin \
        && $DEVELOPER_DIR == /Applications/Xcode.app/Contents/Developer ]] || {
        print -u2 "ii-c-b1 independent snapshot invocation rejected"
        return 1
    }
    for forbidden_name in XBS_DISABLE_SANDBOXED_BUILDS SWIFTPM_SANDBOX \
        IDEPackageSupportDisableManifestSandbox \
        IDEPackageSupportDisablePluginExecutionSandbox OTHER_SWIFT_FLAGS \
        SWIFT_EXEC TOOLCHAINS SDKROOT XCODE_XCCONFIG_FILE
    do
        [[ -z ${parameters[$forbidden_name]:-} ]] || {
            print -u2 "ii-c-b1 independent snapshot invocation rejected"
            return 1
        }
    done
    verify_iicb1_root_owned_gate_component_source_contract \
        "$repo_root/scripts/verify-app-release-boundaries" || return $?
    local validation_commit=${STORNAUT_VALIDATION_COMMIT:-}
    local validation_source=${STORNAUT_VALIDATION_SOURCE:-}
    [[ ${#validation_commit} == 40 \
        && $validation_commit != *[^0-9a-f]* \
        && $validation_source == staged ]] || {
        print -u2 "ii-c-b1 validation snapshot provenance unavailable"
        return 1
    }
    local observed_commit validation_tree repository_status
    observed_commit=$(/usr/bin/git rev-parse --verify 'HEAD^{commit}' 2>/dev/null) \
        || return $?
    [[ $observed_commit == $validation_commit ]] || {
        print -u2 "ii-c-b1 validation snapshot provenance unavailable"
        return 1
    }
    validation_tree=$(/usr/bin/git rev-parse --verify \
        "$validation_commit^{tree}" 2>/dev/null) || return $?
    repository_status=$(/usr/bin/git status --porcelain=v1 \
        --untracked-files=all) || return $?
    [[ -z $repository_status ]] || {
        print -u2 "ii-c-b1 validation snapshot provenance unavailable"
        return 1
    }
    readonly validation_commit validation_source observed_commit \
        validation_tree repository_status

    local scratch product_derived_data diagnostic_derived_data
    local validation_user=$(/usr/bin/id -un)
    local -a validation_xcodebuild=(
        /usr/bin/env -i
        HOME="$HOME"
        USER="$validation_user"
        LOGNAME="$validation_user"
        PATH=/usr/bin:/bin:/usr/sbin:/sbin
        LC_ALL=C
        LANG=C
        TMPDIR="$TMPDIR"
        DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
        STORNAUT_VALIDATION_COMMIT="$validation_commit"
        STORNAUT_VALIDATION_SOURCE=staged
        /usr/bin/xcodebuild
        "STORNAUT_VALIDATION_COMMIT=$validation_commit"
    )
    scratch=$(mktemp -d \
        "${TMPDIR:-/tmp}/stornaut-iicb1-component.XXXXXX") || return $?
    trap 'rm -rf "$scratch"' EXIT
    product_derived_data="$scratch/product"
    diagnostic_derived_data="$scratch/diagnostic"
    local configuration scheme
    for configuration in Debug Release; do
        "${validation_xcodebuild[@]}" -quiet \
            -project Stornaut.xcodeproj -scheme Stornaut \
            -configuration "$configuration" \
            -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$product_derived_data" build || return $?
    done
    "${validation_xcodebuild[@]}" -quiet \
        -project Stornaut.xcodeproj \
        -scheme StornautInvestigationDiagnosticApp -configuration Debug \
        -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath "$diagnostic_derived_data" build || return $?
    "${validation_xcodebuild[@]}" -quiet \
        -project Stornaut.xcodeproj \
        -scheme StornautInvestigationDiagnosticReleaseShell \
        -configuration Release -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath "$diagnostic_derived_data" build || return $?
    for scheme in StornautInvestigationMachineDriverNative \
        StornautInvestigationMachineGateNative \
        StornautInvestigationMachineGateCoordinatorNative
    do
        "${validation_xcodebuild[@]}" -quiet \
            -project Stornaut.xcodeproj -scheme "$scheme" \
            -configuration Release -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$diagnostic_derived_data" build || return $?
    done

    local coordinator="$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app/Contents/MacOS/StornautInvestigationMachineGateCoordinator"
    [[ -f $coordinator && ! -L $coordinator ]] \
        || { print -u2 "ii-c-b1 diagnostic Coordinator is unavailable"; return 1; }
    file "$coordinator" | grep -q 'Mach-O' \
        || { print -u2 "ii-c-b1 diagnostic Coordinator is not Mach-O"; return 1; }
    local symbols strings marker
    symbols=$(xcrun nm -j "$coordinator" 2>/dev/null \
        | xcrun swift-demangle 2>/dev/null) || return $?
    strings=$(xcrun strings -a "$coordinator" 2>/dev/null) || return $?
    for marker in \
        'StornautInvestigationMachineLaunchSupport.InvestigationFixedGateDarwinLifecycle.(validateExecutable' \
        'StornautInvestigationMachineGateSupport.InvestigationMachineFixedGateContract.requiredUserID' \
        'StornautInvestigationMachineGateSupport.InvestigationMachineFixedGateContract.requiredGroupID'
    do
        [[ "$symbols" == *"$marker"* ]] || {
            print -u2 "ii-c-b1 diagnostic Coordinator missing current Gate contract: $marker"
            return 1
        }
    done
    for marker in \
        "$validation_commit" \
        "$validation_tree" \
        'stornaut.task39.machine.build-provenance.v1' \
        'StornautInvestigationMachineGateCoordinatorSupport' \
        'StornautInvestigationMachineGateCoordinator'
    do
        /usr/bin/grep -Fqx -- "$marker" <<<"$strings" || {
            print -u2 \
                "ii-c-b1 diagnostic Coordinator build provenance drifted: $marker"
            return 1
        }
    done
    verify_iica_component_boundary \
        "$product_derived_data" "$diagnostic_derived_data" || return $?
    [[ "$symbols$strings" != *'StornautExecution.'* ]] || {
        print -u2 "ii-c-b1 diagnostic Coordinator gained execution authority"
        return 1
    }

    local -a negative_images=(
        "$product_derived_data/Build/Products/Debug/Stornaut.app"
        "$product_derived_data/Build/Products/Release/Stornaut.app"
        "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"
    )
    local image inventory candidate kind combined symlink
    for image in "${negative_images[@]}"; do
        [[ -d $image && ! -L $image ]] || {
            print -u2 "ii-c-b1 closed image is unavailable: $image"
            return 1
        }
        symlink=$(find "$image" -type l -print -quit) || return $?
        [[ -z $symlink ]] || {
            print -u2 "ii-c-b1 closed image contains symlink: $symlink"
            return 1
        }
        inventory="$scratch/negative-${image:t}.inventory"
        find "$image" -type f -print0 >"$inventory" || return $?
        while IFS= read -r -d '' candidate; do
            kind=$(file "$candidate" 2>/dev/null) || return $?
            [[ $kind == *Mach-O* ]] || continue
            symbols=$(xcrun nm -j "$candidate" 2>/dev/null \
                | xcrun swift-demangle 2>/dev/null) || return $?
            strings=$(xcrun strings -a "$candidate" 2>/dev/null) || return $?
            combined="$symbols$strings"
            for marker in \
                'StornautInvestigationMachineLaunchSupport.' \
                'InvestigationFixedGateDarwinLifecycle'
            do
                [[ "$combined" != *"$marker"* ]] || {
                    print -u2 \
                        "ii-c-b1 Gate lifecycle leaked into closed image: $candidate"
                    return 1
                }
            done
        done <"$inventory"
    done
)

function run_iicb2a2_component_snapshot() (
    run_iicb1_root_owned_gate_component_snapshot b2a2
)

function verify_iicb2a2_component_source_contract() {
    local PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local source=${1:-${ZSH_SCRIPT:A}}
    [[ -f $source && ! -L $source ]] || {
        print -u2 "ii-c-b2a2 component source unavailable"; return 1
    }
    /usr/bin/python3 -I - "$source" <<'PY'
from pathlib import Path
import hashlib
import re
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
critical_names = ("run_iicb2a2_component_snapshot",
                  "verify_iicb2a2_component_source_contract",
                  "verify_iicb2a2_component_boundary",
                  "verify_iicb2a2_negative_macho",
                  "verify_iica_component_boundary")
for name in critical_names:
    pattern = (r"(?m)^\s*(?:function\s+NAME(?:\s*\(\s*\))?|"
               r"NAME\s*\(\s*\))(?=\s|[({])").replace(
                   "NAME", re.escape(name))
    if len(re.findall(pattern, source)) != 1:
        raise SystemExit("ii-c-b2a2 component verifier contract drifted")
for pattern in (r"(?m)^\s*function\s+\$", r"(?m)^\s*functions\[",
                r"(?m)^\s*eval\b", r"(?m)^\s*alias\b"):
    if re.search(pattern, source):
        raise SystemExit("ii-c-b2a2 component verifier contract drifted")
snapshot_start = source.index(
    "\nfunction run_iicb2a2_component_snapshot() ("
) + 1
source_contract_start = source.index(
    "\nfunction verify_iicb2a2_component_source_contract() {", snapshot_start
) + 1
boundary_start = source.index(
    "\nfunction verify_iicb2a2_component_boundary() (", source_contract_start
) + 1
scanner_start = source.index(
    "\nfunction verify_iicb2a2_negative_macho() {", boundary_start
) + 1
runtime_end = source.index(
    "\nfunction verify_iib5biii_a_source_contract() {", scanner_start
) + 1
iica_start = source.index("\nfunction verify_iica_component_boundary() (") + 1
iica_end = source.index(
    "\nfunction run_iicb1_root_owned_gate_component_snapshot() (", iica_start
) + 1
if hashlib.sha256(source[iica_start:iica_end].encode()).hexdigest() != (
    "0b307a0accf57a2946eeacabfd0a7ec6030b4397a5af296c978f491fd089e2f0"
):
    raise SystemExit("ii-c-b2a2 component verifier contract drifted")
expected_snapshot = """function run_iicb2a2_component_snapshot() (
    run_iicb1_root_owned_gate_component_snapshot b2a2
)

"""
if source[snapshot_start:source_contract_start] != expected_snapshot:
    raise SystemExit("ii-c-b2a2 component verifier contract drifted")
source_contract_sha = "8f0906db08c60a0bbd1ef4c28de02302eaede0dc7fc0d9b8903b13868daa3e7f"
source_contract = source[source_contract_start:boundary_start]
if (source_contract.count(source_contract_sha) != 1
        or hashlib.sha256(source_contract.replace(
            source_contract_sha, "SELF").encode()).hexdigest()
        != source_contract_sha):
    raise SystemExit("ii-c-b2a2 component verifier contract drifted")
runtime = source[boundary_start:runtime_end]
runtime_sha = "9327736b82d725a19f5c33ac5427b60195a83967d41cd8c8a764fa3789c5abd1"
if hashlib.sha256(runtime.encode()).hexdigest() != runtime_sha:
    raise SystemExit("ii-c-b2a2 component verifier contract drifted")
prologue = ("function verify_iicb2a2_component_boundary() (\n"
            + "    local PATH=/usr/bin:/bin:/usr/sbin:/sbin\n"
            + "    [[ ${STORNAUT_VALIDATION_SOURCE:-} == staged")
if source.count(prologue) != 1:
    raise SystemExit("ii-c-b2a2 component verifier contract drifted")
boundary = source[boundary_start:scanner_start]
scanner = source[scanner_start:runtime_end]
scanner_prologue = ("function verify_iicb2a2_negative_macho() {\n"
                    + "    local PATH=/usr/bin:/bin:/usr/sbin:/sbin\n"
                    + "    local candidate=$1 kind symbols strings combined marker")
if scanner.count(scanner_prologue) != 1 or scanner.count(
        "[[ $kind == *Mach-O* ]] || return 0") != 1:
    raise SystemExit("ii-c-b2a2 component verifier contract drifted")
if scanner.count("return 0") != 1:
    raise SystemExit("ii-c-b2a2 component verifier contract drifted")
if boundary.count("verify_iicb2a2_negative_macho \"$candidate\" || return $?") != 1:
    raise SystemExit("ii-c-b2a2 component verifier contract drifted")
for marker in (
    "run_iicb1_root_owned_gate_component_snapshot b2a2",
    "--iic-b2a2-component-boundary-internal",
    "--iic-evidence-verification-component-boundary-only",
    "--iic-evidence-verification-staged-scope-contract-only",
    "run_iicb1_root_owned_gate_component_snapshot evidence",
    "StornautInvestigationMachineCampaignSupport.build",
    "InvestigationMachineRawEvidenceWriter",
    "stornaut.task39.iic.raw-evidence-manifest.v1",
    "ii-c-b2a2 campaign namespace leaked into closed image",
    "verify_iica_component_boundary",
):
    if marker not in source:
        raise SystemExit("ii-c-b2a2 component verifier contract drifted")
public_dispatch = """if $iicb2a2_component_boundary_only; then
    run_iicb2a2_component_snapshot
    print "ii-c-b2a2 campaign component boundary verification passed."
    exit 0
fi"""
dispatch_region = source[runtime_end:]
if dispatch_region.count(public_dispatch) != 1:
    raise SystemExit("ii-c-b2a2 component verifier contract drifted")
evidence_dispatch = """if $iic_evidence_verification_component_boundary_only; then
    run_iicb1_root_owned_gate_component_snapshot evidence
    print "ii-c evidence-verification component boundary verification passed."
    exit 0
fi"""
if dispatch_region.count(evidence_dispatch) != 1:
    raise SystemExit("ii-c-b2a2 component verifier contract drifted")
PY
}

function verify_iicb2a2_component_boundary() (
    local PATH=/usr/bin:/bin:/usr/sbin:/sbin
    [[ ${STORNAUT_VALIDATION_SOURCE:-} == staged \
        && ${#STORNAUT_VALIDATION_COMMIT:-} == 40 \
        && ${STORNAUT_VALIDATION_COMMIT:-} != *[^0-9a-f]* \
        && "$(git rev-parse 'HEAD^{commit}')" == $STORNAUT_VALIDATION_COMMIT \
        && -z "$(git status --porcelain=v1 --untracked-files=all)" ]] || {
        print -u2 "ii-c-b2a2 staged validation snapshot unavailable"
        return 1
    }
    verify_iicb2a2_component_source_contract \
        scripts/verify-app-release-boundaries || return $?
    local scratch product_derived_data diagnostic_derived_data validation_user
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-iicb2a2-component.XXXXXX") \
        || return $?
    trap 'rm -rf "$scratch"' EXIT
    product_derived_data="$scratch/product"
    diagnostic_derived_data="$scratch/diagnostic"
    validation_user=$(/usr/bin/id -un)
    local -a clean_env=(/usr/bin/env -i HOME="$HOME" USER="$validation_user"
        LOGNAME="$validation_user" PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C
        LANG=C TMPDIR="$TMPDIR" DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
        STORNAUT_VALIDATION_COMMIT="$STORNAUT_VALIDATION_COMMIT"
        STORNAUT_VALIDATION_SOURCE=staged)
    "${clean_env[@]}" /usr/bin/swift build --scratch-path "$scratch/swiftpm" \
        --configuration debug --target StornautInvestigationMachineCampaignSupport \
        --disable-sandbox || return $?
    local object symbols strings combined marker
    local -a objects=(${(f)"$(find "$scratch/swiftpm" -type f \
        -path '*StornautInvestigationMachineCampaignSupport.build/*.swift.o' | LC_ALL=C sort)"})
    local object_names
    object_names=$(printf '%s\n' "${objects[@]:t}" | LC_ALL=C sort)
    [[ $object_names == $'InvestigationMachineCampaignEvidenceContract.swift.o\nInvestigationMachineCampaignHarness.swift.o\nInvestigationMachineRawEvidenceWriter.swift.o' ]] || {
        print -u2 "ii-c-b2a2 CampaignSupport object positive control unavailable"
        return 1
    }
    combined=
    for object in "${objects[@]}"; do
        file "$object" | grep -q 'Mach-O' || return $?
        symbols=$(xcrun nm -j "$object" 2>/dev/null | xcrun swift-demangle) || return $?
        strings=$(xcrun strings -a "$object" 2>/dev/null) || return $?
        combined+="$symbols$strings"
    done
    for marker in \
        'StornautInvestigationMachineCampaignSupport.InvestigationMachineRawEvidenceWriter' \
        'StornautInvestigationMachineCampaignSupport.InvestigationMachineEvidenceManifestV1' \
        'stornaut.task39.iic.raw-evidence-manifest.v1' \
        'stornaut.task39.iic.attempt-event.v1'
    do
        [[ $combined == *"$marker"* ]] || {
            print -u2 "ii-c-b2a2 CampaignSupport object positive control drifted: $marker"
            return 1
        }
    done
    local -a xcode=("${clean_env[@]}" /usr/bin/xcodebuild
        "STORNAUT_VALIDATION_COMMIT=$STORNAUT_VALIDATION_COMMIT")
    local configuration scheme
    for configuration in Debug Release; do
        "${xcode[@]}" -quiet -project Stornaut.xcodeproj -scheme Stornaut \
            -configuration "$configuration" -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$product_derived_data" build || return $?
    done
    "${xcode[@]}" -quiet -project Stornaut.xcodeproj \
        -scheme StornautInvestigationDiagnosticApp -configuration Debug \
        -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath "$diagnostic_derived_data" build || return $?
    "${xcode[@]}" -quiet -project Stornaut.xcodeproj \
        -scheme StornautInvestigationDiagnosticReleaseShell -configuration Release \
        -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath "$diagnostic_derived_data" build || return $?
    for scheme in StornautInvestigationMachineDriverNative \
        StornautInvestigationMachineGateNative \
        StornautInvestigationMachineGateCoordinatorNative
    do
        "${xcode[@]}" -quiet -project Stornaut.xcodeproj -scheme "$scheme" \
            -configuration Release -destination 'platform=macOS,arch=arm64' \
            -derivedDataPath "$diagnostic_derived_data" build || return $?
    done
    verify_iica_component_boundary \
        "$product_derived_data" "$diagnostic_derived_data" || return $?
    local diagnostic_debug="$diagnostic_derived_data/Build/Products/Debug/StornautInvestigationDiagnostic.app"
    local -a negative_images=(
        "$product_derived_data/Build/Products/Debug/Stornaut.app"
        "$product_derived_data/Build/Products/Release/Stornaut.app"
        "$diagnostic_debug"
        "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"
        "$diagnostic_debug/Contents/MacOS/StornautLifecycleHelper"
        "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationMachineDriver"
        "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationMachineGate"
        "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationMachineGateCoordinatorNative/StornautInvestigationMachineGateCoordinator"
    )
    local image inventory candidate kind symlink
    for image in "${negative_images[@]}"; do
        [[ -e $image && ! -L $image ]] || {
            print -u2 "ii-c-b2a2 closed image unavailable: $image"; return 1
        }
        if [[ -d $image ]]; then
            symlink=$(find "$image" -type l -print -quit) || return $?
            [[ -z $symlink ]] || {
                print -u2 "ii-c-b2a2 closed image contains symlink: $symlink"; return 1
            }
            inventory="$scratch/negative-${image:t}-$RANDOM.inventory"
            find "$image" -type f -print0 >"$inventory" || return $?
            while IFS= read -r -d '' candidate; do
                verify_iicb2a2_negative_macho "$candidate" || return $?
            done <"$inventory"
        else
            verify_iicb2a2_negative_macho "$image" || return $?
        fi
    done
)

function verify_iicb2a2_negative_macho() {
    local PATH=/usr/bin:/bin:/usr/sbin:/sbin
    local candidate=$1 kind symbols strings combined marker
    kind=$(file "$candidate" 2>/dev/null) || return $?
    [[ $kind == *Mach-O* ]] || return 0
    symbols=$(xcrun nm -j "$candidate" 2>/dev/null \
        | xcrun swift-demangle 2>/dev/null) || return $?
    strings=$(xcrun strings -a "$candidate" 2>/dev/null) || return $?
    combined="$symbols$strings"
    for marker in 'StornautInvestigationMachineCampaignSupport.' \
        'InvestigationMachineRawEvidenceWriter' \
        'stornaut.task39.iic.raw-evidence-manifest.v1' \
        'stornaut.task39.iic.attempt-event.v1'
    do
        [[ $combined != *"$marker"* ]] || {
            print -u2 "ii-c-b2a2 campaign namespace leaked into closed image: $candidate"
            return 1
        }
    done
}

function verify_iib5biii_a_source_contract() {
    local single_epoch_path=$1
    local composition_path=$2
    local continuity_path=$3
    xcrun swiftc -frontend -parse "$single_epoch_path"
    xcrun swiftc -frontend -parse "$composition_path"
    xcrun swiftc -frontend -parse "$continuity_path"
    python3 - "$single_epoch_path" "$composition_path" "$continuity_path" <<'PY'
from pathlib import Path
import re
import sys

single_path, composition_path, continuity_path = map(Path, sys.argv[1:])
single = single_path.read_text(encoding="utf-8")
composition = composition_path.read_text(encoding="utf-8")
continuity = continuity_path.read_text(encoding="utf-8")

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

if imports(single) != {"Foundation", "StornautInvestigationHandoffContract", "StornautInvestigationInstalledL2"}:
    raise SystemExit("iii-a source-only import surface drifted")
if imports(composition) != {"Foundation", "StornautInvestigationHandoffContract", "StornautInvestigationInstalledL2"}:
    raise SystemExit("iii-a source-only composition import surface drifted")
if imports(continuity) != {"Foundation", "StornautInvestigationHandoffContract"}:
    raise SystemExit("iii-a source-only continuity import surface drifted")
source = single + composition + continuity
if re.search(r"(?m)^\s*(?:public|open)\s+", source):
    raise SystemExit("iii-a source-only public surface drifted")
for forbidden in (
    "Codable", "Encodable", "Decodable", "CommandLine.arguments",
    "ProcessInfo.processInfo.environment", "posix_spawn", "posix_spawnp",
    "fork(", "socketpair(", "kill(", "killpg(", "waitpid(", "waitid(",
    "setuid(", "setgid(", "initgroups(", "FileManager", "FileHandle",
    "Process(", "URLSession", "StornautExecution", "StornautLifecycle",
    "StornautCodex", "StornautCore", "StornautInvestigationRuntime",
    "StornautInvestigationDiagnostic", "signedRuntimeReady",
    "signedInvestigationRuntimeReady", "readFD0", "FD 0", "FD 8", "FD 9",
    "PGID", "StornautInvestigationMachineDarwin",
):
    if forbidden in source:
        raise SystemExit("iii-a source-only App boundary gained physical authority")
for marker in (
    "previousHelperIdentity: InvestigationMachineProcessIdentity?",
    "InvestigationMachineSingleEpochComposition",
    "package static func genesis(",
    "return try await outerJoin.seal(",
    "InvestigationMachineOuterContainmentProof",
    "InvestigationMachineHelperEpochPredecessor",
    "predecessor: predecessorMaterial",
    "terminalProofSHA256",
    "Task.detached",
):
    if marker not in source:
        raise SystemExit(f"iii-a source-only semantic marker drifted: {marker}")
PY
}

function verify_iib5biii_b1_source_contract() {
    local cohort_path=$1
    local continuity_path=$2
    xcrun swiftc -frontend -parse "$cohort_path"
    xcrun swiftc -frontend -parse "$continuity_path"
    python3 - "$cohort_path" "$continuity_path" <<'PY'
from pathlib import Path
import re
import sys

cohort_path, continuity_path = map(Path, sys.argv[1:])
cohort = cohort_path.read_text(encoding="utf-8")
continuity = continuity_path.read_text(encoding="utf-8")

def imports(source):
    return set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))

if imports(cohort) != {"Foundation", "StornautInvestigationHandoffContract"}:
    raise SystemExit("iii-b1 source-only import surface drifted")
if imports(continuity) != {"Foundation", "StornautInvestigationHandoffContract"}:
    raise SystemExit("iii-b1 source-only continuity import surface drifted")
source = cohort + continuity
if re.search(r"(?m)^\s*(?:public|open)\s+", source):
    raise SystemExit("iii-b1 source-only public surface drifted")
for forbidden in (
    r"\b(?:Codable|Encodable|Decodable)\b",
    r"\b(?:Darwin|Glibc|AppKit|SwiftUI)\b",
    r"\b(?:posix_spawn|posix_spawnp|fork|execve|system)\s*\(",
    r"\b(?:FileManager|FileHandle|URL|URLRequest|Path|URLSession|NSXPCConnection|Process)\b",
    r"\b(?:open|openat|creat|write|pwrite|truncate|ftruncate|rename|unlink|remove|mkdir|rmdir|chmod|chown|copyfile|clonefile|socket|socketpair|connect|bind|listen|accept|send|recv|kill|killpg|waitpid|waitid)\s*\(",
    r"\b(?:O_WRONLY|O_RDWR|O_CREAT|O_TRUNC|O_APPEND)\b",
    r"\b(?:fileDescriptor|descriptor|FD_CLOEXEC|STDIN_FILENO|PGID)\b",
    r"\b(?:CommandLine\.arguments|ProcessInfo\.processInfo\.environment|readLine)\b",
    r"\b(?:Executor|MoveToTrash|RegisteredAction|readiness|signedRuntimeReady|signedInvestigationRuntimeReady|implementationUnavailable)\b",
    r"\bStornaut(?:Execution|Core|Lifecycle|Codex|InvestigationRuntime|InvestigationDiagnostic|ProbeBridge|ProcessSupport)\b",
    r"(?m)^\s*@main\b",
):
    if re.search(forbidden, source, re.IGNORECASE):
        raise SystemExit(
            "iii-b1 source-only App boundary gained physical authority"
        )
for marker in (
    "package actor InvestigationMachineEightEpochCohort",
    "package protocol InvestigationMachineEightEpochExecutionFactory",
    "package final class InvestigationMachineEightEpochExecution",
    "package func run() async throws",
    "package func destroyAfterFinal(",
    "for index in 0..<InvestigationCohortCapsule.epochCount",
    "try finalContinuity.destroyAfterFinal(selection: finalSelection)",
    "guard error == InvestigationMachineFixedCapsuleIntakeError.exhausted",
):
    if marker not in source:
        raise SystemExit(
            f"iii-b1 source-only semantic marker drifted: {marker}"
