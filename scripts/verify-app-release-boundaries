machine_driver_undefined_symbols=$(
    xcrun nm -u -j "$diagnostic_machine_driver" 2>/dev/null \
        | LC_ALL=C sort -u
) || {
    print -u2 "Machine driver undefined-symbol scan failed."
    exit 1
}
machine_driver_loaded_libraries=$(
    otool -L "$diagnostic_machine_driver" 2>/dev/null \
        | tail -n +2 \
        | sed 's/^[[:space:]]*//' \
        | LC_ALL=C sort -u
) || {
    print -u2 "Machine driver load-command scan failed."
    exit 1
}
machine_driver_owned_symbols=$(
    xcrun nm -j "$diagnostic_machine_driver" 2>/dev/null \
        | xcrun swift-demangle 2>/dev/null \
        | rg 'StornautInvestigationMachineDriver(Support)?' \
        | LC_ALL=C sort -u
) || {
    print -u2 "Machine driver owned-symbol scan failed."
    exit 1
}
function require_projection() {
    local value=$1 expected_sha=$2 expected_lines=$3 label=$4
    local observed_sha observed_lines
    observed_sha=$(print -rn -- "$value" | shasum -a 256 | awk '{print $1}')
    observed_lines=$(print -r -- "$value" | awk 'END {print NR}')
    if [[ "$observed_sha" != "$expected_sha" \
        || "$observed_lines" != "$expected_lines" ]]
    then
        print -u2 "Machine driver $label projection drifted."
        exit 1
    fi
}
require_projection \
    "$machine_driver_undefined_symbols" \
    "$iib5biii_b2b1b_xcode_debug_undefined_sha256" \
    "$iib5biii_b2b1b_xcode_debug_undefined_lines" \
    undefined
require_projection \
    "$machine_driver_loaded_libraries" \
    "$iib5biii_b2b1b_xcode_loads_sha256" \
    "$iib5biii_b2b1b_xcode_loads_lines" \
    load-command
require_projection \
    "$machine_driver_owned_symbols" \
    "$iib5biii_b2b1b_xcode_debug_owned_sha256" \
    "$iib5biii_b2b1b_xcode_debug_owned_lines" \
    owned-symbol
if ! mach_o_has_demangled_symbol \
    "$diagnostic_machine_driver" \
    'Darwin.open(Swift.UnsafePointer<Swift.Int8>, Swift.Int32)'
then
    symbol_scan_status=$?
    if (( symbol_scan_status == 2 )); then
        exit 1
    fi
    print -u2 "Machine driver read-only Darwin.open is missing."
    exit 1
fi
for marker in "${machine_driver_authority_forbidden_imports[@]}"; do
    if print -r -- "$machine_driver_undefined_symbols" \
        | grep -Fxq -- "$marker"
    then
        if (( ${iib5biii_b2b0_authority_imports[(Ie)$marker]} > 0 )); then
            continue
        fi
        print -u2 "Machine driver imports prohibited authority: $marker"
        exit 1
    fi
done
for marker in "${machine_driver_required_readonly_imports[@]}"; do
    if ! print -r -- "$machine_driver_undefined_symbols" \
        | grep -Fxq -- "$marker"
    then
        print -u2 "Machine driver read-only import is missing: $marker"
        exit 1
    fi
done
for marker in "${iib5biic_debug_introduced_imports[@]}"; do
