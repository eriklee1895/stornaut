app_contains() {
    local app=$1
    local marker=$2
    mach_o_contains "$app" "$marker"
}

mach_o_contains() {
    local root=$1
    local marker=$2
    local file

    while IFS= read -r -d '' file; do
        if file "$file" 2>/dev/null | grep -q 'Mach-O' \
            && rg -a -q --fixed-strings -- "$marker" "$file"; then
            return 0
        fi
    done < <(find "$root" -type f -print0)
    return 1
}

mach_o_has_demangled_symbol() {
    local root=$1
    local marker=$2
    local file
    local symbols

    while IFS= read -r -d '' file; do
        if ! file "$file" 2>/dev/null | grep -q 'Mach-O'; then
            continue
        fi
        if ! symbols=$(
            xcrun nm -j "$file" 2>/dev/null \
                | xcrun swift-demangle 2>/dev/null
        ); then
            print -u2 "Demangled symbol scan failed: $file"
            return 2
        fi
        if [[ "$symbols" == *"$marker"* ]]; then
            return 0
        fi
    done < <(find "$root" -type f -print0)
    return 1
}

mach_o_image_has_demangled_symbol() {
    local image=$1
    local marker=$2
    local kind symbols

    if [[ ! -f "$image" || -L "$image" ]]; then
        print -u2 "Mach-O symbol scan target is invalid: $image"
        return 2
    fi
    if ! kind=$(file "$image" 2>/dev/null) \
        || [[ "$kind" != *'Mach-O'* ]]
    then
        print -u2 "Mach-O symbol scan target is not Mach-O: $image"
        return 2
    fi
    if ! symbols=$(
        xcrun nm -j "$image" 2>/dev/null \
            | xcrun swift-demangle 2>/dev/null
    ); then
        print -u2 "Mach-O symbol scan failed: $image"
        return 2
    fi
    [[ "$symbols" == *"$marker"* ]]
}

