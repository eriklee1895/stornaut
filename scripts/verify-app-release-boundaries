function verify_iib5biii_b2ai_source_contract() {
    local single_path=$1 composition_path=$2 continuity_path=$3
    local bridge_path=$4 protocol_path=$5
    local source_path
    for source_path in "$single_path" "$composition_path" \
        "$continuity_path" "$bridge_path" "$protocol_path"
    do
        xcrun swiftc -frontend -parse "$source_path"
    done
    python3 - "$single_path" "$composition_path" "$continuity_path" \
        "$bridge_path" "$protocol_path" <<'PY'
from pathlib import Path
import re
import subprocess
import sys

single_path, composition_path, continuity_path, bridge_path, protocol_path = (
    map(Path, sys.argv[1:])
)
sources = {path: path.read_text(encoding="utf-8") for path in (
    single_path, composition_path, continuity_path, bridge_path, protocol_path
)}

def swift_code_only(source):
    output = list(source)
    index = 0
    block_depth = 0
    string_end = None
    raw_hashes = ""
    while index < len(source):
        if block_depth:
            if source.startswith("/*", index):
                output[index:index + 2] = "  "
                block_depth += 1
                index += 2
            elif source.startswith("*/", index):
                output[index:index + 2] = "  "
                block_depth -= 1
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if string_end is not None:
            if source.startswith(string_end, index):
                width = len(string_end)
                output[index:index + width] = " " * width
                index += width
                string_end = None
                raw_hashes = ""
            elif not raw_hashes and source[index] == "\\":
                output[index] = " "
                if index + 1 < len(source) and source[index + 1] != "\n":
                    output[index + 1] = " "
                index += 2
            else:
                if source[index] != "\n":
                    output[index] = " "
                index += 1
            continue
        if source.startswith("//", index):
            end = source.find("\n", index)
            end = len(source) if end < 0 else end
            output[index:end] = " " * (end - index)
            index = end
        elif source.startswith("/*", index):
            output[index:index + 2] = "  "
            block_depth = 1
            index += 2
        else:
            opener = re.match(r'(#+)?("""|")', source[index:])
            if opener is None:
                index += 1
                continue
            hashes = opener.group(1) or ""
            quote = opener.group(2)
            width = len(opener.group(0))
            output[index:index + width] = " " * width
            string_end = quote + hashes
            raw_hashes = hashes
            index += width
    if block_depth or string_end is not None:
        raise SystemExit("iii-b2a-i source-only Swift lexical scan drifted")
    return "".join(output)

code_sources = {path: swift_code_only(source) for path, source in sources.items()}
def swift_parse_tree(path):
    completed = subprocess.run(
        ["xcrun", "swiftc", "-frontend", "-dump-parse", str(path)],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    if completed.returncode != 0:
        raise SystemExit(
            "iii-b2a-i source-only Swift lexical scan drifted"
        )
    return completed.stdout

parse_trees = {path: swift_parse_tree(path) for path in sources}
expected_imports = {
    single_path: {
        "Foundation", "StornautInvestigationHandoffContract",
        "StornautInvestigationInstalledL2",
    },
    composition_path: {
        "Foundation", "StornautInvestigationHandoffContract",
        "StornautInvestigationInstalledL2",
    },
    continuity_path: {
        "Foundation", "StornautInvestigationHandoffContract",
    },
    bridge_path: {
        "Foundation", "StornautInvestigationHandoffContract",
    },
    protocol_path: {
        "Foundation", "StornautInvestigationHandoffContract",
    },
}
for path, source in sources.items():
    imports = set(re.findall(
        r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", code_sources[path]
    ))
    if imports != expected_imports[path]:
        raise SystemExit("iii-b2a-i source-only import surface drifted")
semantic = "\n".join(sources.values())
code_semantic = "\n".join(code_sources.values())
if re.search(r"(?m)^\s*(?:public|open)\s+", code_semantic):
    raise SystemExit("iii-b2a-i source-only public surface drifted")
if re.search(r"\b(?:Codable|Encodable|Decodable)\b", code_semantic):
    raise SystemExit("iii-b2a-i source-only Codable surface drifted")
for forbidden in (
    r"\b(?:Executor|MoveToTrash|RegisteredAction|readiness|"
    r"signedRuntimeReady|implementationAvailable)\b",
    r"\b(?:CommandLine\.arguments|ProcessInfo\.processInfo\.environment)\b",
    r"\bStornaut(?:Execution|Core|Lifecycle|Codex|InvestigationRuntime|"
    r"InvestigationDiagnostic|ProbeBridge|ProcessSupport)\b",
):
    if re.search(forbidden, code_semantic, re.IGNORECASE):
        raise SystemExit(
            "iii-b2a-i source-only App boundary gained physical authority"
        )
physical_authority_symbols = (
    "Darwin", "Glibc", "AppKit", "SwiftUI", "NSXPCConnection",
    "URLSession", "Process", "FileManager", "FileHandle",
    "NWConnection", "Network", "posix_spawn", "fork", "execve",
    "open", "openat", "write", "pwrite", "socket", "connect",
    "recv", "kill", "killpg", "waitpid", "waitid", "dup2",
    "fcntl", "close", "fileDescriptor", "STDIN_FILENO",
    "STDOUT_FILENO", "STDERR_FILENO", "O_WRONLY", "O_RDWR",
    "O_CREAT", "SIGTERM", "SIGKILL",
)
physical_authority = re.compile(
    r'(?:name|id|field)="(?:'
    + "|".join(map(re.escape, physical_authority_symbols))
    + r')"'
)
for path, parse_tree in parse_trees.items():
    if physical_authority.search(parse_tree):
        raise SystemExit(
            "iii-b2a-i source-only physical authority drifted"
        )

# `send` is also the name of the existing injected frame-transport method.
# Pin its exact source-only shapes instead of globally allowing an unqualified
# Darwin `send(2)` call to hide beside that abstraction.
unqualified_send = re.compile(
    r'\(unresolved_decl_ref_expr[^\n]*name="send" function_ref=unapplied\)'
)
if len(unqualified_send.findall(parse_trees[single_path])) != 5:
    raise SystemExit(
        "iii-b2a-i source-only physical authority drifted"
    )
for path in (composition_path, continuity_path, bridge_path, protocol_path):
    if unqualified_send.search(parse_trees[path]):
        raise SystemExit(
            "iii-b2a-i source-only physical authority drifted"
        )
for marker in (
    "package actor InvestigationMachineDarwinInnerProtocolState",
    "package actor InvestigationMachineDarwinOuterAdmission",
    "package struct InvestigationMachineSingleEpochAdmittedPhysicalResult",
    "fileprivate init(",
    "protocol InvestigationMachinePhysicalSingleEpochComposing:",
    "case admittedPhysical(",
    "case let .admittedPhysical(admitted):",
    "epochDeadlineNanoseconds: request.epochDeadlineNanoseconds",
    "evidence.appChild == exchange.appChild",
    "== exchange.physicalOwnership.helperIdentity",
    "private static let maximumAdmissionByteCount = 192 * 1_024",
    "normal.physicalResult.driverObservationSHA256",
    "case let .admittedPhysical(admitted) = result",
    "admittedBy admissionOwner: UUID",
    "guard proof.isBound(",
    "activeRequest == request, activeDecision.kind == .continue",
):
    if marker not in semantic:
        raise SystemExit(
            f"iii-b2a-i source-only semantic marker drifted: {marker}"
        )
if semantic.count("InvestigationMachineSingleEpochAdmittedPhysicalResult(") != 1:
    raise SystemExit("iii-b2a-i source-only admitted token mint drifted")
for forbidden in (
    "case physical(InvestigationMachineSingleEpochPhysicalResult)",
    "case admittedPhysical(InvestigationMachineSingleEpochPhysicalResult)",
    "init(physical: InvestigationMachineSingleEpochPhysicalResult)",
):
    if forbidden in semantic:
        raise SystemExit(
            "iii-b2a-i source-only raw DTO admission drifted"
        )
PY
}

