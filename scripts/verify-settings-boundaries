#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"

settings_views=(
    StornautApp/Settings/StornautSettingsView.swift
    StornautApp/Settings/SettingsComponents.swift
    StornautApp/Settings/GeneralSettingsView.swift
    StornautApp/Settings/ScanningSettingsView.swift
    StornautApp/Settings/PermissionsSettingsView.swift
    StornautApp/Settings/CodexSettingsView.swift
    StornautApp/Settings/PrivacyDataSettingsView.swift
    StornautApp/Settings/LocalKnowledgeSettingsView.swift
)

for source in "${settings_views[@]}"; do
    test -f "$source"
done

for forbidden in \
    EvidenceStore \
    LocalKnowledgeStore \
    SettingsPreferencesStore \
    Surveyor \
    QuickScanCoordinator \
    CodexLocator \
    CodexCapabilityDetector \
    CodexProcess \
    ProbeBridge \
    NSOpenPanel \
    NSWorkspace \
    UserDefaults \
    'Process\(' \
    TCC \
    tccutil \
    '\.clearEvidence\(' \
    '\.clearManifests\(' \
    '\.forgetAll\('; do
    if rg -n "$forbidden" "${settings_views[@]}"; then
        print -u2 "Settings View boundary violation: $forbidden"
        exit 1
    fi
done

if rg -n \
    'Start Deep Dive|Trust Codex|Proceed Anyway|Adjust Retention|Accept' \
    "${settings_views[@]}"; then
    print -u2 "Deferred or unsafe Settings action leaked into Task 25 Views."
    exit 1
fi

if rg -n \
    'Broker-only|仅限 Broker|pausedRequired|Deep Dive Safety Paused' \
    StornautApp; then
    print -u2 "Superseded runtime status copy leaked into the product."
    exit 1
fi

rg -q 'enum SettingsRuntimeEvidenceStatus' \
    StornautApp/Settings/SettingsState.swift
rg -q 'enum SettingsRuntimeGateStatus' \
    StornautApp/Settings/SettingsModel.swift
rg -q 'case implementationUnavailable' \
    StornautApp/Settings/SettingsModel.swift
rg -q 'static let admittedR5' \
    StornautApp/Settings/SettingsState.swift
rg -q '8b93852d901cc7bd78bf827c21dc4d85ab9d473f' \
    StornautApp/Settings/SettingsState.swift
rg -q \
    '08ba7c30373d4736124f0e507fcc9aa972880235251b8bbf636a7b2fabb1d193' \
    StornautApp/Settings/SettingsState.swift
rg -q 'capabilitiesObserved: 9' \
    StornautApp/Settings/SettingsState.swift
rg -q 'integrityContained: 12' \
    StornautApp/Settings/SettingsState.swift
rg -q 'evidence.receipt != .admittedR5' \
    StornautApp/Settings/SettingsModel.swift
rg -q 'deepDiveCanStart: false' \
    StornautApp/Settings/SettingsModel.swift
rg -q 'hasAction: false' \
    StornautApp/Settings/SettingsModel.swift
rg -q 'persistsAcceptance: false' \
    StornautApp/Settings/SettingsModel.swift
rg -q \
    'Runtime boundary verified · Deep Dive implementation not yet available' \
    StornautApp/Resources/en.lproj/Localizable.strings
rg -q 'settings.codex.evidence' \
    StornautApp/Settings/CodexSettingsView.swift
rg -q 'settings.codex.runtimeGate' \
    StornautApp/Settings/CodexSettingsView.swift
rg -q 'settings.codex.deepDiveAvailability' \
    StornautApp/Settings/CodexSettingsView.swift
rg -q 'settings.codex.disclosure' \
    StornautApp/Settings/CodexSettingsView.swift

rg -q 'loadSettings' StornautApp/AppState/AppDependencies.swift
rg -q 'saveSettingsPreferences' StornautApp/AppState/AppDependencies.swift
rg -q 'clearSettingsEvidence' StornautApp/AppState/AppDependencies.swift
rg -q 'forgetSettingsKnowledge' StornautApp/AppState/AppDependencies.swift
rg -q 'refreshSettings' StornautApp/AppState/StornautAppModel.swift
rg -q 'SettingsPrimaryRoot' \
    Sources/StornautCore/Settings/SettingsPreferences.swift
rg -q 'case userExcluded' \
    Sources/StornautCore/Surveyor/PathSnapshot.swift

print "Settings UI/service boundaries verified."
