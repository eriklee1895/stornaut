#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"

history_views=(
    StornautApp/History/HistoryView.swift
    StornautApp/History/HistoryNavigator.swift
    StornautApp/History/HistoryDetailView.swift
    StornautApp/History/HistoryManifestDetailView.swift
    StornautApp/History/HistoryExport.swift
    StornautApp/History/StorageTrendView.swift
)

for source in "${history_views[@]}"; do
    test -f "$source"
done

for forbidden in \
    Surveyor \
    ScanRequest \
    QuickScanCoordinator \
    EvidenceStore \
    SQLite \
    StornautCodex \
    Codex \
    ProbeBridge \
    PolicyGate \
    Executor \
    RegisteredAction \
    LocalKnowledgeStore \
    'FileManager\.' \
    'Process\(' \
    'shell'; do
    if rg -n "$forbidden" "${history_views[@]}"; then
        print -u2 "History View boundary violation: $forbidden"
        exit 1
    fi
done

if rg -n \
    'Delete Permanently|Empty Trash|Restore|Run Again|Freed|Reclaimed|Start Deep Dive' \
    "${history_views[@]}"; then
    print -u2 "Execution, restore, permanent deletion or misleading copy leaked into History."
    exit 1
fi

if rg -n \
    'removeItem\s*\(|moveItem\s*\(|copyItem\s*\(|createFile\s*\(|forWritingTo|O_WRONLY|O_RDWR|unlink\(|rename\(|trashItem\s*\(' \
    "${history_views[@]}"; then
    print -u2 "History View contains a filesystem write surface."
    exit 1
fi

rg -q 'loadScanHistory' StornautApp/AppState/AppDependencies.swift
rg -q 'deleteScanHistory' StornautApp/AppState/AppDependencies.swift
rg -q 'deleteManifestHistory' StornautApp/AppState/AppDependencies.swift
rg -q 'exportHistory' StornautApp/AppState/AppDependencies.swift
rg -q 'refreshHistory' StornautApp/AppState/StornautAppModel.swift
rg -q 'deleteHistoryRecord' StornautApp/AppState/StornautAppModel.swift
rg -q 'exportHistoryRecord' StornautApp/AppState/StornautAppModel.swift
rg -q 'scanHistory' Sources/StornautCore/Evidence/EvidenceStore.swift
rg -q 'cleanupManifestHistory' \
    Sources/StornautCore/Evidence/EvidenceStore.swift
rg -q 'deleteCleanupManifest' \
    Sources/StornautCore/Evidence/EvidenceStore.swift
rg -q 'private static let schemaVersion = 4' \
    Sources/StornautCore/Evidence/EvidenceStore.swift
rg -q 'history.delete.confirm.message' \
    StornautApp/Resources/en.lproj/Localizable.strings
rg -q 'history.record.cleanupManifest' \
    StornautApp/Resources/en.lproj/Localizable.strings
rg -q 'history.action.export' \
    StornautApp/Resources/en.lproj/Localizable.strings
rg -q 'history.trend.nonCausal' \
    StornautApp/Resources/en.lproj/Localizable.strings

print "Manifest-aware History UI/service boundaries verified."
