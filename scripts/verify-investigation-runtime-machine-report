if sys.flags.optimize != 0:
    raise SystemExit("optimized Python execution is not admitted")

MAGIC = 0x53544E43
VERSION = 1
MAX_DOMAIN = 64
MAX_MANIFEST = 512 << 10
MAX_ARTIFACTS = 256
MAX_ARTIFACT = 16 << 20
MAX_TOTAL = 64 << 20
MAX_EVENT = 4_608
MAX_EVENT_PAYLOAD = 4_096
MAX_RECEIPT = 4_096
MAX_CAPSULE = 1_069_056
SCENARIOS = ("success", "cancellation", "timeout", "invalidEnvelope",
    "identityMismatch", "transportLoss", "lifecycleRecovery", "artifactCleanupFailure")
ROLE_NAMES = {1: "sourceBuildIdentity", 2: "builtStagingInstalledIdentity",
              3: "policyProbe", 4: "humanPromptAttestation",
              5: "noAuthModelNetworkCounters", 8: "epochL2Projection",
              9: "epochResidueProjection", 10: "uninstallEvidence",
              11: "globalPostTeardown", 12: "verifierInput"}
O_NOFOLLOW_ANY = 0x20000000
O_RESOLVE_BENEATH = 0x00001000
O_UNIQUE = 0x00002000
READ_FLAGS = (
    os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | O_NOFOLLOW_ANY
    | O_RESOLVE_BENEATH | O_UNIQUE
)
DIRECTORY_FLAGS = READ_FLAGS | os.O_DIRECTORY
ROOT_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NONBLOCK
ROOT_FLAGS |= O_NOFOLLOW_ANY | O_UNIQUE
VNODE_IDENTITY = (select.KQ_NOTE_DELETE | select.KQ_NOTE_ATTRIB
                  | select.KQ_NOTE_RENAME | select.KQ_NOTE_REVOKE)
VNODE_CONTENT = (VNODE_IDENTITY | select.KQ_NOTE_LINK
                 | select.KQ_NOTE_WRITE | select.KQ_NOTE_EXTEND)
ACL_TYPE_EXTENDED = 0x00000100
ACL_FIRST_ENTRY = 0
PHASES = {
    1: "01-preflight", 2: "02-install", 3: "03-authorization",
    4: "04-driver-epochs", 5: "05-uninstall", 6: "06-verifier",
}
ROLES = {
    1: (1, 2, "source-build.json"),
    2: (2, 2, "installed.json"),
    3: (3, 2, "policy-probe.json"),
    4: (3, 2, "human-attestation.json"),
    5: (3, 2, "capability-counts.json"),
    6: (4, 4, "coordinator-receipt.bin"),
    7: (4, 3, "diagnostic-output.bin"),
    8: (4, 2, None),
