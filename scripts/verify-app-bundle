#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
expected_app="$repo_root/.derivedData/app/Build/Products/Debug/Stornaut.app"
app_path=${1:-$expected_app}
app_path=${app_path:A}

if [[ "$app_path" != "$expected_app" ]]; then
    print -u2 "Refusing to inspect unexpected path: $app_path"
    exit 1
fi

info_plist="$app_path/Contents/Info.plist"
executable="$app_path/Contents/MacOS/Stornaut"

test "$(plutil -extract CFBundleIdentifier raw "$info_plist")" = \
    "com.eriklee.stornaut"
test "$(plutil -extract CFBundlePackageType raw "$info_plist")" = "APPL"
test "$(plutil -extract CFBundleExecutable raw "$info_plist")" = "Stornaut"
test "$(plutil -extract LSMinimumSystemVersion raw "$info_plist")" = "26.0"
test "$(lipo -archs "$executable")" = "arm64"

codesign --verify --deep --strict --verbose=2 "$app_path"

requirement=$(codesign -d -r- "$app_path" 2>&1 | tail -1)
test "$requirement" = \
    'designated => identifier "com.eriklee.stornaut"'

entitlements_file=$(mktemp)
trap 'rm -f "$entitlements_file"' EXIT
codesign -d --entitlements :- "$app_path" > "$entitlements_file" 2>/dev/null
test "$(/usr/libexec/PlistBuddy -c 'Print :com.apple.security.app-sandbox' "$entitlements_file")" = \
    "false"

test -f "$app_path/Contents/Resources/en.lproj/Localizable.strings"
test -f "$app_path/Contents/Resources/zh-Hans.lproj/Localizable.strings"
test ! -d "$app_path/Contents/PlugIns"

print "App bundle verification passed: $app_path"
