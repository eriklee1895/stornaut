    raise SystemExit("iii-b scope verifier missing")
scope = source[start:end + len("\nPY\n}\n")]
iii_b_i_expected_paths = {
    "Stornaut.xcodeproj/project.pbxproj",
    "StornautLifecycleHelper/main.swift",
    "Sources/StornautLifecycle/LifecycleMachineRetirementEscrow.swift",
    "Sources/StornautInvestigationMachineClaimServer/InvestigationMachineClaimServerAdapter.swift",
    "Sources/StornautInvestigationMachineClaimServer/InvestigationMachineClaimServerEffects.swift",
    "Tests/StornautLifecycleTests/LifecycleMachineRetirementEscrowTests.swift",
    "Tests/StornautLifecycleTests/LifecycleMachineClaimXPCContractTests.swift",
    "Tests/StornautLifecycleTests/LifecycleInteractiveSessionContractTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineClaimServerAdapterTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift",
    "scripts/verify-app-release-boundaries",
    "scripts/verify-investigation-boundaries",
    "scripts/verify-contract",
}
iii_b_ii_expected_paths = {
    "Sources/StornautInvestigationMachineClaimServer/InvestigationMachineClaimServerAdapter.swift",
    "Sources/StornautInvestigationMachineClaimServer/InvestigationMachineClaimServerEffects.swift",
    "StornautLifecycleHelper/main.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineClaimServerAdapterTests.swift",
    "Tests/StornautLifecycleTests/LifecycleMachineClaimXPCContractTests.swift",
    "Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift",
    "scripts/verify-investigation-boundaries",
    "scripts/verify-app-release-boundaries",
    "scripts/verify-contract",
}


def verify_scope_contract(value):
    for name, expected_paths in (
        ("iii_b_i_expected", iii_b_i_expected_paths),
        ("iii_b_ii_expected", iii_b_ii_expected_paths),
    ):
        expected_match = re.search(
            rf"{name} = \{{\n(?P<body>.*?)^\}}\n",
            value,
            re.MULTILINE | re.DOTALL,
        )
        if expected_match is None:
            raise ValueError(f"{name} scope contract missing")
        observed_paths = set(re.findall(
            r'^\s+"([^"]+)",$',
            expected_match.group("body"),
            re.MULTILINE,
        ))
        if observed_paths != expected_paths:
            raise ValueError(f"{name} scope contract drifted")
    for ceiling in ("3_700", "2_200"):
        if value.count(f"    {ceiling},\n") != 1:
            raise ValueError(f"iii-b ceiling {ceiling} contract drifted")


verify_scope_contract(scope)


def mutate_once(value, old, new, name):
    if value.count(old) != 1:
        raise SystemExit(f"cannot construct iii-b {name} spoof")
    return value.replace(old, new, 1)


