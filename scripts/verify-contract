emit("closed-image-removal", "app", app[:block.start()] + "".join(lines) + app[block.end():])
component_start = app.index("\nfunction verify_iic0biii2a_component_boundary() {")
component_end = app.index(
    "\nfunction verify_iib5biii_a_source_contract() {", component_start
)
projection_guard = '''            [[ "$(print -rn -- "$value" | shasum -a 256 | awk '{print $1}')" \\
                == "$expected" \\
                && "$(print -r -- "$value" | awk 'NF {n++} END {print n+0}')" \\
                    == "$expected_lines" ]] || {'''
if app[component_start:component_end].count(projection_guard) != 1:
    raise SystemExit("cannot construct ii-c0b-iii-2a mutation: projection-bypass")
mutated_projection = (
    app[:component_start]
    + app[component_start:component_end].replace(
        projection_guard,
        '''            [[ "$expected" == "$expected" \\
                && "$expected_lines" == "$expected_lines" ]] || {''',
        1,
    )
    + app[component_end:]
)
emit("projection-bypass", "app", mutated_projection)
PY

    local name='' kind='' expected='' target='' log='' staged_entry=''
    for fixture in \
        gate-extra-dependency:package:'ii-c0b-iii-2a Gate target dependency surface drifted' \
        gatesupport-extra-source:package:'ii-c0b-iii-2a GateSupport source inventory drifted' \
        entry-selector:entry:'ii-c0b-iii-2a entry surface drifted' \
        production-stub:entry:'ii-c0b-iii-2a entry surface drifted' \
        public-surface:transport:'ii-c0b-iii-2a package-only or Codable surface drifted' \
        codable-receipt:transport:'ii-c0b-iii-2a package-only or Codable surface drifted' \
        fixed-command-drift:transport:'ii-c0b-iii-2a fixed command or transport contract drifted' \
        darwin-authority-drift:darwin:'ii-c0b-iii-2a Darwin authority allowlist drifted' \
        signal-mask-restoration:darwin:'ii-c0b-iii-2a signal mask restoration drifted' \
        bootstrap-topology-bypass:darwin:'ii-c0b-iii-2a bootstrap topology drifted' \
        noninitial-stop-reap-bypass:darwin:'ii-c0b-iii-2a noninitial stop reap classification drifted' \
        pending-before-terminal-bypass:darwin:'ii-c0b-iii-2a pending-before-terminal ordering drifted' \
        prejoin-settlement-bypass:launcher:'ii-c0b-iii-2a pre-join settlement ordering drifted' \
        physical-matrix-vacuity:physical:'ii-c0b-iii-2a focused or physical coverage drifted' \
        argv-evidence-vacuity:physical:'ii-c0b-iii-2a independent argv or TTY evidence drifted' \
        tty-node-evidence-vacuity:physical:'ii-c0b-iii-2a independent argv or TTY evidence drifted'
    do
        name=${fixture%%:*}; local remainder=${fixture#*:}
        kind=${remainder%%:*}; expected=${remainder#*:}
        target="$out/iic0biii2a-$name"
        local candidate_package=$package candidate_transport=$transport
        local candidate_launcher=$launcher candidate_darwin=$darwin
        local candidate_entry=$entry candidate_physical=$physical_test
        local log="$out/$name.log"
        [[ $kind == package ]] && candidate_package=$target/${package:t}
        [[ $kind == transport ]] && candidate_transport=$target/${transport:t}
        [[ $kind == launcher ]] && candidate_launcher=$target/${launcher:t}
        [[ $kind == darwin ]] && candidate_darwin=$target/${darwin:t}
        [[ $kind == entry ]] && candidate_entry=$target/${entry:t}
        [[ $kind == physical ]] \
            && candidate_physical=$target/${physical_test:t}
        if "$gate" --iic0b-iii-2a-gate-contract-only \
            "$candidate_package" "$candidate_transport" \
            "$candidate_launcher" "$candidate_darwin" "$candidate_entry" \
            "$launcher_test" "$candidate_physical" "$stub" "$boundary" \
            >"$log" 2>&1
        then
            fail_contract "ii-c0b-iii-2a mutation accepted: $name"
        fi
        require_fixed_text "$log" "$expected"
    done

    for name in closed-image-removal projection-bypass; do
        local mutated_app="$out/iic0biii2a-$name"
        local mirror="$out/$name-root" log="$out/$name-app.log"
        mkdir -p "$mirror/scripts" \
            "$mirror/Sources/StornautInvestigationMachineGateSupport" \
            "$mirror/Tools/StornautInvestigationMachineGate" \
            "$mirror/Stornaut.xcodeproj"
        cp "$package" "$mirror/Package.swift"
        cp "$transport" "$mirror/$transport"
        cp "$launcher" "$mirror/$launcher"
        cp "$darwin" "$mirror/$darwin"
        cp "$entry" "$mirror/$entry"
        cp Stornaut.xcodeproj/project.pbxproj \
            "$mirror/Stornaut.xcodeproj/project.pbxproj"
        cp "$mutated_app" "$mirror/scripts/verify-app-release-boundaries"
        chmod 755 "$mirror/scripts/verify-app-release-boundaries"
        if (
            cd "$mirror"
            scripts/verify-app-release-boundaries \
                --iic0b-iii-2a-source-contract-only Package.swift \
                "$transport" "$launcher" "$darwin" "$entry" \
                scripts/verify-app-release-boundaries
        ) >"$log" 2>&1
        then
            fail_contract "ii-c0b-iii-2a App mutation accepted: $name"
        fi
        if [[ $name == closed-image-removal ]]; then
            require_fixed_text "$log" \
                "ii-c0b-iii-2a closed-image allowlist drifted"
        else
            require_fixed_text "$log" \
                "ii-c0b-iii-2a projection guard drifted"
        fi
    done

    local scan_fixture="$out/iic0biii2a-scan-fixture" scan_bin="$out/iic0biii2a-scan-bin" scan_log="$out/iic0biii2a-scan.log"; mkdir -p "$scan_bin"
    print -r -- 'not a real Mach-O; injected scanner commands own the result' \
        >"$scan_fixture"
    for name in symbol-failure string-failure; do
        cat >"$scan_bin/xcrun" <<'SH'
#!/bin/sh
tool=$1
shift
case "${STORNAUT_IIC0BIII2A_SCAN_FAILURE:?}:$tool" in
    symbol:nm|string:strings) exit 97 ;;
    *:nm) printf '%s\n' '_main' ;;
    *:swift-demangle) cat ;;
    *:strings) printf '%s\n' 'safe-string' ;;
    *) exit 98 ;;
esac
SH
        chmod 755 "$scan_bin/xcrun"
        local failure_kind=${name%-failure}
        if PATH="$scan_bin:$PATH" \
            STORNAUT_IIC0BIII2A_SCAN_FAILURE="$failure_kind" \
            "$app_gate" --iic0b-iii-2a-closed-image-scan-contract-only \
                "$scan_fixture" >"$scan_log" 2>&1
        then
            fail_contract "ii-c0b-iii-2a scanner mutation accepted: $name"
        fi
        require_fixed_text "$scan_log" \
            "ii-c0b-iii-2a closed-image $failure_kind scan failed"
    done
    local find_root="$out/iic0biii2a-find-root"; mkdir -p "$find_root"
    cat >"$scan_bin/find" <<'SH'
#!/bin/sh
exit 97
SH
    chmod 755 "$scan_bin/find"
    scan_log="$out/iic0biii2a-find-failure.log"
    if PATH="$scan_bin:$PATH" "$app_gate" \
        --iic0b-iii-2a-closed-image-scan-contract-only \
        "$find_root" >"$scan_log" 2>&1
    then
        fail_contract "ii-c0b-iii-2a scanner mutation accepted: find-failure"
    fi
    require_fixed_text "$scan_log" \
        "ii-c0b-iii-2a closed-image enumeration failed"
    rm -f "$scan_bin/find"; print -r -- fixture >"$find_root/file"
    print -r -- '#!/bin/sh' 'exit 97' >"$scan_bin/file"; chmod 755 "$scan_bin/file"
    scan_log="$out/iic0biii2a-file-failure.log"; if PATH="$scan_bin:$PATH" "$app_gate" \
        --iic0b-iii-2a-closed-image-scan-contract-only \
        "$find_root" >"$scan_log" 2>&1
    then
        fail_contract "ii-c0b-iii-2a scanner mutation accepted: file-failure"
    fi
    require_fixed_text "$scan_log" "ii-c0b-iii-2a closed-image type scan failed"

    local -a paths=(
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    local index="$out/scope.index" checkpoint_path mode blob
    GIT_INDEX_FILE="$index" git read-tree "$baseline^{tree}"
    for checkpoint_path in "${paths[@]}"; do
        mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
        blob=$(git hash-object -w -- "$checkpoint_path")
        GIT_INDEX_FILE="$index" git update-index --add \
            --cacheinfo "$mode,$blob,$checkpoint_path"
    done
    GIT_INDEX_FILE="$index" "$gate" \
        --iic0b-iii-2a-staged-scope-contract-only "$baseline" \
        >"$out/scope-canonical.log"
    local scope_budget
    scope_budget=$(sed -n \
        's/^[[:space:]]*local budget=\([0-9][0-9]*\)$/\1/p' "$gate")
    [[ $scope_budget == <-> ]] \
        || fail_contract "ii-c0b-iii-2a numeric checkpoint budget unavailable"
    local over_budget="$out/iic0biii2a-over-budget.swift" line
    for (( line = 0; line <= scope_budget; line++ )); do
        print -r -- "// ii-c0b-iii-2a over-budget $line"
    done >"$over_budget"
    local staged_divergence="$out/iic0biii2a-staged-divergence.swift"
    python3 - "$boundary" "$staged_divergence" <<'PY'
from pathlib import Path
import sys
source, output = map(Path, sys.argv[1:])
data = source.read_bytes()
old = b'"source-canonical.log"'
if data.count(old) != 1: raise SystemExit("cannot construct staged divergence")
output.write_bytes(data.replace(old, b'"source-canonical.l0g"', 1))
PY
    local worktree_probe=Tests/StornautInvestigationTests/InvestigationMachineGatePhysicalTests.swift
    local untracked_probe=".stornaut-iic0biii2a-untracked-$PPID-$RANDOM.swift"
    local worktree_original="$out/iic0biii2a-worktree-original"
    cp "$worktree_probe" "$worktree_original"
    [[ ! -e $untracked_probe ]] \
        || fail_contract "ii-c0b-iii-2a untracked mutation target exists"
    (
        function restore_scope_mutation() {
            cp "$worktree_original" "$worktree_probe"
            rm -f "$untracked_probe"
        }
        trap restore_scope_mutation EXIT
        trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
        print -r -- '// ii-c0b-iii-2a unrelated worktree mutation' \
            >>"$worktree_probe"
        log="$out/scope-worktree-path.log"
        if GIT_INDEX_FILE="$index" "$gate" \
            --iic0b-iii-2a-staged-scope-contract-only "$baseline" \
            >"$log" 2>&1
        then
            fail_contract "ii-c0b-iii-2a scope mutation accepted: worktree-path"
        fi
        require_fixed_text "$log" \
            "ii-c0b-iii-2a checkpoint worktree paths drifted"
        cp "$worktree_original" "$worktree_probe"
        print -r -- '// ii-c0b-iii-2a untracked mutation' >"$untracked_probe"
        log="$out/scope-untracked-path.log"
        if GIT_INDEX_FILE="$index" "$gate" \
            --iic0b-iii-2a-staged-scope-contract-only "$baseline" \
            >"$log" 2>&1
        then
            fail_contract "ii-c0b-iii-2a scope mutation accepted: untracked-path"
        fi
        require_fixed_text "$log" \
            "ii-c0b-iii-2a checkpoint untracked paths drifted"
    )
    local fixture='' changed='' scope_baseline=''
    for fixture in extra-path extra-doc extra-agents extra-readme missing-path \
        over-budget deleted deleted-doc binary mode wrong-baseline \
        staged-worktree-divergence
    do
        changed="$out/scope-$fixture.index"
        cp "$index" "$changed"
        scope_baseline=$baseline
        case $fixture in
            extra-path|extra-doc|extra-agents|extra-readme)
                local extra_source=AGENTS.md extra_target=iic0biii2a-extra.swift
                [[ $fixture == extra-doc ]] \
                    && { extra_source=docs/README.md; extra_target=docs/iic0biii2a-extra.md; }
                [[ $fixture == extra-agents ]] && extra_target=AGENTS.md
                [[ $fixture == extra-readme ]] \
                    && { extra_source=README.md; extra_target=README.md; }
                blob=$( { git show "${baseline}:$extra_source"; \
                    print -r -- '// ii-c0b-iii-2a scope drift'; } \
                    | git hash-object -w --stdin)
                GIT_INDEX_FILE="$changed" git update-index --add \
                    --cacheinfo "100644,$blob,$extra_target"
                GIT_INDEX_FILE="$changed" git diff --cached --quiet \
                    "$baseline" -- "$extra_target" \
                    && fail_contract "ii-c0b-iii-2a scope fixture is vacuous: $fixture"
                expected='ii-c0b-iii-2a checkpoint paths drifted' ;;
            missing-path)
                blob=$(git rev-parse "${baseline}:$boundary")
                GIT_INDEX_FILE="$changed" git update-index \
                    --cacheinfo "100644,$blob,$boundary"
                expected='ii-c0b-iii-2a checkpoint paths drifted' ;;
            over-budget)
                blob=$(git hash-object -w -- "$over_budget")
                GIT_INDEX_FILE="$changed" git update-index \
                    --cacheinfo "100644,$blob,$boundary"
                expected='ii-c0b-iii-2a checkpoint budget drifted' ;;
            deleted|deleted-doc)
                local deleted_target=$boundary
                [[ $fixture == deleted-doc ]] && deleted_target=docs/README.md
                GIT_INDEX_FILE="$changed" git rm --cached -q -f "$deleted_target"
                expected='ii-c0b-iii-2a checkpoint deleted an existing path' ;;
            binary)
                blob=$(git rev-parse \
                    "${baseline}:Tests/Fixtures/Snapshots/design-system.empty-state.dark.en.png")
                GIT_INDEX_FILE="$changed" git update-index \
                    --cacheinfo "100644,$blob,$boundary"
                expected='ii-c0b-iii-2a binary checkpoint path rejected' ;;
            mode)
                staged_entry=$(GIT_INDEX_FILE="$changed" git ls-files -s -- \
                    scripts/verify-contract)
                blob=$(print -r -- "$staged_entry" | awk '{print $2}')
                GIT_INDEX_FILE="$changed" git update-index \
                    --cacheinfo "100644,$blob,scripts/verify-contract"
                expected='ii-c0b-iii-2a checkpoint mode drifted: scripts/verify-contract' ;;
            wrong-baseline)
                scope_baseline="$baseline^"
                expected='ii-c0b-iii-2a checkpoint baseline drifted' ;;
            staged-worktree-divergence)
                blob=$(git hash-object -w -- "$staged_divergence")
                GIT_INDEX_FILE="$changed" git update-index \
                    --cacheinfo "100644,$blob,$boundary"
                expected="ii-c0b-iii-2a staged/worktree source drifted: $boundary" ;;
        esac
        log="$out/scope-$fixture.log"
        if GIT_INDEX_FILE="$changed" "$gate" \
            --iic0b-iii-2a-staged-scope-contract-only \
            "$scope_baseline" >"$log" 2>&1
        then
            fail_contract "ii-c0b-iii-2a scope mutation accepted: $fixture"
        fi
        require_fixed_text "$log" "$expected"
    done

}

function verify_iic0bivb1_contract() {
