    final-write-reclassification:entry:'iii-b2b-1b final output commitment drifted' \
    cancellation-precedence-bypass:entry:'iii-b2b-1b cancellation precedence drifted'
do
    name=${fixture%%:*}; remainder=${fixture#*:}
    kind=${remainder%%:*}; expected=${remainder#*:}
    require_iib5biii_b2b1b_mutation_rejected "$name" "$kind" "$expected"
done

# Verifier-only split scope: exact four paths and <= 1,200 changed lines.
# The completed implementation commit is immutable and replayed below.
iib5biii_b2b1b_paths=(
    "$iib5biii_b2b1b_boundary"
    scripts/verify-app-release-boundaries
    scripts/verify-contract
    scripts/verify-investigation-boundaries
)
(( ${#iib5biii_b2b1b_paths} == 4 )) \
    || fail_contract "iii-b2b-1b checkpoint path ceiling drifted"
[[ "$(git show -s --format=%P \
    "$iib5biii_b2b1b_implementation_commit")" == \
    "$iib5biii_b2b1b_baseline" ]] \
    || fail_contract "iii-b2b-1b implementation parent drifted"
[[ "$(git show -s --format=%T \
    "$iib5biii_b2b1b_implementation_commit")" == \
    "$iib5biii_b2b1b_implementation_tree" ]] \
    || fail_contract "iii-b2b-1b implementation tree drifted"
iib5biii_b2b1b_observed_paths=(
    ${(f)"$(git diff-tree --no-commit-id --name-only -r \
        "$iib5biii_b2b1b_implementation_commit" | LC_ALL=C sort)"}
)
iib5biii_b2b1b_expected_paths=("${(@on)iib5biii_b2b1b_paths}")
[[ "${(j:\n:)iib5biii_b2b1b_observed_paths}" == \
    "${(j:\n:)iib5biii_b2b1b_expected_paths}" ]] \
    || fail_contract "iii-b2b-1b implementation paths drifted"
iib5biii_b2b1b_implementation_lines=$(
    git diff-tree --numstat --no-commit-id -r \
        "$iib5biii_b2b1b_implementation_commit" \
        | awk 'index($3,"docs/")!=1 && $3!="AGENTS.md" && $3!="README.md" {n += $1 + $2} END {print n + 0}'
)
(( iib5biii_b2b1b_implementation_lines == 971 )) \
    || fail_contract "iii-b2b-1b implementation line count drifted"
python3 - "$iib5biii_b2b1b_implementation_commit" <<'PY'
from pathlib import Path
import hashlib
import subprocess
import sys

implementation = sys.argv[1]
expected = {
    "Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift":
        "e42cbe4a44a528a1660bf1abb93170c4556d84757d7d692cd1e9c4213276a4b8",
    "scripts/verify-app-release-boundaries":
        "a29b85249cb6be507b756ee4d04d5cf3c45894ae9a20ed34966cccf4176672cb",
    "scripts/verify-contract":
        "6256c53076f65043e4b1d45576224c443cecfb44e37f20157064bffa28d656a2",
    "scripts/verify-investigation-boundaries":
        "9c28eb37ec0d4c7386d50fae34ea6cee6410a3ebd71973cc026d2aab9a1bdacb",
}
for path, expected_sha256 in expected.items():
    completed = subprocess.run(
        ["git", "show", f"{implementation}:{path}"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False,
    )
    if completed.returncode != 0:
        raise SystemExit(
            f"iii-b2b-1b implementation source missing: {path}"
        )
    if hashlib.sha256(completed.stdout).hexdigest() != expected_sha256:
