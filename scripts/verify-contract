from pathlib import Path
import hashlib, re, sys
source_path, out = map(Path, sys.argv[1:])
source = source_path.read_text(encoding="utf-8")
carrier_pattern = r"(?m)^# iicb1_app_self_sha=[0-9a-f]{64}$"
def reseal(value):
    normalized, count = re.subn(carrier_pattern, "# iicb1_app_self_sha=SELF", value); assert count == 1
    return normalized.replace("# iicb1_app_self_sha=SELF", "# iicb1_app_self_sha=" + hashlib.sha256(normalized.encode()).hexdigest(), 1)
snapshot_start = source.index("\nfunction run_iicb1_root_owned_gate_component_snapshot() (") + 1; source_contract_start = source.index("\nfunction verify_iicb1_root_owned_gate_component_source_contract() {") + 1
