function verify_iib5biii_b2b1a1_staged_worktree_identity() {
    local checkpoint_path entry staged_blob worktree_blob
    for checkpoint_path in "$@"; do
        entry=$(git ls-files -s -- "$checkpoint_path")
        staged_blob=$(print -r -- "$entry" | awk '{print $2}')
        [[ -n $staged_blob ]] || {
            print -u2 "iii-b2b-1a-1 staged source missing: $checkpoint_path"
            return 1
        }
        worktree_blob=$(git hash-object -- "$checkpoint_path")
        [[ "$staged_blob" == "$worktree_blob" ]] || {
            print -u2 \
                "iii-b2b-1a-1 staged/worktree source drifted: $checkpoint_path"
            return 1
        }
    done
}
