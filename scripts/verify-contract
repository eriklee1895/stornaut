from pathlib import Path
import sys

bridge_path, test_path, root = map(Path, sys.argv[1:])
sources = {
    "bridge": bridge_path.read_text(encoding="utf-8"),
    "test": test_path.read_text(encoding="utf-8"),
}

def mutate(name, source_name, old, new, count=None):
    source = sources[source_name]
    observed = source.count(old)
    if observed == 0 or (count is not None and observed != count):
        raise SystemExit(
            f"cannot construct iii-b2b-1a-0 mutation: {name}"
        )
    (root / f"iib5biii-b2b1a0-{name}.swift").write_text(
        source.replace(old, new, 1), encoding="utf-8"
    )

mutate(
    "claim-evidence-digest-bypass", "bridge",
    "                claimEvidenceSHA256\n"
    "                    == .hashing(claimEvidenceBytes),",
    "                true,",
)
mutate(
    "claim-evidence-nonce-bypass", "bridge",
    "evidence.l1Residue.investigationUUID == selectionNonce",
    "true",
)
mutate(
    "coordinated-claim-evidence-tamper", "test",
    "physicalOwnershipRejectsCoordinatedForeignClaimEvidence",
    "physicalOwnershipCoordinatedTamperCoverageWasRemoved",
)
assertion = "            #expect(throws: (any Error).self) {\n"
if sources["test"].count(assertion) < 2:
    raise SystemExit(
        "cannot construct iii-b2b-1a-0 mutation: assertion-body-vacuity"
    )
(root / "iib5biii-b2b1a0-assertion-body-vacuity.swift").write_text(
    sources["test"].replace(assertion, "            if false {\n", 1),
    encoding="utf-8",
)
PY

