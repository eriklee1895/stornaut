    fi
    output="$contract_root/iib5bib1-$fixture.log"
    if GIT_INDEX_FILE="$index" "$iib5bib1_gate" \
        --iib5bib1-staged-scope-contract-only "$iib5bib1_baseline" \
        >"$output" 2>&1; then
        fail_contract "ii-b5b-i-b1 scope mutation accepted: $fixture"
