       "            let inventory = try at(.inventory, residue: residue) {",
       "            try system.createDirectory(parentDescriptor: baseDescriptor, "
       "name: request.attemptName, mode: 0o700)\n"
       "            let inventory = try at(.inventory, residue: residue) {",
       "ii-c0b-ii-b mutation before complete inventory drifted")
