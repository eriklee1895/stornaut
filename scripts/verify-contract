function require_iib5biii_b2a0_mutation_rejected() {
    local name=$1 source_kind=$2 expected=$3
    local composition=$iib5biii_b2a0_composition
    local continuity=$iib5biii_b2a0_continuity
    local bridge=$iib5biii_b2a0_bridge
    local focused_test=$iib5biii_b2a0_test
    local target="$contract_root/iib5biii-b2a0-$name.swift"
    [[ $source_kind == composition ]] && composition=$target
    [[ $source_kind == continuity ]] && continuity=$target
    [[ $source_kind == bridge ]] && bridge=$target
    [[ $source_kind == test ]] && focused_test=$target
    local output="$contract_root/iib5biii-b2a0-$name.log"
    if "$iib5biii_b2a0_gate" \
        --iib5biii-b2a0-physical-bridge-contract-only \
        "$composition" "$continuity" "$bridge" "$focused_test" \
        "$iib5biii_b2a0_boundary" >"$output" 2>&1
    then
        fail_contract "iii-b2a0 mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
}

