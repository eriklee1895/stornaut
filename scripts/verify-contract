function validate_machine_driver_packaging_contract() {
    python3 - <<'PY'
import re
import hashlib
from pathlib import Path

release = Path("scripts/verify-app-release-boundaries").read_text(
    encoding="utf-8"
)
installer = Path("scripts/stornaut-r5-local-lifecycle").read_text(
    encoding="utf-8"
)
driver = "StornautInvestigationMachineDriver"


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def flat(source):
    return re.sub(r"\s+", " ", source.replace("\\\n", " ")).strip()


def function_body(source, name):
    match = re.search(
        rf"(?ms)^{re.escape(name)}\(\) \{{\n(.*?)(?=^\}}\n\n)",
        source,
    )
    require(match is not None, f"missing function body: {name}")
    return match.group(1)


def require_order(source, markers, message):
    positions = [source.find(marker) for marker in markers]
    require(
        all(position >= 0 for position in positions)
        and positions == sorted(positions),
        message,
    )


require(
    release.startswith("#!/bin/zsh\n\nset -euo pipefail\n"),
    "App release boundary is not fail closed",
)
ordinary = re.search(
    r'(?ms)^for app_without_machine_driver in \\\n'
    r'(?P<header>.*?)\ndo\n(?P<body>.*?)\ndone\n',
    release,
)
require(ordinary is not None, "missing ordinary driver-absence loop")
require(
    re.findall(r'"\$([a-z_]+)"', ordinary.group("header"))
    == ["debug_app", "release_app"]
    and "diagnostic" not in ordinary.group("header"),
    "ordinary driver-absence loop must cover only debug_app/release_app",
)
ordinary_body = flat(ordinary.group("body"))
ordinary_path = "$app_without_machine_driver/Contents/MacOS/" + driver
for predicate in ("-e", "-L"):
    require(
        ordinary_body.count(
            f'test ! {predicate} "{ordinary_path}"'
        ) == 1,
        "ordinary Apps must reject a present file and symlink driver",
    )

release_flat = flat(release)
for contract in (
    f'diagnostic_machine_driver="$diagnostic_debug_app/Contents/MacOS/{driver}"',
    f'machine_driver_product="$diagnostic_derived_data/Build/Products/Debug/{driver}"',
    "machine_driver_max_bytes=$((16 * 1024 * 1024))",
    'test -f "$machine_driver_product"',
    'test -x "$diagnostic_machine_driver"',
    'test ! -L "$machine_driver_product"',
    'test ! -L "$diagnostic_machine_driver"',
    f'-name {driver} -print | /usr/bin/wc -l | tr -d \' \')" = 1',
    '/usr/bin/codesign --verify --deep --strict "$diagnostic_debug_app"',
):
    require(
        release_flat.count(contract) == 1,
        f"diagnostic driver membership contract drifted: {contract}",
    )

driver_loop = re.search(
    r'(?ms)^for machine_driver in "\$machine_driver_product" '
    r'"\$diagnostic_machine_driver"; do\n(?P<body>.*?)\ndone\n',
    release,
)
require(driver_loop is not None, "missing exact product/nested driver loop")
driver_loop_body = flat(driver_loop.group("body"))
for contract in (
    'test "$(/usr/bin/stat -f \'%HT\' "$machine_driver")" = "Regular File"',
    'test "$(/usr/bin/stat -f \'%Lp\' "$machine_driver")" = 755',
    'test "$(/usr/bin/stat -f \'%l\' "$machine_driver")" = 1',
    'machine_driver_bytes=$(/usr/bin/stat -f \'%z\' "$machine_driver")',
    "machine_driver_bytes <= machine_driver_max_bytes",
    'test "$(/usr/bin/lipo -archs "$machine_driver")" = arm64',
    '/usr/bin/codesign --verify --strict "$machine_driver"',
):
    require(
        driver_loop_body.count(contract) == 1,
        f"driver stat/architecture/signing contract drifted: {contract}",
    )

for contract in (
    'Identifier=com.eriklee.stornaut.investigation.machine-driver',
    'test "Identifier=$machine_driver_product_identifier" = "$expected_machine_driver_identifier_line"',
    'test "Identifier=$diagnostic_machine_driver_identifier" = "$expected_machine_driver_identifier_line"',
    'test "$diagnostic_machine_driver_cdhash" = "$machine_driver_product_cdhash"',
    'test "$diagnostic_machine_driver_requirement" = "$machine_driver_product_requirement"',
    'test "$diagnostic_machine_driver_sha256" = "$machine_driver_product_sha256"',
    'test "$diagnostic_machine_driver_identifier" = "$machine_driver_product_identifier"',
    "grep -Eq '^[0-9a-f]{40}([0-9a-f]{24})?$'",
    "grep -Eq '^[0-9a-f]{64}$'",
):
    require(
        release.count(contract) == 1,
        f"driver product/nested identity contract drifted: {contract}",
    )
require(
    release.count("designated => cdhash H") == 1
    and release.count("$machine_driver_product_cdhash") >= 2,
    "driver product designated requirement lost its exact CDHash binding",
)
for variable, artifact, extractor in (
    ("machine_driver_product_cdhash", "$machine_driver_product", "CDHash"),
    ("diagnostic_machine_driver_cdhash", "$diagnostic_machine_driver", "CDHash"),
    ("machine_driver_product_requirement", "$machine_driver_product", "-r-"),
    ("diagnostic_machine_driver_requirement", "$diagnostic_machine_driver", "-r-"),
    ("machine_driver_product_sha256", "$machine_driver_product", "shasum -a 256"),
    ("diagnostic_machine_driver_sha256", "$diagnostic_machine_driver", "shasum -a 256"),
):
    assignment = re.search(
        rf"(?ms)^{variable}=\$\(\n(?P<body>.*?)\n\)$",
        release,
    )
    require(
        assignment is not None
        and artifact in assignment.group("body")
        and extractor in assignment.group("body"),
        f"driver identity extraction drifted: {variable}",
    )

for marker in (
    "StornautExecution.",
    "StornautCore.ActionExecutor",
    "StornautCore.TrashMoving",
    "StornautCore.Cleanup",
    "StornautCore.ActionPolicy",
    "StornautCore.CleanupPolicy",
    "StornautCore.ExecutionAuthorization",
    "StornautCore.RegisteredAction",
    "StornautCore.MoveToTrash",
    "signedInvestigationRuntimeReady",
    "signedRuntimeReady",
    "Readiness",
    "readiness",
):
    require(
        f"    '{marker}'" in release,
        f"driver forbidden authority/readiness marker drifted: {marker}",
    )
symbol_scan = function_body(release, "mach_o_has_demangled_symbol")
scan_start = symbol_scan.find("if ! symbols=$(")
scan_end = symbol_scan.find('if [[ "$symbols" == *"$marker"* ]]')
require(
    scan_start >= 0 and scan_end > scan_start,
    "driver symbol scanner lost its checked command substitution",
)
scan_failure = symbol_scan[scan_start:scan_end]
for contract in (
    'xcrun nm -j "$file"',
    "xcrun swift-demangle",
    'print -u2 "Demangled symbol scan failed: $file"',
    "return 2",
):
    require(
        scan_failure.count(contract) == 1,
        f"driver symbol scan is not fail closed: {contract}",
    )
require(
    "continue" not in scan_failure and "|| true" not in scan_failure,
    "driver symbol scan regained an error bypass",
)
forbidden_loop = re.search(
    r'(?ms)^for marker in "\$\{machine_driver_authority_forbidden_markers\[@\]\}"; do\n'
    r'(?P<body>.*?)\ndone\n',
    release,
)
require(forbidden_loop is not None, "missing driver forbidden-symbol loop")
forbidden_body = flat(forbidden_loop.group("body"))
for contract in (
    'if mach_o_has_demangled_symbol "$diagnostic_machine_driver" "$marker"; then',
    'print -u2 "Authority or readiness leaked into Machine driver: $marker"',
    "else symbol_scan_status=$? fi",
    "if (( symbol_scan_status == 2 )); then exit 1 fi",
):
    require(
        forbidden_body.count(contract) == 1,
        f"driver forbidden-symbol loop is not fail closed: {contract}",
    )
for contract in (
    "machine_driver_authority_forbidden_imports=(",
    "machine_driver_required_readonly_imports=(",
    "expected_machine_driver_security_imports=$(\n",
    'xcrun nm -u -j "$diagnostic_machine_driver"',
    'grep -E \'^_(Sec|kSec|Authorization|CSSM)\'',
    'Machine driver Security import allowlist drifted.',
    'Machine driver read-only Darwin.open is missing.',
):
    require(
        contract in release,
        f"driver imported-symbol contract drifted: {contract}",
    )

require(
    installer.startswith("#!/bin/zsh\n\nset -euo pipefail\n"),
    "local lifecycle installer is not fail closed",
)
built = flat(function_body(installer, "validate_built_app"))
installed = flat(function_body(installer, "validate_installed_artifacts"))
install = flat(function_body(installer, "install"))
exact_metadata = function_body(installer, "exact_file_metadata")
bundle_permissions = function_body(installer, "validate_bundle_permissions")
identity = function_body(installer, "validate_machine_driver_identity")
artifact = function_body(installer, "validate_machine_driver_artifact")
fixtures = function_body(installer, "validate_machine_driver_fixtures")
fixtures_flat = flat(fixtures)

authorization = "I authorize one bounded disposable read-only Stornaut L3c3b-ii Machine driver validation."
require(
    f'machine_driver_validation_token="{authorization}"' in installer,
    "Machine driver validation token drifted",
)
for name in (
    "validate_machine_driver_identity",
    "validate_machine_driver_artifact",
    "validate_machine_driver_fixtures",
):
    require(
        installer.count(f"{name}() {{") == 1,
        f"Machine driver validation function drifted: {name}",
    )

for marker in (
    "/usr/bin/codesign -d --verbose=4",
    "Identifier=",
    "CDHash=",
    "/usr/bin/codesign -d -r-",
    "designated => cdhash H",
    "/usr/bin/shasum -a 256",
    "com.eriklee.stornaut.investigation.machine-driver",
    "$machine_claim_service",
):
    require(
        marker in identity,
        f"Machine driver static identity contract drifted: {marker}",
    )
for marker in (
    "exact_file_metadata",
    "/usr/bin/stat -f '%z'",
    "/usr/bin/lipo -archs",
    "/usr/bin/codesign --verify --strict",
    "validate_machine_driver_identity",
):
    require(
        marker in artifact,
        f"Machine driver artifact contract drifted: {marker}",
    )
for source_name, source in (
    ("exact_file_metadata", exact_metadata),
    ("validate_bundle_permissions", bundle_permissions),
):
    for marker in ("/bin/ls -lde", "acl_listing", "!= *$'\\n'*"):
        require(
            marker in source,
            f"extended ACL rejection drifted in {source_name}: {marker}",
        )
require(
    artifact.count("/usr/bin/stat -f '%d:%i'") >= 2
    and "sysopen -r -o nofollow" in artifact
    and "zstat -H descriptor_stat -f" in artifact,
    "Machine driver descriptor/node re-observation drifted",
)

for variable in (
    "temporary_root",
    "built_app",
    "staging_app",
    "installed_app",
):
    require(
        f'[[ "${variable}" == /* ]]' in fixtures_flat,
        f"Machine driver path lost absolute-path guard: {variable}",
    )
    require(
        f'canonical_{variable}=$(/bin/realpath "${variable}")'
        in fixtures_flat,
        f"Machine driver path lost canonical binding: {variable}",
    )

# path confinement: validation is limited to one exact canonical descendant of
# the repository .derivedData root, never /Library or another live system root.
fixtures_compact = re.sub(r"\s+", "", fixtures)
require(
    'canonical_validation_parent=$(/bin/realpath"$repo_root/.derivedData")'
    in fixtures_compact,
    "Machine driver repo-derived-data parent binding drifted",
)
for marker in (
    '[[ "$canonical_temporary_root" == "$canonical_validation_parent/"* ]]',
    '[[ "$canonical_temporary_root" != "$canonical_validation_parent" ]]',
    '[[ "$canonical_built_app" == "$canonical_temporary_root/"* ]]',
    '[[ "$canonical_staging_app" == "$canonical_temporary_root/"* ]]',
    '[[ "$canonical_installed_app" == "$canonical_temporary_root/"* ]]',
):
    require(
        marker in fixtures_flat,
        f"Machine driver repo-derived-data path confinement drifted: {marker}",
    )
for left, right in (
    ("built_app", "staging_app"),
    ("built_app", "installed_app"),
    ("staging_app", "installed_app"),
):
    require(
        f'[[ "$canonical_{left}" != "$canonical_{right}" ]]'
        in fixtures_flat,
        f"Machine driver validation planes are not distinct: {left}/{right}",
    )
require(
    fixtures.count("validate_machine_driver_artifact") == 3
    and "built_machine_driver_identity" in fixtures,
    "Machine driver validation lost the three-plane identity join",
)
require_order(
    fixtures_flat,
    (
        '[[ "$token" == "$machine_driver_validation_token" ]]',
        "canonical_validation_parent=",
        "canonical_temporary_root=",
        '[[ "$canonical_temporary_root" == "$canonical_validation_parent/"* ]]',
        "built_machine_driver_identity=",
        "staging_machine_driver_identity=",
        "installed_machine_driver_identity=",
        "lifecycle.local.machine-driver-validation=complete",
    ),
    "Machine driver path confinement or three-plane validation order drifted",
)

case_match = re.search(
    r'(?ms)^    validate-machine-driver\)\n(?P<body>.*?)^        ;;$',
    installer,
)
require(case_match is not None, "missing validate-machine-driver action")
validation_action = case_match.group("body")
require(
    "[[ $# == 6 ]]" in validation_action
    and 'validate_machine_driver_fixtures "$2" "$3" "$4" "$5" "$6"'
    in flat(validation_action),
    "validate-machine-driver argv contract drifted",
)

# no live action: the complete validation-only function closure and action may
# inspect disposable artifacts, but may not install, launch, execute, or mutate.
validation_only_forbidden = (
    "launchctl",
    "mkdir",
    "chown",
    "chmod",
    "ditto",
    "/bin/mv",
    "/bin/rm",
    "/usr/bin/install",
    "/Library/",
    "/private/var/",
    "posix_spawn",
    "exec ",
    "eval ",
    "xargs",
)
direct_driver_execution = re.compile(
        r'(?m)^[ \t]*"?\$(?:\{)?(?:driver|machine_driver)(?:\})?"?'
        r'[ \t]*(?:$|[;&|])'
)


def validation_only_violation(source):
    for forbidden in validation_only_forbidden:
        if forbidden in source:
            return forbidden
    if direct_driver_execution.search(source) is not None:
        return "direct-driver-execution"
    return None


validation_only = exact_metadata + identity + artifact + fixtures + validation_action
expected_installer_sha256 = (
    "3db2b0471504fde111f5fe610f516bb43a6b1f5e74ca800de8a2806f0d6ae8e6"
)
installer_sha256 = hashlib.sha256(installer.encode("utf-8")).hexdigest()
require(
    installer_sha256 == expected_installer_sha256,
    "whole installer source seal drifted",
)
require(
    validation_only_violation(validation_only) is None,
    "Machine driver validation gained live action: "
    + str(validation_only_violation(validation_only)),
)

# validation-only mutation negative control: a transitive helper mutation must
# fail the same closure gate even when it preserves the already-required mode.
mutation_anchor = "    local path=$1\n"
require(
    exact_metadata.count(mutation_anchor) == 1,
    "cannot construct validation-only mutation negative control",
)
mutated_exact_metadata = exact_metadata.replace(
    mutation_anchor,
    mutation_anchor + '    /bin/chmod 0755 "$path"\n',
    1,
)
require(
    validation_only_violation(
        mutated_exact_metadata
        + identity
        + artifact
        + fixtures
        + validation_action
    ) == "chmod",
    "validation-only mutation negative control was accepted",
)

# whole-installer generic mutation negative control: a previously unknown
# top-level mutator between functions must be rejected without name matching.
top_level_anchor = "}\n\nexact_directory_metadata() {"
require(
    installer.count(top_level_anchor) == 1,
    "cannot construct whole-installer generic mutation negative control",
)
generic_mutated_installer = installer.replace(
    top_level_anchor,
    "}\n\n"
    + 'if [[ "$action" == validate-machine-driver ]]; then\n'
    + '    /usr/bin/touch "$5/Contents/MacOS/'
    + 'StornautInvestigationMachineDriver"\n'
    + "fi\n\nexact_directory_metadata() {",
    1,
)
require(
    hashlib.sha256(generic_mutated_installer.encode("utf-8")).hexdigest()
    != expected_installer_sha256,
    "whole-installer generic mutation negative control was accepted",
)

for source, root in (
    (built, "built_app"),
    (install, "staging_app"),
    (installed, "installed_app"),
):
    path = f'$' + root + f'/Contents/MacOS/{driver}'
    require(
        f'validate_machine_driver_artifact "{path}"' in source,
        f"Machine driver phase admission drifted: {root}",
    )
    require(
        f'[[ ! -e "{path}"' not in source,
        f"Machine driver phase retained obsolete absence guard: {root}",
    )

require(
    "validate_built_app" not in installed and ".derivedData" not in installed,
    "installed Machine driver validation depends on a local build",
)
require(
    '[[ -n "$installed_machine_driver_identity" ]]' in installed
    and 'if [[ -n "$expected_machine_driver_identity" ]]' in installed,
    "installed Machine driver standalone/transaction identity split drifted",
)
require_order(
    install,
    (
        "built_machine_driver_identity=$(validate_built_app)",
        '/usr/bin/ditto --noqtn "$built_app" "$staging_app"',
        '/bin/chmod -RN "$staging_app"',
        'validate_bundle_permissions "$staging_app"',
        'validate_machine_driver_artifact "$staging_app/Contents/MacOS/',
        '/bin/mv -n "$staging_app" "$installed_app"',
        'validate_machine_driver_artifact "$installed_app/Contents/MacOS/',
        'validate_installed_artifacts "$built_machine_driver_identity"',
        '/bin/launchctl bootstrap system "$installed_plist"',
        'validate_installed_state "$built_machine_driver_identity"',
        'print "lifecycle.local.install=complete"',
    ),
    "Machine driver install transaction validation order drifted",
)

release_matrix = function_body(
    release, "verify_machine_driver_disposable_matrix"
)
require(
    authorization in release_matrix
    and "mktemp -d" in release_matrix
    and "trap" in release_matrix
    and release_matrix.count("validate-machine-driver") >= 6,
    "release disposable Machine driver matrix is incomplete",
)
for label in (
    "positive",
    "wrong-token",
    "outside-root",
    "duplicate-app",
    "identity-mismatch",
    "acl-mismatch",
):
    require(
        label in release_matrix.lower(),
        f"release disposable Machine driver matrix omitted {label}",
    )
for marker in (
    '/bin/chmod +a',
    'allow read,write',
    '$acl_mismatch_app/Contents/MacOS/StornautInvestigationMachineDriver',
):
    require(
        marker in release_matrix,
        f"release ACL negative control drifted: {marker}",
    )
for forbidden in (
    " launchctl",
    " install ;;",
    " uninstall ;;",
    " stornaut-r5-local-lifecycle install",
    " stornaut-r5-local-lifecycle uninstall",
):
    require(
        forbidden not in release_matrix,
        f"release disposable matrix gained live action: {forbidden}",
    )
PY
}

