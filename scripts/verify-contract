if rg -q --fixed-strings 'Verification passed in full mode.' \
    "$contract_root/exact.log"; then
    fail_contract "Exact verifier step claimed authoritative full success"
fi

receipt_failure_trace="$contract_root/receipt-failure.trace"
: > "$receipt_failure_trace"
receipt_failure_status=0
STORNAUT_VERIFY_CONTRACT_TRACE="$receipt_failure_trace" \
STORNAUT_VERIFY_CONTRACT_RECEIPT_STATUS=74 \
STORNAUT_VERIFY_CONTRACT_STAGE_STATUS=0 \
    "$contract_root/scripts/verify" \
    --full --step phase-c-trash-diagnostic-contract \
    >"$contract_root/receipt-failure.log" 2>&1 \
    || receipt_failure_status=$?
if (( receipt_failure_status != 74 )); then
    fail_contract \
        "Exact verifier step did not preserve receipt failure status"
fi
if [[ "$(<"$receipt_failure_trace")" != receipt ]]; then
    fail_contract "Exact verifier step ran after receipt preflight failed"
fi

diagnostic_contract_output="$contract_root/diagnostic-contract.log"
if "$contract_root/scripts/verify" --full \
    >"$diagnostic_contract_output" 2>&1
then
    fail_contract "Full verifier ignored a broken target-aware Trash contract"
fi
require_fixed_text "$diagnostic_contract_output" \
    '[verify][full] FAIL  phase-c-trash-diagnostic-contract'
if rg -q 'START ui-automation-readiness' "$diagnostic_contract_output"; then
    fail_contract \
        "Full verifier entered UI readiness after a broken Trash diagnostic contract"
fi

