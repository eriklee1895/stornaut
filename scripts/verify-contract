    ("component-symlink-vacuity", '        [[ -z $symlink ]] || {\n            print -u2 "ii-c-b1 closed image contains symlink: $symlink"\n            return 1\n        }', '        [[ -n $symlink ]] || {\n            print -u2 "ii-c-b1 closed image contains symlink: $symlink"\n            return 1\n        }'),
    ("component-symlink-reset-vacuity", '        symlink=$(find "$image" -type l -print -quit) || return $?\n        [[ -z $symlink ]] || {', '        symlink=$(find "$image" -type l -print -quit) || return $?\n        symlink=\n        [[ -z $symlink ]] || {'),
    ("component-provenance-reset-vacuity", '    local validation_source=${STORNAUT_VALIDATION_SOURCE:-}\n    [[ ${#validation_commit} == 40', '    local validation_source=${STORNAUT_VALIDATION_SOURCE:-}\n    validation_commit=\n    [[ ${#validation_commit} == 40'),
    ("component-provenance-head-vacuity", '    [[ $observed_commit == $validation_commit ]] || {', '    [[ -n $observed_commit ]] || {'),
    ("component-provenance-match-vacuity", '        /usr/bin/grep -Fqx -- "$marker" <<<"$strings" || {', '        /usr/bin/grep -Fq -- "$marker" <<<"$strings" || {'),
    ("component-validation-build-setting-vacuity", '        "STORNAUT_VALIDATION_COMMIT=$validation_commit"', '        "STORNAUT_VALIDATION_COMMIT="'),
    ("component-public-dispatch-vacuity", 'if $iicb1_root_owned_gate_component_boundary_only; then\n    run_iicb1_root_owned_gate_component_snapshot\n    print "ii-c-b1 root-owned Gate component boundary verification passed."\n    exit 0\nfi', 'if $iicb1_root_owned_gate_component_boundary_only; then\n    return 0\nfi'),
    ("component-snapshot-umask-vacuity", '    umask 022', '    umask 077'),
    ("component-source-git-env-vacuity", '        [[ $environment_name == GIT_* ]] && unset "$environment_name"', '        [[ $environment_name == STORNAUT_* ]] && unset "$environment_name"'),
    ("component-snapshot-early-return-vacuity", 'function run_iicb1_root_owned_gate_component_snapshot() (\n    umask 022', 'function run_iicb1_root_owned_gate_component_snapshot() (\n    return 0\n    umask 022'),
    ("component-source-contract-early-return-vacuity", "from pathlib import Path\nimport hashlib", "from pathlib import Path\nraise SystemExit(0)\nimport hashlib"),
