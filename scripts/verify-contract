       "        lock.withLock {\n            guard !consumed else { return false }\n            consumed = true\n            return true\n        }",
       "        lock.withLock {}\n        guard !consumed else { return false }\n        consumed = true\n        return true",
       "b3c-admission-relocated")
mutate(composition, "package enum InvestigationHandoffNoAuthRetirement",
       "public enum InvestigationHandoffNoAuthRetirement", "b3c-auth")
mutate(composition, "let returned = try await transport.startAndRetireWithEvidence()",
       "try await transport.writeLine(Data())\n        let returned = try await transport.startAndRetireWithEvidence()",
       "b3c-business-io")
mutate(composition, "let returned = try await transport.startAndRetireWithEvidence()",
       'let hidden = "\\(try await transport.writeLine(Data()))"\n        _ = hidden\n        let returned = try await transport.startAndRetireWithEvidence()',
       "b3c-interpolation")
mutate(composition, "guard wireSHA.lowercaseHex == machineSHA else {",
       "guard true else { // guard wireSHA.lowercaseHex == machineSHA else {",
       "b3c-digest")
mutate(composition,
       "guard machineDriverMatchesPeer(decoded.binding.machineDriver) else {",
       "guard true else { // guard machineDriverMatchesPeer(decoded.binding.machineDriver) else {",
       "b3c-peer-binding")
mutate(composition,
       "guard let stored = await evidenceStore.consume(), stored == returned else {",
       "guard true else { // guard let stored = await evidenceStore.consume(), stored == returned else {",
       "b3c-store")
mutate(composition,
       "let maximum = completed.addingReportingOverflow(30_000_000)",
       "let maximum = started.addingReportingOverflow(30_000_000)",
       "b3c-deadline-edge")
PY
