                print -r -- "// iii-b2b-1b over-budget $line"
            done >"$contract_root/iib5biii-b2b1b-over-budget.swift"
            blob=$(git hash-object -w -- \
                "$contract_root/iib5biii-b2b1b-over-budget.swift")
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,$iib5biii_b2b1b_boundary"
            expected='iii-b2b-1b checkpoint budget drifted' ;;
        deleted)
            GIT_INDEX_FILE="$index" git rm --cached -q -f \
                "$iib5biii_b2b1b_boundary"
            expected='iii-b2b-1b checkpoint deleted an existing path' ;;
        binary)
