    emit(
        name, "author",
        author_without_end[0]
        + f"private let iic0biForbiddenSelector = {selector}\n"
        + "#endif" + author_without_end[1],
    )
emit(
    "extension-wrapper", "author",
    author_without_end[0]
    + "package extension InvestigationProjectedCohortAuthor { func iic0biWrapper() {} }\n"
    + "#endif" + author_without_end[1],
