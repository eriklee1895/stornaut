#!/bin/zsh -f

set -euo pipefail

contract_source=${0:A}
# ib2_self_sha=bf3ef7a6ea7657571fce2143883d79badd8cfaf2518eabf90be7277b9ca9deb1
ib2_self_sha=$(sed -nE 's/^# ib2_self_sha=([0-9a-f]{64})$/\1/p' "$contract_source"); ib2_observed_sha=$(sed -E 's/^# ib2_self_sha=[0-9a-f]{64}$/# ib2_self_sha=SELF/' "$contract_source" | shasum -a 256 | awk '{ print $1 }')
[[ ${#ib2_self_sha} == 64 && "$ib2_observed_sha" == "$ib2_self_sha" ]] || { print -u2 "Machine claim verifier self-seal drifted"; exit 1; }
repo_root=${contract_source:h:h}
cd "$repo_root"
ib2_commit=08184b0a769d904b895636455688ada9e3c3e9e3
ib2_parent=147247ffadcb37c8a7ab83983bf884bd858ac51b
ib2_tree=2d9a22d0e9fc5158898fd3c2a304582c93ec8a94
[[ "$(git show -s --format=%P "$ib2_commit")" == "$ib2_parent" ]] \
    || { print -u2 "Machine claim verifier historical parent drifted"; exit 1; }
[[ "$(git show -s --format=%T "$ib2_commit")" == "$ib2_tree" ]] \
    || { print -u2 "Machine claim verifier historical tree drifted"; exit 1; }
ib2_paths=(${(f)"$(git diff-tree --no-commit-id --name-only -r "$ib2_commit")"})
[[ "${(j: :)ib2_paths}" == scripts/verify-contract ]] \
    || { print -u2 "Machine claim verifier historical scope drifted"; exit 1; }
ib2_lines=$(git diff-tree --numstat --no-commit-id -r "$ib2_commit" -- scripts/verify-contract | awk '{ total += $1 + $2 } END { print total + 0 }')
(( ib2_lines <= 400 )) \
    || { print -u2 "Machine claim verifier historical budget drifted"; exit 1; }
function fail_contract() {
    print -u2 -- "$1"
    exit 1
}

function require_fixed_text() {
    local target_file=$1
    local expected=$2

    if ! rg -q --fixed-strings -- "$expected" "$target_file"; then
        fail_contract "$target_file is missing verifier contract: $expected"
    fi
}

function replay_historical_contract() (
    local replay_root=$1 commit=$2 expected_tree=$3 mode=$4
    local required_marker=${5:-}
    function cleanup_registered_replay() {
        local replay_status=$? registration
        trap - EXIT INT TERM HUP
        git -C "$repo_root" worktree remove --force "$replay_root" >/dev/null 2>&1 \
            || { rm -rf -- "$replay_root" \
                && git -C "$repo_root" worktree prune >/dev/null 2>&1 \
                || exit 92; }
        [[ ! -e $replay_root ]] || exit 92
        registration=$(git -C "$repo_root" worktree list --porcelain) || exit 92
        print -r -- "$registration" | rg -q --fixed-strings -- \
            "worktree $replay_root" && exit 92
        exit $replay_status
    }
    trap cleanup_registered_replay EXIT
    trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
    git worktree add --detach --quiet "$replay_root" "$commit"
    [[ "$(git -C "$replay_root" show -s --format=%T HEAD)" == "$expected_tree" ]] \
        || return 91
    [[ -z $required_marker ]] || require_fixed_text \
        "$replay_root/scripts/verify-investigation-boundaries" \
        "$required_marker"
    cd "$replay_root"
    if [[ $mode == --iic0b-i-accepted ]]; then
        local author=Sources/StornautInvestigationDiagnostic/InvestigationProjectedCohortAuthor.swift composition=Sources/StornautInvestigationDiagnostic/InvestigationRuntimeDiagnosticComposition.swift test=Tests/StornautInvestigationTests/InvestigationProjectedCohortAuthorTests.swift boundary=Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift baseline=e5ed33e27195d9252f02a89ab39664df3848f1ed
        scripts/verify-investigation-boundaries --iic0b-i-producer-contract-only "$author" "$composition" "$test" "$boundary"; scripts/verify-app-release-boundaries --iic0b-i-source-contract-only "$author" "$composition" scripts/verify-app-release-boundaries; scripts/verify-investigation-boundaries --iic0b-i-staged-scope-contract-only "$baseline"
    elif [[ $mode == --iic-c-accepted ]]; then
        local historical_iicc_mode=--iic-c-contract-only
        STORNAUT_IICC_SKIP_COMPONENT_BUILD=1 \
            ./scripts/verify-contract "$historical_iicc_mode"
    else scripts/verify-contract "$mode"; fi
)

function verify_iic0biia_historical_contract() {
    local out=$1
    mkdir -p "$out"
    local baseline=fe3ea757432c4dc9cf960f210c167916697ce601
    local source=Sources/StornautInvestigationMachineLaunchSupport/InvestigationMachineGateOwnership.swift
    local test=Tests/StornautInvestigationTests/InvestigationMachineGateOwnershipTests.swift
    local probe=scripts/probe-investigation-capsule-lock
    local report=docs/reports/phase-d-task-39b2c-l3c3c-ii-c0b-ii-a1-review.md

    local a1=d18354bc7ca7dd2ddb04180298f9fb4f2e7c60e3
    local -a a1_paths=(Package.swift "$source" "$test")
    [[ "$(git show -s --format=%P "$a1")" == \
        842b8daf96e19d3e6f904851d4345543f0464b85 \
        && "$(git show -s --format=%T "$a1")" == \
        d6a4b0ea9f6ee53101fb986fdab5ac4b509de7ad ]] \
        || fail_contract "ii-c0b-ii-a1 immutable commit drifted"
    local -a a1_observed=(
        ${(f)"$(git diff-tree --no-commit-id --name-only -r "$a1" \
            | LC_ALL=C sort)"}
    )
    [[ "${(j:\n:)a1_observed}" == "${(j:\n:)${(@on)a1_paths}}" ]] \
        || fail_contract "ii-c0b-ii-a1 immutable paths drifted"
    [[ "$(git diff-tree --no-commit-id --numstat -r "$a1" \
        | awk '{n+=$1+$2} END{print n+0}')" == 1981 ]] \
        || fail_contract "ii-c0b-ii-a1 immutable line count drifted"
    [[ "$(git show "${a1}:Package.swift" | shasum -a 256 \
            | awk '{print $1}')" == \
            15bc5ce89b4a1c416df9c332cad2306cc26299f7903a0de15707f5e0cfbcab8f \
        && "$(git show "${a1}:$source" | shasum -a 256 \
            | awk '{print $1}')" == \
            eedda4e3a843a76898ddea4bc8fd243b6357efcbf17a4ea9e8438fdc0d561007 \
        && "$(git show "${a1}:$test" | shasum -a 256 \
            | awk '{print $1}')" == \
            9ffdfa9d956655b05cf9813658a0d00449f38a075f991737f460b2864c8a1e21 ]] \
        || fail_contract "ii-c0b-ii-a1 immutable source seal drifted"
    [[ "$(git show "${a1}:$probe" | shasum -a 256 \
        | awk '{print $1}')" == \
        731b613e4b8c1c5c09e34e412b5c7ea25630a8ac2f9e6549131482770bc0acf6 ]] \
        || fail_contract "ii-c0b-ii-a1 immutable probe identity drifted"
    local a1_report=$out/iic0biia1-review.md
    git show "${baseline}:$report" >"$a1_report" \
        || fail_contract "ii-c0b-ii-a1 recorded evidence is unavailable"
    [[ "$(shasum -a 256 "$a1_report" | awk '{print $1}')" == \
        1335b98893fe42c9aa1a377f29ee7d2d3f4742e0a76e26af6e4adbd016047fe5 ]] \
        || fail_contract "ii-c0b-ii-a1 recorded evidence drifted"
    require_fixed_text "$a1_report" \
        '| committed APFS probe | exit 0 on APFS / UID 501 / GID 20 |'
    require_fixed_text "$a1_report" \
        '| last-close evidence | normal exit, SIGKILL, dup and close-on-exec cases passed |'
    require_fixed_text "$a1_report" \
        'No staged serial, shared verifier, App/Xcode build or `scripts/verify --full`'
    require_fixed_text "$a1_report" \
        'a2 owns structural/mutation closure'

    local a2=f11eea42ef295f49b20e1c0f3912d4b32448b968
    local a2_tree=d0683495ea37d0692677c98f491f3037eaedba4c
    local boundary=Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
    local app_gate=scripts/verify-app-release-boundaries
    local contract=scripts/verify-contract
    local investigation_gate=scripts/verify-investigation-boundaries
    local -a a2_paths=("$boundary" "$app_gate" "$contract" "$investigation_gate")
    local -a a2_historical_modes=(
        --iic0b-ii-a-ownership-contract-only
        --iic0b-ii-a-staged-scope-contract-only
        --iic0b-ii-a-source-contract-only
        --iic0b-ii-a-component-boundary-only
    )
    (( ${#a2_historical_modes} == 4 )) \
        || fail_contract "ii-c0b-ii-a2 historical mode inventory drifted"
    [[ "$(git show -s --format=%P "$a2")" == \
        030b2805660cf2f9b17cd06f0cfa77d78490a8ec \
        && "$(git show -s --format=%T "$a2")" == "$a2_tree" ]] \
        || fail_contract "ii-c0b-ii-a2 immutable commit drifted"
    local -a a2_observed=(
        ${(f)"$(git diff-tree --no-commit-id --name-only -r "$a2" \
            | LC_ALL=C sort)"}
    )
    [[ "${(j:\n:)a2_observed}" == "${(j:\n:)${(@on)a2_paths}}" ]] \
        || fail_contract "ii-c0b-ii-a2 immutable paths drifted"
    [[ "$(git diff-tree --no-commit-id --numstat -r "$a2" \
        | awk '{n+=$1+$2} END{print n+0}')" == 889 ]] \
        || fail_contract "ii-c0b-ii-a2 immutable line count drifted"
    [[ "$(git show "${a2}:$boundary" | shasum -a 256 \
            | awk '{print $1}')" == \
            ee0ee2918638c1289c7e136a0aa552c36d54c0a1b163f1b7eb281859d397d4bf \
        && "$(git show "${a2}:$app_gate" | shasum -a 256 \
            | awk '{print $1}')" == \
            4015e672e3dd560735d78f5f118ca11dc980cb3778cae153f1d90a8139287ff9 \
        && "$(git show "${a2}:$contract" | shasum -a 256 \
            | awk '{print $1}')" == \
            0bc6acae096a3748ac2c29ab2db36370bde97c986dba812e92167082fa35ca87 \
        && "$(git show "${a2}:$investigation_gate" | shasum -a 256 \
            | awk '{print $1}')" == \
            41cb8dafbc8e0e7d817a9e6796284957a881429e8d6535d4f2f4678a3c3083bc ]] \
        || fail_contract "ii-c0b-ii-a2 immutable source seal drifted"

    local historical_root=$out/iic0biia2-history
    local historical=$historical_root/tree historical_status=0; mkdir -p "$historical_root"
    replay_historical_contract "$historical" "$a2" "$a2_tree" \
        --iic0b-ii-a-contract-only || historical_status=$?
    (( historical_status == 0 )) \
        || fail_contract "ii-c0b-ii-a2 historical replay failed"
}

function verify_iic0biia3_contract() {
    local out=$1
    local iic0biia3_baseline=fe3ea757432c4dc9cf960f210c167916697ce601
    local iic0biia3_tree=9533824602ff18b35581f191f9ff0140a52ec53c
    local iic0biia3_commit=128e37a045e8c362b5a98bc4198acc3715e0b29d
    local iic0biia3_completed_tree=16fafcbd621201612c939deeef682417682f352a
    [[ "$(git show -s --format=%P "$iic0biia3_commit")" == \
        "$iic0biia3_baseline" \
        && "$(git show -s --format=%T "$iic0biia3_commit")" == \
        "$iic0biia3_completed_tree" ]] \
        || fail_contract "ii-c0b-ii-a3 immutable checkpoint drifted"
    local replay_root="$out/historical-replay" replay_status=0
    replay_historical_contract "$replay_root" "$iic0biia3_commit" \
        "$iic0biia3_completed_tree" --iic0b-ii-a3-contract-only || replay_status=$?
    (( replay_status == 0 )) \
        || fail_contract "ii-c0b-ii-a3 historical replay failed"
    return 0

    local gate=scripts/verify-investigation-boundaries
    local app_gate=scripts/verify-app-release-boundaries
    local source=Sources/StornautInvestigationMachineLaunchSupport/InvestigationMachineGateOwnership.swift
    local test=Tests/StornautInvestigationTests/InvestigationMachineGateOwnershipTests.swift
    local boundary=Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
    local -a iic0biia3_component_command=(
        "$app_gate" --iic0b-ii-a3-component-boundary-only
    )
    local -a historical_evidence=(
        a1-source-identity
        a1-focused-test-identity
        a1-physical-probe-identity
        a2-historical-replay
    )
    (( ${#historical_evidence} == 4 )) \
        || fail_contract "ii-c0b-ii-a3 historical evidence inventory drifted"
    [[ "$(git rev-parse "$iic0biia3_baseline^{commit}")" == \
        "$iic0biia3_baseline" \
        && "$(git rev-parse "$iic0biia3_baseline^{tree}")" == \
        "$iic0biia3_tree" ]] \
        || fail_contract "ii-c0b-ii-a3 checkpoint baseline drifted"

    verify_iic0biia_historical_contract "$out/history"

    (( ${#iic0biia3_component_command} == 2 )) \
        || fail_contract "ii-c0b-ii-a3 component command drifted"
    [[ "$(rg -c --fixed-strings -- \
        "${iic0biia3_component_command[2]}" scripts/verify-contract)" == 1 ]] \
        || fail_contract \
            "ii-c0b-ii-a3 component boundary was executed or duplicated"
    require_fixed_text "$app_gate" \
        'if $iic0biia3_component_boundary_only; then'
    require_fixed_text "$app_gate" 'verify_iic0biia3_component_boundary'

    "$gate" --iic0b-ii-a3-retained-base-contract-only \
        "$source" "$test" "$boundary" >"$out/semantic.log"
    "$app_gate" --iic0b-ii-a3-source-contract-only \
        Package.swift "$source" "$app_gate" >"$out/source.log"

    mkdir -p "$out/candidates"
    python3 - "$source" "$out/candidates" <<'PY'
