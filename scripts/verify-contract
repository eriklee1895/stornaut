        GIT_INDEX_FILE="$temporary_index" git update-index --add \
            --cacheinfo "100644,$blob,AGENTS.md"
        GIT_INDEX_FILE="$temporary_index" git rm --cached -q -f AGENTS.md
        expected='ii-b3a staged checkpoint paths drifted'
    fi
