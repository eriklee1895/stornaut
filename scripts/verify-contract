value = copy.deepcopy(describe)
next(t for t in value["targets"] if t["name"] == "StornautInvestigationMachineClaimServer")["target_dependencies"].append("StornautCore")
mutations["dependency"] = (value, dump)
value = copy.deepcopy(dump)
next(p for p in value["products"] if p["name"] == "StornautInvestigationMachineClaimServer")["type"] = {"library": ["dynamic"]}
mutations["product"] = (describe, value)
value = copy.deepcopy(describe)
