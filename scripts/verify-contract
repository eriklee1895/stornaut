    "$app_peer_policy" "$app_peer_adapter" \
    >"$contract_root/app-peer-admission-canonical.log"
function require_app_peer_mutation_rejected() {
    local fixture_name=$1
    local policy_fixture=$2
    local adapter_fixture=$3
    local output="$contract_root/$fixture_name.log"
    if "$app_peer_gate" --app-peer-admission-contract-only \
        "$policy_fixture" "$adapter_fixture" >"$output" 2>&1
    then
        fail_contract "App peer admission mutation was accepted: $fixture_name"
    fi
}
python3 - \
    "$app_peer_policy" "$app_peer_adapter" "$contract_root" <<'PY'
from pathlib import Path
import sys

policy_path, adapter_path, output_root = map(Path, sys.argv[1:])
policy = policy_path.read_text(encoding="utf-8")
adapter = adapter_path.read_text(encoding="utf-8")

def mutate_once(value, old, new, name):
    if value.count(old) != 1:
        raise SystemExit(f"cannot construct App peer mutation: {name}")
    return value.replace(old, new, 1)

mutations = {
    "app-peer-public.swift": (policy, "package struct LifecycleMachineDriverPeerAdmissionEvidence", "public struct LifecycleMachineDriverPeerAdmissionEvidence"),
    "app-peer-wrapper.swift": (policy, "authorizeAndObserveStableEvidence(identity) != nil", "identity.effectiveUserID == 0"),
    "app-peer-provenance.swift": (policy, "This is current-peer evidence, not installer-authenticated provenance.", "Stable evidence."),
    "app-peer-second-signing.swift": (policy, "signingEvidence(contract.machineDriverExecutableURL)\n                == staticEvidence", "staticEvidence == staticEvidence"),
    "app-peer-fd.swift": (adapter, "package static let fixedDescriptor: Int32 = 7", "package static let fixedDescriptor: Int32 = 8"),
    "app-peer-bootstrap-window.swift": (adapter, "bootstrapWindowNanoseconds: UInt64 = 5_000_000_000", "bootstrapWindowNanoseconds: UInt64 = 6_000_000_000"),
    "app-peer-epoch-window.swift": (adapter, "maximumEpochWindowNanoseconds: UInt64 = 140_000_000_000", "maximumEpochWindowNanoseconds: UInt64 = 141_000_000_000"),
    "app-peer-order.swift": (adapter, "identity = try system.peerIdentity(Self.fixedDescriptor)", "identity = try system.peerIdentity(0)"),
    "app-peer-drop-order.swift": (adapter, "system.setGroupID(identity.groupID) == 0,\n          system.setUserID(identity.userID) == 0", "system.setUserID(identity.userID) == 0,\n          system.setGroupID(identity.groupID) == 0"),
    "app-peer-regain.swift": (adapter, "system.attemptSetEffectiveUserID(0)", "system.attemptSetEffectiveUserID(501)"),
    "app-peer-blocking.swift": (adapter, "private static let queue = DispatchQueue(", "private static let queue = DispatchSemaphore("),
}
for name, (source, old, new) in mutations.items():
    (output_root / name).write_text(
        mutate_once(source, old, new, name), encoding="utf-8"
    )
PY
for fixture in \
    app-peer-public app-peer-wrapper app-peer-provenance app-peer-second-signing
do
    require_app_peer_mutation_rejected "$fixture" \
        "$contract_root/$fixture.swift" "$app_peer_adapter"
done
for fixture in \
    app-peer-fd app-peer-bootstrap-window app-peer-epoch-window app-peer-order \
    app-peer-drop-order app-peer-regain app-peer-blocking
