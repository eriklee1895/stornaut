    ("component-positive-vacuity", "'StornautInvestigationMachineLaunchSupport.InvestigationFixedGateDarwinLifecycle.(validateExecutable'", "'StornautInvestigationMachineLaunchSupport.DisabledLifecycle.(validateExecutable'"),
