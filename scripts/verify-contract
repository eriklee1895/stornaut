from pathlib import Path
import re, sys
source_path, output_root = map(Path, sys.argv[1:])
source = source_path.read_text(encoding="utf-8")
start=source.index("iib5biii_b2b1a1_closed_images=(\n"); end=source.index("\n)\n",start)+3; block=source[start:end]; removed='    "$debug_app/Contents/MacOS/Stornaut"\n'
if block.count(removed)!=1: raise SystemExit("cannot construct iii-b2b-1a-1 Mach-O array mutation")
(output_root/"empty-closed").write_text(source[:start]+block.replace(removed,'',1)+source[end:],encoding="utf-8")
body=re.search(r"(?ms)^verify_iib5biii_b2b1a1_macho\(\) \{\n.*?^\}\n",source)
if body is None: raise SystemExit("cannot construct iii-b2b-1a-1 Mach-O mutation")
(output_root / "noop-body").write_text(source[:body.start()]
    + "verify_iib5biii_b2b1a1_macho() { : }\n" + source[body.end():],
    encoding="utf-8")
call="\nverify_iib5biii_b2b1a1_macho\n"
(output_root/"pre-call-exit").write_text(source.replace(call,"\nexit 0\n"+call,1),encoding="utf-8")
PY
