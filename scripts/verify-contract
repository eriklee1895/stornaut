    "lock-close-failure-swallowed",
    "        do { try system.close(descriptor: active.lockDescriptor) }\n"
    "        catch { succeeded = false }",
    "        do { try system.close(descriptor: active.lockDescriptor) }\n"
    "        catch {}",
)
insert(
    "duplicate-descriptor",
    "private func forbiddenDuplicate() { _ = dup(-1) }",
)
mutate(
    "child-inheritable-descriptor",
    "descriptorFlags & FD_CLOEXEC == FD_CLOEXEC",
    "descriptorFlags & FD_CLOEXEC == 0",
    count=2,
)
