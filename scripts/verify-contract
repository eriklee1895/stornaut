    ("counter-observation-cap", "lifecycle", "        while true {", "        var remainingObservations = 512\n        while true {\n            guard remainingObservations > 0 else { throw InvestigationFixedGateDarwinLifecycleSystemError.uncertain }\n            remainingObservations -= 1", "fixed-gate cleanup critical lifecycle code drifted"),
