    require(
        marker in artifact,
        f"Machine driver artifact contract drifted: {marker}",
    )
for source_name, source in (
    ("exact_file_metadata", exact_metadata),
    ("validate_bundle_permissions", bundle_permissions),
):
    for marker in ("/bin/ls -lde", "acl_listing", "!= *$'\\n'*"):
        require(
            marker in source,
            f"extended ACL rejection drifted in {source_name}: {marker}",
        )
require(
    artifact.count("/usr/bin/stat -f '%d:%i'") >= 2
    and "sysopen -r -o nofollow" in artifact
    and "zstat -H descriptor_stat -f" in artifact,
    "Machine driver descriptor/node re-observation drifted",
)

