    require(
        marker in release_matrix,
        f"release ACL negative control drifted: {marker}",
    )
for forbidden in (
    " launchctl",
    " install ;;",
    " uninstall ;;",
    " stornaut-r5-local-lifecycle install",
    " stornaut-r5-local-lifecycle uninstall",
):
