for fixture in \
    dependency:'ii-b5b-i-b2a dependency or framework surface drifted' \
    blocking-read:'ii-b5b-i-b2a authority or contract surface drifted' \
    manifest-type:'ii-b5b-i-b2a artifact contract drifted' \
    signing-requirement:'ii-b5b-i-b2a artifact contract drifted' \
    descriptor-revalidation:'ii-b5b-i-b2a descriptor revalidation drifted' \
