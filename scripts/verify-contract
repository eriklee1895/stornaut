    GIT_INDEX_FILE="$canonical_index" git read-tree "$(git write-tree)"
    function reject_iicb2a2_scope() {
        local label=$1 expected_text=$2; shift 2
        local output="$out/scope-$label.log"
        if "$@" >"$output" 2>&1; then
            fail_contract "ii-c-b2a2 scope mutation accepted: $label"
        fi
        [[ "$(<"$output")" == *"$expected_text"* ]] || fail_contract \
            "ii-c-b2a2 scope mutation diagnostic drifted: $label"
    }
    for fixture in extra-path over-budget deleted binary mode wrong-baseline \
        staged-worktree-divergence untracked
    do
        bad="$out/scope-$fixture.index"; cp "$canonical_index" "$bad"
        local scope_baseline=$baseline
        case $fixture in
            extra-path)
                blob=$(print extra | git hash-object -w --stdin)
                GIT_INDEX_FILE="$bad" git update-index --add --cacheinfo \
                    "100644,$blob,iicb2a2-extra.swift"
                expected='ii-c-b2a2 checkpoint path ceiling drifted' ;;
            over-budget)
                blob=$( { git show "$baseline:Tests/StornautInvestigationTests/InvestigationMachineCampaignEvidenceTests.swift";
                    for line in {1..2100}; do print "// ii-c-b2a2 $line"; done;
                } | git hash-object -w --stdin)
                GIT_INDEX_FILE="$bad" git update-index --cacheinfo \
                    "100644,$blob,Tests/StornautInvestigationTests/InvestigationMachineCampaignEvidenceTests.swift"
                expected='ii-c-b2a2 checkpoint budget drifted' ;;
            deleted)
                GIT_INDEX_FILE="$bad" git rm --cached -q -f \
                    Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
                expected='ii-c-b2a2 checkpoint deleted an existing path' ;;
            binary)
                blob=$(printf '\0ii-c-b2a2\n' | git hash-object -w --stdin)
                GIT_INDEX_FILE="$bad" git update-index --cacheinfo \
                    "100644,$blob,Tests/StornautInvestigationTests/InvestigationMachineCampaignEvidenceTests.swift"
                expected='ii-c-b2a2 binary checkpoint path rejected' ;;
            mode)
                blob=$(GIT_INDEX_FILE="$bad" git ls-files -s -- \
                    scripts/verify-investigation-runtime-machine-report | awk '{print $2}')
                GIT_INDEX_FILE="$bad" git update-index --cacheinfo \
                    "100644,$blob,scripts/verify-investigation-runtime-machine-report"
                expected='ii-c-b2a2 staged source/mode drifted:' ;;
            wrong-baseline)
                scope_baseline="$baseline^"
                expected='ii-c-b2a2 checkpoint baseline drifted' ;;
            staged-worktree-divergence)
                blob=$(print altered | git hash-object -w --stdin)
                GIT_INDEX_FILE="$bad" git update-index --cacheinfo \
                    "100755,$blob,scripts/verify-investigation-runtime-machine-report"
                expected='ii-c-b2a2 staged source/mode drifted:' ;;
            untracked)
                (
                    local probe=.stornaut-iicb2a2-untracked-$PPID-$RANDOM
                    trap 'rm -f -- "$probe"' EXIT INT TERM HUP
                    print untracked >"$probe"
                    reject_iicb2a2_scope "$fixture" \
                        'ii-c-b2a2 checkpoint untracked paths drifted' env \
                        GIT_INDEX_FILE="$bad" "$gate" \
                        --iic-b2a2-staged-scope-contract-only "$scope_baseline"
                )
                continue ;;
        esac
        reject_iicb2a2_scope "$fixture" "$expected" env \
            GIT_INDEX_FILE="$bad" "$gate" \
            --iic-b2a2-staged-scope-contract-only "$scope_baseline"
    done
}

