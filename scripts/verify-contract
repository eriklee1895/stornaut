    )
    (( ${#implementation_paths} == 4 )) \
        || fail_contract "ii-c0b-iii-2a implementation path count drifted"
    [[ "$(git show -s --format=%P "$implementation")" == \
        "$implementation_parent" ]] \
        || fail_contract "ii-c0b-iii-2a implementation parent drifted"
    [[ "$(git show -s --format=%T "$implementation")" == \
        "$implementation_tree" ]] \
        || fail_contract "ii-c0b-iii-2a implementation tree drifted"
    local -a observed_paths=(
        ${(f)"$(git diff-tree --no-commit-id --name-only -r \
            "$implementation" | LC_ALL=C sort)"}
    )
    [[ "${(j:\n:)observed_paths}" == \
        "${(j:\n:)${(@on)implementation_paths}}" ]] \
        || fail_contract "ii-c0b-iii-2a implementation paths drifted"
    local implementation_lines=$(git diff-tree --no-commit-id --numstat -r \
        "$implementation" | awk '{n+=$1+$2} END{print n+0}')
    (( implementation_lines == 1797 )) \
        || fail_contract "ii-c0b-iii-2a implementation line count drifted"
    local checkpoint_path expected_mode observed_mode expected_sha observed_sha
    for checkpoint_path expected_sha in \
        "${implementation_paths[1]}" 586f58adabe748551dcef53be3e3746c445fe4127b967d10cce4ddd94760fd08 \
        "${implementation_paths[2]}" f680802bc44b9a02d7b8af91ec9ed996f859cbe8fd5ae53c1ee1be310e502b0a \
        "${implementation_paths[3]}" 449af3fbde599bf6a5fdad1668eedba441ca381c41a31ead6e1e90aa541858e1 \
        "${implementation_paths[4]}" 43544e99add08781aa9a628d4db22e53f4befbcca99c07be4c4833247b55776a
    do
        expected_mode=100644; [[ $checkpoint_path == scripts/* ]] \
            && expected_mode=100755
        observed_mode=$(git ls-tree "$implementation" -- "$checkpoint_path" \
            | awk '{print $1}')
        [[ $observed_mode == $expected_mode ]] \
            || fail_contract "ii-c0b-iii-2a implementation mode drifted: $checkpoint_path"
        observed_sha=$(git show "${implementation}:$checkpoint_path" \
            | shasum -a 256 | awk '{print $1}')
        [[ $observed_sha == $expected_sha ]] \
            || fail_contract "ii-c0b-iii-2a implementation source seal drifted: $checkpoint_path"
