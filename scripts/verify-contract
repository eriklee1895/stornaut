function require_iic0bi_mutation_rejected() {
    local name=$1 kind=$2 expected=$3
    local author=$iic0bi_author composition=$iic0bi_composition
    local focused_test=$iic0bi_focused_test
    local target="$contract_root/iic0bi-$name.swift"
    [[ $kind == author ]] && author=$target
    [[ $kind == composition ]] && composition=$target
    [[ $kind == test ]] && focused_test=$target
    local output="$contract_root/iic0bi-$name.log"
    if "$iic0bi_gate" --iic0b-i-producer-contract-only \
        "$author" "$composition" "$focused_test" "$iic0bi_boundary" \
        >"$output" 2>&1
    then
        fail_contract "ii-c0b-i mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
    if [[ $kind == author || $kind == composition ]]; then
        local app_root="$contract_root/iic0bi-$name-app-root"
        mkdir -p \
            "$app_root/Sources/StornautInvestigationDiagnostic" \
            "$app_root/scripts"
        cp "$iic0bi_author" \
            "$app_root/Sources/StornautInvestigationDiagnostic/InvestigationProjectedCohortAuthor.swift"
        cp "$iic0bi_composition" \
            "$app_root/Sources/StornautInvestigationDiagnostic/InvestigationRuntimeDiagnosticComposition.swift"
        cp scripts/verify-app-release-boundaries \
            "$app_root/scripts/verify-app-release-boundaries"
        if [[ $kind == author ]]; then
            cp "$target" \
                "$app_root/Sources/StornautInvestigationDiagnostic/InvestigationProjectedCohortAuthor.swift"
        else
            cp "$target" \
                "$app_root/Sources/StornautInvestigationDiagnostic/InvestigationRuntimeDiagnosticComposition.swift"
        fi
        output="$contract_root/iic0bi-$name-app.log"
        if (
            cd "$app_root"
            scripts/verify-app-release-boundaries \
                --iic0b-i-source-contract-only \
                Sources/StornautInvestigationDiagnostic/InvestigationProjectedCohortAuthor.swift \
                Sources/StornautInvestigationDiagnostic/InvestigationRuntimeDiagnosticComposition.swift \
                scripts/verify-app-release-boundaries
        ) >"$output" 2>&1
        then
            fail_contract "ii-c0b-i App mutation accepted: $name"
        fi
        require_fixed_text "$output" "$expected"
    fi
}
for fixture in \
    public-author:author:'ii-c0b-i package-only or Codable surface drifted' \
    codable-binding:author:'ii-c0b-i package-only or Codable surface drifted' \
    debug-guard-bypass:author:'ii-c0b-i author DEBUG boundary drifted' \
    injectable-production-constructor:author:'ii-c0b-i injectable production constructor drifted' \
    second-scenario-mapping:composition:'ii-c0b-i scenario mapping ownership drifted' \
    production-call-site:composition:'ii-c0b-i producer gained premature production call site' \
    extension-wrapper:author:'ii-c0b-i producer gained premature production call site' \
    stored-wrapper-call-site:author:'ii-c0b-i producer gained premature production call site' \
    internal-wrapper-call-site:author:'ii-c0b-i producer gained premature production call site' \
    data-extension-wrapper:author:'ii-c0b-i producer gained premature production call site' \
    data-static-wrapper:author:'ii-c0b-i producer source seal drifted' \
    authority-import:author:'ii-c0b-i dependency surface drifted' \
    command-line-selector:author:'ii-c0b-i producer gained prohibited authority' \
    command-line-argc-selector:author:'ii-c0b-i producer gained prohibited authority' \
    command-line-unsafe-argv-selector:author:'ii-c0b-i producer gained prohibited authority' \
    process-arguments-selector:author:'ii-c0b-i producer gained prohibited authority' \
    environment-selector:author:'ii-c0b-i producer gained prohibited authority' \
    user-defaults-selector:author:'ii-c0b-i producer gained prohibited authority' \
    libc-environment-selector:author:'ii-c0b-i producer gained prohibited authority' \
    focused-test-vacuity:test:'ii-c0b-i focused tests became vacuous' \
    installed-binding-test-vacuity:test:'ii-c0b-i focused tests became vacuous' \
    focused-assertion-vacuity:test:'ii-c0b-i focused test source seal drifted'
do
    name=${fixture%%:*}; remainder=${fixture#*:}
    kind=${remainder%%:*}; expected=${remainder#*:}
    require_iic0bi_mutation_rejected "$name" "$kind" "$expected"
done

iic0bi_paths=(
    "$iic0bi_author"
    "$iic0bi_composition"
    "$iic0bi_focused_test"
    "$iic0bi_boundary"
    scripts/verify-app-release-boundaries
    scripts/verify-contract
    scripts/verify-investigation-boundaries
)
iic0bi_index="$contract_root/iic0bi.index"
GIT_INDEX_FILE="$iic0bi_index" git read-tree "$iic0bi_baseline^{tree}"
for checkpoint_path in "${iic0bi_paths[@]}"; do
    blob=$(git hash-object -w -- "$checkpoint_path")
    mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
    GIT_INDEX_FILE="$iic0bi_index" git update-index --add \
        --cacheinfo "$mode,$blob,$checkpoint_path"
done
GIT_INDEX_FILE="$iic0bi_index" "$iic0bi_gate" \
    --iic0b-i-staged-scope-contract-only "$iic0bi_baseline" \
    >"$contract_root/iic0bi-scope-canonical.log"
for fixture in extra-path missing-path over-budget deleted binary mode wrong-baseline; do
    index="$contract_root/iic0bi-scope-$fixture.index"
    cp "$iic0bi_index" "$index"
    baseline=$iic0bi_baseline
    case $fixture in
        extra-path)
            blob=$(git rev-parse "${iic0bi_baseline}:AGENTS.md")
            GIT_INDEX_FILE="$index" git update-index --add --cacheinfo \
                "100644,$blob,iic0bi-extra.swift"
            expected='ii-c0b-i checkpoint paths drifted' ;;
        missing-path)
            GIT_INDEX_FILE="$index" git rm --cached -q -f "$iic0bi_author"
            expected='ii-c0b-i checkpoint paths drifted' ;;
        over-budget)
            for line in {1..2000}; do
                print -r -- "// ii-c0b-i over-budget $line"
            done >"$contract_root/iic0bi-over-budget.swift"
            blob=$(git hash-object -w -- "$contract_root/iic0bi-over-budget.swift")
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,$iic0bi_author"
            expected='ii-c0b-i checkpoint budget drifted' ;;
        deleted)
            GIT_INDEX_FILE="$index" git rm --cached -q -f "$iic0bi_composition"
            expected='ii-c0b-i checkpoint deleted an existing path' ;;
        binary)
            blob=$(git rev-parse \
                "${iic0bi_baseline}:Tests/Fixtures/Snapshots/design-system.empty-state.dark.en.png")
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,$iic0bi_author"
            expected='ii-c0b-i binary checkpoint path rejected' ;;
        mode)
            entry=$(GIT_INDEX_FILE="$index" git ls-files -s -- scripts/verify-contract)
            blob=$(print -r -- "$entry" | awk '{print $2}')
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,scripts/verify-contract"
            expected='ii-c0b-i checkpoint mode drifted: scripts/verify-contract' ;;
        wrong-baseline)
            baseline="$iic0bi_baseline^"
            expected='ii-c0b-i checkpoint baseline drifted' ;;
    esac
    output="$contract_root/iic0bi-scope-$fixture.log"
    if GIT_INDEX_FILE="$index" "$iic0bi_gate" \
        --iic0b-i-staged-scope-contract-only "$baseline" \
        >"$output" 2>&1
    then
        fail_contract "ii-c0b-i scope mutation accepted: $fixture"
    fi
    require_fixed_text "$output" "$expected"
done
fi

