from pathlib import Path
import sys

app_path, outer_path, composition_path, root = map(Path, sys.argv[1:])
sources = {
    "app": app_path.read_text(encoding="utf-8"),
    "outer": outer_path.read_text(encoding="utf-8"),
    "composition": composition_path.read_text(encoding="utf-8"),
}

def mutate(name, kind, old, new, count=1):
    source = sources[kind]
    if source.count(old) != count:
        raise SystemExit(f"cannot construct iii-b2b-1a-1 mutation: {name}")
    (root / f"iib5biii-b2b1a1-{name}.swift").write_text(
        source.replace(old, new, 1), encoding="utf-8"
    )

mutate(
    "same-version-identity-drift", "app",
    "            observed.auditSessionID == expected.auditSessionID,",
    "            true,",
)
mutate(
    "canonical-evidence-bypass", "outer",
    "    guard let evidenceBytes = try? evidence.encoded() else { return false }",
    "    let evidenceBytes = Data(repeating: 1, count: 32)",
)
mutate(
    "zero-request-binding-bypass", "outer",
    "        && evidence.requestBindingSHA256.rawBytes.contains { $0 != 0 }",
    "        && true",
)
mutate(
    "shared-driver-digest-bypass", "outer",
    "        guard finalDigest == owned.driverSHA256 else {",
    "        guard finalDigest.rawBytes.contains(where: { $0 != 0 }) else {",
)
mutate(
    "terminalizing-reentrancy-bypass", "outer",
    "        guard case .terminalizing = state else {",
    "        guard case .owned = state else {",
)
mutate(
    "epoch-deadline-bypass", "outer",
    "            finalObservedAt < deadlineNanoseconds",
    "            finalObservedAt <= deadlineNanoseconds",
)
mutate(
    "admission-pre-mint-cancellation-bypass", "outer",
    "        try ensureNotCancelled()\n        state = .terminal\n        return try .init(",
    "        state = .terminal\n        return try .init(",
)
mutate(
    "same-observer-factory-bypass", "composition",
    "            sharedObserver: observer,",
    "            ownershipObserver: observer,\n"
    "            terminalObserver: InvestigationMachineDarwinOuterObserver(\n"
    "                clock: clock, outerProcessID: outerProcessID\n"
    "            ),",
)
PY

function require_iib5biii_b2b1a1_mutation_rejected() {
    local name=$1 kind=$2 expected=$3
    local app=$iib5biii_b2b1a1_app_identity
    local outer=$iib5biii_b2b1a1_outer
    local composition=$iib5biii_b2b1a1_composition
    local target="$contract_root/iib5biii-b2b1a1-$name.swift"
    [[ $kind == app ]] && app=$target
    [[ $kind == outer ]] && outer=$target
    [[ $kind == composition ]] && composition=$target
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$target"
    local output="$contract_root/iib5biii-b2b1a1-$name.log"
    if "$iib5biii_b2b1a1_gate" \
        --iib5biii-b2b1a1-outer-observation-contract-only \
        "$app" "$outer" "$composition" \
        "$iib5biii_b2b1a1_focused" "$iib5biii_b2b1a1_boundary" \
        >"$output" 2>&1
    then
        fail_contract "iii-b2b-1a-1 mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
}
for fixture in \
    same-version-identity-drift:app:'iii-b2b-1a-1 same-version identity drift acceptance' \
    canonical-evidence-bypass:outer:'iii-b2b-1a-1 canonical claim evidence binding drifted' \
    zero-request-binding-bypass:outer:'iii-b2b-1a-1 canonical claim evidence binding drifted' \
    shared-driver-digest-bypass:outer:'iii-b2b-1a-1 terminal state machine drifted' \
    terminalizing-reentrancy-bypass:outer:'iii-b2b-1a-1 terminal state machine drifted' \
    epoch-deadline-bypass:outer:'iii-b2b-1a-1 terminal state machine drifted' \
    admission-pre-mint-cancellation-bypass:outer:'iii-b2b-1a-1 terminal state machine drifted' \
    same-observer-factory-bypass:composition:'iii-b2b-1a-1 production observer factory drifted'
do
    name=${fixture%%:*}; remainder=${fixture#*:}
    kind=${remainder%%:*}; expected=${remainder#*:}
    require_iib5biii_b2b1a1_mutation_rejected "$name" "$kind" "$expected"
done

iib5biii_b2b1a1_paths=(
    "$iib5biii_b2b1a1_app_identity"
    "$iib5biii_b2b1a1_outer"
    "$iib5biii_b2b1a1_composition"
    "$iib5biii_b2b1a1_focused"
    "$iib5biii_b2b1a1_boundary"
    scripts/verify-app-release-boundaries
    scripts/verify-contract
    scripts/verify-investigation-boundaries
)
(( ${#iib5biii_b2b1a1_paths} == 8 )) \
    || fail_contract "iii-b2b-1a-1 checkpoint path ceiling drifted"
iib5biii_b2b1a1_index="$contract_root/iib5biii-b2b1a1.index"
GIT_INDEX_FILE="$iib5biii_b2b1a1_index" \
    git read-tree "$iib5biii_b2b1a1_baseline^{tree}"
GIT_INDEX_FILE="$iib5biii_b2b1a1_index" \
    git add -- "${iib5biii_b2b1a1_paths[@]}"
GIT_INDEX_FILE="$iib5biii_b2b1a1_index" \
    "$iib5biii_b2b1a1_gate" \
    --iib5biii-b2b1a1-staged-scope-contract-only \
    "$iib5biii_b2b1a1_baseline" \
    >"$contract_root/iib5biii-b2b1a1-scope-canonical.log"
for line in {1..3000}; do
    print -r -- "// iii-b2b-1a-1 over-budget $line"
done >"$contract_root/iib5biii-b2b1a1-over-budget.swift"
print -r -- 'import Foundation' \
    >"$contract_root/iib5biii-b2b1a1-staged-divergence.swift"
for fixture in extra-path over-budget deleted binary mode wrong-baseline \
    missing-required-path staged-worktree-divergence
do
    index="$contract_root/iib5biii-b2b1a1-$fixture.index"
    cp "$iib5biii_b2b1a1_index" "$index"
    baseline=$iib5biii_b2b1a1_baseline
    case $fixture in
        extra-path)
            blob=$(git rev-parse "${iib5biii_b2b1a1_baseline}:AGENTS.md")
            GIT_INDEX_FILE="$index" git update-index --add \
                --cacheinfo "100644,$blob,iii-b2b-1a-1-extra.swift"
            expected='iii-b2b-1a-1 staged checkpoint paths drifted' ;;
        over-budget)
            blob=$(git hash-object -w -- \
                "$contract_root/iib5biii-b2b1a1-over-budget.swift")
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,$iib5biii_b2b1a1_focused"
            expected='iii-b2b-1a-1 checkpoint budget drifted' ;;
        deleted)
            GIT_INDEX_FILE="$index" git rm --cached -q -f \
                "$iib5biii_b2b1a1_app_identity"
            expected='iii-b2b-1a-1 checkpoint deleted an existing path' ;;
        binary)
            blob=$(git rev-parse \
                "${iib5biii_b2b1a1_baseline}:Tests/Fixtures/Snapshots/design-system.empty-state.dark.en.png")
            GIT_INDEX_FILE="$index" git update-index --add --cacheinfo \
                "100644,$blob,$iib5biii_b2b1a1_outer"
            expected='iii-b2b-1a-1 binary checkpoint path rejected' ;;
        mode)
            entry=$(GIT_INDEX_FILE="$index" git ls-files -s -- \
                scripts/verify-contract)
            blob=$(print -r -- "$entry" | awk '{print $2}')
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,scripts/verify-contract"
            expected='iii-b2b-1a-1 checkpoint mode drifted: scripts/verify-contract' ;;
        wrong-baseline)
            baseline="$iib5biii_b2b1a1_baseline^"
            expected='iii-b2b-1a-1 checkpoint baseline drifted' ;;
        missing-required-path)
            GIT_INDEX_FILE="$index" git rm --cached -q -f \
                "$iib5biii_b2b1a1_outer"
            expected='iii-b2b-1a-1 staged checkpoint paths drifted' ;;
        staged-worktree-divergence)
            blob=$(git hash-object -w -- \
                "$contract_root/iib5biii-b2b1a1-staged-divergence.swift")
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,$iib5biii_b2b1a1_outer"
            expected="iii-b2b-1a-1 staged/worktree source drifted: $iib5biii_b2b1a1_outer" ;;
    esac
    output="$contract_root/iib5biii-b2b1a1-scope-$fixture.log"
    if GIT_INDEX_FILE="$index" "$iib5biii_b2b1a1_gate" \
        --iib5biii-b2b1a1-staged-scope-contract-only "$baseline" \
        >"$output" 2>&1
    then
        fail_contract "iii-b2b-1a-1 scope mutation accepted: $fixture"
    fi
    require_fixed_text "$output" "$expected"
done

print "Verifier mode and CI contract verification passed."
