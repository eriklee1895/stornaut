function require_iib5biii_a_mutation_rejected() {
    local name=$1 source_kind=$2
    local single=$iib5biii_a_single
    local composition=$iib5biii_a_composition
    local continuity=$iib5biii_a_continuity
    local continuity_test=$iib5biii_a_continuity_test
    local target="$contract_root/iib5biii-a-$name.swift"
    [[ $source_kind == single ]] && single=$target
    [[ $source_kind == composition ]] && composition=$target
    [[ $source_kind == continuity ]] && continuity=$target
    [[ $source_kind == continuity_test ]] && continuity_test=$target
    xcrun swiftc -frontend -parse "$target"
    local output="$contract_root/iib5biii-a-$name.log"
    if "$iib5biii_a_gate" --iib5biii-a-single-epoch-contract-only \
        "$single" "$composition" "$continuity" \
        "$continuity_test" "$iib5biii_a_single_test" \
        "$iib5biii_a_installed_join_test" "$iib5biii_a_boundary" \
        >"$output" 2>&1
    then
        fail_contract "iii-a mutation accepted: $name"
    fi
    require_fixed_text "$output" 'iii-a'
}

