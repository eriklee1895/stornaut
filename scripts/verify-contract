function require_claim_asid_mutation_rejected() {
    local fixture_name=$1
    local fixture_path=$2
    local output="$contract_root/$fixture_name.log"
    if "$claim_asid_gate" --claim-asid-contract-only \
        "$fixture_path" >"$output" 2>&1
    then
        fail_contract "Claim ASID mutation was accepted: $fixture_name"
    fi
}
python3 - \
    "$claim_contract_source" \
    "$contract_root/claim-asid-comment.swift" \
    "$contract_root/claim-asid-string.swift" \
    "$contract_root/claim-asid-reversed.swift" <<'PY'
from pathlib import Path
import sys

source_path, comment_path, string_path, reversed_path = map(Path, sys.argv[1:])
source = source_path.read_text(encoding="utf-8")


def mutate_once(value, old, new, name):
    if value.count(old) != 1:
        raise SystemExit(f"cannot construct {name} mutation")
    return value.replace(old, new, 1)


comment_path.write_text(
    mutate_once(
        source,
        "            l1Residue.auditSessionID == "
        "helperIdentity.auditSessionID,",
        "            // l1Residue.auditSessionID == "
        "helperIdentity.auditSessionID,",
        "comment-only required join",
    ),
    encoding="utf-8",
)
string_path.write_text(
    mutate_once(
        source,
        "        helperAuditSessionID = helperIdentity.auditSessionID",
        "        let ignoredASIDContract = \"helperAuditSessionID = "
        "helperIdentity.auditSessionID\"",
        "string-only required assignment",
    ),
    encoding="utf-8",
)
reversed_path.write_text(
    mutate_once(
        source,
        "            helperIdentity.effectiveUserID == 0\n"
        "        else {",
        "            helperIdentity.effectiveUserID == 0,\n"
        "            helperIdentity.auditSessionID == "
        "appIdentity.auditSessionID\n"
        "        else {",
        "reversed invalid ASID equality",
    ),
    encoding="utf-8",
)
PY
require_claim_asid_mutation_rejected \
    claim-asid-comment "$contract_root/claim-asid-comment.swift"
require_claim_asid_mutation_rejected \
    claim-asid-string "$contract_root/claim-asid-string.swift"
require_claim_asid_mutation_rejected \
    claim-asid-reversed "$contract_root/claim-asid-reversed.swift"

