def mutation(name, old, new, text=source):
    if text.count(old) != 1:
        raise SystemExit(f"cannot construct ii-b5b-ii-a mutation: {name}")
    (root / f"iib5biia-{name}.swift").write_text(
        text.replace(old, new, 1), encoding="utf-8"
    )


