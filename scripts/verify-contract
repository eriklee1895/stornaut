    ("delayed-test-vacuity", "focused", "system.inventoryResponses.count > 512", "true", "fixed-gate cleanup focused tests became vacuous"),
    ("deadline-test-vacuity", "focused", "lifecycle.replay?.processGroupEmpty == false", "true", "fixed-gate cleanup focused tests became vacuous"),
