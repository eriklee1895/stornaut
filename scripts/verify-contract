    ("verifier-vnode-linearization", "verifier", '        require(change_queue.control(None, 1, 0) == [],\n                "evidence changed during verification")', '        require(True, "evidence changed during verification")'),
    ("verifier-vnode-watch-registration", "verifier", 'require(change_queue.control([event], 0, 0) == [], "vnode watch registration")', 'require(True, "vnode watch registration")'),
    ("producer-canonical-reencode", "contract", "value.artifacts == entries, try value.encoded() == data", "value.artifacts == entries, true"),
    ("boundary-assertion-vacuity", "boundary", '] { #expect(verifier.contains(marker)) }', '] { #expect(true) }'),
