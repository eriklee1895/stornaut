        GIT_INDEX_FILE="$temporary_index" git update-index \
            --cacheinfo "100644,$blob,Sources/StornautInvestigationDiagnostic/InvestigationHandoffAppLeafAdapter.swift"
        expected='ii-b3a staged checkpoint budget drifted'
