function require_claim_server_mutation_rejected() {
    local fixture_name=$1
    local adapter_fixture=$2
    local effects_fixture=$3
    local deadline_fixture=$4
    local expected_diagnostic=$5
    local output="$contract_root/$fixture_name.log"
    if "$claim_server_gate" --claim-server-contract-only \
        "$adapter_fixture" \
        "$effects_fixture" \
        "$deadline_fixture" >"$output" 2>&1
    then
        fail_contract "Machine claim server mutation was accepted: $fixture_name"
    fi
    require_fixed_text "$output" "$expected_diagnostic"
}
