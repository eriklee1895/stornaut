    chmod 755 "$bin/xcrun"; reject closed-image-live-namespace 'forbidden namespace or receipt domain leaked' env PATH="$bin:$PATH" STORNAUT_IVB2_SCAN_SYMBOL='StornautInvestigationMachineGateCoordinatorSupport.fake' scripts/verify-app-release-boundaries --iic0b-iii-2a-closed-image-scan-contract-only "$scan"
    reject closed-image-live-domain 'forbidden namespace or receipt domain leaked' env PATH="$bin:$PATH" STORNAUT_IVB2_SCAN_STRING='stornaut.task39.machine.gate-coordinator-receipt.v1' scripts/verify-app-release-boundaries --iic0b-iii-2a-closed-image-scan-contract-only "$scan"
