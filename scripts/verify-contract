import hashlib
import re
import sys
source_path, out = Path(sys.argv[1]), Path(sys.argv[2])
source = source_path.read_text(encoding="utf-8")
carrier = r"(?m)^# iicb1_app_self_sha=[0-9a-f]{64}$"
def reseal(value):
    normalized, count = re.subn(carrier, "# iicb1_app_self_sha=SELF", value)
    if count != 1: raise SystemExit("cannot reseal b2a2 component mutation")
