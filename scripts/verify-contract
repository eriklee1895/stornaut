    local name kind expected target target_sha log rc
    while IFS=$'\t' read -r name kind expected; do
        target="$out/$name.swift"
        target_sha=$(shasum -a 256 "$target" | awk '{print $1}')
        local -a args=("$lifecycle" "$focused" "$boundary" "$darwin")
