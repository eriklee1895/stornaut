#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"
ib2_commit=08184b0a769d904b895636455688ada9e3c3e9e3
ib2_parent=147247ffadcb37c8a7ab83983bf884bd858ac51b
ib2_tree=2d9a22d0e9fc5158898fd3c2a304582c93ec8a94
[[ "$(git show -s --format=%P "$ib2_commit")" == "$ib2_parent" ]] \
    || { print -u2 "Machine claim verifier historical parent drifted"; exit 1; }
[[ "$(git show -s --format=%T "$ib2_commit")" == "$ib2_tree" ]] \
    || { print -u2 "Machine claim verifier historical tree drifted"; exit 1; }
ib2_paths=(${(f)"$(git diff-tree --no-commit-id --name-only -r "$ib2_commit")"})
[[ "${(j: :)ib2_paths}" == scripts/verify-contract ]] \
    || { print -u2 "Machine claim verifier historical scope drifted"; exit 1; }
ib2_lines=$(git diff-tree --numstat --no-commit-id -r "$ib2_commit" -- scripts/verify-contract | awk '{ total += $1 + $2 } END { print total + 0 }')
(( ib2_lines <= 400 )) \
    || { print -u2 "Machine claim verifier historical budget drifted"; exit 1; }
ib2_self_sha=c911d0c5caadfc628cda6c6fb780d831e7b819ef2a867cfcc45cf71edb9c4cfc
ib2_observed_sha=$(sed -E 's/^ib2_self_sha=.*/ib2_self_sha=SELF/' scripts/verify-contract | shasum -a 256 | awk '{ print $1 }')
[[ "$ib2_observed_sha" == "$ib2_self_sha" ]] \
    || { print -u2 "Machine claim verifier self-seal drifted"; exit 1; }

function fail_contract() {
    print -u2 -- "$1"
    exit 1
}

function require_fixed_text() {
    local target_file=$1
    local expected=$2

    if ! rg -q --fixed-strings -- "$expected" "$target_file"; then
        fail_contract "$target_file is missing verifier contract: $expected"
    fi
}

