    require(
        marker in identity,
        f"Machine driver static identity contract drifted: {marker}",
    )
for marker in (
    "exact_file_metadata",
    "/usr/bin/stat -f '%z'",
    "/usr/bin/lipo -archs",
    "/usr/bin/codesign --verify --strict",
    "validate_machine_driver_identity",
