        && projection="$contract_root/$fixture.swift" \
        || intake="$contract_root/$fixture.swift"
    for gate in semantic app; do
        output="$contract_root/$fixture-$gate.log"
        if [[ $gate == semantic ]]; then
            "$iic0a_gate" --iic0a-projection-capsule-contract-only \
                "$projection" "$intake" "$iic0a_transport_test" \
                "$iic0a_intake_test" "$iic0a_boundary" \
                >"$output" 2>&1 && \
                fail_contract "ii-c0a write mutation accepted: $fixture/$gate"
        else
            "$iic0a_app_gate" --iic0a-source-contract-only \
                "$projection" "$intake" >"$output" 2>&1 && \
                fail_contract "ii-c0a write mutation accepted: $fixture/$gate"
        fi
        require_fixed_text "$output" 'ii-c0a'
    done
done
