function require_iib5biii_b2a_iia1v_mutation_rejected() {
    local name=$1 kind=$2 expected=$3
    local session=$iib5biii_b2a_iia1v_semantic_session
    local focused=$iib5biii_b2a_iia1v_semantic_test
    local target="$contract_root/iib5biii-b2a-ii-a1v-$name.swift"
    [[ $kind == session ]] && session=$target
    [[ $kind == test ]] && focused=$target
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$target"
    local output="$contract_root/iib5biii-b2a-ii-a1v-$name.log"
    if "$iib5biii_b2a_iia1v_semantic_gate" \
        --iib5biii-b2a-ii-a1v-contract-only \
        "$session" "$iib5biii_b2a_iia1v_semantic_observer" "$focused" \
        "$iib5biii_b2a_iia1v_semantic_boundary" >"$output" 2>&1
    then
        fail_contract "iii-b2a-ii-a1-v mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
}
