mutate(
    "reversed-close-order",
    "        do { try system.close(descriptor: active.baseDescriptor) }\n"
    "        catch { succeeded = false }\n"
    "        do { try system.close(descriptor: active.lockDescriptor) }\n"
    "        catch { succeeded = false }",
    "        do { try system.close(descriptor: active.lockDescriptor) }\n"
    "        catch { succeeded = false }\n"
    "        do { try system.close(descriptor: active.baseDescriptor) }\n"
    "        catch { succeeded = false }",
)
mutate(
    "base-close-failure-short-circuit",
    "        do { try system.close(descriptor: active.baseDescriptor) }\n"
    "        catch { succeeded = false }",
    "        do { try system.close(descriptor: active.baseDescriptor) }\n"
    "        catch { return false }",
)
