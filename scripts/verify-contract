function require_iib5biii_b2a_iia2ii_mutation_rejected() {
    local name=$1 kind=$2 expected=$3
    local composition=$iib5biii_b2a_iia2ii_semantic_composition
    local session=$iib5biii_b2a_iia2ii_semantic_session
    local protocol=$iib5biii_b2a_iia2ii_semantic_protocol
    local retirement=$iib5biii_b2a_iia2ii_semantic_retirement
    local composition_test=$iib5biii_b2a_iia2ii_semantic_composition_test
    local target="$contract_root/iib5biii-b2a-ii-a2ii-$name.swift"
    [[ $kind == composition ]] && composition=$target
    [[ $kind == session ]] && session=$target
    [[ $kind == protocol ]] && protocol=$target
    [[ $kind == retirement ]] && retirement=$target
    [[ $kind == composition-test ]] && composition_test=$target
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$target"
    local output="$contract_root/iib5biii-b2a-ii-a2ii-$name.log"
    if run_iib5biii_b2a_iia2ii_contract \
        "$composition" "$session" "$protocol" "$retirement" \
        "$composition_test" "$iib5biii_b2a_iia2ii_semantic_session_test" \
        "$iib5biii_b2a_iia2ii_semantic_protocol_test" \
        "$iib5biii_b2a_iia2ii_semantic_retirement_test" \
        "$iib5biii_b2a_iia2ii_semantic_boundary" >"$output" 2>&1
    then
        fail_contract "iii-b2a-ii-a2-ii mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
}

for fixture in \
    outer-order-observation:composition:'iii-b2a-ii-a2-ii outer protocol order drifted' \
    outer-init-widening:composition:'iii-b2a-ii-a2-ii outer composition initializer drifted' \
    terminal-proof-to-bool:composition:'iii-b2a-ii-a2-ii terminal absence proof drifted' \
