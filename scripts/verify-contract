#!/bin/zsh

set -euo pipefail

repo_root=${0:A:h:h}
cd "$repo_root"
ib2_commit=08184b0a769d904b895636455688ada9e3c3e9e3
ib2_parent=147247ffadcb37c8a7ab83983bf884bd858ac51b
ib2_tree=2d9a22d0e9fc5158898fd3c2a304582c93ec8a94
[[ "$(git show -s --format=%P "$ib2_commit")" == "$ib2_parent" ]] \
    || { print -u2 "Machine claim verifier historical parent drifted"; exit 1; }
[[ "$(git show -s --format=%T "$ib2_commit")" == "$ib2_tree" ]] \
    || { print -u2 "Machine claim verifier historical tree drifted"; exit 1; }
ib2_paths=(${(f)"$(git diff-tree --no-commit-id --name-only -r "$ib2_commit")"})
[[ "${(j: :)ib2_paths}" == scripts/verify-contract ]] \
    || { print -u2 "Machine claim verifier historical scope drifted"; exit 1; }
ib2_lines=$(git diff-tree --numstat --no-commit-id -r "$ib2_commit" -- scripts/verify-contract | awk '{ total += $1 + $2 } END { print total + 0 }')
(( ib2_lines <= 400 )) \
    || { print -u2 "Machine claim verifier historical budget drifted"; exit 1; }
ib2_self_sha=2ac44f468c14ded604d0530e8b6b967098ead2b7747f2ede3afc8deb434f7ae4
ib2_observed_sha=$(sed -E 's/^ib2_self_sha=.*/ib2_self_sha=SELF/' scripts/verify-contract | shasum -a 256 | awk '{ print $1 }')
[[ "$ib2_observed_sha" == "$ib2_self_sha" ]] \
    || { print -u2 "Machine claim verifier self-seal drifted"; exit 1; }

function fail_contract() {
    print -u2 -- "$1"
    exit 1
}

function require_fixed_text() {
    local target_file=$1
    local expected=$2

    if ! rg -q --fixed-strings -- "$expected" "$target_file"; then
        fail_contract "$target_file is missing verifier contract: $expected"
    fi
}

function verify_immutable_historical_checkpoints() {
    local historical_root
    historical_root=$(mktemp -d "${TMPDIR:-/tmp}/stornaut-historical-contract.XXXXXX")
    local historical_status=0

    local iib0a_commit=35946583cfb286dd2ac20aab23fe12668f232d83
    local iib0a_parent=376f451f8ceb693e8ef6ed27b18d961ea57cc051
    local iib0a_tree=35883fc2c06be3c48c9e05f6cefeb6de40430dce
    local iib0a_paths=(
        Package.swift
        Sources/StornautInvestigationHandoffContract/HandoffBinaryTranscript.swift
        Sources/StornautInvestigationHandoffContract/InvestigationCohortCapsuleContract.swift
        Sources/StornautInvestigationHandoffContract/InvestigationHandoffFrameContract.swift
        Tests/StornautInvestigationTests/InvestigationHandoffTransportContractTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    [[ "$(git show -s --format=%P "$iib0a_commit")" == "$iib0a_parent" ]] \
        || { print -u2 "ii-b0a historical parent drifted"; historical_status=1; }
    [[ "$(git show -s --format=%T "$iib0a_commit")" == "$iib0a_tree" ]] \
        || { print -u2 "ii-b0a historical tree drifted"; historical_status=1; }
    local iib0a_observed_paths=(${(f)"$(git diff-tree --no-commit-id --name-only -r "$iib0a_commit" | LC_ALL=C sort)"})
    local iib0a_expected_paths=("${(@on)iib0a_paths}")
    [[ "${(j:\n:)iib0a_observed_paths}" == "${(j:\n:)iib0a_expected_paths}" ]] \
        || { print -u2 "ii-b0a historical paths drifted"; historical_status=1; }
    local iib0a_lines
    iib0a_lines=$(git diff-tree --numstat --no-commit-id -r "$iib0a_commit" \
        | awk '{n += $1 + $2} END {print n + 0}')
    (( iib0a_lines == 2366 )) \
        || { print -u2 "ii-b0a historical line count drifted"; historical_status=1; }

    local iib0a_index=$historical_root/iib0a.index
    local iib0a_root=$historical_root/iib0a
    mkdir -p "$iib0a_root"
    GIT_INDEX_FILE="$iib0a_index" git read-tree "$iib0a_commit^{tree}" \
        || historical_status=$?
    GIT_INDEX_FILE="$iib0a_index" git checkout-index --all \
        --prefix="$iib0a_root/" || historical_status=$?
    if (( historical_status == 0 )); then
        python3 - "$iib0a_root" "${iib0a_paths[@]}" <<'PY' \
            || historical_status=$?
from pathlib import Path
import hashlib
import re
import stat
import sys

root = Path(sys.argv[1])
paths = sys.argv[2:]
if len(paths) != 9:
    raise SystemExit("ii-b0a historical path cardinality drifted")
for relative in paths:
    path = root / relative
    expected_mode = 0o755 if relative.startswith("scripts/") else 0o644
    if stat.S_IMODE(path.stat().st_mode) != expected_mode:
        raise SystemExit(f"ii-b0a historical mode drifted: {relative}")
expected_scripts = {
    "scripts/verify-contract":
        "62af998814ff277766cdc506bb90089afbc87edbf0e466d3f0f33cdb73ad0b1a",
    "scripts/verify-investigation-boundaries":
        "7884823783a3aabef297020cd2c814f994d2a3c0d554572051b815e74c85789b",
    "scripts/verify-app-release-boundaries":
        "52f5a3faa50102fc100235450b73abe03fb6b4b496bc2454894795c3f6236724",
}
for relative, expected in expected_scripts.items():
    observed = hashlib.sha256((root / relative).read_bytes()).hexdigest()
    if observed != expected:
        raise SystemExit(f"ii-b0a historical script SHA drifted: {relative}")

package = (root / "Package.swift").read_text(encoding="utf-8")
if package.count('name: "StornautInvestigationHandoffContract"') != 1:
    raise SystemExit("ii-b0a historical package target drifted")
if package.count('"StornautInvestigationHandoffContract"') != 2:
    raise SystemExit("ii-b0a historical package consumer drifted")
if '.product(name: "StornautInvestigationHandoffContract"' in package:
    raise SystemExit("ii-b0a historical package product drifted")
source_root = root / "Sources/StornautInvestigationHandoffContract"
expected_sources = {
    "HandoffBinaryTranscript.swift": {"CryptoKit", "Foundation"},
    "InvestigationCohortCapsuleContract.swift": {"Foundation"},
    "InvestigationHandoffFrameContract.swift": {"Foundation"},
}
if {path.name for path in source_root.iterdir()} != set(expected_sources):
    raise SystemExit("ii-b0a historical source allowlist drifted")
for name, expected_imports in expected_sources.items():
    source = (source_root / name).read_text(encoding="utf-8")
    imports = set(re.findall(r"(?m)^import\s+([A-Za-z0-9_]+)\s*$", source))
    if imports != expected_imports or "public " in source:
        raise SystemExit(f"ii-b0a historical source surface drifted: {name}")
    forbidden = re.search(
        r"\b(?:Codable|NSXPC|Process|FileManager|URLSession|posix_spawn|"
        r"O_WRONLY|O_RDWR|O_CREAT|Darwin\.write)\b|import\s+Stornaut",
        source,
    )
    if forbidden:
        raise SystemExit(f"ii-b0a historical authority drifted: {name}")
PY
        zsh -n "$iib0a_root/scripts/verify-contract" \
            "$iib0a_root/scripts/verify-investigation-boundaries" \
            "$iib0a_root/scripts/verify-app-release-boundaries" \
            || historical_status=$?
        if (( historical_status == 0 )); then
            (
                cd "$iib0a_root"
                scripts/verify-investigation-boundaries || exit $?
            ) || historical_status=$?
        fi
    fi

    local iib5biid_commit=d89d201448a99281a554d9b3fca00512b4f0c0be
    local iib5biid_parent=47f2715f9dc1a835aa769290b1b581b38066f04c
    local iib5biid_tree=6c82ece7639e4335dbbb40e25090abc8fc264913
    local iib5biid_paths=(
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochRetirement.swift
        Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochRetirementTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    [[ "$(git show -s --format=%P "$iib5biid_commit")" == "$iib5biid_parent" ]] \
        || { print -u2 "ii-b5b-ii-d historical parent drifted"; historical_status=1; }
    [[ "$(git show -s --format=%T "$iib5biid_commit")" == "$iib5biid_tree" ]] \
        || { print -u2 "ii-b5b-ii-d historical tree drifted"; historical_status=1; }
    local iib5biid_observed_paths=(${(f)"$(git diff-tree --no-commit-id --name-only -r "$iib5biid_commit" | LC_ALL=C sort)"})
    local iib5biid_expected_paths=("${(@on)iib5biid_paths}")
    [[ "${(j:\n:)iib5biid_observed_paths}" == "${(j:\n:)iib5biid_expected_paths}" ]] \
        || { print -u2 "ii-b5b-ii-d historical paths drifted"; historical_status=1; }
    local iib5biid_lines
    iib5biid_lines=$(git diff-tree --numstat --no-commit-id -r "$iib5biid_commit" \
        | awk '{n += $1 + $2} END {print n + 0}')
    (( iib5biid_lines == 2253 )) \
        || { print -u2 "ii-b5b-ii-d historical line count drifted"; historical_status=1; }

    local iib5biid_index=$historical_root/iib5biid.index
    local iib5biid_root=$historical_root/iib5biid
    mkdir -p "$iib5biid_root"
    GIT_INDEX_FILE="$iib5biid_index" git read-tree "$iib5biid_commit^{tree}" \
        || historical_status=$?
    GIT_INDEX_FILE="$iib5biid_index" git checkout-index --all \
        --prefix="$iib5biid_root/" || historical_status=$?
    if (( historical_status == 0 )); then
        python3 - "$iib5biid_root" "${iib5biid_paths[@]}" <<'PY' \
            || historical_status=$?
from pathlib import Path
import hashlib
import stat
import sys

root = Path(sys.argv[1])
paths = sys.argv[2:]
if len(paths) != 8:
    raise SystemExit("ii-b5b-ii-d historical path cardinality drifted")
for relative in paths:
    path = root / relative
    expected_mode = 0o755 if relative.startswith("scripts/") else 0o644
    if stat.S_IMODE(path.stat().st_mode) != expected_mode:
        raise SystemExit(f"ii-b5b-ii-d historical mode drifted: {relative}")
expected_scripts = {
    "scripts/verify-contract":
        "9ab5bbff99a1f13361049b7e5040b5ac12fe62bd64cb02cd32f6c656e6dd112e",
    "scripts/verify-investigation-boundaries":
        "e6743f59bea8b09d06aad632cb8fbbd1dae3ef18c110f22f606c4f431d99d7f2",
    "scripts/verify-app-release-boundaries":
        "12cdb5be053ea90cc01f6289b6a9228fbf809674818a38e0264d75d21d2d5ea5",
}
for relative, expected in expected_scripts.items():
    observed = hashlib.sha256((root / relative).read_bytes()).hexdigest()
    if observed != expected:
        raise SystemExit(f"ii-b5b-ii-d historical script SHA drifted: {relative}")
PY
        local historical_git_dir
        historical_git_dir=$(git rev-parse --absolute-git-dir)
        (
            cd "$iib5biid_root"
            scripts/verify-investigation-boundaries \
                --iib5biid-darwin-retirement-contract-only \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochSession.swift \
                Sources/StornautInvestigationMachineDriverSupport/InvestigationMachineDarwinEpochRetirement.swift \
                Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochSessionTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineDarwinEpochRetirementTests.swift \
                Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift \
                || exit $?
            scripts/verify-app-release-boundaries \
                --iib5biid-machine-driver-contract-only \
                scripts/verify-app-release-boundaries \
                || exit $?
            GIT_DIR="$historical_git_dir" \
            GIT_WORK_TREE="$iib5biid_root" \
            GIT_INDEX_FILE="$iib5biid_index" \
                scripts/verify-investigation-boundaries \
                --iib5biid-staged-scope-contract-only \
                efe079f95a9f15a360d280ea656bf9548bfaa3c3 \
                || exit $?
        ) || historical_status=$?
    fi

    rm -rf "$historical_root"
    return $historical_status
}

if [[ ${1:-} == --historical-freeze-contract-only ]]; then
    (( $# == 1 )) || fail_contract \
        "Usage: scripts/verify-contract --historical-freeze-contract-only"
    verify_immutable_historical_checkpoints
    print "Immutable historical checkpoint verification passed."
    exit 0
fi

verify_immutable_historical_checkpoints

