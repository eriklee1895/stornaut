    ("command-line-argc-selector", "CommandLine.argc"),
    ("command-line-unsafe-argv-selector", "CommandLine.unsafeArgv"),
    ("process-arguments-selector", "ProcessInfo.processInfo.arguments"),
    ("environment-selector", "ProcessInfo.processInfo.environment"),
    ("user-defaults-selector", "UserDefaults.standard"),
