# A controlled iii-b2b-1a-1 same-path tamper changes one byte in an
# implementation-changed line, preserving the exact line-count budget.
for checkpoint_path in "${iib5biii_b2b1a1_paths[@]}"; do
    index="$contract_root/iib5biii-b2b1a1-tamper-${checkpoint_path:t}.index"
    cp "$iib5biii_b2b1a1_index" "$index"
    python3 - \
        "$iib5biii_b2b1a1_baseline" \
        "$iib5biii_b2b1a1_implementation_commit" \
        "$checkpoint_path" \
        "$contract_root/iib5biii-b2b1a1-tampered" <<'PY'
import difflib
from pathlib import Path
import subprocess
import sys

baseline, implementation, path, output = sys.argv[1:]

def show(revision):
    completed = subprocess.run(
        ["git", "show", f"{revision}:{path}"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False,
    )
    return completed.stdout if completed.returncode == 0 else b""

before = show(baseline).splitlines(keepends=True)
after = show(implementation).splitlines(keepends=True)
matcher = difflib.SequenceMatcher(a=before, b=after, autojunk=False)
changed_index = next(
    (j1 for tag, _i1, _i2, j1, j2 in matcher.get_opcodes()
     if tag != "equal" and j1 < j2),
    None,
)
if changed_index is None:
    raise SystemExit(f"cannot construct same-path tamper: {path}")
line = bytearray(after[changed_index])
for index, value in enumerate(line):
    if 0x21 <= value <= 0x7E:
        line[index] = 0x58 if value != 0x58 else 0x59
        break
else:
    raise SystemExit(f"cannot mutate changed line: {path}")
after[changed_index] = bytes(line)
Path(output).write_bytes(b"".join(after))
PY
    blob=$(git hash-object -w -- \
        "$contract_root/iib5biii-b2b1a1-tampered")
    mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
    GIT_INDEX_FILE="$index" git update-index --cacheinfo \
        "$mode,$blob,$checkpoint_path"
    output="$contract_root/iib5biii-b2b1a1-tamper-${checkpoint_path:t}.log"
    if GIT_INDEX_FILE="$index" "$iib5biii_b2b1a1_gate" \
        --iib5biii-b2b1a1-staged-scope-contract-only \
        "$iib5biii_b2b1a1_baseline" >"$output" 2>&1
    then
        fail_contract \
            "iii-b2b-1a-1 same-path substitution accepted: $checkpoint_path"
    fi
    require_fixed_text "$output" "iii-b2b-1a-1 completed tree drifted"
done

