       "#if DEBUG\n",
       "#if DEBUG\n"
       "private func swallowedInventoryFailure(\n"
       "    _ system: any InvestigationOwnerOnlyCapsuleSystem\n"
       ") { _ = try? system.inventory(baseDescriptor: -1, maximumEntryCount: 1) }\n",
