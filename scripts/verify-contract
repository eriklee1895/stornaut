import sys
c_path, source_path, test_path, root = map(Path, sys.argv[1:])
c, source, test = [p.read_text(encoding="utf-8") for p in (c_path,source_path,test_path)]
def emit(name, old, new, text=source, suffix="swift"):
    if text.count(old) != 1: raise SystemExit(f"cannot construct ii-b5b-i-b2b-a mutation: {name}")
    (root/f"iib5bib2ba-{name}.{suffix}").write_text(text.replace(old,new,1),encoding="utf-8")
emit("c-signal", "#include <sys/proc.h>\n", "#include <sys/proc.h>\nextern int proc_signal_with_audittoken(void *, int);\nstatic void forbidden(void) { (void)proc_signal_with_audittoken(0, 9); }\n", c, "c")
emit("c-ptrace", "    if (process_id <= 1 || identity == NULL) {\n        return EINVAL;\n    }\n    memset(identity, 0, sizeof(*identity));\n", "    if (process_id <= 1 || identity == NULL) {\n        return EINVAL;\n    }\n    memset(identity, 0, sizeof(*identity));\n    extern int ptrace(int, pid_t, void *, int);\n    (void)ptrace(0, process_id, 0, 0);\n", c, "c")
emit("identity-reread", "let finalKernel: InvestigationInstalledL2KernelIdentity\n        switch identityReader.read(processID: expected.processID) {\n        case .success(let identity): finalKernel = identity\n        case .failure: return .unavailable\n        }", "let finalKernel = initialKernel")
emit("path-reread", "let finalPath: URL\n        switch pathReader.read(processID: expected.processID) {\n        case .success(let value): finalPath = value.standardizedFileURL\n        case .failure: return .unavailable\n        }", "let finalPath = initialPath")
emit("audit-token", "kSecGuestAttributeAudit: tokenData as CFData", "kSecGuestAttributeAudit: Data() as CFData")
emit("flags", "let signatureFlags = dictionary[kSecCodeInfoFlags] as? NSNumber", "let signatureFlags = NSNumber(value: 0)")
emit("vacuous-test", "#expect(signing.auditTokens == [expected.auditTokenWords])", "#expect(true)", test)
PY
for fixture in \
    c-signal:'ii-b5b-i-b2b-a C authority drifted' \
    c-ptrace:'ii-b5b-i-b2b-a object authority drifted' \
    identity-reread:'ii-b5b-i-b2b-a identity reread drifted' \
    path-reread:'ii-b5b-i-b2b-a path reread drifted' \
