for name, (kind, old, new) in mutations.items():
    source = sources[kind]
    if source.count(old) != 1:
        raise SystemExit(
            f"cannot construct iii-b2a-ii-a2-i mutation: {name}"
        )
    (output_root / f"iib5biii-b2a-ii-a2i-{name}.swift").write_text(
        source.replace(old, new, 1), encoding="utf-8"
    )
PY

function require_iib5biii_b2a_iia2i_mutation_rejected() {
    local name=$1 kind=$2 expected=$3
    local session=$iib5biii_b2a_iia2i_session
    local identity=$iib5biii_b2a_iia2i_identity
    local retirement=$iib5biii_b2a_iia2i_retirement
    local session_test=$iib5biii_b2a_iia2i_session_test
    local identity_test=$iib5biii_b2a_iia2i_identity_test
    local retirement_test=$iib5biii_b2a_iia2i_retirement_test
    local target="$contract_root/iib5biii-b2a-ii-a2i-$name.swift"
    [[ $kind == session ]] && session=$target
    [[ $kind == identity ]] && identity=$target
    [[ $kind == retirement ]] && retirement=$target
    [[ $kind == session-test ]] && session_test=$target
    [[ $kind == identity-test ]] && identity_test=$target
    [[ $kind == retirement-test ]] && retirement_test=$target
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$target"
    local output="$contract_root/iib5biii-b2a-ii-a2i-$name.log"
    if "$iib5biii_b2a_iia2i_gate" \
        --iib5biii-b2a-ii-a2i-contract-only \
        "$session" "$identity" "$retirement" "$session_test" \
        "$identity_test" "$retirement_test" \
        "$iib5biii_b2a_iia2i_boundary" >"$output" 2>&1
    then
        fail_contract "iii-b2a-ii-a2-i mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
}

for fixture in \
    inherited-policy-removal:session:'iii-b2a-ii-a2-i topology policy drifted' \
    inherited-flags-setpgroup:session:'iii-b2a-ii-a2-i spawn contract drifted' \
    unconditional-setpgroup:session:'iii-b2a-ii-a2-i spawn contract drifted' \
    widened-setpgroup-condition:session:'iii-b2a-ii-a2-i spawn contract drifted' \
    app-pgid-equals-pid:identity:'iii-b2a-ii-a2-i App identity topology drifted' \
    app-topology-binding-removal:identity:'iii-b2a-ii-a2-i App identity topology drifted' \
    inner-pgid-stability-removal:session:'iii-b2a-ii-a2-i inherited PGID stability drifted' \
    group-retirement-substitution:session:'iii-b2a-ii-a2-i direct-child retirement drifted' \
    session-test-vacuity:session-test:'iii-b2a-ii-a2-i session tests became vacuous' \
    identity-test-vacuity:identity-test:'iii-b2a-ii-a2-i identity tests became vacuous' \
    normal-reaper-to-fallback:session:'iii-b2a-ii-a2-i successful direct-child retirement drifted' \
    remove-exit-status-zero:retirement:'iii-b2a-ii-a2-i successful direct-child retirement drifted' \
    exit-status-disjunction:retirement:'iii-b2a-ii-a2-i successful direct-child retirement drifted' \
    successful-reaper-add-signal:retirement:'iii-b2a-ii-a2-i successful direct-child retirement drifted' \
    retirement-test-vacuity:retirement-test:'iii-b2a-ii-a2-i retirement tests became vacuous'
do
    name=${fixture%%:*}; remainder=${fixture#*:}
    kind=${remainder%%:*}; expected=${remainder#*:}
    require_iib5biii_b2a_iia2i_mutation_rejected \
        "$name" "$kind" "$expected"
done

iib5biii_b2a_iia2i_paths=(
    "$iib5biii_b2a_iia2i_session"
    "$iib5biii_b2a_iia2i_identity"
    "$iib5biii_b2a_iia2i_retirement"
    "$iib5biii_b2a_iia2i_session_test"
    "$iib5biii_b2a_iia2i_identity_test"
    "$iib5biii_b2a_iia2i_retirement_test"
    "$iib5biii_b2a_iia2i_boundary"
    scripts/verify-app-release-boundaries
    scripts/verify-contract
    scripts/verify-investigation-boundaries
)
(( ${#iib5biii_b2a_iia2i_paths} == 10 )) \
    || fail_contract "iii-b2a-ii-a2-i checkpoint path ceiling drifted"
iib5biii_b2a_iia2i_index="$contract_root/iib5biii-b2a-ii-a2i.index"
GIT_INDEX_FILE="$iib5biii_b2a_iia2i_index" \
    git read-tree "$iib5biii_b2a_iia2i_implementation_commit^{tree}"
GIT_INDEX_FILE="$iib5biii_b2a_iia2i_index" \
    "$iib5biii_b2a_iia2i_gate" \
    --iib5biii-b2a-ii-a2i-scope-contract-only \
    "$iib5biii_b2a_iia2i_baseline" \
    >"$contract_root/iib5biii-b2a-ii-a2i-scope-canonical.log"
for fixture in extra-path over-budget deleted binary mode wrong-baseline; do
    index="$contract_root/iib5biii-b2a-ii-a2i-scope-$fixture.index"
    cp "$iib5biii_b2a_iia2i_index" "$index"
    baseline=$iib5biii_b2a_iia2i_baseline
    case $fixture in
        extra-path)
            blob=$(git rev-parse "${iib5biii_b2a_iia2i_baseline}:AGENTS.md")
            GIT_INDEX_FILE="$index" git update-index --add --cacheinfo \
                "100644,$blob,a2-i-extra.swift"
            expected='iii-b2a-ii-a2-i staged checkpoint paths drifted' ;;
        over-budget)
            for line in {1..3300}; do print -r -- "// a2-i $line"; done \
                >"$contract_root/iib5biii-b2a-ii-a2i-over-budget.swift"
            blob=$(git hash-object -w -- \
                "$contract_root/iib5biii-b2a-ii-a2i-over-budget.swift")
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,$iib5biii_b2a_iia2i_session"
            expected='iii-b2a-ii-a2-i checkpoint budget drifted' ;;
        deleted)
            GIT_INDEX_FILE="$index" git rm --cached -q -f \
                "$iib5biii_b2a_iia2i_identity"
            expected='iii-b2a-ii-a2-i checkpoint deleted an existing path' ;;
        binary)
            blob=$(git rev-parse \
                "${iib5biii_b2a_iia2i_baseline}:Tests/Fixtures/Snapshots/design-system.empty-state.dark.en.png")
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,$iib5biii_b2a_iia2i_session"
            expected='iii-b2a-ii-a2-i binary checkpoint path rejected' ;;
        mode)
            entry=$(GIT_INDEX_FILE="$index" git ls-files -s -- \
                scripts/verify-contract)
            blob=$(print -r -- "$entry" | awk '{print $2}')
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,scripts/verify-contract"
            expected='iii-b2a-ii-a2-i checkpoint mode drifted: scripts/verify-contract' ;;
        wrong-baseline)
            baseline="$iib5biii_b2a_iia2i_baseline^"
            expected='iii-b2a-ii-a2-i checkpoint baseline drifted' ;;
    esac
    output="$contract_root/iib5biii-b2a-ii-a2i-scope-$fixture.log"
    if GIT_INDEX_FILE="$index" "$iib5biii_b2a_iia2i_gate" \
        --iib5biii-b2a-ii-a2i-scope-contract-only "$baseline" \
        >"$output" 2>&1
    then
        fail_contract "iii-b2a-ii-a2-i scope mutation accepted: $fixture"
    fi
    require_fixed_text "$output" "$expected"
done

