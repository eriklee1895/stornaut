intake = intake_path.read_text(encoding="utf-8")
def emit(name, old, new, source=projection):
    if source.count(old) != 1:
        raise SystemExit(f"cannot construct ii-c0a mutation: {name}")
    (root / f"{name}.swift").write_text(
        source.replace(old, new, 1), encoding="utf-8"
    )
