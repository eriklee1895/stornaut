    reject untracked 'checkpoint untracked paths drifted' env GIT_INDEX_FILE="$base" "$gate" --iic0b-iv-b2-staged-scope-contract-only; rm -f "$probe"
    local composition=Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift receipt=Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorReceipt.swift entry=tools/StornautInvestigationMachineGateCoordinator/main.swift
    local composition_test=Tests/StornautInvestigationTests/InvestigationMachineGateCoordinatorCompositionTests.swift receipt_test=Tests/StornautInvestigationTests/InvestigationMachineGateCoordinatorReceiptTests.swift boundary_test=Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift mutated
    sed 's/dependencies: \.production(context: context, sink: sink)/dependencies: .production(context: context, sink: nil)/' "$composition" >"$out/composition.swift"; reject source-call-edge 'composition call-edge drifted' "$gate" --iic0b-iv-source-contract-only Package.swift "$out/composition.swift" "$receipt" "$entry" "$composition_test" "$receipt_test" "$boundary_test"
    sed 's/InvestigationHandoffAppLeafAdapterSystem.system.continuousNanoseconds/{ DispatchTime.now().uptimeNanoseconds }/' "$composition" >"$out/clock.swift"; reject source-clock 'production clock drifted' "$gate" --iic0b-iv-source-contract-only Package.swift "$out/clock.swift" "$receipt" "$entry" "$composition_test" "$receipt_test" "$boundary_test"
    for fixture in critical-test-composition-vacuity critical-test-receipt-vacuity critical-test-boundary-vacuity; do mutated="$out/$fixture.swift"
        case $fixture in
            critical-test-composition-vacuity) sed 's/@Test(arguments: InvestigationMachineGateCoordinatorOwnedAttempt.RootBootstrapStage.allCases)/@Test(arguments: [])/' "$composition_test" >"$mutated"; reject "$fixture" 'critical test source seal drifted' "$gate" --iic0b-iv-source-contract-only Package.swift "$composition" "$receipt" "$entry" "$mutated" "$receipt_test" "$boundary_test" ;;
            critical-test-receipt-vacuity) sed 's/@Test(arguments: CoordinatorReceiptEncodingMutation.allCases)/@Test(arguments: [])/' "$receipt_test" >"$mutated"; reject "$fixture" 'critical test source seal drifted' "$gate" --iic0b-iv-source-contract-only Package.swift "$composition" "$receipt" "$entry" "$composition_test" "$mutated" "$boundary_test" ;;
