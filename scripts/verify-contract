    "held-named-short-circuit",
    "held == named, held.device > 0",
    "true || held == named, held.device > 0",
    count=2,
)
mutate(
    "cloexec-short-circuit",
    "descriptorFlags & FD_CLOEXEC == FD_CLOEXEC,",
    "true || descriptorFlags & FD_CLOEXEC == FD_CLOEXEC,",
    count=2,
)
insert(
    "lock-mutation",
    'private func forbiddenLockMutation() { _ = unlink(".owner-lock-v1") }',
)
mutate(
    "product-authority",
    "import Foundation\n",
    "import Foundation\nimport StornautCore\n",
)
insert(
    "capsule-authority",
    'private func forbiddenCapsuleMutation() { '
    '_ = unlinkat(-1, "capsule.pending", 0) }',
)
mutate("source-seal", "#endif", "// sealed source drift\n#endif")
owner_member = "ii-c0b-ii-a3 owner member allowlist drifted"
descriptor_declaration = (
    "ii-c0b-ii-a3 descriptor or capability declaration drifted"
)
callback = "ii-c0b-ii-a3 callback surface drifted"
