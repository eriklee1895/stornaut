function require_iib5biii_b1_mutation_rejected() {
    local name=$1 source_kind=$2
    local expected
    case $name in
        one-shot-bypass)
            expected='iii-b1 one-shot state ordering drifted' ;;
        prefetch-retry)
            expected='iii-b1 exact eight-loop or no-prefetch contract drifted' ;;
        overlay-drift)
            expected='iii-b1 fixed overlay drifted' ;;
        omit-final-destroy|ignore-exhaustion)
            expected='iii-b1 final destroy/exhaustion ordering drifted' ;;
        reuse-wrapper)
            expected='iii-b1 fresh wrapper retention drifted' ;;
        authority-injection)
            expected='iii-b1 dependency surface drifted' ;;
        selection-binding|cohort-binding)
            expected='iii-b1 selection or cohort binding drifted' ;;
        cancellation-checks)
            expected='iii-b1 cancellation checks drifted' ;;
        comment-only-tests|vacuous-marker-tests)
            expected='iii-b1 focused test vacuity or coverage drifted' ;;
        focused-test-source-seal)
            expected='iii-b1 focused test source seal drifted' ;;
        *)
            fail_contract "unknown iii-b1 mutation fixture: $name" ;;
    esac
    local cohort=$iib5biii_b1_cohort
    local continuity=$iib5biii_b1_continuity
    local focused_test=$iib5biii_b1_test
    local target="$contract_root/iib5biii-b1-$name.swift"
    [[ $source_kind == cohort ]] && cohort=$target
    [[ $source_kind == continuity ]] && continuity=$target
    [[ $source_kind == test ]] && focused_test=$target
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$target"
    local output="$contract_root/iib5biii-b1-$name.log"
    if "$iib5biii_b1_gate" --iib5biii-b1-cohort-contract-only \
        "$cohort" "$continuity" "$focused_test" \
        "$iib5biii_b1_boundary" >"$output" 2>&1
    then
        fail_contract "iii-b1 mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
}

for fixture in \
    one-shot-bypass:cohort prefetch-retry:cohort overlay-drift:cohort \
    omit-final-destroy:cohort ignore-exhaustion:cohort reuse-wrapper:cohort \
    authority-injection:cohort selection-binding:cohort cohort-binding:cohort \
    cancellation-checks:cohort comment-only-tests:test \
    vacuous-marker-tests:test focused-test-source-seal:test
do
    require_iib5biii_b1_mutation_rejected \
        "${fixture%%:*}" "${fixture#*:}"
done

