    case $source_name in
        single) cp "$iib5biii_b2ai_single" "$source_path" ;;
        composition) cp "$iib5biii_b2ai_composition" "$source_path" ;;
        continuity) cp "$iib5biii_b2ai_continuity" "$source_path" ;;
        bridge) cp "$iib5biii_b2ai_bridge" "$source_path" ;;
        protocol) cp "$iib5biii_b2ai_protocol" "$source_path" ;;
    esac
    {
        print -r -- '// Process() FileManager.default send( is documentation only.'
        print -r -- 'private let harmlessAuthorityWords = "Process() FileManager.default send("'
    } >>"$source_path"
    single=$iib5biii_b2ai_single
    composition=$iib5biii_b2ai_composition
    continuity=$iib5biii_b2ai_continuity
    bridge=$iib5biii_b2ai_bridge
    protocol=$iib5biii_b2ai_protocol
    [[ $source_name == single ]] && single=$source_path
    [[ $source_name == composition ]] && composition=$source_path
    [[ $source_name == continuity ]] && continuity=$source_path
    [[ $source_name == bridge ]] && bridge=$source_path
    [[ $source_name == protocol ]] && protocol=$source_path
    "$iib5biii_b2ai_app_gate" \
        --iib5biii-b2a-i-source-contract-only \
        "$single" "$composition" "$continuity" "$bridge" "$protocol" \
        >"$contract_root/iib5biii-b2a-i-app-harmless-$source_name.log"
done

interpolation=$contract_root/iib5biii-b2a-i-app-interpolation.swift
