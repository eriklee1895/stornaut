    session_path, identity_path, retirement_path, session_test_path,
    identity_test_path, retirement_test_path, output_root,
) = map(Path, sys.argv[1:])
sources = {
    "session": session_path.read_text(encoding="utf-8"),
    "identity": identity_path.read_text(encoding="utf-8"),
    "retirement": retirement_path.read_text(encoding="utf-8"),
    "session-test": session_test_path.read_text(encoding="utf-8"),
    "identity-test": identity_test_path.read_text(encoding="utf-8"),
    "retirement-test": retirement_test_path.read_text(encoding="utf-8"),
}
mutations = {
    "inherited-policy-removal": (
        "session",
        "case inheritedInnerProcessGroup",
        "case removedInheritedProcessGroup",
    ),
    "inherited-flags-setpgroup": (
        "session",
        "static let inheritedProcessGroupSpawnFlags = Int16(\n"
        "        POSIX_SPAWN_CLOEXEC_DEFAULT\n"
        "    )",
        "static let inheritedProcessGroupSpawnFlags = Int16(\n"
        "        POSIX_SPAWN_SETPGROUP | POSIX_SPAWN_CLOEXEC_DEFAULT\n"
        "    )",
    ),
    "unconditional-setpgroup": (
        "session",
        "if request.flags == InvestigationMachineDarwinEpochSessionFactory.spawnFlags {",
        "if true {",
    ),
    "widened-setpgroup-condition": (
        "session",
        "if request.flags == InvestigationMachineDarwinEpochSessionFactory.spawnFlags {",
        "if request.flags == InvestigationMachineDarwinEpochSessionFactory.spawnFlags\n"
        "        || request.flags == InvestigationMachineDarwinEpochSessionFactory\n"
        "            .inheritedProcessGroupSpawnFlags {",
    ),
    "app-pgid-equals-pid": (
        "identity",
        "snapshot.processGroupID == processGroupID,",
        "snapshot.processGroupID == processID,",
    ),
    "app-topology-binding-removal": (
        "identity",
        "snapshot.parentProcessID == parentProcessID,\n"
        "            snapshot.processGroupID == processGroupID,",
        "snapshot.parentProcessID > 1,\n"
        "            snapshot.processGroupID > 1,",
    ),
    "inner-pgid-stability-removal": (
        "session",
        "system.currentProcessGroup() == inheritedProcessGroup,",
        "inheritedProcessGroup > 1,",
    ),
    "group-retirement-substitution": (
        "session",
        "retirementAuthority = .directChild(spawned)",
        "retirementAuthority = .ownedProcessGroup(.init(\n"
        "                    processID: processID, processGroupID: processGroup,\n"
        "                    descriptors: openDescriptors.sorted()\n"
        "                ))",
    ),
    "session-test-vacuity": (
        "session-test",
        "inheritedInnerProcessGroupUsesCloexecOnlyAndDirectChildRetirement",
        "inheritedInnerProcessGroupCoverageWasRemoved",
    ),
    "identity-test-vacuity": (
        "identity-test",
        "inheritedProcessGroupTopologyUsesFactoryOwnedExpectations",
        "inheritedProcessGroupIdentityCoverageWasRemoved",
    ),
    "normal-reaper-to-fallback": (
        "session",
        "if expectsSuccessfulExit {\n"
        "                    proof = try await retirementOwner\n"
        "                        .reapSuccessfulDirectChild(spawned)\n"
        "                } else {\n"
        "                    try await retirementOwner.retireSpawnedProcess(spawned)\n"
        "                    proof = .init()\n"
        "                }",
        "if expectsSuccessfulExit {\n"
        "                    try await retirementOwner.retireSpawnedProcess(spawned)\n"
        "                    proof = .init()\n"
        "                } else {\n"
        "                    proof = try await retirementOwner\n"
        "                        .reapSuccessfulDirectChild(spawned)\n"
        "                }",
    ),
    "remove-exit-status-zero": (
        "retirement",
        "status.rawStatus >> 8 & 0xff == 0",
        "status.rawStatus >> 8 & 0xff >= 0",
    ),
    "exit-status-disjunction": (
        "retirement",
        "status.rawStatus >> 8 & 0xff == 0",
        "status.rawStatus >> 8 & 0xff == 0 || true",
    ),
    "successful-reaper-add-signal": (
        "retirement",
        "let deadline = try adding(Self.totalWindowNanoseconds, to: started)\n"
        "        while try waitableLeader(epoch.processID, deadline: deadline) == nil {",
        "let deadline = try adding(Self.totalWindowNanoseconds, to: started)\n"
        "        try signal(epoch.processID, SIGKILL)\n"
        "        while try waitableLeader(epoch.processID, deadline: deadline) == nil {",
    ),
    "retirement-test-vacuity": (
        "retirement-test",
        "successfulDirectChildExitWaitsWithoutSignalAndRequiresExitZero",
        "successfulDirectChildRetirementCoverageWasRemoved",
    ),
