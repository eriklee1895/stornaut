function iib5biii_b2a0_tampered_blob() {
    local checkpoint_path=$1
    {
        git show "${iib5biii_b2a0_commit}:$checkpoint_path"
        print -r -- "unrelated iii-b2a0 tamper"
    } | git hash-object -w --stdin
}
for fixture in extra-path over-budget deleted binary mode wrong-baseline \
    substitute-composition substitute-continuity substitute-bridge \
    substitute-focused substitute-boundary-test substitute-contract \
    substitute-boundary substitute-app substitute-preflight
do
    index="$contract_root/iib5biii-b2a0-scope-$fixture.index"
    cp "$iib5biii_b2a0_index" "$index"
    case $fixture in
        extra-path)
            blob=$(git rev-parse "${iib5biii_b2a0_baseline}:AGENTS.md")
            GIT_INDEX_FILE="$index" git update-index --add \
                --cacheinfo "100644,$blob,iii-b2a0-extra.swift"
            expected='iii-b2a0 staged checkpoint paths drifted' ;;
        over-budget)
            blob=$(git hash-object -w -- \
                "$contract_root/iib5biii-b2a0-over-budget.swift")
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,$iib5biii_b2a0_bridge"
            expected='iii-b2a0 checkpoint budget drifted' ;;
        deleted)
            GIT_INDEX_FILE="$index" git rm --cached -q -f \
                "$iib5biii_b2a0_continuity"
            expected='iii-b2a0 checkpoint deleted an existing path' ;;
        binary)
            blob=$(git rev-parse \
                "${iib5biii_b2a0_baseline}:Tests/Fixtures/Snapshots/design-system.empty-state.dark.en.png")
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,$iib5biii_b2a0_composition"
            expected='iii-b2a0 binary checkpoint path rejected' ;;
        mode)
            entry=$(GIT_INDEX_FILE="$index" git ls-files -s -- \
                scripts/verify-contract)
            blob=$(print -r -- "$entry" | awk '{print $2}')
            GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                "100644,$blob,scripts/verify-contract"
            expected='iii-b2a0 checkpoint mode drifted: scripts/verify-contract' ;;
        wrong-baseline)
            expected='iii-b2a0 checkpoint baseline drifted' ;;
        substitute-composition) checkpoint_path=$iib5biii_b2a0_composition ;;
        substitute-continuity) checkpoint_path=$iib5biii_b2a0_continuity ;;
        substitute-bridge) checkpoint_path=$iib5biii_b2a0_bridge ;;
        substitute-focused) checkpoint_path=$iib5biii_b2a0_test ;;
        substitute-boundary-test) checkpoint_path=$iib5biii_b2a0_boundary ;;
        substitute-contract) checkpoint_path=scripts/verify-contract ;;
        substitute-boundary) checkpoint_path=scripts/verify-investigation-boundaries ;;
        substitute-app) checkpoint_path=scripts/verify-app-release-boundaries ;;
        substitute-preflight) checkpoint_path=docs/reports/phase-d-task-39b2c-l3c3c-ii-b5b-iii-b2a0-typed-physical-bridge-preflight.md ;;
    esac
    if [[ $fixture == substitute-* ]]; then
        blob=$(iib5biii_b2a0_tampered_blob "$checkpoint_path")
        mode=100644; [[ $checkpoint_path == scripts/* ]] && mode=100755
        GIT_INDEX_FILE="$index" git update-index --cacheinfo \
            "$mode,$blob,$checkpoint_path"
        expected='iii-b2a0 completed tree drifted'
    fi
    output="$contract_root/iib5biii-b2a0-scope-$fixture.log"
    baseline=$iib5biii_b2a0_baseline
    [[ $fixture == wrong-baseline ]] && baseline="$iib5biii_b2a0_baseline^"
    if GIT_INDEX_FILE="$index" "$iib5biii_b2a0_gate" \
        --iib5biii-b2a0-scope-contract-only "$baseline" \
        >"$output" 2>&1
    then
        fail_contract "iii-b2a0 scope mutation accepted: $fixture"
    fi
    require_fixed_text "$output" "$expected"
done

