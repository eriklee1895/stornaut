from pathlib import Path
import re
import sys

package_path, transport_path, launcher_path, darwin_path, entry_path, physical_test_path, app_path, out = map(Path, sys.argv[1:])
sources = {
    "package": package_path.read_text(encoding="utf-8"),
    "transport": transport_path.read_text(encoding="utf-8"),
    "launcher": launcher_path.read_text(encoding="utf-8"),
    "darwin": darwin_path.read_text(encoding="utf-8"),
    "entry": entry_path.read_text(encoding="utf-8"),
    "physical": physical_test_path.read_text(encoding="utf-8"),
    "app": app_path.read_text(encoding="utf-8"),
}

def emit(name, kind, source):
    if kind == "app":
        path = out / f"iic0biii2a-{name}"
    else:
        directory = out / f"iic0biii2a-{name}"
        directory.mkdir()
        path = directory / {
            "package": package_path.name,
            "transport": transport_path.name,
            "launcher": launcher_path.name,
            "darwin": darwin_path.name,
            "entry": entry_path.name,
            "physical": physical_test_path.name,
        }[kind]
    path.write_text(source, encoding="utf-8")

def replace(name, kind, old, new):
    source = sources[kind]
    matches = source.count(old)
    if matches != 1:
        raise SystemExit(f"cannot construct ii-c0b-iii-2a mutation: {name}")
    emit(name, kind, source.replace(old, new, 1))

