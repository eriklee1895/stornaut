python3 - "$iic0bi_author" "$iic0bi_composition" \
    "$iic0bi_focused_test" "$contract_root" <<'PY'
from pathlib import Path
import re
import sys

author_path, composition_path, test_path, root = map(Path, sys.argv[1:])
sources = {
    "author": author_path.read_text(encoding="utf-8"),
    "composition": composition_path.read_text(encoding="utf-8"),
    "test": test_path.read_text(encoding="utf-8"),
}

def emit(name, kind, source):
    (root / f"iic0bi-{name}.swift").write_text(source, encoding="utf-8")

def replace_once(name, kind, old, new):
    source = sources[kind]
    if source.count(old) != 1:
        raise SystemExit(f"cannot construct ii-c0b-i mutation: {name}")
    emit(name, kind, source.replace(old, new, 1))

replace_once(
    "public-author", "author",
    "package struct InvestigationProjectedCohortAuthor",
    "public struct InvestigationProjectedCohortAuthor",
)
author_without_end = sources["author"].rsplit("#endif", 1)
if len(author_without_end) != 2:
    raise SystemExit("cannot construct ii-c0b-i mutation: codable-binding")
emit(
    "codable-binding", "author",
    author_without_end[0]
    + "extension InvestigationProjectedCohortInstalledBinding: Codable {}\n"
    + "#endif" + author_without_end[1],
)
replace_once(
    "debug-guard-bypass", "author", "#if DEBUG", "#if true"
)
replace_once(
    "injectable-production-constructor", "author",
    "    init(now: @escaping Clock", "    package init(now: @escaping Clock",
)
replace_once(
    "second-scenario-mapping", "composition",
    "    ) -> InvestigationHandoffScenario {\n        switch scenario {",
    "    ) -> InvestigationHandoffScenario {\n"
    + "        switch scenario { case _: break }\n        switch scenario {",
)
composition_without_end = sources["composition"].rsplit("#endif", 1)
if len(composition_without_end) != 2:
    raise SystemExit("cannot construct ii-c0b-i mutation: production-call-site")
emit(
    "production-call-site", "composition",
    composition_without_end[0]
    + "private func iic0biPrematureCallSite(\n"
    + "    _ author: InvestigationProjectedCohortAuthor,\n"
    + "    data: [Data], binding: InvestigationProjectedCohortInstalledBinding\n"
    + ") throws { _ = try author.author(configurationData: data, installedBinding: binding) }\n"
