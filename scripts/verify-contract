from pathlib import Path
import sys
source_path, root = map(Path, sys.argv[1:])
source = source_path.read_text(encoding="utf-8")

def mutate_array(name, old, new, mutation_name):
    start = source.index(name + "=(\n")
    end = source.index("\n)\n", start) + 3
    section = source[start:end]
    if section.count(old) != 1:
        raise SystemExit(f"cannot construct ii-b5b-ii-c App mutation: {mutation_name}")
    changed = source[:start] + section.replace(old, new, 1) + source[end:]
    (root / f"iib5biic-app-{mutation_name}").write_text(changed, encoding="utf-8")

mutate_array("iib5biic_debug_introduced_imports", "    _posix_spawn\n", "", "debug-missing-spawn")
mutate_array("iib5biic_debug_introduced_imports", "    _recv\n", "    _recvfrom\n", "debug-sibling-network")
mutate_array("iib5biic_release_forbidden_imports", "    _recv\n", "", "release-missing-negative")
loop = 'for marker in "${iib5biic_debug_introduced_imports[@]}"; do\n'
start = source.index(loop)
end = source.index("\ndone\n", start) + len("\ndone\n")
section = source[start:end]
if section.count("grep -Fxq") != 1:
    raise SystemExit("cannot construct ii-b5b-ii-c App mutation: weak-scanner")
(root / "iib5biic-app-weak-scanner").write_text(
    source[:start] + section.replace("grep -Fxq", "grep -Fq", 1) + source[end:],
    encoding="utf-8",
)
PY
