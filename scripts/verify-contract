    temporary_index="$contract_root/app-peer-$fixture.index"
    cp "$b3a_index" "$temporary_index"
    if [[ $fixture == extra-path ]]; then
        blob=$(git rev-parse "${b3a_parent}:AGENTS.md")
        GIT_INDEX_FILE="$temporary_index" git update-index --add \
            --cacheinfo "100644,$blob,iib3a-extra.swift"
        expected='ii-b3a staged checkpoint paths drifted'
    elif [[ $fixture == over-budget ]]; then
        blob=$(git rev-parse "${b3a_parent}:docs/plans/active/task-39-implementation-brief.md")
        GIT_INDEX_FILE="$temporary_index" git update-index \
            --cacheinfo "100644,$blob,Sources/StornautInvestigationDiagnostic/InvestigationHandoffAppLeafAdapter.swift"
        expected='ii-b3a staged checkpoint budget drifted'
    else
        blob=$(git rev-parse "${b3a_parent}:AGENTS.md")
        GIT_INDEX_FILE="$temporary_index" git update-index --add \
            --cacheinfo "100644,$blob,AGENTS.md"
        GIT_INDEX_FILE="$temporary_index" git rm --cached -q -f AGENTS.md
        expected='ii-b3a staged checkpoint paths drifted'
    fi
    output="$contract_root/app-peer-$fixture.log"
    if GIT_INDEX_FILE="$temporary_index" "$app_peer_gate" \
        --iib3a-staged-scope-contract-only "$b3a_parent" >"$output" 2>&1
    then
        fail_contract "App peer staged scope mutation accepted: $fixture"
    fi
    require_fixed_text "$output" "$expected"
done

