        esac; done
    sed 's/verify_iic0biii2a_component_boundary || exit \$?/true || exit $?/' scripts/verify-app-release-boundaries >"$out/component"
    reject component-call-edge 'component call-edge drifted' env STORNAUT_IIC0BIVB2_COMPONENT_SOURCE="$out/component" scripts/verify-app-release-boundaries --iic0b-iv-component-boundary-only
