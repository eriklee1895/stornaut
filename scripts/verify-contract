    protocol-spawn-authority:protocol:'iii-b2a-i dependency surface drifted' \
    outer-replay-guard:protocol:'iii-b2a-i receiver replay or predecessor binding drifted' \
    identity-topology-binding:protocol:'iii-b2a-i independent identity or deadline binding drifted' \
    terminal-app-binding:protocol:'iii-b2a-i terminal evidence binding drifted' \
    terminal-helper-binding:protocol:'iii-b2a-i terminal evidence binding drifted' \
    terminal-deadline-binding:protocol:'iii-b2a-i terminal evidence binding drifted' \
    raw-dto-admission:continuity:'iii-b2a-i raw physical DTO admission drifted' \
    admitted-token-public-init:protocol:'iii-b2a-i admitted token initializer visibility drifted' \
    admitted-token-second-mint:protocol:'iii-b2a-i admitted token mint cardinality drifted' \
    physical-deadline-forwarding:protocol:'iii-b2a-i request-bound composer deadline drifted' \
