    'iii-b2a-i source-only physical authority drifted'

function require_iib5biii_b2ai_app_mutation_rejected() {
    local name=$1 source_kind=$2 expected=$3
    local single=$iib5biii_b2ai_single
    local composition=$iib5biii_b2ai_composition
    local continuity=$iib5biii_b2ai_continuity
    local bridge=$iib5biii_b2ai_bridge
    local protocol=$iib5biii_b2ai_protocol
    local target="$contract_root/iib5biii-b2a-i-$name.swift"
    [[ $source_kind == single ]] && single=$target
    [[ $source_kind == composition ]] && composition=$target
    [[ $source_kind == continuity ]] && continuity=$target
    [[ $source_kind == bridge ]] && bridge=$target
    [[ $source_kind == protocol ]] && protocol=$target
    local output="$contract_root/iib5biii-b2a-i-app-$name.log"
    if "$iib5biii_b2ai_app_gate" \
        --iib5biii-b2a-i-source-contract-only \
        "$single" "$composition" "$continuity" "$bridge" "$protocol" \
        >"$output" 2>&1
    then
        fail_contract "iii-b2a-i App-boundary mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
}

for fixture in \
    app-authority-single:single:'iii-b2a-i source-only physical authority drifted' \
    app-authority-composition:composition:'iii-b2a-i source-only physical authority drifted' \
    app-authority-continuity:continuity:'iii-b2a-i source-only physical authority drifted' \
    app-authority-bridge:bridge:'iii-b2a-i source-only physical authority drifted' \
    app-authority-protocol:protocol:'iii-b2a-i source-only physical authority drifted' \
    raw-dto-admission:continuity:'iii-b2a-i source-only raw DTO admission drifted'
do
    name=${fixture%%:*}
    remainder=${fixture#*:}
    source_kind=${remainder%%:*}
    expected=${remainder#*:}
    require_iib5biii_b2ai_app_mutation_rejected \
        "$name" "$source_kind" "$expected"
done

