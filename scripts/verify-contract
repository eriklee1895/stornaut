function require_ordinary_machine_claim_mutation_rejected() {
    local fixture_name=$1
    local fixture_path=$2
    local expected_diagnostic=$3
    local output="$contract_root/$fixture_name.log"
    if "$ordinary_machine_claim_gate" \
        --legacy-machine-claim-contract-only \
        "$fixture_path" >"$output" 2>&1
    then
        fail_contract \
            "Ordinary machine claim mutation was accepted: $fixture_name"
    fi
    require_fixed_text "$output" "$expected_diagnostic"
}
