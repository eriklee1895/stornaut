        [[ "$(<"$log")" == "$expected" ]] \
            || fail_contract "fixed-gate cleanup mutation diagnostic drifted: $name"
    done <"$out/mutations.tsv"
    "$gate" --fixed-gate-deadline-cleanup-staged-scope-contract-only \
        >"$out/scope.log"
}

