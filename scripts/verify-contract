function require_iib5biii_b2ai_mutation_rejected() {
    local name=$1 source_kind=$2 expected=$3
    local single=$iib5biii_b2ai_single
    local composition=$iib5biii_b2ai_composition
    local continuity=$iib5biii_b2ai_continuity
    local bridge=$iib5biii_b2ai_bridge
    local protocol=$iib5biii_b2ai_protocol
    local focused_test=$iib5biii_b2ai_test
    local target="$contract_root/iib5biii-b2a-i-$name.swift"
    [[ $source_kind == single ]] && single=$target
    [[ $source_kind == composition ]] && composition=$target
    [[ $source_kind == continuity ]] && continuity=$target
    [[ $source_kind == bridge ]] && bridge=$target
    [[ $source_kind == protocol ]] && protocol=$target
    [[ $source_kind == test ]] && focused_test=$target
    local output="$contract_root/iib5biii-b2a-i-$name.log"
    if "$iib5biii_b2ai_gate" \
        --iib5biii-b2a-i-supervisor-contract-only \
        "$single" "$composition" "$continuity" "$bridge" \
        "$protocol" "$focused_test" "$iib5biii_b2ai_boundary" \
        >"$output" 2>&1
    then
        fail_contract "iii-b2a-i mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
}

