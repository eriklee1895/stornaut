    ("component-snapshot-shadow-vacuity", 'if $iicb1_root_owned_gate_component_boundary_only; then', 'function run_iicb1_root_owned_gate_component_snapshot() { return 0 }\nif $iicb1_root_owned_gate_component_boundary_only; then'),
    ("component-source-contract-shadow-vacuity", 'if $iicb1_root_owned_gate_component_boundary_only; then', 'verify_iicb1_root_owned_gate_component_source_contract() { return 0 }\nif $iicb1_root_owned_gate_component_boundary_only; then'),
    ("component-runtime-shadow-vacuity", 'if $iicb1_root_owned_gate_component_boundary_only; then', 'verify_iicb1_root_owned_gate_component_boundary() { return 0 }\nif $iicb1_root_owned_gate_component_boundary_only; then'),
    ("component-independent-tree-vacuity", '    [[ $materialized_tree == $source_tree ]] || {', '    [[ -n $materialized_tree ]] || {'),
    ("component-native-sandbox-vacuity", '        /usr/bin/env -i\n        HOME="$HOME"', '        /usr/bin/env\n        HOME="$HOME"'),
    ("component-negative-image-vacuity", '    local -a negative_images=(\n        "$product_derived_data/Build/Products/Debug/Stornaut.app"\n        "$product_derived_data/Build/Products/Release/Stornaut.app"\n        "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"\n    )', '    local -a negative_images=(\n        "$product_derived_data/Build/Products/Debug/Stornaut.app"\n        "$diagnostic_derived_data/Build/Products/Release/StornautInvestigationDiagnosticReleaseShell.app"\n    )'),
)
if len(mutations) != 22:
    raise SystemExit("ii-c-b1 component mutation inventory drifted")
mutation_names = []
for name, old, new in mutations:
    region_name = ("snapshot" if name in {"component-snapshot-umask-vacuity", "component-source-git-env-vacuity", "component-snapshot-early-return-vacuity", "component-independent-tree-vacuity"} else "source-contract" if name == "component-source-contract-early-return-vacuity" else "dispatch" if name in {"component-public-dispatch-vacuity", "component-snapshot-shadow-vacuity", "component-source-contract-shadow-vacuity", "component-runtime-shadow-vacuity"} else "runtime")
    start, end = regions[region_name]; region = source[start:end]
    if region.count(old) != 1:
        raise SystemExit(f"ii-c-b1 component mutation fixture is vacuous: {name}")
    (out / f"{name}.zsh").write_text(
        reseal(source[:start] + region.replace(old, new, 1) + source[end:]), encoding="utf-8",
    )
    mutation_names.append(name)
(out / "component-mutations.txt").write_text(
    "".join(f"{name}\n" for name in mutation_names),
    encoding="utf-8",
)
critical_names = ("run_iicb1_root_owned_gate_component_snapshot", "verify_iicb1_root_owned_gate_component_source_contract", "verify_iicb1_root_owned_gate_component_boundary")
binding_forms = (("dynamic", "name=NAME\nfunction $name { return 0 }"), ("functions-array", "name=NAME\nfunctions[$name]='return 0'"), ("eval", "eval 'NAME () return 0'"), ("alias", "alias NAME='true #'"))
dispatch = "if $iicb1_root_owned_gate_component_boundary_only; then"
binding_names = []
for function_name in critical_names:
    for kind, template in binding_forms:
        name = f"component-{kind}-{function_name}-binding-vacuity"
        offset = source.rfind(dispatch); (out / f"{name}.zsh").write_text(reseal(source[:offset] + template.replace("NAME", function_name) + "\n" + source[offset:]), encoding="utf-8"); binding_names.append(name)
carrier = re.findall(r"(?m)^# iicb1_app_self_sha=[0-9a-f]{64}$", source)[0]; name = "component-self-seal-carrier-alias-vacuity"; (out / f"{name}.zsh").write_text(source.replace(carrier, carrier[2:] + "; alias run_iicb1_root_owned_gate_component_snapshot='true #'", 1), encoding="utf-8"); binding_names.append(name)
if len(binding_names) != 13: raise SystemExit("ii-c-b1 component binding mutation inventory drifted")
(out / "component-binding-mutations.txt").write_text("".join(f"{name}\n" for name in binding_names), encoding="utf-8")
PY
    local component_mutation component_log component_rc
    while IFS= read -r component_mutation; do
        [[ -n $component_mutation ]] \
            || fail_contract "ii-c-b1 component mutation inventory empty"
        component_log="$out/$component_mutation.log"; component_rc=0
        "$app_gate" \
            --iic-b1-root-owned-gate-component-source-contract-only \
            "$component_mutation_root/$component_mutation.zsh" \
            >"$component_log" 2>&1 || component_rc=$?
        (( component_rc != 0 )) || fail_contract \
            "ii-c-b1 component mutation accepted: $component_mutation"
        [[ "$(<"$component_log")" == \
            "ii-c-b1 component verifier contract drifted" ]] \
            || fail_contract \
                "ii-c-b1 component mutation diagnostic drifted: $component_mutation"
    done <"$component_mutation_root/component-mutations.txt"
    while IFS= read -r component_mutation; do
        component_log="$out/$component_mutation.log"; component_rc=0
        /bin/zsh -n "$component_mutation_root/$component_mutation.zsh" || fail_contract "ii-c-b1 component binding mutation syntax drifted: $component_mutation"
        "$app_gate" --iic-b1-root-owned-gate-component-source-contract-only "$component_mutation_root/$component_mutation.zsh" >"$component_log" 2>&1 || component_rc=$?
        (( component_rc != 0 )) || fail_contract "ii-c-b1 component binding mutation accepted: $component_mutation"
        [[ "$(<"$component_log")" == "ii-c-b1 component verifier contract drifted" ]] || fail_contract "ii-c-b1 component binding mutation diagnostic drifted: $component_mutation"
    done <"$component_mutation_root/component-binding-mutations.txt"
    mkdir -p "$out/zshenv"; print "print loaded >'$out/zshenv.loaded'; alias verify_iicb1_root_owned_gate_component_source_contract='true #'" >"$out/zshenv/.zshenv"
    component_rc=0; ZDOTDIR="$out/zshenv" "$app_gate" --iic-b1-root-owned-gate-component-source-contract-only "$app_gate" >"$out/zshenv.log" 2>&1 || component_rc=$?; (( component_rc == 0 )) && [[ ! -e $out/zshenv.loaded ]] || fail_contract "ii-c-b1 zsh startup isolation drifted"
    local reuse_log="$out/component-reuse-entry.log" reuse_rc=0
    "$app_gate" --iic-b1-root-owned-gate-component-boundary-only \
        /nonexistent/iicb1-product /nonexistent/iicb1-diagnostic \
        >"$reuse_log" 2>&1 || reuse_rc=$?
    (( reuse_rc == 64 )) \
        || fail_contract "ii-c-b1 arbitrary component reuse entry accepted"
    [[ "$(<"$reuse_log")" == Usage:* ]] \
        || fail_contract "ii-c-b1 component reuse rejection diagnostic drifted"
    replay_historical_contract \
        "$out/immutable-scope-and-mutations" \
        77cde61b8c09e739ab5268531e83bcd333dcdc28 \
        9c59f241ffbfc6bc6c2a6810a9a0ce2c57b23c4b \
        --iic-b1-root-owned-gate-contract-only \
        "--iic-b1-root-owned-gate-staged-scope-contract-only"
}
function verify_iica_contract() {
    local out=$1 replay_status=0
    mkdir -p "$out"
    replay_historical_contract \
        "$out/immutable" \
        81f185c1278e0f80a3a5de856d0b8cb93c810272 \
        7cf4db75a261895ba0c86b6876623daf900bb4db \
        --iic-a-contract-only \
        '--iic-a-staged-scope-contract-only' \
        || replay_status=$?
    (( replay_status == 0 )) \
        || fail_contract 'ii-c-a historical replay failed'
}
function verify_iica_legacy_current_tree_contract() {
    local out=$1 gate=scripts/verify-investigation-boundaries
    local app_gate=scripts/verify-app-release-boundaries
    mkdir -p "$out"
    "$gate" --iic-a-source-contract-only >"$out/source.log"
    "$app_gate" --iic-a-source-contract-only >"$out/app-source.log"

    local package=Package.swift
    local gate_source=Sources/StornautInvestigationMachineGateSupport/InvestigationMachineFixedGateLauncher.swift
    local coordinator_source=Sources/StornautInvestigationMachineGateCoordinatorSupport/InvestigationMachineGateCoordinatorComposition.swift
    local project=Stornaut.xcodeproj/project.pbxproj
    local scheme=Stornaut.xcodeproj/xcshareddata/xcschemes/StornautInvestigationDiagnosticApp.xcscheme
    local installer=scripts/stornaut-r5-local-lifecycle
    local boundary=Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
    local focused=Tests/StornautInvestigationTests/InvestigationClosedMachineArtifactInstallerTests.swift
    function reject_iica_source() {
        local name=$1 expected=$2; shift 2
        local log="$out/$name.log"
        if "$gate" --iic-a-source-contract-only "$@" >"$log" 2>&1; then
            fail_contract "ii-c-a source mutation accepted: $name"
        fi
        require_fixed_text "$log" "$expected"
    }
    sed 's/name: "StornautInvestigationMachineGateSupport"/name: "StornautInvestigationMachineGateSupportMissing"/' "$package" >"$out/missing-gate-product.swift"
    reject_iica_source missing-gate-product 'static support product drifted' \
        "$out/missing-gate-product.swift" "$gate_source" "$coordinator_source" \
        "$project" "$scheme" "$installer" "$boundary" "$focused"
    awk '{print} /public enum InvestigationMachineGateSupport \{/ {print "    public static let leakedAPI = 1"}' \
        "$gate_source" >"$out/public-extra.swift"
    /usr/bin/cmp -s "$gate_source" "$out/public-extra.swift" && \
        fail_contract "ii-c-a public-extra fixture is vacuous"
    reject_iica_source public-extra 'public API surface drifted' \
        "$package" "$out/public-extra.swift" "$coordinator_source" \
        "$project" "$scheme" "$installer" "$boundary" "$focused"
    sed 's/settings = {ATTRIBUTES = (CodeSignOnCopy, ); };/settings = {ATTRIBUTES = (); };/' "$project" >"$out/codesign-copy.pbxproj"
    reject_iica_source codesign-copy 'CodeSignOnCopy membership drifted' \
        "$package" "$gate_source" "$coordinator_source" \
        "$out/codesign-copy.pbxproj" "$scheme" "$installer" \
        "$boundary" "$focused"
    sed 's/func iiCAMachinePackagingVerifierPinsClosedTopologyAndScope()/func disabledIICAMachinePackagingVerifierPinsClosedTopologyAndScope()/' "$boundary" >"$out/boundary-vacuity.swift"
    reject_iica_source boundary-vacuity 'boundary verifier coverage drifted' \
        "$package" "$gate_source" "$coordinator_source" "$project" \
        "$scheme" "$installer" "$out/boundary-vacuity.swift" "$focused"

    local expected_installer_sha=2274081f29fcecde69a9f025e796e242de2f83bbf5adf4f1b1d2c63eebc04e97
    [[ "$(shasum -a 256 "$installer" | awk '{print $1}')" == \
        "$expected_installer_sha" ]] || \
        fail_contract "ii-c-a installer source seal drifted"
    require_fixed_text "$installer" 'validate_closed_executable_identity() {'
    require_fixed_text "$installer" 'validate_closed_executable_artifact() {'
    require_fixed_text "$installer" 'validate_closed_app_artifacts() {'
    require_fixed_text "$installer" 'validate_closed_artifact_fixtures() {'
    for fixture in missing-gate swapped-gate-coordinator hardlinked-coordinator \
        symlinked-gate wrong-mode-gate wrong-signature-gate \
        mutation-before-move mutation-before-bootstrap
    do
        require_fixed_text "$app_gate" "$fixture"
    done
    require_fixed_text "$app_gate" 'verify_closed_machine_tool_disposable_matrix'

    local mutation_root="$out/installer-mutations"
    mkdir -p "$mutation_root"
    python3 - "$installer" "$mutation_root" <<'PY'
from pathlib import Path
import sys

source_path, output = map(Path, sys.argv[1:])
source = source_path.read_text(encoding="utf-8")
mutations = (
    ("installer-owner-bypass", '"$owner" == "$expected_owner" &&',
     '"$owner" != "$expected_owner" &&'),
    ("installer-mode-bypass", '"$mode" == "$expected_mode" &&',
     '"$mode" != "$expected_mode" &&'),
    ("installer-nlink-bypass", '"$links" == 1 &&', '"$links" != 1 &&'),
    ("installer-cdhash-bypass", "'^[0-9a-f]{40}([0-9a-f]{24})?$'",
     "'^[0-9a-f]+$'"),
    ("installer-node-stability-bypass",
     '[[ "$final_node" == "$initial_node" ]]',
     '[[ "$final_node" != "$initial_node" ]]'),
    ("installer-signal-deferral-bypass",
     '    staging_app_created=1\n    /bin/mkdir -m 0755 "$staging_app"',
     '    /bin/mkdir -m 0755 "$staging_app"\n    staging_app_created=1'),
)
for name, old, new in mutations:
    if old not in source:
        raise SystemExit(f"ii-c-a installer mutation fixture is vacuous: {name}")
    (output / f"{name}.zsh").write_text(
        source.replace(old, new, 1), encoding="utf-8"
    )
PY
    local mutation mutated log
    for mutation in installer-owner-bypass installer-mode-bypass \
        installer-nlink-bypass installer-cdhash-bypass \
        installer-node-stability-bypass installer-signal-deferral-bypass
    do
        mutated="$mutation_root/$mutation.zsh"
        log="$out/$mutation.log"
        if "$app_gate" --iic-a-source-contract-only "$mutated" \
            >"$log" 2>&1
        then
            fail_contract "ii-c-a installer mutation accepted: $mutation"
        fi
        require_fixed_text "$log" 'ii-c-a installer source seal drifted'
    done

    # Scope mutation inventory is executed against an isolated index by the
    # staged checkpoint gate; labels are pinned here so removals cannot vacate it.
    for label in extra-path over-budget deleted binary mode wrong-baseline \
        staged-worktree-divergence untracked
    do
        require_fixed_text "$contract_source" "$label"
    done
}

function verify_iica_legacy_current_tree_scope_mutations() {
    local out=$1 gate=scripts/verify-investigation-boundaries
    local baseline=2b30a157c14bc507351b10bd521e710987860f71
    local base=$out/base.index index blob log expected scope_baseline
    mkdir -p "$out"
    cp "$(git rev-parse --git-path index)" "$base"
    function reject_iica_scope() {
        local label=$1 expected_text=$2
        shift 2
        log="$out/$label.log"
        if "$@" >"$log" 2>&1; then
            fail_contract "ii-c-a scope mutation accepted: $label"
        fi
        require_fixed_text "$log" "$expected_text"
    }
    for fixture in extra-path over-budget deleted binary mode wrong-baseline \
        staged-worktree-divergence untracked
    do
        index="$out/$fixture.index"
        cp "$base" "$index"
        scope_baseline=$baseline
        case $fixture in
            extra-path)
                blob=$(print extra | git hash-object -w --stdin)
                GIT_INDEX_FILE="$index" git update-index --add --cacheinfo \
                    "100644,$blob,iica-extra.swift"
                expected='ii-c-a checkpoint paths drifted' ;;
            over-budget)
                blob=$(for line in {1..4000}; do
                    print "// ii-c-a $line"
                done | git hash-object -w --stdin)
                GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                    "100644,$blob,Tests/StornautInvestigationTests/InvestigationClosedMachineArtifactInstallerTests.swift"
                expected='ii-c-a checkpoint budget drifted' ;;
            deleted)
                GIT_INDEX_FILE="$index" git rm --cached -q -f Package.swift
                expected='ii-c-a checkpoint deleted an existing path' ;;
            binary)
                blob=$(printf '\0ii-c-a\n' | git hash-object -w --stdin)
                GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                    "100644,$blob,Package.swift"
                expected='ii-c-a binary checkpoint path rejected' ;;
            mode)
                blob=$(GIT_INDEX_FILE="$index" git ls-files -s -- \
                    scripts/verify-contract | awk '{print $2}')
                GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                    "100644,$blob,scripts/verify-contract"
                expected='ii-c-a staged source/mode drifted' ;;
            wrong-baseline)
                scope_baseline="$baseline^"
                expected='ii-c-a checkpoint baseline drifted' ;;
            staged-worktree-divergence)
                blob=$(print '// ii-c-a staged divergence' \
                    | git hash-object -w --stdin)
                GIT_INDEX_FILE="$index" git update-index --cacheinfo \
                    "100644,$blob,Tests/StornautInvestigationTests/InvestigationClosedMachineArtifactInstallerTests.swift"
                expected='ii-c-a staged source/mode drifted' ;;
            untracked)
                (
                    local probe=.stornaut-iica-untracked-$PPID-$RANDOM
                    trap 'rm -f -- "$probe"' EXIT INT TERM HUP
                    print untracked >"$probe"
                    reject_iica_scope "$fixture" \
                        'ii-c-a checkpoint untracked paths drifted' env \
                        GIT_INDEX_FILE="$index" "$gate" \
                        --iic-a-staged-scope-contract-only "$scope_baseline"
                )
                continue ;;
        esac
        reject_iica_scope "$fixture" "$expected" env \
            GIT_INDEX_FILE="$index" "$gate" \
            --iic-a-staged-scope-contract-only "$scope_baseline"
    done
}

function verify_iicb2a2_contract() {
    local out=$1 gate=scripts/verify-investigation-boundaries
    local release=scripts/verify-app-release-boundaries
    mkdir -p "$out"
    local accepted=294bdb207e572eead2be43921e603ce7407dcbc5
    local accepted_tree=dbbffbbae4a1ed51504e664cec7a43ff1e8cbe5d
    if [[ "$(git rev-parse HEAD)" != $accepted ]]; then
        local historical_status=0
        replay_historical_contract "$out/immutable-b2a2" \
            "$accepted" "$accepted_tree" \
            --iic-b2a2-contract-only \
            '--iic-b2a2-staged-scope-contract-only' \
            || historical_status=$?
        (( historical_status == 0 )) \
            || fail_contract "ii-c-b2a2 historical replay failed"
    fi
    local -a paths=(
        Package.swift
        Sources/StornautInvestigationMachineCampaignSupport/InvestigationMachineCampaignEvidenceContract.swift
        Sources/StornautInvestigationMachineCampaignSupport/InvestigationMachineRawEvidenceWriter.swift
        Tests/StornautInvestigationTests/InvestigationMachineCampaignEvidenceTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-investigation-runtime-machine-report
    )
    "$gate" --iic-b2a2-source-contract-only "${paths[@]}" >"$out/source.log"
    "$release" --iic-b2a2-component-source-contract-only "$release" \
        >"$out/component-source.log"
    python3 - "$out" "${paths[@]}" <<'PY'
from pathlib import Path
