function require_iib5biii_b2b1a0_mutation_rejected() {
    local name=$1 kind=$2 expected=$3
    local composition=$iib5biii_b2b1a0_composition
    local bridge=$iib5biii_b2b1a0_bridge
    local bridge_test=$iib5biii_b2b1a0_bridge_test
    local target="$contract_root/iib5biii-b2b1a0-$name.swift"
    [[ $kind == bridge ]] && bridge=$target
    [[ $kind == bridge-test ]] && bridge_test=$target
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$target"
    local output="$contract_root/iib5biii-b2b1a0-$name.log"
    if "$iib5biii_b2b1a0_gate" \
        --iib5biii-b2b1a0-provenance-contract-only \
        "$composition" "$bridge" "$bridge_test" \
        "$iib5biii_b2b1a0_protocol_test" "$iib5biii_b2b1a0_boundary" \
        >"$output" 2>&1
    then
        fail_contract "iii-b2b-1a-0 mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
}
