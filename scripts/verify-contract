from pathlib import Path
import sys

source_path, helper_path, negative_path, selector_path, fail_open_path, \
    physical_path, physical_negative_path, app_peer_dylib_path, \
    app_peer_preview_path, start_retire_main_path, \
    start_retire_preview_path, start_retire_loop_path, \
    b3c_loop_path = map(
    Path, sys.argv[1:]
)
source = source_path.read_text(encoding="utf-8")
split = source.index("\nscripts/verify-contract\n")
prefix, runtime = source[:split], source[split:]


def mutate_runtime(old, new, name):
    if runtime.count(old) != 1:
        raise SystemExit(f"cannot construct claim-server Mach-O mutation: {name}")
    return prefix + runtime.replace(old, new, 1)

def mutate_array(name, old, new, label):
    start = runtime.index(f"{name}=(\n")
    end = runtime.index("\n)\n", start) + 3
    block = runtime[start:end]
    if block.count(old) != 1:
        raise SystemExit(f"cannot construct claim-server Mach-O mutation: {label}")
    return prefix + runtime[:start] + block.replace(old, new, 1) + runtime[end:]


