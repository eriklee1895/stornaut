helper_body = "ii-c0b-ii-a3 security helper body drifted"
owner_body = "ii-c0b-ii-a3 owner security body drifted"
diagnostics = {
    "raw-descriptor-return": owner_body,
    "raw-descriptor-property": owner_body,
    "raw-descriptor-alias-function": owner_body,
    "allowed-method-signature-drift": "ii-c0b-ii-a3 no-argument owned-base API drifted",
    "raw-descriptor-extension": descriptor_declaration,
    "attributed-raw-descriptor-return": owner_member,
    "attributed-computed-property": owner_member,
    "raw-descriptor-typealias": callback_alias,
    "same-line-extra-declaration": callback_alias,
    "same-line-after-member-close": owner_body,
    "comment-brace-hidden-method": "ii-c0b-ii-a3 owner member allowlist drifted",
    "comment-prefixed-attribute": "ii-c0b-ii-a3 owner member allowlist drifted",
    "top-level-capability-typealias": callback_alias,
    "top-level-computed-property": descriptor_declaration,
    "indented-top-level-typealias": callback_alias,
    "escaping-owned-base": callback, "async-owned-base": callback,
    "acquirer-cint-callback": callback,
    "acquirer-qualified-int32-callback": callback,
    "acquirer-alias-callback": callback_alias,
    "acquirer-optional-callback": callback,
    "acquirer-inout-callback": callback,
    "acquirer-nonfirst-multiline-sendable-callback": callback,
    "acquirer-attributed-callback-return": callback,
    "acquirer-raw-descriptor-return": "ii-c0b-ii-a3 acquirer member allowlist drifted",
    "darwin-system-raw-descriptor-return": "ii-c0b-ii-a3 Darwin system security body drifted",
    "metadata-snapshot-raw-descriptor-return": "ii-c0b-ii-a3 top-level security body drifted",
    "nested-release-decoy": owner_body,
    "nested-deinit-decoy": "ii-c0b-ii-a3 owner security body drifted",
    "missing-operation-revalidation": owner_body,
    "revalidate-early-return": owner_body, "release-early-return": owner_body,
    "base-revalidation-bypass": owner_body,
    "lock-revalidation-bypass": owner_body,
    "acquirer-held-named-short-circuit": "ii-c0b-ii-a3 acquirer security body drifted",
    "root-path-literal-drift": owner_body, "reversed-close-order": owner_body,
    "base-close-failure-short-circuit": owner_body,
    "lock-close-failure-swallowed": owner_body,
    "duplicate-descriptor": descriptor_declaration,
    "child-inheritable-descriptor": "ii-c0b-ii-a3 acquirer security body drifted",
    "held-named-short-circuit": "ii-c0b-ii-a3 acquirer security body drifted",
    "cloexec-short-circuit": "ii-c0b-ii-a3 acquirer security body drifted",
    "lock-mutation": descriptor_declaration,
    "product-authority": "ii-c0b-ii-a3 gained capsule mutation or prohibited authority",
    "capsule-authority": descriptor_declaration,
    "source-seal": "ii-c0b-ii-a3 source or focused-test seal drifted",
}
if set(diagnostics) != {name for name, _ in rows}:
    raise SystemExit("ii-c0b-ii-a3 mutation diagnostic inventory drifted")
(output / "matrix").write_text(
    "".join(
        "|".join((name, app, diagnostics[name])) + "\n"
        for name, app in rows
    ),
    encoding="utf-8",
)
PY

    local name app_expected expected_diagnostic
    local candidate root log candidate_sha verifier
    local source_sha=3e8c1a586e692e705c14399acfcb637f1565da497a8e4b8cfdc2dfe7f3dd146a
    while IFS='|' read -r name app_expected expected_diagnostic; do
        candidate=$out/candidates/$name.swift
        root=$out/m-$name
        mkdir -p "$root/${source:h}" "$root/${test:h}" \
            "$root/${boundary:h}" "$root/scripts" \
            "$root/Stornaut.xcodeproj"
        cp Package.swift "$root/Package.swift"
        cp "$candidate" "$root/$source"
        cp "$test" "$root/$test"
        cp "$boundary" "$root/$boundary"
        cp "$gate" "$root/$gate"
        cp "$app_gate" "$root/$app_gate"
        cp Stornaut.xcodeproj/project.pbxproj \
            "$root/Stornaut.xcodeproj/project.pbxproj"
        chmod 755 "$root/$gate" "$root/$app_gate"
        if [[ $name != source-seal ]]; then
            candidate_sha=$(shasum -a 256 "$candidate" | awk '{print $1}')
            for verifier in "$root/$gate" "$root/$app_gate"; do
                perl -0pi -e "s/$source_sha/$candidate_sha/g" "$verifier"
            done
        fi
        log=$out/$name.log
        if (
            cd "$root"
            "$gate" --iic0b-ii-a3-retained-base-contract-only \
                "$source" "$test" "$boundary"
        ) >"$log" 2>&1
        then
            fail_contract "ii-c0b-ii-a3 mutation accepted: $name"
        fi
        require_fixed_text "$log" "$expected_diagnostic"
        [[ $name == source-seal ]] \
            || require_fixed_text "$log" 'ii-c0b-ii-a3 source seal admitted'
        if [[ $app_expected == app ]]; then
            log=$out/app-$name.log
            if (
                cd "$root"
                "$app_gate" --iic0b-ii-a3-source-contract-only \
                    Package.swift "$source" "$app_gate"
            ) >"$log" 2>&1
            then
                fail_contract "ii-c0b-ii-a3 App mutation accepted: $name"
            fi
            require_fixed_text "$log" "$expected_diagnostic"
            [[ $name == source-seal ]] \
                || require_fixed_text "$log" 'ii-c0b-ii-a3 source seal admitted'
        fi
    done <"$out/candidates/matrix"

    local -a paths=(
        "$source"
        "$test"
        "$boundary"
        "$app_gate"
        scripts/verify-contract
        "$gate"
    )
    (( ${#paths} == 6 )) \
        || fail_contract "ii-c0b-ii-a3 checkpoint path ceiling drifted"
    local index=$out/iic0biia3.index checkpoint_path blob mode
    GIT_INDEX_FILE="$index" git read-tree "$iic0biia3_baseline^{tree}"
    for checkpoint_path in "${paths[@]}"; do
        blob=$(git hash-object -w -- "$checkpoint_path")
        mode=100644
        [[ $checkpoint_path == scripts/* ]] && mode=100755
        GIT_INDEX_FILE="$index" git update-index --add --cacheinfo \
            "$mode,$blob,$checkpoint_path"
    done
    GIT_INDEX_FILE="$index" "$gate" \
        --iic0b-ii-a3-staged-scope-contract-only \
        "$iic0biia3_baseline" >"$out/scope.log"

    local fixture changed scope_baseline expected
    for fixture in extra-path missing-path over-budget deleted binary mode \
        wrong-baseline
    do
        changed=$out/scope-$fixture.index
        cp "$index" "$changed"
        scope_baseline=$iic0biia3_baseline
        case $fixture in
            extra-path)
                blob=$(git rev-parse \
                    "${iic0biia3_baseline}:AGENTS.md")
                GIT_INDEX_FILE="$changed" git update-index --add \
                    --cacheinfo "100644,$blob,iic0biia3-extra.swift"
                expected='ii-c0b-ii-a3 checkpoint paths drifted' ;;
            missing-path)
                blob=$(git rev-parse \
                    "${iic0biia3_baseline}:$boundary")
                GIT_INDEX_FILE="$changed" git update-index --cacheinfo \
                    "100644,$blob,$boundary"
                expected='ii-c0b-ii-a3 checkpoint paths drifted' ;;
            over-budget)
                for line in {1..2500}; do
                    print -r -- "// ii-c0b-ii-a3 over-budget $line"
                done >"$out/over-budget.swift"
                blob=$(git hash-object -w -- "$out/over-budget.swift")
                GIT_INDEX_FILE="$changed" git update-index --cacheinfo \
                    "100644,$blob,$boundary"
                expected='ii-c0b-ii-a3 checkpoint budget drifted' ;;
            deleted)
                GIT_INDEX_FILE="$changed" git rm --cached -q -f "$boundary"
                expected='ii-c0b-ii-a3 checkpoint deleted an existing path' ;;
            binary)
                blob=$(git rev-parse \
                    "${iic0biia3_baseline}:Tests/Fixtures/Snapshots/design-system.empty-state.dark.en.png")
                GIT_INDEX_FILE="$changed" git update-index --cacheinfo \
                    "100644,$blob,$boundary"
                expected='ii-c0b-ii-a3 binary checkpoint path rejected' ;;
            mode)
                blob=$(git hash-object -w -- scripts/verify-contract)
                GIT_INDEX_FILE="$changed" git update-index --cacheinfo \
                    "100644,$blob,scripts/verify-contract"
                expected='ii-c0b-ii-a3 checkpoint mode drifted' ;;
            wrong-baseline)
                scope_baseline=$iic0biia3_baseline^
                expected='ii-c0b-ii-a3 checkpoint baseline drifted' ;;
        esac
        log=$out/scope-$fixture.log
        if GIT_INDEX_FILE="$changed" "$gate" \
            --iic0b-ii-a3-staged-scope-contract-only \
            "$scope_baseline" >"$log" 2>&1
        then
            fail_contract "ii-c0b-ii-a3 scope mutation accepted: $fixture"
        fi
        require_fixed_text "$log" "$expected"
    done
}

function verify_iic0biib_contract() {
    local out=$1
    mkdir -p "$out"
    local iic0biib_a3_commit=128e37a045e8c362b5a98bc4198acc3715e0b29d
    local iic0biib_a3_tree=16fafcbd621201612c939deeef682417682f352a
    local iic0biib_b1_commit=30338abf8f179d2369f49d301045ebffea49237a
    local iic0biib_b1_tree=c4ca6ae2e9e262d30745e6b8548eeee10211722a
    local iic0biib_b2_commit=cbc469403f0ecfcdab17fb93baadd24d3c12f1ff
    local iic0biib_b2_tree=8ec89e24cece79ad7559a25c0fad9681442bae5d
    local iic0biib_closure_commit=6ef304d2102121c9bee5fed363bd9a80c6d33bbc
    local iic0biib_closure_tree=8b1e7ae4a8c40bb0bce795d14477fd64864b4e18
    local ownership=Sources/StornautInvestigationMachineLaunchSupport/InvestigationMachineGateOwnership.swift
    local capsule=Sources/StornautInvestigationMachineLaunchSupport/InvestigationOwnerOnlyCapsule.swift
    local focused=Tests/StornautInvestigationTests/InvestigationOwnerOnlyCapsuleTests.swift
    local boundary=Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
    local gate=scripts/verify-investigation-boundaries
    local app_gate=scripts/verify-app-release-boundaries
    local -a iic0biib_component_command=(
        "$app_gate" --iic0b-ii-b-component-boundary-only
    )
    local iic0biib_component_invocation="verify_iic0biib_component_boundary"
    local -a iic0biib_mutations=(
        recursive-cleanup ordinary-unlink raw-descriptor path-surface
        url-surface generic-callback multiple-lease lock-mutation
        mutation-before-inventory deadline-bypass wall-clock pid-heuristic
        mtime-heuristic missing-close-reap-binding product-authority
        swallowed-inventory-failure swallowed-command-failure
        attempt-uuid-unbound directory-revalidation-missing
        directory-retry-revalidation-missing directory-acl-bypass
        directory-xattr-bypass directory-inventory-bypass
        directory-close-bypass release-renamed-authority
    )
    local -a iic0biib_infrastructure_mutations=(
        target-extra-source verifier-command-failure
    )
    (( ${#iic0biib_mutations} == 25 \
        && ${#iic0biib_infrastructure_mutations} == 2 )) \
        || fail_contract "ii-c0b-ii-b mutation inventory drifted"
    [[ "$(git show -s --format=%P "$iic0biib_closure_commit")" == \
        "$iic0biib_b2_commit" \
        && "$(git show -s --format=%T "$iic0biib_closure_commit")" == \
        "$iic0biib_closure_tree" ]] \
        || fail_contract "ii-c0b-ii-b immutable closure drifted"
    local closure_replay="$out/closure-replay" closure_status=0
    replay_historical_contract "$closure_replay" "$iic0biib_closure_commit" \
        "$iic0biib_closure_tree" \
        --iic0b-ii-b-contract-only \
        '--iic0b-ii-b-staged-scope-contract-only' || closure_status=$?
    (( closure_status == 0 )) \
        || fail_contract "ii-c0b-ii-b immutable closure replay failed"
    [[ "$(git show -s --format=%P "$iic0biib_a3_commit")" == \
        fe3ea757432c4dc9cf960f210c167916697ce601 \
        && "$(git show -s --format=%T "$iic0biib_a3_commit")" == \
        "$iic0biib_a3_tree" ]] \
        || fail_contract "ii-c0b-ii-b child checkpoint drifted: a3"
    local -a a3_paths=(
        ${(f)"$(git diff-tree --no-commit-id --name-only -r \
            "$iic0biib_a3_commit" | awk 'index($0,"docs/")!=1' \
            | LC_ALL=C sort)"}
    )
    local -a expected_a3_paths=(
        Sources/StornautInvestigationMachineLaunchSupport/InvestigationMachineGateOwnership.swift
        Tests/StornautInvestigationTests/InvestigationMachineGateOwnershipTests.swift
        Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift
        scripts/verify-app-release-boundaries
        scripts/verify-contract
        scripts/verify-investigation-boundaries
    )
    [[ "${(j:\n:)a3_paths}" == "${(j:\n:)${(@on)expected_a3_paths}}" \
        && "$(git diff-tree --numstat --no-commit-id -r \
            "$iic0biib_a3_commit" \
            | awk 'index($3,"docs/")!=1 {n+=$1+$2} END{print n+0}')" == 2722 ]] \
        || fail_contract "ii-c0b-ii-b child checkpoint paths drifted: a3"
    [[ "$(git show \
        "${iic0biib_a3_commit}:Sources/StornautInvestigationMachineLaunchSupport/InvestigationMachineGateOwnership.swift" \
        | shasum -a 256 | awk '{print $1}')" == \
        3e8c1a586e692e705c14399acfcb637f1565da497a8e4b8cfdc2dfe7f3dd146a \
        && "$(git show \
        "${iic0biib_a3_commit}:Tests/StornautInvestigationTests/InvestigationMachineGateOwnershipTests.swift" \
        | shasum -a 256 | awk '{print $1}')" == \
        3d6ba434eab3703baa4881941853c8cd4fe56ed42d5827b7bb24db98d5acf4fa ]] \
        || fail_contract "ii-c0b-ii-b child source or test identity drifted: a3"
    local label commit tree parent expected_parent
    for label commit tree parent expected_parent in \
        b1 "$iic0biib_b1_commit" "$iic0biib_b1_tree" \
            "$(git show -s --format=%P "$iic0biib_b1_commit")" \
            87a19b301319422db3889d3739cc65c2d6a708bc
    do
        [[ "$parent" == "$expected_parent" \
            && "$(git show -s --format=%T "$commit")" == "$tree" ]] \
            || fail_contract "ii-c0b-ii-b child checkpoint drifted: $label"
    done
    local -a child_paths=("$ownership" "$capsule" "$focused")
    local -a b1_paths=(
        ${(f)"$(git diff-tree --no-commit-id --name-only -r \
            "$iic0biib_b1_commit" | LC_ALL=C sort)"}
    )
    [[ "${(j:\n:)b1_paths}" == "${(j:\n:)${(@on)child_paths}}" ]] \
        || fail_contract "ii-c0b-ii-b child checkpoint paths drifted"
    [[ "$(git diff-tree --numstat --no-commit-id -r \
        "$iic0biib_b1_commit" \
        | awk '{n+=$1+$2} END{print n+0}')" == 2399 ]] \
        || fail_contract "ii-c0b-ii-b child checkpoint budget drifted: b1"
    for checkpoint_path expected_sha in \
        "$ownership" 3d9bcbabf01df009eec4c6c0d6af2c8eb8877e02ba7b63c845730e73d5c23e0f \
        "$capsule" d0ace5b5b6b4be33473174178e9808cff7b8a9072f8138e54aaa76bcc385c8d8 \
        "$focused" d8a6a26420fd51b29993fed9f2e4658e70e07d9953d51badb1ec0a1bbc531fdd
    do
        [[ "$(git show \
            "${iic0biib_b1_commit}:$checkpoint_path" \
            | shasum -a 256 | awk '{print $1}')" == "$expected_sha" ]] \
            || fail_contract \
                "ii-c0b-ii-b child source or test identity drifted: b1: $checkpoint_path"
    done
    (( ${#iic0biib_component_command} == 2 )) \
        || fail_contract "ii-c0b-ii-b component command drifted"
    require_fixed_text "$app_gate" \
        'if $iic0biib_component_boundary_only; then'
    require_fixed_text "$app_gate" 'verify_iic0biib_component_boundary'
    require_fixed_text "$app_gate" \
        '# Reuse the exact artifacts built by the enclosing a3 component gate.'
    local iic0biib_a3_body
    iic0biib_a3_body=$(python3 - "$app_gate" <<'PY'
from pathlib import Path
import re
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
matches = re.findall(
    r"(?ms)^function verify_iic0biia3_component_boundary\(\) \{.*?^\}\n",
    source,
)
if len(matches) != 1:
    raise SystemExit("ii-c0b-ii-b shared component owner drifted")
print(matches[0], end="")
PY
    ) || fail_contract "ii-c0b-ii-b shared component owner drifted"
    [[ "$(print -r -- "$iic0biib_a3_body" \
        | rg -c --fixed-strings -- "$iic0biib_component_invocation")" == 1 ]] \
        || fail_contract "ii-c0b-ii-b component build reuse drifted"

    "$gate" --iic0b-ii-b-capsule-contract-only \
        Package.swift "$ownership" "$capsule" "$focused" "$boundary" \
        >"$out/semantic.log"
    "$app_gate" --iic0b-ii-b-source-contract-only \
        Package.swift "$ownership" "$capsule" "$app_gate" \
        >"$out/source.log"

    mkdir -p "$out/candidates"
    python3 - "$capsule" "$out/candidates" <<'PY'
from pathlib import Path
import sys

source_path, output = map(Path, sys.argv[1:])
source = source_path.read_text(encoding="utf-8")
rows = []

def mutate(name, old, new, diagnostic, count=1, app=True):
    observed = source.count(old)
    if observed != count:
        raise SystemExit(
            f"cannot construct ii-c0b-ii-b mutation: {name}: "
            f"expected {count} anchors, observed {observed}"
        )
    (output / f"{name}.swift").write_text(
        source.replace(old, new, count), encoding="utf-8"
    )
    rows.append((name, "app" if app else "semantic", diagnostic))

surface = "ii-c0b-ii-b raw descriptor, path, URL or callback surface drifted"
authority = "ii-c0b-ii-b product or privileged reachability drifted"
cleanup = "ii-c0b-ii-b broad cleanup or lock mutation drifted"
