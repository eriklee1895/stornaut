    local composition=$iib5biii_b2b0_composition
    local boundary=$iib5biii_b2b0_boundary
    local target="$contract_root/iib5biii-b2b0-$name.swift"
    [[ $kind == observer ]] && observer=$target
    [[ $kind == session ]] && session=$target
    [[ $kind == composition ]] && composition=$target
    [[ $kind == boundary ]] && boundary=$target
    xcrun swiftc -frontend -parse -enable-bare-slash-regex "$target"
    local output="$contract_root/iib5biii-b2b0-$name.log"
    if "$iib5biii_b2b0_gate" \
        --iib5biii-b2b0-release-graph-contract-only \
        "$observer" "$session" "$composition" "$boundary" \
        >"$output" 2>&1
    then
        fail_contract "iii-b2b-0 mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
}
