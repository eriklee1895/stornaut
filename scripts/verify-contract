start_retire_loop_path.write_text(mutate_runtime(
    'for marker in "${start_retire_seam_forbidden_markers[@]}"; do\n'
    '    for forbidden_image in "${start_retire_seam_closed_images[@]}"; do\n'
    '        if mach_o_image_has_raw_string "$forbidden_image" "$marker"; then\n'
    '            print -u2 "Start-retire seam leaked into a closed image: $forbidden_image: $marker"\n',
    'for marker in "${start_retire_seam_forbidden_markers[@]}"; do\n'
    '    for forbidden_image in "${start_retire_seam_closed_images[@]}"; do\n'
