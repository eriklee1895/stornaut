    if [[ "$(git rev-parse HEAD)" != \
        373431d4d1c4022815eca3c0c5ac3dd9aa4c5f2d ]]; then
        replay_historical_contract "$out/immutable" \
            373431d4d1c4022815eca3c0c5ac3dd9aa4c5f2d \
            b08342e5a17d678768309a2efd190ef33e37b3e8 \
            --iic0b-iv-b1-handoff-contract-only || return $?
        return 0
    fi
    "$gate" --iic0b-iv-b1-handoff-contract-only \
        Tests/Fixtures/InvestigationFixedGateHandoff/main.swift \
