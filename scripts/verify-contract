    "switch system.metadata(for: descriptor) {\n        case .success(let metadata):\n            finalDescriptorMetadata = metadata",
    "switch system.metadata(at: expectation.url) {\n        case .success(let metadata):\n            finalDescriptorMetadata = metadata")
emit("close-release", "defer { system.close(descriptor) }", "")
