import copy, json
from pathlib import Path
import sys

describe_path, dump_path, root = map(Path, sys.argv[1:])
describe = json.loads(describe_path.read_text(encoding="utf-8"))
dump = json.loads(dump_path.read_text(encoding="utf-8"))
root.mkdir()
mutations = {}
value = copy.deepcopy(describe)
next(t for t in value["targets"] if t["name"] == "StornautInvestigationMachineClaimServer")["target_dependencies"].append("StornautCore")
mutations["dependency"] = (value, dump)
value = copy.deepcopy(dump)
next(p for p in value["products"] if p["name"] == "StornautInvestigationMachineClaimServer")["type"] = {"library": ["dynamic"]}
mutations["product"] = (describe, value)
value = copy.deepcopy(describe)
next(t for t in value["targets"] if t["name"] == "StornautCore")["target_dependencies"].append("StornautInvestigationMachineClaimServer")
mutations["consumer"] = (value, dump)
value = copy.deepcopy(describe)
next(t for t in value["targets"] if t["name"] == "StornautLifecycle")["target_dependencies"].append("StornautInvestigationHandoffContract")
mutations["reverse"] = (value, dump)
for name, (description, manifest) in mutations.items():
    (root / f"{name}-describe.json").write_text(json.dumps(description))
    (root / f"{name}-dump.json").write_text(json.dumps(manifest))
