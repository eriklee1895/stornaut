from pathlib import Path
import sys
package_path, source_path, root = map(Path, sys.argv[1:])
package = package_path.read_text(encoding="utf-8")
source = source_path.read_text(encoding="utf-8")

def mutation(name, old, new, text=source, suffix="swift"):
    if text.count(old) != 1:
        raise SystemExit(f"cannot construct ii-b5b-i-b1 mutation: {name}")
    (root / f"iib5bib1-{name}.{suffix}").write_text(
        text.replace(old, new, 1), encoding="utf-8"
    )

mutation("dependency",
    'name: "StornautInvestigationInstalledL2",\n            dependencies: [\n                "StornautInvestigationHandoffContract",\n            ]',
    'name: "StornautInvestigationInstalledL2",\n            dependencies: [\n                "StornautInvestigationHandoffContract",\n                "StornautLifecycle",\n            ]',
    text=package)
mutation("public-observation",
    "package struct InvestigationInstalledL2SemanticObservation:",
    "public struct InvestigationInstalledL2SemanticObservation:")
mutation("codable-observation",
    "package struct InvestigationInstalledL2SemanticObservation:\n    Sendable,\n    Equatable\n{",
    "package struct InvestigationInstalledL2SemanticObservation:\n    Sendable,\n    Equatable,\n    Codable\n{")
mutation("physical-authority", "import Foundation\n",
    "import Foundation\nprivate let forbidden = socketpair(0, 0, 0, nil)\n")
mutation("artifact-closure", "Set(artifacts.keys) == allRoles",
    "artifacts.count <= allRoles.count")
mutation("signing-join", "app.staticSigning == app.liveSigning,",
    "app.staticSigning == app.staticSigning,")
mutation("driver-signing-join",
    "machineDriver.staticSigning == machineDriver.liveSigning,",
    "machineDriver.staticSigning == machineDriver.staticSigning,")
mutation("service-join", "service == .loaded(identity: helper.identity),",
    "service == service,")
mutation("cross-clock",
    "observed.wallUTC < projection.configurationValidBefore,",
    "observed.continuousNanoseconds < UInt64(projection.configurationValidBefore.rawValue),")
PY
for fixture in \
    dependency:'ii-b5b-i-b1 dependency surface drifted' \
    public-observation:'ii-b5b-i-b1 public surface drifted' \
    codable-observation:'ii-b5b-i-b1 authority or schema surface drifted' \
    physical-authority:'ii-b5b-i-b1 authority or schema surface drifted' \
    artifact-closure:'ii-b5b-i-b1 semantic contract drifted' \
    signing-join:'ii-b5b-i-b1 semantic contract drifted' \
    driver-signing-join:'ii-b5b-i-b1 semantic contract drifted' \
    service-join:'ii-b5b-i-b1 semantic contract drifted' \
    cross-clock:'ii-b5b-i-b1 semantic contract drifted'; do
    name=${fixture%%:*}; expected=${fixture#*:}
    semantic="$iib5bib1_source"; package="$iib5bib1_package"
    [[ $name == dependency ]] \
        && package="$contract_root/iib5bib1-$name.swift" \
        || semantic="$contract_root/iib5bib1-$name.swift"
    xcrun swiftc -frontend -parse "$semantic"
    output="$contract_root/iib5bib1-$name.log"
    if "$iib5bib1_gate" --iib5bib1-semantic-contract-only \
        "$package" "$semantic" "$iib5bib1_test" >"$output" 2>&1; then
        fail_contract "ii-b5b-i-b1 mutation accepted: $name"
    fi
    require_fixed_text "$output" "$expected"
done

