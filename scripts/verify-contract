from pathlib import Path
import sys
leaf_path, composition_path, root = map(Path, sys.argv[1:])
leaf = leaf_path.read_text(encoding="utf-8")
composition = composition_path.read_text(encoding="utf-8")

def mutate(source, old, new, name):
    if source.count(old) != 1:
        raise SystemExit(f"cannot construct ii-b3c mutation: {name}")
    (root / f"{name}.swift").write_text(
        source.replace(old, new, 1), encoding="utf-8"
    )

mutate(leaf, "public static func run() async -> Int32",
       "public static func run() -> Int32", "b3c-public")
mutate(leaf, "lock.withLock {",
       "if !consumed {", "b3c-admission-lock")
