                blob=$(git hash-object -w -- "$staged_divergence")
                GIT_INDEX_FILE="$changed" git update-index \
                    --cacheinfo "100644,$blob,Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift"
                expected='ii-c0b-iv-b1b-ii staged/worktree source drifted: Tests/StornautInvestigationTests/InvestigationMachineTargetBoundaryTests.swift' ;;
        esac
        log="$out/scope-$fixture.log"
        if GIT_INDEX_FILE="$changed" "$gate" \
            --iic0b-iv-b1b-ii-staged-scope-contract-only \
            "$scope_baseline" >"$log" 2>&1
        then
            fail_contract "ii-c0b-iv-b1b-ii scope mutation accepted: $fixture"
        fi
        require_fixed_text "$log" "$expected"
    done
}

function verify_iic0bivb2_contract() {
    local out=$1 run_component=${2:-true} gate=scripts/verify-investigation-boundaries
    local accepted=8452f9c466574e550ac8bc8540287b76d444e07e
    local accepted_tree=eb85858c683282feccc1c76c0e08bde1db937b86
    if [[ "$(git rev-parse HEAD)" != $accepted ]]; then
        local historical_status=0
        replay_historical_contract "$out/immutable-iv-b2" \
            "$accepted" "$accepted_tree" \
            --iic0b-iv-b2-composition-contract-only \
            '--iic0b-iv-b2-staged-scope-contract-only' \
            || historical_status=$?
        (( historical_status == 0 )) \
            || fail_contract 'ii-c0b-iv-b2 historical replay failed'
        return 0
    fi
    mkdir -p "$out"; local replay_status=0
    replay_historical_contract "$out/c0b-i-immutable" 2493e0f28e0c8d406b4efcdbf17713bde3633449 8155d64c4966fb83c332f7d195a92095e0af2ba9 --iic0b-i-accepted || replay_status=$?
    (( replay_status == 0 )) || fail_contract 'ii-c0b-i immutable historical replay failed'
    "$gate" --iic0b-iv-source-contract-only >"$out/source.log"
    "$gate" --iic0b-iv-b2-staged-scope-contract-only >"$out/scope.log"; verify_iic0bivb2_mutations "$out/mutations"
    [[ $run_component != true ]] || scripts/verify-app-release-boundaries --iic0b-iv-component-boundary-only >"$out/component.log"
    verify_iic0biia3_contract "$out/c0b-ii-a3"; verify_iic0biib_contract "$out/c0b-ii-b"
    verify_iic0biii2a_contract "$out/c0b-iii"; verify_iic0bivb1_contract "$out/iv-b1"
}

function verify_iic0bivb2_subordinate_source_seals() {
    local investigation=${STORNAUT_IIC0BIVB2_INVESTIGATION_BOUNDARY_SOURCE:-scripts/verify-investigation-boundaries}
    local release=${STORNAUT_IIC0BIVB2_APP_RELEASE_BOUNDARY_SOURCE:-scripts/verify-app-release-boundaries}
    local expected_investigation=4e7b9a8734f5c7581925057f6188f48eda832cb3674e601d90bb2a25ef13315b
    local expected_release=b648f1d5f5d1d23e17ed068dfe52bc47f1f33735f4b930dfe445290e6172829b
    if [[ -z ${STORNAUT_IIC0BIVB2_INVESTIGATION_BOUNDARY_SOURCE:-} ]]; then investigation=$(mktemp); git show 8452f9c466574e550ac8bc8540287b76d444e07e:scripts/verify-investigation-boundaries >"$investigation"; expected_investigation=8447227d21d2fc88338cd9bfd0b36a8ecfa5310f23d484ee59d7442f496186be; fi
    if [[ -z ${STORNAUT_IIC0BIVB2_APP_RELEASE_BOUNDARY_SOURCE:-} ]]; then release=$(mktemp); git show 8452f9c466574e550ac8bc8540287b76d444e07e:scripts/verify-app-release-boundaries >"$release"; expected_release=b51cfb2114a41205bb07b9b66bdd52e4e86d755316a44faafec62278f02eefee; fi
    [[ "$(shasum -a 256 "$investigation" | awk '{print $1}')" == $expected_investigation ]] || fail_contract 'Machine driver verifier source seal drifted: scripts/verify-investigation-boundaries'
    [[ "$(shasum -a 256 "$release" | awk '{print $1}')" == $expected_release ]] || fail_contract 'Machine driver verifier source seal drifted: scripts/verify-app-release-boundaries'
}

