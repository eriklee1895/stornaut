function expect_cli_usage_failure_without_execution() {
    local case_name=$1
    shift
    local output="$contract_root/$case_name.log"
    local trace="$contract_root/$case_name.trace"
    : > "$trace"

    local cli_status=0
    STORNAUT_VERIFY_CONTRACT_TRACE="$trace" \
        "$contract_root/scripts/verify" "$@" \
        >"$output" 2>&1 || cli_status=$?
    if (( cli_status != 64 )); then
        fail_contract \
            "$case_name returned $cli_status instead of usage status 64"
    fi
    require_fixed_text "$output" 'Usage:'
    if [[ -s "$trace" ]]; then
        fail_contract "$case_name executed receipt or verifier stages"
    fi
}

expect_cli_usage_failure_without_execution \
    step-without-mode --step source-boundaries
expect_cli_usage_failure_without_execution \
    step-without-value --headless --step
expect_cli_usage_failure_without_execution \
    unknown-step --headless --step unknown-step
expect_cli_usage_failure_without_execution \
    duplicate-step --headless --step source-boundaries \
        --step source-boundaries
expect_cli_usage_failure_without_execution \
    listed-step --headless --step source-boundaries --list-steps
expect_cli_usage_failure_without_execution \
    incompatible-step --headless --step xcuitest

list_trace="$contract_root/list.trace"
: > "$list_trace"
STORNAUT_VERIFY_CONTRACT_TRACE="$list_trace" \
    "$contract_root/scripts/verify" --headless --list-steps \
    >"$contract_root/list.log"
if [[ -s "$list_trace" ]]; then
    fail_contract "Listing verifier steps unexpectedly ran receipt preflight"
fi

mkdir -p "$contract_root/.derivedData/verification"
print -r -- 'authoritative-full-sentinel' \
    > "$contract_root/.derivedData/verification/full-timings.tsv"
exact_trace="$contract_root/exact.trace"
: > "$exact_trace"
STORNAUT_VERIFY_CONTRACT_TRACE="$exact_trace" \
STORNAUT_VERIFY_CONTRACT_STAGE_STATUS=0 \
    "$contract_root/scripts/verify" \
    --full --step phase-c-trash-diagnostic-contract \
    >"$contract_root/exact.log" 2>&1
if [[ "$(<"$exact_trace")" != $'receipt\ndiagnostic-contract' ]]; then
    fail_contract "Exact verifier step did not run receipt then stage once"
fi
if [[ "$(<"$contract_root/.derivedData/verification/full-timings.tsv")" \
    != 'authoritative-full-sentinel' ]]; then
    fail_contract "Exact verifier step overwrote authoritative full timings"
fi
exact_timing="$contract_root/.derivedData/verification/steps/full/phase-c-trash-diagnostic-contract-timings.tsv"
if [[ ! -s "$exact_timing" ]] \
    || (( $(wc -l < "$exact_timing") != 2 )); then
    fail_contract "Exact verifier step did not persist isolated timing"
fi
require_fixed_text "$contract_root/exact.log" 'diagnostic only'
if rg -q --fixed-strings 'Verification passed in full mode.' \
    "$contract_root/exact.log"; then
    fail_contract "Exact verifier step claimed authoritative full success"
fi

receipt_failure_trace="$contract_root/receipt-failure.trace"
: > "$receipt_failure_trace"
receipt_failure_status=0
STORNAUT_VERIFY_CONTRACT_TRACE="$receipt_failure_trace" \
STORNAUT_VERIFY_CONTRACT_RECEIPT_STATUS=74 \
STORNAUT_VERIFY_CONTRACT_STAGE_STATUS=0 \
    "$contract_root/scripts/verify" \
    --full --step phase-c-trash-diagnostic-contract \
    >"$contract_root/receipt-failure.log" 2>&1 \
    || receipt_failure_status=$?
if (( receipt_failure_status != 74 )); then
    fail_contract \
        "Exact verifier step did not preserve receipt failure status"
fi
if [[ "$(<"$receipt_failure_trace")" != receipt ]]; then
    fail_contract "Exact verifier step ran after receipt preflight failed"
fi

diagnostic_contract_output="$contract_root/diagnostic-contract.log"
if "$contract_root/scripts/verify" --full \
    >"$diagnostic_contract_output" 2>&1
then
    fail_contract "Full verifier ignored a broken target-aware Trash contract"
fi
require_fixed_text "$diagnostic_contract_output" \
    '[verify][full] FAIL  phase-c-trash-diagnostic-contract'
if rg -q 'START ui-automation-readiness' "$diagnostic_contract_output"; then
    fail_contract \
        "Full verifier entered UI readiness after a broken Trash diagnostic contract"
fi

