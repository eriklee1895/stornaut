for fixture in extra-path over-budget deleted binary mode wrong-baseline; do
    index="$contract_root/iib5biii-b2b1b-scope-$fixture.index"
    cp "$iib5biii_b2b1b_index" "$index"
    baseline=$iib5biii_b2b1b_baseline
    case $fixture in
        extra-path)
            blob=$(git rev-parse "${iib5biii_b2b1b_baseline}:AGENTS.md")
