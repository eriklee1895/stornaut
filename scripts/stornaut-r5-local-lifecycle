#!/bin/zsh

set -euo pipefail

typeset -a expected_source_hashes; source_plist_base64=
if [[ ${1:-} == --held-source ]]; then
    [[ $# == 10 && $2 == /* && -d $2 && ! -L $2 && ${2:A} == $2 ]] || exit 64
    repo_root=$2; action=$3; expected_source_hashes=("${@:4:6}"); source_plist_base64=${10}; set -- "$action"
else repo_root=${0:A:h:h}; action=${1:-}; expected_source_hashes=(); fi
label="com.eriklee.stornaut.lifecycle"
machine_claim_service="com.eriklee.stornaut.lifecycle.machine-claim"
machine_driver_validation_token="I authorize one bounded disposable read-only Stornaut L3c3b-ii Machine driver validation."
machine_driver_max_bytes=$((16 * 1024 * 1024))
machine_gate_max_bytes=$((64 * 1024 * 1024))
machine_coordinator_max_bytes=$((64 * 1024 * 1024))
application_support="/Library/Application Support"
installed_root="$application_support/Stornaut"
installed_app="$installed_root/Stornaut-R5-Diagnostic.app"
installed_plist="/Library/LaunchDaemons/$label.plist"
lease_root="/private/var/db/com.eriklee.stornaut.r5"
diagnostic_root="$installed_root/R5Runtime"
built_app="$repo_root/.derivedData/xcodebuildmcp/Build/Products/Debug/StornautInvestigationDiagnostic.app"
source_plist="$repo_root/StornautLifecycleHelper/$label.plist"

if [[ "$action" == validate-machine-driver ]]; then
    if [[ $# != 6 ]]; then
        print -u2 \
            "Usage: $0 validate-machine-driver <exact-token> <temporary-root> <built-app> <staging-app> <installed-app>"
        exit 64
    fi
elif [[ $# != 1 || "$action" != (status|install|uninstall) ]]; then
    print -u2 "Usage: $0 <status|install|uninstall>"
    exit 64
fi

exact_file_metadata() {
    local path=$1
    local expected_owner=$2
    local expected_group=$3
    local expected_mode=$4
    local file_type owner group mode links acl_listing

    [[ -e "$path" && ! -L "$path" ]] || return 1
    file_type=$(/usr/bin/stat -f '%HT' "$path")
    owner=$(/usr/bin/stat -f '%Su' "$path")
    group=$(/usr/bin/stat -f '%Sg' "$path")
    mode=$(/usr/bin/stat -f '%Mp%Lp' "$path")
    links=$(/usr/bin/stat -f '%l' "$path")
    acl_listing=$(/bin/ls -lde "$path")
    [[ "$file_type" == "Regular File" &&
        "$owner" == "$expected_owner" &&
        "$group" == "$expected_group" &&
        "$mode" == "$expected_mode" &&
        "$links" == 1 &&
        "$acl_listing" != *$'\n'* ]]
}

exact_directory_metadata() {
    local path=$1
    local expected_owner=$2
    local expected_group=$3
    local expected_mode=$4
    local file_type owner group mode

    [[ -d "$path" && ! -L "$path" ]] || return 1
    file_type=$(/usr/bin/stat -f '%HT' "$path")
    owner=$(/usr/bin/stat -f '%Su' "$path")
    group=$(/usr/bin/stat -f '%Sg' "$path")
    mode=$(/usr/bin/stat -f '%Mp%Lp' "$path")
    [[ "$file_type" == "Directory" &&
        "$owner" == "$expected_owner" &&
        "$group" == "$expected_group" &&
        "$mode" == "$expected_mode" ]]
}

validate_closed_executable_identity() {
    local executable=$1
    local descriptor=${2:-$executable}
    local expected_node=${3:-}
    local expected_signing_identifier=$4
    local claim_service_identifier=${5:-}
    local signing_output signing_identifier code_directory_hash signature_kind
    local designated_requirement designated_requirement_sha256
    local executable_sha256 observed_node

    observed_node=$(/usr/bin/stat -f '%d:%i' "$executable")
    [[ -z "$expected_node" || "$observed_node" == "$expected_node" ]]
    /usr/bin/codesign --verify --strict "$executable"
    observed_node=$(/usr/bin/stat -f '%d:%i' "$executable")
    [[ -z "$expected_node" || "$observed_node" == "$expected_node" ]]
    observed_node=$(/usr/bin/stat -f '%d:%i' "$executable")
    [[ -z "$expected_node" || "$observed_node" == "$expected_node" ]]
    signing_output=$(
        /usr/bin/codesign -d --verbose=4 "$executable" 2>&1
    )
    observed_node=$(/usr/bin/stat -f '%d:%i' "$executable")
    [[ -z "$expected_node" || "$observed_node" == "$expected_node" ]]
    signing_identifier=$(
        print -r -- "$signing_output" |
            /usr/bin/sed -n 's/^Identifier=//p'
    )
    code_directory_hash=$(
        print -r -- "$signing_output" |
            /usr/bin/sed -n 's/^CDHash=//p'
    )
    signature_kind=$(
        print -r -- "$signing_output" |
            /usr/bin/sed -n 's/^Signature=//p'
    )
    case "$expected_signing_identifier" in
        com.eriklee.stornaut.investigation.machine-driver)
            [[ "$claim_service_identifier" == "$machine_claim_service" ]]
            ;;
        com.eriklee.stornaut.investigation.machine-gate|com.eriklee.stornaut.investigation.machine-gate-coordinator)
            [[ -z "$claim_service_identifier" ]]
            ;;
        *) return 1 ;;
    esac
    [[ "$signing_identifier" == "$expected_signing_identifier" ]]
    [[ "$signing_identifier" != *$'\n'* ]]
    [[ "$code_directory_hash" != *$'\n'* ]]
    [[ "$signature_kind" == adhoc ]]
    print -rn -- "$code_directory_hash" |
        /usr/bin/grep -Eq '^[0-9a-f]{40}([0-9a-f]{24})?$'

    observed_node=$(/usr/bin/stat -f '%d:%i' "$executable")
    [[ -z "$expected_node" || "$observed_node" == "$expected_node" ]]
    designated_requirement=$(
        /usr/bin/codesign -d -r- "$executable" 2>&1 |
            /usr/bin/sed -n 's/^# //p'
    )
    observed_node=$(/usr/bin/stat -f '%d:%i' "$executable")
    [[ -z "$expected_node" || "$observed_node" == "$expected_node" ]]
    [[ "$designated_requirement" != *$'\n'* ]]
    [[ "$designated_requirement" ==
        "designated => cdhash H\"$code_directory_hash\"" ]]
    designated_requirement_sha256=$(
        /usr/bin/csreq -r="$designated_requirement" -b /dev/stdout |
            /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}'
    )
    print -rn -- "$designated_requirement_sha256" |
        /usr/bin/grep -Eq '^[0-9a-f]{64}$'

    executable_sha256=$(
        /usr/bin/shasum -a 256 "$descriptor" |
            /usr/bin/awk '{print $1}'
    )
    print -rn -- "$executable_sha256" |
        /usr/bin/grep -Eq '^[0-9a-f]{64}$'
    observed_node=$(/usr/bin/stat -f '%d:%i' "$executable")
    [[ -z "$expected_node" || "$observed_node" == "$expected_node" ]]
    /usr/bin/codesign --verify --strict "$executable"
    observed_node=$(/usr/bin/stat -f '%d:%i' "$executable")
    [[ -z "$expected_node" || "$observed_node" == "$expected_node" ]]

    print -r -- \
        "executableSHA256=$executable_sha256
signingIdentifier=$signing_identifier
designatedRequirement=$designated_requirement
designatedRequirementSHA256=$designated_requirement_sha256
codeDirectoryHash=$code_directory_hash
isAdHoc=true"
    if [[ -n "$claim_service_identifier" ]]; then
        [[ "$claim_service_identifier" == "$machine_claim_service" ]]
        print -r -- \
            "machineClaimServiceIdentifier=$machine_claim_service"
    fi
}

validate_closed_executable_artifact() {
    (
        setopt local_options pipe_fail
        zmodload -F zsh/system b:sysopen b:sysseek
        zmodload -F zsh/stat b:zstat

        local executable=$1
        local expected_owner=$2
        local expected_group=$3
        local expected_signing_identifier=$4
        local max_bytes=$5
        local claim_service_identifier=${6:-}
        local expected_identity=${7:-}
        local initial_node opened_node final_node
        local initial_uid initial_gid final_size
        local first_identity second_identity
        local executable_size executable_architectures
        integer executable_fd
        typeset -A descriptor_stat

        exact_file_metadata \
            "$executable" "$expected_owner" "$expected_group" 0755
        initial_node=$(/usr/bin/stat -f '%d:%i' "$executable")
        initial_uid=$(/usr/bin/stat -f '%u' "$executable")
        initial_gid=$(/usr/bin/stat -f '%g' "$executable")
        executable_size=$(/usr/bin/stat -f '%z' "$executable")
        (( executable_size > 0 && executable_size <= max_bytes ))
        sysopen -r -o nofollow -u executable_fd "$executable"
        zstat -H descriptor_stat -f "$executable_fd"
        opened_node=$(/usr/bin/stat -f '%d:%i' "$executable")
        [[ "$initial_node" == "$opened_node" ]]
        [[ "$opened_node" ==
            "${descriptor_stat[device]}:${descriptor_stat[inode]}" ]]
        [[ "${descriptor_stat[size]}" == "$executable_size" ]]
        [[ "${descriptor_stat[nlink]}" == 1 ]]
        [[ "${descriptor_stat[uid]}" == "$initial_uid" ]]
        [[ "${descriptor_stat[gid]}" == "$initial_gid" ]]
        (( (descriptor_stat[mode] & 8#170000) == 8#100000 ))
        (( (descriptor_stat[mode] & 8#777) == 8#755 ))
        executable_architectures=$(
            /usr/bin/lipo -archs "/dev/fd/$executable_fd"
        )
        [[ "$executable_architectures" == arm64 ]]
        [[ "$(/usr/bin/stat -f '%d:%i' "$executable")" ==
            "$opened_node" ]]

        [[ "$(/usr/bin/stat -f '%d:%i' "$executable")" ==
            "$opened_node" ]]
        /usr/bin/codesign --verify --strict "$executable"
        [[ "$(/usr/bin/stat -f '%d:%i' "$executable")" ==
            "$opened_node" ]]
        sysseek -u "$executable_fd" 0
        first_identity=$(
            validate_closed_executable_identity \
                "$executable" "/dev/fd/$executable_fd" \
                "$opened_node" "$expected_signing_identifier" \
                "$claim_service_identifier"
        )
        sysseek -u "$executable_fd" 0
        second_identity=$(
            validate_closed_executable_identity \
                "$executable" "/dev/fd/$executable_fd" \
                "$opened_node" "$expected_signing_identifier" \
                "$claim_service_identifier"
        )
        [[ "$second_identity" == "$first_identity" ]]
        final_node=$(/usr/bin/stat -f '%d:%i' "$executable")
        [[ "$final_node" == "$initial_node" ]]
        exact_file_metadata \
            "$executable" "$expected_owner" "$expected_group" 0755
        final_size=$(/usr/bin/stat -f '%z' "$executable")
        [[ "$final_size" == "$executable_size" ]]
        zstat -H descriptor_stat -f "$executable_fd"
        [[ "$final_node" ==
            "${descriptor_stat[device]}:${descriptor_stat[inode]}" ]]
        [[ "${descriptor_stat[size]}" == "$executable_size" ]]
        [[ "${descriptor_stat[nlink]}" == 1 ]]
        [[ "${descriptor_stat[uid]}" == "$initial_uid" ]]
        [[ "${descriptor_stat[gid]}" == "$initial_gid" ]]

        if [[ -n "$expected_identity" ]]; then
            [[ "$first_identity" == "$expected_identity" ]]
        fi
        print -r -- "$first_identity"
    )
}

validate_closed_app_artifacts() {
    local app=$1
    local expected_owner=$2
    local expected_group=$3
    local expected_identity=${4:-}
    local initial_app_node final_app_node
    local driver_identity gate_identity coordinator_identity closed_identity

    exact_directory_metadata "$app" "$expected_owner" "$expected_group" 0755
    initial_app_node=$(/usr/bin/stat -f '%d:%i' "$app")
    driver_identity=$(
        validate_closed_executable_artifact \
            "$app/Contents/MacOS/StornautInvestigationMachineDriver" \
            "$expected_owner" "$expected_group" \
            com.eriklee.stornaut.investigation.machine-driver \
            "$machine_driver_max_bytes" "$machine_claim_service"
    )
    gate_identity=$(
        validate_closed_executable_artifact \
            "$app/Contents/MacOS/StornautInvestigationMachineGate" \
            "$expected_owner" "$expected_group" \
            com.eriklee.stornaut.investigation.machine-gate \
            "$machine_gate_max_bytes" ""
    )
    coordinator_identity=$(
        validate_closed_executable_artifact \
            "$app/Contents/MacOS/StornautInvestigationMachineGateCoordinator" \
            "$expected_owner" "$expected_group" \
            com.eriklee.stornaut.investigation.machine-gate-coordinator \
            "$machine_coordinator_max_bytes" ""
    )
    final_app_node=$(/usr/bin/stat -f '%d:%i' "$app")
    [[ "$final_app_node" == "$initial_app_node" ]]
    exact_directory_metadata "$app" "$expected_owner" "$expected_group" 0755
    closed_identity="machineDriverIdentity={
$driver_identity
}
machineGateIdentity={
$gate_identity
}
machineCoordinatorIdentity={
$coordinator_identity
}"
    if [[ -n "$expected_identity" ]]; then
        [[ "$closed_identity" == "$expected_identity" ]]
    fi
    print -r -- "$closed_identity"
}

validate_closed_artifact_fixtures() {
    local token=$1
    local temporary_root=$2
    local built_app=$3
    local staging_app=$4
    local installed_app=$5
    local canonical_validation_parent canonical_temporary_root
    local canonical_built_app
    local canonical_staging_app canonical_installed_app
    local fixture_owner fixture_group built_closed_artifact_identity
    local staging_closed_artifact_identity installed_closed_artifact_identity

    [[ "$token" == "$machine_driver_validation_token" ]]
    [[ "$token" != */* ]]
    [[ "$temporary_root" == /* ]]
    [[ "$built_app" == /* ]]
    [[ "$staging_app" == /* ]]
    [[ "$installed_app" == /* ]]
    canonical_validation_parent=$(
        /bin/realpath "$repo_root/.derivedData"
    )
    canonical_temporary_root=$(/bin/realpath "$temporary_root")
    canonical_built_app=$(/bin/realpath "$built_app")
    canonical_staging_app=$(/bin/realpath "$staging_app")
    canonical_installed_app=$(/bin/realpath "$installed_app")
    [[ "$temporary_root" == "$canonical_temporary_root" ]]
    [[ "$built_app" == "$canonical_built_app" ]]
    [[ "$staging_app" == "$canonical_staging_app" ]]
    [[ "$installed_app" == "$canonical_installed_app" ]]
    [[ "$canonical_validation_parent" == /* ]]
    [[ "$canonical_temporary_root" ==
        "$canonical_validation_parent/"* ]]
    [[ "$canonical_temporary_root" !=
        "$canonical_validation_parent" ]]
    [[ "$canonical_built_app" == "$canonical_temporary_root/"* ]]
    [[ "$canonical_staging_app" == "$canonical_temporary_root/"* ]]
    [[ "$canonical_installed_app" == "$canonical_temporary_root/"* ]]
    [[ "$canonical_built_app" != "$canonical_staging_app" ]]
    [[ "$canonical_built_app" != "$canonical_installed_app" ]]
    [[ "$canonical_staging_app" != "$canonical_installed_app" ]]
    [[ -d "$canonical_temporary_root" &&
        ! -L "$canonical_temporary_root" ]]
    for app in \
        "$canonical_built_app" \
        "$canonical_staging_app" \
        "$canonical_installed_app"
    do
        [[ -d "$app" && ! -L "$app" ]]
    done

    fixture_owner=$(/usr/bin/stat -f '%Su' "$canonical_temporary_root")
    fixture_group=$(/usr/bin/stat -f '%Sg' "$canonical_temporary_root")
    built_closed_artifact_identity=$(
        validate_closed_app_artifacts \
            "$canonical_built_app" "$fixture_owner" "$fixture_group"
    )
    staging_closed_artifact_identity=$(
        validate_closed_app_artifacts \
            "$canonical_staging_app" "$fixture_owner" "$fixture_group" \
            "$built_closed_artifact_identity"
    )
    installed_closed_artifact_identity=$(
        validate_closed_app_artifacts \
            "$canonical_installed_app" "$fixture_owner" "$fixture_group" \
            "$built_closed_artifact_identity"
    )
    [[ "$staging_closed_artifact_identity" ==
        "$built_closed_artifact_identity" ]]
    [[ "$installed_closed_artifact_identity" ==
        "$built_closed_artifact_identity" ]]
    print "lifecycle.local.machine-driver-validation=complete"
}

validate_plist() {
    local plist=$1
    /usr/bin/plutil -lint "$plist" >/dev/null
    [[ "$(
        /usr/bin/plutil -convert xml1 -o - "$plist" |
            /usr/bin/xmllint --xpath 'count(/plist/dict/key)' -
    )" == 10 ]]
    [[ "$(/usr/bin/plutil -extract Label raw "$plist")" == "$label" ]]
    [[ "$(/usr/bin/plutil -extract Program raw "$plist")" ==
        "$installed_app/Contents/MacOS/StornautLifecycleHelper" ]]
    [[ "$(/usr/bin/plutil -extract ProcessType raw "$plist")" ==
        "Interactive" ]]
    [[ "$(/usr/bin/plutil -extract SessionCreate raw "$plist")" == true ]]
    [[ "$(/usr/bin/plutil -extract RunAtLoad raw "$plist")" == false ]]
    [[ "$(/usr/bin/plutil -extract AbandonProcessGroup raw "$plist")" == false ]]
    [[ "$(/usr/bin/plutil -extract KeepAlive.SuccessfulExit raw "$plist")" == false ]]
    [[ "$(/usr/bin/plutil -extract ThrottleInterval raw "$plist")" == 1 ]]
    [[ "$(/usr/bin/plutil -extract AssociatedBundleIdentifiers raw "$plist")" == 1 ]]
    [[ "$(
        /usr/bin/plutil -extract AssociatedBundleIdentifiers.0 raw "$plist"
    )" == "com.eriklee.stornaut" ]]
    [[ "$(
        /usr/bin/plutil -extract MachServices xml1 -o - "$plist" |
            /usr/bin/xmllint --xpath 'string(/plist/dict/key[1])' -
    )" == "$label" ]]
    [[ "$(
        /usr/bin/plutil -extract MachServices xml1 -o - "$plist" |
            /usr/bin/xmllint --xpath 'string(/plist/dict/key[2])' -
    )" == "$machine_claim_service" ]]
    [[ "$(
        /usr/bin/plutil -extract MachServices xml1 -o - "$plist" |
            /usr/bin/xmllint --xpath \
                'name(/plist/dict/key[.="com.eriklee.stornaut.lifecycle"]/following-sibling::*[1])' \
                -
    )" == "true" ]]
    [[ "$(
        /usr/bin/plutil -extract MachServices xml1 -o - "$plist" |
            /usr/bin/xmllint --xpath \
                'name(/plist/dict/key[.="com.eriklee.stornaut.lifecycle.machine-claim"]/following-sibling::*[1])' \
                -
    )" == "true" ]]
    [[ "$(
        /usr/bin/plutil -extract KeepAlive xml1 -o - "$plist" |
            /usr/bin/xmllint --xpath 'count(/plist/dict/key)' -
    )" == 1 ]]
    [[ "$(
        /usr/bin/plutil -extract MachServices xml1 -o - "$plist" |
            /usr/bin/xmllint --xpath 'count(/plist/dict/key)' -
    )" == 2 ]]
}

validate_built_app() {
    local machine_driver="$built_app/Contents/MacOS/StornautInvestigationMachineDriver"
    local built_owner built_group built_closed_artifact_identity
    [[ -d "$built_app" && ! -L "$built_app" ]]
    for executable in \
        "$built_app/Contents/MacOS/StornautInvestigationDiagnostic" \
        "$built_app/Contents/MacOS/StornautLifecycleHelper"
    do
        [[ -x "$executable" && ! -L "$executable" ]]
        [[ "$(/usr/bin/file -b "$executable")" == *"arm64"* ]]
    done
    /usr/bin/codesign --verify --deep --strict "$built_app"
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
        "$built_app/Contents/Info.plist")" == "com.eriklee.stornaut" ]]
    (( ${#expected_source_hashes} )) || validate_plist "$source_plist"
    built_owner=$(/usr/bin/stat -f '%Su' "$machine_driver")
    built_group=$(/usr/bin/stat -f '%Sg' "$machine_driver")
    built_closed_artifact_identity=$(
        validate_closed_app_artifacts \
            "$built_app" "$built_owner" "$built_group"
    )
    print -r -- "$built_closed_artifact_identity"
}

validate_bundle_permissions() {
    local app=$1
    local file file_type owner group links acl_listing
    [[ -z "$(/usr/bin/find "$app" -type l -print -quit)" ]]
    [[ -z "$(/usr/bin/find "$app" \
        \( -perm -020 -o -perm -002 \) -print -quit)" ]]
    while IFS= read -r -d '' file; do
        file_type=$(/usr/bin/stat -f '%HT' "$file")
        owner=$(/usr/bin/stat -f '%Su' "$file")
        group=$(/usr/bin/stat -f '%Sg' "$file")
        links=$(/usr/bin/stat -f '%l' "$file")
        acl_listing=$(/bin/ls -lde "$file")
        [[ "$owner" == root && "$group" == wheel ]]
        [[ "$acl_listing" != *$'\n'* ]]
        if [[ "$file_type" == "Regular File" ]]; then
            [[ "$links" == 1 ]]
        else
            [[ "$file_type" == "Directory" ]]
        fi
    done < <(/usr/bin/find "$app" -print0)
}

validate_installed_artifacts() {
    local expected_closed_artifact_identity=${1:-}
    local installed_closed_artifact_identity
    exact_directory_metadata "$application_support" root admin 0755
    exact_directory_metadata "$installed_root" root wheel 0755
    exact_directory_metadata "$installed_app" root wheel 0755
    exact_file_metadata "$installed_plist" root wheel 0644
    validate_plist "$installed_plist"
    source_plist_matches "$installed_plist"
    /usr/bin/codesign --verify --deep --strict "$installed_app"
    validate_bundle_permissions "$installed_app"
    for executable in \
        "$installed_app/Contents/MacOS/StornautInvestigationDiagnostic" \
        "$installed_app/Contents/MacOS/StornautLifecycleHelper"
    do
        exact_file_metadata "$executable" root wheel 0755
    done
    installed_closed_artifact_identity=$(
        validate_closed_app_artifacts \
            "$installed_app" root wheel \
            "$expected_closed_artifact_identity"
    )
    [[ -n "$installed_closed_artifact_identity" ]]
    if [[ -n "$expected_closed_artifact_identity" ]]; then
        [[ "$installed_closed_artifact_identity" ==
            "$expected_closed_artifact_identity" ]]
    fi
}

validate_installed_state() {
    local expected_closed_artifact_identity=${1:-}
    validate_installed_artifacts "$expected_closed_artifact_identity"
    /bin/launchctl print "system/$label" >/dev/null
}

validate_runtime_roots_drained() {
    local user_root name
    if [[ -e "$lease_root" || -L "$lease_root" ]]; then
        exact_directory_metadata "$lease_root" root wheel 0700
        [[ -z "$(/usr/bin/find "$lease_root" -mindepth 1 -print -quit)" ]]
    fi
    if [[ -e "$diagnostic_root" || -L "$diagnostic_root" ]]; then
        exact_directory_metadata "$diagnostic_root" root wheel 0711
        while IFS= read -r -d '' user_root; do
            [[ -d "$user_root" && ! -L "$user_root" ]]
            name=${user_root:t}
            [[ "$name" == <1-> ]]
            exact_directory_metadata "$user_root" root wheel 0711
            [[ -z "$(/usr/bin/find "$user_root" -mindepth 1 -print -quit)" ]]
        done < <(
            /usr/bin/find "$diagnostic_root" \
                -mindepth 1 -maxdepth 1 -print0
        )
    fi
}

runtime_roots_are_drained() {
    validate_runtime_roots_drained >/dev/null 2>&1
}

recover_runtime_roots_after_bootout() {
    runtime_roots_are_drained && return
    validate_installed_artifacts
    /bin/launchctl bootstrap system "$installed_plist"
    local recovery_status=0
    /bin/launchctl kickstart "system/$label" || recovery_status=$?
    if (( recovery_status == 0 )); then
        local attempt
        for attempt in {1..100}; do
            runtime_roots_are_drained && break
            /bin/sleep 0.1
        done
        validate_runtime_roots_drained || recovery_status=$?
    fi
    /bin/launchctl bootout "system/$label" || recovery_status=$?
    (( recovery_status == 0 )) || return "$recovery_status"
    validate_runtime_roots_drained
}

rollback_failed_lifecycle() {
    local exit_status=${1:-1}
    local may_remove_installed=1
    trap - EXIT INT TERM
    if /bin/launchctl print "system/$label" >/dev/null 2>&1; then
        /bin/launchctl bootout "system/$label" >/dev/null 2>&1 ||
            may_remove_installed=0
    fi
    if /bin/launchctl print "system/$label" >/dev/null 2>&1; then
        may_remove_installed=0
    fi
    if [[ -n ${staging_plist:-} &&
        ( -e "$staging_plist" || -L "$staging_plist" ) ]]
    then
        /bin/rm -f -- "$staging_plist"
    fi
    if (( ${staging_app_created:-0} )) &&
        [[ -n ${staging_app:-} &&
        ( -e "$staging_app" || -L "$staging_app" ) ]]
    then
        if exact_directory_metadata "$staging_app" root wheel 0755 &&
            [[ -z ${staging_app_node:-} ||
                "$(/usr/bin/stat -f '%d:%i' "$staging_app")" ==
                    "$staging_app_node" ]] &&
            [[ "$(/usr/bin/stat -f '%d:%i' "$installed_root")" ==
                "${installed_root_node:-}" ]]
        then
            /bin/rm -rf -- "$staging_app"
        fi
    fi
    if (( may_remove_installed && ${installed_plist_moved:-0} )); then
        if exact_file_metadata "$installed_plist" root wheel 0644 &&
            validate_plist "$installed_plist" &&
            source_plist_matches "$installed_plist"
        then
            /bin/rm -f -- "$installed_plist"
        fi
    fi
    if (( may_remove_installed && ${installed_app_moved:-0} )); then
        if exact_directory_metadata "$installed_app" root wheel 0755 &&
            [[ "$(/usr/bin/stat -f '%d:%i' "$installed_app")" ==
                "${installed_app_node:-}" ]] &&
            [[ "$(/usr/bin/stat -f '%d:%i' "$installed_root")" ==
                "${installed_root_node:-}" ]] &&
            /usr/bin/codesign --verify --deep --strict "$installed_app" &&
            validate_bundle_permissions "$installed_app" &&
            validate_closed_app_artifacts "$installed_app" root wheel \
                "${built_closed_artifact_identity:-}" \
                >/dev/null
        then
            /bin/rm -rf -- "$installed_app"
        fi
    fi
    if (( may_remove_installed && ${installed_root_created:-0} )); then
        /bin/rmdir -- "$installed_root" >/dev/null 2>&1 || true
    fi
    exit "$exit_status"
}

status() {
    local root_state=absent app_state=absent plist_state=absent service_state=absent
    [[ -e "$installed_root" ]] && root_state=present
    [[ -e "$installed_app" ]] && app_state=present
    [[ -e "$installed_plist" ]] && plist_state=present
    if /bin/launchctl print "system/$label" >/dev/null 2>&1; then
        service_state=loaded
    fi
    if validate_installed_state >/dev/null 2>&1; then
        print "lifecycle.local.state=installed"
        return
    fi
    print "lifecycle.local.root=$root_state"
    print "lifecycle.local.app=$app_state"
    print "lifecycle.local.plist=$plist_state"
    print "lifecycle.local.service=$service_state"
    if [[ "$root_state" == absent &&
        "$app_state" == absent &&
        "$plist_state" == absent &&
        "$service_state" == absent ]]
    then
        print "lifecycle.local.state=administratorInstallRequired"
    else
        print "lifecycle.local.state=inconsistentInstallation"
        return 1
    fi
}

sha256_text() {
    local digest
    digest=$(
        print -rn -- "$1" |
            /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}'
    )
    [[ ${#digest} == 64 && "$digest" != *[^0-9a-f]* ]]
    print -rn -- "$digest"
}

sha256_file() {
    local digest
    digest=$(
        /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
    )
    [[ ${#digest} == 64 && "$digest" != *[^0-9a-f]* ]]
    print -rn -- "$digest"
}
source_plist_matches() { (( ${#expected_source_hashes} )) && [[ "$(sha256_file "$1")" == "$expected_source_hashes[6]" ]] || { (( ! ${#expected_source_hashes} )) && /usr/bin/cmp -s "$source_plist" "$1"; }; }

role_sha256_projection() {
    local app=$1 role
    local -a roles=(
        StornautInvestigationDiagnostic
        StornautLifecycleHelper
        StornautInvestigationMachineDriver
        StornautInvestigationMachineGate
        StornautInvestigationMachineGateCoordinator
    )
    for role in "${roles[@]}"; do
        sha256_file "$app/Contents/MacOS/$role"
        print
    done
}

emit_install_receipt() {
    local built_sha256=$1 staging_sha256=$2 installed_sha256=$3
    local plist_sha256=$4 digest
    [[ "$built_sha256" == "$staging_sha256" &&
        "$built_sha256" == "$installed_sha256" ]]
    for digest in "$@"
    do
        [[ ${#digest} == 64 && "$digest" != *[^0-9a-f]* ]]
    done
    /usr/bin/printf '%s\n' \
        "{\"action\":\"install\",\"appExecutableSHA256\":\"$5\",\"builtIdentitySHA256\":\"$built_sha256\",\"builtStagingInstalledEqual\":true,\"coordinatorExecutableSHA256\":\"$9\",\"domain\":\"lifecycle.local.install.receipt.v1\",\"gateExecutableSHA256\":\"$8\",\"helperExecutableSHA256\":\"$6\",\"installedIdentitySHA256\":\"$installed_sha256\",\"machineDriverExecutableSHA256\":\"$7\",\"plistSHA256\":\"$plist_sha256\",\"schemaVersion\":1,\"serviceLoaded\":true,\"stagingIdentitySHA256\":\"$staging_sha256\"}"
}

emit_uninstall_receipt() {
    local installed_sha256=$1 plist_sha256=$2 digest
    for digest in "$@"; do
        [[ ${#digest} == 64 && "$digest" != *[^0-9a-f]* ]]
    done
    /usr/bin/printf '%s\n' \
        "{\"action\":\"uninstall\",\"appAbsent\":true,\"appExecutableSHA256\":\"$3\",\"bootoutCompleted\":true,\"coordinatorExecutableSHA256\":\"$7\",\"domain\":\"lifecycle.local.uninstall.receipt.v1\",\"gateExecutableSHA256\":\"$6\",\"globalPostTeardown\":true,\"helperExecutableSHA256\":\"$4\",\"installedIdentitySHA256\":\"$installed_sha256\",\"leaseAbsent\":true,\"machineDriverExecutableSHA256\":\"$5\",\"plistAbsent\":true,\"plistSHA256\":\"$plist_sha256\",\"rootAbsent\":true,\"runtimeAbsent\":true,\"schemaVersion\":1,\"serviceAbsent\":true}"
}

install() {
    local built_closed_artifact_identity
    local staging_closed_artifact_identity
    local installed_closed_artifact_identity
    local built_identity_sha256 staging_identity_sha256
    local installed_identity_sha256 installed_plist_sha256
    local installed_root_node staging_app_node installed_app_node
    local -a built_role_sha256 staging_role_sha256 installed_role_sha256
    (( EUID == 0 )) || {
        print -u2 "Install requires explicit administrator authentication."
        exit 77
    }
    built_role_sha256=(
        "${(@f)$(role_sha256_projection "$built_app")}"
    )
    (( ${#built_role_sha256} == 5 ))
    (( ! ${#expected_source_hashes} )) || [[ "${(j:\n:)built_role_sha256}" == "${(j:\n:)expected_source_hashes[1,5]}" && "$(sha256_file "$source_plist")" == "$expected_source_hashes[6]" ]]
    built_closed_artifact_identity=$(validate_built_app)
    built_identity_sha256=$(sha256_text "$built_closed_artifact_identity")
    exact_directory_metadata "$application_support" root admin 0755
    if [[ -e "$installed_root" || -L "$installed_root" ||
        -e "$installed_app" || -L "$installed_app" ||
        -e "$installed_plist" || -L "$installed_plist" ]] ||
        /bin/launchctl print "system/$label" >/dev/null 2>&1
    then
        print -u2 "Refusing to replace an existing local lifecycle object."
        exit 73
    fi

    local staging_app="$installed_app.staging.$$"
    local staging_plist="$installed_plist.staging.$$"
    local installed_root_created=0
    local installed_app_moved=0
    local installed_plist_moved=0
    local service_bootstrapped=0
    local staging_app_created=0
    [[ ! -e "$staging_app" && ! -L "$staging_app" ]]
    [[ ! -e "$staging_plist" && ! -L "$staging_plist" ]]
    trap 'rollback_failed_lifecycle $?' EXIT
    trap 'rollback_failed_lifecycle 1' INT TERM
    /bin/mkdir -m 0755 "$installed_root"
    installed_root_created=1
    /usr/sbin/chown root:wheel "$installed_root"
    exact_directory_metadata "$installed_root" root wheel 0755
    installed_root_node=$(/usr/bin/stat -f '%d:%i' "$installed_root")

    staging_app_created=1
    /bin/mkdir -m 0755 "$staging_app"
    staging_app_node=$(/usr/bin/stat -f '%d:%i' "$staging_app")
    /usr/sbin/chown root:wheel "$staging_app"
    exact_directory_metadata "$staging_app" root wheel 0755
    /usr/bin/ditto --noqtn "$built_app" "$staging_app"
    (( ! ${#expected_source_hashes} )) || { built_role_sha256=("${(@f)$(role_sha256_projection "$built_app")}"); [[ "${(j:\n:)built_role_sha256}" == "${(j:\n:)expected_source_hashes[1,5]}" && "$(sha256_file "$source_plist")" == "$expected_source_hashes[6]" ]]; }
    /usr/sbin/chown -R root:wheel "$staging_app"
    /bin/chmod -RN "$staging_app"
    /bin/chmod -R go-w "$staging_app"
    /bin/chmod 0755 "$staging_app"
    /bin/chmod 0755 \
        "$staging_app/Contents/MacOS/StornautInvestigationDiagnostic" \
        "$staging_app/Contents/MacOS/StornautLifecycleHelper" \
        "$staging_app/Contents/MacOS/StornautInvestigationMachineDriver" \
        "$staging_app/Contents/MacOS/StornautInvestigationMachineGate" \
        "$staging_app/Contents/MacOS/StornautInvestigationMachineGateCoordinator"
    validate_bundle_permissions "$staging_app"
    /usr/bin/codesign --verify --deep --strict "$staging_app"
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
        "$staging_app/Contents/Info.plist")" == "com.eriklee.stornaut" ]]
    staging_closed_artifact_identity=$(
        validate_closed_app_artifacts \
            "$staging_app" root wheel "$built_closed_artifact_identity"
    )
    [[ "$staging_closed_artifact_identity" ==
        "$built_closed_artifact_identity" ]]
    staging_identity_sha256=$(
        sha256_text "$staging_closed_artifact_identity"
    )
    staging_role_sha256=(
        "${(@f)$(role_sha256_projection "$staging_app")}"
    )
    [[ "${(j:\n:)staging_role_sha256}" ==
        "${(j:\n:)built_role_sha256}" ]]
    [[ "$(/usr/bin/stat -f '%d:%i' "$staging_app")" ==
        "$staging_app_node" ]]
    [[ "$(/usr/bin/stat -f '%d:%i' "$installed_root")" ==
        "$installed_root_node" ]]
    installed_app_node=$staging_app_node
    installed_app_moved=1
    /bin/mv -n "$staging_app" "$installed_app"
    staging_app_created=0
    [[ "$(/usr/bin/stat -f '%d:%i' "$installed_app")" ==
        "$installed_app_node" ]]
    /usr/bin/codesign --verify --deep --strict "$installed_app"
    installed_closed_artifact_identity=$(
        validate_closed_app_artifacts \
            "$installed_app" root wheel "$built_closed_artifact_identity"
    )
    [[ "$installed_closed_artifact_identity" ==
        "$built_closed_artifact_identity" ]]
    installed_identity_sha256=$(
        sha256_text "$installed_closed_artifact_identity"
    )
    installed_role_sha256=(
        "${(@f)$(role_sha256_projection "$installed_app")}"
    )
    [[ "${(j:\n:)installed_role_sha256}" ==
        "${(j:\n:)built_role_sha256}" ]]

    if (( ${#expected_source_hashes} )); then print -rn -- "$source_plist_base64"|/usr/bin/base64 -D -o "$staging_plist"; /usr/sbin/chown root:wheel "$staging_plist"; /bin/chmod 0644 "$staging_plist"; validate_plist "$staging_plist"; source_plist_matches "$staging_plist"; else /usr/bin/install -o root -g wheel -m 0644 "$source_plist" "$staging_plist"; fi
    /bin/mv -n "$staging_plist" "$installed_plist"
    installed_plist_moved=1
    validate_plist "$installed_plist"
    installed_plist_sha256=$(sha256_file "$installed_plist")
    validate_installed_artifacts "$built_closed_artifact_identity"
    /bin/launchctl bootstrap system "$installed_plist"
    service_bootstrapped=1
    validate_installed_state "$built_closed_artifact_identity"
    /bin/launchctl print "system/$label" >/dev/null
    emit_install_receipt \
        "$built_identity_sha256" "$staging_identity_sha256" \
        "$installed_identity_sha256" "$installed_plist_sha256" \
        "${installed_role_sha256[@]}"
    trap - EXIT INT TERM
    print "lifecycle.local.install=complete"
}

uninstall() {
    local uninstall_closed_artifact_identity uninstall_app_node
    local uninstall_identity_sha256 uninstall_plist_sha256
    local -a uninstall_role_sha256
    (( EUID == 0 )) || {
        print -u2 "Uninstall requires explicit administrator authentication."
        exit 77
    }
    validate_installed_artifacts
    uninstall_app_node=$(/usr/bin/stat -f '%d:%i' "$installed_app")
    uninstall_closed_artifact_identity=$(
        validate_closed_app_artifacts "$installed_app" root wheel
    )
    uninstall_identity_sha256=$(
        sha256_text "$uninstall_closed_artifact_identity"
    )
    uninstall_plist_sha256=$(sha256_file "$installed_plist")
    uninstall_role_sha256=(
        "${(@f)$(role_sha256_projection "$installed_app")}"
    )
    (( ${#uninstall_role_sha256} == 5 ))
    if /bin/launchctl print "system/$label" >/dev/null 2>&1; then
        /bin/launchctl bootout "system/$label"
    fi
    recover_runtime_roots_after_bootout
    if [[ -e "$installed_plist" || -L "$installed_plist" ]]; then
        exact_file_metadata "$installed_plist" root wheel 0644
        validate_plist "$installed_plist"
        source_plist_matches "$installed_plist"
        /bin/rm -f -- "$installed_plist"
    fi
    if [[ -e "$installed_app" || -L "$installed_app" ]]; then
        exact_directory_metadata "$installed_app" root wheel 0755
        /usr/bin/codesign --verify --deep --strict "$installed_app"
        validate_bundle_permissions "$installed_app"
        [[ "$(/usr/bin/stat -f '%d:%i' "$installed_app")" ==
            "$uninstall_app_node" ]]
        validate_closed_app_artifacts "$installed_app" root wheel \
            "$uninstall_closed_artifact_identity" \
            >/dev/null
        [[ "${(j:\n:)${(@f)$(role_sha256_projection "$installed_app")}}" ==
            "${(j:\n:)uninstall_role_sha256}" ]]
        /bin/rm -rf -- "$installed_app"
    fi
    if [[ -e "$lease_root" || -L "$lease_root" ]]; then
        exact_directory_metadata "$lease_root" root wheel 0700
        /bin/rmdir -- "$lease_root"
    fi
    if [[ -e "$diagnostic_root" || -L "$diagnostic_root" ]]; then
        exact_directory_metadata "$diagnostic_root" root wheel 0711
        while IFS= read -r -d '' user_root; do
            /bin/rmdir -- "$user_root"
        done < <(
            /usr/bin/find "$diagnostic_root" \
                -mindepth 1 -maxdepth 1 -print0
        )
        /bin/rmdir -- "$diagnostic_root"
    fi
    if [[ -e "$installed_root" || -L "$installed_root" ]]; then
        exact_directory_metadata "$installed_root" root wheel 0755
        /bin/rmdir -- "$installed_root"
    fi
    [[ ! -e "$installed_app" && ! -L "$installed_app" ]]
    [[ ! -e "$installed_root" && ! -L "$installed_root" ]]
    [[ ! -e "$installed_plist" && ! -L "$installed_plist" ]]
    [[ ! -e "$lease_root" && ! -L "$lease_root" ]]
    [[ ! -e "$diagnostic_root" && ! -L "$diagnostic_root" ]]
    ! /bin/launchctl print "system/$label" >/dev/null 2>&1
    emit_uninstall_receipt \
        "$uninstall_identity_sha256" "$uninstall_plist_sha256" \
        "${uninstall_role_sha256[@]}"
    print "lifecycle.local.uninstall=complete"
}

case "$action" in
    status) status ;;
    install) install ;;
    uninstall) uninstall ;;
    validate-machine-driver)
        [[ $# == 6 ]]
        validate_closed_artifact_fixtures "$2" "$3" "$4" "$5" "$6"
        ;;
esac
